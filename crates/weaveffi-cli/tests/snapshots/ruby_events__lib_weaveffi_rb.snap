  # released exactly once, when iteration finishes or is abandoned
  # early (for example by `break`).
  def self.get_messages()
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = weaveffi_events_get_messages(err)
      begin
        check_error!(err)
