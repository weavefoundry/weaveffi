function $w$shapes$Shape(w, v) {
  switch (v.tag) {
    case 'Empty':
      w.writeI32(0);
      return;
    case 'Circle':
      w.writeI32(1);
      w.writeF64(v.radius);
      return;
    case 'Rectangle':
      w.writeI32(2);
      w.writeF32(v.width);
      w.writeF32(v.height);
      return;
    case 'Bounded':
      w.writeI32(3);
      w.writeI16(v.min);
      w.writeI16(v.max);
      w.writeU64(v.weight);
      return;
    case 'Labeled':
      w.writeI32(4);
      w.writeString(v.label);
      w.writeU8(v.count);
      return;
    default:
      throw new TypeError('unknown Shape tag: ' + (v && v.tag));
