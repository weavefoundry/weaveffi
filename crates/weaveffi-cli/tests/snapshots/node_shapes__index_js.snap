  const tag = r.readI32();
  switch (tag) {
    case 0: return { tag: 'Empty' };
    case 1: return { tag: 'Circle', radius: r.readF64() };
    case 2: return { tag: 'Rectangle', width: r.readF32(), height: r.readF32() };
    case 3: return { tag: 'Bounded', min: r.readI16(), max: r.readI16(), weight: r.readU64() };
    case 4: return { tag: 'Labeled', label: r.readString(), count: r.readU8() };
    default:
