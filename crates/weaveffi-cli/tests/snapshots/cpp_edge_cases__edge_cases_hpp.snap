/**
 * Verifies that the linked edge_cases library implements C ABI revision
 * 4 and every declaration this header was generated with, throwing
 * LoadError naming the first mismatch. The check runs once; every free
 * function, constructor, and static member calls this before its first
 * native call, so calling it at startup is optional.
 */
inline void check_library() {
    static const std::string failure = []() -> std::string {
        uint32_t abi = edge_cases_abi_version();
        if (abi != EDGE_CASES_ABI_VERSION) {
            return "edge_cases: C ABI revision mismatch (header " + std::to_string(EDGE_CASES_ABI_VERSION) +
                   ", library " + std::to_string(abi) + ")";
        }
        if (std::string why = detail::contract_mismatch(edge_cases_edge_cases_contract, detail::edge_cases_contract); !why.empty()) {
            return "edge_cases: " + why;
        }
        return std::string();
    }();
    if (!failure.empty()) throw LoadError(failure);
}

