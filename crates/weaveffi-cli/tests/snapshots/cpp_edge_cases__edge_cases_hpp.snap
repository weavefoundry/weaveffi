class Keyword;

/** Interface with no constructor; instances come from make_widget */
class Widget {
    edge_cases_edge_cases_Widget* raw_;

public:
    /** The C type this class wraps. */
    using raw_type = edge_cases_edge_cases_Widget;

    /** Adopts one strong reference to a producer object: `Widget(adopt, raw)`. */
    explicit Widget(adopt_t, edge_cases_edge_cases_Widget* h) noexcept : raw_(h) {}

    /** Releases this wrapper's reference; the object is dropped with its last one. */
    ~Widget() {
        if (raw_ != nullptr) edge_cases_edge_cases_Widget_destroy(raw_);
    }

    /** Copies share the object: the copy takes a new strong reference. */
    Widget(const Widget& other) : raw_(edge_cases_edge_cases_Widget_clone(other.raw_)) {}

    /** Takes a new reference to `other`'s object and releases the current one. */
    Widget& operator=(const Widget& other) {
        if (this != &other) {
            edge_cases_edge_cases_Widget* h = edge_cases_edge_cases_Widget_clone(other.raw_);
            if (raw_ != nullptr) edge_cases_edge_cases_Widget_destroy(raw_);
            raw_ = h;
        }
        return *this;
    }

    /** Transfers `other`'s reference; `other` becomes empty. */
    Widget(Widget&& other) noexcept : raw_(other.raw_) { other.raw_ = nullptr; }

    /** Releases the current reference and takes over `other`'s. */
    Widget& operator=(Widget&& other) noexcept {
        if (this != &other) {
            if (raw_ != nullptr) edge_cases_edge_cases_Widget_destroy(raw_);
            raw_ = other.raw_;
            other.raw_ = nullptr;
        }
        return *this;
    }

    /** The wrapped pointer, borrowed (null after a move): this wrapper keeps its reference. */
    const edge_cases_edge_cases_Widget* handle() const noexcept { return raw_; }

    /** A new strong reference to the object, which the caller owns. */
    edge_cases_edge_cases_Widget* clone_handle() const { return edge_cases_edge_cases_Widget_clone(raw_); }

    /**
     * Void method that can fail
     *
     * @throws EdgeErrorsError when the call fails with one of the domain's codes.
     */
    void refresh() const;

    std::string rename(std::string_view class_, const std::optional<std::string>& import) const;

    /**
     * Async method with a struct result
     *
     * @return A future settled from a producer thread; get() rethrows the call's error.
     * @throws EdgeErrorsError when the call fails with one of the domain's codes.
     */
    std::future<Outer> fetch(int64_t id) const;

    [[deprecated("Use rename instead")]]
    std::string old_name() const;

    /** Spelled like the release method of several wrappers */
    bool close() const;

    /** Spelled like the release method of the Dart and .NET wrappers */
    void dispose(bool force) const;

};

/**
 * Deprecated interface with a throwing constructor
 *
 * @deprecated Use Widget instead
 */
class Vault {
    edge_cases_edge_cases_Vault* raw_;

public:
    /** The C type this class wraps. */
    using raw_type = edge_cases_edge_cases_Vault;

    /** Adopts one strong reference to a producer object: `Vault(adopt, raw)`. */
    explicit Vault(adopt_t, edge_cases_edge_cases_Vault* h) noexcept : raw_(h) {}

    /** Releases this wrapper's reference; the object is dropped with its last one. */
    ~Vault() {
        if (raw_ != nullptr) edge_cases_edge_cases_Vault_destroy(raw_);
    }

    /** Copies share the object: the copy takes a new strong reference. */
    Vault(const Vault& other) : raw_(edge_cases_edge_cases_Vault_clone(other.raw_)) {}

    /** Takes a new reference to `other`'s object and releases the current one. */
    Vault& operator=(const Vault& other) {
        if (this != &other) {
            edge_cases_edge_cases_Vault* h = edge_cases_edge_cases_Vault_clone(other.raw_);
            if (raw_ != nullptr) edge_cases_edge_cases_Vault_destroy(raw_);
            raw_ = h;
        }
        return *this;
    }

    /** Transfers `other`'s reference; `other` becomes empty. */
    Vault(Vault&& other) noexcept : raw_(other.raw_) { other.raw_ = nullptr; }

    /** Releases the current reference and takes over `other`'s. */
    Vault& operator=(Vault&& other) noexcept {
        if (this != &other) {
            if (raw_ != nullptr) edge_cases_edge_cases_Vault_destroy(raw_);
            raw_ = other.raw_;
            other.raw_ = nullptr;
        }
        return *this;
    }

    /** The wrapped pointer, borrowed (null after a move): this wrapper keeps its reference. */
    const edge_cases_edge_cases_Vault* handle() const noexcept { return raw_; }

    /** A new strong reference to the object, which the caller owns. */
    edge_cases_edge_cases_Vault* clone_handle() const { return edge_cases_edge_cases_Vault_clone(raw_); }

    /**
     * Fails when the vault is busy
     *
     * @throws EdgeErrorsError when the call fails with one of the domain's codes.
     */
    static Vault open(std::string_view path);

    std::optional<Widget> peek() const;

    /** Spelled like the handle accessor of several wrappers */
    int64_t handle_() const;

    /**
     * Throwing static
     *
     * @throws EdgeErrorsError when the call fails with one of the domain's codes.
     */
    static bool probe();

    /** Static spelled like an inherited object member */
    static std::string to_string();

};

struct Leaf {
    float weight;
};

/** Middle layer of a three-deep struct nesting */
struct Inner {
    Leaf leaf;
    std::vector<Leaf> leaves;
};

struct Outer {
    Inner inner;
    std::optional<Inner> maybe_inner;
    std::unordered_map<std::string, Inner> by_name;
    std::vector<Mode> modes;
    std::vector<std::vector<int32_t>> matrix;
    std::vector<std::optional<int64_t>> sparse;
    std::optional<std::vector<uint8_t>> blob;
    std::optional<std::string> note;
    std::unordered_map<int64_t, std::string> by_id;
    bool _hidden;
    uint8_t v2;
};

/** Every field is a reserved word somewhere */
struct Keywords {
    int32_t class_;
    int32_t def;
    int32_t import;
    int32_t from;
    int32_t func;
    int32_t range;
    int32_t register_;
    int32_t volatile_;
    int32_t new_;
    int32_t default_;
    int32_t end;
    int32_t in;
    int32_t is;
    int32_t int_;
    int32_t var;
    int32_t val;
    int32_t self;
    int32_t this_;
    int32_t object;
    int32_t string;
    int32_t case_;
    int32_t select;
    int32_t switch_;
    int32_t void_;
    int32_t union_;
    int32_t namespace_;
    int32_t operator_;
    int32_t template_;
    int32_t package;
    int32_t protocol;
    int32_t guard;
    int32_t defer;
    int32_t inout;
    int32_t internal;
    int32_t when;
    int32_t fun;
    int32_t data;
    int32_t late;
    int32_t part;
    int32_t out;
    int32_t ref;
    int32_t event;
    int32_t base;
    int32_t lambda;
    int32_t yield;
    int32_t nil;
    int32_t null;
    int32_t begin;
    int32_t rescue;
    int32_t module;
    int32_t chan;
    int32_t go;
    int32_t let;
    int32_t export_;
    int32_t delete_;
    int32_t typedef_;
    int32_t sizeof_;
    int32_t static_;
    int32_t super;
};

/**
 * Deprecated struct
 *
 * @deprecated Use Outer instead
 */
struct Retired {
    int64_t id;
};

/** Record carrying objects in every buffered position */
struct WidgetHolder {
    Widget primary;
    std::optional<Widget> fallback;
    std::vector<Widget> extras;
    std::unordered_map<std::string, Widget> by_name;
};

