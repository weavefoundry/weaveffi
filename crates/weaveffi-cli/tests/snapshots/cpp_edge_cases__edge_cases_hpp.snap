inline void Widget::refresh() const {
    edge_cases_error err{};
    edge_cases_edge_cases_Widget_refresh(handle_, &err);
    detail::check_edge_cases(err);
}

inline std::string Widget::rename(std::string_view class_, const std::optional<std::string>& import) const {
    detail::BufferWriter import_buf;
    import_buf.write_option_flag(import.has_value());
    if (import.has_value()) {
        import_buf.write_string((*import));
    }
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_Widget_rename(handle_, detail::utf8(class_), class_.size(), import_buf.data(), import_buf.size(), &out_len, &err);
    detail::check(err);
    return detail::take_string(result, out_len);
}

inline std::future<Outer> Widget::fetch(int64_t id) const {
    auto promise = std::make_unique<std::promise<Outer>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_Widget_fetch(handle_, id, [](void* context, edge_cases_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<Outer>> p(static_cast<std::promise<Outer>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string msg = detail::error_message(*err);
                p->set_exception(detail::make_edge_cases_error(err->code, msg, err->payload_ptr, err->payload_len));
            } else {
                detail::BufferGuard result_guard(result_ptr, result_len);
                detail::BufferReader result_r(result_ptr, result_len);
                Outer value = detail::read_Outer(result_r);
                result_r.expect_end();
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

inline std::string Widget::old_name() const {
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_Widget_old_name(handle_, &out_len, &err);
    detail::check(err);
    return detail::take_string(result, out_len);
}

