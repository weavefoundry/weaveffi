    auto promise = std::make_unique<std::promise<std::vector<uint8_t>>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_async_bytes(size, [](void* context, edge_cases_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<std::vector<uint8_t>>> p(static_cast<std::promise<std::vector<uint8_t>>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string msg = detail::error_message(*err);
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                p->set_value(detail::take_bytes(result_ptr, result_len));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

inline std::future<Outer> async_struct() {
    check_library();
    auto promise = std::make_unique<std::promise<Outer>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_async_struct([](void* context, edge_cases_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<Outer>> p(static_cast<std::promise<Outer>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string msg = detail::error_message(*err);
                p->set_exception(detail::make_edge_cases_error(err->code, msg, err->payload_ptr, err->payload_len));
            } else {
                detail::BufferGuard result_guard(result_ptr, result_len);
                detail::BufferReader result_r(result_ptr, result_len);
                Outer value = detail::read_Outer(result_r);
                result_r.expect_end();
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

inline std::future<std::vector<Outer>> async_list(const CancelToken& cancel_token = CancelToken::none()) {
    check_library();
    auto promise = std::make_unique<std::promise<std::vector<Outer>>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_async_list(cancel_token.handle(), [](void* context, edge_cases_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<std::vector<Outer>>> p(static_cast<std::promise<std::vector<Outer>>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string msg = detail::error_message(*err);
                p->set_exception(detail::make_edge_cases_error(err->code, msg, err->payload_ptr, err->payload_len));
            } else {
                detail::BufferGuard result_guard(result_ptr, result_len);
                detail::BufferReader result_r(result_ptr, result_len);
                std::vector<Outer> value{};
                {
                    size_t value_n = result_r.read_count();
                    value.reserve(result_r.reserve_hint(value_n));
                    for (size_t value_i = 0; value_i < value_n; ++value_i) {
                        Outer value_item = detail::read_Outer(result_r);
                        value.push_back(std::move(value_item));
                    }
                }
                result_r.expect_end();
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

inline std::future<std::optional<int64_t>> async_optional() {
    check_library();
    auto promise = std::make_unique<std::promise<std::optional<int64_t>>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_async_optional([](void* context, edge_cases_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<std::optional<int64_t>>> p(static_cast<std::promise<std::optional<int64_t>>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string msg = detail::error_message(*err);
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                detail::BufferGuard result_guard(result_ptr, result_len);
                detail::BufferReader result_r(result_ptr, result_len);
                std::optional<int64_t> value{};
                if (result_r.read_option_flag()) {
                    int64_t value_v = result_r.read_i64();
                    value = std::move(value_v);
                }
                result_r.expect_end();
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

