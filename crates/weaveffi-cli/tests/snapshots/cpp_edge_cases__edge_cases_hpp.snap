/** The errors the `edge_cases` module's throwing calls report; catch a code's subclass or this. */
class EdgeErrorsError : public Error {
public:
    /** Builds an error carrying a domain `code` and `message`. */
    EdgeErrorsError(int32_t code, const std::string& message) : Error(code, message) {}
};

/**
 * Resource is busy
 *
 * Code 7.
 */
class BusyError : public EdgeErrorsError {
public:
    /** Builds the error with the producer's `message` and the code's fields. */
    explicit BusyError(const std::string& message) : EdgeErrorsError(7, message) {}
};

namespace detail {

/** The exception for a failed `EdgeErrorsError` call: its code's subclass, Cancelled, or the root Error. */
inline std::exception_ptr make_edge_cases_error(int32_t code, const std::string& message, const uint8_t* payload_ptr, size_t payload_len) {
    if (code == -5) return std::make_exception_ptr(Cancelled(message));
    if (code < 0) return std::make_exception_ptr(Error(code, message));
    (void)payload_ptr;
    (void)payload_len;
    switch (code) {
        case 7: return std::make_exception_ptr(BusyError(message));
        default: return std::make_exception_ptr(EdgeErrorsError(code, message));
    }
}

/** Throws the typed `EdgeErrorsError` exception if `err` carries a nonzero code. */
inline void check_edge_cases(edge_cases_error& err) {
    if (err.code == 0) return;
    std::exception_ptr ex = make_edge_cases_error(err.code, error_message(err), err.payload_ptr, err.payload_len);
    edge_cases_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

/**
 * Callback interface carrying composite payloads and objects
 *
 * Subclass it and pass a `std::shared_ptr<BatchListener>` where the API takes a `BatchListener`. The producer may call the methods from any thread, so they must be thread-safe, until it releases the implementation (also from any thread). An exception a method throws reaches the producer as a callback failure (code -4).
 */
class BatchListener {
public:
    virtual ~BatchListener() = default;

    /** Composite payloads cross as value buffers */
    virtual void on_batch(const std::vector<Outer>& items, const std::vector<uint8_t>& raw, const std::optional<Outer>& first, Mode mode) = 0;

    /** Objects cross as strong references the consumer must release */
    virtual void on_widget(Widget widget, std::optional<Widget> fallback, const std::vector<Widget>& children) = 0;

    virtual void on_tick() = 0;

    /** Scalar return travels back through the vtable */
    virtual bool should_continue(int32_t class_) = 0;

    /** Enum return travels back as its integer discriminant */
    virtual Mode pick_mode() = 0;
};

namespace detail {

/** Trampolines adapting a `BatchListener` implementation to `edge_cases_edge_cases_BatchListener_vtable`. */
struct BatchListener_trampolines {
    static void on_batch(void* ctx, const uint8_t* items_ptr, size_t items_len, const uint8_t* raw_ptr, size_t raw_len, const uint8_t* first_ptr, size_t first_len, edge_cases_edge_cases_Mode mode, edge_cases_error* out_err) {
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            std::vector<Outer> items_arg = detail::decode(items_ptr, items_len, &detail::read_list_Outer);
            std::optional<Outer> first_arg = detail::decode(first_ptr, first_len, &detail::read_opt_Outer);
            impl.on_batch(std::move(items_arg), detail::borrow_bytes(raw_ptr, raw_len), std::move(first_arg), static_cast<Mode>(static_cast<int32_t>(mode)));
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::on_batch threw a non-standard exception");
        }
    }

    static void on_widget(void* ctx, edge_cases_edge_cases_Widget* widget, edge_cases_edge_cases_Widget* fallback, const uint8_t* children_ptr, size_t children_len, edge_cases_error* out_err) {
        Widget widget_arg(adopt, widget);
        std::optional<Widget> fallback_arg;
        if (fallback != nullptr) fallback_arg.emplace(adopt, fallback);
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            std::vector<Widget> children_arg = detail::decode(children_ptr, children_len, &detail::read_list_Widget);
            impl.on_widget(std::move(widget_arg), std::move(fallback_arg), std::move(children_arg));
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::on_widget threw a non-standard exception");
        }
    }

    static void on_tick(void* ctx, edge_cases_error* out_err) {
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            impl.on_tick();
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::on_tick threw a non-standard exception");
        }
    }

    static bool should_continue(void* ctx, int32_t class_, edge_cases_error* out_err) {
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            return impl.should_continue(class_);
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::should_continue threw a non-standard exception");
        }
        return bool{};
    }

    static edge_cases_edge_cases_Mode pick_mode(void* ctx, edge_cases_error* out_err) {
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            return static_cast<edge_cases_edge_cases_Mode>(static_cast<int32_t>(impl.pick_mode()));
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::pick_mode threw a non-standard exception");
        }
        return edge_cases_edge_cases_Mode{};
    }

    /** Deletes the implementation box once the producer releases it. */
    static void free_ctx(void* ctx) {
        delete static_cast<std::shared_ptr<BatchListener>*>(ctx);
    }
};

/** The vtable every `BatchListener` implementation is passed with. */
inline const edge_cases_edge_cases_BatchListener_vtable& BatchListener_vtable() {
    static const edge_cases_edge_cases_BatchListener_vtable vtable = {
        static_cast<uint32_t>(sizeof(edge_cases_edge_cases_BatchListener_vtable)),
        0,
        &BatchListener_trampolines::free_ctx,
        &BatchListener_trampolines::on_batch,
        &BatchListener_trampolines::on_widget,
        &BatchListener_trampolines::on_tick,
        &BatchListener_trampolines::should_continue,
        &BatchListener_trampolines::pick_mode,
    };
    return vtable;
}

} // namespace detail

/**
 * Callback interface whose name and methods are keywords
 *
 * Subclass it and pass a `std::shared_ptr<Keyword>` where the API takes a `Keyword`. The producer may call the methods from any thread, so they must be thread-safe, until it releases the implementation (also from any thread). An exception a method throws reaches the producer as a callback failure (code -4).
 */
class Keyword {
public:
    virtual ~Keyword() = default;

    virtual void delete_(int32_t self) = 0;

    virtual int32_t import() = 0;
};

namespace detail {

/** Trampolines adapting a `Keyword` implementation to `edge_cases_edge_cases_Keyword_vtable`. */
struct Keyword_trampolines {
    static void delete_(void* ctx, int32_t self, edge_cases_error* out_err) {
        try {
            Keyword& impl = **static_cast<std::shared_ptr<Keyword>*>(ctx);
            impl.delete_(self);
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "Keyword::delete_ threw a non-standard exception");
        }
    }

    static int32_t import(void* ctx, edge_cases_error* out_err) {
        try {
            Keyword& impl = **static_cast<std::shared_ptr<Keyword>*>(ctx);
            return impl.import();
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "Keyword::import threw a non-standard exception");
        }
        return int32_t{};
    }

    /** Deletes the implementation box once the producer releases it. */
    static void free_ctx(void* ctx) {
        delete static_cast<std::shared_ptr<Keyword>*>(ctx);
    }
};

/** The vtable every `Keyword` implementation is passed with. */
inline const edge_cases_edge_cases_Keyword_vtable& Keyword_vtable() {
    static const edge_cases_edge_cases_Keyword_vtable vtable = {
        static_cast<uint32_t>(sizeof(edge_cases_edge_cases_Keyword_vtable)),
        0,
        &Keyword_trampolines::free_ctx,
        &Keyword_trampolines::delete_,
        &Keyword_trampolines::import,
    };
    return vtable;
}

} // namespace detail

inline void Widget::refresh() const {
    edge_cases_error err{};
    edge_cases_edge_cases_Widget_refresh(raw_, &err);
    detail::check_edge_cases(err);
}

inline std::string Widget::rename(std::string_view class_, const std::optional<std::string>& import) const {
    detail::BufferWriter import_buf;
    detail::write_opt_string(import_buf, import);
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_Widget_rename(raw_, detail::utf8(class_), class_.size(), import_buf.data(), import_buf.size(), &out_len, &err);
    detail::check(err);
    return detail::take_string(result, out_len);
}

inline std::future<Outer> Widget::fetch(int64_t id) const {
    auto promise = std::make_unique<std::promise<Outer>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_Widget_fetch(raw_, id, [](void* context, edge_cases_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<Outer>> p(static_cast<std::promise<Outer>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string message = detail::error_message(*err);
                p->set_exception(detail::make_edge_cases_error(err->code, message, err->payload_ptr, err->payload_len));
            } else {
                p->set_value(detail::take(result_ptr, result_len, &detail::read_Outer));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

inline std::string Widget::old_name() const {
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_Widget_old_name(raw_, &out_len, &err);
    detail::check(err);
    return detail::take_string(result, out_len);
}

inline bool Widget::close() const {
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_Widget_close(raw_, &err);
    detail::check(err);
    return result;
}

inline void Widget::dispose(bool force) const {
    edge_cases_error err{};
    edge_cases_edge_cases_Widget_dispose(raw_, force, &err);
    detail::check(err);
}

inline Vault Vault::open(std::string_view path) {
    check_library();
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_Vault_open(detail::utf8(path), path.size(), &err);
    detail::check_edge_cases(err);
    return Vault(adopt, result);
}

inline std::optional<Widget> Vault::peek() const {
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_Vault_peek(raw_, &err);
    detail::check(err);
    return result != nullptr ? std::optional<Widget>(std::in_place, adopt, result) : std::nullopt;
}

inline int64_t Vault::handle_() const {
