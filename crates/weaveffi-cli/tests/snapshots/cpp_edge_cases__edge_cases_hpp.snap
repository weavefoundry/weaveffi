/** Interface with no constructor; instances come from make_widget */
class Widget {
    edge_cases_edge_cases_Widget* handle_;

public:
    /** The C type this class wraps. */
    using raw_type = edge_cases_edge_cases_Widget;

    /** Adopts one strong reference to a producer object: `Widget(adopt, raw)`. */
    explicit Widget(adopt_t, edge_cases_edge_cases_Widget* h) noexcept : handle_(h) {}

    /** Releases this wrapper's reference; the object is dropped with its last one. */
    ~Widget() {
        if (handle_) edge_cases_edge_cases_Widget_destroy(handle_);
    }

    /** Copies share the object: the copy takes a new strong reference. */
    Widget(const Widget& other) : handle_(edge_cases_edge_cases_Widget_clone(other.handle_)) {}

    Widget& operator=(const Widget& other) {
        if (this != &other) {
            edge_cases_edge_cases_Widget* h = edge_cases_edge_cases_Widget_clone(other.handle_);
            if (handle_) edge_cases_edge_cases_Widget_destroy(handle_);
            handle_ = h;
        }
        return *this;
    }

    Widget(Widget&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    Widget& operator=(Widget&& other) noexcept {
        if (this != &other) {
            if (handle_) edge_cases_edge_cases_Widget_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** The wrapped pointer, borrowed: this wrapper keeps its reference. */
    const edge_cases_edge_cases_Widget* handle() const { return handle_; }

    /** A new strong reference the caller owns (for example to write into a value buffer). */
    edge_cases_edge_cases_Widget* clone_handle() const { return edge_cases_edge_cases_Widget_clone(handle_); }

    /** Void method that can fail */
    void refresh() const;

    std::string rename(std::string_view class_, const std::optional<std::string>& import) const;

    /** Async method with a struct result */
    std::future<Outer> fetch(int64_t id) const;

    [[deprecated("Use rename instead")]]
    std::string old_name() const;

};

