} // namespace detail

/** Typed errors reported by the `edge_cases` module's throwing functions. */
class EdgeErrorsError : public Error {
public:
    EdgeErrorsError(int32_t code, const std::string& msg) : Error(code, msg) {}
};

/** Resource is busy */
class BusyError : public EdgeErrorsError {
public:
    explicit BusyError(const std::string& msg) : EdgeErrorsError(7, msg) {}
};

namespace detail {

/** Map a `edge_cases` error code and payload to its typed exception (the runtime exception for negative codes, EdgeErrorsError for unknown codes). */
inline std::exception_ptr make_edge_cases_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    if (code < 0) return make_error(code, msg);
    (void)payload_ptr;
    (void)payload_len;
    switch (code) {
    case 7: return std::make_exception_ptr(BusyError(msg));
    default: return std::make_exception_ptr(EdgeErrorsError(code, msg));
    }
}

/** Throw the typed `edge_cases` exception if `err` carries a nonzero code. */
inline void check_edge_cases(edge_cases_error& err) {
    if (err.code == 0) return;
    std::string msg = error_message(err);
    std::exception_ptr ex = make_edge_cases_error(err.code, msg, err.payload_ptr, err.payload_len);
    edge_cases_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

/**
 * Callback interface carrying composite payloads and objects
 *
 * Implement this interface and pass a `std::shared_ptr<BatchListener>` to any function that accepts one. The producer may call the methods from any thread until it releases its last reference to the implementation. An exception thrown by a method is reported to the producer as a foreign error (code -4) and aborts the call that triggered it.
 */
class BatchListener {
public:
    virtual ~BatchListener() = default;

    /** Composite payloads cross as value buffers */
    virtual void on_batch(const std::vector<Outer>& items, const std::vector<uint8_t>& raw, const std::optional<Outer>& first, Mode mode) = 0;
    /** Objects cross as strong references the consumer must release */
    virtual void on_widget(Widget widget, std::optional<Widget> fallback, const std::vector<Widget>& children) = 0;
    virtual void on_tick() = 0;
    /** Scalar return travels back through the vtable */
    virtual bool should_continue(int32_t class_) = 0;
    /** Enum return travels back as its integer discriminant */
    virtual Mode pick_mode() = 0;
};

namespace detail {

/** Vtable trampolines adapting a `BatchListener` implementation to `edge_cases_edge_cases_BatchListener_vtable`. */
struct BatchListener_trampolines {
    static void on_batch(void* ctx, const uint8_t* items_ptr, size_t items_len, const uint8_t* raw_ptr, size_t raw_len, const uint8_t* first_ptr, size_t first_len, edge_cases_edge_cases_Mode mode, edge_cases_error* out_err) {
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            detail::BufferReader items_r(items_ptr, items_len);
            std::vector<Outer> items_val{};
            {
                size_t items_val_n = items_r.read_count();
                items_val.reserve(items_r.reserve_hint(items_val_n));
                for (size_t items_val_i = 0; items_val_i < items_val_n; ++items_val_i) {
                    Outer items_val_item = detail::read_Outer(items_r);
                    items_val.push_back(std::move(items_val_item));
                }
            }
            items_r.expect_end();
            std::vector<uint8_t> raw_val = detail::borrow_bytes(raw_ptr, raw_len);
            detail::BufferReader first_r(first_ptr, first_len);
            std::optional<Outer> first_val{};
            if (first_r.read_option_flag()) {
                Outer first_val_v = detail::read_Outer(first_r);
                first_val = std::move(first_val_v);
            }
            first_r.expect_end();
            impl.on_batch(items_val, raw_val, first_val, static_cast<Mode>(static_cast<int32_t>(mode)));
            return;
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::on_batch threw a non-standard exception");
        }
    }

    static void on_widget(void* ctx, edge_cases_edge_cases_Widget* widget, edge_cases_edge_cases_Widget* fallback, const uint8_t* children_ptr, size_t children_len, edge_cases_error* out_err) {
        Widget widget_val(adopt, widget);
        std::optional<Widget> fallback_val;
        if (fallback) fallback_val.emplace(adopt, fallback);
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            detail::BufferReader children_r(children_ptr, children_len);
            std::vector<Widget> children_val{};
            {
                size_t children_val_n = children_r.read_count();
                children_val.reserve(children_r.reserve_hint(children_val_n));
                for (size_t children_val_i = 0; children_val_i < children_val_n; ++children_val_i) {
                    Widget children_val_item = Widget(adopt, reinterpret_cast<Widget::raw_type*>(static_cast<uintptr_t>(children_r.read_u64())));
                    children_val.push_back(std::move(children_val_item));
                }
            }
            children_r.expect_end();
            impl.on_widget(std::move(widget_val), std::move(fallback_val), children_val);
            return;
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::on_widget threw a non-standard exception");
        }
    }

    static void on_tick(void* ctx, edge_cases_error* out_err) {
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            impl.on_tick();
            return;
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::on_tick threw a non-standard exception");
        }
    }

    static bool should_continue(void* ctx, int32_t class_, edge_cases_error* out_err) {
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            return impl.should_continue(class_);
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::should_continue threw a non-standard exception");
        }
        return bool{};
    }

    static edge_cases_edge_cases_Mode pick_mode(void* ctx, edge_cases_error* out_err) {
        try {
            BatchListener& impl = **static_cast<std::shared_ptr<BatchListener>*>(ctx);
            return static_cast<edge_cases_edge_cases_Mode>(static_cast<int32_t>(impl.pick_mode()));
        } catch (const std::exception& e) {
            edge_cases_error_set(out_err, -4, e.what());
        } catch (...) {
            edge_cases_error_set(out_err, -4, "BatchListener::pick_mode threw a non-standard exception");
        }
        return edge_cases_edge_cases_Mode{};
    }

    /** Releases the implementation box once the producer drops its last reference. */
    static void free_ctx(void* ctx) {
        delete static_cast<std::shared_ptr<BatchListener>*>(ctx);
    }
