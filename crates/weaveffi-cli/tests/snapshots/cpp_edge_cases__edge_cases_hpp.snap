inline Keywords keywords_roundtrip(const Keywords& value) {
    check_library();
    detail::BufferWriter value_buf;
    detail::write_Keywords(value_buf, value);
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_keywords_roundtrip(value_buf.data(), value_buf.size(), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    Keywords ret = detail::read_Keywords(result_r);
    result_r.expect_end();
    return ret;
}

[[deprecated("Use Mode-based APIs")]]
inline Retired legacy_value(Legacy value) {
    check_library();
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_legacy_value(static_cast<edge_cases_edge_cases_Legacy>(static_cast<int32_t>(value)), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    Retired ret = detail::read_Retired(result_r);
    result_r.expect_end();
    return ret;
}

