namespace edge_cases {

/** No parameters and no result */
inline void noop() {
    check_library();
    edge_cases_error err{};
    edge_cases_edge_cases_noop(&err);
    detail::check(err);
}

/** Function named after a keyword whose parameters are all keywords */
inline int32_t select(int32_t class_, std::string_view from, const std::vector<std::string>& func, const std::optional<int32_t>& range, bool type_) {
    check_library();
    detail::BufferWriter func_buf;
    detail::write_list_string(func_buf, func);
    detail::BufferWriter range_buf;
    detail::write_opt_i32(range_buf, range);
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_select(class_, detail::utf8(from), from.size(), func_buf.data(), func_buf.size(), range_buf.data(), range_buf.size(), type_, &err);
    detail::check(err);
    return result;
}

/** Optional list of optional structs, the deepest legal nesting */
inline std::optional<std::vector<std::optional<Outer>>> nested_optional(const std::optional<std::vector<std::optional<Outer>>>& items) {
    check_library();
    detail::BufferWriter items_buf;
    detail::write_opt_list_opt_Outer(items_buf, items);
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_nested_optional(items_buf.data(), items_buf.size(), &out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_opt_list_opt_Outer);
}

inline std::optional<Mode> optional_params(const std::optional<std::string>& text, const std::optional<int32_t>& count, const std::optional<Outer>& outer, const std::optional<std::vector<std::string>>& tags, const std::optional<std::vector<uint8_t>>& blob, const std::optional<Mode>& mode) {
    check_library();
    detail::BufferWriter text_buf;
    detail::write_opt_string(text_buf, text);
    detail::BufferWriter count_buf;
    detail::write_opt_i32(count_buf, count);
    detail::BufferWriter outer_buf;
    detail::write_opt_Outer(outer_buf, outer);
    detail::BufferWriter tags_buf;
    detail::write_opt_list_string(tags_buf, tags);
    detail::BufferWriter blob_buf;
    detail::write_opt_bytes(blob_buf, blob);
    detail::BufferWriter mode_buf;
    detail::write_opt_Mode(mode_buf, mode);
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_optional_params(text_buf.data(), text_buf.size(), count_buf.data(), count_buf.size(), outer_buf.data(), outer_buf.size(), tags_buf.data(), tags_buf.size(), blob_buf.data(), blob_buf.size(), mode_buf.data(), mode_buf.size(), &out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_opt_Mode);
}

/** Two callback interface parameters on one function */
inline void register_batch(std::shared_ptr<BatchListener> listener, std::shared_ptr<Keyword> keyword) {
    check_library();
    if (!listener) throw std::invalid_argument("listener: null callback interface");
    auto listener_ctx = std::make_unique<std::shared_ptr<BatchListener>>(std::move(listener));
    if (!keyword) throw std::invalid_argument("keyword: null callback interface");
    auto keyword_ctx = std::make_unique<std::shared_ptr<Keyword>>(std::move(keyword));
    edge_cases_error err{};
    edge_cases_edge_cases_register_batch(static_cast<void*>(listener_ctx.release()), &detail::BatchListener_vtable(), static_cast<void*>(keyword_ctx.release()), &detail::Keyword_vtable(), &err);
    detail::check(err);
}

/** Objects in every buffered position */
inline WidgetHolder widgets_everywhere(const std::vector<Widget>& list, const std::unordered_map<std::string, Widget>& by_name, const std::vector<std::optional<Widget>>& sparse, const WidgetHolder& holder) {
    check_library();
    detail::BufferWriter list_buf;
    detail::write_list_Widget(list_buf, list);
    detail::BufferWriter by_name_buf;
    detail::write_map_string_Widget(by_name_buf, by_name);
    detail::BufferWriter sparse_buf;
    detail::write_list_opt_Widget(sparse_buf, sparse);
    detail::BufferWriter holder_buf;
    detail::write_WidgetHolder(holder_buf, holder);
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_widgets_everywhere(list_buf.data(), list_buf.size(), by_name_buf.data(), by_name_buf.size(), sparse_buf.data(), sparse_buf.size(), holder_buf.data(), holder_buf.size(), &out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_WidgetHolder);
}

