        using reference = Mode&;

        /** Binds to `range` and pulls the first element. */
        explicit iterator(ModeStreamIterator* range) : range_(range), current_(range->next()) {}
        reference operator*() { return *current_; }
        pointer operator->() { return &*current_; }
        iterator& operator++() { current_ = range_->next(); return *this; }
        void operator++(int) { current_ = range_->next(); }
        bool operator==(sentinel) const { return !current_.has_value(); }
        bool operator!=(sentinel) const { return current_.has_value(); }
    };

    /** Begins iteration by pulling the first element. */
    iterator begin() { return iterator(this); }

    /** The past-the-end sentinel. */
    sentinel end() const { return sentinel{}; }
};

/**
 * Iterator of enums
 *
 * @return A lazy `ModeStreamIterator` range that streams one element per iteration step and releases the producer iterator when exhausted or destroyed.
 */
inline ModeStreamIterator mode_stream() {
    check_library();
    edge_cases_error err{};
    edge_cases_edge_cases_ModeStreamIterator* iter = edge_cases_edge_cases_mode_stream(&err);
    detail::check(err);
    return ModeStreamIterator(adopt, iter);
}

/** Async with no result */
inline std::future<void> async_void() {
    check_library();
    auto promise = std::make_unique<std::promise<void>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_async_void([](void* context, edge_cases_error* err) {
        std::unique_ptr<std::promise<void>> p(static_cast<std::promise<void>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string msg = detail::error_message(*err);
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                p->set_value();
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

inline std::future<std::vector<uint8_t>> async_bytes(uint32_t size) {
