    WidgetStreamIterator(WidgetStreamIterator&& other) noexcept : handle_(other.handle_) { other.handle_ = nullptr; }

    /** Releases the current iterator and takes over `other`'s. */
    WidgetStreamIterator& operator=(WidgetStreamIterator&& other) noexcept {
        if (this != &other) {
            if (handle_ != nullptr) edge_cases_edge_cases_WidgetStreamIterator_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** Pulls the next element, or `std::nullopt` once exhausted (which releases the producer iterator). A producer error releases the iterator and throws InternalError. */
    std::optional<Widget> next() {
        if (handle_ == nullptr) return std::nullopt;
        edge_cases_error err{};
        edge_cases_edge_cases_Widget* item{};
        int32_t has_item = edge_cases_edge_cases_WidgetStreamIterator_next(handle_, &item, &err);
        if (err.code != 0 || has_item == 0) {
            edge_cases_edge_cases_WidgetStreamIterator_destroy(handle_);
