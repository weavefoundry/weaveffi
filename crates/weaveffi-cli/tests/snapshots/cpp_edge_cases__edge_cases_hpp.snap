            if (err != nullptr && err->code != 0) {
                std::string message = detail::error_message(*err);
                p->set_exception(detail::make_internal_error(err->code, message));
            } else {
                p->set_value(detail::take_string(result_ptr, result_len));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

inline Keywords keywords_roundtrip(const Keywords& value) {
    check_library();
    detail::BufferWriter value_buf;
    detail::write_Keywords(value_buf, value);
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_keywords_roundtrip(value_buf.data(), value_buf.size(), &out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_Keywords);
}

[[deprecated("Use Mode-based APIs")]]
inline Retired legacy_value(Legacy value) {
    check_library();
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_legacy_value(static_cast<edge_cases_edge_cases_Legacy>(static_cast<int32_t>(value)), &out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_Retired);
}

} // namespace edge_cases

