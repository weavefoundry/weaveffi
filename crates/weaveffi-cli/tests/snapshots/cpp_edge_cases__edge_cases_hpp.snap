    return result;
}

inline std::string Vault::to_string() {
    check_library();
    size_t out_len = 0;
    edge_cases_error err{};
    auto result = edge_cases_edge_cases_Vault_to_string(&out_len, &err);
    detail::check(err);
    return detail::take_string(result, out_len);
