}

/** Writes one `Retired` to a value buffer. */
inline void write_Retired(BufferWriter& w, const Retired& v) {
    w.write_i64(v.id);
}

/** Reads one `Retired` from a value buffer. */
inline Retired read_Retired(BufferReader& r) {
    return Retired{
        r.read_i64(),
    };
}

/** Writes one `WidgetHolder` to a value buffer. */
inline void write_WidgetHolder(BufferWriter& w, const WidgetHolder& v) {
    w.write_object(v.primary);
    detail::write_opt_Widget(w, v.fallback);
    detail::write_list_Widget(w, v.extras);
    detail::write_map_string_Widget(w, v.by_name);
}

/** Reads one `WidgetHolder` from a value buffer. */
inline WidgetHolder read_WidgetHolder(BufferReader& r) {
    return WidgetHolder{
        r.read_object<Widget>(),
        detail::read_opt_Widget(r),
        detail::read_list_Widget(r),
        detail::read_map_string_Widget(r),
    };
}

/** Writes one `[Leaf]` to a value buffer. */
inline void write_list_Leaf(BufferWriter& w, const std::vector<Leaf>& v) {
    w.write_len(v.size());
    for (const auto& item : v) detail::write_Leaf(w, item);
}

/** Reads one `[Leaf]` from a value buffer. */
inline std::vector<Leaf> read_list_Leaf(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<Leaf> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(detail::read_Leaf(r));
    return v;
}

/** Writes one `Inner?` to a value buffer. */
inline void write_opt_Inner(BufferWriter& w, const std::optional<Inner>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) detail::write_Inner(w, *v);
}

/** Reads one `Inner?` from a value buffer. */
inline std::optional<Inner> read_opt_Inner(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<Inner>(detail::read_Inner(r));
}

/** Writes one `{string:Inner}` to a value buffer. */
inline void write_map_string_Inner(BufferWriter& w, const std::unordered_map<std::string, Inner>& v) {
    w.write_len(v.size());
    for (const auto& entry : v) {
        w.write_string(entry.first);
        detail::write_Inner(w, entry.second);
    }
}

/** Reads one `{string:Inner}` from a value buffer. */
inline std::unordered_map<std::string, Inner> read_map_string_Inner(BufferReader& r) {
    size_t n = r.read_count();
    std::unordered_map<std::string, Inner> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) {
        std::string key = r.read_string();
        Inner value = detail::read_Inner(r);
        if (!v.emplace(std::move(key), std::move(value)).second) BufferReader::fail("repeated map key");
    }
    return v;
}

/** Writes one `[Mode]` to a value buffer. */
inline void write_list_Mode(BufferWriter& w, const std::vector<Mode>& v) {
    w.write_len(v.size());
    for (const auto& item : v) w.write_i32(static_cast<int32_t>(item));
}

/** Reads one `[Mode]` from a value buffer. */
inline std::vector<Mode> read_list_Mode(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<Mode> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(static_cast<Mode>(r.read_i32()));
    return v;
}

/** Writes one `[i32]` to a value buffer. */
inline void write_list_i32(BufferWriter& w, const std::vector<int32_t>& v) {
    w.write_len(v.size());
    for (const auto& item : v) w.write_i32(item);
}

/** Reads one `[i32]` from a value buffer. */
inline std::vector<int32_t> read_list_i32(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<int32_t> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(r.read_i32());
    return v;
}

/** Writes one `[[i32]]` to a value buffer. */
inline void write_list_list_i32(BufferWriter& w, const std::vector<std::vector<int32_t>>& v) {
    w.write_len(v.size());
    for (const auto& item : v) detail::write_list_i32(w, item);
}

/** Reads one `[[i32]]` from a value buffer. */
inline std::vector<std::vector<int32_t>> read_list_list_i32(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<std::vector<int32_t>> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(detail::read_list_i32(r));
    return v;
}

/** Writes one `i64?` to a value buffer. */
inline void write_opt_i64(BufferWriter& w, const std::optional<int64_t>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) w.write_i64(*v);
}

/** Reads one `i64?` from a value buffer. */
inline std::optional<int64_t> read_opt_i64(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<int64_t>(r.read_i64());
}

/** Writes one `[i64?]` to a value buffer. */
inline void write_list_opt_i64(BufferWriter& w, const std::vector<std::optional<int64_t>>& v) {
    w.write_len(v.size());
    for (const auto& item : v) detail::write_opt_i64(w, item);
}

/** Reads one `[i64?]` from a value buffer. */
inline std::vector<std::optional<int64_t>> read_list_opt_i64(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<std::optional<int64_t>> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(detail::read_opt_i64(r));
    return v;
}

/** Writes one `bytes?` to a value buffer. */
inline void write_opt_bytes(BufferWriter& w, const std::optional<std::vector<uint8_t>>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) w.write_bytes(*v);
}

/** Reads one `bytes?` from a value buffer. */
inline std::optional<std::vector<uint8_t>> read_opt_bytes(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<std::vector<uint8_t>>(r.read_bytes());
}

/** Writes one `string?` to a value buffer. */
inline void write_opt_string(BufferWriter& w, const std::optional<std::string>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) w.write_string(*v);
}

/** Reads one `string?` from a value buffer. */
inline std::optional<std::string> read_opt_string(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<std::string>(r.read_string());
}

/** Writes one `{i64:string}` to a value buffer. */
inline void write_map_i64_string(BufferWriter& w, const std::unordered_map<int64_t, std::string>& v) {
    w.write_len(v.size());
    for (const auto& entry : v) {
        w.write_i64(entry.first);
        w.write_string(entry.second);
    }
}

/** Reads one `{i64:string}` from a value buffer. */
inline std::unordered_map<int64_t, std::string> read_map_i64_string(BufferReader& r) {
    size_t n = r.read_count();
    std::unordered_map<int64_t, std::string> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) {
        int64_t key = r.read_i64();
        std::string value = r.read_string();
        if (!v.emplace(std::move(key), std::move(value)).second) BufferReader::fail("repeated map key");
    }
    return v;
}

/** Writes one `Widget?` to a value buffer. */
inline void write_opt_Widget(BufferWriter& w, const std::optional<Widget>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) w.write_object(*v);
}

/** Reads one `Widget?` from a value buffer. */
inline std::optional<Widget> read_opt_Widget(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<Widget>(r.read_object<Widget>());
}

/** Writes one `[Widget]` to a value buffer. */
inline void write_list_Widget(BufferWriter& w, const std::vector<Widget>& v) {
    w.write_len(v.size());
    for (const auto& item : v) w.write_object(item);
}

/** Reads one `[Widget]` from a value buffer. */
inline std::vector<Widget> read_list_Widget(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<Widget> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(r.read_object<Widget>());
    return v;
}

/** Writes one `{string:Widget}` to a value buffer. */
inline void write_map_string_Widget(BufferWriter& w, const std::unordered_map<std::string, Widget>& v) {
    w.write_len(v.size());
    for (const auto& entry : v) {
        w.write_string(entry.first);
        w.write_object(entry.second);
    }
}

/** Reads one `{string:Widget}` from a value buffer. */
inline std::unordered_map<std::string, Widget> read_map_string_Widget(BufferReader& r) {
    size_t n = r.read_count();
    std::unordered_map<std::string, Widget> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) {
        std::string key = r.read_string();
        Widget value = r.read_object<Widget>();
        if (!v.emplace(std::move(key), std::move(value)).second) BufferReader::fail("repeated map key");
    }
    return v;
}

/** Writes one `[string]` to a value buffer. */
inline void write_list_string(BufferWriter& w, const std::vector<std::string>& v) {
    w.write_len(v.size());
    for (const auto& item : v) w.write_string(item);
}

/** Reads one `[string]` from a value buffer. */
inline std::vector<std::string> read_list_string(BufferReader& r) {
