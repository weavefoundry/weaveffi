/** Writes one `Leaf` to a value buffer. */
inline void write_Leaf(BufferWriter& w, const Leaf& v) {
    w.write_f32(v.weight);
}

/** Reads one `Leaf` from a value buffer. */
inline Leaf read_Leaf(BufferReader& r) {
    return Leaf{
        r.read_f32(),
    };
}

/** Writes one `Inner` to a value buffer. */
inline void write_Inner(BufferWriter& w, const Inner& v) {
    detail::write_Leaf(w, v.leaf);
    detail::write_list_Leaf(w, v.leaves);
}

/** Reads one `Inner` from a value buffer. */
inline Inner read_Inner(BufferReader& r) {
    return Inner{
        detail::read_Leaf(r),
        detail::read_list_Leaf(r),
    };
}

/** Writes one `Outer` to a value buffer. */
inline void write_Outer(BufferWriter& w, const Outer& v) {
    detail::write_Inner(w, v.inner);
    detail::write_opt_Inner(w, v.maybe_inner);
    detail::write_map_string_Inner(w, v.by_name);
    detail::write_list_Mode(w, v.modes);
    detail::write_list_list_i32(w, v.matrix);
    detail::write_list_opt_i64(w, v.sparse);
    detail::write_opt_bytes(w, v.blob);
    detail::write_opt_string(w, v.note);
    detail::write_map_i64_string(w, v.by_id);
    w.write_bool(v._hidden);
    w.write_u8(v.v2);
}

/** Reads one `Outer` from a value buffer. */
inline Outer read_Outer(BufferReader& r) {
    return Outer{
        detail::read_Inner(r),
        detail::read_opt_Inner(r),
        detail::read_map_string_Inner(r),
        detail::read_list_Mode(r),
        detail::read_list_list_i32(r),
        detail::read_list_opt_i64(r),
        detail::read_opt_bytes(r),
        detail::read_opt_string(r),
        detail::read_map_i64_string(r),
        r.read_bool(),
        r.read_u8(),
    };
}

/** Writes one `Keywords` to a value buffer. */
inline void write_Keywords(BufferWriter& w, const Keywords& v) {
    w.write_i32(v.class_);
    w.write_i32(v.def);
    w.write_i32(v.import);
    w.write_i32(v.from);
    w.write_i32(v.func);
    w.write_i32(v.range);
    w.write_i32(v.register_);
    w.write_i32(v.volatile_);
    w.write_i32(v.new_);
    w.write_i32(v.default_);
    w.write_i32(v.end);
    w.write_i32(v.in);
    w.write_i32(v.is);
    w.write_i32(v.int_);
    w.write_i32(v.var);
    w.write_i32(v.val);
    w.write_i32(v.self);
    w.write_i32(v.this_);
    w.write_i32(v.object);
    w.write_i32(v.string);
    w.write_i32(v.case_);
    w.write_i32(v.select);
    w.write_i32(v.switch_);
    w.write_i32(v.void_);
    w.write_i32(v.union_);
    w.write_i32(v.namespace_);
    w.write_i32(v.operator_);
    w.write_i32(v.template_);
    w.write_i32(v.package);
    w.write_i32(v.protocol);
    w.write_i32(v.guard);
    w.write_i32(v.defer);
    w.write_i32(v.inout);
    w.write_i32(v.internal);
    w.write_i32(v.when);
    w.write_i32(v.fun);
    w.write_i32(v.data);
    w.write_i32(v.late);
    w.write_i32(v.part);
    w.write_i32(v.out);
    w.write_i32(v.ref);
    w.write_i32(v.event);
    w.write_i32(v.base);
    w.write_i32(v.lambda);
    w.write_i32(v.yield);
    w.write_i32(v.nil);
    w.write_i32(v.null);
    w.write_i32(v.begin);
    w.write_i32(v.rescue);
    w.write_i32(v.module);
    w.write_i32(v.chan);
    w.write_i32(v.go);
    w.write_i32(v.let);
    w.write_i32(v.export_);
    w.write_i32(v.delete_);
    w.write_i32(v.typedef_);
    w.write_i32(v.sizeof_);
    w.write_i32(v.static_);
    w.write_i32(v.super);
}

/** Reads one `Keywords` from a value buffer. */
