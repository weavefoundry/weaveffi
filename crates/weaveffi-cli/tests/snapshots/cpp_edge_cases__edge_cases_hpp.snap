/**
 * Async returning an object
 *
 * @return A future settled from a producer thread; get() rethrows the call's error.
 * @throws EdgeErrorsError when the call fails with one of the domain's codes.
 */
inline std::future<Widget> async_widget() {
    check_library();
    auto promise = std::make_unique<std::promise<Widget>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_async_widget([](void* context, edge_cases_error* err, edge_cases_edge_cases_Widget* result) {
        std::unique_ptr<std::promise<Widget>> p(static_cast<std::promise<Widget>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string message = detail::error_message(*err);
                p->set_exception(detail::make_edge_cases_error(err->code, message, err->payload_ptr, err->payload_len));
            } else {
                p->set_value(Widget(adopt, result));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        edge_cases_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

