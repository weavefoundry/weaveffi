    auto promise = std::make_unique<std::promise<void>>();
    auto future = promise->get_future();
    edge_cases_edge_cases_async_void([](void* context, edge_cases_error* err) {
        std::unique_ptr<std::promise<void>> p(static_cast<std::promise<void>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
