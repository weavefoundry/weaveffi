/** Encodes a `WidgetHolder` in the value-buffer wire format. */
inline void write_WidgetHolder(BufferWriter& w, const WidgetHolder& v) {
    w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(v.primary.clone_handle())));
    w.write_option_flag(v.fallback.has_value());
    if (v.fallback.has_value()) {
        w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>((*v.fallback).clone_handle())));
    }
    w.write_len(v.extras.size());
    for (const auto& item0 : v.extras) {
        w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(item0.clone_handle())));
    }
    w.write_len(v.by_name.size());
    for (const auto& kv0 : v.by_name) {
        w.write_string(kv0.first);
        w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(kv0.second.clone_handle())));
    }
}

/** Decodes a `WidgetHolder` from the value-buffer wire format. */
inline WidgetHolder read_WidgetHolder(BufferReader& r) {
    Widget f_primary = Widget(adopt, reinterpret_cast<Widget::raw_type*>(static_cast<uintptr_t>(r.read_u64())));
    std::optional<Widget> f_fallback{};
    if (r.read_option_flag()) {
        Widget f_fallback_v = Widget(adopt, reinterpret_cast<Widget::raw_type*>(static_cast<uintptr_t>(r.read_u64())));
        f_fallback = std::move(f_fallback_v);
    }
    std::vector<Widget> f_extras{};
    {
        size_t f_extras_n = r.read_count();
        f_extras.reserve(r.reserve_hint(f_extras_n));
        for (size_t f_extras_i = 0; f_extras_i < f_extras_n; ++f_extras_i) {
            Widget f_extras_item = Widget(adopt, reinterpret_cast<Widget::raw_type*>(static_cast<uintptr_t>(r.read_u64())));
            f_extras.push_back(std::move(f_extras_item));
        }
    }
    std::unordered_map<std::string, Widget> f_by_name{};
    {
        size_t f_by_name_n = r.read_count();
        for (size_t f_by_name_i = 0; f_by_name_i < f_by_name_n; ++f_by_name_i) {
            std::string f_by_name_key = r.read_string();
            Widget f_by_name_val = Widget(adopt, reinterpret_cast<Widget::raw_type*>(static_cast<uintptr_t>(r.read_u64())));
            f_by_name.emplace(std::move(f_by_name_key), std::move(f_by_name_val));
        }
    }
    return WidgetHolder{std::move(f_primary), std::move(f_fallback), std::move(f_extras), std::move(f_by_name)};
