// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

package com.weaveffi

class WeaveFFI {
    companion object {
        init { System.loadLibrary("weaveffi") }

        /**
         * Render a shape to a string
         */
        @JvmStatic private external fun describeJni(shape: ByteArray): String
        @JvmStatic fun describe(shape: Shape): String = describeJni(weaveEncode { w -> packShape(w, shape) })
        /**
         * Scale a shape by a factor, returning a new shape
         */
        @JvmStatic private external fun scaleJni(shape: ByteArray, factor: Double): ByteArray
        @JvmStatic fun scale(shape: Shape, factor: Double): Shape = weaveDecode(scaleJni(weaveEncode { w -> packShape(w, shape) }, factor)) { r -> unpackShape(r) }
        /**
         * Sum a list of bytes into a wide integer (numerics smoke)
         */
        @JvmStatic external fun sumBytes(values: ByteArray): Long
        /**
         * Build a Numerics struct from every numeric primitive
         */
        @JvmStatic private external fun makeNumericsJni(a: Byte, b: Short, c: Int, d: Long, e: Byte, f: Short, g: Long, h: Long, i: Float, j: Double): ByteArray
        @JvmStatic fun makeNumerics(a: Byte, b: Short, c: Int, d: Long, e: Byte, f: Short, g: Long, h: Long, i: Float, j: Double): Numerics = weaveDecode(makeNumericsJni(a, b, c, d, e, f, g, h, i, j)) { r -> unpackNumerics(r) }
    }
}

/** An algebraic shape (sum type with associated data) */
sealed class Shape {
    /** The empty shape (a unit variant) */
    object Empty : Shape()
    /** A circle with a radius */
    data class Circle(
        /** Radius in points */
        val radius: Double,
    ) : Shape()
    /** An axis-aligned rectangle */
    data class Rectangle(val width: Float, val height: Float) : Shape()
    /** An integer-bounded shape (exercises narrow + wide ints) */
    data class Bounded(val min: Short, val max: Short, val weight: Long) : Shape()
    /** A labeled shape with a small count */
    data class Labeled(val label: String, val count: Byte) : Shape()
}

internal fun packShape(w: WeaveBufferWriter, v: Shape) {
    when (v) {
        is Shape.Empty -> w.writeI32(0)
        is Shape.Circle -> {
            w.writeI32(1)
            w.writeF64(v.radius)
        }
        is Shape.Rectangle -> {
            w.writeI32(2)
            w.writeF32(v.width)
            w.writeF32(v.height)
        }
        is Shape.Bounded -> {
            w.writeI32(3)
            w.writeI16(v.min)
            w.writeI16(v.max)
            w.writeI64(v.weight)
        }
        is Shape.Labeled -> {
            w.writeI32(4)
            w.writeString(v.label)
            w.writeI8(v.count)
        }
    }
}

internal fun unpackShape(r: WeaveBufferReader): Shape = when (val tag = r.readI32()) {
    0 -> Shape.Empty
    1 -> Shape.Circle(r.readF64())
    2 -> Shape.Rectangle(r.readF32(), r.readF32())
    3 -> Shape.Bounded(r.readI16(), r.readI16(), r.readI64())
    4 -> Shape.Labeled(r.readString(), r.readI8())
    else -> throw WeaveFFIException(-2, "malformed WeaveFFI value buffer: unknown Shape tag $tag")
}

/** A plain C-style enum (no payloads) */
enum class Channel(val value: Int) {
    Red(0),
    Green(1),
    Blue(2);

    companion object {
        fun fromValue(value: Int): Channel = entries.first { it.value == value }
    }
}

/** One field per supported numeric primitive */
data class Numerics(val a: Byte, val b: Short, val c: Int, val d: Long, val e: Byte, val f: Short, val g: Long, val h: Long, val i: Float, val j: Double)

internal fun packNumerics(w: WeaveBufferWriter, v: Numerics) {
    w.writeI8(v.a)
    w.writeI16(v.b)
    w.writeI32(v.c)
    w.writeI64(v.d)
    w.writeI8(v.e)
    w.writeI16(v.f)
    w.writeU32(v.g)
    w.writeI64(v.h)
    w.writeF32(v.i)
    w.writeF64(v.j)
}

internal fun unpackNumerics(r: WeaveBufferReader): Numerics = Numerics(
    r.readI8(),
    r.readI16(),
    r.readI32(),
    r.readI64(),
    r.readI8(),
    r.readI16(),
    r.readU32(),
    r.readI64(),
    r.readF32(),
    r.readF64(),
)

/** Generic WeaveFFI failure: panics, marshalling errors, and unknown codes. */
open class WeaveFFIException(val code: Int, message: String) : Exception(message)

/** Growable little-endian writer implementing the WeaveFFI value-buffer wire format. */
internal class WeaveBufferWriter {
    private var buf = ByteArray(32)
    private var len = 0

    private fun reserve(extra: Int) {
        if (len + extra <= buf.size) return
        var cap = buf.size * 2
        while (cap < len + extra) cap *= 2
        buf = buf.copyOf(cap)
    }

    fun toByteArray(): ByteArray = buf.copyOf(len)

    fun writeBool(v: Boolean) { reserve(1); buf[len++] = if (v) 1 else 0 }
    fun writeI8(v: Byte) { reserve(1); buf[len++] = v }
    fun writeI16(v: Short) {
        reserve(2)
        val b = v.toInt()
        buf[len++] = (b and 0xFF).toByte()
        buf[len++] = ((b shr 8) and 0xFF).toByte()
    }
    fun writeI32(v: Int) {
        reserve(4)
        buf[len++] = (v and 0xFF).toByte()
        buf[len++] = ((v shr 8) and 0xFF).toByte()
        buf[len++] = ((v shr 16) and 0xFF).toByte()
        buf[len++] = ((v shr 24) and 0xFF).toByte()
    }
    fun writeU32(v: Long) = writeI32(v.toInt())
    fun writeI64(v: Long) {
        writeI32(v.toInt())
        writeI32((v ushr 32).toInt())
    }
    fun writeF32(v: Float) = writeI32(v.toRawBits())
    fun writeF64(v: Double) = writeI64(v.toRawBits())
    fun writeString(v: String) = writeBytes(v.toByteArray(Charsets.UTF_8))
    fun writeBytes(v: ByteArray) {
        writeI32(v.size)
        reserve(v.size)
        v.copyInto(buf, len)
        len += v.size
    }
    fun <T> writeOptional(v: T?, write: (T) -> Unit) {
        if (v == null) writeBool(false) else { writeBool(true); write(v) }
    }
    fun <T> writeList(v: List<T>, write: (T) -> Unit) {
        writeI32(v.size)
        for (e in v) write(e)
    }
    fun <K, V> writeMap(v: Map<K, V>, writeKey: (K) -> Unit, writeValue: (V) -> Unit) {
        writeI32(v.size)
        for ((k, e) in v) { writeKey(k); writeValue(e) }
    }
}

/** Validating little-endian reader for the WeaveFFI value-buffer wire format. */
internal class WeaveBufferReader(private val buf: ByteArray) {
    private var pos = 0

    private fun malformed(detail: String): Nothing =
        throw WeaveFFIException(-2, "malformed WeaveFFI value buffer: " + detail)

    private fun take(n: Int): Int {
        if (n > buf.size - pos) malformed("truncated buffer")
        val at = pos
        pos += n
        return at
    }

    fun readBool(): Boolean = when (buf[take(1)].toInt()) {
        0 -> false
        1 -> true
        else -> malformed("invalid bool byte")
    }
    fun readI8(): Byte = buf[take(1)]
    fun readI16(): Short {
        val at = take(2)
        return ((buf[at].toInt() and 0xFF) or ((buf[at + 1].toInt() and 0xFF) shl 8)).toShort()
    }
    fun readI32(): Int {
        val at = take(4)
        return (buf[at].toInt() and 0xFF) or
            ((buf[at + 1].toInt() and 0xFF) shl 8) or
            ((buf[at + 2].toInt() and 0xFF) shl 16) or
            ((buf[at + 3].toInt() and 0xFF) shl 24)
    }
    fun readU32(): Long = readI32().toLong() and 0xFFFFFFFFL
    fun readI64(): Long {
        val lo = readI32().toLong() and 0xFFFFFFFFL
        val hi = readI32().toLong()
        return lo or (hi shl 32)
    }
    fun readF32(): Float = Float.fromBits(readI32())
    fun readF64(): Double = Double.fromBits(readI64())
    private fun readLen(): Int {
        val n = readI32()
        if (n < 0 || n > buf.size - pos) malformed("length prefix exceeds remaining bytes")
        return n
    }
    fun readString(): String {
        val n = readLen()
        val at = take(n)
        return try {
            Charsets.UTF_8.newDecoder().decode(java.nio.ByteBuffer.wrap(buf, at, n)).toString()
        } catch (e: java.nio.charset.CharacterCodingException) {
            malformed("string is not valid UTF-8")
        }
    }
    fun readBytes(): ByteArray {
        val n = readLen()
        val at = take(n)
        return buf.copyOfRange(at, at + n)
    }
    fun <T> readOptional(read: () -> T): T? = if (readBool()) read() else null
    fun <T> readList(read: () -> T): List<T> {
        val n = readLen()
        val out = ArrayList<T>(n)
        repeat(n) { out.add(read()) }
        return out
    }
    fun <K, V> readMap(readKey: () -> K, readValue: () -> V): Map<K, V> {
        val n = readLen()
        val out = LinkedHashMap<K, V>()
        repeat(n) { out[readKey()] = readValue() }
        return out
    }
    fun expectEnd() {
        if (pos != buf.size) malformed("trailing bytes after value")
    }
}

internal fun weaveEncode(write: (WeaveBufferWriter) -> Unit): ByteArray {
    val w = WeaveBufferWriter()
    write(w)
    return w.toByteArray()
}

internal fun <T> weaveDecode(bytes: ByteArray, read: (WeaveBufferReader) -> T): T {
    val r = WeaveBufferReader(bytes)
    val v = read(r)
    r.expectEnd()
    return v
}

