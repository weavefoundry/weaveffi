// OrdersError is a typed error reported by the `orders` module.
type OrdersError struct {
	// Code is the numeric ABI error code (one of the OrdersError constants).
	Code int32
	// Message is the human-readable error message.
	Message string
}

func (e *OrdersError) Error() string {
	return fmt.Sprintf("orders: %s (code %d)", e.Message, e.Code)
}

// OrdersError codes.
const (
	// OrdersErrorOrderNotFound order not found
	OrdersErrorOrderNotFound int32 = 1
	// OrdersErrorEmptyOrder order must contain at least one item
	OrdersErrorEmptyOrder int32 = 2
)

// wvMapOrders converts a non-zero code from the `orders` domain into a
// *OrdersError, falling back to the generic *WeaveFFIError for unknown codes.
func wvMapOrders(code int32, message string, payload []byte) error {
	switch code {
	case OrdersErrorOrderNotFound:
		if message == "" {
			message = "order not found"
		}
		return &OrdersError{Code: code, Message: message}
	case OrdersErrorEmptyOrder:
		if message == "" {
			message = "order must contain at least one item"
		}
		return &OrdersError{Code: code, Message: message}
	default:
		return wvBrandError(code, message, payload)
	}
}

type OrderItem struct {
	ProductId int64
	Quantity int32
	UnitPrice float64
}

// wvPackOrderItem appends v to w in the value-buffer wire format.
func wvPackOrderItem(w *wvWriter, v OrderItem) {
	w.writeI64(v.ProductId)
	w.writeI32(v.Quantity)
	w.writeF64(v.UnitPrice)
}

// wvUnpackOrderItem decodes one OrderItem from r.
func wvUnpackOrderItem(r *wvReader) OrderItem {
	var v OrderItem
	v.ProductId = r.readI64()
	v.Quantity = r.readI32()
	v.UnitPrice = r.readF64()
	return v
}

type Order struct {
	Id int64
	Items []OrderItem
	Total float64
