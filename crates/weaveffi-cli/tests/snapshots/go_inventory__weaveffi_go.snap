func AddProductToOrder(orderId int64, product Product) bool {
	wProduct := &wvWriter{}
	wvPackProduct(wProduct, product)
	var cProductPtr *C.uint8_t
	if len(wProduct.buf) > 0 {
		cProductPtr = (*C.uint8_t)(unsafe.Pointer(&wProduct.buf[0]))
	}
	var cErr C.weaveffi_error
	result := C.weaveffi_orders_add_product_to_order(C.int64_t(orderId), cProductPtr, C.size_t(len(wProduct.buf)), &cErr)
	wvTrap(&cErr)
	return cToBool(result)
}


