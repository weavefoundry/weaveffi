	case ProductsErrorInvalidPrice:
		if message == "" {
			message = "price must be positive"
		}
		return &ProductsError{Code: code, Message: message}
	case ProductsErrorProductNotFound:
		if message == "" {
			message = "product not found"
		}
		return &ProductsError{Code: code, Message: message}
	default:
		return wvBrandError(code, message, payload)
	}
}

type Category int32

const (
	CategoryElectronics Category = 0
	CategoryClothing Category = 1
	CategoryFood Category = 2
	CategoryBooks Category = 3
)

type Product struct {
	Id int64
	Name string
	Description *string
	Price float64
	Category Category
	Tags []string
}

// wvPackProduct appends v to w in the value-buffer wire format.
func wvPackProduct(w *wvWriter, v Product) {
	w.writeI64(v.Id)
	w.writeString(v.Name)
	if v.Description == nil {
		w.writeOptionFlag(false)
	} else {
		w.writeOptionFlag(true)
		w.writeString((*v.Description))
	}
	w.writeF64(v.Price)
	w.writeI32(int32(v.Category))
	w.writeLen(len(v.Tags))
	for _, eTags0 := range v.Tags {
		w.writeString(eTags0)
	}
}

// wvUnpackProduct decodes one Product from r.
func wvUnpackProduct(r *wvReader) Product {
	var v Product
	v.Id = r.readI64()
	v.Name = r.readString()
	if r.readOptionFlag() {
		var oDescription0 string
		oDescription0 = r.readString()
		v.Description = &oDescription0
	}
	v.Price = r.readF64()
	v.Category = Category(r.readI32())
	nTags0 := r.readLen()
	v.Tags = make([]string, nTags0)
	for iTags0 := range v.Tags {
		v.Tags[iTags0] = r.readString()
	}
	return v
}

// Catalog: A product catalog owning its products
