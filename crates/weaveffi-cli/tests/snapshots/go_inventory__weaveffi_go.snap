}

// wvPackOrder appends v to w in the value-buffer wire format.
func wvPackOrder(w *wvWriter, v Order) {
	w.writeI64(v.Id)
	w.writeLen(len(v.Items))
	for _, eItems0 := range v.Items {
		wvPackOrderItem(w, eItems0)
	}
	w.writeF64(v.Total)
	w.writeString(v.Status)
}

// wvUnpackOrder decodes one Order from r.
func wvUnpackOrder(r *wvReader) Order {
	var v Order
	v.Id = r.readI64()
	nItems0 := r.readLen()
	v.Items = make([]OrderItem, nItems0)
	for iItems0 := range v.Items {
		v.Items[iItems0] = wvUnpackOrderItem(r)
	}
	v.Total = r.readF64()
	v.Status = r.readString()
	return v
}

func CreateOrder(items []OrderItem) (int64, error) {
	wItems := &wvWriter{}
	wItems.writeLen(len(items))
	for _, eItems0 := range items {
		wvPackOrderItem(wItems, eItems0)
	}
	var cItemsPtr *C.uint8_t
	if len(wItems.buf) > 0 {
		cItemsPtr = (*C.uint8_t)(unsafe.Pointer(&wItems.buf[0]))
	}
	var cErr C.weaveffi_error
	result := C.weaveffi_orders_create_order(cItemsPtr, C.size_t(len(wItems.buf)), &cErr)
	if cErr.code != 0 {
		return 0, wvMapOrders(wvTakeError(&cErr))
	}
	return int64(result), nil
}

func GetOrder(id int64) (Order, error) {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_orders_get_order(C.int64_t(id), &cOutLen, &cErr)
