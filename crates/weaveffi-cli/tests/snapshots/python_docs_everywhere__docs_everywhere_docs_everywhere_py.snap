    _check_error(_err)
    return _decode(_take_bytes(_ret, _out_len.value), lambda _r: (_read_Document(_r) if _r.read_flag() else None))


_c_docs_publish_async_callback = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.POINTER(_ErrorStruct), ctypes.c_bool)
_c_docs_publish_async = _bind("docs_everywhere_docs_publish_async", None, ctypes.c_int64, _c_docs_publish_async_callback, ctypes.c_void_p)


def _docs_publish_async_complete(context, err, result) -> None:
    # Runs once, on a producer thread: take ownership of the result
    # here, then hand it to the awaiting event loop.
    try:
        if err:
            _async_settle(context, _async_error(err, _error_from), None)
        else:
            _async_settle(context, None, result)
    except BaseException as exc:
        _async_settle(context, exc, None)


_docs_publish_async_completion = _c_docs_publish_async_callback(_docs_publish_async_complete)


async def publish_async(id: int) -> bool:
    """Publish a document in the background

    Parameters
    ----------
    id : Identifier of the document to publish
    """
    _call, _future = _async_begin()
    try:
        _c_docs_publish_async(id, _docs_publish_async_completion, _call)
    except BaseException:
        _async_abandon(_call)
        raise
    return await _future


