class Error(Exception):
    """An error a fallible call reports.

    `code` is positive for one of the API's declared error codes, raised as
    the declaring module's typed subclasses, and negative for a runtime
    failure of a call that declares errors: a generic failure (-1), a
    producer panic (-2), a marshalling failure (-3), or an exception raised
    by a callback-interface implementation (-4). A cancelled async call (-5)
    raises `asyncio.CancelledError` instead. A call that declares no errors
    never raises this; its failures are bugs and raise `InternalError`.
    """

    GENERIC_ERROR_CODE = -1
    PANIC_ERROR_CODE = -2
    MARSHAL_ERROR_CODE = -3
    FOREIGN_ERROR_CODE = -4
    CANCELLED_ERROR_CODE = -5

