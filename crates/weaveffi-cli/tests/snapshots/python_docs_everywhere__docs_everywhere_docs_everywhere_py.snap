_c_docs_create_document = _bind("docs_everywhere_docs_create_document", ctypes.c_void_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_char_p, ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(_ErrorStruct))


def create_document(title: str, tags: List[str]) -> "Document":
    """
    Create a brand new document.

    The document starts in `Draft` status; callers must publish
    it explicitly to make it visible.

    Parameters
    ----------
    title : Human-readable title for the new document
    tags : Initial set of tags (may be empty)
    """
    _title_b = title.encode("utf-8")
    _tags_w = _Writer()
    _tags_w.write_count(len(tags))
    for _e0 in tags:
        _tags_w.write_string(_e0)
    _err = _ErrorStruct()
    _out_len = ctypes.c_size_t()
    _tags_b = _tags_w.finish()
    _ret = _c_docs_create_document(_title_b, len(_title_b), _tags_b, len(_tags_b), ctypes.byref(_out_len), ctypes.byref(_err))
    _check_error(_err)
    return _decode(_take_bytes(_ret, _out_len.value), _read_Document)


