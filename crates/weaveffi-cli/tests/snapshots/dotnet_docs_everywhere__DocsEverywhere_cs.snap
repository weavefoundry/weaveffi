/// <summary>The value-buffer codec of every composite type the API
/// carries.</summary>
internal static class FfiCodecs
{
    /// <summary>Reads one value that must fill the whole buffer.</summary>
    internal static T Decode<T>(FfiBufferReader reader, Func<FfiBufferReader, T> read)
    {
        var value = read(reader);
        reader.ExpectEnd();
        return value;
    }

    internal static void WriteListOfString(FfiBufferWriter writer, string[] value)
    {
        writer.WriteLen(value.Length);
        foreach (var item in value)
        {
            writer.WriteString(item);
        }
    }

    internal static string[] ReadListOfString(FfiBufferReader reader)
    {
        var count = reader.ReadLen();
        var list = new List<string>(reader.Capacity(count));
        for (var i = 0; i < count; i++)
        {
            list.Add(reader.ReadString());
        }
        return list.ToArray();
    }

    internal static void WriteOptionalOfDocument(FfiBufferWriter writer, Document? value)
    {
        writer.WriteBool(value != null);
        if (value is { } present)
        {
            present.WriteTo(writer);
        }
    }

    internal static Document? ReadOptionalOfDocument(FfiBufferReader reader)
    {
        return reader.ReadBool() ? global::DocsEverywhere.Document.ReadFrom(reader) : null;
    }
}

