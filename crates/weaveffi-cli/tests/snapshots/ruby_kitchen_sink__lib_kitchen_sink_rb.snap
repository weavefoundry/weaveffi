  # The `KitchenErrors` error domain. A code these bindings don't know (from a
  # newer library) raises this class itself, with its code and message.
  class KitchenError < Error
    # Item not found
    class NotFound < KitchenError
      CODE = 1
      MESSAGE = 'Item not found'
    end

    # Invalid input
    class InvalidInput < KitchenError
      CODE = 2
      MESSAGE = 'Invalid input'
    end
  end

  # The `PantryError` error domain. A code these bindings don't know (from a
  # newer library) raises this class itself, with its code and message.
  class PantryError < Error
    # Out of stock
    class OutOfStock < PantryError
      CODE = 1
      MESSAGE = 'Out of stock'

      # @return [String]
      attr_reader :item
    end

    # Spoiled
    class Spoiled < PantryError
      CODE = 2
      MESSAGE = 'Spoiled'
    end
  end

  # Task priority levels
  module Priority
    # Low priority
    LOW = 0
    # Normal priority
    NORMAL = 1
    # High priority
    HIGH = 2
  end

  # A reusable token referenced from several declarations
  #
  # @!attribute [r] id
  #   @return [Integer]
  # @!attribute [r] label
  #   @return [String]
  Token = Data.define(:id, :label)

  # Kitchen sink struct exercising every field feature
  #
  # @!attribute [r] id
  #   @return [Integer] Stable identifier
  # @!attribute [r] name
  #   @return [String] Display name
  # @!attribute [r] count
  #   @return [Integer] Initial count
  # @!attribute [r] enabled
  #   @return [Boolean] Whether the item is enabled
  # @!attribute [r] ratio
  #   @return [Float] Scaling ratio
  # @!attribute [r] nick
  #   @return [Integer]
  # @!attribute [r] payload
  #   @return [String]
  # @!attribute [r] tags
  #   @return [Array<String>]
  # @!attribute [r] attrs
  #   @return [Hash{String => String}]
  # @!attribute [r] parent
  #   @return [Integer, nil]
  # @!attribute [r] token
  #   @return [Token] A record inside a record
  # @!attribute [r] priority
  #   @return [Integer]
  # @!attribute [r] gadget
  #   @return [Gadget, nil] An optional object inside a record
  Item = Data.define(
    :id,
    :name,
    :count,
    :enabled,
    :ratio,
    :nick,
    :payload,
    :tags,
    :attrs,
    :parent,
    :token,
    :priority,
    :gadget,
  )

  # Consumer-implemented observer of ready items
  #
  # A callback interface: pass any object that responds to the methods below
  # wherever a ReadyListener is expected. Including this module documents the
  # intent and supplies NotImplementedError defaults. The library may call the
  # methods from any thread until it releases the implementation.
  module ReadyListener
    # Fires when an item is ready
    #
    # @param code [Integer]
    # @param msg [String]
    # @return [void]
    def on_ready(code, msg)
      raise NotImplementedError, "#{self.class}#on_ready is not implemented"
    end

    # Receives the item itself and says whether to keep listening
    #
    # @param item [Item]
    # @param gadget [Gadget]
    # @return [Boolean]
    def on_item(item, gadget)
      raise NotImplementedError, "#{self.class}#on_item is not implemented"
    end

    # A display label, failing with a kitchen error
    #
    # @return [String]
    # @raise [KitchenError] reported to the library with its code and fields
    def label
      raise NotImplementedError, "#{self.class}#label is not implemented"
    end

    # The most recent item the listener kept, if any
    #
    # @return [Item, nil]
    def latest
      raise NotImplementedError, "#{self.class}#latest is not implemented"
    end

    # The listener's favorite gadget
    #
    # @return [Gadget]
    def favorite
      raise NotImplementedError, "#{self.class}#favorite is not implemented"
    end
  end

  # Consumer-implemented source of scalar samples
  #
  # A callback interface: pass any object that responds to the methods below
  # wherever a Sampler is expected. Including this module documents the intent
  # and supplies NotImplementedError defaults. The library may call the
  # methods from any thread until it releases the implementation.
  module Sampler
    # The cutoff for a level, if the sampler has one
    #
    # @param level [Integer, nil]
    # @return [Float, nil]
    def threshold(level)
      raise NotImplementedError, "#{self.class}#threshold is not implemented"
    end

    # Up to `limit` samples, failing when the pantry is empty
    #
    # @param limit [Integer, nil]
    # @param weights [Array<Float>]
    # @return [Array<Integer>]
    # @raise [PantryError] reported to the library with its code and fields
    def samples(limit, weights)
      raise NotImplementedError, "#{self.class}#samples is not implemented"
    end

    # A free-form description, failing with an untyped error
    #
    # @return [String]
    # @raise [StandardError] reported to the library with its message
    def describe
      raise NotImplementedError, "#{self.class}#describe is not implemented"
    end
  end

  # A pocket-sized interface exercising the object surface
  class Gadget < Bridge::Handle
    # Create a gadget with the given id
    #
    # @param id [Integer]
    def initialize(id)
      id = Bridge.scalar(id, :i64)
      ptr = Bridge.call(nil, :pointer) do |out_err|
        Native.kitchen_sink_Gadget_new(id, out_err)
      end
      _wv_init(ptr)
    end

    # Render the gadget as a human-readable string
    #
    # @return [String]
    def describe
      Bridge.pin(self) do |self_|
        Bridge.call(nil, :string) do |out_err|
          Native.kitchen_sink_Gadget_describe(self_, out_err)
        end
      end
    end

    # Poke the gadget a number of times, failing on a negative count
    #
    # @param times [Integer]
    # @return [Integer]
    # @raise [KitchenError] for a domain error
    def poke(times)
      times = Bridge.scalar(times, :i32)
      Bridge.pin(self) do |self_|
        Bridge.call(KitchenError, :i32) do |out_err|
          Native.kitchen_sink_Gadget_poke(self_, times, out_err)
        end
      end
    end

    # The gadget's sensor readings, optionally limited
    #
    # @param limit [Integer, nil]
    # @return [Array<Float>]
    # @raise [Error] when the call fails
    def readings(limit = nil)
      limit = Bridge.opt_arg(limit, :u32)
      Bridge.pin(self) do |self_|
        Bridge.call(Error, [:slice, :f64]) do |out_err|
          Native.kitchen_sink_Gadget_readings(self_, limit, out_err)
        end
      end
    end

    # The gadget subsystem version string
    #
    # @return [String]
    def self.version
      Bridge.call(nil, :string) do |out_err|
        Native.kitchen_sink_Gadget_version(out_err)
      end
    end
  end

  # A trivial helper
  #
  # @return [String]
  def self.ping
    Bridge.call(nil, :string) do |out_err|
      Native.kitchen_sink_ping(out_err)
    end
  end

  # Identity for bool
  #
  # @param x [Boolean]
  # @return [Boolean]
  def self.bool_id(x)
    Bridge.call(nil, :bool) do |out_err|
      Native.kitchen_sink_bool_id((x ? true : false), out_err)
    end
  end

  # @param x [Integer]
  # @return [Integer]
  def self.i32_id(x)
    x = Bridge.scalar(x, :i32)
    Bridge.call(nil, :i32) do |out_err|
      Native.kitchen_sink_i32_id(x, out_err)
    end
  end

  # @param x [Integer]
  # @return [Integer]
  def self.u32_id(x)
    x = Bridge.scalar(x, :u32)
    Bridge.call(nil, :u32) do |out_err|
      Native.kitchen_sink_u32_id(x, out_err)
    end
  end

  # @param x [Integer]
  # @return [Integer]
  def self.i64_id(x)
    x = Bridge.scalar(x, :i64)
    Bridge.call(nil, :i64) do |out_err|
      Native.kitchen_sink_i64_id(x, out_err)
    end
  end

  # @param x [Float]
  # @return [Float]
  def self.f64_id(x)
    Bridge.call(nil, :f64) do |out_err|
      Native.kitchen_sink_f64_id(x, out_err)
    end
  end

  # @param s [String]
  # @return [String]
  def self.echo_string(s)
    s = Bridge.string_arg(s)
    Bridge.call(nil, :string) do |out_err|
      Native.kitchen_sink_echo_string(s, out_err)
    end
  end

  # @param b [String]
  # @return [String]
  def self.echo_bytes(b)
    b = Bridge.bytes_arg(b)
    Bridge.call(nil, :bytes) do |out_err|
      Native.kitchen_sink_echo_bytes(b, out_err)
    end
  end

  # Register a listener, returning how many are attached
  #
  # @param listener [ReadyListener]
  # @return [Integer]
  def self.subscribe(listener)
    Bridge.present!(listener, 'listener')
    Bridge.call(nil, :i32) do |out_err|
      Native.kitchen_sink_subscribe(Bridge.register(listener, ReadyListener), out_err)
    end
  end

  # Register a listener if one is given
  #
  # @param listener [ReadyListener, nil]
  # @return [Boolean]
  def self.maybe_subscribe(listener = nil)
    Bridge.call(nil, :bool) do |out_err|
      Native.kitchen_sink_maybe_subscribe(Bridge.register(listener, ReadyListener), out_err)
    end
  end

  # Optional object in both directions
  #
  # @param fallback [Gadget, nil]
  # @return [Gadget, nil]
  def self.maybe_gadget(fallback = nil)
    Bridge.check_object(fallback, Gadget, 'fallback', nullable: true)
    Bridge.pin(fallback) do |fallback|
      Bridge.call(nil, [:object?, Gadget]) do |out_err|
        Native.kitchen_sink_maybe_gadget(fallback, out_err)
      end
    end
  end

  # A list of objects
  #
  # @return [Array<Gadget>]
  def self.gadgets
    Bridge.call(nil, [:buffer, [:list, Gadget]]) do |out_err|
      Native.kitchen_sink_gadgets(out_err)
    end
  end

  # An iterator over objects
  #
  # Returns a lazy Enumerator: each enumeration starts its own native iterator
  # on the first pull and releases it when iteration finishes or stops early.
  #
  # @return [Enumerator<Gadget>]
  def self.stream_gadgets
    Bridge.iterate(
      nil,
      [:object, Gadget],
      :kitchen_sink_StreamGadgetsIterator_next,
      :kitchen_sink_StreamGadgetsIterator_destroy,
    ) do |out_err|
      Native.kitchen_sink_stream_gadgets(out_err)
    end
  end

  # Optional struct return
  #
  # @param id [Integer]
  # @return [Item, nil]
  # @raise [KitchenError] for a domain error
  def self.maybe_item(id)
    id = Bridge.scalar(id, :i64)
    Bridge.call(KitchenError, [:buffer, [:opt, Item]]) do |out_err|
      Native.kitchen_sink_maybe_item(id, out_err)
    end
  end

  # List of structs
  #
  # @return [Array<Item>]
  def self.list_items
    Bridge.call(nil, [:buffer, [:list, Item]]) do |out_err|
      Native.kitchen_sink_list_items(out_err)
    end
  end

  # Map return type
  #
  # @return [Hash{String => Integer}]
  def self.get_attrs
    Bridge.call(nil, [:buffer, [:map, :string, :i32]]) do |out_err|
      Native.kitchen_sink_get_attrs(out_err)
    end
  end

  # Iterator return type
  #
  # Returns a lazy Enumerator: each enumeration starts its own native iterator
  # on the first pull and releases it when iteration finishes or stops early.
  #
  # @return [Enumerator<Item>]
  def self.stream_items
    Bridge.iterate(
      nil,
      [:buffer, Item],
      :kitchen_sink_StreamItemsIterator_next,
      :kitchen_sink_StreamItemsIterator_destroy,
    ) do |out_err|
      Native.kitchen_sink_stream_items(out_err)
    end
  end

  # Returns the shared Token record
  #
  # @return [Token]
  def self.make_token
    Bridge.call(nil, [:buffer, Token]) do |out_err|
      Native.kitchen_sink_make_token(out_err)
    end
  end

  # Async operation
  #
  # Blocks until the call completes on a library thread (under a Fiber
  # scheduler, only the calling Fiber waits).
  #
  # @param input [String]
  # @return [String]
  def self.do_async(input)
    input = Bridge.string_arg(input)
    Bridge.await(nil, :string) do |callback, context|
      Native.kitchen_sink_do_async(input, callback, context)
    end
  end

  # Cancellable async operation
  #
  # Blocks until the call completes on a library thread (under a Fiber
  # scheduler, only the calling Fiber waits).
  #
  # @param input [String]
  # @param cancel [CancelToken, nil] cancels the call, which then raises Cancelled
  # @return [String]
  # @raise [Cancelled] when `cancel` fires first
  def self.do_cancellable(input, cancel: nil)
    input = Bridge.string_arg(input)
    Bridge.await_cancellable(nil, :string, cancel) do |cancel_token, callback, context|
      Native.kitchen_sink_do_cancellable(input, cancel_token, callback, context)
    end
  end

  # Legacy operation kept for compatibility
  #
  # @return [Integer]
  # @deprecated Use `new_op` instead
  def self.legacy_op
    warn('KitchenSink.legacy_op is deprecated: Use `new_op` instead', uplevel: 1, category: :deprecated)
    Bridge.call(nil, :i32) do |out_err|
      Native.kitchen_sink_legacy_op(out_err)
    end
  end

  # Replacement for `legacy_op`
  #
  # @return [Integer]
  def self.new_op
    Bridge.call(nil, :i32) do |out_err|
      Native.kitchen_sink_new_op(out_err)
    end
  end

  # Optional scalar in both directions
  #
  # @param x [Integer, nil]
  # @return [Integer, nil]
  def self.opt_i32_id(x = nil)
    x = Bridge.opt_arg(x, :i32)
    Bridge.call(nil, [:opt, :i32]) do |out_err|
      Native.kitchen_sink_opt_i32_id(x, out_err)
    end
  end

  # @param x [Boolean, nil]
  # @return [Boolean, nil]
  def self.opt_bool_id(x = nil)
    x = Bridge.opt_arg(x, :bool)
    Bridge.call(nil, [:opt, :bool]) do |out_err|
      Native.kitchen_sink_opt_bool_id(x, out_err)
    end
  end

  # Optional C-style enum in both directions
  #
  # @param p [Integer, nil]
  # @return [Integer, nil]
  def self.opt_priority(p = nil)
    p = Bridge.opt_arg(p, :i32)
    Bridge.call(nil, [:opt, :i32]) do |out_err|
      Native.kitchen_sink_opt_priority(p, out_err)
    end
  end

  # Optional scalars next to ordinary parameters
  #
  # @param base [Float]
  # @param scale [Float, nil]
  # @param offset [Integer, nil]
  # @param label [String, nil]
  # @return [Integer, nil]
  def self.opt_mixed(base, scale = nil, offset = nil, label = nil)
    scale = Bridge.opt_arg(scale, :f32)
    offset = Bridge.opt_arg(offset, :i64)
    label = Bridge.encode([:opt, :string], label)
    Bridge.call(nil, [:opt, :u16], label) do |label, out_err|
      Native.kitchen_sink_opt_mixed(base, scale, offset, label, out_err)
    end
  end

  # A typed-array parameter
  #
  # @param xs [Array<Float>]
  # @return [Float]
  def self.sum_f64(xs)
    xs = Bridge.slice_arg(xs, :f64)
    Bridge.call(nil, :f64) do |out_err|
      Native.kitchen_sink_sum_f64(xs, out_err)
    end
  end

  # Typed arrays in both directions
  #
  # @param xs [Array<Integer>]
  # @param factor [Integer]
  # @return [Array<Integer>]
  def self.scale_i32(xs, factor)
    xs = Bridge.slice_arg(xs, :i32)
    factor = Bridge.scalar(factor, :i32)
    Bridge.call(nil, [:slice, :i32]) do |out_err|
      Native.kitchen_sink_scale_i32(xs, factor, out_err)
    end
  end

  # @param ids [Array<Integer>]
  # @return [Array<Integer>]
  def self.ids_u64(ids)
    ids = Bridge.slice_arg(ids, :u64)
    Bridge.call(nil, [:slice, :u64]) do |out_err|
      Native.kitchen_sink_ids_u64(ids, out_err)
    end
  end

  # Every slice element type
  #
  # @param a [Array<Integer>]
  # @param b [Array<Integer>]
  # @param c [Array<Integer>]
  # @param d [Array<Integer>]
  # @param e [Array<Integer>]
  # @param f [Array<Float>]
  # @return [Array<Integer>]
  def self.mixed_slices(a, b, c, d, e, f)
    a = Bridge.slice_arg(a, :i8)
    b = Bridge.slice_arg(b, :i16)
    c = Bridge.slice_arg(c, :u16)
    d = Bridge.slice_arg(d, :u32)
    e = Bridge.slice_arg(e, :i64)
    f = Bridge.slice_arg(f, :f32)
    Bridge.call(nil, [:slice, :u32]) do |out_err|
      Native.kitchen_sink_mixed_slices(a, b, c, d, e, f, out_err)
    end
  end

  # Async returning an optional scalar
  #
  # Blocks until the call completes on a library thread (under a Fiber
  # scheduler, only the calling Fiber waits).
  #
  # @return [Integer, nil]
  def self.async_maybe_count
    Bridge.await(nil, [:opt, :i64]) do |callback, context|
      Native.kitchen_sink_async_maybe_count(callback, context)
    end
  end

  # Async returning a typed array
  #
  # Blocks until the call completes on a library thread (under a Fiber
  # scheduler, only the calling Fiber waits).
  #
  # @param n [Integer]
  # @param cancel [CancelToken, nil] cancels the call, which then raises Cancelled
  # @return [Array<Float>]
  # @raise [Cancelled] when `cancel` fires first
  def self.async_samples(n, cancel: nil)
    n = Bridge.scalar(n, :u32)
    Bridge.await_cancellable(nil, [:slice, :f32], cancel) do |cancel_token, callback, context|
      Native.kitchen_sink_async_samples(n, cancel_token, callback, context)
    end
  end

  # Iterator of optional scalars
  #
  # Returns a lazy Enumerator: each enumeration starts its own native iterator
  # on the first pull and releases it when iteration finishes or stops early.
  #
  # @return [Enumerator<Integer, nil>]
  def self.stream_maybe
    Bridge.iterate(
      nil,
      [:opt, :i32],
      :kitchen_sink_StreamMaybeIterator_next,
      :kitchen_sink_StreamMaybeIterator_destroy,
    ) do |out_err|
      Native.kitchen_sink_stream_maybe(out_err)
    end
  end

  # Iterator of typed arrays
  #
  # Returns a lazy Enumerator: each enumeration starts its own native iterator
  # on the first pull and releases it when iteration finishes or stops early.
  #
  # @return [Enumerator<Array<Integer>>]
  def self.stream_chunks
    Bridge.iterate(
      nil,
      [:slice, :i32],
      :kitchen_sink_StreamChunksIterator_next,
      :kitchen_sink_StreamChunksIterator_destroy,
    ) do |out_err|
      Native.kitchen_sink_stream_chunks(out_err)
    end
  end

  # Drive a consumer-implemented sampler
  #
  # @param sampler [Sampler]
  # @param level [Integer, nil]
  # @return [Array<Integer>]
  # @raise [PantryError] for a domain error
  def self.sample_with(sampler, level = nil)
    Bridge.present!(sampler, 'sampler')
    level = Bridge.opt_arg(level, :u32)
    Bridge.call(PantryError, [:slice, :i16]) do |out_err|
      Native.kitchen_sink_sample_with(Bridge.register(sampler, Sampler), level, out_err)
    end
  end

  # Fails with the second domain
  #
  # @param item [String]
  # @return [Integer]
  # @raise [PantryError] for a domain error
  def self.take_from_pantry(item)
    item = Bridge.string_arg(item)
    Bridge.call(PantryError, :i32) do |out_err|
      Native.kitchen_sink_take_from_pantry(item, out_err)
    end
  end

  # Fails with an untyped error
  #
  # @param text [String]
  # @return [Integer]
  # @raise [Error] when the call fails
  def self.parse_any(text)
    text = Bridge.string_arg(text)
    Bridge.call(Error, :i64) do |out_err|
      Native.kitchen_sink_parse_any(text, out_err)
    end
  end

  # A trivial function returning a string
  #
  # @return [String]
  def self.hello
    Bridge.call(nil, :string) do |out_err|
      Native.kitchen_sink_hello(out_err)
    end
  end

  # === Private registrations ===

  # How the library clones and releases each interface's objects, and how
  # each record, variant, and error payload is laid out in a value buffer.
  Bridge.interface(Gadget, :kitchen_sink_Gadget_clone, :kitchen_sink_Gadget_destroy)
  Bridge.record(Token, id: :i64, label: :string)
  Bridge.record(
    Item,
    id: :i64,
    name: :string,
    count: :i32,
    enabled: :bool,
    ratio: :f64,
    nick: :u32,
    payload: :bytes,
    tags: [:list, :string],
    attrs: [:map, :string, :string],
    parent: [:opt, :i64],
    token: Token,
    priority: :i32,
    gadget: [:opt, Gadget],
  )
  Bridge.record(PantryError::OutOfStock, item: :string)

  # The ReadyListener vtable, one row per method: its name, the error class it
  # may raise, its return, and its parameters.
  Bridge.vtable(
    ReadyListener,
    [:on_ready, nil, nil, [:i32, :string]],
    [:on_item, nil, :bool, [[:buffer, Item], [:object, Gadget]]],
    [:label, KitchenError, :string, []],
    [:latest, nil, [:buffer, [:opt, Item]], []],
    [:favorite, nil, [:object, Gadget], []],
  )

  # The Sampler vtable, one row per method: its name, the error class it may
  # raise, its return, and its parameters.
  Bridge.vtable(
    Sampler,
    [:threshold, nil, [:opt, :f64], [[:opt, :u32]]],
    [:samples, PantryError, [:slice, :i16], [[:opt, :u32], [:slice, :f64]]],
    [:describe, Error, :string, []],
  )
end

# END kitchen_sink.rb
