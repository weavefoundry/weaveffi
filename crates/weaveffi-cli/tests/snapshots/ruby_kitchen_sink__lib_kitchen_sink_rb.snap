    _wv_take_bytes(result, out_len.read(:size_t))
  end

  # Register a listener, returning how many are attached
  # @return [Integer]
  def self.subscribe(listener)
    _wv_present!(listener, 'listener')
    err = ErrorStruct.new
    listener_ctx, listener_vtable = _wv_cb_register(listener, WV_READY_LISTENER_VTABLE)
    result = kitchen_sink_kitchen_subscribe(listener_ctx, listener_vtable, err)
    _wv_check!(err)
    result
  end

  # Register a listener if one is given
  # @return [Boolean]
  def self.maybe_subscribe(listener = nil)
    err = ErrorStruct.new
    listener_ctx, listener_vtable = _wv_cb_register(listener, WV_READY_LISTENER_VTABLE)
    result = kitchen_sink_kitchen_maybe_subscribe(listener_ctx, listener_vtable, err)
    _wv_check!(err)
    result
  end

  # Optional object in both directions
  # @return [Gadget, nil]
  def self.maybe_gadget(fallback = nil)
    _wv_object!(fallback, Gadget, 'fallback', true)
    _wv_pin(fallback) do |_wv_fallback|
      err = ErrorStruct.new
      result = kitchen_sink_kitchen_maybe_gadget(_wv_fallback, err)
      _wv_check!(err)
      result.null? ? nil : Gadget._from_ptr(result)
    end
  end

  # A list of objects
  # @return [Array<Gadget>]
  def self.gadgets
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = kitchen_sink_kitchen_gadgets(out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_list_gadget(r) }
  end

  # An iterator over objects
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
  # iteration finishes or is abandoned early.
  # @return [Enumerator<Gadget>]
  def self.stream_gadgets
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = kitchen_sink_kitchen_stream_gadgets(err)
      begin
        _wv_check!(err)
        out_item = FFI::MemoryPointer.new(:pointer)
        loop do
          has_item = kitchen_sink_kitchen_StreamGadgetsIterator_next(iter, out_item, err)
          _wv_check!(err)
          break if has_item.zero?
          item = out_item.read_pointer
          value = Gadget._from_ptr(_wv_nonnull(item))
          y << value
        end
      ensure
        kitchen_sink_kitchen_StreamGadgetsIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Optional struct return
  # @return [Item, nil]
  def self.maybe_item(id)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = kitchen_sink_kitchen_maybe_item(id, out_len, err)
    _wv_check_kitchen_errors_error!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_opt_item(r) }
  end

  # List of structs
  # @return [Array<Item>]
  def self.list_items
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = kitchen_sink_kitchen_list_items(out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_list_item(r) }
  end

  # Map return type
  # @return [Hash{String => Integer}]
  def self.get_attrs
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = kitchen_sink_kitchen_get_attrs(out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_map_string_i32(r) }
  end

  # Iterator return type
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
  # iteration finishes or is abandoned early.
  # @return [Enumerator<Item>]
  def self.stream_items
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = kitchen_sink_kitchen_stream_items(err)
      begin
        _wv_check!(err)
        out_item = FFI::MemoryPointer.new(:pointer)
        out_len = FFI::MemoryPointer.new(:size_t)
        loop do
          has_item = kitchen_sink_kitchen_StreamItemsIterator_next(iter, out_item, out_len, err)
          _wv_check!(err)
          break if has_item.zero?
          item = out_item.read_pointer
          value = _wv_decode(item, out_len.read(:size_t)) { |r| _wv_read_item(r) }
          y << value
        end
      ensure
        kitchen_sink_kitchen_StreamItemsIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Returns the shared Token type from another module
  # @return [Token]
  def self.cross_module_token
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = kitchen_sink_kitchen_cross_module_token(out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_token(r) }
  end

  # Async operation
  # Blocks until the call completes on a producer thread.
  # @return [String]
  def self.do_async(input)
    input_s = _wv_str(input)
    ctx, queue = _wv_async_begin
    kitchen_sink_kitchen_do_async(input_s, input_s.bytesize, KITCHEN_SINK_KITCHEN_DO_ASYNC_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Cancellable async operation
  # Blocks until the call completes on a producer thread.
  # @param cancel [CancelToken, nil] cancels the call; it then raises Cancelled
  # @return [String]
  def self.do_cancellable(input, cancel: nil)
    input_s = _wv_str(input)
    own_token = CancelToken.new if cancel.nil?
    token = cancel || own_token
    ctx, queue = _wv_async_begin
    kitchen_sink_kitchen_do_cancellable(input_s, input_s.bytesize, token._wv_ptr, KITCHEN_SINK_KITCHEN_DO_CANCELLABLE_CALLBACK, ctx)
    _wv_async_wait(queue, token)
  ensure
    own_token&.close
  end

  # Legacy operation kept for compatibility
  # @return [Integer]
  # @deprecated Use new_op instead
  def self.legacy_op
    warn('KitchenSink.legacy_op is deprecated: Use new_op instead', uplevel: 1)
    err = ErrorStruct.new
    result = kitchen_sink_kitchen_legacy_op(err)
    _wv_check!(err)
    result
  end

  # Replacement for legacy_op
  # @return [Integer]
  def self.new_op
    err = ErrorStruct.new
    result = kitchen_sink_kitchen_new_op(err)
    _wv_check!(err)
    result
  end

  # === Module: kitchen.nested ===

  attach_function :kitchen_sink_kitchen_nested_hello, [:pointer, :pointer], :pointer, blocking: true

  # Trivial nested-module function
  # @return [String]
  def self.hello
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = kitchen_sink_kitchen_nested_hello(out_len, err)
    _wv_check!(err)
    _wv_take_string(result, out_len.read(:size_t))
  end

  # === Value-buffer codecs of the composite types ===

  # @api private
  # Packs `[Gadget]` into the value-buffer wire format.
  def self._wv_write_list_gadget(w, v)
    w.write_len(v.length)
    v.each { |e| w.write_object(e, Gadget) }
  end

  # @api private
  # Unpacks `[Gadget]` from the value-buffer wire format.
  def self._wv_read_list_gadget(r)
    Array.new(r.read_len) { r.read_object(Gadget) }
  end

  # @api private
  # Packs `Item?` into the value-buffer wire format.
  def self._wv_write_opt_item(w, v)
    if v.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      _wv_write_item(w, v)
    end
  end

  # @api private
  # Unpacks `Item?` from the value-buffer wire format.
  def self._wv_read_opt_item(r)
    r.read_flag ? _wv_read_item(r) : nil
  end

  # @api private
  # Packs `[Item]` into the value-buffer wire format.
  def self._wv_write_list_item(w, v)
    w.write_len(v.length)
    v.each { |e| _wv_write_item(w, e) }
  end

  # @api private
  # Unpacks `[Item]` from the value-buffer wire format.
  def self._wv_read_list_item(r)
    Array.new(r.read_len) { _wv_read_item(r) }
  end

  # @api private
  # Packs `{string:i32}` into the value-buffer wire format.
  def self._wv_write_map_string_i32(w, v)
    w.write_len(v.length)
    v.each do |k, e|
      w.write_string(k)
      w.write_i32(e)
    end
  end

  # @api private
  # Unpacks `{string:i32}` from the value-buffer wire format.
  def self._wv_read_map_string_i32(r)
    Array.new(r.read_len) { [r.read_string, r.read_i32] }.to_h
  end

  # @api private
  # Packs `[string]` into the value-buffer wire format.
  def self._wv_write_list_string(w, v)
    w.write_len(v.length)
    v.each { |e| w.write_string(e) }
  end

  # @api private
  # Unpacks `[string]` from the value-buffer wire format.
  def self._wv_read_list_string(r)
    Array.new(r.read_len) { r.read_string }
  end

  # @api private
  # Packs `{string:string}` into the value-buffer wire format.
  def self._wv_write_map_string_string(w, v)
    w.write_len(v.length)
    v.each do |k, e|
      w.write_string(k)
      w.write_string(e)
    end
  end

  # @api private
  # Unpacks `{string:string}` from the value-buffer wire format.
  def self._wv_read_map_string_string(r)
    Array.new(r.read_len) { [r.read_string, r.read_string] }.to_h
  end

  # @api private
  # Packs `i64?` into the value-buffer wire format.
  def self._wv_write_opt_i64(w, v)
    if v.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      w.write_i64(v)
    end
  end

  # @api private
  # Unpacks `i64?` from the value-buffer wire format.
  def self._wv_read_opt_i64(r)
    r.read_flag ? r.read_i64 : nil
  end

  # @api private
  # Packs `Gadget?` into the value-buffer wire format.
  def self._wv_write_opt_gadget(w, v)
    if v.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      w.write_object(v, Gadget)
    end
  end

  # @api private
  # Unpacks `Gadget?` from the value-buffer wire format.
  def self._wv_read_opt_gadget(r)
    r.read_flag ? r.read_object(Gadget) : nil
  end
end

# END kitchen_sink.rb
