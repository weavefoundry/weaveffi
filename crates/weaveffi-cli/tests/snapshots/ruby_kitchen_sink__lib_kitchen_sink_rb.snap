  # === Module: shared ===

  # A reusable token referenced across modules
  #
  # @!attribute [r] id
  #   @return [Integer]
  # @!attribute [r] label
  #   @return [String]
  Token = Data.define(:id, :label)

  # Trivial cross-module helper
  #
  # @return [String]
  def self.ping
    Bridge.call(nil, :string) do |out_len, out_err|
      Native.kitchen_sink_shared_ping(out_len, out_err)
    end
  end

  # === Module: kitchen ===

  # The `KitchenErrors` error domain of the `kitchen` module. A code these
  # bindings don't know (from a newer library) raises this class itself, with
  # its code and message.
  class KitchenError < Error
    # Item not found
    class NotFound < KitchenError
      CODE = 1
      MESSAGE = 'Item not found'
    end

    # Invalid input
    class InvalidInput < KitchenError
      CODE = 2
      MESSAGE = 'Invalid input'
    end
  end

  # The `PantryError` error domain of the `kitchen` module. A code these
  # bindings don't know (from a newer library) raises this class itself, with
  # its code and message.
  class PantryError < Error
    # Out of stock
    class OutOfStock < PantryError
      CODE = 1
      MESSAGE = 'Out of stock'

      # @return [String]
      attr_reader :item
    end

    # Spoiled
    class Spoiled < PantryError
      CODE = 2
      MESSAGE = 'Spoiled'
    end
  end

  # Task priority levels
  module Priority
    # Low priority
    LOW = 0
    # Normal priority
    NORMAL = 1
    # High priority
    HIGH = 2
  end

  # Kitchen sink struct exercising every field feature
  #
  # @!attribute [r] id
  #   @return [Integer] Stable identifier
  # @!attribute [r] name
  #   @return [String] Display name
  # @!attribute [r] count
  #   @return [Integer] Initial count
  # @!attribute [r] enabled
  #   @return [Boolean] Whether the item is enabled
  # @!attribute [r] ratio
  #   @return [Float] Scaling ratio
  # @!attribute [r] nick
  #   @return [Integer]
  # @!attribute [r] payload
  #   @return [String]
  # @!attribute [r] tags
  #   @return [Array<String>]
  # @!attribute [r] attrs
  #   @return [Hash{String => String}]
  # @!attribute [r] parent
  #   @return [Integer, nil]
  # @!attribute [r] token
  #   @return [Token] Cross-module struct reference
  # @!attribute [r] priority
  #   @return [Integer]
  # @!attribute [r] gadget
  #   @return [Gadget, nil] An optional object inside a record
  Item = Data.define(
    :id,
    :name,
    :count,
    :enabled,
    :ratio,
    :nick,
    :payload,
    :tags,
    :attrs,
    :parent,
    :token,
    :priority,
    :gadget,
  )

  # Consumer-implemented observer of ready items
  #
  # A callback interface: pass any object that responds to the methods below
  # wherever a ReadyListener is expected. Including this module documents the
  # intent and supplies NotImplementedError defaults. The library may call the
  # methods from any thread until it releases the implementation.
  module ReadyListener
    # Fires when an item is ready
    #
    # @param code [Integer]
    # @param msg [String]
    # @return [void]
    def on_ready(code, msg)
      raise NotImplementedError, "#{self.class}#on_ready is not implemented"
    end

    # Receives the item itself and says whether to keep listening
    #
    # @param item [Item]
    # @param gadget [Gadget]
    # @return [Boolean]
    def on_item(item, gadget)
      raise NotImplementedError, "#{self.class}#on_item is not implemented"
    end

    # A display label, failing with a kitchen error
    #
    # @return [String]
    # @raise [KitchenError] reported to the library with its code and fields
    def label
      raise NotImplementedError, "#{self.class}#label is not implemented"
    end

    # The most recent item the listener kept, if any
    #
    # @return [Item, nil]
    def latest
      raise NotImplementedError, "#{self.class}#latest is not implemented"
    end

    # The listener's favorite gadget
    #
    # @return [Gadget]
    def favorite
      raise NotImplementedError, "#{self.class}#favorite is not implemented"
    end
  end

  # Consumer-implemented source of scalar samples
  #
  # A callback interface: pass any object that responds to the methods below
  # wherever a Sampler is expected. Including this module documents the intent
  # and supplies NotImplementedError defaults. The library may call the
  # methods from any thread until it releases the implementation.
  module Sampler
    # The cutoff for a level, if the sampler has one
    #
    # @param level [Integer, nil]
    # @return [Float, nil]
    def threshold(level)
      raise NotImplementedError, "#{self.class}#threshold is not implemented"
    end

    # Up to `limit` samples, failing when the pantry is empty
    #
    # @param limit [Integer, nil]
    # @param weights [Array<Float>]
    # @return [Array<Integer>]
    # @raise [PantryError] reported to the library with its code and fields
    def samples(limit, weights)
      raise NotImplementedError, "#{self.class}#samples is not implemented"
    end

    # A free-form description, failing with an untyped error
    #
    # @return [String]
    # @raise [StandardError] reported to the library with its message
    def describe
      raise NotImplementedError, "#{self.class}#describe is not implemented"
    end
  end

  # A pocket-sized interface exercising the object surface
  class Gadget < Bridge::Handle
    # Create a gadget with the given id
    #
    # @param id [Integer]
    def initialize(id)
      id = Bridge.scalar(id, :i64)
      ptr = Bridge.call(nil, :pointer) do |out_err|
        Native.kitchen_sink_kitchen_Gadget_new(id, out_err)
      end
      _wv_init(ptr)
    end

    # Render the gadget as a human-readable string
    #
    # @return [String]
    def describe
      Bridge.pin(self) do |self_|
        Bridge.call(nil, :string) do |out_len, out_err|
          Native.kitchen_sink_kitchen_Gadget_describe(self_, out_len, out_err)
        end
      end
    end

    # Poke the gadget a number of times, failing on a negative count
    #
    # @param times [Integer]
    # @return [Integer]
    # @raise [KitchenError] for a domain error
    def poke(times)
      times = Bridge.scalar(times, :i32)
      Bridge.pin(self) do |self_|
        Bridge.call(KitchenError, :i32) do |out_err|
          Native.kitchen_sink_kitchen_Gadget_poke(self_, times, out_err)
        end
      end
    end

    # The gadget's sensor readings, optionally limited
    #
    # @param limit [Integer, nil]
    # @return [Array<Float>]
    # @raise [Error] when the call fails
    def readings(limit = nil)
      has_limit, limit = Bridge.opt_arg(limit, :u32)
      Bridge.pin(self) do |self_|
        Bridge.call(Error, [:slice, :f64]) do |out_len, out_err|
          Native.kitchen_sink_kitchen_Gadget_readings(self_, has_limit, limit, out_len, out_err)
        end
      end
    end

    # The gadget subsystem version string
    #
    # @return [String]
    def self.version
      Bridge.call(nil, :string) do |out_len, out_err|
        Native.kitchen_sink_kitchen_Gadget_version(out_len, out_err)
      end
    end
  end

  # Identity for bool
  #
  # @param x [Boolean]
  # @return [Boolean]
  def self.bool_id(x)
    Bridge.call(nil, :bool) do |out_err|
      Native.kitchen_sink_kitchen_bool_id((x ? true : false), out_err)
    end
  end

  # @param x [Integer]
  # @return [Integer]
  def self.i32_id(x)
    x = Bridge.scalar(x, :i32)
    Bridge.call(nil, :i32) do |out_err|
      Native.kitchen_sink_kitchen_i32_id(x, out_err)
    end
  end

  # @param x [Integer]
  # @return [Integer]
  def self.u32_id(x)
    x = Bridge.scalar(x, :u32)
    Bridge.call(nil, :u32) do |out_err|
      Native.kitchen_sink_kitchen_u32_id(x, out_err)
    end
  end

  # @param x [Integer]
  # @return [Integer]
  def self.i64_id(x)
    x = Bridge.scalar(x, :i64)
    Bridge.call(nil, :i64) do |out_err|
      Native.kitchen_sink_kitchen_i64_id(x, out_err)
    end
  end

  # @param x [Float]
  # @return [Float]
  def self.f64_id(x)
    Bridge.call(nil, :f64) do |out_err|
      Native.kitchen_sink_kitchen_f64_id(x, out_err)
    end
  end

  # @param s [String]
  # @return [String]
  def self.echo_string(s)
    s_ptr = Bridge.string_arg(s)
    Bridge.call(nil, :string) do |out_len, out_err|
      Native.kitchen_sink_kitchen_echo_string(s_ptr, s_ptr.bytesize, out_len, out_err)
    end
  end

  # @param b [String]
  # @return [String]
  def self.echo_bytes(b)
    b_ptr = Bridge.bytes_arg(b)
    Bridge.call(nil, :bytes) do |out_len, out_err|
      Native.kitchen_sink_kitchen_echo_bytes(b_ptr, b_ptr.bytesize, out_len, out_err)
    end
  end

  # Register a listener, returning how many are attached
  #
  # @param listener [ReadyListener]
  # @return [Integer]
  def self.subscribe(listener)
    Bridge.present!(listener, 'listener')
    Bridge.call(nil, :i32) do |out_err|
      listener_ctx, listener_vtable = Bridge.register(listener, ReadyListener)
      Native.kitchen_sink_kitchen_subscribe(listener_ctx, listener_vtable, out_err)
    end
  end

  # Register a listener if one is given
  #
  # @param listener [ReadyListener, nil]
  # @return [Boolean]
  def self.maybe_subscribe(listener = nil)
    Bridge.call(nil, :bool) do |out_err|
      listener_ctx, listener_vtable = Bridge.register(listener, ReadyListener)
      Native.kitchen_sink_kitchen_maybe_subscribe(listener_ctx, listener_vtable, out_err)
    end
  end

  # Optional object in both directions
  #
  # @param fallback [Gadget, nil]
  # @return [Gadget, nil]
  def self.maybe_gadget(fallback = nil)
    Bridge.check_object(fallback, Gadget, 'fallback', nullable: true)
    Bridge.pin(fallback) do |fallback|
      Bridge.call(nil, [:object?, Gadget]) do |out_err|
        Native.kitchen_sink_kitchen_maybe_gadget(fallback, out_err)
      end
    end
  end

  # A list of objects
  #
  # @return [Array<Gadget>]
  def self.gadgets
    Bridge.call(nil, [:buffer, [:list, Gadget]]) do |out_len, out_err|
      Native.kitchen_sink_kitchen_gadgets(out_len, out_err)
    end
  end

  # An iterator over objects
  #
  # Returns a lazy Enumerator: each enumeration starts its own native iterator
  # on the first pull and releases it when iteration finishes or stops early.
  #
  # @return [Enumerator<Gadget>]
  def self.stream_gadgets
    Bridge.iterate(
      nil,
      [:object, Gadget],
      :kitchen_sink_kitchen_StreamGadgetsIterator_next,
      :kitchen_sink_kitchen_StreamGadgetsIterator_destroy,
    ) do |out_err|
      Native.kitchen_sink_kitchen_stream_gadgets(out_err)
    end
  end

  # Optional struct return
  #
  # @param id [Integer]
  # @return [Item, nil]
  # @raise [KitchenError] for a domain error
  def self.maybe_item(id)
    id = Bridge.scalar(id, :i64)
    Bridge.call(KitchenError, [:buffer, [:opt, Item]]) do |out_len, out_err|
      Native.kitchen_sink_kitchen_maybe_item(id, out_len, out_err)
    end
  end

  # List of structs
  #
  # @return [Array<Item>]
  def self.list_items
    Bridge.call(nil, [:buffer, [:list, Item]]) do |out_len, out_err|
      Native.kitchen_sink_kitchen_list_items(out_len, out_err)
    end
  end

  # Map return type
  #
  # @return [Hash{String => Integer}]
  def self.get_attrs
    Bridge.call(nil, [:buffer, [:map, :string, :i32]]) do |out_len, out_err|
      Native.kitchen_sink_kitchen_get_attrs(out_len, out_err)
    end
  end

  # Iterator return type
  #
  # Returns a lazy Enumerator: each enumeration starts its own native iterator
  # on the first pull and releases it when iteration finishes or stops early.
  #
  # @return [Enumerator<Item>]
  def self.stream_items
    Bridge.iterate(
      nil,
      [:buffer, Item],
      :kitchen_sink_kitchen_StreamItemsIterator_next,
      :kitchen_sink_kitchen_StreamItemsIterator_destroy,
    ) do |out_err|
      Native.kitchen_sink_kitchen_stream_items(out_err)
    end
  end

  # Returns the shared Token type from another module
  #
  # @return [Token]
  def self.cross_module_token
    Bridge.call(nil, [:buffer, Token]) do |out_len, out_err|
      Native.kitchen_sink_kitchen_cross_module_token(out_len, out_err)
    end
  end

  # Async operation
  #
  # Blocks until the call completes on a library thread (under a Fiber
  # scheduler, only the calling Fiber waits).
  #
  # @param input [String]
  # @return [String]
  def self.do_async(input)
    input_ptr = Bridge.string_arg(input)
    Bridge.await(nil, :string) do |callback, context|
      Native.kitchen_sink_kitchen_do_async(input_ptr, input_ptr.bytesize, callback, context)
    end
  end

  # Cancellable async operation
  #
  # Blocks until the call completes on a library thread (under a Fiber
  # scheduler, only the calling Fiber waits).
  #
  # @param input [String]
  # @param cancel [CancelToken, nil] cancels the call, which then raises Cancelled
  # @return [String]
  # @raise [Cancelled] when `cancel` fires first
  def self.do_cancellable(input, cancel: nil)
    input_ptr = Bridge.string_arg(input)
    Bridge.await_cancellable(nil, :string, cancel) do |cancel_token, callback, context|
      Native.kitchen_sink_kitchen_do_cancellable(
        input_ptr,
        input_ptr.bytesize,
        cancel_token,
        callback,
        context,
      )
    end
  end

  # Legacy operation kept for compatibility
  #
  # @return [Integer]
  # @deprecated Use `new_op` instead
  def self.legacy_op
    warn('KitchenSink.legacy_op is deprecated: Use `new_op` instead', uplevel: 1, category: :deprecated)
    Bridge.call(nil, :i32) do |out_err|
      Native.kitchen_sink_kitchen_legacy_op(out_err)
    end
  end

  # Replacement for `legacy_op`
  #
  # @return [Integer]
  def self.new_op
    Bridge.call(nil, :i32) do |out_err|
      Native.kitchen_sink_kitchen_new_op(out_err)
    end
  end

  # Optional scalar in both directions
  #
  # @param x [Integer, nil]
  # @return [Integer, nil]
  def self.opt_i32_id(x = nil)
    has_x, x = Bridge.opt_arg(x, :i32)
    Bridge.call(nil, [:opt, :i32]) do |out_value, out_err|
      Native.kitchen_sink_kitchen_opt_i32_id(has_x, x, out_value, out_err)
    end
  end

  # @param x [Boolean, nil]
  # @return [Boolean, nil]
  def self.opt_bool_id(x = nil)
    has_x, x = Bridge.opt_arg(x, :bool)
    Bridge.call(nil, [:opt, :bool]) do |out_value, out_err|
      Native.kitchen_sink_kitchen_opt_bool_id(has_x, x, out_value, out_err)
    end
  end

  # Optional C-style enum in both directions
  #
  # @param p [Integer, nil]
  # @return [Integer, nil]
  def self.opt_priority(p = nil)
    has_p, p = Bridge.opt_arg(p, :i32)
    Bridge.call(nil, [:opt, :i32]) do |out_value, out_err|
      Native.kitchen_sink_kitchen_opt_priority(has_p, p, out_value, out_err)
    end
  end

  # Optional scalars next to ordinary parameters
  #
  # @param base [Float]
  # @param scale [Float, nil]
  # @param offset [Integer, nil]
  # @param label [String, nil]
  # @return [Integer, nil]
  def self.opt_mixed(base, scale = nil, offset = nil, label = nil)
    has_scale, scale = Bridge.opt_arg(scale, :f32)
    has_offset, offset = Bridge.opt_arg(offset, :i64)
    label_ptr = Bridge.encode([:opt, :string], label)
    Bridge.call(nil, [:opt, :u16], label_ptr) do |label_ptr, out_value, out_err|
      Native.kitchen_sink_kitchen_opt_mixed(
        base,
        has_scale,
        scale,
        has_offset,
        offset,
        label_ptr,
        label_ptr.bytesize,
        out_value,
        out_err,
      )
    end
  end

  # A typed-array parameter
  #
  # @param xs [Array<Float>]
  # @return [Float]
  def self.sum_f64(xs)
    xs_ptr, xs_len = Bridge.slice_arg(xs, :f64)
    Bridge.call(nil, :f64) do |out_err|
      Native.kitchen_sink_kitchen_sum_f64(xs_ptr, xs_len, out_err)
    end
  end

  # Typed arrays in both directions
  #
  # @param xs [Array<Integer>]
  # @param factor [Integer]
  # @return [Array<Integer>]
  def self.scale_i32(xs, factor)
    xs_ptr, xs_len = Bridge.slice_arg(xs, :i32)
    factor = Bridge.scalar(factor, :i32)
    Bridge.call(nil, [:slice, :i32]) do |out_len, out_err|
      Native.kitchen_sink_kitchen_scale_i32(xs_ptr, xs_len, factor, out_len, out_err)
    end
  end

  # @param ids [Array<Integer>]
  # @return [Array<Integer>]
  def self.ids_u64(ids)
    ids_ptr, ids_len = Bridge.slice_arg(ids, :u64)
    Bridge.call(nil, [:slice, :u64]) do |out_len, out_err|
      Native.kitchen_sink_kitchen_ids_u64(ids_ptr, ids_len, out_len, out_err)
    end
  end

  # Every slice element type
  #
  # @param a [Array<Integer>]
  # @param b [Array<Integer>]
  # @param c [Array<Integer>]
  # @param d [Array<Integer>]
  # @param e [Array<Integer>]
  # @param f [Array<Float>]
  # @return [Array<Integer>]
  def self.mixed_slices(a, b, c, d, e, f)
    a_ptr, a_len = Bridge.slice_arg(a, :i8)
    b_ptr, b_len = Bridge.slice_arg(b, :i16)
    c_ptr, c_len = Bridge.slice_arg(c, :u16)
    d_ptr, d_len = Bridge.slice_arg(d, :u32)
    e_ptr, e_len = Bridge.slice_arg(e, :i64)
    f_ptr, f_len = Bridge.slice_arg(f, :f32)
    Bridge.call(nil, [:slice, :u32]) do |out_len, out_err|
      Native.kitchen_sink_kitchen_mixed_slices(
        a_ptr,
        a_len,
        b_ptr,
        b_len,
        c_ptr,
        c_len,
        d_ptr,
        d_len,
        e_ptr,
        e_len,
        f_ptr,
        f_len,
        out_len,
        out_err,
      )
    end
  end

  # Async returning an optional scalar
  #
  # Blocks until the call completes on a library thread (under a Fiber
  # scheduler, only the calling Fiber waits).
  #
  # @return [Integer, nil]
  def self.async_maybe_count
    Bridge.await(nil, [:opt, :i64]) do |callback, context|
      Native.kitchen_sink_kitchen_async_maybe_count(callback, context)
    end
  end

  # Async returning a typed array
  #
  # Blocks until the call completes on a library thread (under a Fiber
  # scheduler, only the calling Fiber waits).
  #
  # @param n [Integer]
  # @param cancel [CancelToken, nil] cancels the call, which then raises Cancelled
  # @return [Array<Float>]
  # @raise [Cancelled] when `cancel` fires first
  def self.async_samples(n, cancel: nil)
    n = Bridge.scalar(n, :u32)
    Bridge.await_cancellable(nil, [:slice, :f32], cancel) do |cancel_token, callback, context|
      Native.kitchen_sink_kitchen_async_samples(n, cancel_token, callback, context)
    end
  end

  # Iterator of optional scalars
  #
  # Returns a lazy Enumerator: each enumeration starts its own native iterator
  # on the first pull and releases it when iteration finishes or stops early.
  #
  # @return [Enumerator<Integer, nil>]
  def self.stream_maybe
    Bridge.iterate(
      nil,
      [:opt, :i32],
      :kitchen_sink_kitchen_StreamMaybeIterator_next,
      :kitchen_sink_kitchen_StreamMaybeIterator_destroy,
    ) do |out_err|
      Native.kitchen_sink_kitchen_stream_maybe(out_err)
    end
  end

  # Iterator of typed arrays
  #
  # Returns a lazy Enumerator: each enumeration starts its own native iterator
  # on the first pull and releases it when iteration finishes or stops early.
  #
  # @return [Enumerator<Array<Integer>>]
  def self.stream_chunks
    Bridge.iterate(
      nil,
      [:slice, :i32],
      :kitchen_sink_kitchen_StreamChunksIterator_next,
      :kitchen_sink_kitchen_StreamChunksIterator_destroy,
    ) do |out_err|
      Native.kitchen_sink_kitchen_stream_chunks(out_err)
    end
  end

  # Drive a consumer-implemented sampler
  #
  # @param sampler [Sampler]
  # @param level [Integer, nil]
  # @return [Array<Integer>]
  # @raise [PantryError] for a domain error
  def self.sample_with(sampler, level = nil)
    Bridge.present!(sampler, 'sampler')
    has_level, level = Bridge.opt_arg(level, :u32)
    Bridge.call(PantryError, [:slice, :i16]) do |out_len, out_err|
      sampler_ctx, sampler_vtable = Bridge.register(sampler, Sampler)
      Native.kitchen_sink_kitchen_sample_with(
        sampler_ctx,
        sampler_vtable,
        has_level,
        level,
        out_len,
        out_err,
      )
    end
  end

  # Fails with the second domain
  #
  # @param item [String]
  # @return [Integer]
  # @raise [PantryError] for a domain error
  def self.take_from_pantry(item)
    item_ptr = Bridge.string_arg(item)
    Bridge.call(PantryError, :i32) do |out_err|
      Native.kitchen_sink_kitchen_take_from_pantry(item_ptr, item_ptr.bytesize, out_err)
    end
  end

  # Fails with an untyped error
  #
  # @param text [String]
  # @return [Integer]
  # @raise [Error] when the call fails
  def self.parse_any(text)
    text_ptr = Bridge.string_arg(text)
    Bridge.call(Error, :i64) do |out_err|
      Native.kitchen_sink_kitchen_parse_any(text_ptr, text_ptr.bytesize, out_err)
    end
  end

  # === Module: kitchen.nested ===

  # Trivial nested-module function
  #
  # @return [String]
  def self.hello
    Bridge.call(nil, :string) do |out_len, out_err|
      Native.kitchen_sink_kitchen_nested_hello(out_len, out_err)
    end
  end

  # === Private registrations ===

  # How the library clones and releases each interface's objects, and how
  # each record, variant, and error payload is laid out in a value buffer.
  Bridge.interface(Gadget, :kitchen_sink_kitchen_Gadget_clone, :kitchen_sink_kitchen_Gadget_destroy)
  Bridge.record(Token, id: :i64, label: :string)
  Bridge.record(
    Item,
    id: :i64,
    name: :string,
    count: :i32,
    enabled: :bool,
    ratio: :f64,
    nick: :u32,
    payload: :bytes,
    tags: [:list, :string],
    attrs: [:map, :string, :string],
    parent: [:opt, :i64],
    token: Token,
    priority: :i32,
    gadget: [:opt, Gadget],
  )
  Bridge.record(PantryError::OutOfStock, item: :string)

  # The ReadyListener vtable.
  Bridge.vtable(
    ReadyListener,
    # ReadyListener#on_ready
    FFI::Function.new(:void, [:pointer, :int32, :pointer, :size_t, :pointer]) do |ctx, code, msg_ptr, msg_len, out_err|
      Bridge.callback(out_err, nil) do
        msg = Bridge.borrow_string(msg_ptr, msg_len)
        Bridge.impl(ctx).on_ready(code, msg)
        nil
      end
    end,
    # ReadyListener#on_item
    FFI::Function.new(:bool, [:pointer, :pointer, :size_t, :pointer, :pointer]) do |ctx, item_ptr, item_len, gadget, out_err|
      Bridge.callback(out_err, nil, false) do
        gadget = Bridge.adopt(Gadget, gadget)
        item = Bridge.decode_borrowed(item_ptr, item_len, Item)
        Bridge.impl(ctx).on_item(item, gadget) ? true : false
      end
    end,
    # ReadyListener#label
    FFI::Function.new(:void, [:pointer, :pointer, :pointer, :pointer]) do |ctx, out_ptr, out_len, out_err|
      Bridge.callback(out_err, KitchenError) do
        Bridge.string_return(Bridge.impl(ctx).label, out_ptr, out_len)
      end
    end,
    # ReadyListener#latest
    FFI::Function.new(:void, [:pointer, :pointer, :pointer, :pointer]) do |ctx, out_ptr, out_len, out_err|
      Bridge.callback(out_err, nil) do
        Bridge.buffer_return([:opt, Item], Bridge.impl(ctx).latest, out_ptr, out_len)
      end
    end,
    # ReadyListener#favorite
    FFI::Function.new(:pointer, [:pointer, :pointer]) do |ctx, out_err|
      Bridge.callback(out_err, nil) do
        Bridge.object_return(Bridge.impl(ctx).favorite, Gadget)
      end
    end,
  )

  # The Sampler vtable.
  Bridge.vtable(
    Sampler,
    # Sampler#threshold
    FFI::Function.new(:bool, [:pointer, :bool, :uint32, :pointer, :pointer]) do |ctx, has_level, level, out_value, out_err|
      Bridge.callback(out_err, nil, false) do
        level = has_level ? level : nil
        Bridge.opt_return(Bridge.impl(ctx).threshold(level), :f64, out_value)
      end
    end,
    # Sampler#samples
    FFI::Function.new(:void, [:pointer, :bool, :uint32, :pointer, :size_t, :pointer, :pointer, :pointer]) do |ctx, has_limit, limit, weights_ptr, weights_len, out_ptr, out_len, out_err|
      Bridge.callback(out_err, PantryError) do
        limit = has_limit ? limit : nil
        weights = Bridge.borrow_slice(weights_ptr, weights_len, :f64)
        Bridge.slice_return(Bridge.impl(ctx).samples(limit, weights), :i16, out_ptr, out_len)
      end
    end,
    # Sampler#describe
    FFI::Function.new(:void, [:pointer, :pointer, :pointer, :pointer]) do |ctx, out_ptr, out_len, out_err|
      Bridge.callback(out_err, Error) do
        Bridge.string_return(Bridge.impl(ctx).describe, out_ptr, out_len)
      end
    end,
  )
end

# END kitchen_sink.rb
