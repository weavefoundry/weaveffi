  # @api private
  # Owns one strong reference to a Gadget; releases it exactly once.
  class GadgetPtr < FFI::AutoPointer
    def self.release(ptr)
      KitchenSink.kitchen_sink_kitchen_Gadget_destroy(ptr)
    end
  end

  # A pocket-sized interface exercising the object surface
  class Gadget < WvObject
    WV_PTR = GadgetPtr

    # @api private
    def self._wv_clone(ptr)
      KitchenSink.kitchen_sink_kitchen_Gadget_clone(ptr)
    end

    # Create a gadget with the given id
    def initialize(id)
      err = ErrorStruct.new
      result = KitchenSink.kitchen_sink_kitchen_Gadget_new(id, err)
      KitchenSink._wv_check!(err)
      _wv_init(KitchenSink._wv_nonnull(result))
    end

    # Render the gadget as a human-readable string
    # @return [String]
    def describe
      KitchenSink._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        out_len = FFI::MemoryPointer.new(:size_t)
        result = KitchenSink.kitchen_sink_kitchen_Gadget_describe(_wv_self, out_len, err)
        KitchenSink._wv_check!(err)
        KitchenSink._wv_take_string(result, out_len.read(:size_t))
      end
    end

    # Poke the gadget a number of times, failing on a negative count
    # @return [Integer]
    def poke(times)
      KitchenSink._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        result = KitchenSink.kitchen_sink_kitchen_Gadget_poke(_wv_self, times, err)
        KitchenSink._wv_check_kitchen_errors_error!(err)
        result
      end
    end

    # The gadget subsystem version string
    # @return [String]
    def self.version
      err = ErrorStruct.new
      out_len = FFI::MemoryPointer.new(:size_t)
      result = KitchenSink.kitchen_sink_kitchen_Gadget_version(out_len, err)
      KitchenSink._wv_check!(err)
      KitchenSink._wv_take_string(result, out_len.read(:size_t))
    end
  end

