/// Async operation
Future<String> doAsync(String input) {
  final _arena = Arena();
  final _completer = Completer<String>();
  late final NativeCallable<_KitchenSinkKitchenDoAsyncCallback> _callback;
  _callback = NativeCallable<_KitchenSinkKitchenDoAsyncCallback>.listener((
      Pointer<Void> _, Pointer<_Error> error, Pointer<Uint8> value, int valueLen) {
    _callback.close();
    try {
      if (error != nullptr) throw _takeAsyncError(error, _trap);
      _completer.complete(_takeString(value, valueLen));
    } catch (e, s) {
      _completer.completeError(e, s);
    }
  });
  try {
    final _inputBytes = utf8.encode(input);
    _kitchenSinkKitchenDoAsync(_stage(_arena, _inputBytes), _inputBytes.length, _callback.nativeFunction, nullptr);
  } catch (_) {
    _callback.close();
    rethrow;
  } finally {
    _arena.releaseAll();
  }
  return _completer.future;
}

