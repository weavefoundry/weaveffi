/* ---------------------------------------------------------------------------
 * Value buffer runtime.
 *
 * The wire format is little-endian and packed: fixed-width scalars at their
 * natural width, `bool` as one byte, strings and bytes as a `uint32_t` length
 * followed by the raw bytes (no NUL terminator), optionals as a presence byte
 * followed by the value, lists as a `uint32_t` count followed by the
 * elements, maps as a `uint32_t` count followed by alternating keys and
 * values, and objects as a `uint64_t` token holding one strong reference.
 * ------------------------------------------------------------------------- */

/* A UTF-8 string view: `len` bytes at `ptr`, which may contain NUL bytes.
   A decoded string owns `ptr` and also NUL-terminates it, so `ptr` can be
   passed to C string functions when the text has no interior NUL. */
typedef struct shapes_str {
    const char* ptr;
    size_t len;
} shapes_str;

/* A byte string view: `len` bytes at `ptr`. A decoded value owns `ptr`. */
typedef struct shapes_bytes {
    const uint8_t* ptr;
    size_t len;
} shapes_bytes;

/* Borrow a NUL-terminated C string (NULL is the empty string). */
static inline shapes_str shapes_str_of(const char* s) {
    shapes_str v;
    v.ptr = s;
    v.len = s ? strlen(s) : 0;
    return v;
}

/* Borrow `len` bytes at `ptr`. */
static inline shapes_bytes shapes_bytes_of(const uint8_t* ptr, size_t len) {
    shapes_bytes v;
    v.ptr = ptr;
    v.len = len;
    return v;
}

/* Release a decoded string. Never call this on a borrowed view. */
static inline void shapes_str_free(shapes_str* s) {
    free((void*)s->ptr);
    s->ptr = NULL;
    s->len = 0;
}

/* Release decoded bytes. Never call this on a borrowed view. */
static inline void shapes_bytes_free(shapes_bytes* b) {
    free((void*)b->ptr);
    b->ptr = NULL;
    b->len = 0;
}

/* A growable output buffer. Zero-initialize it, write values, pass
   `ptr`/`len` to the call, then release it with shapes_writer_free. An
   allocation failure sets `failed` and turns later writes into no-ops. */
typedef struct shapes_writer {
    uint8_t* ptr;
    size_t len;
    size_t cap;
    bool failed;
} shapes_writer;

static inline void shapes_writer_free(shapes_writer* w) {
    free(w->ptr);
    w->ptr = NULL;
    w->len = 0;
    w->cap = 0;
    w->failed = false;
}

static inline void shapes_writer_put_raw(shapes_writer* w, const void* data, size_t n) {
    if (w->failed || n == 0) {
        return;
    }
    if (n > w->cap - w->len) {
        size_t cap = w->cap ? w->cap : 64;
        while (cap - w->len < n) {
            if (cap > SIZE_MAX / 2) {
                w->failed = true;
                return;
            }
            cap *= 2;
        }
        uint8_t* grown = (uint8_t*)realloc(w->ptr, cap);
        if (grown == NULL) {
            w->failed = true;
            return;
        }
        w->ptr = grown;
        w->cap = cap;
    }
    memcpy(w->ptr + w->len, data, n);
    w->len += n;
}

static inline void shapes_writer_put_u64(shapes_writer* w, uint64_t v) {
    uint8_t b[8];
    for (int i = 0; i < 8; i++) {
        b[i] = (uint8_t)(v >> (8 * i));
    }
    shapes_writer_put_raw(w, b, 8);
}

static inline void shapes_writer_put_u32(shapes_writer* w, uint32_t v) {
    uint8_t b[4] = {(uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24)};
    shapes_writer_put_raw(w, b, 4);
}

static inline void shapes_writer_put_u16(shapes_writer* w, uint16_t v) {
    uint8_t b[2] = {(uint8_t)v, (uint8_t)(v >> 8)};
    shapes_writer_put_raw(w, b, 2);
}

static inline void shapes_writer_put_u8(shapes_writer* w, uint8_t v) {
    shapes_writer_put_raw(w, &v, 1);
}

static inline void shapes_writer_put_i8(shapes_writer* w, int8_t v) {
    shapes_writer_put_u8(w, (uint8_t)v);
}

static inline void shapes_writer_put_i16(shapes_writer* w, int16_t v) {
    shapes_writer_put_u16(w, (uint16_t)v);
}

static inline void shapes_writer_put_i32(shapes_writer* w, int32_t v) {
    shapes_writer_put_u32(w, (uint32_t)v);
}

static inline void shapes_writer_put_i64(shapes_writer* w, int64_t v) {
    shapes_writer_put_u64(w, (uint64_t)v);
}

static inline void shapes_writer_put_bool(shapes_writer* w, bool v) {
    shapes_writer_put_u8(w, v ? 1 : 0);
}

static inline void shapes_writer_put_f32(shapes_writer* w, float v) {
    uint32_t bits;
    memcpy(&bits, &v, 4);
    shapes_writer_put_u32(w, bits);
}

static inline void shapes_writer_put_f64(shapes_writer* w, double v) {
    uint64_t bits;
    memcpy(&bits, &v, 8);
    shapes_writer_put_u64(w, bits);
}

static inline void shapes_writer_put_len(shapes_writer* w, size_t n) {
    if (n > UINT32_MAX) {
        w->failed = true;
        return;
    }
    shapes_writer_put_u32(w, (uint32_t)n);
}

static inline void shapes_writer_put_string(shapes_writer* w, shapes_str v) {
    shapes_writer_put_len(w, v.len);
    shapes_writer_put_raw(w, v.ptr, v.len);
}

static inline void shapes_writer_put_bytes(shapes_writer* w, shapes_bytes v) {
    shapes_writer_put_len(w, v.len);
    shapes_writer_put_raw(w, v.ptr, v.len);
}

/* Write an object token. The token carries one strong reference, so pass
   a reference the buffer may own (the generated codecs pass a fresh
   `_clone`). */
static inline void shapes_writer_put_object(shapes_writer* w, const void* owned) {
    shapes_writer_put_u64(w, (uint64_t)(uintptr_t)owned);
}

/* A cursor over an input buffer. A malformed buffer sets `failed`; every
   later read then returns a zero value, so a decoder can always finish and
   release what it built. */
typedef struct shapes_reader {
    const uint8_t* ptr;
    size_t len;
    size_t pos;
    bool failed;
} shapes_reader;

static inline shapes_reader shapes_reader_of(const uint8_t* ptr, size_t len) {
    shapes_reader r;
    r.ptr = ptr;
    r.len = ptr ? len : 0;
    r.pos = 0;
    r.failed = false;
    return r;
}

/* `true` when every byte was consumed and nothing was malformed. */
static inline bool shapes_reader_finish(const shapes_reader* r) {
    return !r->failed && r->pos == r->len;
}

static inline const uint8_t* shapes_reader_take(shapes_reader* r, size_t n) {
    if (r->failed || n > r->len - r->pos) {
        r->failed = true;
        return NULL;
    }
    const uint8_t* at = r->ptr + r->pos;
    r->pos += n;
    return at;
}

/* Zeroed storage for `n` decoded elements of `size` bytes (NULL when `n` is
   zero). `min_wire` is the smallest encoding of one element; a count the
   remaining bytes can't hold fails the reader before anything is
   allocated. */
static inline void* shapes_reader_alloc(shapes_reader* r, size_t n, size_t size, size_t min_wire) {
    if (r->failed || n == 0) {
        return NULL;
    }
    if (min_wire != 0 && n > (r->len - r->pos) / min_wire) {
        r->failed = true;
        return NULL;
    }
    void* p = calloc(n, size);
    if (p == NULL) {
        r->failed = true;
    }
    return p;
}

static inline uint64_t shapes_reader_get_u64(shapes_reader* r) {
    const uint8_t* b = shapes_reader_take(r, 8);
    uint64_t v = 0;
    if (b != NULL) {
        for (int i = 0; i < 8; i++) {
            v |= (uint64_t)b[i] << (8 * i);
        }
    }
    return v;
}

static inline uint32_t shapes_reader_get_u32(shapes_reader* r) {
    const uint8_t* b = shapes_reader_take(r, 4);
    if (b == NULL) {
        return 0;
    }
    return (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
}

static inline uint16_t shapes_reader_get_u16(shapes_reader* r) {
    const uint8_t* b = shapes_reader_take(r, 2);
    return b ? (uint16_t)((uint16_t)b[0] | ((uint16_t)b[1] << 8)) : (uint16_t)0;
}

static inline uint8_t shapes_reader_get_u8(shapes_reader* r) {
    const uint8_t* b = shapes_reader_take(r, 1);
    return b ? b[0] : (uint8_t)0;
}

static inline int8_t shapes_reader_get_i8(shapes_reader* r) {
    return (int8_t)shapes_reader_get_u8(r);
}

static inline int16_t shapes_reader_get_i16(shapes_reader* r) {
    return (int16_t)shapes_reader_get_u16(r);
}

static inline int32_t shapes_reader_get_i32(shapes_reader* r) {
    return (int32_t)shapes_reader_get_u32(r);
}

static inline int64_t shapes_reader_get_i64(shapes_reader* r) {
    return (int64_t)shapes_reader_get_u64(r);
}

static inline bool shapes_reader_get_bool(shapes_reader* r) {
    uint8_t v = shapes_reader_get_u8(r);
    if (v > 1) {
        r->failed = true;
        return false;
    }
    return v == 1;
}

static inline float shapes_reader_get_f32(shapes_reader* r) {
    uint32_t bits = shapes_reader_get_u32(r);
    float v;
    memcpy(&v, &bits, 4);
    return v;
}

static inline double shapes_reader_get_f64(shapes_reader* r) {
    uint64_t bits = shapes_reader_get_u64(r);
    double v;
    memcpy(&v, &bits, 8);
    return v;
}

/* A `uint32_t` length followed by that many bytes, copied into a fresh
   NUL-terminated allocation. */
static inline uint8_t* shapes_reader_get_run(shapes_reader* r, size_t* out_len) {
    size_t n = shapes_reader_get_u32(r);
    const uint8_t* at = shapes_reader_take(r, n);
    *out_len = 0;
    if (at == NULL) {
        return NULL;
    }
    uint8_t* copy = (uint8_t*)malloc(n + 1);
    if (copy == NULL) {
        r->failed = true;
        return NULL;
    }
    memcpy(copy, at, n);
    copy[n] = 0;
    *out_len = n;
    return copy;
}

static inline shapes_str shapes_reader_get_string(shapes_reader* r) {
    shapes_str v;
    v.ptr = (const char*)shapes_reader_get_run(r, &v.len);
    return v;
}

static inline shapes_bytes shapes_reader_get_bytes(shapes_reader* r) {
    shapes_bytes v;
    v.ptr = shapes_reader_get_run(r, &v.len);
    return v;
}

/* Read an object token and adopt the strong reference it carries. A zero
   token in a required position fails the reader. */
static inline void* shapes_reader_get_object(shapes_reader* r) {
    uint64_t token = shapes_reader_get_u64(r);
    if (token == 0) {
        r->failed = true;
    }
    return (void*)(uintptr_t)token;
}

/* ---------------------------------------------------------------------------
 * Value types. A record is a struct of its fields; a rich enum is a `tag`
 * plus a union `as` with one struct per payload-carrying variant; a list is
 * `items` + `len`; a map is parallel `keys` and `values` arrays + `len`; an
 * optional is a pointer that is NULL when absent; an object is its pointer;
 * a string or byte string is a view (`ptr` + `len`).
 * ------------------------------------------------------------------------- */

typedef struct shapes_shapes_Numerics shapes_shapes_Numerics;
typedef struct shapes_shapes_Shape shapes_shapes_Shape;

/** One field per supported numeric primitive */
struct shapes_shapes_Numerics {
    int8_t a;
    int16_t b;
    int32_t c;
    int64_t d;
    uint8_t e;
    uint16_t f;
    uint32_t g;
    uint64_t h;
    float i;
    double j;
};

/** An algebraic shape (sum type with associated data) */
struct shapes_shapes_Shape {
    shapes_shapes_Shape_Tag tag;
    union {
        /** A circle with a radius */
        struct {
            /** Radius in points */
            double radius;
        } Circle;
        /** An axis-aligned rectangle */
        struct {
            float width;
            float height;
        } Rectangle;
        /** An integer-bounded shape (exercises narrow + wide ints) */
        struct {
            int16_t min;
            int16_t max;
            uint64_t weight;
        } Bounded;
        /** A labeled shape with a small count */
        struct {
            shapes_str label;
            uint8_t count;
        } Labeled;
    } as;
};

/* ---------------------------------------------------------------------------
 * Codecs. Each value type T above, and each optional shape, has four
 * functions:
 *
 *   T_write(w, v)            appends the value at `v` to writer `w`
 *   T_read(r, out)           decodes one value from reader `r`
 *   T_decode(ptr, len, out)  decodes a whole buffer; on a malformed
 *                            buffer it frees what it built and
 *                            returns false
 *   T_free(v)                releases a decoded value
 *
 * An optional's T_write takes the nullable pointer itself. Writing an
 * object stores a fresh `_clone` reference for the reader to adopt;
 * decoding adopts each object reference, and T_free destroys it. T_free
 * releases only what T_read or T_decode allocated; never call it on a
 * value that borrows caller memory.
 * ------------------------------------------------------------------------- */

static inline void shapes_shapes_Numerics_write(shapes_writer* w, const shapes_shapes_Numerics* v);
static inline void shapes_shapes_Numerics_read(shapes_reader* r, shapes_shapes_Numerics* out);
static inline bool shapes_shapes_Numerics_decode(const uint8_t* ptr, size_t len, shapes_shapes_Numerics* out);
static inline void shapes_shapes_Numerics_free(shapes_shapes_Numerics* v);
static inline void shapes_shapes_Shape_write(shapes_writer* w, const shapes_shapes_Shape* v);
static inline void shapes_shapes_Shape_read(shapes_reader* r, shapes_shapes_Shape* out);
static inline bool shapes_shapes_Shape_decode(const uint8_t* ptr, size_t len, shapes_shapes_Shape* out);
static inline void shapes_shapes_Shape_free(shapes_shapes_Shape* v);

static inline void shapes_shapes_Numerics_write(shapes_writer* w, const shapes_shapes_Numerics* v) {
    shapes_writer_put_i8(w, v->a);
    shapes_writer_put_i16(w, v->b);
    shapes_writer_put_i32(w, v->c);
    shapes_writer_put_i64(w, v->d);
    shapes_writer_put_u8(w, v->e);
    shapes_writer_put_u16(w, v->f);
    shapes_writer_put_u32(w, v->g);
    shapes_writer_put_u64(w, v->h);
    shapes_writer_put_f32(w, v->i);
    shapes_writer_put_f64(w, v->j);
}

static inline void shapes_shapes_Numerics_read(shapes_reader* r, shapes_shapes_Numerics* out) {
    memset(out, 0, sizeof *out);
    out->a = shapes_reader_get_i8(r);
    out->b = shapes_reader_get_i16(r);
    out->c = shapes_reader_get_i32(r);
    out->d = shapes_reader_get_i64(r);
    out->e = shapes_reader_get_u8(r);
    out->f = shapes_reader_get_u16(r);
    out->g = shapes_reader_get_u32(r);
    out->h = shapes_reader_get_u64(r);
    out->i = shapes_reader_get_f32(r);
    out->j = shapes_reader_get_f64(r);
}

static inline bool shapes_shapes_Numerics_decode(const uint8_t* ptr, size_t len, shapes_shapes_Numerics* out) {
    shapes_reader r = shapes_reader_of(ptr, len);
    shapes_shapes_Numerics_read(&r, out);
    if (!shapes_reader_finish(&r)) {
        shapes_shapes_Numerics_free(out);
        return false;
    }
    return true;
}

static inline void shapes_shapes_Numerics_free(shapes_shapes_Numerics* v) {
    memset(v, 0, sizeof *v);
}

static inline void shapes_shapes_Shape_write(shapes_writer* w, const shapes_shapes_Shape* v) {
    shapes_writer_put_i32(w, (int32_t)v->tag);
    switch (v->tag) {
    case shapes_shapes_Shape_Empty:
        break;
    case shapes_shapes_Shape_Circle:
        shapes_writer_put_f64(w, v->as.Circle.radius);
        break;
    case shapes_shapes_Shape_Rectangle:
        shapes_writer_put_f32(w, v->as.Rectangle.width);
        shapes_writer_put_f32(w, v->as.Rectangle.height);
        break;
    case shapes_shapes_Shape_Bounded:
        shapes_writer_put_i16(w, v->as.Bounded.min);
        shapes_writer_put_i16(w, v->as.Bounded.max);
        shapes_writer_put_u64(w, v->as.Bounded.weight);
        break;
    case shapes_shapes_Shape_Labeled:
        shapes_writer_put_string(w, v->as.Labeled.label);
        shapes_writer_put_u8(w, v->as.Labeled.count);
        break;
    default:
        w->failed = true;
        break;
    }
}

static inline void shapes_shapes_Shape_read(shapes_reader* r, shapes_shapes_Shape* out) {
    memset(out, 0, sizeof *out);
    int32_t tag = shapes_reader_get_i32(r);
    switch (tag) {
    case shapes_shapes_Shape_Empty:
        out->tag = shapes_shapes_Shape_Empty;
        break;
    case shapes_shapes_Shape_Circle:
        out->tag = shapes_shapes_Shape_Circle;
        out->as.Circle.radius = shapes_reader_get_f64(r);
        break;
    case shapes_shapes_Shape_Rectangle:
        out->tag = shapes_shapes_Shape_Rectangle;
        out->as.Rectangle.width = shapes_reader_get_f32(r);
        out->as.Rectangle.height = shapes_reader_get_f32(r);
        break;
    case shapes_shapes_Shape_Bounded:
        out->tag = shapes_shapes_Shape_Bounded;
        out->as.Bounded.min = shapes_reader_get_i16(r);
        out->as.Bounded.max = shapes_reader_get_i16(r);
        out->as.Bounded.weight = shapes_reader_get_u64(r);
        break;
    case shapes_shapes_Shape_Labeled:
        out->tag = shapes_shapes_Shape_Labeled;
        out->as.Labeled.label = shapes_reader_get_string(r);
        out->as.Labeled.count = shapes_reader_get_u8(r);
        break;
    default:
        r->failed = true;
        break;
    }
}

static inline bool shapes_shapes_Shape_decode(const uint8_t* ptr, size_t len, shapes_shapes_Shape* out) {
    shapes_reader r = shapes_reader_of(ptr, len);
    shapes_shapes_Shape_read(&r, out);
    if (!shapes_reader_finish(&r)) {
        shapes_shapes_Shape_free(out);
        return false;
    }
    return true;
}

static inline void shapes_shapes_Shape_free(shapes_shapes_Shape* v) {
    switch (v->tag) {
    case shapes_shapes_Shape_Labeled:
        shapes_str_free(&v->as.Labeled.label);
        break;
    default:
        break;
    }
    memset(v, 0, sizeof *v);
}

#ifdef __cplusplus
}
#endif

#endif // SHAPES_BUFFER_H

// END shapes_buffer.h
