  # Registers a OnBatch listener block. Returns a subscription id for
  # unregister_batch_listener.
  def self.register_batch_listener(&block)
    trampoline = FFI::Function.new(:void, [:pointer, :size_t, :pointer, :size_t, :pointer, :size_t, :int32, :pointer]) do |items_ptr, items_len, raw_ptr, raw_len, first_ptr, first_len, mode, _context|
      begin
        items_r = WvBufferReader.new(items_ptr.null? ? ''.b : items_ptr.read_string(items_len))
        items_v = Array.new(items_r.read_len) do
          _wv_e0 = _wv_read_outer(items_r)
          _wv_e0
        end
        items_r.expect_end!
        first_r = WvBufferReader.new(first_ptr.null? ? ''.b : first_ptr.read_string(first_len))
        if first_r.read_flag
          first_v = _wv_read_outer(first_r)
        else
          first_v = nil
        end
        first_r.expect_end!
      rescue Error => e
        warn "weaveffi: dropped OnBatch event: #{e.message}"
        next
      end
      block.call(items_v, (raw_ptr.null? ? ''.b : raw_ptr.read_string(raw_len)), first_v, mode)
    end
    listener_id = weaveffi_edge_cases_register_batch_listener(trampoline, FFI::Pointer::NULL)
    @listener_refs[listener_id] = trampoline
    listener_id
  end

