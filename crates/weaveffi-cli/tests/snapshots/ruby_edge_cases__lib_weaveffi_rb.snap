  class WidgetPtr < FFI::AutoPointer
    def self.release(ptr)
      WeaveFFI.weaveffi_edge_cases_Widget_destroy(ptr)
    end
  end

  # Interface with no constructor; instances come from make_widget
  class Widget
    attr_reader :handle

    # Wraps an owned pointer the producer handed over, without
    # re-running initialize.
    def self._from_ptr(ptr)
      obj = allocate
      obj.instance_variable_set(:@handle, WidgetPtr.new(ptr))
      obj
    end

    def destroy
      return if @handle.nil?
      @handle.free
      @handle = nil
    end

    # Void method that can fail
    def refresh()
      err = ErrorStruct.new
      WeaveFFI.weaveffi_edge_cases_Widget_refresh(@handle, err)
      WeaveFFI.check_edge_errors_error!(err)
    end

    def rename(class_, import)
      err = ErrorStruct.new
      import_w = WvBufferWriter.new
      if import.nil?
        import_w.write_flag(false)
      else
        import_w.write_flag(true)
        import_w.write_string(import)
      end
      import_data = import_w.data
      import_buf = FFI::MemoryPointer.new(:uint8, import_data.bytesize)
      import_buf.put_bytes(0, import_data)
      result = WeaveFFI.weaveffi_edge_cases_Widget_rename(@handle, class_, import_buf, import_data.bytesize, err)
      WeaveFFI.check_error!(err)
      return '' if result.null?
      str = result.read_string
      WeaveFFI.weaveffi_free_string(result)
      str
    end

    # Async method with a struct result
    # Blocks the current thread until the async producer completes; the
    # result (or error) is delivered through the completion callback.
    def fetch(id)
      queue = Queue.new
      callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer, :size_t]) do |_context, err_ptr, result_ptr, result_len|
        err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
        if err && err[:code] != 0
          code = err[:code]
          msg = err[:message].null? ? '' : err[:message].read_string
          payload = err[:payload_ptr].null? ? nil : err[:payload_ptr].read_string(err[:payload_len])
          WeaveFFI.weaveffi_error_free(err_ptr)
          queue << WeaveFFI.edge_errors_error_from(code, msg, payload)
        else
          begin
            _wv_r = WvBufferReader.new(result_ptr.null? ? ''.b : result_ptr.read_string(result_len))
            WeaveFFI.weaveffi_free_bytes(result_ptr, result_len) unless result_ptr.null?
            _wv_v = WeaveFFI._wv_read_outer(_wv_r)
            _wv_r.expect_end!
            queue << _wv_v
          rescue Error => e
            queue << e
          end
        end
      end
      WeaveFFI.weaveffi_edge_cases_Widget_fetch_async(@handle, id, callback, FFI::Pointer::NULL)
      value = queue.pop
      raise value if value.is_a?(Error)
      value
    end

    def old_name()
      warn "[DEPRECATED] Use rename instead"
      err = ErrorStruct.new
      result = WeaveFFI.weaveffi_edge_cases_Widget_old_name(@handle, err)
      WeaveFFI.check_error!(err)
      return '' if result.null?
      str = result.read_string
      WeaveFFI.weaveffi_free_string(result)
      str
    end
  end

