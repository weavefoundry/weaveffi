  # Async with no result
  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.async_void()
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer]) do |_context, err_ptr|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        queue << nil
      end
    end
    weaveffi_edge_cases_async_void_async(callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.async_bytes(size)
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer, :size_t]) do |_context, err_ptr, result, result_len|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        _wv_b = result.null? ? ''.b : result.read_string(result_len)
        weaveffi_free_bytes(result, result_len) unless result.null?
        queue << _wv_b
      end
    end
    weaveffi_edge_cases_async_bytes_async(size, callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.async_struct()
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer, :size_t]) do |_context, err_ptr, result_ptr, result_len|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        payload = err[:payload_ptr].null? ? nil : err[:payload_ptr].read_string(err[:payload_len])
        weaveffi_error_free(err_ptr)
        queue << edge_errors_error_from(code, msg, payload)
      else
        begin
          _wv_r = WvBufferReader.new(result_ptr.null? ? ''.b : result_ptr.read_string(result_len))
          weaveffi_free_bytes(result_ptr, result_len) unless result_ptr.null?
          _wv_v = _wv_read_outer(_wv_r)
          _wv_r.expect_end!
          queue << _wv_v
        rescue Error => e
          queue << e
        end
      end
    end
    weaveffi_edge_cases_async_struct_async(callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback (cancellation token not exposed; pass-through is NULL).
  def self.async_list()
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer, :size_t]) do |_context, err_ptr, result_ptr, result_len|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        payload = err[:payload_ptr].null? ? nil : err[:payload_ptr].read_string(err[:payload_len])
        weaveffi_error_free(err_ptr)
        queue << edge_errors_error_from(code, msg, payload)
      else
        begin
          _wv_r = WvBufferReader.new(result_ptr.null? ? ''.b : result_ptr.read_string(result_len))
          weaveffi_free_bytes(result_ptr, result_len) unless result_ptr.null?
          _wv_v = Array.new(_wv_r.read_len) do
            _wv_e0 = _wv_read_outer(_wv_r)
            _wv_e0
          end
          _wv_r.expect_end!
          queue << _wv_v
        rescue Error => e
          queue << e
        end
      end
    end
    weaveffi_edge_cases_async_list_async(FFI::Pointer::NULL, callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.async_optional()
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer, :size_t]) do |_context, err_ptr, result_ptr, result_len|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        begin
          _wv_r = WvBufferReader.new(result_ptr.null? ? ''.b : result_ptr.read_string(result_len))
          weaveffi_free_bytes(result_ptr, result_len) unless result_ptr.null?
          if _wv_r.read_flag
            _wv_v = _wv_r.read_i64
          else
            _wv_v = nil
          end
          _wv_r.expect_end!
          queue << _wv_v
        rescue Error => e
          queue << e
        end
      end
    end
    weaveffi_edge_cases_async_optional_async(callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.async_enum()
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :int32]) do |_context, err_ptr, result|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        queue << result
      end
    end
    weaveffi_edge_cases_async_enum_async(callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
