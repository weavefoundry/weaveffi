  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.async_keywords(class_, import)
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer]) do |_context, err_ptr, result|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        _wv_s = result.null? ? '' : result.read_string
        weaveffi_free_string(result) unless result.null?
        queue << _wv_s
      end
    end
    weaveffi_edge_cases_async_keywords_async(class_, import, callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  def self.keywords_roundtrip(value)
    err = ErrorStruct.new
    value_w = WvBufferWriter.new
    _wv_write_keywords(value_w, value)
    value_data = value_w.data
    value_buf = FFI::MemoryPointer.new(:uint8, value_data.bytesize)
    value_buf.put_bytes(0, value_data)
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_edge_cases_keywords_roundtrip(value_buf, value_data.bytesize, out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = _wv_read_keywords(_wv_r)
    _wv_r.expect_end!
    _wv_value
  end

  def self.legacy_value(value)
    warn "[DEPRECATED] Use Mode-based APIs"
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_edge_cases_legacy_value(value, out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = _wv_read_retired(_wv_r)
    _wv_r.expect_end!
    _wv_value
  end
end

# END weaveffi.rb
