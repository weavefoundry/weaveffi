	cRet := C.kitchen_sink_kitchen_Gadget_new(C.int64_t(id), &cErr)
	wvTrap(&cErr)
	return wvAdoptGadget(cRet)
}

// Describe: Render the gadget as a human-readable string
func (s *Gadget) Describe() string {
	cSelf := s.native()
	defer s.release()
	var cRetLen C.size_t
