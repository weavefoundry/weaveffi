	wvDone := make(chan wvOutcome[string], 1)
	wvHandle := cgo.NewHandle(wvDone)
	C.kitchen_sink_kitchen_do_cancellable(cInputPtr, cInputLen, wvToken, C.kitchen_sink_kitchen_do_cancellable_callback(unsafe.Pointer(C.goWv_kitchen_sink_kitchen_do_cancellable_callback)), C.wvHandlePtr(C.uintptr_t(wvHandle)))
	res, fail, err := wvAwait(ctx, wvDone, wvToken)
	if err != nil {
		return "", err
	}
	if fail != nil {
		panic(fail.err())
	}
	return res, nil
}

