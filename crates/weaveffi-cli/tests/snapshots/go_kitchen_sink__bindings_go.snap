	return func(yield func(*Gadget) bool) {
		var cErr C.kitchen_sink_error
		cIter := C.kitchen_sink_kitchen_stream_gadgets(&cErr)
		wvTrap(&cErr)
		defer C.kitchen_sink_kitchen_StreamGadgetsIterator_destroy(cIter)
		for {
			var cItem *C.kitchen_sink_kitchen_Gadget
			var cIterErr C.kitchen_sink_error
			more := C.kitchen_sink_kitchen_StreamGadgetsIterator_next(cIter, &cItem, &cIterErr) != 0
			wvTrap(&cIterErr)
			if !more {
				return
			}
			if !yield(wvAdoptGadget(cItem)) {
				return
			}
		}
	}
}

