// Token: A reusable token referenced across modules
type Token struct {
	ID    int64
	Label string
}

func wvWriteToken(w *wvWriter, v Token) {
	w.writeI64(v.ID)
	w.writeString(v.Label)
}

func wvReadToken(r *wvReader) Token {
	var v Token
	v.ID = r.readI64()
	v.Label = r.readString()
	return v
}

// Ping: Trivial cross-module helper
func Ping() string {
	wvLoaded()
	var cRetLen C.size_t
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_shared_ping(&cRetLen, &cErr)
	wvTrap(&cErr)
	return wvTakeString(cRet, cRetLen)
}

