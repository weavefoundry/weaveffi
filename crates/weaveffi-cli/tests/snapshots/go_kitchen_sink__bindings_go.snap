	cRet := C.kitchen_sink_kitchen_Gadget_describe(cSelf, &cRetLen, &cErr)
	wvTrap(&cErr)
	return wvTakeString(cRet, cRetLen)
}

// Poke the gadget a number of times, failing on a negative count
func (s *Gadget) Poke(times int32) (int32, error) {
	cSelf := s.native()
	defer s.release()
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_kitchen_Gadget_poke(cSelf, C.int32_t(times), &cErr)
	if cErr.code != 0 {
		return 0, wvKitchenError(wvTakeError(&cErr))
	}
	return int32(cRet), nil
}

