	wvTrap(&cErr)
	return wvDecode(cRet, cRetLen, wvReadListItem)
}

// GetAttrs: Map return type
func GetAttrs() map[string]int32 {
	var cRetLen C.size_t
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_kitchen_get_attrs(&cRetLen, &cErr)
	wvTrap(&cErr)
	return wvDecode(cRet, cRetLen, wvReadMapStringI32)
}

// StreamItems: Iterator return type
//
// The sequence launches the native iterator each time it's ranged over and
// pulls one element per step; the iterator is released when the range ends,
// early or not.
func StreamItems() iter.Seq[Item] {
	return func(yield func(Item) bool) {
		var cErr C.kitchen_sink_error
		cIter := C.kitchen_sink_kitchen_stream_items(&cErr)
		wvTrap(&cErr)
		defer C.kitchen_sink_kitchen_StreamItemsIterator_destroy(cIter)
		for {
			var cItem *C.uint8_t
			var cItemLen C.size_t
			var cIterErr C.kitchen_sink_error
			more := C.kitchen_sink_kitchen_StreamItemsIterator_next(cIter, &cItem, &cItemLen, &cIterErr) != 0
			wvTrap(&cIterErr)
			if !more {
				return
			}
			if !yield(wvDecode(cItem, cItemLen, wvReadItem)) {
				return
			}
		}
	}
}

// CrossModuleToken returns the shared Token type from another module
func CrossModuleToken() Token {
	var cRetLen C.size_t
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_kitchen_cross_module_token(&cRetLen, &cErr)
	wvTrap(&cErr)
	return wvDecode(cRet, cRetLen, wvReadToken)
}

//export goWv_kitchen_sink_kitchen_do_async_callback
func goWv_kitchen_sink_kitchen_do_async_callback(context_ unsafe.Pointer, err_ *C.kitchen_sink_error, result_ptr *C.uint8_t, result_len C.size_t) {
	wvComplete(context_, err_, func() string {
		return wvTakeString(result_ptr, result_len)
	})
}

// DoAsync: Async operation
//
// It blocks until the call completes or ctx is done; in the latter case it
// returns ctx.Err() at once and the native result is discarded.
func DoAsync(ctx context.Context, input string) (string, error) {
	if err := ctx.Err(); err != nil {
		return "", err
	}
	cInputPtr, cInputLen := wvStr(input)
	call := wvNewAsyncCall[string]()
	C.kitchen_sink_kitchen_do_async(cInputPtr, cInputLen, C.kitchen_sink_kitchen_do_async_callback(unsafe.Pointer(C.goWv_kitchen_sink_kitchen_do_async_callback)), call.context())
	res, fail, err := call.wait(ctx, nil)
	if err != nil {
		return "", err
	}
	if fail != nil {
		panic(fail.err())
	}
	return res, nil
}

//export goWv_kitchen_sink_kitchen_do_cancellable_callback
func goWv_kitchen_sink_kitchen_do_cancellable_callback(context_ unsafe.Pointer, err_ *C.kitchen_sink_error, result_ptr *C.uint8_t, result_len C.size_t) {
	wvComplete(context_, err_, func() string {
		return wvTakeString(result_ptr, result_len)
	})
}

// DoCancellable: Cancellable async operation
//
// It blocks until the call completes. Cancelling ctx cancels the native call,
// which then returns ctx.Err().
func DoCancellable(ctx context.Context, input string) (string, error) {
	if err := ctx.Err(); err != nil {
		return "", err
	}
	cInputPtr, cInputLen := wvStr(input)
	token := C.kitchen_sink_cancel_token_create()
	defer C.kitchen_sink_cancel_token_destroy(token)
	call := wvNewAsyncCall[string]()
	C.kitchen_sink_kitchen_do_cancellable(cInputPtr, cInputLen, token, C.kitchen_sink_kitchen_do_cancellable_callback(unsafe.Pointer(C.goWv_kitchen_sink_kitchen_do_cancellable_callback)), call.context())
	res, fail, err := call.wait(ctx, token)
	if err != nil {
		return "", err
	}
	if fail != nil {
		panic(fail.err())
	}
	return res, nil
}

