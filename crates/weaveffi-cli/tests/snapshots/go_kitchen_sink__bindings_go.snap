func wvWriteListGadget(w *wvWriter, v []*Gadget) {
	wvWriteList(w, v, wvWriteGadget)
}

func wvReadListGadget(r *wvReader) []*Gadget {
	return wvReadList(r, wvReadGadget)
}

func wvWriteListItem(w *wvWriter, v []Item) {
	wvWriteList(w, v, wvWriteItem)
}

func wvReadListItem(r *wvReader) []Item {
	return wvReadList(r, wvReadItem)
}

func wvWriteListString(w *wvWriter, v []string) {
	wvWriteList(w, v, (*wvWriter).writeString)
}

func wvReadListString(r *wvReader) []string {
	return wvReadList(r, (*wvReader).readString)
}

func wvWriteMapStringI32(w *wvWriter, v map[string]int32) {
	wvWriteMap(w, v, (*wvWriter).writeString, (*wvWriter).writeI32)
}

func wvReadMapStringI32(r *wvReader) map[string]int32 {
	return wvReadMap(r, (*wvReader).readString, (*wvReader).readI32)
}

func wvWriteMapStringString(w *wvWriter, v map[string]string) {
	wvWriteMap(w, v, (*wvWriter).writeString, (*wvWriter).writeString)
}

func wvReadMapStringString(r *wvReader) map[string]string {
	return wvReadMap(r, (*wvReader).readString, (*wvReader).readString)
}

func wvWriteOptGadget(w *wvWriter, v *Gadget) {
	wvWriteNilable(w, v, v != nil, wvWriteGadget)
}

func wvReadOptGadget(r *wvReader) *Gadget {
	return wvReadNilable(r, wvReadGadget)
}

func wvWriteOptI64(w *wvWriter, v *int64) {
	wvWriteOptional(w, v, (*wvWriter).writeI64)
}

func wvReadOptI64(r *wvReader) *int64 {
	return wvReadOptional(r, (*wvReader).readI64)
}

func wvWriteOptItem(w *wvWriter, v *Item) {
	wvWriteOptional(w, v, wvWriteItem)
}

func wvReadOptItem(r *wvReader) *Item {
	return wvReadOptional(r, wvReadItem)
}

