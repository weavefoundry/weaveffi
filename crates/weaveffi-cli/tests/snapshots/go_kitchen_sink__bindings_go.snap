// DoAsync: Async operation
//
// DoAsync blocks until the call completes or ctx is done; in the latter case
// it returns ctx.Err() at once and the native result is discarded.
func DoAsync(ctx context.Context, input string) (string, error) {
	wvLoaded()
	if err := ctx.Err(); err != nil {
		return "", err
	}
	cInputPtr, cInputLen := wvStr(input)
	call := wvNewAsyncCall[string]()
	C.kitchen_sink_kitchen_do_async(cInputPtr, cInputLen, C.kitchen_sink_kitchen_do_async_callback(unsafe.Pointer(C.goWv_kitchen_sink_kitchen_do_async_callback)), call.context())
	return wvAwait(ctx, call, nil, wvFailure.err)
}

