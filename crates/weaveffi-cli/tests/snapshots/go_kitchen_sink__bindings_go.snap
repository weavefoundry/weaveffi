}

// UnknownKitchenError is a KitchenError code these bindings don't declare,
// which a newer library may report.
type UnknownKitchenError struct {
	code int32
	// Message is the library's message.
	Message string
}

// Error returns the error's message.
func (e *UnknownKitchenError) Error() string {
	if e.Message == "" {
		return wvCodeMessage("KitchenErrors", e.code)
	}
	return e.Message
}

// Code returns the code the library reported.
func (e *UnknownKitchenError) Code() int32 {
	return e.code
}

func (*UnknownKitchenError) isKitchenError() {}

func (*UnknownKitchenError) wvPayload() []byte {
	return nil
}

func wvKitchenError(f wvFailure) error {
	switch f.code {
	case 1:
		return &NotFoundError{Message: f.message}
	case 2:
		return &InvalidInputError{Message: f.message}
	}
	if f.code > 0 {
		return &UnknownKitchenError{code: f.code, Message: f.message}
	}
	return f.err()
}

