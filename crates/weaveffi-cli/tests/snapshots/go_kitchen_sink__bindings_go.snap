func wvWrite_opt_Gadget(w *wvWriter, v *Gadget) {
	wvWriteNilable(w, v, v != nil, wvWriteGadget)
}

func wvRead_opt_Gadget(r *wvReader) *Gadget {
	return wvReadNilable(r, wvReadGadget)
}

func wvWrite_list_Gadget(w *wvWriter, v []*Gadget) {
	wvWriteList(w, v, wvWriteGadget)
}

func wvRead_list_Gadget(r *wvReader) []*Gadget {
	return wvReadList(r, wvReadGadget)
}

func wvWrite_opt_Item(w *wvWriter, v *Item) {
	wvWriteOptional(w, v, wvWriteItem)
}

func wvRead_opt_Item(r *wvReader) *Item {
	return wvReadOptional(r, wvReadItem)
}

func wvWrite_list_Item(w *wvWriter, v []Item) {
	wvWriteList(w, v, wvWriteItem)
}

func wvRead_list_Item(r *wvReader) []Item {
	return wvReadList(r, wvReadItem)
}

func wvWrite_map_string_i32(w *wvWriter, v map[string]int32) {
	wvWriteMap(w, v, (*wvWriter).writeString, (*wvWriter).writeI32)
}

func wvRead_map_string_i32(r *wvReader) map[string]int32 {
	return wvReadMap(r, (*wvReader).readString, (*wvReader).readI32)
}

func wvWrite_opt_string(w *wvWriter, v *string) {
	wvWriteOptional(w, v, (*wvWriter).writeString)
}

func wvRead_opt_string(r *wvReader) *string {
	return wvReadOptional(r, (*wvReader).readString)
}

// END bindings.go
