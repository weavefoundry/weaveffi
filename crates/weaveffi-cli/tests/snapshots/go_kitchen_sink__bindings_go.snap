		return &KitchenErrorsError{Code: f.code, Message: f.message}
	case KitchenErrorsErrorInvalidInput:
		if f.message == "" {
			f.message = "Invalid input"
		}
		return &KitchenErrorsError{Code: f.code, Message: f.message}
	default:
		return f.err()
	}
