// KitchenError is an error of the KitchenErrors domain: *NotFoundError,
// *InvalidInputError, or *UnknownKitchenError for a code these bindings don't
// declare.
//
// Match one code with errors.As and its type, or any code of the domain with a
// KitchenError. A callback method that declares the domain returns one to
// report that code.
type KitchenError interface {
	error
	// Code returns the error's numeric code.
	Code() int32
	isKitchenError()
}

// NotFoundError is the KitchenError code NotFound (1): Item not found.
type NotFoundError struct {
	// Message describes the failure; when it's empty, Error returns the
	// code's default message, "Item not found".
	Message string
}

// Error returns the error's message.
func (e *NotFoundError) Error() string {
	if e.Message == "" {
		return "Item not found"
	}
	return e.Message
}

// Code returns 1.
func (*NotFoundError) Code() int32 {
	return 1
}

func (*NotFoundError) isKitchenError() {}

func (*NotFoundError) wvPayload() []byte {
	return nil
}

// InvalidInputError is the KitchenError code InvalidInput (2): Invalid input.
type InvalidInputError struct {
	// Message describes the failure; when it's empty, Error returns the
