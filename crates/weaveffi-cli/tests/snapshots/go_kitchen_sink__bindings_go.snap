}

// Gadget: A pocket-sized interface exercising the object surface
//
// Each wrapper holds one strong reference to the object. Close releases it; a
// wrapper that's never closed releases it some time after it becomes
// unreachable.
type Gadget struct {
	wvObject
}

func wvDestroyGadget(ptr unsafe.Pointer) {
	C.kitchen_sink_Gadget_destroy((*C.kitchen_sink_Gadget)(ptr))
}

// wvAdoptGadget wraps one owned strong reference. A null pointer adopts to nil.
func wvAdoptGadget(ptr *C.kitchen_sink_Gadget) *Gadget {
	if ptr == nil {
		return nil
	}
	s := &Gadget{}
	s.adopt(unsafe.Pointer(ptr), wvDestroyGadget)
	return s
}

// native borrows the wrapper's pointer for one call; pair it with a
// deferred s.release().
func (s *Gadget) native() *C.kitchen_sink_Gadget {
	if s == nil {
		panic("kitchensink: nil *Gadget")
	}
	return (*C.kitchen_sink_Gadget)(s.acquire("Gadget"))
}

// share returns a new strong reference to the wrapper's object for the
// native library to adopt (the wrapper keeps its own), or null for nil.
func (s *Gadget) share() *C.kitchen_sink_Gadget {
	if s == nil {
		return nil
	}
	ptr := s.native()
	defer s.release()
	return C.kitchen_sink_Gadget_clone(ptr)
}

func wvWriteGadget(w *wvWriter, v *Gadget) {
	w.writeU64(uint64(uintptr(unsafe.Pointer(v.share()))))
}

func wvReadGadget(r *wvReader) *Gadget {
	token := r.readU64()
	if token == 0 {
		wvMalformed("null object token")
	}
	return wvAdoptGadget((*C.kitchen_sink_Gadget)(C.wvHandlePtr(C.uintptr_t(token))))
}

// NewGadget: Create a gadget with the given id
func NewGadget(id int64) *Gadget {
	wvLoaded()
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_Gadget_new(C.int64_t(id), &cErr)
	wvTrap(&cErr)
	return wvAdoptGadget(cRet)
}

// Describe: Render the gadget as a human-readable string
func (s *Gadget) Describe() string {
	cSelf := s.native()
	defer s.release()
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_Gadget_describe(cSelf, &cErr)
	wvTrap(&cErr)
	return wvTakeString(cRet)
}

// Poke the gadget a number of times, failing on a negative count
func (s *Gadget) Poke(times int32) (int32, error) {
	cSelf := s.native()
	defer s.release()
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_Gadget_poke(cSelf, C.int32_t(times), &cErr)
	if cErr.code != 0 {
		return 0, wvKitchenError(wvTakeError(&cErr))
	}
	return int32(cRet), nil
}

