				return wvOptional(bool(cHas), int32(cItem)), true
			},
			destroy: func() { C.kitchen_sink_kitchen_StreamMaybeIterator_destroy(it) },
		}
	})
}

// StreamChunks: Iterator of typed arrays
//
// StreamChunks returns a lazy sequence: each range over it launches the native
// iterator, pulls one element per step, and releases the iterator when the
// loop ends, early or not.
func StreamChunks() iter.Seq[[]int32] {
	wvLoaded()
	return wvSeq(func(cErr *C.kitchen_sink_error) wvCursor[[]int32] {
		it := C.kitchen_sink_kitchen_stream_chunks(cErr)
		return wvCursor[[]int32]{
			next: func(cErr *C.kitchen_sink_error) ([]int32, bool) {
				var cItem *C.int32_t
				var cItemLen C.size_t
				if C.kitchen_sink_kitchen_StreamChunksIterator_next(it, &cItem, &cItemLen, cErr) == 0 {
					return nil, false
				}
				return wvTakeSlice[int32](cItem, cItemLen), true
			},
			destroy: func() { C.kitchen_sink_kitchen_StreamChunksIterator_destroy(it) },
		}
	})
}

// SampleWith: Drive a consumer-implemented sampler
func SampleWith(sampler Sampler, level *uint32) ([]int16, error) {
	wvLoaded()
	cLevelHas, cLevel := wvPresent(level)
	var cRetLen C.size_t
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_kitchen_sample_with(wvNewCallback(sampler, "Sampler"), C.wvVtablePtr_kitchen_sink_kitchen_Sampler_vtable(), C._Bool(cLevelHas), C.uint32_t(cLevel), &cRetLen, &cErr)
	if cErr.code != 0 {
		return nil, wvPantryError(wvTakeError(&cErr))
	}
	return wvTakeSlice[int16](cRet, cRetLen), nil
}

// TakeFromPantry: Fails with the second domain
func TakeFromPantry(item string) (int32, error) {
	wvLoaded()
	cItemPtr, cItemLen := wvStr(item)
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_kitchen_take_from_pantry(cItemPtr, cItemLen, &cErr)
	if cErr.code != 0 {
		return 0, wvPantryError(wvTakeError(&cErr))
	}
	return int32(cRet), nil
}

// ParseAny: Fails with an untyped error
func ParseAny(text string) (int64, error) {
	wvLoaded()
	cTextPtr, cTextLen := wvStr(text)
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_kitchen_parse_any(cTextPtr, cTextLen, &cErr)
	if cErr.code != 0 {
		return 0, wvTakeError(&cErr).err()
	}
	return int64(cRet), nil
}

// Hello: Trivial nested-module function
func Hello() string {
	wvLoaded()
	var cRetLen C.size_t
	var cErr C.kitchen_sink_error
	cRet := C.kitchen_sink_kitchen_nested_hello(&cRetLen, &cErr)
	wvTrap(&cErr)
	return wvTakeString(cRet, cRetLen)
}

func wvWrite_list_string(w *wvWriter, v []string) {
	wvWriteList(w, v, (*wvWriter).writeString)
}

func wvRead_list_string(r *wvReader) []string {
	return wvReadList(r, (*wvReader).readString)
}

