func wvPantryError(f wvFailure) error {
	switch f.code {
	case 1:
		e := &OutOfStockError{Message: f.message}
		if f.payload != nil {
			r := &wvReader{buf: f.payload}
			e.Item = r.readString()
			r.expectEnd()
		}
		return e
	case 2:
		return &SpoiledError{Message: f.message}
	}
	if f.code > 0 {
		return &UnknownPantryError{code: f.code, Message: f.message}
	}
	return f.err()
}

// Priority: Task priority levels
type Priority int32

const (
	// Low priority
	PriorityLow Priority = 0
	// Normal priority
	PriorityNormal Priority = 1
	// High priority
	PriorityHigh Priority = 2
)

func wvWritePriority(w *wvWriter, v Priority) {
	w.writeI32(int32(v))
}

func wvReadPriority(r *wvReader) Priority {
	return Priority(r.readI32())
}

// Token: A reusable token referenced from several declarations
type Token struct {
	ID    int64
	Label string
}

func wvWriteToken(w *wvWriter, v Token) {
	w.writeI64(v.ID)
	w.writeString(v.Label)
}

func wvReadToken(r *wvReader) Token {
	var v Token
	v.ID = r.readI64()
	v.Label = r.readString()
	return v
}

// Item: Kitchen sink struct exercising every field feature
type Item struct {
	// Stable identifier
	ID int64
	// Display name
	Name string
	// Initial count
	Count int32
	// Whether the item is enabled
	Enabled bool
	// Scaling ratio
	Ratio   float64
	Nick    uint32
	Payload []byte
	Tags    []string
	Attrs   map[string]string
	Parent  *int64
	// A record inside a record
	Token    Token
	Priority Priority
	// An optional object inside a record
	Gadget *Gadget
}

func wvWriteItem(w *wvWriter, v Item) {
	w.writeI64(v.ID)
	w.writeString(v.Name)
	w.writeI32(v.Count)
	w.writeBool(v.Enabled)
	w.writeF64(v.Ratio)
	w.writeU32(v.Nick)
	w.writeBytes(v.Payload)
	wvWrite_list_string(w, v.Tags)
	wvWrite_map_string_string(w, v.Attrs)
	wvWrite_opt_i64(w, v.Parent)
	wvWriteToken(w, v.Token)
	wvWritePriority(w, v.Priority)
	wvWrite_opt_Gadget(w, v.Gadget)
}

func wvReadItem(r *wvReader) Item {
	var v Item
	v.ID = r.readI64()
	v.Name = r.readString()
	v.Count = r.readI32()
	v.Enabled = r.readBool()
	v.Ratio = r.readF64()
	v.Nick = r.readU32()
	v.Payload = r.readBytes()
	v.Tags = wvRead_list_string(r)
	v.Attrs = wvRead_map_string_string(r)
	v.Parent = wvRead_opt_i64(r)
	v.Token = wvReadToken(r)
	v.Priority = wvReadPriority(r)
	v.Gadget = wvRead_opt_Gadget(r)
	return v
}

// ReadyListener: Consumer-implemented observer of ready items
//
// Implement ReadyListener in Go and pass the value to the functions that take
// it. The native library may call its methods from any thread until it
// releases the implementation. A method that panics fails the native call in
// progress as a callback failure (code -4).
type ReadyListener interface {
	// Fires when an item is ready
	OnReady(code int32, msg string)
	// Receives the item itself and says whether to keep listening
	OnItem(item Item, gadget *Gadget) bool
	// A display label, failing with a kitchen error
	//
	// Return a KitchenError to report one of its codes, with its fields, to the
	// native caller; any other error reports code -1 with its text.
	Label() (string, error)
	// The most recent item the listener kept, if any
	Latest() *Item
	// The listener's favorite gadget
	Favorite() *Gadget
}

//export goWv_kitchen_sink_ReadyListener_on_ready
func goWv_kitchen_sink_ReadyListener_on_ready(ctx unsafe.Pointer, code C.int32_t, msg C.kitchen_sink_run, out_err *C.kitchen_sink_error) {
	defer wvRecoverCallback(out_err)
	wvCallback[ReadyListener](ctx).OnReady(int32(code), wvBorrowString(msg))
}

//export goWv_kitchen_sink_ReadyListener_on_item
func goWv_kitchen_sink_ReadyListener_on_item(ctx unsafe.Pointer, item C.kitchen_sink_run, gadget *C.kitchen_sink_Gadget, out_err *C.kitchen_sink_error) (cRet C._Bool) {
	defer wvRecoverCallback(out_err)
	ret := wvCallback[ReadyListener](ctx).OnItem(wvDecodeBorrowed(item, wvReadItem), wvAdoptGadget(gadget))
	return C._Bool(ret)
}

//export goWv_kitchen_sink_ReadyListener_label
func goWv_kitchen_sink_ReadyListener_label(ctx unsafe.Pointer, out_err *C.kitchen_sink_error) (cRet C.kitchen_sink_run) {
	defer wvRecoverCallback(out_err)
	ret, err := wvCallback[ReadyListener](ctx).Label()
	if err != nil {
		wvCallbackFailed[KitchenError](out_err, err)
		return
	}
	return wvAllocString(ret)
}

//export goWv_kitchen_sink_ReadyListener_latest
func goWv_kitchen_sink_ReadyListener_latest(ctx unsafe.Pointer, out_err *C.kitchen_sink_error) (cRet C.kitchen_sink_run) {
	defer wvRecoverCallback(out_err)
	ret := wvCallback[ReadyListener](ctx).Latest()
	return wvAllocSlice(wvEncode(ret, wvWrite_opt_Item))
}

//export goWv_kitchen_sink_ReadyListener_favorite
func goWv_kitchen_sink_ReadyListener_favorite(ctx unsafe.Pointer, out_err *C.kitchen_sink_error) (cRet *C.kitchen_sink_Gadget) {
	defer wvRecoverCallback(out_err)
	ret := wvCallback[ReadyListener](ctx).Favorite()
	return ret.share()
}

//export goWv_kitchen_sink_ReadyListener_free
func goWv_kitchen_sink_ReadyListener_free(ctx unsafe.Pointer) {
	wvFreeCallback(ctx)
}

// Sampler: Consumer-implemented source of scalar samples
//
// Implement Sampler in Go and pass the value to the functions that take it.
// The native library may call its methods from any thread until it releases
// the implementation. A method that panics fails the native call in progress
// as a callback failure (code -4).
type Sampler interface {
	// The cutoff for a level, if the sampler has one
	Threshold(level *uint32) *float64
	// Up to limit samples, failing when the pantry is empty
	//
	// Return a PantryError to report one of its codes, with its fields, to the
	// native caller; any other error reports code -1 with its text.
	Samples(limit *uint32, weights []float64) ([]int16, error)
	// A free-form description, failing with an untyped error
	//
	// A returned error reaches the native caller as code -1 with its text.
	Describe() (string, error)
}

//export goWv_kitchen_sink_Sampler_threshold
func goWv_kitchen_sink_Sampler_threshold(ctx unsafe.Pointer, level C.kitchen_sink_opt_u32, out_err *C.kitchen_sink_error) (cRet C.kitchen_sink_opt_f64) {
	defer wvRecoverCallback(out_err)
	ret := wvCallback[Sampler](ctx).Threshold(wvOptOutU32(level))
	return wvOptInF64(ret)
}

//export goWv_kitchen_sink_Sampler_samples
func goWv_kitchen_sink_Sampler_samples(ctx unsafe.Pointer, limit C.kitchen_sink_opt_u32, weights C.kitchen_sink_run, out_err *C.kitchen_sink_error) (cRet C.kitchen_sink_run) {
	defer wvRecoverCallback(out_err)
	ret, err := wvCallback[Sampler](ctx).Samples(wvOptOutU32(limit), wvBorrowSlice[float64](weights))
	if err != nil {
		wvCallbackFailed[PantryError](out_err, err)
		return
	}
	return wvAllocSlice(ret)
}

//export goWv_kitchen_sink_Sampler_describe
func goWv_kitchen_sink_Sampler_describe(ctx unsafe.Pointer, out_err *C.kitchen_sink_error) (cRet C.kitchen_sink_run) {
	defer wvRecoverCallback(out_err)
	ret, err := wvCallback[Sampler](ctx).Describe()
