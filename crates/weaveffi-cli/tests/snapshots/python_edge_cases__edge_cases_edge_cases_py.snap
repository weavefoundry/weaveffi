class BatchListener(abc.ABC):
    """Callback interface carrying composite payloads and objects

    Subclass it and implement every method to pass an instance where the
    API takes a `BatchListener`. The producer may call the methods from any
    thread until it releases the instance. An exception a method raises
    reaches the producer as Error.FOREIGN_ERROR_CODE (-4).
    """

    @abc.abstractmethod
    def on_batch(self, items: List[Outer], raw: bytes, first: Optional[Outer], mode: Mode) -> None:
        """Composite payloads cross as value buffers"""

    @abc.abstractmethod
    def on_widget(self, widget: Widget, fallback: Optional[Widget], children: List[Widget]) -> None:
        """Objects cross as strong references the consumer must release"""

    @abc.abstractmethod
    def on_tick(self) -> None:
        ...

    @abc.abstractmethod
    def should_continue(self, class_: int) -> bool:
        """Scalar return travels back through the vtable"""

    @abc.abstractmethod
    def pick_mode(self) -> Mode:
        """Enum return travels back as its integer discriminant"""


_BatchListener_on_batch_t = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int32, ctypes.POINTER(_ErrorStruct))
_BatchListener_on_widget_t = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.POINTER(_ErrorStruct))
_BatchListener_on_tick_t = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.POINTER(_ErrorStruct))
_BatchListener_should_continue_t = ctypes.CFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_int32, ctypes.POINTER(_ErrorStruct))
_BatchListener_pick_mode_t = ctypes.CFUNCTYPE(ctypes.c_int32, ctypes.c_void_p, ctypes.POINTER(_ErrorStruct))


class _BatchListenerVtable(ctypes.Structure):
    """The C vtable `edge_cases_edge_cases_BatchListener_vtable`."""

    _fields_ = [
        ("size", ctypes.c_uint32),
        ("flags", ctypes.c_uint32),
        ("free", _CallbackFree),
        ("on_batch", _BatchListener_on_batch_t),
        ("on_widget", _BatchListener_on_widget_t),
        ("on_tick", _BatchListener_on_tick_t),
        ("should_continue", _BatchListener_should_continue_t),
        ("pick_mode", _BatchListener_pick_mode_t),
    ]


def _BatchListener_on_batch(ctx: Optional[int], items_ptr: Optional[int], items_len: int, raw_ptr: Optional[int], raw_len: int, first_ptr: Optional[int], first_len: int, mode: int, out_err: Any) -> None:
    try:
        _callback_get(ctx).on_batch(_decode(_peek_bytes(items_ptr, items_len), _read_list_Outer), _peek_bytes(raw_ptr, raw_len), _decode(_peek_bytes(first_ptr, first_len), _read_opt_Outer), Mode(mode))
    except BaseException as exc:
        _callback_fail(out_err, exc)


def _BatchListener_on_widget(ctx: Optional[int], widget: Optional[int], fallback: Optional[int], children_ptr: Optional[int], children_len: int, out_err: Any) -> None:
    try:
        _widget = Widget._adopt(_required(widget))
        _fallback = Widget._adopt(fallback) if fallback else None
        _children = _decode(_peek_bytes(children_ptr, children_len), _read_list_Widget)
        _callback_get(ctx).on_widget(_widget, _fallback, _children)
    except BaseException as exc:
        _callback_fail(out_err, exc)


def _BatchListener_on_tick(ctx: Optional[int], out_err: Any) -> None:
    try:
        _callback_get(ctx).on_tick()
    except BaseException as exc:
        _callback_fail(out_err, exc)


def _BatchListener_should_continue(ctx: Optional[int], class_: int, out_err: Any) -> bool:
    try:
        return bool(_callback_get(ctx).should_continue(class_))
    except BaseException as exc:
        _callback_fail(out_err, exc)
        return False


def _BatchListener_pick_mode(ctx: Optional[int], out_err: Any) -> int:
    try:
        return int(_callback_get(ctx).pick_mode())
    except BaseException as exc:
        _callback_fail(out_err, exc)
        return 0


_BatchListener_vtable = _BatchListenerVtable(
    ctypes.sizeof(_BatchListenerVtable),
    0,
    _callback_free_fn,
    _BatchListener_on_batch_t(_BatchListener_on_batch),
    _BatchListener_on_widget_t(_BatchListener_on_widget),
    _BatchListener_on_tick_t(_BatchListener_on_tick),
    _BatchListener_should_continue_t(_BatchListener_should_continue),
    _BatchListener_pick_mode_t(_BatchListener_pick_mode),
)
_BatchListener_vtable_ptr = ctypes.addressof(_BatchListener_vtable)


class Keyword(abc.ABC):
    """Callback interface whose name and methods are keywords

    Subclass it and implement every method to pass an instance where the
    API takes a `Keyword`. The producer may call the methods from any
    thread until it releases the instance. An exception a method raises
    reaches the producer as Error.FOREIGN_ERROR_CODE (-4).
    """

