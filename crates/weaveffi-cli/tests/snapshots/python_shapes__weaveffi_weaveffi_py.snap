def describe(shape: "Shape") -> str:
    """Render a shape to a string
    """
    _fn = _lib.weaveffi_shapes_describe
    _fn.argtypes = [ctypes.c_char_p, ctypes.c_size_t, ctypes.POINTER(_WeaveFFIErrorStruct)]
    _fn.restype = ctypes.c_void_p
    _shape_buf = _pack_Shape(shape)
    _err = _WeaveFFIErrorStruct()
    _result = _fn(_shape_buf, len(_shape_buf), ctypes.byref(_err))
    _check_error(_err)
    return _take_string(_result) or ""


def scale(shape: "Shape", factor: float) -> "Shape":
    """Scale a shape by a factor, returning a new shape
    """
    _fn = _lib.weaveffi_shapes_scale
    _fn.argtypes = [ctypes.c_char_p, ctypes.c_size_t, ctypes.c_double, ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(_WeaveFFIErrorStruct)]
    _fn.restype = ctypes.c_void_p
    _shape_buf = _pack_Shape(shape)
    _err = _WeaveFFIErrorStruct()
    _out_len = ctypes.c_size_t(0)
    _result = _fn(_shape_buf, len(_shape_buf), factor, ctypes.byref(_out_len), ctypes.byref(_err))
    _check_error(_err)
    _data = _take_buffer(_result, _out_len.value)
    return _unpack_Shape(_data)


def sum_bytes(values: bytes) -> int:
    """Sum a list of bytes into a wide integer (numerics smoke)
    """
    _fn = _lib.weaveffi_shapes_sum_bytes
    _fn.argtypes = [ctypes.POINTER(ctypes.c_uint8), ctypes.c_size_t, ctypes.POINTER(_WeaveFFIErrorStruct)]
    _fn.restype = ctypes.c_uint64
    _values_arr = (ctypes.c_uint8 * len(values))(*values)
    _err = _WeaveFFIErrorStruct()
    _result = _fn(_values_arr, len(values), ctypes.byref(_err))
    _check_error(_err)
    return _result


def make_numerics(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: float, j: float) -> "Numerics":
    """Build a Numerics struct from every numeric primitive
    """
    _fn = _lib.weaveffi_shapes_make_numerics
    _fn.argtypes = [ctypes.c_int8, ctypes.c_int16, ctypes.c_int32, ctypes.c_int64, ctypes.c_uint8, ctypes.c_uint16, ctypes.c_uint32, ctypes.c_uint64, ctypes.c_float, ctypes.c_double, ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(_WeaveFFIErrorStruct)]
    _fn.restype = ctypes.c_void_p
    _err = _WeaveFFIErrorStruct()
    _out_len = ctypes.c_size_t(0)
    _result = _fn(a, b, c, d, e, f, g, h, i, j, ctypes.byref(_out_len), ctypes.byref(_err))
    _check_error(_err)
    _data = _take_buffer(_result, _out_len.value)
    return _unpack_Numerics(_data)

