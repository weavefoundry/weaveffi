    return Numerics(
        a=_r.read_i8(),
        b=_r.read_i16(),
        c=_r.read_i32(),
        d=_r.read_i64(),
        e=_r.read_u8(),
        f=_r.read_u16(),
        g=_r.read_u32(),
        h=_r.read_u64(),
