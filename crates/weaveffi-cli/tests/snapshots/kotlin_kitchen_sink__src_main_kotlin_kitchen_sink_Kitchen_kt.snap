package kitchen_sink

/**
 * Errors of the `KitchenErrors` domain, one subclass per code.
 *
 * A code these bindings don't declare (from a newer library) is a plain `KitchenException`
 * carrying that [code] and the library's message.
 */
open class KitchenException internal constructor(code: Int, message: String) : FfiException(code, message) {
    class NotFound(message: String = "Item not found") : KitchenException(1, message)
    class InvalidInput(message: String = "Invalid input") : KitchenException(2, message)

    internal companion object {
        /** The exception for a positive code and its serialized payload. */
        fun fromCode(code: Int, message: String, payload: ByteArray?): KitchenException = when (code) {
            1 -> NotFound(message)
            2 -> InvalidInput(message)
            else -> KitchenException(code, message)
        }
    }
}

/**
 * Errors of the `PantryError` domain, one subclass per code.
 *
 * A code these bindings don't declare (from a newer library) is a plain `PantryException`
 * carrying that [code] and the library's message.
 */
open class PantryException internal constructor(code: Int, message: String) : FfiException(code, message) {
    class OutOfStock(val item: String, message: String = "Out of stock") : PantryException(1, message) {
        override fun encodePayload(): ByteArray = encodeBuffer { _w ->
            _w.writeString(item)
        }
    }
    class Spoiled(message: String = "Spoiled") : PantryException(2, message)

    internal companion object {
        /** The exception for a positive code and its serialized payload. */
        fun fromCode(code: Int, message: String, payload: ByteArray?): PantryException = when (code) {
            1 -> if (payload == null) PantryException(code, message) else decodeBuffer(payload) { _r -> OutOfStock(_r.readString(), message) }
            2 -> Spoiled(message)
            else -> PantryException(code, message)
        }
    }
}

/** Task priority levels */
enum class Priority(val value: Int) {
    /** Low priority */
    Low(0),
    /** Normal priority */
    Normal(1),
    /** High priority */
    High(2);

    companion object {
        /** The variant whose ABI value is [value]. */
        @JvmStatic
        fun fromValue(value: Int): Priority = entries.firstOrNull { it.value == value }
            ?: throw NativeBugException(-3, "unknown Priority value $value")
    }
}

/** Kitchen sink struct exercising every field feature */
data class Item(
    /** Stable identifier */
    val id: Long,
    /** Display name */
    val name: String,
    /** Initial count */
    val count: Int,
    /** Whether the item is enabled */
    val enabled: Boolean,
    /** Scaling ratio */
    val ratio: Double,
    val nick: UInt,
    val payload: ByteArray,
    val tags: List<String>,
    val attrs: Map<String, String>,
    val parent: Long?,
    /** Cross-module struct reference */
    val token: Token,
    val priority: Priority,
    /** An optional object inside a record */
    val gadget: Gadget?,
) {
    override fun equals(other: Any?): Boolean {
        if (this === other) return true
        if (other !is Item) return false
        return id == other.id &&
            name == other.name &&
            count == other.count &&
            enabled == other.enabled &&
            ratio == other.ratio &&
            nick == other.nick &&
            payload.contentEquals(other.payload) &&
            tags == other.tags &&
            attrs == other.attrs &&
            parent == other.parent &&
            token == other.token &&
            priority == other.priority &&
            gadget == other.gadget
    }

    override fun hashCode(): Int {
        var result = id.hashCode()
        result = 31 * result + name.hashCode()
        result = 31 * result + count.hashCode()
        result = 31 * result + enabled.hashCode()
        result = 31 * result + ratio.hashCode()
        result = 31 * result + nick.hashCode()
        result = 31 * result + payload.contentHashCode()
        result = 31 * result + tags.hashCode()
        result = 31 * result + attrs.hashCode()
        result = 31 * result + parent.hashCode()
        result = 31 * result + token.hashCode()
        result = 31 * result + priority.hashCode()
        result = 31 * result + gadget.hashCode()
        return result
    }

    override fun toString(): String = "Item(id=${id}, name=${name}, count=${count}, enabled=${enabled}, ratio=${ratio}, nick=${nick}, payload=${payload.contentToString()}, tags=${tags}, attrs=${attrs}, parent=${parent}, token=${token}, priority=${priority}, gadget=${gadget})"
}

internal fun pack_Item(_w: BufferWriter, _v: Item) {
    _w.writeI64(_v.id)
    _w.writeString(_v.name)
    _w.writeI32(_v.count)
    _w.writeBool(_v.enabled)
    _w.writeF64(_v.ratio)
    _w.writeU32(_v.nick)
    _w.writeBytes(_v.payload)
    pack_list_string(_w, _v.tags)
    pack_map_string_string(_w, _v.attrs)
    pack_opt_i64(_w, _v.parent)
    pack_Token(_w, _v.token)
    _w.writeI32(_v.priority.value)
    pack_opt_Gadget(_w, _v.gadget)
}

internal fun unpack_Item(_r: BufferReader): Item = Item(
    _r.readI64(),
    _r.readString(),
    _r.readI32(),
    _r.readBool(),
    _r.readF64(),
    _r.readU32(),
    _r.readBytes(),
    unpack_list_string(_r),
    unpack_map_string_string(_r),
    unpack_opt_i64(_r),
    unpack_Token(_r),
    Priority.fromValue(_r.readI32()),
    unpack_opt_Gadget(_r),
)

/** Consumer-implemented observer of ready items */
interface ReadyListener {
    /** Fires when an item is ready */
    fun onReady(code: Int, msg: String)

    /** Receives the item itself and says whether to keep listening */
    fun onItem(item: Item, gadget: Gadget): Boolean

    /**
     * A display label, failing with a kitchen error
     *
     * Throw a [KitchenException] to report a typed error to the library; anything else
     * thrown reaches it as an untyped failure with its message.
     */
    @Throws(KitchenException::class)
    fun label(): String

    /** The most recent item the listener kept, if any */
    fun latest(): Item?

    /** The listener's favorite gadget */
    fun favorite(): Gadget
}

/** Consumer-implemented source of scalar samples */
interface Sampler {
    /** The cutoff for a level, if the sampler has one */
    fun threshold(level: UInt?): Double?

    /**
     * Up to `limit` samples, failing when the pantry is empty
     *
     * Throw a [PantryException] to report a typed error to the library; anything else
     * thrown reaches it as an untyped failure with its message.
     */
    @Throws(PantryException::class)
    fun samples(limit: UInt?, weights: List<Double>): List<Short>

    /**
     * A free-form description, failing with an untyped error
     *
     * Anything thrown reaches the library as a failure with its message.
     */
    @Throws(Exception::class)
    fun describe(): String
}

/** A pocket-sized interface exercising the object surface */
class Gadget private constructor(address: Long) : AutoCloseable {
    internal val handle: NativeHandle = NativeCleaner.register(this, NativeHandle(address, JniBridge::kitchen_Gadget_destroy))

    /** A new strong reference to this object, as written into a value buffer. */
    internal fun cloneHandle(): Long = handle.borrow { JniBridge.kitchen_Gadget_clone(it) }

    /** Render the gadget as a human-readable string */
    fun describe(): String = handle.borrow { _self ->
        decodeUtf8(JniBridge.kitchen_Gadget_describe(_self))
    }

    /** Poke the gadget a number of times, failing on a negative count */
    @Throws(KitchenException::class)
    fun poke(times: Int): Int = handle.borrow { _self ->
        JniBridge.kitchen_Gadget_poke(_self, times)
    }

    /** The gadget's sensor readings, optionally limited */
    @Throws(FfiException::class)
    fun readings(limit: UInt?): List<Double> = handle.borrow { _self ->
        JniBridge.kitchen_Gadget_readings(_self, limit != null, limit?.toInt() ?: 0).asList()
    }

    /** Releases this wrapper's native reference; safe to call more than once. */
    override fun close() = handle.close()

    companion object {
        /** Adopts one strong reference (a return value or a buffer token). */
        internal fun fromHandle(address: Long): Gadget = Gadget(address)

        /** [fromHandle], with address 0 meaning no object. */
        internal fun fromHandleOrNull(address: Long): Gadget? = if (address == 0L) null else Gadget(address)

        /** Create a gadget with the given id */
        @JvmStatic
        operator fun invoke(id: Long): Gadget = Gadget.fromHandle(JniBridge.kitchen_Gadget_new(id))

        /** The gadget subsystem version string */
        @JvmStatic
        fun version(): String = decodeUtf8(JniBridge.kitchen_Gadget_version())
    }
}

