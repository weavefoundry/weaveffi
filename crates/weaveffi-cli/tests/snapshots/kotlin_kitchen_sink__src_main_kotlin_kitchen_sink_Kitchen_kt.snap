        val _slot = LongArray(1)
        if (JniBridge.kitchen_StreamGadgetsIterator_next(_it, _slot)) Gadget.fromHandle(_slot[0]) else NativeIterator.DONE
    }

    /** Optional struct return */
    fun maybeItem(id: Long): Item? = decodeBuffer(JniBridge.kitchen_maybe_item(id)) { _r -> unpackOptionalOfItem(_r) }

    /** List of structs */
    fun listItems(): List<Item> = decodeBuffer(JniBridge.kitchen_list_items()) { _r -> unpackListOfItem(_r) }

    /** Map return type */
    fun getAttrs(): Map<String, Int> = decodeBuffer(JniBridge.kitchen_get_attrs()) { _r -> unpackMapOfStringToI32(_r) }

    /** Iterator return type */
    fun streamItems(): NativeIterator<Item> = NativeIterator(JniBridge.kitchen_stream_items(), JniBridge::kitchen_StreamItemsIterator_destroy) { _it ->
        val _item = JniBridge.kitchen_StreamItemsIterator_next(_it)
        if (_item == null) NativeIterator.DONE else decodeBuffer(_item) { _r -> unpackItem(_r) }
    }

    /** Returns the shared Token type from another module */
    fun crossModuleToken(): Token = decodeBuffer(JniBridge.kitchen_cross_module_token()) { _r -> unpackToken(_r) }

    /** Async operation */
    suspend fun doAsync(input: String): String = awaitNative(false, 0, { _raw -> decodeUtf8(_raw as ByteArray) }) { _, _done ->
        JniBridge.kitchen_do_async(encodeUtf8(input), _done)
    }

    /** Cancellable async operation */
    suspend fun doCancellable(input: String): String = awaitNative(true, 0, { _raw -> decodeUtf8(_raw as ByteArray) }) { _token, _done ->
        JniBridge.kitchen_do_cancellable(encodeUtf8(input), _token, _done)
    }

    /** Legacy operation kept for compatibility */
    @Deprecated("Use new_op instead")
    fun legacyOp(): Int = JniBridge.kitchen_legacy_op()

    /** Replacement for legacy_op */
    fun newOp(): Int = JniBridge.kitchen_new_op()

    object Nested {
        /** Trivial nested-module function */
        fun hello(): String = decodeUtf8(JniBridge.kitchen_nested_hello())
    }
