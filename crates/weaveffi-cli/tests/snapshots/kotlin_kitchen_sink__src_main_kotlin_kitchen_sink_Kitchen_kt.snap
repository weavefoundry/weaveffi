package kitchen_sink

/** Errors of the `KitchenErrors` domain. */
sealed class KitchenErrorsException(code: Int, message: String) : FfiException(code, message) {
    class NotFound(message: String = "Item not found") : KitchenErrorsException(1, message)
    class InvalidInput(message: String = "Invalid input") : KitchenErrorsException(2, message)

    internal companion object {
        /** The exception for a raw code and its serialized payload. */
        fun fromCode(code: Int, message: String, payload: ByteArray?): FfiException = when (code) {
            1 -> NotFound(message)
            2 -> InvalidInput(message)
            else -> FfiException(code, message)
        }
    }
}

/** Task priority levels */
enum class Priority(val value: Int) {
    /** Low priority */
    Low(0),
    /** Normal priority */
    Normal(1),
    /** High priority */
    High(2);

    companion object {
        /** The variant whose ABI value is [value]. */
        fun fromValue(value: Int): Priority = entries.firstOrNull { it.value == value }
            ?: throw NativeBugException(-3, "unknown Priority value $value")
    }
}

/** Kitchen sink struct exercising every field feature */
data class Item(
    /** Stable identifier */
    val id: Long,
    /** Display name */
    val name: String,
    /** Initial count */
    val count: Int,
    /** Whether the item is enabled */
    val enabled: Boolean,
    /** Scaling ratio */
    val ratio: Double,
    val nick: UInt,
    val payload: ByteArray,
    val tags: List<String>,
    val attrs: Map<String, String>,
    val parent: Long?,
    /** Cross-module struct reference */
    val token: Token,
    val priority: Priority,
    /** An optional object inside a record */
    val gadget: Gadget?,
)

internal fun packItem(_w: BufferWriter, _v: Item) {
    _w.writeI64(_v.id)
    _w.writeString(_v.name)
    _w.writeI32(_v.count)
    _w.writeBool(_v.enabled)
    _w.writeF64(_v.ratio)
    _w.writeU32(_v.nick)
    _w.writeBytes(_v.payload)
    packListOfString(_w, _v.tags)
    packMapOfStringToString(_w, _v.attrs)
    packOptionalOfI64(_w, _v.parent)
    packToken(_w, _v.token)
    _w.writeI32(_v.priority.value)
    packOptionalOfGadget(_w, _v.gadget)
}

internal fun unpackItem(_r: BufferReader): Item = Item(
    _r.readI64(),
    _r.readString(),
    _r.readI32(),
    _r.readBool(),
    _r.readF64(),
    _r.readU32(),
    _r.readBytes(),
    unpackListOfString(_r),
    unpackMapOfStringToString(_r),
    unpackOptionalOfI64(_r),
    unpackToken(_r),
    Priority.fromValue(_r.readI32()),
    unpackOptionalOfGadget(_r),
)

/** Consumer-implemented observer of ready items */
interface ReadyListener {
    /** Fires when an item is ready */
    fun onReady(code: Int, msg: String)

    /** Receives the item itself and says whether to keep listening */
    fun onItem(item: Item, gadget: Gadget): Boolean

    /**
     * A display label, failing with a kitchen error
     *
     * Throw a [KitchenErrorsException] to report a typed error to the library.
     */
    fun label(): String

    /** The most recent item the listener kept, if any */
    fun latest(): Item?

    /** The listener's favorite gadget */
    fun favorite(): Gadget
}

/** A pocket-sized interface exercising the object surface */
class Gadget private constructor(address: Long) : AutoCloseable {
    internal val handle: NativeHandle = NativeCleaner.register(this, NativeHandle(address, JniBridge::kitchen_Gadget_destroy))

    /** A new strong reference to this object, as written into a value buffer. */
    internal fun cloneHandle(): Long = handle.borrow { JniBridge.kitchen_Gadget_clone(it) }

    /** Render the gadget as a human-readable string */
    fun describe(): String = handle.borrow { _self ->
        decodeUtf8(JniBridge.kitchen_Gadget_describe(_self))
    }

    /** Poke the gadget a number of times, failing on a negative count */
    fun poke(times: Int): Int = handle.borrow { _self ->
        JniBridge.kitchen_Gadget_poke(_self, times)
    }

    /** Releases this wrapper's native reference; safe to call more than once. */
    override fun close() = handle.close()

    companion object {
        /** Adopts one strong reference (a return value or a buffer token). */
        internal fun fromHandle(address: Long): Gadget = Gadget(address)

        /** [fromHandle], with address 0 meaning no object. */
        internal fun fromHandleOrNull(address: Long): Gadget? = if (address == 0L) null else Gadget(address)

        /** Create a gadget with the given id */
        operator fun invoke(id: Long): Gadget = Gadget.fromHandle(JniBridge.kitchen_Gadget_new(id))

        /** The gadget subsystem version string */
        fun version(): String = decodeUtf8(JniBridge.kitchen_Gadget_version())
    }
}

object Kitchen {
    /** Identity for bool */
    fun boolId(x: Boolean): Boolean = JniBridge.kitchen_bool_id(x)

    fun i32Id(x: Int): Int = JniBridge.kitchen_i32_id(x)

    fun u32Id(x: UInt): UInt = JniBridge.kitchen_u32_id(x.toInt()).toUInt()

    fun i64Id(x: Long): Long = JniBridge.kitchen_i64_id(x)

    fun f64Id(x: Double): Double = JniBridge.kitchen_f64_id(x)

    fun echoString(s: String): String = decodeUtf8(JniBridge.kitchen_echo_string(encodeUtf8(s)))

    fun echoBytes(b: ByteArray): ByteArray = JniBridge.kitchen_echo_bytes(b)

    /** Register a listener, returning how many are attached */
    fun subscribe(listener: ReadyListener): Int = JniBridge.kitchen_subscribe(listener)

    /** Register a listener if one is given */
    fun maybeSubscribe(listener: ReadyListener?): Boolean = JniBridge.kitchen_maybe_subscribe(listener)

    /** Optional object in both directions */
