/// A struct two levels deep.
class Detail {
  final double area;

  Detail({required this.area});
}

void _packDetail(_BufferWriter w, Detail v) {
  w.writeFloat64(v.area);
}

Detail _unpackDetail(_BufferReader r) {
  return Detail(
    area: r.readFloat64(),
  );
}

typedef _NativeWeaveffiGraphicsShapesGeometryCompute = Pointer<Uint8> Function(Pointer<Uint8>, Size, Pointer<Size>, Pointer<_WeaveFFIError>);
typedef _DartWeaveffiGraphicsShapesGeometryCompute = Pointer<Uint8> Function(Pointer<Uint8>, int, Pointer<Size>, Pointer<_WeaveFFIError>);
final _weaveffiGraphicsShapesGeometryCompute = _lib.lookupFunction<
    _NativeWeaveffiGraphicsShapesGeometryCompute, _DartWeaveffiGraphicsShapesGeometryCompute>('weaveffi_graphics_shapes_geometry_compute');

/// Deeper function taking an ancestor-module struct. Throws through the root module's inherited GraphicsError domain.
///
/// Throws [GraphicsException] on domain errors.
Detail compute(Shape shape) {
  final shapeWriter = _BufferWriter();
  _packShape(shapeWriter, shape);
  final shapeBuf = shapeWriter.takeBytes();
  final shapePtr = _stageBytes(shapeBuf);
  final outLen = calloc<Size>();
  final err = calloc<_WeaveFFIError>();
  try {
    final result = _weaveffiGraphicsShapesGeometryCompute(shapePtr, shapeBuf.length, outLen, err);
    _checkGraphicsException(err);
    final n = outLen.value;
    final data = _copyNativeBytes(result, n);
    if (result != nullptr) _weaveffiFreeBytes(result, n);
    final reader = _BufferReader(data);
    final value = _unpackDetail(reader);
    reader.expectEnd();
    return value;
  } finally {
    calloc.free(shapePtr);
    calloc.free(outLen);
    calloc.free(err);
  }
}

