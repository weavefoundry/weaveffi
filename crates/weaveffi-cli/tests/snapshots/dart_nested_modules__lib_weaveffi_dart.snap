typedef _DartWeaveffiGraphicsNewCanvas = Pointer<Uint8> Function(int, Pointer<Size>, Pointer<_WeaveFFIError>);
final _weaveffiGraphicsNewCanvas = _lib.lookupFunction<
    _NativeWeaveffiGraphicsNewCanvas, _DartWeaveffiGraphicsNewCanvas>('weaveffi_graphics_new_canvas');

/// Construct a Canvas.
Canvas newCanvas(int width) {
  final outLen = calloc<Size>();
  final err = calloc<_WeaveFFIError>();
  try {
    final result = _weaveffiGraphicsNewCanvas(width, outLen, err);
    _checkError(err);
    final n = outLen.value;
    final data = _copyNativeBytes(result, n);
    if (result != nullptr) _weaveffiFreeBytes(result, n);
    final reader = _BufferReader(data);
    final value = _unpackCanvas(reader);
    reader.expectEnd();
    return value;
  } finally {
    calloc.free(outLen);
    calloc.free(err);
  }
}

/// A struct one level deep that references both an ancestor enum and a deeper struct.
class Shape {
  final int sides;
  /// Reference up to the parent module's enum
  final Unit unit;
  /// Reference down into a deeper module
  final Detail detail;

  Shape({required this.sides, required this.unit, required this.detail});
}

void _packShape(_BufferWriter w, Shape v) {
  w.writeInt32(v.sides);
  w.writeInt32(v.unit.value);
  _packDetail(w, v.detail);
}

Shape _unpackShape(_BufferReader r) {
  return Shape(
    sides: r.readInt32(),
    unit: Unit.fromValue(r.readInt32()),
    detail: _unpackDetail(r),
  );
}

