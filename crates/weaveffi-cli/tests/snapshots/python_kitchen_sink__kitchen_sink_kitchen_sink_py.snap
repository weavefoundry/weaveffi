    ]


def _ReadyListener_on_ready(ctx: int | None, code: int, msg_ptr: int | None, msg_len: int, out_err: Any) -> None:
    try:
        _callback_get(ctx).on_ready(code, _peek_bytes(msg_ptr, msg_len).decode("utf-8"))
    except BaseException as exc:
