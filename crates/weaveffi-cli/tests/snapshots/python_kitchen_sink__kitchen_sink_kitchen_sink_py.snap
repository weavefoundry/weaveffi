_run_free = _bind("kitchen_sink_run_free", None, _Run)
_debug_live_fn = _bind("kitchen_sink_debug_live", ctypes.c_uint64, ctypes.c_int32)


def _debug_live(kind: int) -> int:
    """The producer's live-resource counter `kind` (0 objects, 1 callbacks,
    2 iterators, 3 cancel tokens, 4 runs; -1 is 1 when the producer counts
    at all). Always 0 unless the producer was built with its leak counters
    enabled."""
    live: int = _debug_live_fn(kind)
    return live


def _peek(ptr: int | None, length: int) -> bytes:
    """Copy `length` bytes the producer only lends (a zero-length run's
    pointer is never read)."""
    return ctypes.string_at(ptr, length) if ptr and length else b""


def _read_error(err: _ErrorStruct) -> tuple[int, str, bytes]:
    """Copy a filled error slot's code, message, and payload, then release
    them."""
    code = err.code
    message = _peek(err.message_ptr, err.message_len).decode("utf-8", "replace")
    payload = _peek(err.payload_ptr, err.payload_len)
    _error_clear(ctypes.byref(err))
    return code, message, payload


def _trap_from(code: int, message: str, payload: bytes = b"") -> InternalError:
    """The exception for a failed call that declares no errors."""
    return InternalError(code, message)


def _error_from(code: int, message: str, payload: bytes = b"") -> Error:
    """The exception for a failed call declared `throws: any`."""
    return Error(code, message)


def _unknown_code(domain: type[Error], code: int, message: str) -> Error:
    """The exception for a code a domain's factory doesn't know: a positive
    code (from a library newer than these bindings) raises the domain's base
    class with the code and message; a runtime code raises the root error."""
    return domain(code, message) if code > 0 else Error(code, message)


# Runs into the producer. A parameter's run is lent for the call: it points
# into a Python object the run keeps alive.


def _run_in(data: bytes) -> _Run:
    """Lend `data` (a string's UTF-8, bytes, or a value buffer) to one call,
    without copying it."""
    ptr = ctypes.cast(ctypes.c_char_p(data), ctypes.c_void_p).value if data else None
    run = _Run(ptr, len(data))
    run._keep = data
    return run


# Runs out of the producer: a returned run is the consumer's to release
# with kitchen_sink_run_free; a callback argument's is only lent.


def _take_bytes(run: _Run) -> bytes:
    """Copy a run the producer handed over, then release it."""
    if not run.ptr:
        return b""
    try:
        return ctypes.string_at(run.ptr, run.len)
    finally:
        _run_free(run)


def _take_str(run: _Run) -> str:
    """Copy and release a string the producer handed over."""
    return _take_bytes(run).decode("utf-8")


def _peek_bytes(run: _Run) -> bytes:
    """Copy a run the producer only lends."""
    return _peek(run.ptr, run.len)


def _peek_str(run: _Run) -> str:
    """Copy a string the producer only lends."""
    return _peek(run.ptr, run.len).decode("utf-8")


# Optional scalars out of the producer.


def _opt_int(opt: Any) -> int | None:
    return int(opt.value) if opt.has else None


def _opt_float(opt: Any) -> float | None:
    return float(opt.value) if opt.has else None


def _opt_bool(opt: Any) -> bool | None:
    return bool(opt.value) if opt.has else None


_E = TypeVar("_E", bound=IntEnum)


def _opt_enum(opt: Any, cls: type[_E]) -> _E | None:
    return cls(opt.value) if opt.has else None


# Range checks. ctypes truncates an out-of-range integer argument to the C
# width silently, so every integer crossing as a scalar is checked first.


def _int_check(kind: str, lo: int, hi: int) -> Callable[[int, str], int]:
    def check(value: int, what: str) -> int:
        try:
            v = operator.index(value)
        except TypeError:
            raise TypeError(f"{what}: expected an integer, got {type(value).__name__}") from None
        if lo <= v <= hi:
            return v
        raise OverflowError(f"{what}: {v} is out of range for {kind}")

    return check


_i8 = _int_check("i8", -(1 << 7), (1 << 7) - 1)
_i16 = _int_check("i16", -(1 << 15), (1 << 15) - 1)
_i32 = _int_check("i32", -(1 << 31), (1 << 31) - 1)
_i64 = _int_check("i64", -(1 << 63), (1 << 63) - 1)
_u8 = _int_check("u8", 0, (1 << 8) - 1)
_u16 = _int_check("u16", 0, (1 << 16) - 1)
_u32 = _int_check("u32", 0, (1 << 32) - 1)
_u64 = _int_check("u64", 0, (1 << 64) - 1)


def _float(value: float, what: str) -> float:
    """A number as a float, rejecting anything else."""
    if isinstance(value, (int, float)):
        return float(value)
    raise TypeError(f"{what}: expected a number, got {type(value).__name__}")


# Typed arrays: numeric lists crossing as a run of packed elements. Each
# element kind's `array` typecode and ctypes element type.
_ARRAY_TYPES: dict[str, tuple[str, Any]] = {
    "i8": ("b", ctypes.c_int8),
    "i16": ("h", ctypes.c_int16),
    "i32": ("i", ctypes.c_int32),
    "i64": ("q", ctypes.c_int64),
    "u16": ("H", ctypes.c_uint16),
    "u32": ("I", ctypes.c_uint32),
    "u64": ("Q", ctypes.c_uint64),
    "f32": ("f", ctypes.c_float),
    "f64": ("d", ctypes.c_double),
}


def _array(values: Iterable[Any], kind: str, what: str) -> array.array[Any]:
    """Pack a sequence of numbers into a range-checked typed array. An
    `array.array` of the matching typecode is used as is, without a copy."""
    code = _ARRAY_TYPES[kind][0]
    if isinstance(values, array.array) and values.typecode == code:
        return values
    if isinstance(values, (str, bytes, bytearray, memoryview)):
        raise TypeError(f"{what}: expected a sequence of numbers, got {type(values).__name__}")
    try:
        return array.array(code, values)
    except OverflowError:
        raise OverflowError(f"{what}: an element is out of range for {kind}") from None
    except TypeError as exc:
        raise TypeError(f"{what}: {exc}") from None


def _array_in(values: Iterable[Any], kind: str, what: str) -> _Run:
    """Lend a typed array to one call. Its buffer is allocated by Python,
    which aligns it for every element type."""
    data = _array(values, kind, what)
    size = len(data) * data.itemsize
    run = _Run(data.buffer_info()[0] if size else None, size)
    run._keep = data
    return run


def _peek_array(run: _Run, kind: str) -> list[Any]:
    """Copy a typed array the producer only lends."""
    if not run.ptr or not run.len:
        return []
    ctype = _ARRAY_TYPES[kind][1]
    values: list[Any] = (ctype * (run.len // ctypes.sizeof(ctype))).from_address(run.ptr)[:]
    return values


def _take_array(run: _Run, kind: str) -> list[Any]:
    """Copy a typed array the producer handed over, then release it."""
    if not run.ptr:
        return []
    try:
        return _peek_array(run, kind)
    finally:
        _run_free(run)


_H = TypeVar("_H", bound="_Handle")
_T = TypeVar("_T")


class _Handle:
    """Owns one native reference and releases it exactly once.

    Calls lend the pointer through `_acquire`/`_release`, so `close()` from
    another thread while a call is in flight defers the release until the
    last such call returns instead of freeing the object mid-call.
    """

    def _init_handle(self, ptr: int) -> None:
        self._ptr: int | None = ptr
        self._key = ptr
        self._calls = 0
        self._closing = False
        self._lock = threading.Lock()

    def _free(self, ptr: int) -> None:
        """Release the native reference (each subclass releases its kind)."""

    def _acquire(self) -> int:
        with self._lock:
            ptr = self._ptr
            if ptr is None or self._closing:
                raise ValueError(f"{type(self).__name__} is closed")
            self._calls += 1
            return ptr

    def _release(self) -> None:
        with self._lock:
            self._calls -= 1
            if self._calls or not self._closing:
                return
            ptr, self._ptr = self._ptr, None
        if ptr is not None:
            self._free(ptr)

    def close(self) -> None:
        """Release the native reference. Idempotent; the object is unusable
        afterwards."""
        lock = getattr(self, "_lock", None)
        if lock is None:
            return
        with lock:
            if self._closing:
                return
            self._closing = True
            if self._calls:
                return
            ptr, self._ptr = self._ptr, None
        if ptr is not None:
            self._free(ptr)

    def __enter__(self: _H) -> _H:
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    def __del__(self) -> None:
        # An unreachable handle has no call in flight: release directly.
        ptr = getattr(self, "_ptr", None)
        if ptr is not None:
            self._ptr = None
            self._free(ptr)


class _Object(_Handle):
    """Base of every interface wrapper: a reference-counted native object.
    Two wrappers are equal when they hold the same native object."""

    # The native destroy and clone functions, set per subclass.
    _destroy: ClassVar[Callable[[int], None]]
    _clone: ClassVar[Callable[[int], int]]

    @classmethod
    def _adopt(cls: type[_H], ptr: int) -> _H:
        """Wrap one strong reference the producer handed over."""
        obj = cls.__new__(cls)
        obj._init_handle(ptr)
        return obj

    def _free(self, ptr: int) -> None:
        type(self)._destroy(ptr)

    def _clone_ref(self) -> int:
        """A new strong reference to the same object, for a receiver that
        adopts it (an object token, or a callback method's return)."""
        ptr = self._acquire()
        try:
            return type(self)._clone(ptr)
        finally:
            self._release()

    def __eq__(self, other: object) -> bool:
        if not isinstance(other, _Object):
            return NotImplemented
        return self is other or (self._ptr is not None and self._ptr == other._ptr)

    def __hash__(self) -> int:
        return hash(self._key)


class NativeIterator(Iterator[_T], _Handle, Generic[_T]):
    """A lazy iterator over a sequence the native library produces.

    Each step pulls one element from the producer. The native handle is
    released when the iterator is exhausted, on `close()`, at the end of a
    `with` block, or by garbage collection; a closed iterator is exhausted.
    Iterator-returning calls create these; there's no public constructor.
    """

    _pull: Callable[[int], _T]
    _destroy_fn: Callable[[int], None]

    def __init__(self) -> None:
        raise TypeError("NativeIterator objects come from the API's iterator-returning calls")

    def _free(self, ptr: int) -> None:
        self._destroy_fn(ptr)

    def __next__(self) -> _T:
        with self._lock:
            ptr = self._ptr
            if ptr is None or self._closing:
                raise StopIteration
            self._calls += 1
        try:
            item = self._pull(ptr)
        except StopIteration:
            self._release()
            self.close()
            raise
        except BaseException:
            self._release()
            raise
        self._release()
        return item

    def __repr__(self) -> str:
        state = "closed" if self._ptr is None or self._closing else "open"
        return f"<NativeIterator ({state})>"


def _iterate(
    ptr: int, pull: Callable[[int], _T], destroy: Callable[[int], None]
) -> NativeIterator[_T]:
    """Wrap an iterator handle the producer returned."""
    it: NativeIterator[_T] = NativeIterator.__new__(NativeIterator)
    it._init_handle(ptr)
    it._pull = pull
    it._destroy_fn = destroy
    return it


def _required(ptr: int | None) -> int:
    """A non-null object pointer the producer returned."""
    if not ptr:
        raise InternalError(-3, "the producer returned a null object")
    return ptr


def _lend(obj: Any, cls: type[_Object]) -> int:
    """Lend `obj`'s native pointer to one call; pair with `obj._release()`."""
    if not isinstance(obj, cls):
        raise TypeError(f"expected {cls.__name__}, got {type(obj).__name__}")
    return obj._acquire()


def _lend_opt(obj: Any, cls: type[_Object]) -> int | None:
    """`_lend` for an optional object: None lends a null pointer."""
    return None if obj is None else _lend(obj, cls)


def _release_opt(obj: _Object | None) -> None:
    if obj is not None:
        obj._release()


_S_I8 = struct.Struct("<b")
_S_U8 = struct.Struct("<B")
_S_I16 = struct.Struct("<h")
_S_U16 = struct.Struct("<H")
_S_I32 = struct.Struct("<i")
_S_U32 = struct.Struct("<I")
_S_I64 = struct.Struct("<q")
_S_U64 = struct.Struct("<Q")
_S_F32 = struct.Struct("<f")
_S_F64 = struct.Struct("<d")


def _malformed(what: str) -> InternalError:
    return InternalError(-3, f"malformed value buffer: {what}")


def _bad_value(kind: str, value: object) -> Exception:
    """The exception for a value `struct` can't pack as `kind`: out of range
    for a number, else the wrong type."""
    if isinstance(value, (int, float)):
        return OverflowError(f"{value} is out of range for {kind}")
    return TypeError(f"expected a number for {kind}, got {type(value).__name__}")


class _Writer:
    """Encodes values in the value-buffer wire format: little-endian,
    packed, no alignment."""

    __slots__ = ("_buf", "_objects")

    def __init__(self) -> None:
        self._buf = bytearray()
        self._objects: list[tuple[int, _Object]] = []

    def finish(self) -> bytes:
        # Object tokens are minted last, so an encoding that fails part-way
        # never leaks a strong reference.
        minted: list[tuple[_Object, int]] = []
        try:
            for pos, obj in self._objects:
                ptr = obj._clone_ref()
                minted.append((obj, ptr))
                _S_U64.pack_into(self._buf, pos, ptr)
        except BaseException:
            for obj, ptr in minted:
                type(obj)._destroy(ptr)
            raise
        self._objects = []
        return bytes(self._buf)

    def _put(self, fmt: struct.Struct, kind: str, v: Any) -> None:
        try:
            self._buf += fmt.pack(v)
        except struct.error:
            raise _bad_value(kind, v) from None

    def write_bool(self, v: bool) -> None:
        self._buf.append(1 if v else 0)

    def write_i8(self, v: int) -> None:
        self._put(_S_I8, "i8", v)

    def write_u8(self, v: int) -> None:
        self._put(_S_U8, "u8", v)

    def write_i16(self, v: int) -> None:
        self._put(_S_I16, "i16", v)

    def write_u16(self, v: int) -> None:
        self._put(_S_U16, "u16", v)

    def write_i32(self, v: int) -> None:
        self._put(_S_I32, "i32", v)

    def write_u32(self, v: int) -> None:
        self._put(_S_U32, "u32", v)

    def write_i64(self, v: int) -> None:
        self._put(_S_I64, "i64", v)

    def write_u64(self, v: int) -> None:
        self._put(_S_U64, "u64", v)

    def write_f32(self, v: float) -> None:
        self._put(_S_F32, "f32", v)

    def write_f64(self, v: float) -> None:
        self._put(_S_F64, "f64", v)

    def write_count(self, n: int) -> None:
        self._buf += _S_U32.pack(n)

    def write_flag(self, present: bool) -> None:
        self._buf.append(1 if present else 0)

    def write_string(self, v: str) -> None:
        data = v.encode("utf-8")
        self._buf += _S_U32.pack(len(data))
        self._buf += data

    def write_bytes(self, v: bytes) -> None:
        self._buf += _S_U32.pack(len(v))
        self._buf += v

    def write_numbers(self, code: str, kind: str, values: Sequence[Any]) -> None:
        """A list of one fixed-width numeric primitive (`code` is its struct
        format character), packed in one call."""
        try:
            data = struct.pack(f"<{len(values)}{code}", *values)
        except struct.error:
            one = struct.Struct(f"<{code}")
            for v in values:
                try:
                    one.pack(v)
                except struct.error:
                    raise _bad_value(kind, v) from None
            raise
        self._buf += _S_U32.pack(len(values))
        self._buf += data

    def write_object(self, obj: Any, cls: type[_Object]) -> None:
        """Reserve an object token: one strong reference to `obj` the reader
        adopts, cloned in `finish()`. A closed wrapper is rejected now."""
        if not isinstance(obj, cls):
            raise TypeError(f"expected {cls.__name__}, got {type(obj).__name__}")
        obj._acquire()
        obj._release()
        self._objects.append((len(self._buf), obj))
        self._buf += bytes(8)


class _Reader:
    """Decodes values from the value-buffer wire format, rejecting truncated
    buffers, invalid flag bytes, invalid UTF-8, undeclared enum values, and
    trailing data."""

    __slots__ = ("_data", "_pos")

    def __init__(self, data: bytes) -> None:
        self._data = data
        self._pos = 0

    def _take(self, n: int, what: str) -> int:
        pos = self._pos
        if len(self._data) - pos < n:
            raise _malformed(f"truncated {what}")
        self._pos = pos + n
        return pos

    def read_bool(self) -> bool:
        b = self._data[self._take(1, "bool")]
        if b > 1:
            raise _malformed("invalid bool byte")
        return b == 1

    def read_i8(self) -> int:
        return int(_S_I8.unpack_from(self._data, self._take(1, "i8"))[0])

    def read_u8(self) -> int:
        return self._data[self._take(1, "u8")]

    def read_i16(self) -> int:
        return int(_S_I16.unpack_from(self._data, self._take(2, "i16"))[0])

    def read_u16(self) -> int:
        return int(_S_U16.unpack_from(self._data, self._take(2, "u16"))[0])

    def read_i32(self) -> int:
        return int(_S_I32.unpack_from(self._data, self._take(4, "i32"))[0])

    def read_u32(self) -> int:
        return int(_S_U32.unpack_from(self._data, self._take(4, "u32"))[0])

    def read_i64(self) -> int:
        return int(_S_I64.unpack_from(self._data, self._take(8, "i64"))[0])

    def read_u64(self) -> int:
        return int(_S_U64.unpack_from(self._data, self._take(8, "u64"))[0])

    def read_f32(self) -> float:
        return float(_S_F32.unpack_from(self._data, self._take(4, "f32"))[0])

    def read_f64(self) -> float:
        return float(_S_F64.unpack_from(self._data, self._take(8, "f64"))[0])

    def read_count(self) -> int:
        # An element count, not a byte length: elements can encode to zero
        # bytes, so it isn't bounded by the remaining data.
        return int(_S_U32.unpack_from(self._data, self._take(4, "count"))[0])

    def read_flag(self) -> bool:
        b = self._data[self._take(1, "option flag")]
        if b > 1:
            raise _malformed("invalid option flag")
        return b == 1

    def read_bytes(self) -> bytes:
        n = int(_S_U32.unpack_from(self._data, self._take(4, "length"))[0])
        pos = self._take(n, "bytes")
        return self._data[pos:pos + n]

    def read_string(self) -> str:
        try:
            return self.read_bytes().decode("utf-8")
        except UnicodeDecodeError:
            raise _malformed("string is not valid UTF-8") from None

    def read_enum(self, cls: type[_E]) -> _E:
        value = self.read_i32()
        try:
            return cls(value)
        except ValueError:
            raise _malformed(f"undeclared {cls.__name__} value {value}") from None

    def read_numbers(self, code: str, size: int) -> list[Any]:
        """A list of one fixed-width numeric primitive, unpacked in one call."""
        n = self.read_count()
        pos = self._take(n * size, "list")
        return list(struct.unpack_from(f"<{n}{code}", self._data, pos))

    def read_object(self) -> int:
        """An object token: one strong reference the caller adopts."""
        ptr = int(_S_U64.unpack_from(self._data, self._take(8, "object token"))[0])
        if ptr == 0:
            raise _malformed("null object token")
        return ptr

    def expect_end(self) -> None:
        if self._pos != len(self._data):
            raise _malformed("trailing bytes")


def _decode(data: bytes, read: Callable[[_Reader], _T]) -> _T:
    """Decode exactly one value from `data`."""
    r = _Reader(data)
    value = read(r)
    r.expect_end()
    return value


# Async completions. A call registers its future under an integer key, passes
# the key as the launcher's `context`, and the function's static completion
# trampoline settles it from whichever producer thread completes the call.
# The trampolines live at module scope, so nothing a pending call needs can
# be garbage collected before the producer fires the completion, even when
# the awaiting coroutine is gone.
_pending: dict[int, tuple[asyncio.AbstractEventLoop, asyncio.Future[Any]]] = {}
_pending_lock = threading.Lock()
_pending_next = 0

_error_free = _bind("kitchen_sink_error_free", None, ctypes.c_void_p)


def _async_begin() -> tuple[int, asyncio.Future[Any]]:
    """Register a new pending call on the running event loop."""
    global _pending_next
    loop = asyncio.get_running_loop()
    future = loop.create_future()
    with _pending_lock:
        _pending_next += 1
        key = _pending_next
        _pending[key] = (loop, future)
    return key, future


def _async_abandon(key: int) -> None:
    """Forget a call whose launcher never ran."""
    with _pending_lock:
        _pending.pop(key, None)


def _async_error(err: int, factory: Callable[[int, str, bytes], BaseException]) -> BaseException:
    """Copy and release a heap-boxed completion error, then build the
    exception it reports. The cancelled code maps to CancelledError."""
    e = _ErrorStruct.from_address(err)
    code = e.code
    message = _peek(e.message_ptr, e.message_len).decode("utf-8", "replace")
    payload = _peek(e.payload_ptr, e.payload_len)
    _error_free(err)
    if code == Error.CANCELLED_ERROR_CODE:
        return asyncio.CancelledError(message)
    return factory(code, message, payload)


def _async_settle(key: int | None, exc: BaseException | None, value: Any) -> None:
    """Hand a completion back to the event loop that awaits it."""
    with _pending_lock:
        entry = _pending.pop(key or 0, None)
    if entry is None:
        return
    loop, future = entry
    try:
        loop.call_soon_threadsafe(_async_resolve, future, exc, value)
    except RuntimeError:
        # The loop is closed, so nothing awaits the result any more.
        pass


def _async_resolve(future: asyncio.Future[Any], exc: BaseException | None, value: Any) -> None:
    if future.done():
        return
    if isinstance(exc, asyncio.CancelledError):
        future.cancel()
    elif exc is not None:
        future.set_exception(exc)
    else:
        future.set_result(value)


# Cancellation for `cancellable` async functions. Each call creates a token,
# the producer takes its own reference at launch, and cancelling the awaiting
# task cancels the token; the producer then completes the call with the
# cancelled code.
_cancel_token_create = _bind("kitchen_sink_cancel_token_create", ctypes.c_void_p)
_cancel_token_cancel = _bind("kitchen_sink_cancel_token_cancel", None, ctypes.c_void_p)
_cancel_token_destroy = _bind("kitchen_sink_cancel_token_destroy", None, ctypes.c_void_p)


async def _async_wait_cancellable(future: asyncio.Future[Any], token: int) -> Any:
    """Await a cancellable call. Cancelling the awaiting task cancels the
    native call and waits for its (cancelled) completion before raising, so
    nothing outlives the call."""
    try:
        return await asyncio.shield(future)
    except asyncio.CancelledError:
        _cancel_token_cancel(token)
        try:
            await future
        except BaseException:
            pass
        raise
    finally:
        _cancel_token_destroy(token)


# Callback-interface implementations the producer holds, keyed by the integer
# it receives as `ctx`. An entry is added when an implementation is passed to
# a call and removed when the producer calls the vtable's `free(ctx)`, so the
# implementation lives exactly as long as the producer may call it and the
# producer never holds a raw reference to a Python object. ctypes acquires
# the GIL on entry to a trampoline, so the producer may call (and free) from
# any thread.
_callbacks: dict[int, Any] = {}
_callbacks_lock = threading.Lock()
_callbacks_next = 0

_alloc = _bind("kitchen_sink_alloc", ctypes.c_void_p, ctypes.c_size_t)
_error_set = _bind(
    "kitchen_sink_error_set",
    None,
    ctypes.c_void_p,
    ctypes.c_int32,
    ctypes.c_char_p,
    ctypes.c_size_t,
)
_error_set_payload = _bind(
    "kitchen_sink_error_set_payload",
    None,
    ctypes.c_void_p,
    ctypes.c_char_p,
    ctypes.c_size_t,
)


def _callback_vtable(impl: Any, cls: type, vtable: Callable[[], int]) -> int:
    """Check an implementation passed to one call, and return its
    interface's vtable."""
    if not isinstance(impl, cls):
        raise TypeError(f"expected {cls.__name__}, got {type(impl).__name__}")
    return vtable()


def _callback_vtable_opt(impl: Any, cls: type, vtable: Callable[[], int]) -> int | None:
    """`_callback_vtable` for an optional callback: None passes a null
    vtable."""
    return None if impl is None else _callback_vtable(impl, cls, vtable)


def _callback_register(impl: Any) -> int:
    """Register a checked implementation for one call; returns its `ctx`
    key."""
    global _callbacks_next
    with _callbacks_lock:
        _callbacks_next += 1
        ctx = _callbacks_next
        _callbacks[ctx] = impl
    return ctx


def _callback_register_opt(impl: Any) -> int | None:
    """`_callback_register` for an optional callback: None registers
    nothing."""
    return None if impl is None else _callback_register(impl)


def _callback_get(ctx: int | None) -> Any:
    return _callbacks[ctx or 0]


def _callback_free(ctx: int | None) -> None:
    # The producer's last reference is gone; it never passes `ctx` again.
    with _callbacks_lock:
        _callbacks.pop(ctx or 0, None)


# Every vtable entry's function object, kept for the process lifetime.
_vtable_keep: list[Any] = []


def _vtable_entry(fn: Callable[..., Any], restype: Any, *argtypes: Any) -> int:
    """The address of a function the producer calls as one vtable entry
    (a method returning nothing, a scalar, or an object)."""
    entry = ctypes.CFUNCTYPE(restype, *argtypes)(fn)
    _vtable_keep.append(entry)
    return ctypes.cast(entry, ctypes.c_void_p).value or 0


# Every vtable's `free` entry.
_callback_free_ptr = _vtable_entry(_callback_free, None, ctypes.c_void_p)


class _LazyVtable:
    """A callback interface's one vtable, built the first time an
    implementation is passed and kept for the process lifetime."""

    def __init__(self, build: Callable[[], ctypes.Structure]) -> None:
        self._build = build
        self._vtable: ctypes.Structure | None = None
        self._lock = threading.Lock()

    def __call__(self) -> int:
        with self._lock:
            if self._vtable is None:
                self._vtable = self._build()
            return ctypes.addressof(self._vtable)


def _alloc_run(data: bytes) -> _Run:
    """Hand a string, bytes, or value-buffer return to the producer: a run
    allocated with kitchen_sink_alloc, which the producer adopts and frees."""
    n = len(data)
    if not n:
        return _Run()
    ptr = _alloc(n)
    if not ptr:
        raise MemoryError(f"kitchen_sink_alloc({n}) failed")
    ctypes.memmove(ptr, data, n)
    return _Run(ptr, n)


def _alloc_array(values: Iterable[Any], kind: str, what: str) -> _Run:
    """Hand a typed-array return to the producer: a range-checked run
    allocated with kitchen_sink_alloc, which the producer adopts and frees."""
    data = _array(values, kind, what)
    size = len(data) * data.itemsize
    if not size:
        return _Run()
    ptr = _alloc(size)
    if not ptr:
        raise MemoryError(f"kitchen_sink_alloc({size}) failed")
    ctypes.memmove(ptr, data.buffer_info()[0], size)
    return _Run(ptr, size)


def _callback_return_object(obj: Any, cls: type[_Object]) -> int:
    """Hand an object return to the producer: one fresh strong reference it
    adopts."""
    if not isinstance(obj, cls):
        raise TypeError(f"expected {cls.__name__}, got {type(obj).__name__}")
    return obj._clone_ref()


def _callback_return_object_opt(obj: Any, cls: type[_Object]) -> int | None:
    """`_callback_return_object` for an optional object: None returns null."""
    return None if obj is None else _callback_return_object(obj, cls)


# The codes a failed callback method reports when it raised anything but a
# code of its domain: -1 for a method that throws (a domain or `any`), -4
# for one that declares no errors.
_GENERIC = Error.GENERIC_ERROR_CODE
_FOREIGN = Error.FOREIGN_ERROR_CODE


def _callback_fail(
    out_err: int | None, exc: BaseException, code: int, domain: type[Error] | None = None
) -> None:
    """Report an implementation's exception to the producer. A method that
    throws an error domain passes it, and an exception of that domain
    carrying a positive code travels as that code with its fields as the
    payload; every other exception travels as `code` with its message.
    Nothing unwinds through C."""
    if domain is not None and isinstance(exc, domain) and exc.code > 0:
        code = exc.code
        payload = exc._payload()
        message = exc.message
    else:
        payload = b""
        if isinstance(exc, (Error, InternalError)):
            message = exc.message
        else:
            message = str(exc) or type(exc).__name__
    data = message.encode("utf-8", "replace")
    _error_set(out_err, code, data, len(data))
    if payload:
        _error_set_payload(out_err, payload, len(payload))


# Vtable entries of callback methods that return a structure (a
# kitchen_sink_run or an optional scalar) by value. A ctypes callback can't
# return a structure, so each such entry is a libffi closure, built through
# the libffi that ctypes itself runs on: libffi calls one ctypes callback with
# the return slot and the argument addresses, and it converts the arguments,
# calls the trampoline, and stores the structure the trampoline returns.


class _FfiType(ctypes.Structure):
    """libffi's `ffi_type`."""


_FfiType._fields_ = [
    ("size", ctypes.c_size_t),
    ("alignment", ctypes.c_ushort),
    ("type", ctypes.c_ushort),
    ("elements", ctypes.POINTER(ctypes.POINTER(_FfiType))),
]

# libffi's `FFI_TYPE_STRUCT`.
_FFI_TYPE_STRUCT = 13

# The libffi type of each ctypes scalar a vtable entry's slot can have (a
# C `bool` is one byte).
_FFI_SCALARS: dict[Any, str] = {
    ctypes.c_bool: "uint8",
    ctypes.c_int8: "sint8",
    ctypes.c_uint8: "uint8",
    ctypes.c_int16: "sint16",
    ctypes.c_uint16: "uint16",
    ctypes.c_int32: "sint32",
    ctypes.c_uint32: "uint32",
    ctypes.c_int64: "sint64",
    ctypes.c_uint64: "uint64",
    ctypes.c_float: "float",
    ctypes.c_double: "double",
    ctypes.c_void_p: "pointer",
}

# `void handler(ffi_cif* cif, void* ret, void** args, void* user_data)`.
_FfiHandler = ctypes.CFUNCTYPE(
    None, ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p), ctypes.c_void_p
)

_ffi_lock = threading.Lock()
_ffi_found: list[ctypes.CDLL] = []
_ffi_types: dict[Any, _FfiType] = {}
# Every closure's signature, handler, and type tables, kept for the process
# lifetime.
_ffi_keep: list[Any] = []


def _ffi_library() -> ctypes.CDLL:
    """The libffi ctypes runs on: found through the `_ctypes` extension, which
    links it, or by name."""
    if _ffi_found:
        return _ffi_found[0]
    import _ctypes
    import ctypes.util

    names = [
        getattr(_ctypes, "__file__", None),
        ctypes.util.find_library("ffi"),
        "libffi.so.8",
        "libffi.so.7",
        "libffi-8.dll",
        "libffi-7.dll",
    ]
    for name in names:
        if not name:
            continue
        try:
            lib = ctypes.CDLL(name)
        except OSError:
            continue
        if not hasattr(lib, "ffi_prep_closure_loc"):
            continue
        lib.ffi_prep_cif.restype = ctypes.c_int
        lib.ffi_prep_cif.argtypes = [
            ctypes.c_void_p,
            ctypes.c_int,
            ctypes.c_uint,
            ctypes.POINTER(_FfiType),
            ctypes.POINTER(ctypes.POINTER(_FfiType)),
        ]
        lib.ffi_closure_alloc.restype = ctypes.c_void_p
        lib.ffi_closure_alloc.argtypes = [ctypes.c_size_t, ctypes.POINTER(ctypes.c_void_p)]
        lib.ffi_prep_closure_loc.restype = ctypes.c_int
        lib.ffi_prep_closure_loc.argtypes = [
            ctypes.c_void_p,
            ctypes.c_void_p,
            _FfiHandler,
            ctypes.c_void_p,
            ctypes.c_void_p,
        ]
        _ffi_found.append(lib)
        return lib
    raise OSError(
        "cannot find libffi, which a callback method returning a string, bytes, "
        "a typed array, a value buffer, or an optional scalar needs"
    )


def _ffi_abi() -> int:
    """libffi's `FFI_DEFAULT_ABI` on the 64-bit platforms wheels target."""
    x86 = platform.machine().lower() in ("x86_64", "amd64")
    if os.name == "nt":
        return 1 if x86 else 2
    return 2 if x86 else 1


def _ffi_type(t: Any) -> _FfiType:
    """The libffi type of a ctypes scalar or structure."""
    found = _ffi_types.get(t)
    if found is None:
        if isinstance(t, type) and issubclass(t, ctypes.Structure):
            fields = [_ffi_type(field[1]) for field in t._fields_]
            elements = (ctypes.POINTER(_FfiType) * (len(fields) + 1))(
                *[ctypes.pointer(field) for field in fields]
            )
            # libffi computes the size and alignment.
            found = _FfiType(0, 0, _FFI_TYPE_STRUCT, elements)
            _ffi_keep.append(elements)
        else:
            found = _FfiType.in_dll(_ffi_library(), "ffi_type_" + _FFI_SCALARS[t])
        _ffi_types[t] = found
    return found


def _ffi_arg(t: Any, address: int) -> Any:
    """One argument as a ctypes callback would receive it: a scalar's value,
    or a copy of a structure."""
    if isinstance(t, type) and issubclass(t, ctypes.Structure):
        return t.from_buffer_copy(ctypes.string_at(address, ctypes.sizeof(t)))
    return t.from_address(address).value


def _vtable_struct_entry(fn: Callable[..., Any], restype: Any, *argtypes: Any) -> int:
    """The address of a function the producer calls as one vtable entry
    returning the structure `restype`."""
    with _ffi_lock:
        lib = _ffi_library()
        atypes = (ctypes.POINTER(_FfiType) * len(argtypes))(
            *[ctypes.pointer(_ffi_type(t)) for t in argtypes]
        )
        rtype = ctypes.pointer(_ffi_type(restype))
        # An `ffi_cif` and an `ffi_closure`, each with room to spare.
        cif = (ctypes.c_uint64 * 16)()
        if lib.ffi_prep_cif(cif, _ffi_abi(), len(argtypes), rtype, atypes) != 0:
            raise OSError("libffi rejected a callback method's signature")
        code = ctypes.c_void_p()
        closure = lib.ffi_closure_alloc(256, ctypes.byref(code))
        if not closure:
            raise MemoryError("ffi_closure_alloc failed")
        size = ctypes.sizeof(restype)

        def handler(cif: int | None, ret: Any, args: Any, data: int | None) -> None:
            values = [_ffi_arg(t, args[i]) for i, t in enumerate(argtypes)]
            result = fn(*values)
            ctypes.memmove(ret, ctypes.addressof(result), size)

        entry = _FfiHandler(handler)
        if lib.ffi_prep_closure_loc(closure, cif, entry, None, code) != 0:
            raise OSError("libffi couldn't prepare a callback method")
        _ffi_keep.extend([atypes, rtype, cif, entry])
        return code.value or 0


# === API ===


class KitchenError(Error):
    """Base exception of the `KitchenErrors` error domain.

    Each declared code raises its own subclass. A positive code these
    bindings don't know (from a newer library) raises this class itself,
    with `code` and `message` preserved.
    """

    NotFound: ClassVar[type[NotFoundError]]
    InvalidInput: ClassVar[type[InvalidInputError]]


class NotFoundError(KitchenError):
    """Item not found"""

    CODE = 1

    def __init__(self, message: str = "Item not found") -> None:
        super().__init__(1, message)


class InvalidInputError(KitchenError):
    """Invalid input"""

    CODE = 2

    def __init__(self, message: str = "Invalid input") -> None:
        super().__init__(2, message)


KitchenError.NotFound = NotFoundError
KitchenError.InvalidInput = InvalidInputError


def _kitchen_error_from(code: int, message: str, payload: bytes = b"") -> Error:
    """The exception for a failure of a call that throws KitchenError."""
    if code == 1:
        return NotFoundError(message)
    if code == 2:
        return InvalidInputError(message)
    return _unknown_code(KitchenError, code, message)


class PantryError(Error):
    """Base exception of the `PantryError` error domain.

    Each declared code raises its own subclass. A positive code these
    bindings don't know (from a newer library) raises this class itself,
    with `code` and `message` preserved.
    """

    OutOfStock: ClassVar[type[OutOfStockError]]
    Spoiled: ClassVar[type[SpoiledError]]


class OutOfStockError(PantryError):
    """Out of stock"""

    CODE = 1

    item: str

    def __init__(self, item: str, message: str = "Out of stock") -> None:
        super().__init__(1, message)
        self.item = item

    def _payload(self) -> bytes:
        _w = _Writer()
        _w.write_string(self.item)
        return _w.finish()


class SpoiledError(PantryError):
    """Spoiled"""

    CODE = 2

    def __init__(self, message: str = "Spoiled") -> None:
        super().__init__(2, message)


PantryError.OutOfStock = OutOfStockError
PantryError.Spoiled = SpoiledError


def _pantry_error_from(code: int, message: str, payload: bytes = b"") -> Error:
    """The exception for a failure of a call that throws PantryError."""
    if code == 1:
        return _decode(payload, lambda _r: OutOfStockError(
            item=_r.read_string(),
            message=message,
        ))
    if code == 2:
        return SpoiledError(message)
    return _unknown_code(PantryError, code, message)


class Priority(IntEnum):
    """Task priority levels"""

    # Low priority
    Low = 0
    # Normal priority
    Normal = 1
    # High priority
    High = 2


@dataclass(frozen=True, slots=True)
class Token:
    """A reusable token referenced from several declarations"""

    id: int
    label: str


def _write_Token(_w: _Writer, value: Token) -> None:
    _w.write_i64(value.id)
    _w.write_string(value.label)


def _read_Token(_r: _Reader) -> Token:
    return Token(
        id=_r.read_i64(),
        label=_r.read_string(),
    )


@dataclass(frozen=True, slots=True)
class Item:
    """Kitchen sink struct exercising every field feature"""

    # Stable identifier
    id: int
    # Display name
    name: str
    # Initial count
    count: int
    # Whether the item is enabled
    enabled: bool
    # Scaling ratio
    ratio: float
    nick: int
    payload: bytes
    tags: list[str]
    attrs: dict[str, str]
    parent: int | None
    # A record inside a record
    token: Token
    priority: Priority
    # An optional object inside a record
    gadget: Gadget | None


def _write_Item(_w: _Writer, value: Item) -> None:
    _w.write_i64(value.id)
    _w.write_string(value.name)
    _w.write_i32(value.count)
    _w.write_bool(value.enabled)
    _w.write_f64(value.ratio)
    _w.write_u32(value.nick)
    _w.write_bytes(value.payload)
    _write_list_string(_w, value.tags)
    _write_map_string_string(_w, value.attrs)
    _write_opt_i64(_w, value.parent)
    _write_Token(_w, value.token)
    _w.write_i32(value.priority)
    _write_opt_Gadget(_w, value.gadget)


def _read_Item(_r: _Reader) -> Item:
    return Item(
        id=_r.read_i64(),
        name=_r.read_string(),
        count=_r.read_i32(),
        enabled=_r.read_bool(),
        ratio=_r.read_f64(),
        nick=_r.read_u32(),
        payload=_r.read_bytes(),
        tags=_read_list_string(_r),
        attrs=_read_map_string_string(_r),
        parent=_read_opt_i64(_r),
        token=_read_Token(_r),
        priority=_r.read_enum(Priority),
        gadget=_read_opt_Gadget(_r),
    )


class ReadyListener(abc.ABC):
    """Consumer-implemented observer of ready items

    Subclass it and implement every method to pass an instance where the
    API takes a `ReadyListener`. The producer may call the methods from any
    thread until it releases the instance. An exception a method raises
    reaches the producer as a failure of that call (a method that throws
    an error domain reports that domain's codes with their fields).
    """

    @abc.abstractmethod
    def on_ready(self, code: int, msg: str) -> None:
        """Fires when an item is ready"""

    @abc.abstractmethod
    def on_item(self, item: Item, gadget: Gadget) -> bool:
        """Receives the item itself and says whether to keep listening"""

    @abc.abstractmethod
    def label(self) -> str:
        """A display label, failing with a kitchen error

        Raises
        ------
        KitchenError
            To report one of the domain's codes, with its fields, to the producer.
        """

    @abc.abstractmethod
    def latest(self) -> Item | None:
        """The most recent item the listener kept, if any"""

    @abc.abstractmethod
    def favorite(self) -> Gadget:
        """The listener's favorite gadget"""


def _ReadyListener_on_ready(ctx: int | None, code: int, msg: _Run, out_err: int | None) -> None:
    try:
        _callback_get(ctx).on_ready(code, _peek_str(msg))
    except BaseException as exc:
        _callback_fail(out_err, exc, _FOREIGN)


def _ReadyListener_on_item(ctx: int | None, item: _Run, gadget: int | None, out_err: int | None) -> bool:
    try:
        _gadget = Gadget._adopt(_required(gadget))
        _ret = _callback_get(ctx).on_item(_decode(_peek_bytes(item), _read_Item), _gadget)
        return bool(_ret)
    except BaseException as exc:
        _callback_fail(out_err, exc, _FOREIGN)
        return False


def _ReadyListener_label(ctx: int | None, out_err: int | None) -> _Run:
    try:
        _ret = _callback_get(ctx).label()
        return _alloc_run(_ret.encode("utf-8"))
    except BaseException as exc:
        _callback_fail(out_err, exc, _GENERIC, KitchenError)
        return _Run()


def _ReadyListener_latest(ctx: int | None, out_err: int | None) -> _Run:
    try:
        _ret = _callback_get(ctx).latest()
        _w = _Writer()
        _write_opt_Item(_w, _ret)
        return _alloc_run(_w.finish())
    except BaseException as exc:
        _callback_fail(out_err, exc, _FOREIGN)
        return _Run()


def _ReadyListener_favorite(ctx: int | None, out_err: int | None) -> int | None:
    try:
        _ret = _callback_get(ctx).favorite()
        return _callback_return_object(_ret, Gadget)
    except BaseException as exc:
        _callback_fail(out_err, exc, _FOREIGN)
        return None


class _ReadyListenerVtable(ctypes.Structure):
    """The C vtable `kitchen_sink_ReadyListener_vtable`."""

    _fields_ = [
        ("size", ctypes.c_uint32),
        ("flags", ctypes.c_uint32),
        ("free", ctypes.c_void_p),
        ("on_ready", ctypes.c_void_p),
        ("on_item", ctypes.c_void_p),
        ("label", ctypes.c_void_p),
        ("latest", ctypes.c_void_p),
        ("favorite", ctypes.c_void_p),
    ]


class _ReadyListenerArg(ctypes.Structure):
    """The C `kitchen_sink_ReadyListener` argument: a context and a vtable."""

    _fields_ = [("ctx", ctypes.c_void_p), ("vtable", ctypes.c_void_p)]


def _ReadyListenerVtableBuild() -> _ReadyListenerVtable:
    return _ReadyListenerVtable(
        ctypes.sizeof(_ReadyListenerVtable),
        0,  # flags: callable from any thread
        _callback_free_ptr,
        _vtable_entry(_ReadyListener_on_ready, None, ctypes.c_void_p, ctypes.c_int32, _Run, ctypes.c_void_p),
        _vtable_entry(_ReadyListener_on_item, ctypes.c_bool, ctypes.c_void_p, _Run, ctypes.c_void_p, ctypes.c_void_p),
        _vtable_struct_entry(_ReadyListener_label, _Run, ctypes.c_void_p, ctypes.c_void_p),
        _vtable_struct_entry(_ReadyListener_latest, _Run, ctypes.c_void_p, ctypes.c_void_p),
        _vtable_entry(_ReadyListener_favorite, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p),
    )


_ReadyListenerVtableOnce = _LazyVtable(_ReadyListenerVtableBuild)


class Sampler(abc.ABC):
    """Consumer-implemented source of scalar samples

    Subclass it and implement every method to pass an instance where the
    API takes a `Sampler`. The producer may call the methods from any
    thread until it releases the instance. An exception a method raises
    reaches the producer as a failure of that call (a method that throws
    an error domain reports that domain's codes with their fields).
    """

    @abc.abstractmethod
    def threshold(self, level: int | None) -> float | None:
        """The cutoff for a level, if the sampler has one"""

    @abc.abstractmethod
    def samples(self, limit: int | None, weights: list[float]) -> Sequence[int]:
        """Up to `limit` samples, failing when the pantry is empty

        Raises
        ------
        PantryError
            To report one of the domain's codes, with its fields, to the producer.
        """

    @abc.abstractmethod
    def describe(self) -> str:
        """A free-form description, failing with an untyped error"""


def _Sampler_threshold(ctx: int | None, level: _OptU32, out_err: int | None) -> _OptF64:
    try:
        _ret = _callback_get(ctx).threshold(_opt_int(level))
        return _OptF64(True, _float(_ret, "Sampler.threshold() result")) if _ret is not None else _OptF64()
    except BaseException as exc:
        _callback_fail(out_err, exc, _FOREIGN)
        return _OptF64()


def _Sampler_samples(ctx: int | None, limit: _OptU32, weights: _Run, out_err: int | None) -> _Run:
    try:
        _ret = _callback_get(ctx).samples(_opt_int(limit), _peek_array(weights, "f64"))
        return _alloc_array(_ret, "i16", "Sampler.samples() result")
    except BaseException as exc:
        _callback_fail(out_err, exc, _GENERIC, PantryError)
        return _Run()


def _Sampler_describe(ctx: int | None, out_err: int | None) -> _Run:
    try:
        _ret = _callback_get(ctx).describe()
        return _alloc_run(_ret.encode("utf-8"))
    except BaseException as exc:
        _callback_fail(out_err, exc, _GENERIC)
        return _Run()


class _SamplerVtable(ctypes.Structure):
    """The C vtable `kitchen_sink_Sampler_vtable`."""

    _fields_ = [
        ("size", ctypes.c_uint32),
        ("flags", ctypes.c_uint32),
        ("free", ctypes.c_void_p),
        ("threshold", ctypes.c_void_p),
        ("samples", ctypes.c_void_p),
        ("describe", ctypes.c_void_p),
    ]


class _SamplerArg(ctypes.Structure):
    """The C `kitchen_sink_Sampler` argument: a context and a vtable."""

    _fields_ = [("ctx", ctypes.c_void_p), ("vtable", ctypes.c_void_p)]


def _SamplerVtableBuild() -> _SamplerVtable:
    return _SamplerVtable(
        ctypes.sizeof(_SamplerVtable),
        0,  # flags: callable from any thread
        _callback_free_ptr,
        _vtable_struct_entry(_Sampler_threshold, _OptF64, ctypes.c_void_p, _OptU32, ctypes.c_void_p),
        _vtable_struct_entry(_Sampler_samples, _Run, ctypes.c_void_p, _OptU32, _Run, ctypes.c_void_p),
        _vtable_struct_entry(_Sampler_describe, _Run, ctypes.c_void_p, ctypes.c_void_p),
    )


_SamplerVtableOnce = _LazyVtable(_SamplerVtableBuild)


_c_Gadget_new = _bind("kitchen_sink_Gadget_new", ctypes.c_void_p, ctypes.c_int64, ctypes.POINTER(_ErrorStruct))
_c_Gadget_describe = _bind("kitchen_sink_Gadget_describe", _Run, ctypes.c_void_p, ctypes.POINTER(_ErrorStruct))
_c_Gadget_poke = _bind("kitchen_sink_Gadget_poke", ctypes.c_int32, ctypes.c_void_p, ctypes.c_int32, ctypes.POINTER(_ErrorStruct))
_c_Gadget_readings = _bind("kitchen_sink_Gadget_readings", _Run, ctypes.c_void_p, _OptU32, ctypes.POINTER(_ErrorStruct))
_c_Gadget_version = _bind("kitchen_sink_Gadget_version", _Run, ctypes.POINTER(_ErrorStruct))
_c_Gadget_clone = _bind("kitchen_sink_Gadget_clone", ctypes.c_void_p, ctypes.c_void_p)
_c_Gadget_destroy = _bind("kitchen_sink_Gadget_destroy", None, ctypes.c_void_p)


class Gadget(_Object):
    """A pocket-sized interface exercising the object surface"""

    _destroy = staticmethod(_c_Gadget_destroy)
    _clone = staticmethod(_c_Gadget_clone)

    def __init__(self, id: int) -> None:
        """Create a gadget with the given id"""
        _err = _ErrorStruct()
        _ret = _c_Gadget_new(_i64(id, "id"), ctypes.byref(_err))
        if _err.code:
            raise _trap_from(*_read_error(_err))
        self._init_handle(_required(_ret))

    def describe(self) -> str:
        """Render the gadget as a human-readable string"""
        _err = _ErrorStruct()
        _self_p = self._acquire()
        try:
            _ret = _c_Gadget_describe(_self_p, ctypes.byref(_err))
        finally:
            self._release()
        if _err.code:
            raise _trap_from(*_read_error(_err))
        return _take_str(_ret)

    def poke(self, times: int) -> int:
        """Poke the gadget a number of times, failing on a negative count

        Raises
        ------
        KitchenError
            If the call fails with one of the domain's codes.
        """
        _times_v = _i32(times, "times")
        _err = _ErrorStruct()
        _self_p = self._acquire()
        try:
            _ret: int = _c_Gadget_poke(_self_p, _times_v, ctypes.byref(_err))
        finally:
            self._release()
        if _err.code:
            raise _kitchen_error_from(*_read_error(_err))
        return _ret

    def readings(self, limit: int | None) -> list[float]:
        """The gadget's sensor readings, optionally limited

        Raises
        ------
        Error
            If the call fails.
        """
        _limit_v = _OptU32(True, _u32(limit, "limit")) if limit is not None else _OptU32()
        _err = _ErrorStruct()
        _self_p = self._acquire()
        try:
            _ret = _c_Gadget_readings(_self_p, _limit_v, ctypes.byref(_err))
        finally:
            self._release()
        if _err.code:
            raise _error_from(*_read_error(_err))
        return _take_array(_ret, "f64")

    @staticmethod
    def version() -> str:
        """The gadget subsystem version string"""
        _err = _ErrorStruct()
        _ret = _c_Gadget_version(ctypes.byref(_err))
        if _err.code:
            raise _trap_from(*_read_error(_err))
        return _take_str(_ret)


_c_ping = _bind("kitchen_sink_ping", _Run, ctypes.POINTER(_ErrorStruct))


def ping() -> str:
    """A trivial helper"""
    _err = _ErrorStruct()
    _ret = _c_ping(ctypes.byref(_err))
    if _err.code:
        raise _trap_from(*_read_error(_err))
    return _take_str(_ret)


_c_bool_id = _bind("kitchen_sink_bool_id", ctypes.c_bool, ctypes.c_bool, ctypes.POINTER(_ErrorStruct))


def bool_id(x: bool) -> bool:
