def _load_library() -> ctypes.CDLL:
    # An explicit path wins; then a library bundled inside this package (a
    # platform wheel); then the system loader's search path.
    override = os.environ.get("KITCHEN_SINK_LIBRARY")
    if override:
        return _open(override, f"the kitchen_sink native library from KITCHEN_SINK_LIBRARY={override!r}")
    system = platform.system()
    if system == "Darwin":
        name = "libkitchen_sink.dylib"
    elif system == "Windows":
        name = "kitchen_sink.dll"
    else:
        name = "libkitchen_sink.so"
    bundled = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    if os.path.exists(bundled):
        return _open(bundled, f"the bundled kitchen_sink native library {bundled!r}")
    return _open(
        name,
        f"the kitchen_sink native library {name!r} (set KITCHEN_SINK_LIBRARY to its path, "
        "or install a wheel that bundles it)",
    )


