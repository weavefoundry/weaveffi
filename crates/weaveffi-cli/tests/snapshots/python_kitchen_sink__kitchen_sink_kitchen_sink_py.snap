    return _ret


_c_i32_id = _bind("kitchen_sink_i32_id", ctypes.c_int32, ctypes.c_int32, ctypes.POINTER(_ErrorStruct))


def i32_id(x: int) -> int:
    _err = _ErrorStruct()
