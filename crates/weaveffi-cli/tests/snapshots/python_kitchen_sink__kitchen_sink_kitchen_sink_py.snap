    return _ret


_c_u32_id = _bind("kitchen_sink_u32_id", ctypes.c_uint32, ctypes.c_uint32, ctypes.POINTER(_ErrorStruct))


def u32_id(x: int) -> int:
    _err = _ErrorStruct()
