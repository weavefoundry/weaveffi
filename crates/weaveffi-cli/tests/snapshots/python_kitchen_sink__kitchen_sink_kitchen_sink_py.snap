# === Value-buffer codecs of composite types ===


def _write_list_string(_w: _Writer, value: List[str]) -> None:
    _w.write_count(len(value))
    for item in value:
        _w.write_string(item)


def _read_list_string(_r: _Reader) -> List[str]:
    return [_r.read_string() for _ in range(_r.read_count())]


def _write_map_string_string(_w: _Writer, value: Dict[str, str]) -> None:
    _w.write_count(len(value))
    for key, item in value.items():
        _w.write_string(key)
        _w.write_string(item)


def _read_map_string_string(_r: _Reader) -> Dict[str, str]:
    n = _r.read_count()
    value = {_r.read_string(): _r.read_string() for _ in range(n)}
    if len(value) != n:
        raise _malformed("repeated map key")
    return value


def _write_opt_i64(_w: _Writer, value: Optional[int]) -> None:
    _w.write_flag(value is not None)
    if value is not None:
        _w.write_i64(value)


def _read_opt_i64(_r: _Reader) -> Optional[int]:
    return _r.read_i64() if _r.read_flag() else None


def _write_opt_Gadget(_w: _Writer, value: Optional[Gadget]) -> None:
    _w.write_flag(value is not None)
    if value is not None:
        _w.write_object(value, Gadget)


def _read_opt_Gadget(_r: _Reader) -> Optional[Gadget]:
    return Gadget._adopt(_r.read_object()) if _r.read_flag() else None


def _write_list_Gadget(_w: _Writer, value: List[Gadget]) -> None:
    _w.write_count(len(value))
    for item in value:
        _w.write_object(item, Gadget)


def _read_list_Gadget(_r: _Reader) -> List[Gadget]:
    return [Gadget._adopt(_r.read_object()) for _ in range(_r.read_count())]


def _write_opt_Item(_w: _Writer, value: Optional[Item]) -> None:
    _w.write_flag(value is not None)
    if value is not None:
        _write_Item(_w, value)


def _read_opt_Item(_r: _Reader) -> Optional[Item]:
    return _read_Item(_r) if _r.read_flag() else None


def _write_list_Item(_w: _Writer, value: List[Item]) -> None:
    _w.write_count(len(value))
    for item in value:
        _write_Item(_w, item)


def _read_list_Item(_r: _Reader) -> List[Item]:
    return [_read_Item(_r) for _ in range(_r.read_count())]


def _write_map_string_i32(_w: _Writer, value: Dict[str, int]) -> None:
    _w.write_count(len(value))
    for key, item in value.items():
        _w.write_string(key)
        _w.write_i32(item)


def _read_map_string_i32(_r: _Reader) -> Dict[str, int]:
    n = _r.read_count()
    value = {_r.read_string(): _r.read_i32() for _ in range(n)}
    if len(value) != n:
        raise _malformed("repeated map key")
    return value


