    return _take_str(_ret, _out_len.value)


# === Module: kitchen ===


class KitchenErrorsError(Error):
    """Base exception for the `kitchen` module's error domain."""

    NotFound: Type[NotFound]
    InvalidInput: Type[InvalidInput]


class NotFound(KitchenErrorsError):
    """Item not found"""

    CODE = 1

    def __init__(self, message: str = "Item not found") -> None:
        super().__init__(1, message)


class InvalidInput(KitchenErrorsError):
    """Invalid input"""

    CODE = 2

    def __init__(self, message: str = "Invalid input") -> None:
        super().__init__(2, message)


KitchenErrorsError.NotFound = NotFound
KitchenErrorsError.InvalidInput = InvalidInput


def _kitchen_errors_error_from(code: int, message: str, payload: bytes = b"") -> Error:
    """The KitchenErrorsError subclass for `code` with its payload fields, or the
    plain Error for a runtime code (a panic, a marshalling failure).
    """
    if code == 1:
        return NotFound(message)
    if code == 2:
        return InvalidInput(message)
    return Error(code, message)


class Priority(IntEnum):
    """Task priority levels"""

    # Low priority
    Low = 0
    # Normal priority
    Normal = 1
    # High priority
    High = 2


@dataclass
class Item:
    """Kitchen sink struct exercising every field feature"""

    # Stable identifier
    id: int
    # Display name
    name: str
    # Initial count
    count: int
    # Whether the item is enabled
    enabled: bool
    # Scaling ratio
    ratio: float
    nick: int
    payload: bytes
    tags: List[str]
    attrs: Dict[str, str]
    parent: Optional[int]
    # Cross-module struct reference
    token: Token
    priority: Priority
    # An optional object inside a record
    gadget: Optional[Gadget]


def _write_Item(_w: _Writer, value: Item) -> None:
    _w.write_i64(value.id)
    _w.write_string(value.name)
    _w.write_i32(value.count)
    _w.write_bool(value.enabled)
    _w.write_f64(value.ratio)
    _w.write_u32(value.nick)
    _w.write_bytes(value.payload)
    _write_list_string(_w, value.tags)
    _write_map_string_string(_w, value.attrs)
    _write_opt_i64(_w, value.parent)
    _write_Token(_w, value.token)
    _w.write_i32(value.priority)
    _write_opt_Gadget(_w, value.gadget)


def _read_Item(_r: _Reader) -> Item:
    return Item(
        id=_r.read_i64(),
        name=_r.read_string(),
        count=_r.read_i32(),
        enabled=_r.read_bool(),
        ratio=_r.read_f64(),
        nick=_r.read_u32(),
        payload=_r.read_bytes(),
        tags=_read_list_string(_r),
        attrs=_read_map_string_string(_r),
        parent=_read_opt_i64(_r),
        token=_read_Token(_r),
        priority=_r.read_enum(Priority),
        gadget=_read_opt_Gadget(_r),
    )


class ReadyListener(abc.ABC):
    """Consumer-implemented observer of ready items

    Subclass it and implement every method to pass an instance where the
    API takes a `ReadyListener`. The producer may call the methods from any
    thread until it releases the instance. A method that declares errors may
    raise a `KitchenErrorsError` code, which reaches the producer with its fields;
    any other exception reaches it as Error.FOREIGN_ERROR_CODE (-4).
    """

    @abc.abstractmethod
    def on_ready(self, code: int, msg: str) -> None:
        """Fires when an item is ready"""

    @abc.abstractmethod
    def on_item(self, item: Item, gadget: Gadget) -> bool:
        """Receives the item itself and says whether to keep listening"""

    @abc.abstractmethod
    def label(self) -> str:
        """A display label, failing with a kitchen error

        Raises
        ------
        KitchenErrorsError
            To report one of the domain's error codes to the producer.
        """

    @abc.abstractmethod
    def latest(self) -> Optional[Item]:
        """The most recent item the listener kept, if any"""

    @abc.abstractmethod
    def favorite(self) -> Gadget:
        """The listener's favorite gadget"""


_ReadyListener_on_ready_t = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_int32, ctypes.c_void_p, ctypes.c_size_t, ctypes.POINTER(_ErrorStruct))
_ReadyListener_on_item_t = ctypes.CFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.POINTER(_ErrorStruct))
_ReadyListener_label_t = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(_ErrorStruct))
_ReadyListener_latest_t = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(_ErrorStruct))
_ReadyListener_favorite_t = ctypes.CFUNCTYPE(ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(_ErrorStruct))


class _ReadyListenerVtable(ctypes.Structure):
    """The C vtable `kitchen_sink_kitchen_ReadyListener_vtable`."""

    _fields_ = [
        ("size", ctypes.c_uint32),
        ("flags", ctypes.c_uint32),
        ("free", _CallbackFree),
        ("on_ready", _ReadyListener_on_ready_t),
        ("on_item", _ReadyListener_on_item_t),
        ("label", _ReadyListener_label_t),
        ("latest", _ReadyListener_latest_t),
        ("favorite", _ReadyListener_favorite_t),
    ]


def _ReadyListener_on_ready(ctx: Optional[int], code: int, msg_ptr: Optional[int], msg_len: int, out_err: Any) -> None:
    try:
        _callback_get(ctx).on_ready(code, _peek_bytes(msg_ptr, msg_len).decode("utf-8"))
    except BaseException as exc:
        _callback_fail(out_err, exc)


def _ReadyListener_on_item(ctx: Optional[int], item_ptr: Optional[int], item_len: int, gadget: Optional[int], out_err: Any) -> bool:
    try:
        _gadget = Gadget._adopt(_required(gadget))
        return bool(_callback_get(ctx).on_item(_decode(_peek_bytes(item_ptr, item_len), _read_Item), _gadget))
    except BaseException as exc:
        _callback_fail(out_err, exc)
        return False


def _ReadyListener_label(ctx: Optional[int], out_ptr: Any, out_len: Any, out_err: Any) -> None:
    try:
        _ret = _callback_get(ctx).label()
        _callback_return_bytes(out_ptr, out_len, _ret.encode("utf-8"))
    except BaseException as exc:
        _callback_fail(out_err, exc, KitchenErrorsError)


def _ReadyListener_latest(ctx: Optional[int], out_ptr: Any, out_len: Any, out_err: Any) -> None:
    try:
        _ret = _callback_get(ctx).latest()
        _w = _Writer()
        _write_opt_Item(_w, _ret)
        _callback_return_bytes(out_ptr, out_len, _w.finish())
    except BaseException as exc:
        _callback_fail(out_err, exc)


def _ReadyListener_favorite(ctx: Optional[int], out_err: Any) -> Optional[int]:
    try:
        _ret = _callback_get(ctx).favorite()
        return _callback_return_object(_ret, Gadget)
    except BaseException as exc:
        _callback_fail(out_err, exc)
        return None


