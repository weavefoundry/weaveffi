def _ReadyListener_on_item(ctx: int | None, item_ptr: int | None, item_len: int, gadget: int | None, out_err: Any) -> bool:
    try:
        _gadget = Gadget._adopt(_required(gadget))
        return bool(_callback_get(ctx).on_item(_decode(_peek_bytes(item_ptr, item_len), _read_Item), _gadget))
    except BaseException as exc:
        _callback_fail(out_err, exc, _FOREIGN)
        return False


