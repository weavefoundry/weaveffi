  final _anchor = _IteratorAnchor();
  _kitchenSinkKitchenStreamChunksIteratorDestroyFinalizer.attach(_anchor, _iter, detach: _anchor);
  try {
    while (true) {
      final _step = _Frame.take();
      final List<int> _item;
      try {
        final _more = _kitchenSinkKitchenStreamChunksIteratorNext(_iter, _step.slot0.cast(), _step.slot1.cast(), _step.err);
        _step.check();
        if (_more == 0) break;
