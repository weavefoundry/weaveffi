# Generated by WeaveFFI [VERSION] from api.yml
# DO NOT EDIT. Your changes will be overwritten.
# To regenerate: weaveffi generate api.yml -o <out>

cmake_minimum_required(VERSION 3.18)
project(shapes_jni C)

# The directory holding the producer library (libshapes). Android builds
# default to the per-ABI copy under src/main/jniLibs/.
set(SHAPES_LIBRARY_DIR "" CACHE PATH "Directory holding the shapes producer library")
if(NOT SHAPES_LIBRARY_DIR AND ANDROID)
    set(SHAPES_LIBRARY_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../jniLibs/${ANDROID_ABI}")
endif()
if(SHAPES_LIBRARY_DIR)
    find_library(SHAPES_PRODUCER NAMES shapes PATHS "${SHAPES_LIBRARY_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
else()
    set(CMAKE_FIND_FRAMEWORK NEVER)
    find_library(SHAPES_PRODUCER NAMES shapes REQUIRED)
endif()

add_library(shapes_jni SHARED shapes_jni.c)
target_include_directories(shapes_jni PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(shapes_jni PRIVATE "${SHAPES_PRODUCER}")
if(NOT ANDROID)
    find_package(JNI REQUIRED)
    find_package(Threads REQUIRED)
    target_include_directories(shapes_jni PRIVATE ${JNI_INCLUDE_DIRS})
    target_link_libraries(shapes_jni PRIVATE Threads::Threads)
endif()

# END CMakeLists.txt
