extern "C" {

typedef uint64_t weaveffi_handle_t;

/* Error slot written by every fallible call. `payload_ptr`/`payload_len`
   hold the matched error code's fields serialized in the WeaveFFI value
   buffer format (null when the code declares no fields); both the message
   and the payload are released by weaveffi_error_clear. */
typedef struct weaveffi_error {
    int32_t code;
    const char* message;
    const uint8_t* payload_ptr;
    size_t payload_len;
} weaveffi_error;

WEAVEFFI_API void weaveffi_error_clear(weaveffi_error* err);

/* Async completion callbacks receive a heap-boxed error the consumer
   owns; weaveffi_error_free releases the message, the payload, and the
   box itself. Passing NULL is a safe no-op. */
WEAVEFFI_API void weaveffi_error_free(weaveffi_error* err);
WEAVEFFI_API void weaveffi_free_string(const char* ptr);
WEAVEFFI_API void weaveffi_free_bytes(uint8_t* ptr, size_t len);

/* Linear-memory allocator used by the Wasm JS glue to stage call
   arguments. Native consumers never call these; producers targeting
   WebAssembly must export them (the generated weaveffi.c provides
   malloc/free-backed defaults). */
WEAVEFFI_API uint8_t* weaveffi_alloc(uint32_t size);
WEAVEFFI_API void weaveffi_dealloc(uint8_t* ptr, uint32_t size);

typedef struct weaveffi_cancel_token weaveffi_cancel_token;
WEAVEFFI_API weaveffi_cancel_token* weaveffi_cancel_token_create(void);
WEAVEFFI_API void weaveffi_cancel_token_cancel(weaveffi_cancel_token* token);
WEAVEFFI_API bool weaveffi_cancel_token_is_cancelled(const weaveffi_cancel_token* token);
WEAVEFFI_API void weaveffi_cancel_token_destroy(weaveffi_cancel_token* token);

/** Error codes reported by throwing functions in the `tasks` module tree. */
typedef enum { weaveffi_tasks_TaskError_InvalidName = 1 } weaveffi_tasks_TaskError;
typedef void (*weaveffi_tasks_run_task_callback)(void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len);
typedef void (*weaveffi_tasks_run_batch_callback)(void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len);
typedef void (*weaveffi_tasks_run_n_tasks_callback)(void* context, weaveffi_error* err, int32_t result);

WEAVEFFI_API void weaveffi_tasks_run_task_async(const char* name, weaveffi_tasks_run_task_callback callback, void* context);
WEAVEFFI_API void weaveffi_tasks_run_batch_async(const uint8_t* names_ptr, size_t names_len, weaveffi_tasks_run_batch_callback callback, void* context);
WEAVEFFI_API bool weaveffi_tasks_cancel_task(int64_t id, weaveffi_error* out_err);
WEAVEFFI_API void weaveffi_tasks_run_n_tasks_async(int32_t n, weaveffi_tasks_run_n_tasks_callback callback, void* context);
WEAVEFFI_API int64_t weaveffi_tasks_active_callbacks(weaveffi_error* out_err);

} // extern "C"

namespace weaveffi {

/** Base exception for every error reported through the C ABI. */
class WeaveFFIError : public std::runtime_error {
    int32_t code_;

public:
    WeaveFFIError(int32_t code, const std::string& msg) : std::runtime_error(msg), code_(code) {}
    int32_t code() const { return code_; }
};

namespace detail {

/** Throw the generic WeaveFFIError if `err` carries a nonzero code. */
inline void check(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    int32_t code = err.code;
    weaveffi_error_clear(&err);
    throw WeaveFFIError(code, msg);
}

/** Wrap an async-callback error as the generic WeaveFFIError. */
inline std::exception_ptr make_error(int32_t code, const std::string& msg) {
    return std::make_exception_ptr(WeaveFFIError(code, msg));
}

} // namespace detail

namespace detail {

/**
 * Serializes values into the WeaveFFI value-buffer wire format: little-endian,
 * packed with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a string, byte-buffer, or collection length as a u32. */
    void write_len(size_t n) { append_le(static_cast<uint32_t>(n)); }

    void write_string(const std::string& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }
};

/**
 * Decodes values from the WeaveFFI value-buffer wire format. A malformed
 * buffer is a producer/consumer contract violation (both sides are generated
 * from one IDL), so every decode failure throws the generic WeaveFFIError,
 * the same channel as a producer panic.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    [[noreturn]] static void fail(const char* what) {
        throw WeaveFFIError(-2, std::string("malformed WeaveFFI value buffer: ") + what);
    }

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    BufferReader(const uint8_t* data, size_t len) : data_(data), len_(len), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a length prefix, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with weaveffi_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    ~BufferGuard() {
        if (ptr != nullptr) weaveffi_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

} // namespace detail

struct TaskResult {
    int64_t id;
    std::string value;
    bool success;
};

namespace detail {

/** Encodes a `TaskResult` in the WeaveFFI value-buffer format. */
inline void write_TaskResult(BufferWriter& w, const TaskResult& v) {
    w.write_i64(v.id);
    w.write_string(v.value);
    w.write_bool(v.success);
}

/** Decodes a `TaskResult` from the WeaveFFI value-buffer format. */
inline TaskResult read_TaskResult(BufferReader& r) {
    TaskResult out{};
    out.id = r.read_i64();
    out.value = r.read_string();
    out.success = r.read_bool();
    return out;
}

} // namespace detail

/** Typed errors reported by the `tasks` module's throwing functions. */
class TaskError : public WeaveFFIError {
public:
    TaskError(int32_t code, const std::string& msg) : WeaveFFIError(code, msg) {}
};

/** task name must not be empty */
class InvalidNameError : public TaskError {
public:
    InvalidNameError(const std::string& msg) : TaskError(1, msg) {}
};

namespace detail {

/** Map a `tasks` error code and payload to its typed exception (WeaveFFIError for runtime codes, TaskError for unknown codes). */
inline std::exception_ptr make_tasks_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    if (code < 0) return std::make_exception_ptr(WeaveFFIError(code, msg));
    switch (code) {
    case 1: return std::make_exception_ptr(InvalidNameError(msg));
    default: return std::make_exception_ptr(TaskError(code, msg));
    }
}

/** Throw the typed `tasks` exception if `err` carries a nonzero code. */
inline void check_tasks(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    std::exception_ptr ex = make_tasks_error(err.code, msg, err.payload_ptr, err.payload_len);
    weaveffi_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

namespace tasks {

inline std::future<TaskResult> run_task(const std::string& name) {
    auto* promise_ptr = new std::promise<TaskResult>();
    auto future = promise_ptr->get_future();
    weaveffi_tasks_run_task_async(name.c_str(), [](void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len) {
        auto* p = static_cast<std::promise<TaskResult>*>(context);
        if (err && err->code != 0) {
            std::string msg(err->message ? err->message : "unknown error");
            p->set_exception(detail::make_tasks_error(err->code, msg, err->payload_ptr, err->payload_len));
            weaveffi_error_free(err);
        } else {
            detail::BufferReader result_r(result_ptr, result_len);
            TaskResult value = detail::read_TaskResult(result_r);
            result_r.expect_end();
            weaveffi_free_bytes(const_cast<uint8_t*>(result_ptr), result_len);
            p->set_value(std::move(value));
        }
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline std::future<std::vector<TaskResult>> run_batch(const std::vector<std::string>& names) {
    auto* promise_ptr = new std::promise<std::vector<TaskResult>>();
    auto future = promise_ptr->get_future();
    detail::BufferWriter names_buf;
    names_buf.write_len(names.size());
    for (const auto& item0 : names) {
        names_buf.write_string(item0);
    }
    weaveffi_tasks_run_batch_async(names_buf.data(), names_buf.size(), [](void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len) {
        auto* p = static_cast<std::promise<std::vector<TaskResult>>*>(context);
        if (err && err->code != 0) {
            std::string msg(err->message ? err->message : "unknown error");
            p->set_exception(detail::make_error(err->code, msg));
            weaveffi_error_free(err);
        } else {
            detail::BufferReader result_r(result_ptr, result_len);
            std::vector<TaskResult> value{};
            {
                size_t value_n = result_r.read_len();
                value.reserve(value_n);
                for (size_t value_i = 0; value_i < value_n; ++value_i) {
                    TaskResult value_item = detail::read_TaskResult(result_r);
                    value.push_back(std::move(value_item));
                }
            }
            result_r.expect_end();
            weaveffi_free_bytes(const_cast<uint8_t*>(result_ptr), result_len);
            p->set_value(std::move(value));
        }
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline bool cancel_task(int64_t id) {
    weaveffi_error err{};
    auto result = weaveffi_tasks_cancel_task(id, &err);
    detail::check(err);
    return result;
}

inline std::future<int32_t> run_n_tasks(int32_t n) {
    auto* promise_ptr = new std::promise<int32_t>();
    auto future = promise_ptr->get_future();
    weaveffi_tasks_run_n_tasks_async(n, [](void* context, weaveffi_error* err, int32_t result) {
        auto* p = static_cast<std::promise<int32_t>*>(context);
        if (err && err->code != 0) {
            std::string msg(err->message ? err->message : "unknown error");
            p->set_exception(detail::make_error(err->code, msg));
            weaveffi_error_free(err);
        } else {
            p->set_value(result);
        }
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline int64_t active_callbacks() {
    weaveffi_error err{};
    auto result = weaveffi_tasks_active_callbacks(&err);
    detail::check(err);
    return result;
}

} // namespace tasks

} // namespace weaveffi

// END weaveffi.hpp
