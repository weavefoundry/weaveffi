// Generated by WeaveFFI [VERSION]
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate

package shapes

/** An algebraic shape (sum type with associated data) */
sealed class Shape {
    /** The empty shape (a unit variant) */
    object Empty : Shape()
    /** A circle with a radius */
    data class Circle(
        /** Radius in points */
        val radius: Double,
    ) : Shape()
    /** An axis-aligned rectangle */
    data class Rectangle(val width: Float, val height: Float) : Shape()
    /** An integer-bounded shape (exercises narrow + wide ints) */
    data class Bounded(val min: Short, val max: Short, val weight: ULong) : Shape()
    /** A labeled shape with a small count */
    data class Labeled(val label: String, val count: UByte) : Shape()
}

internal fun packShape(_w: BufferWriter, _v: Shape) {
    when (_v) {
        is Shape.Empty -> _w.writeI32(0)
        is Shape.Circle -> {
            _w.writeI32(1)
            _w.writeF64(_v.radius)
        }
        is Shape.Rectangle -> {
            _w.writeI32(2)
            _w.writeF32(_v.width)
            _w.writeF32(_v.height)
        }
        is Shape.Bounded -> {
            _w.writeI32(3)
            _w.writeI16(_v.min)
            _w.writeI16(_v.max)
            _w.writeU64(_v.weight)
        }
        is Shape.Labeled -> {
            _w.writeI32(4)
            _w.writeString(_v.label)
            _w.writeU8(_v.count)
        }
    }
}

internal fun unpackShape(_r: BufferReader): Shape = when (val _tag = _r.readI32()) {
    0 -> Shape.Empty
    1 -> Shape.Circle(_r.readF64())
    2 -> Shape.Rectangle(_r.readF32(), _r.readF32())
    3 -> Shape.Bounded(_r.readI16(), _r.readI16(), _r.readU64())
    4 -> Shape.Labeled(_r.readString(), _r.readU8())
    else -> throw NativeBugException(-3, "malformed value buffer: unknown Shape tag $_tag")
}

/** A plain C-style enum (no payloads) */
enum class Channel(val value: Int) {
    Red(0),
    Green(1),
    Blue(2);

    companion object {
        /** The variant whose ABI value is [value]. */
        fun fromValue(value: Int): Channel = entries.firstOrNull { it.value == value }
            ?: throw NativeBugException(-3, "unknown Channel value $value")
    }
}

/** One field per supported numeric primitive */
data class Numerics(val a: Byte, val b: Short, val c: Int, val d: Long, val e: UByte, val f: UShort, val g: UInt, val h: ULong, val i: Float, val j: Double)

internal fun packNumerics(_w: BufferWriter, _v: Numerics) {
    _w.writeI8(_v.a)
    _w.writeI16(_v.b)
    _w.writeI32(_v.c)
    _w.writeI64(_v.d)
    _w.writeU8(_v.e)
    _w.writeU16(_v.f)
    _w.writeU32(_v.g)
    _w.writeU64(_v.h)
    _w.writeF32(_v.i)
    _w.writeF64(_v.j)
}

internal fun unpackNumerics(_r: BufferReader): Numerics = Numerics(
    _r.readI8(),
    _r.readI16(),
    _r.readI32(),
    _r.readI64(),
    _r.readU8(),
    _r.readU16(),
    _r.readU32(),
    _r.readU64(),
    _r.readF32(),
    _r.readF64(),
)

/** Rich (algebraic) enums and the expanded numeric primitives. */
object Shapes {
    /** Render a shape to a string */
    fun describe(shape: Shape): String = decodeUtf8(JniBridge.shapes_describe(encodeBuffer { _w -> packShape(_w, shape) }))

    /** Scale a shape by a factor, returning a new shape */
    fun scale(shape: Shape, factor: Double): Shape = decodeBuffer(JniBridge.shapes_scale(encodeBuffer { _w -> packShape(_w, shape) }, factor)) { _r -> unpackShape(_r) }

    /** Sum a list of bytes into a wide integer (numerics smoke) */
    fun sumBytes(values: ByteArray): ULong = JniBridge.shapes_sum_bytes(values).toULong()

    /** Build a Numerics struct from every numeric primitive */
    fun makeNumerics(a: Byte, b: Short, c: Int, d: Long, e: UByte, f: UShort, g: UInt, h: ULong, i: Float, j: Double): Numerics = decodeBuffer(JniBridge.shapes_make_numerics(a, b, c, d, e.toByte(), f.toShort(), g.toInt(), h.toLong(), i, j)) { _r -> unpackNumerics(_r) }
}

