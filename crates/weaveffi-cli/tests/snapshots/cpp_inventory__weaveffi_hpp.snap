namespace weaveffi {

/** Base exception for every error reported through the C ABI. */
class WeaveFFIError : public std::runtime_error {
    int32_t code_;

public:
    WeaveFFIError(int32_t code, const std::string& msg) : std::runtime_error(msg), code_(code) {}
    int32_t code() const { return code_; }
};

namespace detail {

/** Throw the generic WeaveFFIError if `err` carries a nonzero code. */
inline void check(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    int32_t code = err.code;
    weaveffi_error_clear(&err);
    throw WeaveFFIError(code, msg);
}

/** Wrap an async-callback error as the generic WeaveFFIError. */
inline std::exception_ptr make_error(int32_t code, const std::string& msg) {
    return std::make_exception_ptr(WeaveFFIError(code, msg));
}

} // namespace detail

namespace detail {

/**
 * Serializes values into the WeaveFFI value-buffer wire format: little-endian,
 * packed with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a string, byte-buffer, or collection length as a u32. */
    void write_len(size_t n) { append_le(static_cast<uint32_t>(n)); }

    void write_string(const std::string& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }
};

/**
 * Decodes values from the WeaveFFI value-buffer wire format. A malformed
 * buffer is a producer/consumer contract violation (both sides are generated
 * from one IDL), so every decode failure throws the generic WeaveFFIError,
 * the same channel as a producer panic.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    [[noreturn]] static void fail(const char* what) {
        throw WeaveFFIError(-2, std::string("malformed WeaveFFI value buffer: ") + what);
    }

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    BufferReader(const uint8_t* data, size_t len) : data_(data), len_(len), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a length prefix, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with weaveffi_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    ~BufferGuard() {
        if (ptr != nullptr) weaveffi_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

} // namespace detail

enum class Category : int32_t {
    Electronics = 0,
    Clothing = 1,
    Food = 2,
    Books = 3
};

struct Product {
    int64_t id;
    std::string name;
    std::optional<std::string> description;
    double price;
    Category category;
    std::vector<std::string> tags;
};

struct OrderItem {
    int64_t product_id;
    int32_t quantity;
    double unit_price;
};

struct Order {
    int64_t id;
    std::vector<OrderItem> items;
    double total;
    std::string status;
};

namespace detail {

/** Encodes a `Product` in the WeaveFFI value-buffer format. */
inline void write_Product(BufferWriter& w, const Product& v) {
    w.write_i64(v.id);
    w.write_string(v.name);
    w.write_option_flag(v.description.has_value());
    if (v.description.has_value()) {
        w.write_string((*v.description));
    }
    w.write_f64(v.price);
    w.write_i32(static_cast<int32_t>(v.category));
    w.write_len(v.tags.size());
    for (const auto& item0 : v.tags) {
        w.write_string(item0);
    }
}

/** Decodes a `Product` from the WeaveFFI value-buffer format. */
inline Product read_Product(BufferReader& r) {
    Product out{};
    out.id = r.read_i64();
    out.name = r.read_string();
    if (r.read_option_flag()) {
        std::string v_description_v = r.read_string();
        out.description = std::move(v_description_v);
    }
    out.price = r.read_f64();
    out.category = static_cast<Category>(r.read_i32());
    {
        size_t v_tags_n = r.read_len();
        out.tags.reserve(v_tags_n);
        for (size_t v_tags_i = 0; v_tags_i < v_tags_n; ++v_tags_i) {
            std::string v_tags_item = r.read_string();
            out.tags.push_back(std::move(v_tags_item));
        }
    }
    return out;
}

/** Encodes a `OrderItem` in the WeaveFFI value-buffer format. */
inline void write_OrderItem(BufferWriter& w, const OrderItem& v) {
    w.write_i64(v.product_id);
    w.write_i32(v.quantity);
    w.write_f64(v.unit_price);
}

/** Decodes a `OrderItem` from the WeaveFFI value-buffer format. */
inline OrderItem read_OrderItem(BufferReader& r) {
    OrderItem out{};
    out.product_id = r.read_i64();
    out.quantity = r.read_i32();
    out.unit_price = r.read_f64();
    return out;
}

/** Encodes a `Order` in the WeaveFFI value-buffer format. */
inline void write_Order(BufferWriter& w, const Order& v) {
    w.write_i64(v.id);
    w.write_len(v.items.size());
    for (const auto& item0 : v.items) {
        detail::write_OrderItem(w, item0);
    }
    w.write_f64(v.total);
    w.write_string(v.status);
}

/** Decodes a `Order` from the WeaveFFI value-buffer format. */
inline Order read_Order(BufferReader& r) {
    Order out{};
    out.id = r.read_i64();
    {
        size_t v_items_n = r.read_len();
        out.items.reserve(v_items_n);
        for (size_t v_items_i = 0; v_items_i < v_items_n; ++v_items_i) {
            OrderItem v_items_item = detail::read_OrderItem(r);
            out.items.push_back(std::move(v_items_item));
        }
    }
    out.total = r.read_f64();
    out.status = r.read_string();
    return out;
}

} // namespace detail

/** Typed errors reported by the `products` module's throwing functions. */
class ProductsError : public WeaveFFIError {
public:
    ProductsError(int32_t code, const std::string& msg) : WeaveFFIError(code, msg) {}
};

/** price must be positive */
class InvalidPriceError : public ProductsError {
public:
    InvalidPriceError(const std::string& msg) : ProductsError(1, msg) {}
};

/** product not found */
class ProductNotFoundError : public ProductsError {
public:
    ProductNotFoundError(const std::string& msg) : ProductsError(2, msg) {}
};

namespace detail {

/** Map a `products` error code and payload to its typed exception (WeaveFFIError for runtime codes, ProductsError for unknown codes). */
inline std::exception_ptr make_products_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    if (code < 0) return std::make_exception_ptr(WeaveFFIError(code, msg));
    switch (code) {
    case 1: return std::make_exception_ptr(InvalidPriceError(msg));
    case 2: return std::make_exception_ptr(ProductNotFoundError(msg));
    default: return std::make_exception_ptr(ProductsError(code, msg));
    }
}

/** Throw the typed `products` exception if `err` carries a nonzero code. */
inline void check_products(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    std::exception_ptr ex = make_products_error(err.code, msg, err.payload_ptr, err.payload_len);
    weaveffi_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

/** Typed errors reported by the `orders` module's throwing functions. */
class OrdersError : public WeaveFFIError {
public:
    OrdersError(int32_t code, const std::string& msg) : WeaveFFIError(code, msg) {}
};

/** order not found */
class OrderNotFoundError : public OrdersError {
public:
    OrderNotFoundError(const std::string& msg) : OrdersError(1, msg) {}
};

/** order must contain at least one item */
class EmptyOrderError : public OrdersError {
public:
    EmptyOrderError(const std::string& msg) : OrdersError(2, msg) {}
};

namespace detail {

/** Map a `orders` error code and payload to its typed exception (WeaveFFIError for runtime codes, OrdersError for unknown codes). */
inline std::exception_ptr make_orders_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    if (code < 0) return std::make_exception_ptr(WeaveFFIError(code, msg));
    switch (code) {
    case 1: return std::make_exception_ptr(OrderNotFoundError(msg));
    case 2: return std::make_exception_ptr(EmptyOrderError(msg));
    default: return std::make_exception_ptr(OrdersError(code, msg));
    }
}

/** Throw the typed `orders` exception if `err` carries a nonzero code. */
inline void check_orders(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    std::exception_ptr ex = make_orders_error(err.code, msg, err.payload_ptr, err.payload_len);
    weaveffi_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

/** A product catalog owning its products */
class Catalog {
    void* handle_;

public:
    explicit Catalog(void* h) : handle_(h) {}

    ~Catalog() {
        if (handle_) weaveffi_products_Catalog_destroy(static_cast<weaveffi_products_Catalog*>(handle_));
    }

    Catalog(const Catalog&) = delete;
    Catalog& operator=(const Catalog&) = delete;

    Catalog(Catalog&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    Catalog& operator=(Catalog&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_products_Catalog_destroy(static_cast<weaveffi_products_Catalog*>(handle_));
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    void* handle() const { return handle_; }

    Catalog() : handle_(nullptr) {
        weaveffi_error err{};
        auto result = weaveffi_products_Catalog_new(&err);
        detail::check(err);
        handle_ = result;
    }

    Product add_product(const std::string& name, double price, Category category) const {
        size_t out_len = 0;
        weaveffi_error err{};
        auto result = weaveffi_products_Catalog_add_product(static_cast<const weaveffi_products_Catalog*>(handle_), name.c_str(), price, static_cast<weaveffi_products_Category>(static_cast<int32_t>(category)), &out_len, &err);
        detail::check_products(err);
        detail::BufferGuard result_guard{result, out_len};
        detail::BufferReader result_r(result, out_len);
        Product ret = detail::read_Product(result_r);
        result_r.expect_end();
        return ret;
    }

    Product get_product(int64_t id) const {
        size_t out_len = 0;
        weaveffi_error err{};
        auto result = weaveffi_products_Catalog_get_product(static_cast<const weaveffi_products_Catalog*>(handle_), id, &out_len, &err);
        detail::check_products(err);
        detail::BufferGuard result_guard{result, out_len};
        detail::BufferReader result_r(result, out_len);
        Product ret = detail::read_Product(result_r);
        result_r.expect_end();
        return ret;
    }

    std::vector<Product> search(Category category) const {
        size_t out_len = 0;
        weaveffi_error err{};
        auto result = weaveffi_products_Catalog_search(static_cast<const weaveffi_products_Catalog*>(handle_), static_cast<weaveffi_products_Category>(static_cast<int32_t>(category)), &out_len, &err);
        detail::check(err);
        detail::BufferGuard result_guard{result, out_len};
        detail::BufferReader result_r(result, out_len);
        std::vector<Product> ret{};
        {
            size_t ret_n = result_r.read_len();
            ret.reserve(ret_n);
            for (size_t ret_i = 0; ret_i < ret_n; ++ret_i) {
                Product ret_item = detail::read_Product(result_r);
                ret.push_back(std::move(ret_item));
            }
        }
        result_r.expect_end();
        return ret;
    }

    bool update_price(int64_t id, double price) const {
        weaveffi_error err{};
        auto result = weaveffi_products_Catalog_update_price(static_cast<const weaveffi_products_Catalog*>(handle_), id, price, &err);
        detail::check_products(err);
        return result;
    }

    bool remove(int64_t id) const {
        weaveffi_error err{};
        auto result = weaveffi_products_Catalog_remove(static_cast<const weaveffi_products_Catalog*>(handle_), id, &err);
        detail::check(err);
        return result;
    }

};

namespace orders {

inline int64_t create_order(const std::vector<OrderItem>& items) {
    detail::BufferWriter items_buf;
    items_buf.write_len(items.size());
    for (const auto& item0 : items) {
        detail::write_OrderItem(items_buf, item0);
    }
    weaveffi_error err{};
    auto result = weaveffi_orders_create_order(items_buf.data(), items_buf.size(), &err);
    detail::check_orders(err);
    return result;
}

inline Order get_order(int64_t id) {
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_orders_get_order(id, &out_len, &err);
    detail::check_orders(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    Order ret = detail::read_Order(result_r);
    result_r.expect_end();
    return ret;
}

inline bool cancel_order(int64_t id) {
    weaveffi_error err{};
    auto result = weaveffi_orders_cancel_order(id, &err);
    detail::check(err);
    return result;
}

inline bool add_product_to_order(int64_t order_id, const Product& product) {
    detail::BufferWriter product_buf;
    detail::write_Product(product_buf, product);
    weaveffi_error err{};
    auto result = weaveffi_orders_add_product_to_order(order_id, product_buf.data(), product_buf.size(), &err);
    detail::check(err);
    return result;
}

} // namespace orders

} // namespace weaveffi

// END weaveffi.hpp
