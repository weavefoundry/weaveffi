WEAVEFFI_API uint64_t weaveffi_shapes_sum_bytes(const uint8_t* values_ptr, size_t values_len, weaveffi_error* out_err);
/** Build a Numerics struct from every numeric primitive */
WEAVEFFI_API const uint8_t* weaveffi_shapes_make_numerics(int8_t a, int16_t b, int32_t c, int64_t d, uint8_t e, uint16_t f, uint32_t g, uint64_t h, float i, double j, size_t* out_len, weaveffi_error* out_err);

