typedef enum { weaveffi_shapes_Channel_Red = 0, weaveffi_shapes_Channel_Green = 1, weaveffi_shapes_Channel_Blue = 2 } weaveffi_shapes_Channel;

/** Render a shape to a string */
WEAVEFFI_API const char* weaveffi_shapes_describe(const uint8_t* shape_ptr, size_t shape_len, weaveffi_error* out_err);
