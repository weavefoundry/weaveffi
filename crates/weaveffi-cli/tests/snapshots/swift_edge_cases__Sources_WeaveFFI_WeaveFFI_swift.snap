@inline(__always)
func mapEdgeCases(code: Int32, message: String, payload: [UInt8]?) -> Error {
    switch code {
    case 7: return EdgeErrorsError.busy(message: message.isEmpty ? "Resource is busy" : message)
    default: return WeaveFFIError.error(code: code, message: message)
    }
}

@inline(__always)
func checkEdgeCases(_ err: inout weaveffi_error) throws {
    if err.code != 0 {
        let code = err.code
        let message = err.message.flatMap { String(cString: $0) } ?? ""
        let payload: [UInt8]? = err.payload_ptr.map { [UInt8](UnsafeBufferPointer(start: $0, count: err.payload_len)) }
        weaveffi_error_clear(&err)
        throw mapEdgeCases(code: code, message: message, payload: payload)
    }
}

