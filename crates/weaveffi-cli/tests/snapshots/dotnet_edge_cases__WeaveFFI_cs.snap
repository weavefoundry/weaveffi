            var fLeavesCount = reader.ReadLen();
            var fLeaves = new Leaf[fLeavesCount];
            for (int i0 = 0; i0 < fLeavesCount; i0++)
            {
                var fLeavesItem = Leaf.ReadFrom(reader);
                fLeaves[i0] = fLeavesItem;
            }
            return new Inner(fLeaf, fLeaves);
        }
    }

    public sealed class Outer
    {
        public Inner Inner { get; }

        public Inner? MaybeInner { get; }

        public Dictionary<string, Inner> ByName { get; }

        public Mode[] Modes { get; }

        public int[][] Matrix { get; }

        public long?[] Sparse { get; }

        public byte[]? Blob { get; }

        public string? Note { get; }

        public Dictionary<long, string> ById { get; }

        public bool Hidden { get; }

        public byte V2 { get; }

        public Outer(Inner inner, Inner? maybeInner, Dictionary<string, Inner> byName, Mode[] modes, int[][] matrix, long?[] sparse, byte[]? blob, string? note, Dictionary<long, string> byId, bool hidden, byte v2)
        {
            Inner = inner;
            MaybeInner = maybeInner;
            ByName = byName;
            Modes = modes;
            Matrix = matrix;
            Sparse = sparse;
            Blob = blob;
            Note = note;
            ById = byId;
            Hidden = hidden;
            V2 = v2;
