            {
                id = NativeMethods.weaveffi_edge_cases_register_tick_listener(trampoline, IntPtr.Zero);
                _listenerRefs[id] = trampoline;
            }
            return id;
        }

        /// <summary>Unregisters a listener previously registered with RegisterTickListener().</summary>
        public static void UnregisterTickListener(ulong id)
        {
            NativeMethods.weaveffi_edge_cases_unregister_tick_listener(id);
            lock (_listenerLock)
            {
                _listenerRefs.Remove(id);
            }
        }

        /// <summary>No parameters and no result</summary>
        public static void Noop()
        {
            var err = new WeaveFFIError();
