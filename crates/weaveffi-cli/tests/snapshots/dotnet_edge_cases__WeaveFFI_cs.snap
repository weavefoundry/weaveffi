    public static class EdgeCases
    {
        private static readonly object _listenerLock = new object();
        // Live listener delegates by subscription id. Holding the delegate
        // here keeps its native thunk alive until unregistered; without this
        // the GC could collect a delegate the producer still calls.
        private static readonly Dictionary<ulong, Delegate> _listenerRefs = new Dictionary<ulong, Delegate>();

        /// <returns>A subscription id for UnregisterBatchListener().</returns>
        public static ulong RegisterBatchListener(Action<Outer[], byte[], Outer?, Mode> callback)
        {
            NativeMethods.Cb_weaveffi_edge_cases_OnBatch_fn trampoline = (items_ptr, items_len, raw_ptr, raw_len, first_ptr, first_len, mode, context) =>
            {
                var arg0Buf = new byte[(int)items_len];
                if (items_ptr != IntPtr.Zero && (int)items_len > 0) Marshal.Copy(items_ptr, arg0Buf, 0, (int)items_len);
                var arg0Reader = new WeaveFFIBufferReader(arg0Buf);
                var arg0Count = arg0Reader.ReadLen();
                var arg0 = new Outer[arg0Count];
                for (int i0 = 0; i0 < arg0Count; i0++)
                {
                    var arg0Item = Outer.ReadFrom(arg0Reader);
                    arg0[i0] = arg0Item;
                }
                arg0Reader.ExpectEnd();
                var arg1 = new byte[(int)raw_len];
                if (raw_ptr != IntPtr.Zero && (int)raw_len > 0) Marshal.Copy(raw_ptr, arg1, 0, (int)raw_len);
                var arg2Buf = new byte[(int)first_len];
                if (first_ptr != IntPtr.Zero && (int)first_len > 0) Marshal.Copy(first_ptr, arg2Buf, 0, (int)first_len);
                var arg2Reader = new WeaveFFIBufferReader(arg2Buf);
                Outer? arg2 = null;
                if (arg2Reader.ReadOptionFlag())
                {
                    var arg2Value = Outer.ReadFrom(arg2Reader);
                    arg2 = arg2Value;
                }
                arg2Reader.ExpectEnd();
                callback(arg0, arg1, arg2, (Mode)mode);
            };
            ulong id;
            lock (_listenerLock)
            {
                id = NativeMethods.weaveffi_edge_cases_register_batch_listener(trampoline, IntPtr.Zero);
                _listenerRefs[id] = trampoline;
            }
            return id;
        }

        /// <summary>Unregisters a listener previously registered with RegisterBatchListener().</summary>
        public static void UnregisterBatchListener(ulong id)
        {
            NativeMethods.weaveffi_edge_cases_unregister_batch_listener(id);
            lock (_listenerLock)
            {
                _listenerRefs.Remove(id);
            }
        }

        /// <returns>A subscription id for UnregisterTickListener().</returns>
        public static ulong RegisterTickListener(Action callback)
        {
            NativeMethods.Cb_weaveffi_edge_cases_OnTick_fn trampoline = (context) =>
            {
                callback();
            };
