        /// <summary>Objects in every buffered position</summary>
        public static WidgetHolder WidgetsEverywhere(Widget[] list, Dictionary<string, Widget> byName, Widget?[] sparse, WidgetHolder holder)
        {
            var err = new WeaveFFIError();
            var listWriter = new WeaveFFIBufferWriter();
            listWriter.WriteLen(list.Length);
            foreach (var item0 in list)
            {
                listWriter.WriteObject(item0.CloneHandle());
