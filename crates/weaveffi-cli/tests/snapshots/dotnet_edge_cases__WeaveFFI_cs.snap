                var decodedReader = new WeaveFFIBufferReader(resultBuf);
                var decoded = Keywords.ReadFrom(decodedReader);
                decodedReader.ExpectEnd();
                return decoded;
            }
            finally
            {
                valuePin.Free();
            }
        }

        [Obsolete("Use Mode-based APIs")]
        public static Retired LegacyValue(Legacy value)
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_edge_cases_legacy_value((int)value, out var outLen, ref err);
            WeaveFFIError.Check(err);
            var resultBuf = new byte[(int)outLen];
            if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
            NativeMethods.weaveffi_free_bytes(result, outLen);
            var decodedReader = new WeaveFFIBufferReader(resultBuf);
            var decoded = Retired.ReadFrom(decodedReader);
            decodedReader.ExpectEnd();
            return decoded;
        }

    }

}

