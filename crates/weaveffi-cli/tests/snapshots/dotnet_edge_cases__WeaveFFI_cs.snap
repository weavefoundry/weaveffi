        /// <summary>Iterator of objects</summary>
        /// <remarks>Streams lazily: each element is pulled from the native
        /// iterator on demand, and the iterator is destroyed when enumeration
        /// completes or the enumerator is disposed (a <c>foreach</c> disposes it
        /// automatically, including on early exit). The returned sequence can be
        /// enumerated only once.</remarks>
        public static IEnumerable<Widget> WidgetStream()
        {
            var err = new WeaveFFIError();
            var iter = NativeMethods.weaveffi_edge_cases_widget_stream(ref err);
            WeaveFFIError.Check(err);
            return new WeaveFFIOnceEnumerable<Widget>(EnumerateWidgetStream(iter));
        }

        private static IEnumerator<Widget> EnumerateWidgetStream(IntPtr iter)
        {
            try
            {
                while (true)
                {
                    var iterErr = new WeaveFFIError();
                    if (NativeMethods.weaveffi_edge_cases_WidgetStreamIterator_next(iter, out var out_item, ref iterErr) == 0)
                    {
                        WeaveFFIError.Check(iterErr);
                        yield break;
                    }
                    WeaveFFIError.Check(iterErr);
                    yield return new Widget(new WeaveFFIHandle(out_item));
                }
            }
            finally
            {
                NativeMethods.weaveffi_edge_cases_WidgetStreamIterator_destroy(iter);
            }
        }

        /// <summary>Async returning an object</summary>
