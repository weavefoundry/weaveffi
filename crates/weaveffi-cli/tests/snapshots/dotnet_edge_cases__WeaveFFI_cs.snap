        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            Inner.WriteTo(writer);
            if (MaybeInner != null)
            {
                writer.WriteOptionFlag(true);
                MaybeInner!.WriteTo(writer);
            }
            else
            {
                writer.WriteOptionFlag(false);
            }
            writer.WriteLen(ByName.Count);
            foreach (var entry0 in ByName)
            {
                writer.WriteString(entry0.Key);
                entry0.Value.WriteTo(writer);
            }
            writer.WriteLen(Modes.Length);
            foreach (var item0 in Modes)
            {
                writer.WriteI32((int)item0);
            }
            writer.WriteLen(Matrix.Length);
            foreach (var item0 in Matrix)
            {
                writer.WriteLen(item0.Length);
                foreach (var item1 in item0)
                {
                    writer.WriteI32(item1);
                }
            }
            writer.WriteLen(Sparse.Length);
            foreach (var item0 in Sparse)
            {
                if (item0 != null)
                {
                    writer.WriteOptionFlag(true);
                    writer.WriteI64(item0.Value);
                }
                else
                {
                    writer.WriteOptionFlag(false);
                }
            }
            if (Blob != null)
            {
                writer.WriteOptionFlag(true);
                writer.WriteBytes(Blob!);
            }
            else
            {
                writer.WriteOptionFlag(false);
            }
            if (Note != null)
            {
                writer.WriteOptionFlag(true);
                writer.WriteString(Note!);
            }
            else
            {
                writer.WriteOptionFlag(false);
            }
            writer.WriteLen(ById.Count);
            foreach (var entry0 in ById)
            {
                writer.WriteI64(entry0.Key);
                writer.WriteString(entry0.Value);
            }
            writer.WriteBool(Hidden);
            writer.WriteU8(V2);
        }

        internal static Outer ReadFrom(WeaveFFIBufferReader reader)
        {
            var fInner = Inner.ReadFrom(reader);
            Inner? fMaybeInner = null;
            if (reader.ReadOptionFlag())
            {
                var fMaybeInnerValue = Inner.ReadFrom(reader);
                fMaybeInner = fMaybeInnerValue;
            }
            var fByNameCount = reader.ReadLen();
            var fByName = new Dictionary<string, Inner>(fByNameCount);
            for (int i0 = 0; i0 < fByNameCount; i0++)
            {
                var fByNameKey = reader.ReadString();
                var fByNameVal = Inner.ReadFrom(reader);
                fByName[fByNameKey] = fByNameVal;
            }
            var fModesCount = reader.ReadLen();
            var fModes = new Mode[fModesCount];
            for (int i0 = 0; i0 < fModesCount; i0++)
            {
                var fModesItem = (Mode)reader.ReadI32();
                fModes[i0] = fModesItem;
            }
            var fMatrixCount = reader.ReadLen();
            var fMatrix = new int[fMatrixCount][];
            for (int i0 = 0; i0 < fMatrixCount; i0++)
            {
                var fMatrixItemCount = reader.ReadLen();
                var fMatrixItem = new int[fMatrixItemCount];
                for (int i1 = 0; i1 < fMatrixItemCount; i1++)
                {
                    var fMatrixItemItem = reader.ReadI32();
                    fMatrixItem[i1] = fMatrixItemItem;
                }
                fMatrix[i0] = fMatrixItem;
            }
            var fSparseCount = reader.ReadLen();
            var fSparse = new long?[fSparseCount];
            for (int i0 = 0; i0 < fSparseCount; i0++)
            {
                long? fSparseItem = null;
                if (reader.ReadOptionFlag())
                {
                    var fSparseItemValue = reader.ReadI64();
                    fSparseItem = fSparseItemValue;
                }
                fSparse[i0] = fSparseItem;
            }
            byte[]? fBlob = null;
            if (reader.ReadOptionFlag())
            {
                var fBlobValue = reader.ReadBytes();
                fBlob = fBlobValue;
            }
            string? fNote = null;
            if (reader.ReadOptionFlag())
            {
                var fNoteValue = reader.ReadString();
                fNote = fNoteValue;
            }
            var fByIdCount = reader.ReadLen();
            var fById = new Dictionary<long, string>(fByIdCount);
            for (int i0 = 0; i0 < fByIdCount; i0++)
            {
                var fByIdKey = reader.ReadI64();
                var fByIdVal = reader.ReadString();
                fById[fByIdKey] = fByIdVal;
            }
            var fHidden = reader.ReadBool();
            var fV2 = reader.ReadU8();
            return new Outer(fInner, fMaybeInner, fByName, fModes, fMatrix, fSparse, fBlob, fNote, fById, fHidden, fV2);
        }
