        {
            case Empty _:
                writer.WriteI32(0);
                break;
            case Circle v:
                writer.WriteI32(1);
                writer.WriteF64(v.Radius);
                break;
            case Rectangle v:
                writer.WriteI32(2);
                writer.WriteF32(v.Width);
                writer.WriteF32(v.Height);
                break;
            case Bounded v:
                writer.WriteI32(3);
                writer.WriteI16(v.Min);
                writer.WriteI16(v.Max);
                writer.WriteU64(v.Weight);
                break;
            case Labeled v:
