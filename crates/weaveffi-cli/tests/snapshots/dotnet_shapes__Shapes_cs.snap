                return new Rectangle(fWidth, fHeight);
            }
            case 3:
            {
                var fMin = reader.ReadI16();
                var fMax = reader.ReadI16();
                var fWeight = reader.ReadU64();
                return new Bounded(fMin, fMax, fWeight);
