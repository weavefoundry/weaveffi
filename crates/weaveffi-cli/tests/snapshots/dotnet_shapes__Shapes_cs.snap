                writer.WriteF32(v.Width);
                writer.WriteF32(v.Height);
                break;
            case Bounded v:
                writer.WriteI32(3);
                writer.WriteI16(v.Min);
                writer.WriteI16(v.Max);
                writer.WriteU64(v.Weight);
                break;
            case Labeled v:
                writer.WriteI32(4);
                writer.WriteString(v.Label);
                writer.WriteU8(v.Count);
