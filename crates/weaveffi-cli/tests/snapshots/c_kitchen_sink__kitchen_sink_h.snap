 * `throws: KitchenErrors` reports in `kitchen_sink_error.code`. Domains are
 * open: a newer library may report a positive code not listed here, which
 * keeps its message.
 */
typedef int32_t kitchen_sink_kitchen_KitchenErrors;
enum { kitchen_sink_kitchen_KitchenErrors_NotFound = 1, kitchen_sink_kitchen_KitchenErrors_InvalidInput = 2 };
