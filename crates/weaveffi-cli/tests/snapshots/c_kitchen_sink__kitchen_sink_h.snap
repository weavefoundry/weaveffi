 * Fails with a `kitchen_sink_KitchenErrors` code (and its fields as a payload
 * when it declares any).
 */
KITCHEN_SINK_API int32_t kitchen_sink_Gadget_poke(const kitchen_sink_Gadget* self, int32_t times, kitchen_sink_error* out_err);
