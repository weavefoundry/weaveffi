    uint32_t size;
    uint32_t flags;
    void (*free)(void* ctx);
    /** The cutoff for a level, if the sampler has one */
    bool (*threshold)(void* ctx, bool has_level, uint32_t level, double* out_value, kitchen_sink_error* out_err);
    /**
     * Up to `limit` samples, failing when the pantry is empty
     *
     * May fail with a `kitchen_sink_kitchen_PantryError` code (attaching its
     * fields with `kitchen_sink_error_set_payload` when it declares any).
     */
    void (*samples)(void* ctx, bool has_limit, uint32_t limit, const double* weights_ptr, size_t weights_len, int16_t** out_ptr, size_t* out_len, kitchen_sink_error* out_err);
    /**
     * A free-form description, failing with an untyped error
     *
     * May fail with code -1 and a message.
     */
    void (*describe)(void* ctx, uint8_t** out_ptr, size_t* out_len, kitchen_sink_error* out_err);
} kitchen_sink_kitchen_Sampler_vtable;
typedef void (*kitchen_sink_kitchen_do_async_callback)(void* context, kitchen_sink_error* err, const uint8_t* result_ptr, size_t result_len);
typedef void (*kitchen_sink_kitchen_do_cancellable_callback)(void* context, kitchen_sink_error* err, const uint8_t* result_ptr, size_t result_len);
typedef void (*kitchen_sink_kitchen_async_maybe_count_callback)(void* context, kitchen_sink_error* err, bool has_result, int64_t result);
typedef void (*kitchen_sink_kitchen_async_samples_callback)(void* context, kitchen_sink_error* err, const float* result_ptr, size_t result_len);

