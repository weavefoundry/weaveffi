        {kitchen_sink_contract_eb66fcdc777f75ca, 0xfa049f78b77e146aull, "gadgets"},
        {kitchen_sink_contract_eea763c41fa7d198, 0xcf1bc6bb37872798ull, "stream_chunks"},
        {kitchen_sink_contract_f24fd5a4569f91f3, 0x07e272f09c41fffcull, "Gadget.version"},
        {kitchen_sink_contract_fe26cde50070f9a2, 0xd88e2753503b36dfull, "stream_maybe"},
        {kitchen_sink_contract_ff329711a0bd4978, 0xc9047a95bdf49e93ull, "get_attrs"},
    };
    for (size_t i = 0; i < sizeof rows / sizeof rows[0]; i++) {
        if (rows[i].hash() != rows[i].expected) return rows[i].path;
    }
    return NULL;
}

