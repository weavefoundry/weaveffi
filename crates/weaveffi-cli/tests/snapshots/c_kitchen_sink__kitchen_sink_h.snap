/*
 * How values cross. Every value is one C value in every position
 * (parameter, return, async result, iterator item, callback argument):
 *   integer, float, bool, C-style enum   the value (an enum is int32_t)
 *   optional of one of those (T?)       kitchen_sink_opt_T: { bool has; T value; }
 *   string, bytes, [i8] .. [f64]        kitchen_sink_run: { ptr, len }, len in bytes
 *   (typed arrays), and every record,   (typed arrays are aligned for their
 *   rich enum, list, map, optional      element); the rest is a value buffer
 *   interface                           const Tag* as a parameter (borrowed),
 *                                       Tag* elsewhere (one reference moves)
 *   callback interface                  kitchen_sink_Cb: { ctx, vtable }
 * Strings are UTF-8 without a NUL terminator; NULL with length 0 is the
 * empty run. When generated, kitchen_sink_buffer.h declares a C struct and codec for
 * every value-buffer type. A run the producer returns is released with
 * kitchen_sink_run_free, and every one it allocates is 8-aligned. Every sync
 * call ends with `kitchen_sink_error* out_err`, which it overwrites.
 */

/** Task priority levels */
typedef int32_t kitchen_sink_Priority;
enum {
    /** Low priority */
    kitchen_sink_Priority_Low = 0,
    /** Normal priority */
    kitchen_sink_Priority_Normal = 1,
    /** High priority */
    kitchen_sink_Priority_High = 2
};
/**
 * Error codes of the `KitchenErrors` domain (`KitchenError` in the language
 * bindings), which a function declared `throws: KitchenErrors` reports in
 * `kitchen_sink_error.code`. Domains are open: a newer library may report a
 * positive code not listed here, which keeps its message.
 */
typedef int32_t kitchen_sink_KitchenErrors;
enum { kitchen_sink_KitchenErrors_NotFound = 1, kitchen_sink_KitchenErrors_InvalidInput = 2 };
/**
 * Error codes of the `PantryError` domain (`PantryError` in the language
 * bindings), which a function declared `throws: PantryError` reports in
 * `kitchen_sink_error.code`. Domains are open: a newer library may report a
 * positive code not listed here, which keeps its message.
 */
typedef int32_t kitchen_sink_PantryError;
enum { kitchen_sink_PantryError_OutOfStock = 1, kitchen_sink_PantryError_Spoiled = 2 };
typedef struct kitchen_sink_Gadget kitchen_sink_Gadget;
typedef struct kitchen_sink_StreamGadgetsIterator kitchen_sink_StreamGadgetsIterator;
typedef struct kitchen_sink_StreamItemsIterator kitchen_sink_StreamItemsIterator;
typedef struct kitchen_sink_StreamMaybeIterator kitchen_sink_StreamMaybeIterator;
typedef struct kitchen_sink_StreamChunksIterator kitchen_sink_StreamChunksIterator;
typedef struct kitchen_sink_ReadyListener_vtable kitchen_sink_ReadyListener_vtable;
/** A `ReadyListener` argument: the consumer's context and vtable (a NULL vtable is none). */
typedef struct kitchen_sink_ReadyListener { void* ctx; const kitchen_sink_ReadyListener_vtable* vtable; } kitchen_sink_ReadyListener;
typedef struct kitchen_sink_Sampler_vtable kitchen_sink_Sampler_vtable;
/** A `Sampler` argument: the consumer's context and vtable (a NULL vtable is none). */
typedef struct kitchen_sink_Sampler { void* ctx; const kitchen_sink_Sampler_vtable* vtable; } kitchen_sink_Sampler;
/**
 * Consumer-implemented observer of ready items
 *
 * A consumer-implemented callback interface, passed as a
 * `kitchen_sink_ReadyListener`: a context pointer and a pointer to a vtable
 * that outlives it, with `size` set to `sizeof` the vtable and `flags` to 0 or
 * `KITCHEN_SINK_VTABLE_THREAD_AFFINE`. Vtables are open: the producer accepts
 * a shorter vtable (a binding generated before a method was appended), and a
 * call to a method past its `size`, or a NULL entry, fails with -4. The
 * producer may call any method from any thread (with
 * `KITCHEN_SINK_VTABLE_THREAD_AFFINE`, a method that returns a value only from
 * the thread that passed the vtable) until it calls `free(ctx)` exactly once,
 * also from any thread. A method reports failure with
 * `kitchen_sink_error_set(out_err, ...)`, and returns a run it allocates with
 * `kitchen_sink_alloc`, which the producer adopts whether or not the method
 * failed.
 */
struct kitchen_sink_ReadyListener_vtable {
    uint32_t size;
    uint32_t flags;
    void (*free)(void* ctx);
    /** Fires when an item is ready */
    void (*on_ready)(void* ctx, int32_t code, kitchen_sink_run msg, kitchen_sink_error* out_err);
    /** Receives the item itself and says whether to keep listening */
    bool (*on_item)(void* ctx, kitchen_sink_run item, kitchen_sink_Gadget* gadget, kitchen_sink_error* out_err);
    /**
     * A display label, failing with a kitchen error
     *
     * May fail with a `kitchen_sink_KitchenErrors` code (attaching its fields with
     * `kitchen_sink_error_set_payload` when it declares any).
     */
    kitchen_sink_run (*label)(void* ctx, kitchen_sink_error* out_err);
    /** The most recent item the listener kept, if any */
    kitchen_sink_run (*latest)(void* ctx, kitchen_sink_error* out_err);
    /** The listener's favorite gadget */
    kitchen_sink_Gadget* (*favorite)(void* ctx, kitchen_sink_error* out_err);
};
/**
 * Consumer-implemented source of scalar samples
 *
 * A consumer-implemented callback interface, passed as a
 * `kitchen_sink_Sampler`: a context pointer and a pointer to a vtable that
 * outlives it, with `size` set to `sizeof` the vtable and `flags` to 0 or
 * `KITCHEN_SINK_VTABLE_THREAD_AFFINE`. Vtables are open: the producer accepts
 * a shorter vtable (a binding generated before a method was appended), and a
 * call to a method past its `size`, or a NULL entry, fails with -4. The
 * producer may call any method from any thread (with
 * `KITCHEN_SINK_VTABLE_THREAD_AFFINE`, a method that returns a value only from
 * the thread that passed the vtable) until it calls `free(ctx)` exactly once,
 * also from any thread. A method reports failure with
 * `kitchen_sink_error_set(out_err, ...)`, and returns a run it allocates with
 * `kitchen_sink_alloc`, which the producer adopts whether or not the method
 * failed.
 */
struct kitchen_sink_Sampler_vtable {
    uint32_t size;
    uint32_t flags;
    void (*free)(void* ctx);
    /** The cutoff for a level, if the sampler has one */
    kitchen_sink_opt_f64 (*threshold)(void* ctx, kitchen_sink_opt_u32 level, kitchen_sink_error* out_err);
    /**
     * Up to `limit` samples, failing when the pantry is empty
     *
     * May fail with a `kitchen_sink_PantryError` code (attaching its fields with
     * `kitchen_sink_error_set_payload` when it declares any).
     */
    kitchen_sink_run (*samples)(void* ctx, kitchen_sink_opt_u32 limit, kitchen_sink_run weights, kitchen_sink_error* out_err);
    /**
     * A free-form description, failing with an untyped error
     *
     * May fail with code -1 and a message.
     */
    kitchen_sink_run (*describe)(void* ctx, kitchen_sink_error* out_err);
};
typedef void (*kitchen_sink_do_async_callback)(void* context, kitchen_sink_error* err, kitchen_sink_run result);
typedef void (*kitchen_sink_do_cancellable_callback)(void* context, kitchen_sink_error* err, kitchen_sink_run result);
typedef void (*kitchen_sink_async_maybe_count_callback)(void* context, kitchen_sink_error* err, kitchen_sink_opt_i64 result);
typedef void (*kitchen_sink_async_samples_callback)(void* context, kitchen_sink_error* err, kitchen_sink_run result);

/** A pocket-sized interface exercising the object surface */
/** Create a gadget with the given id */
KITCHEN_SINK_API kitchen_sink_Gadget* kitchen_sink_Gadget_new(int64_t id, kitchen_sink_error* out_err);
/** The gadget subsystem version string */
KITCHEN_SINK_API kitchen_sink_run kitchen_sink_Gadget_version(kitchen_sink_error* out_err);
/** Render the gadget as a human-readable string */
KITCHEN_SINK_API kitchen_sink_run kitchen_sink_Gadget_describe(const kitchen_sink_Gadget* self, kitchen_sink_error* out_err);
/**
 * Poke the gadget a number of times, failing on a negative count
