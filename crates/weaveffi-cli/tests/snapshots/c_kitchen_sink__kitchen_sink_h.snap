/*
 * How values cross. A parameter `v` becomes, by its type:
 *   integer, float, bool, C-style enum   T v
 *   optional of one of those (T?)       bool has_v, T v (v is 0 and ignored
 *                                       when has_v is false)
 *   [i8] [i16] [i32] [i64] [u16] [u32]  const T* v_ptr, size_t v_len
 *   [u64] [f32] [f64] (typed arrays)    (v_len counts elements; v_ptr is
 *                                       aligned for T, NULL when v_len is 0)
 *   string, bytes, and every other      const uint8_t* v_ptr, size_t v_len
 *   record, enum, list, map, optional
 *   interface                           const Tag* v (borrowed; NULL for an
 *                                       absent optional)
 *   callback interface                  void* v_ctx, const Tag_vtable* v_vtable
 * Strings are UTF-8 without a NUL terminator; NULL with length 0 is the
 * empty value. Everything in the (ptr, len) row past bytes is a value
 * buffer in the little-endian format; when generated, kitchen_sink_buffer.h
 * declares a C struct and codec for each such type.
 *
 * A return of type T is the C return, except: T? returns `bool` (present)
 * with the value in a trailing `T* out_value`; a typed array returns `T*`
 * with its element count in `size_t* out_len`, released with
 * kitchen_sink_free_bytes((uint8_t*)ptr, len * sizeof(T)); a string, bytes, or
 * buffer returns `const uint8_t*` with `size_t* out_len`, released with
 * kitchen_sink_free_bytes(ptr, len); an interface returns an owned reference,
 * released with its `_destroy`. Every producer run is 8-aligned. Every
 * sync call ends with `kitchen_sink_error* out_err`.
 */

/** Task priority levels */
typedef int32_t kitchen_sink_kitchen_Priority;
enum {
    /** Low priority */
    kitchen_sink_kitchen_Priority_Low = 0,
    /** Normal priority */
    kitchen_sink_kitchen_Priority_Normal = 1,
    /** High priority */
    kitchen_sink_kitchen_Priority_High = 2
};
