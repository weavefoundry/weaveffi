 *
 * Fails with code -1 and a message.
 */
KITCHEN_SINK_API kitchen_sink_run kitchen_sink_Gadget_readings(const kitchen_sink_Gadget* self, kitchen_sink_opt_u32 limit, kitchen_sink_error* out_err);
/** Returns a new strong reference to the same object (the pointer value is unchanged). Null is a no-op returning null. */
KITCHEN_SINK_API kitchen_sink_Gadget* kitchen_sink_Gadget_clone(const kitchen_sink_Gadget* self);
/** Releases one strong reference; the object is dropped when the last reference is released. Null is a no-op. */
KITCHEN_SINK_API void kitchen_sink_Gadget_destroy(kitchen_sink_Gadget* self);

