KITCHEN_SINK_API kitchen_sink_opt_u16 kitchen_sink_opt_mixed(double base, kitchen_sink_opt_f32 scale, kitchen_sink_opt_i64 offset, kitchen_sink_run label, kitchen_sink_error* out_err);
/** A typed-array parameter */
KITCHEN_SINK_API double kitchen_sink_sum_f64(kitchen_sink_run xs, kitchen_sink_error* out_err);
/** Typed arrays in both directions */
KITCHEN_SINK_API kitchen_sink_run kitchen_sink_scale_i32(kitchen_sink_run xs, int32_t factor, kitchen_sink_error* out_err);
KITCHEN_SINK_API kitchen_sink_run kitchen_sink_ids_u64(kitchen_sink_run ids, kitchen_sink_error* out_err);
/** Every slice element type */
KITCHEN_SINK_API kitchen_sink_run kitchen_sink_mixed_slices(kitchen_sink_run a, kitchen_sink_run b, kitchen_sink_run c, kitchen_sink_run d, kitchen_sink_run e, kitchen_sink_run f, kitchen_sink_error* out_err);
/** Async returning an optional scalar */
KITCHEN_SINK_API void kitchen_sink_async_maybe_count(kitchen_sink_async_maybe_count_callback callback, void* context);
/** Async returning a typed array */
KITCHEN_SINK_API void kitchen_sink_async_samples(uint32_t n, kitchen_sink_cancel_token* cancel_token, kitchen_sink_async_samples_callback callback, void* context);
/** Iterator of optional scalars */
KITCHEN_SINK_API kitchen_sink_StreamMaybeIterator* kitchen_sink_stream_maybe(kitchen_sink_error* out_err);
KITCHEN_SINK_API int32_t kitchen_sink_StreamMaybeIterator_next(kitchen_sink_StreamMaybeIterator* iter, kitchen_sink_opt_i32* out_item, kitchen_sink_error* out_err);
KITCHEN_SINK_API void kitchen_sink_StreamMaybeIterator_destroy(kitchen_sink_StreamMaybeIterator* iter);
/** Iterator of typed arrays */
KITCHEN_SINK_API kitchen_sink_StreamChunksIterator* kitchen_sink_stream_chunks(kitchen_sink_error* out_err);
KITCHEN_SINK_API int32_t kitchen_sink_StreamChunksIterator_next(kitchen_sink_StreamChunksIterator* iter, kitchen_sink_run* out_item, kitchen_sink_error* out_err);
KITCHEN_SINK_API void kitchen_sink_StreamChunksIterator_destroy(kitchen_sink_StreamChunksIterator* iter);
/**
 * Drive a consumer-implemented sampler
 *
 * Fails with a `kitchen_sink_PantryError` code (and its fields as a payload
 * when it declares any).
 */
KITCHEN_SINK_API kitchen_sink_run kitchen_sink_sample_with(kitchen_sink_Sampler sampler, kitchen_sink_opt_u32 level, kitchen_sink_error* out_err);
/**
 * Fails with the second domain
 *
 * Fails with a `kitchen_sink_PantryError` code (and its fields as a payload
 * when it declares any).
 */
KITCHEN_SINK_API int32_t kitchen_sink_take_from_pantry(kitchen_sink_run item, kitchen_sink_error* out_err);
/**
 * Fails with an untyped error
 *
 * Fails with code -1 and a message.
 */
KITCHEN_SINK_API int64_t kitchen_sink_parse_any(kitchen_sink_run text, kitchen_sink_error* out_err);
/** A trivial function returning a string */
KITCHEN_SINK_API kitchen_sink_run kitchen_sink_hello(kitchen_sink_error* out_err);

