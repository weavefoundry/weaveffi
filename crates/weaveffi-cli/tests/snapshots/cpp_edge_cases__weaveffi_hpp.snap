        for (size_t f_matrix_i = 0; f_matrix_i < f_matrix_n; ++f_matrix_i) {
            std::vector<int32_t> f_matrix_item{};
            {
                size_t f_matrix_item_n = r.read_len();
                f_matrix_item.reserve(f_matrix_item_n);
                for (size_t f_matrix_item_i = 0; f_matrix_item_i < f_matrix_item_n; ++f_matrix_item_i) {
                    int32_t f_matrix_item_item = r.read_i32();
                    f_matrix_item.push_back(std::move(f_matrix_item_item));
                }
            }
