class Widget {
    weaveffi_edge_cases_Widget* handle_;

public:
    /** Adopts one strong reference to a producer object. */
    explicit Widget(weaveffi_edge_cases_Widget* h) : handle_(h) {}

    /** Releases this wrapper's reference; the object is dropped with its last one. */
    ~Widget() {
        if (handle_) weaveffi_edge_cases_Widget_destroy(handle_);
    }

    /** Copies share the object: the copy takes a new strong reference. */
    Widget(const Widget& other) : handle_(weaveffi_edge_cases_Widget_clone(other.handle_)) {}

    Widget& operator=(const Widget& other) {
        if (this != &other) {
            weaveffi_edge_cases_Widget* h = weaveffi_edge_cases_Widget_clone(other.handle_);
            if (handle_) weaveffi_edge_cases_Widget_destroy(handle_);
            handle_ = h;
        }
        return *this;
    }

    Widget(Widget&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    Widget& operator=(Widget&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_edge_cases_Widget_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** The wrapped pointer, borrowed: this wrapper keeps its reference. */
    const weaveffi_edge_cases_Widget* handle() const { return handle_; }

    /** A new strong reference the caller owns (for example to write into a value buffer). */
    weaveffi_edge_cases_Widget* clone_handle() const { return weaveffi_edge_cases_Widget_clone(handle_); }

    /** Void method that can fail */
