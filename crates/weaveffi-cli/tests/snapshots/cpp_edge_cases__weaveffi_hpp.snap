/** Async with no result */
inline std::future<void> async_void() {
    auto* promise_ptr = new std::promise<void>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_async_void_async([](void* context, weaveffi_error* err) {
        auto* p = static_cast<std::promise<void>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                p->set_value();
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline std::future<std::vector<uint8_t>> async_bytes(uint32_t size) {
    auto* promise_ptr = new std::promise<std::vector<uint8_t>>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_async_bytes_async(size, [](void* context, weaveffi_error* err, const uint8_t* result, size_t result_len) {
        auto* p = static_cast<std::promise<std::vector<uint8_t>>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                std::vector<uint8_t> value(result, result + result_len);
                weaveffi_free_bytes(const_cast<uint8_t*>(result), result_len);
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline std::future<Outer> async_struct() {
    auto* promise_ptr = new std::promise<Outer>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_async_struct_async([](void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len) {
        auto* p = static_cast<std::promise<Outer>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_edge_cases_error(err->code, msg, err->payload_ptr, err->payload_len));
            } else {
                detail::BufferGuard result_guard{result_ptr, result_len};
                detail::BufferReader result_r(result_ptr, result_len);
                Outer value = detail::read_Outer(result_r);
                result_r.expect_end();
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline std::future<std::vector<Outer>> async_list(weaveffi_cancel_token* cancel_token) {
    auto* promise_ptr = new std::promise<std::vector<Outer>>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_async_list_async(cancel_token, [](void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len) {
        auto* p = static_cast<std::promise<std::vector<Outer>>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_edge_cases_error(err->code, msg, err->payload_ptr, err->payload_len));
            } else {
                detail::BufferGuard result_guard{result_ptr, result_len};
                detail::BufferReader result_r(result_ptr, result_len);
                std::vector<Outer> value{};
                {
                    size_t value_n = result_r.read_len();
                    value.reserve(value_n);
                    for (size_t value_i = 0; value_i < value_n; ++value_i) {
                        Outer value_item = detail::read_Outer(result_r);
                        value.push_back(std::move(value_item));
                    }
                }
                result_r.expect_end();
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline std::future<std::optional<int64_t>> async_optional() {
    auto* promise_ptr = new std::promise<std::optional<int64_t>>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_async_optional_async([](void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len) {
        auto* p = static_cast<std::promise<std::optional<int64_t>>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                detail::BufferGuard result_guard{result_ptr, result_len};
                detail::BufferReader result_r(result_ptr, result_len);
                std::optional<int64_t> value{};
                if (result_r.read_option_flag()) {
                    int64_t value_v = result_r.read_i64();
                    value = std::move(value_v);
                }
                result_r.expect_end();
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline std::future<Mode> async_enum() {
    auto* promise_ptr = new std::promise<Mode>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_async_enum_async([](void* context, weaveffi_error* err, weaveffi_edge_cases_Mode result) {
        auto* p = static_cast<std::promise<Mode>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                p->set_value(static_cast<Mode>(result));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline std::future<std::string> async_keywords(const std::string& class_, int32_t import) {
    auto* promise_ptr = new std::promise<std::string>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_async_keywords_async(class_.c_str(), import, [](void* context, weaveffi_error* err, const char* result) {
        auto* p = static_cast<std::promise<std::string>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                std::string value(result ? result : "");
                weaveffi_free_string(result);
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

inline Keywords keywords_roundtrip(const Keywords& value) {
    detail::BufferWriter value_buf;
    detail::write_Keywords(value_buf, value);
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_keywords_roundtrip(value_buf.data(), value_buf.size(), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    Keywords ret = detail::read_Keywords(result_r);
    result_r.expect_end();
    return ret;
}

[[deprecated("Use Mode-based APIs")]]
inline Retired legacy_value(Legacy value) {
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_legacy_value(static_cast<weaveffi_edge_cases_Legacy>(static_cast<int32_t>(value)), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    Retired ret = detail::read_Retired(result_r);
    result_r.expect_end();
    return ret;
}

