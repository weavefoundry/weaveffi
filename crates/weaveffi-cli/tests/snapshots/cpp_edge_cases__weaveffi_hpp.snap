namespace weaveffi {

/** Base exception for every error reported through the C ABI. */
class WeaveFFIError : public std::runtime_error {
    int32_t code_;

public:
    WeaveFFIError(int32_t code, const std::string& msg) : std::runtime_error(msg), code_(code) {}
    int32_t code() const { return code_; }
};

namespace detail {

/** Throw the generic WeaveFFIError if `err` carries a nonzero code. */
inline void check(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    int32_t code = err.code;
    weaveffi_error_clear(&err);
    throw WeaveFFIError(code, msg);
}

/** Wrap an async-callback error as the generic WeaveFFIError. */
inline std::exception_ptr make_error(int32_t code, const std::string& msg) {
    return std::make_exception_ptr(WeaveFFIError(code, msg));
}

} // namespace detail

namespace detail {

/**
 * Serializes values into the WeaveFFI value-buffer wire format: little-endian,
 * packed with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a string, byte-buffer, or collection length as a u32. */
    void write_len(size_t n) { append_le(static_cast<uint32_t>(n)); }

    void write_string(const std::string& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }
};

/**
 * Decodes values from the WeaveFFI value-buffer wire format. A malformed
 * buffer is a producer/consumer contract violation (both sides are generated
 * from one IDL), so every decode failure throws the generic WeaveFFIError,
 * the same channel as a producer panic.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    [[noreturn]] static void fail(const char* what) {
        throw WeaveFFIError(-2, std::string("malformed WeaveFFI value buffer: ") + what);
    }

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    BufferReader(const uint8_t* data, size_t len) : data_(data), len_(len), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a length prefix, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with weaveffi_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    ~BufferGuard() {
        if (ptr != nullptr) weaveffi_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

} // namespace detail

/** Deprecated enum with non-contiguous values and keyword-like variants */
enum class Legacy : int32_t {
    None = 0,
    Default = 5,
    Class = 10
};

enum class Mode : int32_t {
    Fast = 1,
    Safe = 2
};

struct Leaf {
    float weight;
};

/** Middle layer of a three-deep struct nesting */
struct Inner {
    Leaf leaf;
    std::vector<Leaf> leaves;
};

struct Outer {
    Inner inner;
    std::optional<Inner> maybe_inner;
    std::unordered_map<std::string, Inner> by_name;
    std::vector<Mode> modes;
    std::vector<std::vector<int32_t>> matrix;
    std::vector<std::optional<int64_t>> sparse;
    std::optional<std::vector<uint8_t>> blob;
    std::optional<std::string> note;
    std::unordered_map<int64_t, std::string> by_id;
    bool _hidden;
    uint8_t v2;
};

/** Every field is a reserved word somewhere */
struct Keywords {
    int32_t class_;
    int32_t def;
    int32_t import;
    int32_t from;
    int32_t func;
    int32_t range;
    int32_t register_;
    int32_t volatile_;
    int32_t new_;
    int32_t default_;
    int32_t end;
    int32_t in;
    int32_t is;
    int32_t int_;
    int32_t var;
    int32_t val;
    int32_t self;
    int32_t this_;
    int32_t object;
    int32_t string;
    int32_t case_;
    int32_t select;
    int32_t switch_;
    int32_t void_;
    int32_t union_;
    int32_t namespace_;
    int32_t operator_;
    int32_t template_;
    int32_t package;
    int32_t protocol;
    int32_t guard;
    int32_t defer;
    int32_t inout;
    int32_t internal;
    int32_t when;
    int32_t fun;
    int32_t data;
    int32_t late;
    int32_t part;
    int32_t out;
    int32_t ref;
    int32_t event;
    int32_t base;
    int32_t lambda;
    int32_t yield;
    int32_t nil;
    int32_t null;
    int32_t begin;
    int32_t rescue;
    int32_t module;
    int32_t chan;
    int32_t go;
    int32_t let;
    int32_t export_;
    int32_t delete_;
    int32_t typedef_;
    int32_t sizeof_;
    int32_t static_;
    int32_t super;
};

/** Deprecated struct */
struct Retired {
    int64_t id;
};

namespace detail {

/** Encodes a `Leaf` in the WeaveFFI value-buffer format. */
inline void write_Leaf(BufferWriter& w, const Leaf& v) {
    w.write_f32(v.weight);
}

/** Decodes a `Leaf` from the WeaveFFI value-buffer format. */
inline Leaf read_Leaf(BufferReader& r) {
    Leaf out{};
    out.weight = r.read_f32();
    return out;
}

/** Encodes a `Inner` in the WeaveFFI value-buffer format. */
inline void write_Inner(BufferWriter& w, const Inner& v) {
    detail::write_Leaf(w, v.leaf);
    w.write_len(v.leaves.size());
    for (const auto& item0 : v.leaves) {
        detail::write_Leaf(w, item0);
    }
}

/** Decodes a `Inner` from the WeaveFFI value-buffer format. */
inline Inner read_Inner(BufferReader& r) {
    Inner out{};
    out.leaf = detail::read_Leaf(r);
    {
        size_t v_leaves_n = r.read_len();
        out.leaves.reserve(v_leaves_n);
        for (size_t v_leaves_i = 0; v_leaves_i < v_leaves_n; ++v_leaves_i) {
            Leaf v_leaves_item = detail::read_Leaf(r);
            out.leaves.push_back(std::move(v_leaves_item));
        }
    }
    return out;
}

/** Encodes a `Outer` in the WeaveFFI value-buffer format. */
inline void write_Outer(BufferWriter& w, const Outer& v) {
    detail::write_Inner(w, v.inner);
    w.write_option_flag(v.maybe_inner.has_value());
    if (v.maybe_inner.has_value()) {
        detail::write_Inner(w, (*v.maybe_inner));
    }
    w.write_len(v.by_name.size());
    for (const auto& kv0 : v.by_name) {
        w.write_string(kv0.first);
        detail::write_Inner(w, kv0.second);
    }
    w.write_len(v.modes.size());
    for (const auto& item0 : v.modes) {
        w.write_i32(static_cast<int32_t>(item0));
    }
    w.write_len(v.matrix.size());
    for (const auto& item0 : v.matrix) {
        w.write_len(item0.size());
        for (const auto& item1 : item0) {
            w.write_i32(item1);
        }
    }
    w.write_len(v.sparse.size());
    for (const auto& item0 : v.sparse) {
        w.write_option_flag(item0.has_value());
        if (item0.has_value()) {
            w.write_i64((*item0));
        }
    }
    w.write_option_flag(v.blob.has_value());
    if (v.blob.has_value()) {
        w.write_bytes((*v.blob));
    }
    w.write_option_flag(v.note.has_value());
    if (v.note.has_value()) {
        w.write_string((*v.note));
    }
    w.write_len(v.by_id.size());
    for (const auto& kv0 : v.by_id) {
        w.write_i64(kv0.first);
        w.write_string(kv0.second);
    }
    w.write_bool(v._hidden);
    w.write_u8(v.v2);
}

/** Decodes a `Outer` from the WeaveFFI value-buffer format. */
inline Outer read_Outer(BufferReader& r) {
    Outer out{};
    out.inner = detail::read_Inner(r);
    if (r.read_option_flag()) {
        Inner v_maybe_inner_v = detail::read_Inner(r);
        out.maybe_inner = std::move(v_maybe_inner_v);
    }
    {
        size_t v_by_name_n = r.read_len();
        for (size_t v_by_name_i = 0; v_by_name_i < v_by_name_n; ++v_by_name_i) {
            std::string v_by_name_key = r.read_string();
            Inner v_by_name_val = detail::read_Inner(r);
            out.by_name.emplace(std::move(v_by_name_key), std::move(v_by_name_val));
        }
    }
    {
        size_t v_modes_n = r.read_len();
        out.modes.reserve(v_modes_n);
        for (size_t v_modes_i = 0; v_modes_i < v_modes_n; ++v_modes_i) {
            Mode v_modes_item = static_cast<Mode>(r.read_i32());
            out.modes.push_back(std::move(v_modes_item));
        }
    }
    {
        size_t v_matrix_n = r.read_len();
        out.matrix.reserve(v_matrix_n);
        for (size_t v_matrix_i = 0; v_matrix_i < v_matrix_n; ++v_matrix_i) {
            std::vector<int32_t> v_matrix_item{};
            {
                size_t v_matrix_item_n = r.read_len();
                v_matrix_item.reserve(v_matrix_item_n);
                for (size_t v_matrix_item_i = 0; v_matrix_item_i < v_matrix_item_n; ++v_matrix_item_i) {
                    int32_t v_matrix_item_item = r.read_i32();
                    v_matrix_item.push_back(std::move(v_matrix_item_item));
                }
            }
            out.matrix.push_back(std::move(v_matrix_item));
        }
    }
    {
        size_t v_sparse_n = r.read_len();
        out.sparse.reserve(v_sparse_n);
        for (size_t v_sparse_i = 0; v_sparse_i < v_sparse_n; ++v_sparse_i) {
            std::optional<int64_t> v_sparse_item{};
            if (r.read_option_flag()) {
                int64_t v_sparse_item_v = r.read_i64();
                v_sparse_item = std::move(v_sparse_item_v);
            }
            out.sparse.push_back(std::move(v_sparse_item));
        }
    }
    if (r.read_option_flag()) {
        std::vector<uint8_t> v_blob_v = r.read_bytes();
        out.blob = std::move(v_blob_v);
    }
    if (r.read_option_flag()) {
        std::string v_note_v = r.read_string();
        out.note = std::move(v_note_v);
    }
    {
        size_t v_by_id_n = r.read_len();
        for (size_t v_by_id_i = 0; v_by_id_i < v_by_id_n; ++v_by_id_i) {
            int64_t v_by_id_key = r.read_i64();
            std::string v_by_id_val = r.read_string();
            out.by_id.emplace(std::move(v_by_id_key), std::move(v_by_id_val));
        }
    }
    out._hidden = r.read_bool();
    out.v2 = r.read_u8();
    return out;
}

/** Encodes a `Keywords` in the WeaveFFI value-buffer format. */
inline void write_Keywords(BufferWriter& w, const Keywords& v) {
    w.write_i32(v.class_);
    w.write_i32(v.def);
    w.write_i32(v.import);
    w.write_i32(v.from);
    w.write_i32(v.func);
    w.write_i32(v.range);
    w.write_i32(v.register_);
    w.write_i32(v.volatile_);
    w.write_i32(v.new_);
    w.write_i32(v.default_);
    w.write_i32(v.end);
    w.write_i32(v.in);
    w.write_i32(v.is);
    w.write_i32(v.int_);
    w.write_i32(v.var);
    w.write_i32(v.val);
    w.write_i32(v.self);
    w.write_i32(v.this_);
    w.write_i32(v.object);
    w.write_i32(v.string);
    w.write_i32(v.case_);
    w.write_i32(v.select);
    w.write_i32(v.switch_);
    w.write_i32(v.void_);
    w.write_i32(v.union_);
    w.write_i32(v.namespace_);
    w.write_i32(v.operator_);
    w.write_i32(v.template_);
    w.write_i32(v.package);
    w.write_i32(v.protocol);
    w.write_i32(v.guard);
    w.write_i32(v.defer);
    w.write_i32(v.inout);
    w.write_i32(v.internal);
    w.write_i32(v.when);
    w.write_i32(v.fun);
    w.write_i32(v.data);
    w.write_i32(v.late);
    w.write_i32(v.part);
    w.write_i32(v.out);
    w.write_i32(v.ref);
    w.write_i32(v.event);
    w.write_i32(v.base);
    w.write_i32(v.lambda);
    w.write_i32(v.yield);
    w.write_i32(v.nil);
    w.write_i32(v.null);
    w.write_i32(v.begin);
    w.write_i32(v.rescue);
    w.write_i32(v.module);
    w.write_i32(v.chan);
    w.write_i32(v.go);
    w.write_i32(v.let);
    w.write_i32(v.export_);
    w.write_i32(v.delete_);
    w.write_i32(v.typedef_);
    w.write_i32(v.sizeof_);
    w.write_i32(v.static_);
    w.write_i32(v.super);
}

