    out.delete_ = r.read_i32();
    out.typedef_ = r.read_i32();
    out.sizeof_ = r.read_i32();
    out.static_ = r.read_i32();
    out.super = r.read_i32();
    return out;
}

/** Encodes a `Retired` in the WeaveFFI value-buffer format. */
inline void write_Retired(BufferWriter& w, const Retired& v) {
    w.write_i64(v.id);
}

/** Decodes a `Retired` from the WeaveFFI value-buffer format. */
inline Retired read_Retired(BufferReader& r) {
    Retired out{};
    out.id = r.read_i64();
    return out;
}

} // namespace detail

/** Typed errors reported by the `edge_cases` module's throwing functions. */
class EdgeErrorsError : public WeaveFFIError {
public:
    EdgeErrorsError(int32_t code, const std::string& msg) : WeaveFFIError(code, msg) {}
};

/** Resource is busy */
class BusyError : public EdgeErrorsError {
public:
    BusyError(const std::string& msg) : EdgeErrorsError(7, msg) {}
};

namespace detail {

/** Map a `edge_cases` error code and payload to its typed exception (WeaveFFIError for runtime codes, EdgeErrorsError for unknown codes). */
inline std::exception_ptr make_edge_cases_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    if (code < 0) return std::make_exception_ptr(WeaveFFIError(code, msg));
    switch (code) {
    case 7: return std::make_exception_ptr(BusyError(msg));
    default: return std::make_exception_ptr(EdgeErrorsError(code, msg));
    }
}

/** Throw the typed `edge_cases` exception if `err` carries a nonzero code. */
inline void check_edge_cases(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    std::exception_ptr ex = make_edge_cases_error(err.code, msg, err.payload_ptr, err.payload_len);
    weaveffi_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

namespace detail {

inline std::mutex& wv_listener_mutex() {
    static std::mutex m;
    return m;
}

inline std::unordered_map<uint64_t, std::shared_ptr<void>>& wv_listener_registry() {
    static std::unordered_map<uint64_t, std::shared_ptr<void>> registry;
    return registry;
}

} // namespace detail

/** Interface with no constructor; instances come from make_widget */
class Widget {
    void* handle_;

public:
    explicit Widget(void* h) : handle_(h) {}

    ~Widget() {
        if (handle_) weaveffi_edge_cases_Widget_destroy(static_cast<weaveffi_edge_cases_Widget*>(handle_));
    }

    Widget(const Widget&) = delete;
    Widget& operator=(const Widget&) = delete;

    Widget(Widget&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    Widget& operator=(Widget&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_edge_cases_Widget_destroy(static_cast<weaveffi_edge_cases_Widget*>(handle_));
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    void* handle() const { return handle_; }

    /** Void method that can fail */
    void refresh() const {
        weaveffi_error err{};
        weaveffi_edge_cases_Widget_refresh(static_cast<const weaveffi_edge_cases_Widget*>(handle_), &err);
        detail::check_edge_cases(err);
    }

    std::string rename(const std::string& class_, const std::optional<std::string>& import) const {
        detail::BufferWriter import_buf;
        import_buf.write_option_flag(import.has_value());
        if (import.has_value()) {
            import_buf.write_string((*import));
        }
        weaveffi_error err{};
        auto result = weaveffi_edge_cases_Widget_rename(static_cast<const weaveffi_edge_cases_Widget*>(handle_), class_.c_str(), import_buf.data(), import_buf.size(), &err);
        detail::check(err);
        std::string ret(result);
        weaveffi_free_string(result);
        return ret;
    }

    /** Async method with a struct result */
    std::future<Outer> fetch(int64_t id) const {
        auto* promise_ptr = new std::promise<Outer>();
        auto future = promise_ptr->get_future();
        weaveffi_edge_cases_Widget_fetch_async(static_cast<const weaveffi_edge_cases_Widget*>(handle_), id, [](void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len) {
            auto* p = static_cast<std::promise<Outer>*>(context);
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_edge_cases_error(err->code, msg, err->payload_ptr, err->payload_len));
                weaveffi_error_free(err);
            } else {
                detail::BufferReader result_r(result_ptr, result_len);
                Outer value = detail::read_Outer(result_r);
                result_r.expect_end();
                weaveffi_free_bytes(const_cast<uint8_t*>(result_ptr), result_len);
                p->set_value(std::move(value));
            }
            delete p;
        }, static_cast<void*>(promise_ptr));
        return future;
    }

    [[deprecated("Use rename instead")]]
    std::string old_name() const {
        weaveffi_error err{};
        auto result = weaveffi_edge_cases_Widget_old_name(static_cast<const weaveffi_edge_cases_Widget*>(handle_), &err);
        detail::check(err);
        std::string ret(result);
        weaveffi_free_string(result);
        return ret;
    }

};

/** Deprecated interface with a throwing constructor */
class Vault {
    void* handle_;

public:
    explicit Vault(void* h) : handle_(h) {}

    ~Vault() {
        if (handle_) weaveffi_edge_cases_Vault_destroy(static_cast<weaveffi_edge_cases_Vault*>(handle_));
    }

    Vault(const Vault&) = delete;
    Vault& operator=(const Vault&) = delete;

    Vault(Vault&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    Vault& operator=(Vault&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_edge_cases_Vault_destroy(static_cast<weaveffi_edge_cases_Vault*>(handle_));
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    void* handle() const { return handle_; }

    /** Fails when the vault is busy */
    static Vault open(const std::string& path) {
        weaveffi_error err{};
        auto result = weaveffi_edge_cases_Vault_open(path.c_str(), &err);
        detail::check_edge_cases(err);
        return Vault(result);
    }

    std::optional<Widget> peek() const {
        weaveffi_error err{};
        auto result = weaveffi_edge_cases_Vault_peek(static_cast<const weaveffi_edge_cases_Vault*>(handle_), &err);
        detail::check(err);
        if (!result) return std::nullopt;
        return Widget(result);
    }

    /** Throwing static */
    static bool probe() {
        weaveffi_error err{};
        auto result = weaveffi_edge_cases_Vault_probe(&err);
        detail::check_edge_cases(err);
        return result;
    }

};

namespace edge_cases {

/** @return A subscription id for unregister_batch_listener(). */
inline uint64_t register_batch_listener(std::function<void(std::vector<Outer>, std::vector<uint8_t>, std::optional<Outer>, Mode)> callback) {
    auto fn = std::make_shared<std::function<void(std::vector<Outer>, std::vector<uint8_t>, std::optional<Outer>, Mode)>>(std::move(callback));
    uint64_t id = weaveffi_edge_cases_register_batch_listener(
        [](const uint8_t* items_ptr, size_t items_len, const uint8_t* raw_ptr, size_t raw_len, const uint8_t* first_ptr, size_t first_len, weaveffi_edge_cases_Mode mode, void* context) {
            auto& cb = *static_cast<std::function<void(std::vector<Outer>, std::vector<uint8_t>, std::optional<Outer>, Mode)>*>(context);
            std::vector<Outer> items_val{};
            if (items_ptr != nullptr) {
                detail::BufferReader items_r(items_ptr, items_len);
                {
                    size_t items_val_n = items_r.read_len();
                    items_val.reserve(items_val_n);
                    for (size_t items_val_i = 0; items_val_i < items_val_n; ++items_val_i) {
                        Outer items_val_item = detail::read_Outer(items_r);
                        items_val.push_back(std::move(items_val_item));
                    }
                }
                items_r.expect_end();
            }
            std::optional<Outer> first_val{};
            if (first_ptr != nullptr) {
                detail::BufferReader first_r(first_ptr, first_len);
                if (first_r.read_option_flag()) {
                    Outer first_val_v = detail::read_Outer(first_r);
                    first_val = std::move(first_val_v);
                }
                first_r.expect_end();
            }
            cb(std::move(items_val), raw_ptr ? std::vector<uint8_t>(raw_ptr, raw_ptr + raw_len) : std::vector<uint8_t>{}, std::move(first_val), static_cast<Mode>(static_cast<int32_t>(mode)));
        },
        fn.get());
    std::lock_guard<std::mutex> lock(detail::wv_listener_mutex());
    detail::wv_listener_registry()[id] = fn;
    return id;
}

/** Unregisters a listener previously registered with register_batch_listener(). */
inline void unregister_batch_listener(uint64_t id) {
    weaveffi_edge_cases_unregister_batch_listener(id);
    std::lock_guard<std::mutex> lock(detail::wv_listener_mutex());
    detail::wv_listener_registry().erase(id);
}

/** @return A subscription id for unregister_tick_listener(). */
inline uint64_t register_tick_listener(std::function<void()> callback) {
    auto fn = std::make_shared<std::function<void()>>(std::move(callback));
    uint64_t id = weaveffi_edge_cases_register_tick_listener(
        [](void* context) {
            auto& cb = *static_cast<std::function<void()>*>(context);
            cb();
        },
        fn.get());
    std::lock_guard<std::mutex> lock(detail::wv_listener_mutex());
    detail::wv_listener_registry()[id] = fn;
    return id;
}

/** Unregisters a listener previously registered with register_tick_listener(). */
inline void unregister_tick_listener(uint64_t id) {
    weaveffi_edge_cases_unregister_tick_listener(id);
    std::lock_guard<std::mutex> lock(detail::wv_listener_mutex());
    detail::wv_listener_registry().erase(id);
}

/** No parameters and no result */
inline void noop() {
    weaveffi_error err{};
    weaveffi_edge_cases_noop(&err);
    detail::check(err);
}

/** Function named after a keyword whose parameters are all keywords */
inline int32_t select(int32_t class_, const std::string& from, const std::vector<std::string>& func, const std::optional<int32_t>& range, bool type_) {
    detail::BufferWriter func_buf;
    func_buf.write_len(func.size());
    for (const auto& item0 : func) {
        func_buf.write_string(item0);
    }
    detail::BufferWriter range_buf;
    range_buf.write_option_flag(range.has_value());
    if (range.has_value()) {
        range_buf.write_i32((*range));
    }
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_select(class_, from.c_str(), func_buf.data(), func_buf.size(), range_buf.data(), range_buf.size(), type_, &err);
    detail::check(err);
    return result;
}

/** Optional list of optional structs, the deepest legal nesting */
inline std::optional<std::vector<std::optional<Outer>>> nested_optional(const std::optional<std::vector<std::optional<Outer>>>& items) {
    detail::BufferWriter items_buf;
    items_buf.write_option_flag(items.has_value());
    if (items.has_value()) {
        items_buf.write_len((*items).size());
        for (const auto& item0 : (*items)) {
            items_buf.write_option_flag(item0.has_value());
            if (item0.has_value()) {
                detail::write_Outer(items_buf, (*item0));
            }
        }
    }
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_nested_optional(items_buf.data(), items_buf.size(), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    std::optional<std::vector<std::optional<Outer>>> ret{};
    if (result_r.read_option_flag()) {
        std::vector<std::optional<Outer>> ret_v{};
        {
            size_t ret_v_n = result_r.read_len();
            ret_v.reserve(ret_v_n);
            for (size_t ret_v_i = 0; ret_v_i < ret_v_n; ++ret_v_i) {
                std::optional<Outer> ret_v_item{};
                if (result_r.read_option_flag()) {
                    Outer ret_v_item_v = detail::read_Outer(result_r);
                    ret_v_item = std::move(ret_v_item_v);
                }
                ret_v.push_back(std::move(ret_v_item));
            }
        }
        ret = std::move(ret_v);
    }
    result_r.expect_end();
    return ret;
}

inline std::optional<Mode> optional_params(const std::optional<std::string>& text, const std::optional<int32_t>& count, const std::optional<Outer>& outer, const std::optional<std::vector<std::string>>& tags, const std::optional<std::vector<uint8_t>>& blob, const std::optional<Mode>& mode) {
    detail::BufferWriter text_buf;
    text_buf.write_option_flag(text.has_value());
    if (text.has_value()) {
        text_buf.write_string((*text));
    }
    detail::BufferWriter count_buf;
    count_buf.write_option_flag(count.has_value());
    if (count.has_value()) {
        count_buf.write_i32((*count));
    }
    detail::BufferWriter outer_buf;
    outer_buf.write_option_flag(outer.has_value());
    if (outer.has_value()) {
        detail::write_Outer(outer_buf, (*outer));
    }
    detail::BufferWriter tags_buf;
    tags_buf.write_option_flag(tags.has_value());
    if (tags.has_value()) {
        tags_buf.write_len((*tags).size());
        for (const auto& item0 : (*tags)) {
            tags_buf.write_string(item0);
        }
    }
    detail::BufferWriter blob_buf;
    blob_buf.write_option_flag(blob.has_value());
    if (blob.has_value()) {
        blob_buf.write_bytes((*blob));
    }
    detail::BufferWriter mode_buf;
    mode_buf.write_option_flag(mode.has_value());
    if (mode.has_value()) {
        mode_buf.write_i32(static_cast<int32_t>((*mode)));
    }
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_optional_params(text_buf.data(), text_buf.size(), count_buf.data(), count_buf.size(), outer_buf.data(), outer_buf.size(), tags_buf.data(), tags_buf.size(), blob_buf.data(), blob_buf.size(), mode_buf.data(), mode_buf.size(), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    std::optional<Mode> ret{};
    if (result_r.read_option_flag()) {
        Mode ret_v = static_cast<Mode>(result_r.read_i32());
        ret = std::move(ret_v);
    }
    result_r.expect_end();
    return ret;
}

/** Write-back parameters */
inline void mutable_params(std::string& text, std::vector<uint8_t>& blob) {
    weaveffi_error err{};
    weaveffi_edge_cases_mutable_params(text.data(), blob.data(), blob.size(), &err);
    detail::check(err);
}

