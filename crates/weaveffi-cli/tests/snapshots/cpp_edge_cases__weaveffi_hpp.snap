/** Encodes a `WidgetHolder` in the WeaveFFI value-buffer format. */
inline void write_WidgetHolder(BufferWriter& w, const WidgetHolder& v) {
    w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(v.primary.clone_handle())));
    w.write_option_flag(v.fallback.has_value());
    if (v.fallback.has_value()) {
        w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>((*v.fallback).clone_handle())));
    }
    w.write_len(v.extras.size());
    for (const auto& item0 : v.extras) {
        w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(item0.clone_handle())));
    }
    w.write_len(v.by_name.size());
    for (const auto& kv0 : v.by_name) {
        w.write_string(kv0.first);
        w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(kv0.second.clone_handle())));
    }
}

