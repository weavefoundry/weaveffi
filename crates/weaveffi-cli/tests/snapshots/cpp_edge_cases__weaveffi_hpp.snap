    out.when = r.read_i32();
    out.fun = r.read_i32();
    out.data = r.read_i32();
    out.late = r.read_i32();
    out.part = r.read_i32();
    out.out = r.read_i32();
    out.ref = r.read_i32();
    out.event = r.read_i32();
    out.base = r.read_i32();
    out.lambda = r.read_i32();
