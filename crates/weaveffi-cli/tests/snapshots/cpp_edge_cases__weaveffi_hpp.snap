    out.namespace_ = r.read_i32();
    out.operator_ = r.read_i32();
    out.template_ = r.read_i32();
    out.package = r.read_i32();
    out.protocol = r.read_i32();
    out.guard = r.read_i32();
    out.defer = r.read_i32();
    out.inout = r.read_i32();
