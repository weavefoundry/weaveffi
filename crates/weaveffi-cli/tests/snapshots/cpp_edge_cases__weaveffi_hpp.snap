}

/** Function named after a keyword whose parameters are all keywords */
inline int32_t select(int32_t class_, const std::string& from, const std::vector<std::string>& func, const std::optional<int32_t>& range, bool type_) {
    detail::BufferWriter func_buf;
    func_buf.write_len(func.size());
    for (const auto& item0 : func) {
        func_buf.write_string(item0);
    }
    detail::BufferWriter range_buf;
    range_buf.write_option_flag(range.has_value());
    if (range.has_value()) {
        range_buf.write_i32((*range));
    }
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_select(class_, from.c_str(), func_buf.data(), func_buf.size(), range_buf.data(), range_buf.size(), type_, &err);
    detail::check(err);
    return result;
}

/** Optional list of optional structs, the deepest legal nesting */
inline std::optional<std::vector<std::optional<Outer>>> nested_optional(const std::optional<std::vector<std::optional<Outer>>>& items) {
    detail::BufferWriter items_buf;
    items_buf.write_option_flag(items.has_value());
    if (items.has_value()) {
        items_buf.write_len((*items).size());
        for (const auto& item0 : (*items)) {
            items_buf.write_option_flag(item0.has_value());
            if (item0.has_value()) {
                detail::write_Outer(items_buf, (*item0));
            }
        }
    }
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_nested_optional(items_buf.data(), items_buf.size(), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    std::optional<std::vector<std::optional<Outer>>> ret{};
    if (result_r.read_option_flag()) {
        std::vector<std::optional<Outer>> ret_v{};
        {
            size_t ret_v_n = result_r.read_len();
            ret_v.reserve(ret_v_n);
            for (size_t ret_v_i = 0; ret_v_i < ret_v_n; ++ret_v_i) {
                std::optional<Outer> ret_v_item{};
                if (result_r.read_option_flag()) {
                    Outer ret_v_item_v = detail::read_Outer(result_r);
                    ret_v_item = std::move(ret_v_item_v);
                }
                ret_v.push_back(std::move(ret_v_item));
            }
        }
        ret = std::move(ret_v);
    }
    result_r.expect_end();
    return ret;
}

inline std::optional<Mode> optional_params(const std::optional<std::string>& text, const std::optional<int32_t>& count, const std::optional<Outer>& outer, const std::optional<std::vector<std::string>>& tags, const std::optional<std::vector<uint8_t>>& blob, const std::optional<Mode>& mode) {
    detail::BufferWriter text_buf;
    text_buf.write_option_flag(text.has_value());
    if (text.has_value()) {
        text_buf.write_string((*text));
    }
    detail::BufferWriter count_buf;
    count_buf.write_option_flag(count.has_value());
    if (count.has_value()) {
        count_buf.write_i32((*count));
    }
    detail::BufferWriter outer_buf;
    outer_buf.write_option_flag(outer.has_value());
    if (outer.has_value()) {
        detail::write_Outer(outer_buf, (*outer));
    }
    detail::BufferWriter tags_buf;
    tags_buf.write_option_flag(tags.has_value());
    if (tags.has_value()) {
        tags_buf.write_len((*tags).size());
        for (const auto& item0 : (*tags)) {
            tags_buf.write_string(item0);
        }
    }
    detail::BufferWriter blob_buf;
    blob_buf.write_option_flag(blob.has_value());
    if (blob.has_value()) {
        blob_buf.write_bytes((*blob));
    }
    detail::BufferWriter mode_buf;
    mode_buf.write_option_flag(mode.has_value());
    if (mode.has_value()) {
        mode_buf.write_i32(static_cast<int32_t>((*mode)));
    }
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_optional_params(text_buf.data(), text_buf.size(), count_buf.data(), count_buf.size(), outer_buf.data(), outer_buf.size(), tags_buf.data(), tags_buf.size(), blob_buf.data(), blob_buf.size(), mode_buf.data(), mode_buf.size(), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    std::optional<Mode> ret{};
    if (result_r.read_option_flag()) {
        Mode ret_v = static_cast<Mode>(result_r.read_i32());
        ret = std::move(ret_v);
    }
    result_r.expect_end();
    return ret;
}

/** Two callback interface parameters on one function */
inline void register_batch(std::shared_ptr<BatchListener> listener, std::shared_ptr<Keyword> keyword) {
    if (!listener) throw std::invalid_argument("listener: null callback interface");
    auto* listener_ctx = new std::shared_ptr<BatchListener>(std::move(listener));
    if (!keyword) throw std::invalid_argument("keyword: null callback interface");
    auto* keyword_ctx = new std::shared_ptr<Keyword>(std::move(keyword));
    weaveffi_error err{};
    weaveffi_edge_cases_register_batch(static_cast<void*>(listener_ctx), &detail::BatchListener_vtable(), static_cast<void*>(keyword_ctx), &detail::Keyword_vtable(), &err);
    detail::check(err);
}

/** Objects in every buffered position */
inline WidgetHolder widgets_everywhere(const std::vector<Widget>& list, const std::unordered_map<std::string, Widget>& by_name, const std::vector<std::optional<Widget>>& sparse, const WidgetHolder& holder) {
    detail::BufferWriter list_buf;
    list_buf.write_len(list.size());
    for (const auto& item0 : list) {
        list_buf.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(item0.clone_handle())));
    }
    detail::BufferWriter by_name_buf;
    by_name_buf.write_len(by_name.size());
    for (const auto& kv0 : by_name) {
        by_name_buf.write_string(kv0.first);
        by_name_buf.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(kv0.second.clone_handle())));
    }
    detail::BufferWriter sparse_buf;
    sparse_buf.write_len(sparse.size());
    for (const auto& item0 : sparse) {
        sparse_buf.write_option_flag(item0.has_value());
        if (item0.has_value()) {
            sparse_buf.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>((*item0).clone_handle())));
        }
    }
    detail::BufferWriter holder_buf;
    detail::write_WidgetHolder(holder_buf, holder);
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_widgets_everywhere(list_buf.data(), list_buf.size(), by_name_buf.data(), by_name_buf.size(), sparse_buf.data(), sparse_buf.size(), holder_buf.data(), holder_buf.size(), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    WidgetHolder ret = detail::read_WidgetHolder(result_r);
    result_r.expect_end();
    return ret;
}

/**
 * A lazy, move-only range over the `Widget` elements produced by `widget_stream()`.
 *
 * Each iteration step pulls exactly one element from the producer, so results stream in constant memory. The range owns the producer-side iterator and releases it exactly once: eagerly when the range is exhausted, or from the destructor when iteration is abandoned early.
 */
class WidgetStreamIterator {
    weaveffi_edge_cases_WidgetStreamIterator* handle_;

public:
    /** Adopts ownership of the raw producer iterator. */
    explicit WidgetStreamIterator(weaveffi_edge_cases_WidgetStreamIterator* h) : handle_(h) {}

    ~WidgetStreamIterator() {
        if (handle_) weaveffi_edge_cases_WidgetStreamIterator_destroy(handle_);
    }

    WidgetStreamIterator(const WidgetStreamIterator&) = delete;
    WidgetStreamIterator& operator=(const WidgetStreamIterator&) = delete;

    WidgetStreamIterator(WidgetStreamIterator&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    WidgetStreamIterator& operator=(WidgetStreamIterator&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_edge_cases_WidgetStreamIterator_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** Pulls the next element from the producer, or `std::nullopt` once exhausted (which releases the producer iterator eagerly). A producer error throws the generic WeaveFFIError after releasing the iterator. */
    std::optional<Widget> next() {
        if (!handle_) return std::nullopt;
        weaveffi_error err{};
        weaveffi_edge_cases_Widget* item{};
        int32_t has_item = weaveffi_edge_cases_WidgetStreamIterator_next(handle_, &item, &err);
        if (err.code != 0) {
            weaveffi_edge_cases_WidgetStreamIterator_destroy(handle_);
            handle_ = nullptr;
            detail::check(err);
        }
        if (has_item == 0) {
            weaveffi_edge_cases_WidgetStreamIterator_destroy(handle_);
            handle_ = nullptr;
            return std::nullopt;
        }
        return Widget(item);
    }

    /** Sentinel type marking the end of the range. */
    struct sentinel {};

    /** Single-pass input iterator; each increment pulls one element from the producer. */
    class iterator {
        WidgetStreamIterator* range_;
        std::optional<Widget> current_;

    public:
        using iterator_category = std::input_iterator_tag;
        using value_type = Widget;
        using difference_type = std::ptrdiff_t;
        using pointer = Widget*;
        using reference = Widget&;

        /** Binds to `range` and pulls the first element. */
        explicit iterator(WidgetStreamIterator* range) : range_(range), current_(range->next()) {}
        reference operator*() { return *current_; }
        pointer operator->() { return &*current_; }
        iterator& operator++() { current_ = range_->next(); return *this; }
        void operator++(int) { current_ = range_->next(); }
        bool operator==(sentinel) const { return !current_.has_value(); }
        bool operator!=(sentinel) const { return current_.has_value(); }
    };

    /** Begins iteration by pulling the first element. */
    iterator begin() { return iterator(this); }

    /** The past-the-end sentinel. */
    sentinel end() const { return sentinel{}; }
};

/**
 * Iterator of objects
 *
 * @return A lazy `WidgetStreamIterator` range that streams one element per iteration step and releases the producer iterator when exhausted or destroyed.
 */
inline WidgetStreamIterator widget_stream() {
    weaveffi_error err{};
    weaveffi_edge_cases_WidgetStreamIterator* iter = weaveffi_edge_cases_widget_stream(&err);
    detail::check(err);
    return WidgetStreamIterator(iter);
}

/** Async returning an object */
inline std::future<Widget> async_widget() {
    auto* promise_ptr = new std::promise<Widget>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_async_widget_async([](void* context, weaveffi_error* err, weaveffi_edge_cases_Widget* result) {
        auto* p = static_cast<std::promise<Widget>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_edge_cases_error(err->code, msg, err->payload_ptr, err->payload_len));
            } else {
                p->set_value(Widget(result));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

