inline std::string Widget::rename(const std::string& class_, const std::optional<std::string>& import) const {
    detail::BufferWriter import_buf;
    import_buf.write_option_flag(import.has_value());
    if (import.has_value()) {
        import_buf.write_string((*import));
    }
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_Widget_rename(handle_, class_.c_str(), import_buf.data(), import_buf.size(), &err);
    detail::check(err);
    std::string ret(result);
    weaveffi_free_string(result);
    return ret;
}

inline std::future<Outer> Widget::fetch(int64_t id) const {
    auto* promise_ptr = new std::promise<Outer>();
    auto future = promise_ptr->get_future();
    weaveffi_edge_cases_Widget_fetch_async(handle_, id, [](void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len) {
        auto* p = static_cast<std::promise<Outer>*>(context);
        try {
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_edge_cases_error(err->code, msg, err->payload_ptr, err->payload_len));
            } else {
                detail::BufferGuard result_guard{result_ptr, result_len};
                detail::BufferReader result_r(result_ptr, result_len);
                Outer value = detail::read_Outer(result_r);
                result_r.expect_end();
                p->set_value(std::move(value));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        weaveffi_error_free(err);
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

