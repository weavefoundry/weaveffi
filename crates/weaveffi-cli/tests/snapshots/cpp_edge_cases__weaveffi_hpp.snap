        f_sparse.reserve(f_sparse_n);
        for (size_t f_sparse_i = 0; f_sparse_i < f_sparse_n; ++f_sparse_i) {
            std::optional<int64_t> f_sparse_item{};
            if (r.read_option_flag()) {
