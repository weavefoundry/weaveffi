    static int32_t import(void* ctx, weaveffi_error* out_err) {
        try {
            Keyword& impl = **static_cast<std::shared_ptr<Keyword>*>(ctx);
            return impl.import();
        } catch (const std::exception& e) {
            weaveffi_error_set(out_err, -4, e.what());
        } catch (...) {
            weaveffi_error_set(out_err, -4, "Keyword::import threw a non-standard exception");
        }
        return int32_t{};
    }

    /** Releases the implementation box once the producer drops its last reference. */
    static void free_ctx(void* ctx) {
        delete static_cast<std::shared_ptr<Keyword>*>(ctx);
    }
};

/** The process-wide vtable every `Keyword` implementation is passed with. */
inline const weaveffi_edge_cases_Keyword_vtable& Keyword_vtable() {
