/** Interface parameter, including an optional one */
inline std::string inspect_widget(const Widget& widget, const std::optional<Widget>& fallback) {
    weaveffi_error err{};
    auto result = weaveffi_edge_cases_inspect_widget(widget.handle(), fallback.has_value() ? fallback->handle() : nullptr, &err);
    detail::check(err);
    std::string ret(result);
    weaveffi_free_string(result);
    return ret;
}

/**
 * A lazy, move-only range over the `std::string` elements produced by `string_stream()`.
 *
 * Each iteration step pulls exactly one element from the producer, so results stream in constant memory. The range owns the producer-side iterator and releases it exactly once: eagerly when the range is exhausted, or from the destructor when iteration is abandoned early.
 */
class StringStreamIterator {
    weaveffi_edge_cases_StringStreamIterator* handle_;

public:
    /** Adopts ownership of the raw producer iterator. */
    explicit StringStreamIterator(weaveffi_edge_cases_StringStreamIterator* h) : handle_(h) {}

    ~StringStreamIterator() {
        if (handle_) weaveffi_edge_cases_StringStreamIterator_destroy(handle_);
    }

    StringStreamIterator(const StringStreamIterator&) = delete;
    StringStreamIterator& operator=(const StringStreamIterator&) = delete;

    StringStreamIterator(StringStreamIterator&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    StringStreamIterator& operator=(StringStreamIterator&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_edge_cases_StringStreamIterator_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** Pulls the next element from the producer, or `std::nullopt` once exhausted (which releases the producer iterator eagerly). A producer error throws the generic WeaveFFIError after releasing the iterator. */
    std::optional<std::string> next() {
        if (!handle_) return std::nullopt;
        weaveffi_error err{};
        const char* item{};
        int32_t has_item = weaveffi_edge_cases_StringStreamIterator_next(handle_, &item, &err);
        if (err.code != 0) {
            weaveffi_edge_cases_StringStreamIterator_destroy(handle_);
            handle_ = nullptr;
            detail::check(err);
        }
        if (has_item == 0) {
            weaveffi_edge_cases_StringStreamIterator_destroy(handle_);
            handle_ = nullptr;
            return std::nullopt;
        }
        std::string value(item);
        weaveffi_free_string(item);
        return value;
    }

    /** Sentinel type marking the end of the range. */
    struct sentinel {};

    /** Single-pass input iterator; each increment pulls one element from the producer. */
    class iterator {
        StringStreamIterator* range_;
        std::optional<std::string> current_;

    public:
        using iterator_category = std::input_iterator_tag;
        using value_type = std::string;
        using difference_type = std::ptrdiff_t;
        using pointer = std::string*;
        using reference = std::string&;

        /** Binds to `range` and pulls the first element. */
        explicit iterator(StringStreamIterator* range) : range_(range), current_(range->next()) {}
        reference operator*() { return *current_; }
        pointer operator->() { return &*current_; }
        iterator& operator++() { current_ = range_->next(); return *this; }
        void operator++(int) { current_ = range_->next(); }
        bool operator==(sentinel) const { return !current_.has_value(); }
        bool operator!=(sentinel) const { return current_.has_value(); }
    };

    /** Begins iteration by pulling the first element. */
    iterator begin() { return iterator(this); }

    /** The past-the-end sentinel. */
    sentinel end() const { return sentinel{}; }
};

/**
 * Iterator of strings
 *
 * @return A lazy `StringStreamIterator` range that streams one element per iteration step and releases the producer iterator when exhausted or destroyed.
 */
inline StringStreamIterator string_stream() {
    weaveffi_error err{};
    weaveffi_edge_cases_StringStreamIterator* iter = weaveffi_edge_cases_string_stream(&err);
    detail::check(err);
    return StringStreamIterator(iter);
}

