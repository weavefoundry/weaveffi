// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

import CWeaveFFI
import Foundation

public enum WeaveFFIError: Error, LocalizedError {
    case error(code: Int32, message: String)
    public var errorDescription: String? {
        switch self {
        case let .error(_, message): return message
        }
    }
    public var errorCode: Int32 {
        switch self {
        case let .error(code, _): return code
        }
    }
}

@inline(__always)
func check(_ err: inout weaveffi_error) throws {
    if err.code != 0 {
        let code = err.code
        let message = err.message.flatMap { String(cString: $0) } ?? ""
        weaveffi_error_clear(&err)
        throw WeaveFFIError.error(code: code, message: message)
    }
}

@inline(__always)
func trap(_ err: inout weaveffi_error) {
    if err.code != 0 {
        let code = err.code
        let message = err.message.flatMap { String(cString: $0) } ?? ""
        weaveffi_error_clear(&err)
        fatalError("\(code): \(message)")
    }
}

/// Serializes values into the WeaveFFI value-buffer wire format
/// (little-endian, packed, no alignment).
struct WvWriter {
    var bytes: [UInt8] = []

    mutating func writeBool(_ v: Bool) { bytes.append(v ? 1 : 0) }
    mutating func writeInt8(_ v: Int8) { bytes.append(UInt8(bitPattern: v)) }
    mutating func writeUInt8(_ v: UInt8) { bytes.append(v) }
    mutating func writeUInt16(_ v: UInt16) {
        bytes.append(UInt8(truncatingIfNeeded: v))
        bytes.append(UInt8(truncatingIfNeeded: v >> 8))
    }
    mutating func writeInt16(_ v: Int16) { writeUInt16(UInt16(bitPattern: v)) }
    mutating func writeUInt32(_ v: UInt32) {
        bytes.append(UInt8(truncatingIfNeeded: v))
        bytes.append(UInt8(truncatingIfNeeded: v >> 8))
        bytes.append(UInt8(truncatingIfNeeded: v >> 16))
        bytes.append(UInt8(truncatingIfNeeded: v >> 24))
    }
    mutating func writeInt32(_ v: Int32) { writeUInt32(UInt32(bitPattern: v)) }
    mutating func writeUInt64(_ v: UInt64) {
        writeUInt32(UInt32(truncatingIfNeeded: v))
        writeUInt32(UInt32(truncatingIfNeeded: v >> 32))
    }
    mutating func writeInt64(_ v: Int64) { writeUInt64(UInt64(bitPattern: v)) }
    mutating func writeFloat(_ v: Float) { writeUInt32(v.bitPattern) }
    mutating func writeDouble(_ v: Double) { writeUInt64(v.bitPattern) }
    mutating func writeLen(_ n: Int) {
        precondition(n >= 0 && n <= Int(UInt32.max), "WeaveFFI buffer length exceeds UInt32.max")
        writeUInt32(UInt32(n))
    }
    mutating func writeString(_ v: String) {
        let utf8 = Array(v.utf8)
        writeLen(utf8.count)
        bytes.append(contentsOf: utf8)
    }
    mutating func writeBytes(_ v: Data) {
        writeLen(v.count)
        bytes.append(contentsOf: v)
    }
    mutating func writeOptionFlag(_ present: Bool) { bytes.append(present ? 1 : 0) }
}

/// Traps on a malformed value buffer. Per the wire-format spec, consumers
/// surface decode failures through the same channel as a producer panic.
func wvDecodeFailure(_ context: String) -> Never {
    fatalError("malformed WeaveFFI value buffer: \(context)")
}

/// Deserializes values from the WeaveFFI value-buffer wire format, rejecting
/// truncated buffers, invalid flag bytes, oversized length prefixes, and
/// trailing bytes.
struct WvReader {
    let bytes: [UInt8]
    var pos: Int = 0

    init(bytes: [UInt8]) { self.bytes = bytes }

    var remaining: Int { bytes.count - pos }

    mutating func take(_ n: Int, _ context: String) -> ArraySlice<UInt8> {
        guard remaining >= n else { wvDecodeFailure(context) }
        defer { pos += n }
        return bytes[pos..<(pos + n)]
    }

    mutating func readBool() -> Bool {
        switch take(1, "bool").first! {
        case 0: return false
        case 1: return true
        default: wvDecodeFailure("bool byte out of range")
        }
    }
    mutating func readUInt8() -> UInt8 { take(1, "u8").first! }
    mutating func readInt8() -> Int8 { Int8(bitPattern: readUInt8()) }
    mutating func readUInt16() -> UInt16 {
        var v: UInt16 = 0
        for (i, b) in take(2, "u16").enumerated() { v |= UInt16(b) << (8 * i) }
        return v
    }
    mutating func readInt16() -> Int16 { Int16(bitPattern: readUInt16()) }
    mutating func readUInt32() -> UInt32 {
        var v: UInt32 = 0
        for (i, b) in take(4, "u32").enumerated() { v |= UInt32(b) << (8 * i) }
        return v
    }
    mutating func readInt32() -> Int32 { Int32(bitPattern: readUInt32()) }
    mutating func readUInt64() -> UInt64 {
        var v: UInt64 = 0
        for (i, b) in take(8, "u64").enumerated() { v |= UInt64(b) << (8 * i) }
        return v
    }
    mutating func readInt64() -> Int64 { Int64(bitPattern: readUInt64()) }
    mutating func readFloat() -> Float { Float(bitPattern: readUInt32()) }
    mutating func readDouble() -> Double { Double(bitPattern: readUInt64()) }
    mutating func readLen() -> Int {
        let n = Int(readUInt32())
        guard n <= remaining else { wvDecodeFailure("length prefix exceeds remaining buffer") }
        return n
    }
    mutating func readString() -> String {
        let n = readLen()
        guard let s = String(bytes: take(n, "string bytes"), encoding: .utf8) else {
            wvDecodeFailure("string is not valid UTF-8")
        }
        return s
    }
    mutating func readBytes() -> Data {
        let n = readLen()
        return Data(take(n, "byte buffer"))
    }
    mutating func readOptionFlag() -> Bool {
        switch take(1, "option flag").first! {
        case 0: return false
        case 1: return true
        default: wvDecodeFailure("option flag byte out of range")
        }
    }
    func finish() {
        if remaining != 0 { wvDecodeFailure("trailing bytes after value") }
    }
}

/// An algebraic shape (sum type with associated data)
public enum Shape {
    /// The empty shape (a unit variant)
    case empty
    /// A circle with a radius
    case circle(radius: Double)
    /// An axis-aligned rectangle
    case rectangle(width: Float, height: Float)
    /// An integer-bounded shape (exercises narrow + wide ints)
    case bounded(min: Int16, max: Int16, weight: UInt64)
    /// A labeled shape with a small count
    case labeled(label: String, count: UInt8)
}

/// Serializes a `Shape` into the value-buffer wire format.
func wvWriteShape(_ value: Shape, into w: inout WvWriter) {
    switch value {
    case .empty:
        w.writeInt32(0)
    case let .circle(v0):
        w.writeInt32(1)
        w.writeDouble(v0)
    case let .rectangle(v1, v2):
        w.writeInt32(2)
        w.writeFloat(v1)
        w.writeFloat(v2)
    case let .bounded(v3, v4, v5):
        w.writeInt32(3)
        w.writeInt16(v3)
        w.writeInt16(v4)
        w.writeUInt64(v5)
    case let .labeled(v6, v7):
        w.writeInt32(4)
        w.writeString(v6)
        w.writeUInt8(v7)
    }
}

/// Deserializes a `Shape` from the value-buffer wire format.
func wvReadShape(_ r: inout WvReader) -> Shape {
    let tag = r.readInt32()
    switch tag {
    case 0:
        return .empty
    case 1:
        let v8 = r.readDouble()
        return .circle(radius: v8)
    case 2:
        let v9 = r.readFloat()
        let v10 = r.readFloat()
        return .rectangle(width: v9, height: v10)
    case 3:
        let v11 = r.readInt16()
        let v12 = r.readInt16()
        let v13 = r.readUInt64()
        return .bounded(min: v11, max: v12, weight: v13)
    case 4:
        let v14 = r.readString()
        let v15 = r.readUInt8()
        return .labeled(label: v14, count: v15)
    default:
        wvDecodeFailure("unknown Shape tag \(tag)")
    }
}

/// A plain C-style enum (no payloads)
public enum Channel: UInt32 {
    case red = 0
    case green = 1
    case blue = 2
}

/// One field per supported numeric primitive
public struct Numerics {
    public var a: Int8
    public var b: Int16
    public var c: Int32
    public var d: Int64
    public var e: UInt8
    public var f: UInt16
    public var g: UInt32
    public var h: UInt64
    public var i: Float
    public var j: Double

    /// Creates a `Numerics` value.
    public init(a: Int8, b: Int16, c: Int32, d: Int64, e: UInt8, f: UInt16, g: UInt32, h: UInt64, i: Float, j: Double) {
        self.a = a
        self.b = b
        self.c = c
        self.d = d
        self.e = e
        self.f = f
        self.g = g
        self.h = h
        self.i = i
        self.j = j
    }
}

/// Serializes a `Numerics` into the value-buffer wire format.
func wvWriteNumerics(_ value: Numerics, into w: inout WvWriter) {
    w.writeInt8(value.a)
    w.writeInt16(value.b)
    w.writeInt32(value.c)
    w.writeInt64(value.d)
    w.writeUInt8(value.e)
    w.writeUInt16(value.f)
    w.writeUInt32(value.g)
    w.writeUInt64(value.h)
    w.writeFloat(value.i)
    w.writeDouble(value.j)
}

/// Deserializes a `Numerics` from the value-buffer wire format.
func wvReadNumerics(_ r: inout WvReader) -> Numerics {
    let v0 = r.readInt8()
    let v1 = r.readInt16()
    let v2 = r.readInt32()
    let v3 = r.readInt64()
    let v4 = r.readUInt8()
    let v5 = r.readUInt16()
    let v6 = r.readUInt32()
    let v7 = r.readUInt64()
    let v8 = r.readFloat()
    let v9 = r.readDouble()
    return Numerics(a: v0, b: v1, c: v2, d: v3, e: v4, f: v5, g: v6, h: v7, i: v8, j: v9)
}

public enum Shapes {
    /// Render a shape to a string
    public static func describe(shape: Shape) -> String {
        var err = weaveffi_error(code: 0, message: nil, payload_ptr: nil, payload_len: 0)
        var shapeWriter = WvWriter()
        wvWriteShape(shape, into: &shapeWriter)
        let rv: UnsafePointer<CChar>? = shapeWriter.bytes.withUnsafeBufferPointer { shape_buf in
            let shape_ptr = shape_buf.baseAddress
            let shape_len = shape_buf.count
            return weaveffi_shapes_describe(shape_ptr, shape_len, &err)
        }
        trap(&err)
        guard let rv = rv else { fatalError("-1: null string") }
        defer { weaveffi_free_string(rv) }
        return String(cString: rv)
