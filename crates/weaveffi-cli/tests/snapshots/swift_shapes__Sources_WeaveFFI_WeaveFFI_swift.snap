            let shape_ptr = shape_buf.baseAddress
            let shape_len = shape_buf.count
            return weaveffi_shapes_scale(shape_ptr, shape_len, factor, &outLen, &err)
        }
        trap(&err)
        guard let rv = rv else { fatalError("-1: null buffer") }
        let rvBytes = [UInt8](UnsafeBufferPointer(start: rv, count: outLen))
        weaveffi_free_bytes(UnsafeMutablePointer(mutating: rv), outLen)
        var rvReader = WvReader(bytes: rvBytes)
        let v0 = wvReadShape(&rvReader)
        rvReader.finish()
        return v0
    }
    /// Sum a list of bytes into a wide integer (numerics smoke)
    public static func sumBytes(values: Data) -> UInt64 {
        var err = weaveffi_error(code: 0, message: nil, payload_ptr: nil, payload_len: 0)
        let valuesBytes = Array(values)
        let rv: UInt64 = valuesBytes.withUnsafeBufferPointer { values_buf in
            let values_ptr = values_buf.baseAddress
            let values_len = values_buf.count
            return weaveffi_shapes_sum_bytes(values_ptr, values_len, &err)
        }
        trap(&err)
        return rv
    }
    /// Build a Numerics struct from every numeric primitive
    public static func makeNumerics(a: Int8, b: Int16, c: Int32, d: Int64, e: UInt8, f: UInt16, g: UInt32, h: UInt64, i: Float, j: Double) -> Numerics {
        var err = weaveffi_error(code: 0, message: nil, payload_ptr: nil, payload_len: 0)
        var outLen: Int = 0
        let rv = weaveffi_shapes_make_numerics(a, b, c, d, e, f, g, h, i, j, &outLen, &err)
        trap(&err)
        guard let rv = rv else { fatalError("-1: null buffer") }
        let rvBytes = [UInt8](UnsafeBufferPointer(start: rv, count: outLen))
        weaveffi_free_bytes(UnsafeMutablePointer(mutating: rv), outLen)
        var rvReader = WvReader(bytes: rvBytes)
        let v0 = wvReadNumerics(&rvReader)
        rvReader.finish()
        return v0
    }
