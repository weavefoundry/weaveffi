// Growable little-endian byte writer implementing the WeaveFFI value-buffer
// wire format: values are packed back to back with no alignment; lengths and
// counts are u32; strings are u32 byte length + UTF-8 bytes (no NUL).
class _BufWriter {
  constructor() {
