/** Base error for WeaveFFI failures: domain errors extend it, and it is
 * thrown directly for unknown codes, marshalling failures, and producer
 * panics. Carries the stable ABI `code`. */
export class WeaveFFIError extends Error {
  constructor(code, message) {
    super(message ? `WeaveFFI error ${code}: ${message}` : `WeaveFFI error ${code}`);
    this.name = new.target.name;
    this.code = code;
  }
}

/** Base error for the `tasks` module's error domain. */
export class TaskError extends WeaveFFIError {}

// task name must not be empty
export class InvalidName extends TaskError {
  constructor(message = "task name must not be empty") {
    super(1, message);
  }
}
InvalidName.CODE = 1;
TaskError.InvalidName = InvalidName;

const _TASK_ERROR_CODES = Object.freeze({
  1: InvalidName,
});

// Build the TaskError subclass matching `code`, or a generic
// WeaveFFIError for codes outside the domain (panics, marshalling).
function _taskErrorFrom(wasm, code, message, payloadPtr, payloadLen) {
  const _cls = _TASK_ERROR_CODES[code];
  const _e = _cls ? (message ? new _cls(message) : new _cls()) : new WeaveFFIError(code, message);
  return _e;
}

const _enc = new TextEncoder();
const _dec = new TextDecoder();

// Stage a JS string as a NUL-terminated C string in linear memory.
// Returns [ptr, size] (size includes the NUL); release with _free.
function _cstr(wasm, str) {
