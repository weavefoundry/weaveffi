const _bufDec = new TextDecoder('utf-8', { fatal: true });

// Strict little-endian reader for the WeaveFFI value-buffer wire format. A
// malformed buffer (truncation, invalid bool or flag bytes, an oversized
// length prefix, invalid UTF-8, trailing bytes) is a producer/consumer
// contract violation and throws the generic brand error; code -3 marks a
// consumer-side marshalling failure.
class _BufReader {
  constructor(bytes) {
    this._u8 = bytes;
    this._dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
    this._pos = 0;
  }
  _bad(what) {
    throw new WeaveFFIError(-3, 'malformed value buffer: ' + what);
  }
  _take(n, what) {
    if (this._pos + n > this._u8.length) this._bad('truncated ' + what);
    const at = this._pos;
    this._pos += n;
    return at;
  }
  bool() {
    const b = this._u8[this._take(1, 'bool')];
    if (b > 1) this._bad('bool byte out of range');
    return b === 1;
  }
  i8() { return this._dv.getInt8(this._take(1, 'i8')); }
  u8() { return this._u8[this._take(1, 'u8')]; }
  i16() { return this._dv.getInt16(this._take(2, 'i16'), true); }
  u16() { return this._dv.getUint16(this._take(2, 'u16'), true); }
  i32() { return this._dv.getInt32(this._take(4, 'i32'), true); }
  u32() { return this._dv.getUint32(this._take(4, 'u32'), true); }
  i64() { return this._dv.getBigInt64(this._take(8, 'i64'), true); }
  u64() { return this._dv.getBigUint64(this._take(8, 'u64'), true); }
  f32() { return this._dv.getFloat32(this._take(4, 'f32'), true); }
  f64() { return this._dv.getFloat64(this._take(8, 'f64'), true); }
  len() {
    const n = this.u32();
    if (n > this._u8.length - this._pos) this._bad('length prefix exceeds remaining buffer');
    return n;
  }
  flag() {
    const b = this._u8[this._take(1, 'option flag')];
    if (b > 1) this._bad('option flag byte out of range');
    return b === 1;
  }
  str() {
    const n = this.len();
    const at = this._take(n, 'string bytes');
    try {
      return _bufDec.decode(this._u8.subarray(at, at + n));
    } catch (e) {
      this._bad('string is not valid UTF-8');
    }
  }
  bytes() {
    const n = this.len();
    const at = this._take(n, 'byte buffer');
    return this._u8.subarray(at, at + n).slice();
  }
  end() {
    if (this._pos !== this._u8.length) this._bad('trailing bytes after value');
