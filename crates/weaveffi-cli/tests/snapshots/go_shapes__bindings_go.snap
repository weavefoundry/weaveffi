// Describe: Render a shape to a string
func Describe(shape Shape) string {
	wShape := &wvWriter{}
	wvPackShape(wShape, shape)
	cShapePtr, cShapeLen := wvBytes(wShape.buf)
	var cRetLen C.size_t
	var cErr C.shapes_error
	cRet := C.shapes_shapes_describe(cShapePtr, cShapeLen, &cRetLen, &cErr)
	wvTrap(&cErr)
	return wvTakeString(cRet, cRetLen)
}

// Scale: Scale a shape by a factor, returning a new shape
func Scale(shape Shape, factor float64) Shape {
	wShape := &wvWriter{}
	wvPackShape(wShape, shape)
	cShapePtr, cShapeLen := wvBytes(wShape.buf)
	var cRetLen C.size_t
	var cErr C.shapes_error
	cRet := C.shapes_shapes_scale(cShapePtr, cShapeLen, C.double(factor), &cRetLen, &cErr)
	wvTrap(&cErr)
	rRet := &wvReader{buf: wvTakeBytes(cRet, cRetLen)}
	var ret Shape
	ret = wvUnpackShape(rRet)
	rRet.expectEnd()
	return ret
}

