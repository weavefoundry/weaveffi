	case ShapeRectangle:
		w.writeI32(2)
		w.writeF32(x.Width)
		w.writeF32(x.Height)
	case ShapeBounded:
		w.writeI32(3)
		w.writeI16(x.Min)
		w.writeI16(x.Max)
		w.writeU64(x.Weight)
	case ShapeLabeled:
		w.writeI32(4)
		w.writeString(x.Label)
		w.writeU8(x.Count)
	default:
		panic("shapes: Shape value is not one of its variants")
	}
}

// wvUnpackShape decodes one Shape from r.
func wvUnpackShape(r *wvReader) Shape {
	switch r.readI32() {
	case 0:
		return ShapeEmpty{}
	case 1:
		var x ShapeCircle
		x.Radius = r.readF64()
		return x
	case 2:
		var x ShapeRectangle
		x.Width = r.readF32()
		x.Height = r.readF32()
		return x
	case 3:
		var x ShapeBounded
		x.Min = r.readI16()
		x.Max = r.readI16()
		x.Weight = r.readU64()
		return x
	case 4:
