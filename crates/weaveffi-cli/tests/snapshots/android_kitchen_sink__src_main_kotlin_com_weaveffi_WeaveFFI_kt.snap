// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

package com.weaveffi

import kotlinx.coroutines.suspendCancellableCoroutine
import kotlin.coroutines.resume
import kotlin.coroutines.resumeWithException

class WeaveFFI {
    companion object {
        init { System.loadLibrary("weaveffi") }

        @Volatile private var callbackExceptionHandler: ((Throwable) -> Unit)? = null

        /**
         * Installs a handler for exceptions thrown by listener callbacks and
         * async continuations on native producer threads. These exceptions have
         * no Kotlin caller to propagate to; when no handler is installed, they
         * are logged with their stack trace and dropped. Pass `null` to
         * restore the default logging behavior.
         */
        @JvmStatic fun setCallbackExceptionHandler(handler: ((Throwable) -> Unit)?) {
            callbackExceptionHandler = handler
        }

        // Invoked from the JNI glue; rethrowing signals "no handler" so the
        // glue falls back to ExceptionDescribe.
        @JvmStatic private fun dispatchCallbackException(t: Throwable) {
            callbackExceptionHandler?.invoke(t) ?: throw t
        }

        /**
         * Trivial cross-module helper
         */
        @JvmStatic external fun ping(): String
        /**
         * Subscribe to OnReady events
         *
         * Exceptions thrown by the callback cannot propagate to a caller (events fire on a producer thread); they are delivered to the handler installed via [setCallbackExceptionHandler], or logged with their stack trace and dropped when no handler is set.
         */
        @JvmStatic external fun registerReadyListener(callback: (Int, String) -> Unit): Long
        @JvmStatic external fun unregisterReadyListener(id: Long)
        /**
         * Identity for bool
         */
        @JvmStatic external fun boolId(x: Boolean): Boolean
        @JvmStatic external fun i32Id(x: Int): Int
        @JvmStatic external fun u32Id(x: Long): Long
        @JvmStatic external fun i64Id(x: Long): Long
        @JvmStatic external fun f64Id(x: Double): Double
        @JvmStatic external fun echoString(s: String): String
        @JvmStatic external fun echoBytes(b: ByteArray): ByteArray
        /**
         * Borrowed string parameter
         */
        @JvmStatic external fun echoBorrowedStr(s: String): String
        /**
         * Borrowed bytes parameter
         */
        @JvmStatic external fun echoBorrowedBytes(b: ByteArray): ByteArray
        /**
         * Returns an opaque handle
         */
        @JvmStatic external fun openHandle(): Long
        /**
         * Returns a typed handle
         */
        @JvmStatic external fun openTypedHandle(): Long
        /**
         * Optional struct return
         */
        @JvmStatic private external fun maybeItemJni(id: Long): ByteArray
        @JvmStatic fun maybeItem(id: Long): Item? = weaveDecode(maybeItemJni(id)) { r -> r.readOptional { unpackItem(r) } }
        /**
         * List of structs
         */
        @JvmStatic private external fun listItemsJni(): ByteArray
        @JvmStatic fun listItems(): List<Item> = weaveDecode(listItemsJni()) { r -> r.readList { unpackItem(r) } }
        /**
         * Map return type
         */
        @JvmStatic private external fun getAttrsJni(): ByteArray
        @JvmStatic fun getAttrs(): Map<String, Int> = weaveDecode(getAttrsJni()) { r -> r.readMap({ r.readString() }, { r.readI32() }) }
        /**
         * Iterator return type
         */
        @JvmStatic private external fun streamItemsJni(): Long
        @JvmStatic fun streamItems(): Iterator<Item> = KitchenStreamItemsIterator(streamItemsJni())
        /**
         * Returns the shared Token type from another module
         */
        @JvmStatic private external fun crossModuleTokenJni(): ByteArray
        @JvmStatic fun crossModuleToken(): Token = weaveDecode(crossModuleTokenJni()) { r -> unpackToken(r) }
        /**
         * Async operation
         */
        @JvmStatic private external fun doAsyncAsync(input: String, callback: Any)
        @JvmStatic suspend fun doAsync(input: String): String = suspendCancellableCoroutine { cont ->
            doAsyncAsync(input, WeaveContinuation(cont) { code, message, _ -> WeaveFFIException(code, message) })
        }
        /**
         * Cancellable async operation
         */
        @JvmStatic private external fun doCancellableAsync(input: String, cancelToken: Long, callback: Any)
        @JvmStatic suspend fun doCancellable(input: String): String = suspendCancellableCoroutine { cont ->
            doCancellableAsync(input, 0L, WeaveContinuation(cont) { code, message, _ -> WeaveFFIException(code, message) })
        }
        /**
         * Legacy operation kept for compatibility
         */
        @Deprecated("Use new_op instead")
        @JvmStatic external fun legacyOp(): Int
        /**
         * Replacement for legacy_op
         */
        @JvmStatic external fun newOp(): Int
        /**
         * Trivial nested-module function
         */
        @JvmStatic external fun hello(): String
    }
}

/** A reusable token referenced across modules */
data class Token(val id: Long, val label: String)

internal fun packToken(w: WeaveBufferWriter, v: Token) {
    w.writeI64(v.id)
    w.writeString(v.label)
}

internal fun unpackToken(r: WeaveBufferReader): Token = Token(
    r.readI64(),
    r.readString(),
)

/** Task priority levels */
enum class Priority(val value: Int) {
    /** Low priority */
    Low(0),
    /** Normal priority */
    Normal(1),
    /** High priority */
    High(2);

    companion object {
        fun fromValue(value: Int): Priority = entries.first { it.value == value }
    }
}

/** Kitchen sink struct exercising every field feature */
data class Item(
    /** Stable identifier */
    val id: Long,
    /** Display name */
    val name: String,
    /** Initial count */
    val count: Int,
    /** Whether the item is enabled */
    val enabled: Boolean,
    /** Scaling ratio */
    val ratio: Double,
    val nick: Long,
    val payload: ByteArray,
    val tags: List<String>,
    val attrs: Map<String, String>,
    val parent: Long?,
    /** Cross-module struct reference */
    val token: Token,
    val priority: Priority,
)

internal fun packItem(w: WeaveBufferWriter, v: Item) {
    w.writeI64(v.id)
    w.writeString(v.name)
    w.writeI32(v.count)
    w.writeBool(v.enabled)
    w.writeF64(v.ratio)
    w.writeU32(v.nick)
    w.writeBytes(v.payload)
    w.writeList(v.tags) { v0 -> w.writeString(v0) }
    w.writeMap(v.attrs, { k0 -> w.writeString(k0) }, { v0 -> w.writeString(v0) })
    w.writeOptional(v.parent) { v0 -> w.writeI64(v0) }
    packToken(w, v.token)
    w.writeI32(v.priority.value)
}

internal fun unpackItem(r: WeaveBufferReader): Item = Item(
    r.readI64(),
    r.readString(),
    r.readI32(),
    r.readBool(),
    r.readF64(),
    r.readU32(),
    r.readBytes(),
    r.readList { r.readString() },
    r.readMap({ r.readString() }, { r.readString() }),
    r.readOptional { r.readI64() },
    unpackToken(r),
    Priority.fromValue(r.readI32()),
)

/** A pocket-sized interface exercising the object surface */
class Gadget internal constructor(internal var handle: Long) : java.io.Closeable {
    companion object {
        init { System.loadLibrary("weaveffi") }

        @JvmStatic private external fun nativeNew(id: Long): Long
        @JvmStatic private external fun nativeVersion(): String
        @JvmStatic private external fun nativeDescribe(selfHandle: Long): String
        @JvmStatic private external fun nativePoke(selfHandle: Long, times: Int): Int
        @JvmStatic private external fun nativeDestroy(handle: Long)

        /**
         * Create a gadget with the given id
         */
        operator fun invoke(id: Long): Gadget = Gadget(nativeNew(id))

        /**
         * The gadget subsystem version string
         */
        fun version(): String = nativeVersion()
    }

    /**
     * Render the gadget as a human-readable string
     */
    fun describe(): String = nativeDescribe(handle)

    /**
     * Poke the gadget a number of times, failing on a negative count
     */
    fun poke(times: Int): Int = nativePoke(handle, times)

    override fun close() {
        if (handle != 0L) {
            nativeDestroy(handle)
            handle = 0L
        }
    }

    protected fun finalize() {
        close()
    }
}

/**
 * A lazy iterator over the `Item` elements streamed by [streamItems]. Each step pulls
 * exactly one element from the native producer. The native handle is
 * released when the producer is exhausted, when [close] is called, or by
 * the finalizer if the iterator is abandoned, whichever comes first.
 */
class KitchenStreamItemsIterator internal constructor(private var handle: Long) : Iterator<Item>, java.io.Closeable {
    private var nextSlot: Array<Any?>? = null

    override fun hasNext(): Boolean {
        if (nextSlot != null) return true
        if (handle == 0L) return false
        val slot = nativeNext(handle)
        if (slot == null) {
            close()
            return false
        }
        nextSlot = slot
        return true
    }

    override fun next(): Item {
        if (!hasNext()) throw NoSuchElementException()
        val raw = nextSlot!![0]
        nextSlot = null
        return weaveDecode((raw as ByteArray)) { r -> unpackItem(r) }
    }

    override fun close() {
        if (handle != 0L) {
            nativeDestroy(handle)
            handle = 0L
        }
    }

    protected fun finalize() {
        close()
    }

    companion object {
        init { System.loadLibrary("weaveffi") }

        @JvmStatic private external fun nativeNext(handle: Long): Array<Any?>?
        @JvmStatic private external fun nativeDestroy(handle: Long)
    }
}

/** Generic WeaveFFI failure: panics, marshalling errors, and unknown codes. */
open class WeaveFFIException(val code: Int, message: String) : Exception(message)

/** Typed error domain `KitchenErrors` declared by module `kitchen`. */
sealed class KitchenErrorsException(code: Int, message: String) : WeaveFFIException(code, message) {
    class NotFound(message: String = "Item not found") : KitchenErrorsException(1, message)
    class InvalidInput(message: String = "Invalid input") : KitchenErrorsException(2, message)

    companion object {
        /** Map a raw `KitchenErrors` code and payload to the typed exception; unknown codes yield the generic [WeaveFFIException]. */
        @JvmStatic fun fromCode(code: Int, message: String, payload: ByteArray?): WeaveFFIException = when (code) {
            1 -> NotFound(message)
            2 -> InvalidInput(message)
            else -> WeaveFFIException(code, message)
        }
    }
}

/** Growable little-endian writer implementing the WeaveFFI value-buffer wire format. */
internal class WeaveBufferWriter {
    private var buf = ByteArray(32)
    private var len = 0

    private fun reserve(extra: Int) {
        if (len + extra <= buf.size) return
        var cap = buf.size * 2
        while (cap < len + extra) cap *= 2
        buf = buf.copyOf(cap)
    }

    fun toByteArray(): ByteArray = buf.copyOf(len)

    fun writeBool(v: Boolean) { reserve(1); buf[len++] = if (v) 1 else 0 }
    fun writeI8(v: Byte) { reserve(1); buf[len++] = v }
    fun writeI16(v: Short) {
        reserve(2)
        val b = v.toInt()
        buf[len++] = (b and 0xFF).toByte()
        buf[len++] = ((b shr 8) and 0xFF).toByte()
    }
    fun writeI32(v: Int) {
        reserve(4)
        buf[len++] = (v and 0xFF).toByte()
        buf[len++] = ((v shr 8) and 0xFF).toByte()
        buf[len++] = ((v shr 16) and 0xFF).toByte()
        buf[len++] = ((v shr 24) and 0xFF).toByte()
    }
    fun writeU32(v: Long) = writeI32(v.toInt())
    fun writeI64(v: Long) {
        writeI32(v.toInt())
        writeI32((v ushr 32).toInt())
    }
    fun writeF32(v: Float) = writeI32(v.toRawBits())
    fun writeF64(v: Double) = writeI64(v.toRawBits())
    fun writeString(v: String) = writeBytes(v.toByteArray(Charsets.UTF_8))
    fun writeBytes(v: ByteArray) {
        writeI32(v.size)
        reserve(v.size)
        v.copyInto(buf, len)
        len += v.size
    }
    fun <T> writeOptional(v: T?, write: (T) -> Unit) {
        if (v == null) writeBool(false) else { writeBool(true); write(v) }
    }
    fun <T> writeList(v: List<T>, write: (T) -> Unit) {
        writeI32(v.size)
        for (e in v) write(e)
    }
    fun <K, V> writeMap(v: Map<K, V>, writeKey: (K) -> Unit, writeValue: (V) -> Unit) {
        writeI32(v.size)
        for ((k, e) in v) { writeKey(k); writeValue(e) }
    }
}

/** Validating little-endian reader for the WeaveFFI value-buffer wire format. */
internal class WeaveBufferReader(private val buf: ByteArray) {
    private var pos = 0

    private fun malformed(detail: String): Nothing =
        throw WeaveFFIException(-2, "malformed WeaveFFI value buffer: " + detail)

    private fun take(n: Int): Int {
        if (n > buf.size - pos) malformed("truncated buffer")
        val at = pos
        pos += n
        return at
    }

    fun readBool(): Boolean = when (buf[take(1)].toInt()) {
        0 -> false
        1 -> true
        else -> malformed("invalid bool byte")
    }
    fun readI8(): Byte = buf[take(1)]
    fun readI16(): Short {
        val at = take(2)
        return ((buf[at].toInt() and 0xFF) or ((buf[at + 1].toInt() and 0xFF) shl 8)).toShort()
    }
    fun readI32(): Int {
        val at = take(4)
        return (buf[at].toInt() and 0xFF) or
            ((buf[at + 1].toInt() and 0xFF) shl 8) or
            ((buf[at + 2].toInt() and 0xFF) shl 16) or
            ((buf[at + 3].toInt() and 0xFF) shl 24)
    }
    fun readU32(): Long = readI32().toLong() and 0xFFFFFFFFL
    fun readI64(): Long {
        val lo = readI32().toLong() and 0xFFFFFFFFL
        val hi = readI32().toLong()
        return lo or (hi shl 32)
    }
    fun readF32(): Float = Float.fromBits(readI32())
    fun readF64(): Double = Double.fromBits(readI64())
    private fun readLen(): Int {
        val n = readI32()
        if (n < 0 || n > buf.size - pos) malformed("length prefix exceeds remaining bytes")
        return n
    }
    fun readString(): String {
        val n = readLen()
        val at = take(n)
        return try {
            Charsets.UTF_8.newDecoder().decode(java.nio.ByteBuffer.wrap(buf, at, n)).toString()
        } catch (e: java.nio.charset.CharacterCodingException) {
            malformed("string is not valid UTF-8")
        }
    }
    fun readBytes(): ByteArray {
        val n = readLen()
        val at = take(n)
        return buf.copyOfRange(at, at + n)
    }
    fun <T> readOptional(read: () -> T): T? = if (readBool()) read() else null
    fun <T> readList(read: () -> T): List<T> {
        val n = readLen()
        val out = ArrayList<T>(n)
        repeat(n) { out.add(read()) }
        return out
    }
    fun <K, V> readMap(readKey: () -> K, readValue: () -> V): Map<K, V> {
        val n = readLen()
        val out = LinkedHashMap<K, V>()
        repeat(n) { out[readKey()] = readValue() }
        return out
    }
    fun expectEnd() {
        if (pos != buf.size) malformed("trailing bytes after value")
    }
}

internal fun weaveEncode(write: (WeaveBufferWriter) -> Unit): ByteArray {
    val w = WeaveBufferWriter()
    write(w)
    return w.toByteArray()
}

internal fun <T> weaveDecode(bytes: ByteArray, read: (WeaveBufferReader) -> T): T {
    val r = WeaveBufferReader(bytes)
    val v = read(r)
    r.expectEnd()
    return v
}

internal class WeaveContinuation<T>(
    private val cont: kotlinx.coroutines.CancellableContinuation<T>,
    private val mapError: (Int, String, ByteArray?) -> Throwable
) {
    @Suppress("UNCHECKED_CAST")
    fun onSuccess(result: Any?) { cont.resume(result as T) }
    fun onError(code: Int, message: String, payload: ByteArray?) { cont.resumeWithException(mapError(code, message, payload)) }
}

// END WeaveFFI.kt
