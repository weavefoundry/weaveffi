typedef struct {
    napi_deferred deferred;
    napi_threadsafe_function tsfn;
    int32_t err_code;
    char* err_msg;
    uint8_t* err_payload;
    size_t err_payload_len;
    bool result;
} weaveffi_docs_publish_async_napi_actx;

static void weaveffi_docs_publish_async_napi_cb(void* context, weaveffi_error* err, bool result) {
    weaveffi_docs_publish_async_napi_actx* ctx = (weaveffi_docs_publish_async_napi_actx*)context;
    if (err != NULL && err->code != 0) {
        ctx->err_code = err->code;
        ctx->err_msg = err->message ? strdup(err->message) : strdup("unknown error");
        ctx->err_payload_len = err->payload_len;
        if (err->payload_ptr != NULL && err->payload_len > 0) { ctx->err_payload = (uint8_t*)malloc(err->payload_len); memcpy(ctx->err_payload, err->payload_ptr, err->payload_len); }
    } else {
        ctx->result = result;
    }
    weaveffi_error_free(err);
    napi_call_threadsafe_function(ctx->tsfn, ctx, napi_tsfn_blocking);
}

static void weaveffi_docs_publish_async_napi_settle(napi_env env, napi_value js_cb, void* context, void* data) {
    (void)js_cb;
    (void)context;
    weaveffi_docs_publish_async_napi_actx* ctx = (weaveffi_docs_publish_async_napi_actx*)data;
    if (env != NULL) {
    if (ctx->err_code != 0) {
        napi_value err_obj = weaveffi_napi_error_value(env, ctx->err_code, ctx->err_msg, ctx->err_payload, ctx->err_payload_len);
        napi_reject_deferred(env, ctx->deferred, err_obj);
    } else {
        napi_value val;
        napi_get_boolean(env, ctx->result, &val);
        napi_resolve_deferred(env, ctx->deferred, val);
    }
    }
    free(ctx->err_msg);
    free(ctx->err_payload);
    napi_release_threadsafe_function(ctx->tsfn, napi_tsfn_release);
    free(ctx);
}

static napi_value Napi_weaveffi_docs_publish_async(napi_env env, napi_callback_info info) {
  size_t argc = 1;
  napi_value args[1];
  napi_get_cb_info(env, info, &argc, args, NULL, NULL);
  napi_status arg_status = napi_ok;
  int64_t id = 0;
  if (arg_status == napi_ok) {
    arg_status = weaveffi_napi_get_i64(env, args[0], &id);
  }
  if (arg_status != napi_ok) {
    return NULL;
  }
  weaveffi_docs_publish_async_napi_actx* ctx = (weaveffi_docs_publish_async_napi_actx*)calloc(1, sizeof(weaveffi_docs_publish_async_napi_actx));
  napi_value promise;
  napi_create_promise(env, &ctx->deferred, &promise);
  napi_value resource_name;
  napi_create_string_utf8(env, "weaveffi_docs_publish_async", NAPI_AUTO_LENGTH, &resource_name);
  napi_create_threadsafe_function(env, NULL, NULL, resource_name, 0, 1, NULL, NULL, NULL, weaveffi_docs_publish_async_napi_settle, &ctx->tsfn);
  weaveffi_docs_publish_async_async(id, weaveffi_docs_publish_async_napi_cb, ctx);
  return promise;
}

static napi_value Napi_weaveffi_docs_watch(napi_env env, napi_callback_info info) {
  size_t argc = 1;
  napi_value args[1];
  napi_get_cb_info(env, info, &argc, args, NULL, NULL);
  napi_status arg_status = napi_ok;
  napi_valuetype listener_type;
  napi_typeof(env, args[0], &listener_type);
  weaveffi_napi_cb_ctx* listener_ctx = NULL;
  if (listener_type == napi_object || listener_type == napi_function) {
    listener_ctx = weaveffi_napi_cb_register(env, args[0], "weaveffi_docs_SavedListener", weaveffi_docs_SavedListener_napi_dispatch);
  } else {
    napi_throw_type_error(env, NULL, "expected a SavedListener implementation");
    arg_status = napi_object_expected;
  }
  if (arg_status != napi_ok) {
    if (listener_ctx != NULL) weaveffi_napi_cb_release(env, listener_ctx);
    return NULL;
  }
  weaveffi_error err = {0};
  weaveffi_docs_watch((void*)listener_ctx, &weaveffi_docs_SavedListener_napi_vtable, &err);
  if (err.code != 0) {
    napi_throw(env, weaveffi_napi_error_value(env, err.code, err.message, err.payload_ptr, err.payload_len));
    weaveffi_error_clear(&err);
    return NULL;
  }
  napi_value ret;
  napi_get_undefined(env, &ret);
  return ret;
}

static napi_value Init(napi_env env, napi_value exports) {
  {
    uint32_t found = weaveffi_abi_version();
    if (found != WEAVEFFI_ABI_VERSION) {
      char msg[160];
      snprintf(msg, sizeof msg, "WeaveFFI ABI mismatch: these bindings expect revision %u but the loaded library reports revision %u", (unsigned)WEAVEFFI_ABI_VERSION, (unsigned)found);
      napi_throw_error(env, NULL, msg);
      return NULL;
    }
  }
  weaveffi_napi_js_thread = uv_thread_self();
  napi_property_descriptor props[] = {
    { "Notebook_new", NULL, Napi_weaveffi_docs_Notebook_new, NULL, NULL, NULL, napi_default, NULL },
    { "Notebook_max_documents", NULL, Napi_weaveffi_docs_Notebook_max_documents, NULL, NULL, NULL, napi_default, NULL },
    { "Notebook_insert", NULL, Napi_weaveffi_docs_Notebook_insert, NULL, NULL, NULL, napi_default, NULL },
    { "Notebook_find", NULL, Napi_weaveffi_docs_Notebook_find, NULL, NULL, NULL, napi_default, NULL },
    { "Notebook_size", NULL, Napi_weaveffi_docs_Notebook_size, NULL, NULL, NULL, napi_default, NULL },
    { "Notebook__destroy", NULL, Napi_weaveffi_docs_Notebook_destroy, NULL, NULL, NULL, napi_default, NULL },
    { "Notebook__clone", NULL, Napi_weaveffi_docs_Notebook_clone, NULL, NULL, NULL, napi_default, NULL },
    { "createDocument", NULL, Napi_weaveffi_docs_create_document, NULL, NULL, NULL, napi_default, NULL },
    { "getDocument", NULL, Napi_weaveffi_docs_get_document, NULL, NULL, NULL, napi_default, NULL },
    { "publishAsync", NULL, Napi_weaveffi_docs_publish_async, NULL, NULL, NULL, napi_default, NULL },
    { "watch", NULL, Napi_weaveffi_docs_watch, NULL, NULL, NULL, napi_default, NULL },
  };
  napi_define_properties(env, exports, 11, props);
  return exports;
}

NAPI_MODULE(NODE_GYP_MODULE_NAME, Init)

// END weaveffi_addon.c
