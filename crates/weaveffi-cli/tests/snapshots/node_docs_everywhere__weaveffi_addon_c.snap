      napi_get_value_string_utf8(env, str, msg, sizeof msg, NULL);
    }
    napi_is_exception_pending(env, &pending);
    if (pending) {
      napi_get_and_clear_last_exception(env, &exc);
    }
  }
  weaveffi_error_set(out_err, -4, msg[0] ? msg : fallback);
}

