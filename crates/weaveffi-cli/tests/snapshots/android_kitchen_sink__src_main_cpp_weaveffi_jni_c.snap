    weaveffi_kitchen_Gadget_destroy((weaveffi_kitchen_Gadget*)(intptr_t)handle);
}

JNIEXPORT jobjectArray JNICALL Java_com_weaveffi_KitchenStreamItemsIterator_nativeNext(JNIEnv* env, jclass clazz, jlong handle) {
    weaveffi_kitchen_StreamItemsIterator* _iter = (weaveffi_kitchen_StreamItemsIterator*)(intptr_t)handle;
    const uint8_t* _item = (const uint8_t*)0;
    size_t _item_len = 0;
    weaveffi_error err = {0, NULL, NULL, 0};
    int32_t _has = weaveffi_kitchen_StreamItemsIterator_next(_iter, &_item, &_item_len, &err);
    if (err.code != 0) {
        throw_weaveffi_error(env, &err);
        return NULL;
    }
    if (_has == 0) { return NULL; }
    jbyteArray _jitem = (*env)->NewByteArray(env, (jsize)_item_len);
    if (_jitem && _item) { (*env)->SetByteArrayRegion(env, _jitem, 0, (jsize)_item_len, (const jbyte*)_item); }
    weaveffi_free_bytes((uint8_t*)_item, _item_len);
    jclass _obj_cls = (*env)->FindClass(env, "java/lang/Object");
    jobjectArray _slot = (*env)->NewObjectArray(env, 1, _obj_cls, NULL);
    (*env)->SetObjectArrayElement(env, _slot, 0, _jitem);
    return _slot;
}

JNIEXPORT void JNICALL Java_com_weaveffi_KitchenStreamItemsIterator_nativeDestroy(JNIEnv* env, jclass clazz, jlong handle) {
    weaveffi_kitchen_StreamItemsIterator_destroy((weaveffi_kitchen_StreamItemsIterator*)(intptr_t)handle);
}


