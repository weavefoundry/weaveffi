    const char* rv = weaveffi_kitchen_nested_hello(&err);
    if (err.code != 0) {
        throw_weaveffi_error(env, &err);
        return NULL;
    }
    jstring out = rv ? (*env)->NewStringUTF(env, rv) : (*env)->NewStringUTF(env, "");
    weaveffi_free_string(rv);
    return out;
}

JNIEXPORT jlong JNICALL Java_com_weaveffi_Gadget_nativeNew(JNIEnv* env, jclass clazz, jlong id) {
    weaveffi_error err = {0, NULL, NULL, 0};
