JNIEXPORT jint JNICALL Java_com_weaveffi_Gadget_nativePoke(JNIEnv* env, jclass clazz, jlong selfHandle, jint times) {
    weaveffi_error err = {0, NULL, NULL, 0};
    int32_t rv = weaveffi_kitchen_Gadget_poke((const weaveffi_kitchen_Gadget*)(intptr_t)selfHandle, (int32_t)times, &err);
    if (err.code != 0) {
        throw_weaveffi_kitchen_KitchenErrors(env, &err);
