cmake_minimum_required(VERSION 3.18)
project(edge_cases_jni C)

# The directory holding the producer library (libedge_cases). Android builds
# default to the per-ABI copy under src/main/jniLibs/.
set(EDGE_CASES_LIBRARY_DIR "" CACHE PATH "Directory holding the edge_cases producer library")
if(NOT EDGE_CASES_LIBRARY_DIR AND ANDROID)
    set(EDGE_CASES_LIBRARY_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../jniLibs/${ANDROID_ABI}")
endif()
if(EDGE_CASES_LIBRARY_DIR)
    find_library(EDGE_CASES_PRODUCER NAMES edge_cases PATHS "${EDGE_CASES_LIBRARY_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
else()
    set(CMAKE_FIND_FRAMEWORK NEVER)
    find_library(EDGE_CASES_PRODUCER NAMES edge_cases REQUIRED)
endif()

add_library(edge_cases_jni SHARED edge_cases_jni.c)
target_include_directories(edge_cases_jni PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(edge_cases_jni PRIVATE "${EDGE_CASES_PRODUCER}")
if(NOT ANDROID)
    find_package(JNI REQUIRED)
    find_package(Threads REQUIRED)
    target_include_directories(edge_cases_jni PRIVATE ${JNI_INCLUDE_DIRS})
    target_link_libraries(edge_cases_jni PRIVATE Threads::Threads)
endif()

# END CMakeLists.txt
