  def self.check_error!(err)
    return if err[:code].zero?
    code = err[:code]
    msg_ptr = err[:message]
    msg = msg_ptr.null? ? '' : msg_ptr.read_string
    weaveffi_error_clear(err.to_ptr)
    raise Error.new(code, msg)
  end

  # === Module: shapes ===

  # An algebraic shape (sum type with associated data)
  class Shape
    # The active variant's integer tag.
    def tag
      self.class::TAG
    end

    # The empty shape (a unit variant)
    class Empty < Shape
      TAG = 0

      # Structural equality over the variant and its fields.
      def ==(other)
        return false unless other.is_a?(Empty)
        true
      end
    end

    # A circle with a radius
    class Circle < Shape
      TAG = 1

      # Radius in points
      attr_reader :radius

      def initialize(radius:)
        @radius = radius
      end

      # Structural equality over the variant and its fields.
      def ==(other)
        return false unless other.is_a?(Circle)
        return false unless radius == other.radius
        true
      end
    end

    # An axis-aligned rectangle
    class Rectangle < Shape
      TAG = 2

      attr_reader :width

      attr_reader :height

      def initialize(width:, height:)
        @width = width
        @height = height
      end

      # Structural equality over the variant and its fields.
      def ==(other)
        return false unless other.is_a?(Rectangle)
        return false unless width == other.width
        return false unless height == other.height
        true
      end
    end

    # An integer-bounded shape (exercises narrow + wide ints)
    class Bounded < Shape
      TAG = 3

      attr_reader :min

      attr_reader :max

      attr_reader :weight

      def initialize(min:, max:, weight:)
        @min = min
        @max = max
        @weight = weight
      end

      # Structural equality over the variant and its fields.
      def ==(other)
        return false unless other.is_a?(Bounded)
        return false unless min == other.min
        return false unless max == other.max
        return false unless weight == other.weight
        true
      end
    end

    # A labeled shape with a small count
    class Labeled < Shape
      TAG = 4

      attr_reader :label

      attr_reader :count

      def initialize(label:, count:)
        @label = label
        @count = count
      end

      # Structural equality over the variant and its fields.
      def ==(other)
        return false unless other.is_a?(Labeled)
        return false unless label == other.label
        return false unless count == other.count
        true
      end
    end
  end

