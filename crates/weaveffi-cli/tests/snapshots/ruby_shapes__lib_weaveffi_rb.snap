      @c = c
      @d = d
      @e = e
      @f = f
      @g = g
      @h = h
      @i = i
      @j = j
    end

    # Structural equality over every field.
    def ==(other)
      return false unless other.is_a?(Numerics)
      return false unless a == other.a
      return false unless b == other.b
      return false unless c == other.c
      return false unless d == other.d
      return false unless e == other.e
      return false unless f == other.f
      return false unless g == other.g
      return false unless h == other.h
      return false unless i == other.i
      return false unless j == other.j
      true
    end
  end

  # @api private
  # Packs a Numerics into the value-buffer wire format.
  def self._wv_write_numerics(w, v)
    w.write_i8(v.a)
    w.write_i16(v.b)
    w.write_i32(v.c)
    w.write_i64(v.d)
    w.write_u8(v.e)
    w.write_u16(v.f)
    w.write_u32(v.g)
    w.write_u64(v.h)
    w.write_f32(v.i)
    w.write_f64(v.j)
  end

  # @api private
  # Unpacks a Numerics from the value-buffer wire format.
  def self._wv_read_numerics(r)
    _wv_a = r.read_i8
    _wv_b = r.read_i16
    _wv_c = r.read_i32
    _wv_d = r.read_i64
    _wv_e = r.read_u8
    _wv_f = r.read_u16
    _wv_g = r.read_u32
    _wv_h = r.read_u64
    _wv_i = r.read_f32
    _wv_j = r.read_f64
    Numerics.new(a: _wv_a, b: _wv_b, c: _wv_c, d: _wv_d, e: _wv_e, f: _wv_f, g: _wv_g, h: _wv_h, i: _wv_i, j: _wv_j)
  end

  # @api private
  # Packs a Shape into the value-buffer wire format.
  def self._wv_write_shape(w, v)
    case v
    when Shape::Empty
      w.write_i32(0)
    when Shape::Circle
      w.write_i32(1)
      w.write_f64(v.radius)
    when Shape::Rectangle
      w.write_i32(2)
      w.write_f32(v.width)
      w.write_f32(v.height)
    when Shape::Bounded
      w.write_i32(3)
      w.write_i16(v.min)
      w.write_i16(v.max)
      w.write_u64(v.weight)
    when Shape::Labeled
      w.write_i32(4)
      w.write_string(v.label)
      w.write_u8(v.count)
    else
      raise Error.new(-1, 'unknown Shape variant')
    end
  end

  # @api private
  # Unpacks a Shape from the value-buffer wire format.
  def self._wv_read_shape(r)
    tag = r.read_i32
    case tag
    when 0
      Shape::Empty.new
    when 1
      _wv_radius = r.read_f64
      Shape::Circle.new(radius: _wv_radius)
    when 2
      _wv_width = r.read_f32
      _wv_height = r.read_f32
      Shape::Rectangle.new(width: _wv_width, height: _wv_height)
    when 3
      _wv_min = r.read_i16
      _wv_max = r.read_i16
      _wv_weight = r.read_u64
      Shape::Bounded.new(min: _wv_min, max: _wv_max, weight: _wv_weight)
    when 4
      _wv_label = r.read_string
      _wv_count = r.read_u8
      Shape::Labeled.new(label: _wv_label, count: _wv_count)
    else
      raise Error.new(-1, "malformed value buffer: unknown Shape tag #{tag}")
    end
  end
  # Render a shape to a string
  attach_function :weaveffi_shapes_describe, [:pointer, :size_t, :pointer], :pointer
  # Scale a shape by a factor, returning a new shape
  attach_function :weaveffi_shapes_scale, [:pointer, :size_t, :double, :pointer, :pointer], :pointer
  # Sum a list of bytes into a wide integer (numerics smoke)
  attach_function :weaveffi_shapes_sum_bytes, [:pointer, :size_t, :pointer], :uint64
  # Build a Numerics struct from every numeric primitive
  attach_function :weaveffi_shapes_make_numerics, [:int8, :int16, :int32, :int64, :uint8, :uint16, :uint32, :uint64, :float, :double, :pointer, :pointer], :pointer

  # Render a shape to a string
  def self.describe(shape)
    err = ErrorStruct.new
    shape_w = WvBufferWriter.new
    _wv_write_shape(shape_w, shape)
    shape_data = shape_w.data
    shape_buf = FFI::MemoryPointer.new(:uint8, shape_data.bytesize)
    shape_buf.put_bytes(0, shape_data)
    result = weaveffi_shapes_describe(shape_buf, shape_data.bytesize, err)
    check_error!(err)
    return '' if result.null?
    str = result.read_string
    weaveffi_free_string(result)
    str
  end

  # Scale a shape by a factor, returning a new shape
  def self.scale(shape, factor)
    err = ErrorStruct.new
    shape_w = WvBufferWriter.new
    _wv_write_shape(shape_w, shape)
    shape_data = shape_w.data
    shape_buf = FFI::MemoryPointer.new(:uint8, shape_data.bytesize)
    shape_buf.put_bytes(0, shape_data)
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_shapes_scale(shape_buf, shape_data.bytesize, factor, out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = _wv_read_shape(_wv_r)
    _wv_r.expect_end!
    _wv_value
  end

  # Sum a list of bytes into a wide integer (numerics smoke)
  def self.sum_bytes(values)
    err = ErrorStruct.new
    values_buf = FFI::MemoryPointer.new(:uint8, values.bytesize)
    values_buf.put_bytes(0, values)
    result = weaveffi_shapes_sum_bytes(values_buf, values.bytesize, err)
    check_error!(err)
    result
  end

  # Build a Numerics struct from every numeric primitive
  def self.make_numerics(a, b, c, d, e, f, g, h, i, j)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_shapes_make_numerics(a, b, c, d, e, f, g, h, i, j, out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = _wv_read_numerics(_wv_r)
    _wv_r.expect_end!
    _wv_value
  end
