                }
            }, ctx)
        }
    }
    /// Register a listener for saved notifications
    /// - Parameter listener: Receiver of saved notifications
    public static func watch(listener: SavedListener) -> Void {
        var err = weaveffi_error(code: 0, message: nil, payload_ptr: nil, payload_len: 0)
        let listener_ctx = Unmanaged.passRetained(WvSavedListenerBox(listener)).toOpaque()
        weaveffi_docs_watch(listener_ctx, WvSavedListenerVtable.pointer, &err)
        trap(&err)
