        weaveffi_free_bytes(UnsafeMutablePointer(mutating: rv), outLen)
        var rvReader = WvReader(bytes: rvBytes)
        var v0: Document? = nil
        if rvReader.readOptionFlag() {
            let v1 = wvReadDocument(&rvReader)
            v0 = v1
        }
        rvReader.finish()
        return v0
    }
    /// Publish a document in the background
    /// - Parameter id: Identifier of the document to publish
    public static func publishAsync(id: Int64) async -> Bool {
        await withCheckedContinuation { (continuation: CheckedContinuation<Bool, Never>) in
            let ctx = Unmanaged.passRetained(ContinuationRef(continuation)).toOpaque()
            weaveffi_docs_publish_async_async(id, { context, err, result in
                let contRef = Unmanaged<ContinuationRef<Bool, Never>>.fromOpaque(context!).takeRetainedValue()
                if let err = err, err.pointee.code != 0 {
