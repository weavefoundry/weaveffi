/** Errors of the `EdgeErrors` domain. */
sealed class EdgeErrorsException(code: Int, message: String) : FfiException(code, message) {
    class Busy(message: String = "Resource is busy") : EdgeErrorsException(7, message)

    internal companion object {
        /** The exception for a raw code and its serialized payload. */
        fun fromCode(code: Int, message: String, payload: ByteArray?): FfiException = when (code) {
            7 -> Busy(message)
            else -> FfiException(code, message)
        }
    }
}

