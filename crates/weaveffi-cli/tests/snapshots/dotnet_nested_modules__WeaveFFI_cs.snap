// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

#nullable enable

using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;

namespace WeaveFFI
{
    public class WeaveFFIException : Exception
    {
        public int Code { get; }

        public WeaveFFIException(int code, string message) : base(message)
        {
            Code = code;
        }
    }

    /// <summary>Typed exception for the GraphicsError error domain (module graphics).</summary>
    public class GraphicsException : WeaveFFIException
    {
        /// <summary>coordinate out of bounds</summary>
        public const int OutOfBounds = 1;

        public GraphicsException(int code, string message) : base(code, message)
        {
        }

        /// <summary>Wraps a raw error slot in the typed exception, falling
        /// back to <see cref="WeaveFFIException"/> for unknown codes. Codes
        /// declaring payload fields decode them into Data.</summary>
        internal static WeaveFFIException FromCode(int code, string message, byte[]? payload)
        {
            switch (code)
            {
                case OutOfBounds:
                    return new GraphicsException(code, string.IsNullOrEmpty(message) ? "coordinate out of bounds" : message);
                default:
                    return new WeaveFFIException(code, message);
            }
        }
    }

    [StructLayout(LayoutKind.Sequential)]
    internal struct WeaveFFIError
    {
        public int Code;
        public IntPtr Message;
        public IntPtr PayloadPtr;
        public UIntPtr PayloadLen;

        internal static byte[]? CopyPayload(WeaveFFIError err)
        {
            if (err.PayloadPtr == IntPtr.Zero || (int)err.PayloadLen == 0)
            {
                return null;
            }
            var payload = new byte[(int)err.PayloadLen];
            Marshal.Copy(err.PayloadPtr, payload, 0, (int)err.PayloadLen);
            return payload;
        }

        internal static void Check(WeaveFFIError err)
        {
            if (err.Code != 0)
            {
                var code = err.Code;
                var msg = Marshal.PtrToStringUTF8(err.Message) ?? "";
                NativeMethods.weaveffi_error_clear(ref err);
                throw new WeaveFFIException(code, msg);
            }
        }

        internal static void CheckGraphics(WeaveFFIError err)
        {
            if (err.Code != 0)
            {
                var code = err.Code;
                var msg = Marshal.PtrToStringUTF8(err.Message) ?? "";
                var payload = CopyPayload(err);
                NativeMethods.weaveffi_error_clear(ref err);
                throw GraphicsException.FromCode(code, msg, payload);
            }
        }
    }

    internal static class WeaveFFIHelpers
    {
        internal static IntPtr StringToPtr(string? s)
        {
            return s == null ? IntPtr.Zero : Marshal.StringToCoTaskMemUTF8(s);
        }

        internal static string? PtrToString(IntPtr ptr)
        {
            return ptr == IntPtr.Zero ? null : Marshal.PtrToStringUTF8(ptr);
        }

        internal static void FreePtr(IntPtr ptr)
        {
            Marshal.FreeCoTaskMem(ptr);
        }
    }

    /// <summary>Serializes values into the WeaveFFI value-buffer wire
    /// format (little-endian, packed).</summary>
    internal sealed class WeaveFFIBufferWriter
    {
        private byte[] _buf = new byte[64];
        private int _len;

        private void Ensure(int extra)
        {
            if (_len + extra <= _buf.Length)
            {
                return;
            }
            var size = _buf.Length * 2;
            while (size < _len + extra)
            {
                size *= 2;
            }
            Array.Resize(ref _buf, size);
        }

        internal void WriteBool(bool v)
        {
            Ensure(1);
            _buf[_len++] = v ? (byte)1 : (byte)0;
        }

        internal void WriteI8(sbyte v)
        {
            Ensure(1);
            _buf[_len++] = (byte)v;
        }

        internal void WriteU8(byte v)
        {
            Ensure(1);
            _buf[_len++] = v;
        }

        internal void WriteU16(ushort v)
        {
            Ensure(2);
            _buf[_len++] = (byte)v;
            _buf[_len++] = (byte)(v >> 8);
        }

        internal void WriteI16(short v)
        {
            WriteU16((ushort)v);
        }

        internal void WriteU32(uint v)
        {
            Ensure(4);
            _buf[_len++] = (byte)v;
            _buf[_len++] = (byte)(v >> 8);
            _buf[_len++] = (byte)(v >> 16);
            _buf[_len++] = (byte)(v >> 24);
        }

        internal void WriteI32(int v)
        {
            WriteU32((uint)v);
        }

        internal void WriteU64(ulong v)
        {
            WriteU32((uint)v);
            WriteU32((uint)(v >> 32));
        }

        internal void WriteI64(long v)
        {
            WriteU64((ulong)v);
        }

        internal void WriteF32(float v)
        {
            WriteU32((uint)BitConverter.SingleToInt32Bits(v));
        }

        internal void WriteF64(double v)
        {
            WriteU64((ulong)BitConverter.DoubleToInt64Bits(v));
        }

        internal void WriteLen(int len)
        {
            WriteU32((uint)len);
        }

        internal void WriteOptionFlag(bool present)
        {
            WriteBool(present);
        }

        internal void WriteString(string v)
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(v);
            WriteLen(bytes.Length);
            Ensure(bytes.Length);
            Array.Copy(bytes, 0, _buf, _len, bytes.Length);
            _len += bytes.Length;
        }

        internal void WriteBytes(byte[] v)
        {
            WriteLen(v.Length);
            Ensure(v.Length);
            Array.Copy(v, 0, _buf, _len, v.Length);
            _len += v.Length;
        }

        internal byte[] ToArray()
        {
            var outBuf = new byte[_len];
            Array.Copy(_buf, outBuf, _len);
            return outBuf;
        }
    }

    /// <summary>Decodes values from the WeaveFFI value-buffer wire format.
    /// A malformed buffer indicates a producer/consumer contract violation and
    /// throws <see cref="InvalidOperationException"/>.</summary>
    internal sealed class WeaveFFIBufferReader
    {
        private static readonly System.Text.Encoding Utf8Strict =
            new System.Text.UTF8Encoding(false, true);

        private readonly byte[] _data;
        private int _pos;

        internal WeaveFFIBufferReader(byte[] data)
        {
            _data = data;
        }

        private void Require(int n)
        {
            if (_data.Length - _pos < n)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: buffer exhausted");
            }
        }

        internal bool ReadBool()
        {
            Require(1);
            var b = _data[_pos++];
            if (b > 1)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: invalid bool byte");
            }
            return b == 1;
        }

        internal sbyte ReadI8()
        {
            Require(1);
            return (sbyte)_data[_pos++];
        }

        internal byte ReadU8()
        {
            Require(1);
            return _data[_pos++];
        }

        internal ushort ReadU16()
        {
            Require(2);
            var v = (ushort)(_data[_pos] | (_data[_pos + 1] << 8));
            _pos += 2;
            return v;
        }

        internal short ReadI16()
        {
            return (short)ReadU16();
        }

        internal uint ReadU32()
        {
            Require(4);
            var v = (uint)_data[_pos]
                | ((uint)_data[_pos + 1] << 8)
                | ((uint)_data[_pos + 2] << 16)
                | ((uint)_data[_pos + 3] << 24);
            _pos += 4;
            return v;
        }

        internal int ReadI32()
        {
            return (int)ReadU32();
        }

        internal ulong ReadU64()
        {
            var lo = (ulong)ReadU32();
            var hi = (ulong)ReadU32();
            return lo | (hi << 32);
        }

        internal long ReadI64()
        {
            return (long)ReadU64();
        }

        internal float ReadF32()
        {
            return BitConverter.Int32BitsToSingle(ReadI32());
        }

        internal double ReadF64()
        {
            return BitConverter.Int64BitsToDouble(ReadI64());
        }

        internal int ReadLen()
        {
            var len = ReadU32();
            if (len > (uint)(_data.Length - _pos))
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: length prefix exceeds remaining bytes");
            }
            return (int)len;
        }

        internal bool ReadOptionFlag()
        {
            return ReadBool();
        }

        internal string ReadString()
        {
            var len = ReadLen();
            string s;
            try
            {
                s = Utf8Strict.GetString(_data, _pos, len);
            }
            catch (ArgumentException)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: string is not valid UTF-8");
            }
            _pos += len;
            return s;
        }

        internal byte[] ReadBytes()
        {
            var len = ReadLen();
            var outBuf = new byte[len];
            Array.Copy(_data, _pos, outBuf, 0, len);
            _pos += len;
            return outBuf;
        }

        internal void ExpectEnd()
        {
            if (_pos != _data.Length)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: trailing bytes");
            }
        }
    }

    /// <summary>A measurement unit shared with nested submodules.</summary>
    public enum Unit
    {
        pixels = 0,
        points = 1,
    }

    /// <summary>Top-level struct that references a struct defined one level deeper.</summary>
    public sealed class Canvas
    {
        public int Width { get; }

        /// <summary>Reference down into a nested module</summary>
        public Shape Root { get; }

        public Canvas(int width, Shape root)
        {
            Width = width;
            Root = root;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI32(Width);
            Root.WriteTo(writer);
        }

        internal static Canvas ReadFrom(WeaveFFIBufferReader reader)
        {
            var fWidth = reader.ReadI32();
            var fRoot = Shape.ReadFrom(reader);
            return new Canvas(fWidth, fRoot);
        }
    }

    /// <summary>A struct one level deep that references both an ancestor enum and a deeper struct.</summary>
    public sealed class Shape
    {
        public int Sides { get; }

        /// <summary>Reference up to the parent module's enum</summary>
        public Unit Unit { get; }

        /// <summary>Reference down into a deeper module</summary>
        public Detail Detail { get; }

        public Shape(int sides, Unit unit, Detail detail)
        {
            Sides = sides;
            Unit = unit;
            Detail = detail;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI32(Sides);
            writer.WriteI32((int)Unit);
            Detail.WriteTo(writer);
        }

        internal static Shape ReadFrom(WeaveFFIBufferReader reader)
        {
            var fSides = reader.ReadI32();
            var fUnit = (Unit)reader.ReadI32();
            var fDetail = Detail.ReadFrom(reader);
            return new Shape(fSides, fUnit, fDetail);
        }
    }

    /// <summary>A struct two levels deep.</summary>
    public sealed class Detail
    {
        public double Area { get; }

        public Detail(double area)
        {
            Area = area;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteF64(Area);
        }

        internal static Detail ReadFrom(WeaveFFIBufferReader reader)
        {
            var fArea = reader.ReadF64();
            return new Detail(fArea);
        }
    }

    internal static class NativeMethods
    {
        private const string LibName = "weaveffi";

        // The ABI revision these bindings were generated against.
        internal const uint AbiVersion = 1;

        // Runs before the first P/Invoke through this class, so a producer built
        // for a different ABI revision fails loudly instead of misreading the
        // error struct or a value buffer later.
        static NativeMethods()
        {
            uint found;
            try
            {
                found = weaveffi_abi_version();
            }
            catch (EntryPointNotFoundException e)
            {
                throw new InvalidOperationException(
                    $"the loaded WeaveFFI library predates ABI versioning (these bindings expect ABI revision {AbiVersion})", e);
            }
            if (found != AbiVersion)
            {
                throw new InvalidOperationException(
                    $"WeaveFFI ABI mismatch: these bindings expect revision {AbiVersion} but the loaded library reports revision {found}");
            }
        }

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern uint weaveffi_abi_version();

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_free_string(IntPtr ptr);

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_free_bytes(IntPtr ptr, UIntPtr len);

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_error_clear(ref WeaveFFIError err);

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_error_free(IntPtr err);

        [DllImport(LibName, EntryPoint = "weaveffi_graphics_new_canvas", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_graphics_new_canvas(int width, out UIntPtr out_len, ref WeaveFFIError err);

        [DllImport(LibName, EntryPoint = "weaveffi_graphics_shapes_make_shape", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_graphics_shapes_make_shape(int sides, out UIntPtr out_len, ref WeaveFFIError err);

        [DllImport(LibName, EntryPoint = "weaveffi_graphics_shapes_describe", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_graphics_shapes_describe(out UIntPtr out_len, ref WeaveFFIError err);

        [DllImport(LibName, EntryPoint = "weaveffi_graphics_shapes_geometry_compute", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_graphics_shapes_geometry_compute(IntPtr shape_ptr, UIntPtr shape_len, out UIntPtr out_len, ref WeaveFFIError err);

    }

    public static class Graphics
    {
        /// <summary>Construct a Canvas.</summary>
        public static Canvas NewCanvas(int width)
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_graphics_new_canvas(width, out var outLen, ref err);
            WeaveFFIError.Check(err);
            var resultBuf = new byte[(int)outLen];
            if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
            NativeMethods.weaveffi_free_bytes(result, outLen);
            var valueReader = new WeaveFFIBufferReader(resultBuf);
            var value = Canvas.ReadFrom(valueReader);
            valueReader.ExpectEnd();
            return value;
        }

    }

    public static class GraphicsShapes
    {
        /// <summary>Construct a Shape.</summary>
        public static Shape MakeShape(int sides)
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_graphics_shapes_make_shape(sides, out var outLen, ref err);
            WeaveFFIError.Check(err);
            var resultBuf = new byte[(int)outLen];
            if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
            NativeMethods.weaveffi_free_bytes(result, outLen);
            var valueReader = new WeaveFFIBufferReader(resultBuf);
            var value = Shape.ReadFrom(valueReader);
            valueReader.ExpectEnd();
            return value;
        }

        /// <summary>Nested function returning a struct owned by an ancestor module.</summary>
        public static Canvas Describe()
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_graphics_shapes_describe(out var outLen, ref err);
            WeaveFFIError.Check(err);
            var resultBuf = new byte[(int)outLen];
            if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
            NativeMethods.weaveffi_free_bytes(result, outLen);
            var valueReader = new WeaveFFIBufferReader(resultBuf);
            var value = Canvas.ReadFrom(valueReader);
            valueReader.ExpectEnd();
            return value;
        }

    }

    public static class GraphicsShapesGeometry
    {
        /// <summary>Deeper function taking an ancestor-module struct. Throws through the root module's inherited GraphicsError domain.</summary>
        /// <exception cref="GraphicsException">Thrown when the call reports a GraphicsError code.</exception>
        public static Detail Compute(Shape shape)
        {
            var err = new WeaveFFIError();
            var shapeWriter = new WeaveFFIBufferWriter();
            shape.WriteTo(shapeWriter);
            var shapeBuf = shapeWriter.ToArray();
            var shapePin = GCHandle.Alloc(shapeBuf, GCHandleType.Pinned);
            try
            {
                var result = NativeMethods.weaveffi_graphics_shapes_geometry_compute(shapePin.AddrOfPinnedObject(), (UIntPtr)shapeBuf.Length, out var outLen, ref err);
                WeaveFFIError.CheckGraphics(err);
                var resultBuf = new byte[(int)outLen];
                if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
                NativeMethods.weaveffi_free_bytes(result, outLen);
                var valueReader = new WeaveFFIBufferReader(resultBuf);
                var value = Detail.ReadFrom(valueReader);
                valueReader.ExpectEnd();
                return value;
            }
            finally
            {
                shapePin.Free();
            }
        }

    }

}

