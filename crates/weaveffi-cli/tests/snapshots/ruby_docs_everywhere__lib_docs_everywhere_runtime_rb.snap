# Generated by WeaveFFI [VERSION] from api.yml
# DO NOT EDIT. Your changes will be overwritten.
# To regenerate: weaveffi generate api.yml -o <out>

# frozen_string_literal: true

require 'ffi'
require 'monitor'

# The fixed runtime every generated DocsEverywhere binding builds on: the native
# library loader, the load-time ABI check, the error classes, the
# value-buffer reader and writer, cancel tokens, the handle table behind
# callback interfaces and async completions, and the object wrapper base.
module DocsEverywhere
  extend FFI::Library

  # An explicit path in DOCS_EVERYWHERE_LIBRARY wins. Otherwise a library bundled
  # under lib/native/ (a platform gem) is preferred over the system search
  # path.
  _wv_override = ENV['DOCS_EVERYWHERE_LIBRARY']
  if _wv_override && !_wv_override.empty?
    ffi_lib _wv_override
  else
    _wv_name =
      case FFI::Platform::OS
      when /darwin/ then 'libdocs_everywhere.dylib'
      when /mswin|mingw|windows/ then 'docs_everywhere.dll'
      else 'libdocs_everywhere.so'
      end
    _wv_bundled = File.expand_path(File.join('..', 'native', _wv_name), __dir__)
    ffi_lib(File.exist?(_wv_bundled) ? _wv_bundled : _wv_name)
  end

  # The C ABI revision these bindings speak. Checked before anything else is
  # attached, so a mismatched library fails at require time instead of
  # misreading an error struct or a value buffer later.
  ABI_VERSION = 3
  begin
    attach_function :docs_everywhere_abi_version, [], :uint32
  rescue FFI::NotFoundError
    raise LoadError, "the loaded docs_everywhere library does not export docs_everywhere_abi_version " \
                     "(these bindings expect ABI revision #{ABI_VERSION})"
  end
  _wv_abi = docs_everywhere_abi_version
  unless _wv_abi == ABI_VERSION
    raise LoadError, "docs_everywhere ABI mismatch: these bindings expect revision #{ABI_VERSION} " \
                     "but the loaded library reports revision #{_wv_abi}"
  end

  # The `docs_everywhere_error` out-parameter every call reports through.
  class ErrorStruct < FFI::Struct
    layout :code, :int32,
           :message, :pointer,
           :payload_ptr, :pointer,
           :payload_len, :size_t
  end

  # Codes reserved by the runtime. Positive codes belong to a module's error
  # domain; these negative codes are raised as a plain Error (or Cancelled)
  # regardless of whether the function declares errors.
  GENERIC_ERROR_CODE = -1
  PANIC_ERROR_CODE = -2
  MARSHAL_ERROR_CODE = -3
  # A callback-interface implementation raised; the message carries the
  # exception text.
  FOREIGN_ERROR_CODE = -4
  # The call was cancelled through its CancelToken.
  CANCELLED_ERROR_CODE = -5

  # The base class of every error the library raises.
  class Error < StandardError
    # The ABI error code: positive for a domain error, negative for a runtime
    # failure.
    attr_reader :code

    def initialize(code, message)
      @code = code
      super(message)
    end
  end

  # Raised when a cancellable call completes because its CancelToken fired.
  class Cancelled < Error
    def initialize(message = 'cancelled')
      super(CANCELLED_ERROR_CODE, message)
    end
  end

  attach_function :docs_everywhere_error_set, [:pointer, :int32, :string], :void
  attach_function :docs_everywhere_error_clear, [:pointer], :void
  attach_function :docs_everywhere_error_free, [:pointer], :void
  attach_function :docs_everywhere_free_bytes, [:pointer, :size_t], :void
  attach_function :docs_everywhere_cancel_token_create, [], :pointer
  attach_function :docs_everywhere_cancel_token_cancel, [:pointer], :void
  attach_function :docs_everywhere_cancel_token_is_cancelled, [:pointer], :bool
  attach_function :docs_everywhere_cancel_token_destroy, [:pointer], :void

  # @api private
  # The error for a code outside any declared domain.
  def self._wv_error(code, message)
    return Cancelled.new(message.empty? ? 'cancelled' : message) if code == CANCELLED_ERROR_CODE

    Error.new(code, message)
  end

  # @api private
  # Copies the code, message, and payload out of a reported error and clears
  # it. Returns nil when the struct reports success.
  def self._wv_take_error(err)
    code = err[:code]
    return nil if code.zero?

    msg_ptr = err[:message]
    message = msg_ptr.null? ? '' : msg_ptr.read_string.force_encoding(Encoding::UTF_8)
    payload_ptr = err[:payload_ptr]
    payload = payload_ptr.null? ? nil : payload_ptr.read_string(err[:payload_len])
    docs_everywhere_error_clear(err.to_ptr)
    [code, message, payload]
  end

  # @api private
  # Like _wv_take_error for the heap-boxed error an async completion
  # receives; the box is released with docs_everywhere_error_free.
  def self._wv_take_boxed_error(err_ptr)
    return nil if err_ptr.null?

    taken = _wv_take_error(ErrorStruct.new(err_ptr))
    docs_everywhere_error_free(err_ptr)
    taken
  end

  # @api private
  # Raises the generic error for a call that declares no error domain.
  def self.check_error!(err)
    taken = _wv_take_error(err)
    return if taken.nil?

    raise _wv_error(taken[0], taken[1])
  end

  # @api private
  # The UTF-8 bytes of a String argument, as a private binary copy the
  # producer borrows for the call.
  def self._wv_str(value)
    value.to_s.encode(Encoding::UTF_8).b
  end

  # @api private
  # A private binary copy of a bytes argument.
  def self._wv_bytes(value)
    value.to_s.b
  end

  # @api private
  # Copies a borrowed (ptr, len) run without releasing it.
  def self._wv_borrow_bytes(ptr, len)
    ptr.null? || len.zero? ? ''.b : ptr.read_string(len)
  end

  # @api private
  # Copies a returned (ptr, len) allocation, then releases it.
  def self._wv_take_bytes(ptr, len)
    return ''.b if ptr.null?

    data = len.zero? ? ''.b : ptr.read_string(len)
    docs_everywhere_free_bytes(ptr, len)
    data
  end

  # @api private
  # Copies a returned UTF-8 string, then releases it.
  def self._wv_take_string(ptr, len)
    _wv_take_bytes(ptr, len).force_encoding(Encoding::UTF_8)
  end

  # A cancellation signal for a cancellable async call. Pass one as the
  # `cancel:` keyword, then call #cancel from any thread; the call raises
  # Cancelled unless it already completed. A token may be shared by several
  # calls and stays cancelled once cancelled.
  class CancelToken
    # @api private
    # Owns the consumer's reference to the native token.
    class Ptr < FFI::AutoPointer
      def self.release(ptr)
        DocsEverywhere.docs_everywhere_cancel_token_destroy(ptr)
      end
    end

    def initialize
      @ptr = Ptr.new(DocsEverywhere.docs_everywhere_cancel_token_create)
    end

    # Requests cancellation. Idempotent.
    def cancel
      DocsEverywhere.docs_everywhere_cancel_token_cancel(@ptr) unless @ptr.nil?
      nil
    end

    # Whether #cancel has been called.
    def cancelled?
      !@ptr.nil? && DocsEverywhere.docs_everywhere_cancel_token_is_cancelled(@ptr)
    end

    # Releases the native token now rather than at GC time. Calls already
    # launched with it keep their own reference.
    def close
      return if @ptr.nil?

      @ptr.free
      @ptr = nil
    end

    # @api private
    def _wv_ptr
      raise Error.new(GENERIC_ERROR_CODE, 'CancelToken used after close') if @ptr.nil?

      @ptr
    end
  end

  # @api private
  # Appends values in the value-buffer wire format: little-endian, packed,
  # no alignment.
  class WvBufferWriter
    def initialize
      @buf = +''.b
      @objects = []
    end

    # Reserves an object token. The strong reference it carries is minted
    # by #seal, just before the buffer is handed to the producer, so an
    # encoding abandoned on the way never strands a reference.
    def write_object(object)
      raise TypeError, "expected a wrapper object, got #{object.class}" unless object.is_a?(WvObject)

      @objects << [@buf.bytesize, object]
      write_u64(0)
    end

    # Mints the reference each reserved object token carries, recording it
    # in `minted`, and returns the finished encoding.
    def seal(minted)
      @objects.each do |offset, object|
        ptr = object._wv_clone_ptr
        minted << [object.class, ptr]
        @buf[offset, 8] = [ptr.address].pack('Q<')
      end
      @buf
    end

    # Every append is a binary String, so the buffer stays binary and byte
    # offsets index it directly.
    def write_bool(value)
      @buf << [value ? 1 : 0].pack('C')
    end

    def write_flag(value)
      write_bool(value)
    end

    def write_i8(value)
      @buf << [value].pack('c')
    end

    def write_u8(value)
      @buf << [value].pack('C')
    end

    def write_i16(value)
      @buf << [value].pack('s<')
    end

    def write_u16(value)
      @buf << [value].pack('S<')
    end

    def write_i32(value)
      @buf << [value].pack('l<')
    end

    def write_u32(value)
      @buf << [value].pack('L<')
    end

    def write_len(value)
      write_u32(value)
    end

    def write_i64(value)
      @buf << [value].pack('q<')
    end

    def write_u64(value)
      @buf << [value].pack('Q<')
    end

    def write_f32(value)
      @buf << [value].pack('e')
    end

    def write_f64(value)
      @buf << [value].pack('E')
    end

    def write_string(value)
      write_bytes(value.to_s.encode(Encoding::UTF_8))
    end

    def write_bytes(value)
      bytes = value.to_s.b
      write_u32(bytes.bytesize)
      @buf << bytes
    end
  end

  # @api private
  # Reads values in the value-buffer wire format, raising Error on any
  # malformed buffer.
  class WvBufferReader
    def initialize(data)
      @data = data.to_s.b
      @pos = 0
    end

    def take(count, what)
      if @pos + count > @data.bytesize
        raise Error.new(MARSHAL_ERROR_CODE, "malformed value buffer: truncated #{what}")
      end

      bytes = @data.byteslice(@pos, count)
      @pos += count
      bytes
    end

    def read_bool
      byte = take(1, 'bool').unpack1('C')
      raise Error.new(MARSHAL_ERROR_CODE, 'malformed value buffer: bool byte out of range') if byte > 1

      byte == 1
    end

    def read_flag
      byte = take(1, 'option flag').unpack1('C')
      raise Error.new(MARSHAL_ERROR_CODE, 'malformed value buffer: option flag out of range') if byte > 1

      byte == 1
    end

    def read_i8
      take(1, 'i8').unpack1('c')
    end

    def read_u8
      take(1, 'u8').unpack1('C')
    end

    def read_i16
      take(2, 'i16').unpack1('s<')
    end

    def read_u16
      take(2, 'u16').unpack1('S<')
    end

    def read_i32
      take(4, 'i32').unpack1('l<')
    end

    def read_u32
      take(4, 'u32').unpack1('L<')
    end

    # A u32 element count. Counts are not checked against the remaining
    # bytes, since an element can encode to zero bytes; a short buffer still
    # fails on the first truncated read.
    def read_len
      read_u32
    end

    def read_i64
      take(8, 'i64').unpack1('q<')
    end

    def read_u64
      take(8, 'u64').unpack1('Q<')
    end

    def read_f32
      take(4, 'f32').unpack1('e')
    end

    def read_f64
      take(8, 'f64').unpack1('E')
    end

    def read_string
      text = read_bytes.force_encoding(Encoding::UTF_8)
      raise Error.new(MARSHAL_ERROR_CODE, 'malformed value buffer: string is not valid UTF-8') unless text.valid_encoding?

      text
    end

    def read_bytes
      take(read_u32, 'byte run')
    end

    # An object token: a non-zero u64 carrying one strong reference the
    # caller adopts into a wrapper.
    def read_object_token
      addr = read_u64
      raise Error.new(MARSHAL_ERROR_CODE, 'malformed value buffer: null object token') if addr.zero?

      FFI::Pointer.new(addr)
    end

    def expect_end!
      return if @pos == @data.bytesize

      raise Error.new(MARSHAL_ERROR_CODE, 'malformed value buffer: trailing bytes after value')
    end
  end

  # @api private
  # Seals the writers of one call's object-carrying buffers (see
  # WvBufferWriter#seal) and returns their encodings. If any reference can't
  # be minted (a closed wrapper), the ones already minted are released before
  # the error propagates. The producer adopts every minted reference once the
  # call is made.
  def self._wv_seal(*writers)
    minted = []
    writers.map { |writer| writer.seal(minted) }
  rescue Exception # rubocop:disable Lint/RescueException
    minted.each { |cls, ptr| cls::WV_PTR.release(ptr) }
    raise
  end

  # @api private
  # Decodes a returned value buffer: copies and releases it, yields a reader
  # to the block, and checks that the block consumed every byte.
  def self._wv_decode(ptr, len)
    reader = WvBufferReader.new(_wv_take_bytes(ptr, len))
    value = yield reader
    reader.expect_end!
    value
  end

  # Ruby objects the producer refers to by an integer key: callback-interface
  # implementations (the key is the vtable `ctx`) and pending async
  # completions (the key is the completion `context`). The producer never
  # sees a Ruby object address. A Monitor rather than a Mutex, so a
  # finalizer that runs while this thread holds the lock can't deadlock it.
  @wv_handles = {}
  @wv_next_handle = 0
  @wv_handles_lock = Monitor.new

  # @api private
  def self._wv_handle_put(value)
    @wv_handles_lock.synchronize do
      @wv_next_handle += 1
      @wv_handles[@wv_next_handle] = value
      FFI::Pointer.new(@wv_next_handle)
    end
  end

  # @api private
  def self._wv_handle_get(key)
    @wv_handles_lock.synchronize { @wv_handles[key.address] }
  end

  # @api private
  def self._wv_handle_take(key)
    @wv_handles_lock.synchronize { @wv_handles.delete(key.address) }
  end

  # @api private
  # Registers a callback-interface implementation and returns its `ctx`.
  # Never raises, so nothing can strand the registration between this and
  # the call that hands it to the producer (an unusable implementation fails
  # when the producer calls it, with FOREIGN_ERROR_CODE).
  def self._wv_cb_register(impl)
    _wv_handle_put([:callback, impl])
  end

  # @api private
  # Resolves a trampoline's `ctx` back to the registered implementation.
  def self._wv_cb_lookup(ctx)
    kind, impl = _wv_handle_get(ctx)
    raise Error.new(FOREIGN_ERROR_CODE, 'callback context is not registered') unless kind == :callback

    impl
  end

  # @api private
  # Drops an implementation when the producer releases its last reference.
  def self._wv_cb_free(ctx)
    _wv_handle_take(ctx)
    nil
  end

  # @api private
  # Reports a callback implementation's exception through `out_err`. The
  # producer copies the message.
  def self._wv_cb_fail(out_err, exception)
    message = exception.message.to_s
    message = exception.class.name if message.empty?
    message = message.encode(Encoding::UTF_8, invalid: :replace, undef: :replace).delete("\0")
    docs_everywhere_error_set(out_err, FOREIGN_ERROR_CODE, message)
    nil
  end

  # @api private
  # Registers a pending async call; returns its completion context and the
  # queue its completion is delivered on.
  def self._wv_async_begin
    queue = Queue.new
    [_wv_handle_put([:async, queue]), queue]
  end

  # @api private
  # The queue of the pending call a completion belongs to. Each context
  # completes exactly once, so its entry is removed here.
  def self._wv_async_finish(ctx)
    kind, queue = _wv_handle_take(ctx)
    kind == :async ? queue : Queue.new
  end

  # @api private
  # Blocks until a pending call completes, raising its error. If the wait is
  # interrupted (Thread#raise, Thread#kill, Timeout), the call's token is
  # cancelled before the interruption propagates.
  def self._wv_async_wait(queue, token = nil)
    value =
      begin
        queue.pop
      rescue Exception # rubocop:disable Lint/RescueException
        token&.cancel
        raise
      end
    raise value if value.is_a?(Exception)

    value
  end

  # @api private
  # The base of every interface wrapper. A wrapper owns one strong reference
  # to its native object and releases it exactly once, from #close or (as a
  # backstop) from the GC finalizer of its FFI::AutoPointer. Calls borrow the
  # pointer through #_wv_call, so a #close that races an in-flight call on
  # another thread only releases the reference once the call returns.
  class WvObject
    # @api private
    # Adopts one strong reference the producer handed over.
    def self._from_ptr(ptr)
      obj = allocate
      obj._wv_init(ptr)
      obj
    end

    # @api private
    def _wv_init(ptr)
      @wv_handle = self.class::WV_PTR.new(ptr)
      @wv_lock = Mutex.new
      @wv_calls = 0
      @wv_closing = false
    end

    # The native object pointer (borrowed; valid until #close).
    def handle
      handle = @wv_handle
      raise Error.new(GENERIC_ERROR_CODE, "#{self.class.name} used after close") if handle.nil? || @wv_closing

      handle
    end

    # Whether #close has released this wrapper's reference.
    def closed?
      @wv_handle.nil? || @wv_closing
    end

    # Releases this wrapper's reference now rather than at GC time.
    # Idempotent. The object itself lives until its last reference anywhere
    # (another wrapper, a record field, the producer) goes.
    def close
      handle = @wv_lock.synchronize do
        next nil if @wv_handle.nil? || @wv_closing

        if @wv_calls.zero?
          taken = @wv_handle
          @wv_handle = nil
          taken
        else
          @wv_closing = true
          nil
        end
      end
      handle&.free
      nil
    end

    # @api private
    # Yields the native pointer, keeping the reference alive until the block
    # returns.
    def _wv_call
      handle = @wv_lock.synchronize do
        raise Error.new(GENERIC_ERROR_CODE, "#{self.class.name} used after close") if @wv_handle.nil? || @wv_closing

        @wv_calls += 1
        @wv_handle
      end
      begin
        yield handle
      ensure
        _wv_leave
      end
    end

    # @api private
    # Mints a new strong reference the caller owns (an object written into a
    # value buffer carries its own reference).
    def _wv_clone_ptr
      _wv_call { |ptr| self.class._wv_clone(ptr) }
    end

    # dup and clone produce an independent wrapper with its own reference to
    # the same object.
    def initialize_copy(other)
      super
      _wv_init(other._wv_clone_ptr)
    end

    private

    def _wv_leave
      release = @wv_lock.synchronize do
        @wv_calls -= 1
        next nil unless @wv_closing && @wv_calls.zero?

        taken = @wv_handle
        @wv_handle = nil
        @wv_closing = false
        taken
      end
      release&.free
    end
  end

  # @api private
  # Yields the native pointers of `objects` (NULL for nil), each kept alive
  # until the block returns.
  def self._wv_pin(*objects, &block)
    _wv_pin_from(objects, 0, [], &block)
  end

  # @api private
  def self._wv_pin_from(objects, index, pointers, &block)
    return yield(*pointers) if index == objects.length

    object = objects[index]
    if object.nil?
      _wv_pin_from(objects, index + 1, pointers + [FFI::Pointer::NULL], &block)
    else
      object._wv_call { |ptr| _wv_pin_from(objects, index + 1, pointers + [ptr], &block) }
    end
  end

  # @api private
  # Checks each top-level module's contract checksum (`module name =>
  # [checksum function, expected value]`) against the library, so bindings
  # generated from a different API fail at require time.
  def self._wv_check_contract!(checksums)
    checksums.each do |mod, (symbol, expected)|
      begin
        attach_function symbol, [], :uint64
      rescue FFI::NotFoundError
        raise LoadError, "the loaded docs_everywhere library has no module '#{mod}' (#{symbol} is missing)"
      end
      actual = public_send(symbol)
      next if actual == expected

      raise LoadError, "docs_everywhere module '#{mod}' does not match these bindings: expected contract " \
                       "checksum 0x#{expected.to_s(16)}, the library reports 0x#{actual.to_s(16)}; " \
                       'regenerate the bindings'
    end
  end

  # @api private
  # Live native resources of one kind (0 objects, 1 callbacks, 2 iterators,
  # 3 cancel tokens, 4 byte allocations). Only libraries built with the
  # `leak-check` feature export the counter.
  def self._wv_debug_live(kind)
    unless respond_to?(:docs_everywhere_debug_live)
      begin
        attach_function :docs_everywhere_debug_live, [:int32], :uint64
      rescue FFI::NotFoundError
        raise Error.new(GENERIC_ERROR_CODE, 'docs_everywhere was built without the leak-check feature')
      end
    end
    docs_everywhere_debug_live(kind)
  end
end

# END runtime.rb
