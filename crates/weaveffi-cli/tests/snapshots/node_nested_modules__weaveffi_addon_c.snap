static napi_value Init(napi_env env, napi_value exports) {
  {
    uint32_t found = weaveffi_abi_version();
    if (found != WEAVEFFI_ABI_VERSION) {
      char msg[160];
      snprintf(msg, sizeof msg, "WeaveFFI ABI mismatch: these bindings expect revision %u but the loaded library reports revision %u", (unsigned)WEAVEFFI_ABI_VERSION, (unsigned)found);
      napi_throw_error(env, NULL, msg);
      return NULL;
    }
  }
  napi_property_descriptor props[] = {
    { "newCanvas", NULL, Napi_weaveffi_graphics_new_canvas, NULL, NULL, NULL, napi_default, NULL },
    { "makeShape", NULL, Napi_weaveffi_graphics_shapes_make_shape, NULL, NULL, NULL, napi_default, NULL },
    { "describe", NULL, Napi_weaveffi_graphics_shapes_describe, NULL, NULL, NULL, napi_default, NULL },
    { "compute", NULL, Napi_weaveffi_graphics_shapes_geometry_compute, NULL, NULL, NULL, napi_default, NULL },
  };
  napi_define_properties(env, exports, 4, props);
  return exports;
}

