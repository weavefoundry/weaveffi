        let rv: UnsafePointer<CChar>? = s.withCString { s_ptr in
            return weaveffi_kitchen_echo_string(s_ptr, &err)
        }
        trap(&err)
        guard let rv = rv else { fatalError("-1: null string") }
        defer { weaveffi_free_string(rv) }
        return String(cString: rv)
    }
    public static func echoBytes(b: Data) -> Data {
        var err = weaveffi_error(code: 0, message: nil, payload_ptr: nil, payload_len: 0)
        let bBytes = Array(b)
        var outLen: Int = 0
        let rv: UnsafePointer<UInt8>? = bBytes.withUnsafeBufferPointer { b_buf in
            let b_ptr = b_buf.baseAddress
            let b_len = b_buf.count
            return weaveffi_kitchen_echo_bytes(b_ptr, b_len, &outLen, &err)
        }
        trap(&err)
        guard let rv = rv else { return Data() }
        defer { weaveffi_free_bytes(UnsafeMutablePointer(mutating: rv), outLen) }
        return Data(bytes: rv, count: outLen)
    }
    /// Register a listener, returning how many are attached
    public static func subscribe(listener: ReadyListener) -> Int32 {
        var err = weaveffi_error(code: 0, message: nil, payload_ptr: nil, payload_len: 0)
        let listener_ctx = Unmanaged.passRetained(WvReadyListenerBox(listener)).toOpaque()
        let rv = weaveffi_kitchen_subscribe(listener_ctx, WvReadyListenerVtable.pointer, &err)
        trap(&err)
        return rv
    }
