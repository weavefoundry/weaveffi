/// A reusable token referenced across modules
public struct Token {
    public var id: Int64
    public var label: String

    /// Creates a `Token` value.
    public init(id: Int64, label: String) {
        self.id = id
        self.label = label
    }
}

/// Serializes a `Token` into the value-buffer wire format.
func wvWriteToken(_ value: Token, into w: inout WvWriter) {
    w.writeInt64(value.id)
    w.writeString(value.label)
}

/// Deserializes a `Token` from the value-buffer wire format.
func wvReadToken(_ r: inout WvReader) -> Token {
    let v0 = r.readInt64()
    let v1 = r.readString()
    return Token(id: v0, label: v1)
}

