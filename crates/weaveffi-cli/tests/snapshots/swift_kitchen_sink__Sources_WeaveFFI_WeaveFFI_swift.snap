    public static func maybeGadget(fallback: Gadget?) -> Gadget? {
        var err = weaveffi_error(code: 0, message: nil, payload_ptr: nil, payload_len: 0)
        let rv = weaveffi_kitchen_maybe_gadget(fallback?.ptr, &err)
