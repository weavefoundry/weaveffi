        case .notFound: return 1
        case .invalidInput: return 2
        }
    }
}

@inline(__always)
func mapKitchen(code: Int32, message: String, payload: [UInt8]?) -> Error {
    switch code {
    case 1: return KitchenErrorsError.notFound(message: message.isEmpty ? "Item not found" : message)
    case 2: return KitchenErrorsError.invalidInput(message: message.isEmpty ? "Invalid input" : message)
    default: return WeaveFFIError.error(code: code, message: message)
    }
}

@inline(__always)
func checkKitchen(_ err: inout weaveffi_error) throws {
    if err.code != 0 {
        let code = err.code
        let message = err.message.flatMap { String(cString: $0) } ?? ""
        let payload: [UInt8]? = err.payload_ptr.map { [UInt8](UnsafeBufferPointer(start: $0, count: err.payload_len)) }
        weaveffi_error_clear(&err)
        throw mapKitchen(code: code, message: message, payload: payload)
    }
}

/// Task priority levels
public enum Priority: UInt32 {
    /// Low priority
    case low = 0
    /// Normal priority
    case normal = 1
    /// High priority
    case high = 2
}

/// Kitchen sink struct exercising every field feature
public struct Item {
    /// Stable identifier
    public var id: Int64
    /// Display name
    public var name: String
    /// Initial count
    public var count: Int32
    /// Whether the item is enabled
    public var enabled: Bool
    /// Scaling ratio
    public var ratio: Double
    public var nick: UInt32
    public var payload: Data
    public var tags: [String]
    public var attrs: [String: String]
    public var parent: Int64?
    /// Cross-module struct reference
    public var token: Token
    public var priority: Priority

    /// Creates a `Item` value.
    public init(id: Int64, name: String, count: Int32, enabled: Bool, ratio: Double, nick: UInt32, payload: Data, tags: [String], attrs: [String: String], parent: Int64?, token: Token, priority: Priority) {
        self.id = id
        self.name = name
        self.count = count
        self.enabled = enabled
        self.ratio = ratio
        self.nick = nick
        self.payload = payload
        self.tags = tags
        self.attrs = attrs
        self.parent = parent
        self.token = token
        self.priority = priority
    }
}

/// Serializes a `Item` into the value-buffer wire format.
func wvWriteItem(_ value: Item, into w: inout WvWriter) {
    w.writeInt64(value.id)
    w.writeString(value.name)
    w.writeInt32(value.count)
    w.writeBool(value.enabled)
    w.writeDouble(value.ratio)
    w.writeUInt32(value.nick)
    w.writeBytes(value.payload)
    w.writeLen(value.tags.count)
    for v0 in value.tags {
        w.writeString(v0)
    }
    w.writeLen(value.attrs.count)
    for (v1, v2) in value.attrs {
        w.writeString(v1)
        w.writeString(v2)
    }
    if let v3 = value.parent {
        w.writeOptionFlag(true)
        w.writeInt64(v3)
    } else {
        w.writeOptionFlag(false)
    }
    wvWriteToken(value.token, into: &w)
    w.writeInt32(Int32(bitPattern: value.priority.rawValue))
}

/// Deserializes a `Item` from the value-buffer wire format.
func wvReadItem(_ r: inout WvReader) -> Item {
    let v4 = r.readInt64()
    let v5 = r.readString()
    let v6 = r.readInt32()
    let v7 = r.readBool()
    let v8 = r.readDouble()
    let v9 = r.readUInt32()
    let v10 = r.readBytes()
    let n12 = r.readLen()
    var v11: [String] = []
    v11.reserveCapacity(n12)
    for _ in 0..<n12 {
        let v13 = r.readString()
        v11.append(v13)
    }
    let n15 = r.readLen()
    var v14: [String: String] = [:]
    v14.reserveCapacity(n15)
    for _ in 0..<n15 {
        let v16 = r.readString()
        let v17 = r.readString()
        v14[v16] = v17
    }
    var v18: Int64? = nil
    if r.readOptionFlag() {
        let v19 = r.readInt64()
        v18 = v19
    }
    let v20 = wvReadToken(&r)
    let v21 = Priority(rawValue: UInt32(bitPattern: r.readInt32()))!
    return Item(id: v4, name: v5, count: v6, enabled: v7, ratio: v8, nick: v9, payload: v10, tags: v11, attrs: v14, parent: v18, token: v20, priority: v21)
}

