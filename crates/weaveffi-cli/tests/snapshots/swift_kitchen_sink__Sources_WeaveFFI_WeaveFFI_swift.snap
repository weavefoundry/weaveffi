    public var token: Token
    public var priority: Priority
    /// An optional object inside a record
    public var gadget: Gadget?

    /// Creates a `Item` value.
    public init(id: Int64, name: String, count: Int32, enabled: Bool, ratio: Double, nick: UInt32, payload: Data, tags: [String], attrs: [String: String], parent: Int64?, token: Token, priority: Priority, gadget: Gadget?) {
        self.id = id
        self.name = name
        self.count = count
        self.enabled = enabled
        self.ratio = ratio
        self.nick = nick
        self.payload = payload
        self.tags = tags
        self.attrs = attrs
        self.parent = parent
        self.token = token
        self.priority = priority
        self.gadget = gadget
    }
}

/// Serializes a `Item` into the value-buffer wire format.
func wvWriteItem(_ value: Item, into w: inout WvWriter) {
    w.writeInt64(value.id)
    w.writeString(value.name)
    w.writeInt32(value.count)
    w.writeBool(value.enabled)
    w.writeDouble(value.ratio)
    w.writeUInt32(value.nick)
    w.writeBytes(value.payload)
    w.writeLen(value.tags.count)
    for v0 in value.tags {
        w.writeString(v0)
    }
    w.writeLen(value.attrs.count)
    for (v1, v2) in value.attrs {
        w.writeString(v1)
        w.writeString(v2)
    }
    if let v3 = value.parent {
        w.writeOptionFlag(true)
        w.writeInt64(v3)
    } else {
        w.writeOptionFlag(false)
    }
    wvWriteToken(value.token, into: &w)
    w.writeInt32(Int32(bitPattern: value.priority.rawValue))
    if let v4 = value.gadget {
        w.writeOptionFlag(true)
        w.writeObject(v4.clonePtr())
    } else {
        w.writeOptionFlag(false)
    }
}

/// Deserializes a `Item` from the value-buffer wire format.
func wvReadItem(_ r: inout WvReader) -> Item {
    let v5 = r.readInt64()
    let v6 = r.readString()
    let v7 = r.readInt32()
    let v8 = r.readBool()
    let v9 = r.readDouble()
    let v10 = r.readUInt32()
    let v11 = r.readBytes()
    let n13 = r.readLen()
    var v12: [String] = []
    v12.reserveCapacity(n13)
    for _ in 0..<n13 {
        let v14 = r.readString()
        v12.append(v14)
    }
    let n16 = r.readLen()
    var v15: [String: String] = [:]
    v15.reserveCapacity(n16)
    for _ in 0..<n16 {
        let v17 = r.readString()
        let v18 = r.readString()
        v15[v17] = v18
    }
    var v19: Int64? = nil
    if r.readOptionFlag() {
        let v20 = r.readInt64()
        v19 = v20
    }
    let v21 = wvReadToken(&r)
    let v22 = Priority(rawValue: UInt32(bitPattern: r.readInt32()))!
    var v23: Gadget? = nil
    if r.readOptionFlag() {
        let v24 = Gadget(ptr: r.readObject())
        v23 = v24
    }
    return Item(id: v5, name: v6, count: v7, enabled: v8, ratio: v9, nick: v10, payload: v11, tags: v12, attrs: v15, parent: v19, token: v21, priority: v22, gadget: v23)
}

/// Consumer-implemented observer of ready items
///
/// Implement this protocol and pass the value where the API expects it; the
/// producer keeps it alive for as long as it holds the callback and may call
/// any method from any thread. A thrown error aborts the producer's call and
/// surfaces to the original caller as a foreign error (code -4).
public protocol ReadyListener {
    /// Fires when an item is ready
    func onReady(code: Int32, msg: String) throws
    /// Receives the item itself and says whether to keep listening
    func onItem(item: Item, gadget: Gadget) throws -> Bool
}

/// Retains one `ReadyListener` implementation across the C boundary; the producer's
/// `free` entry releases it.
final class WvReadyListenerBox {
    let impl: any ReadyListener
    init(_ impl: any ReadyListener) { self.impl = impl }
}

/// The process-wide `weaveffi_kitchen_ReadyListener_vtable` the producer calls `ReadyListener`
/// implementations through. Every entry recovers the box from `ctx`, copies
/// or adopts its arguments, and reports a thrown error through `out_err`
/// instead of unwinding.
enum WvReadyListenerVtable {
    static let value = weaveffi_kitchen_ReadyListener_vtable(
        on_ready: { ctx, code, msg, out_err in
            let wvBox = Unmanaged<WvReadyListenerBox>.fromOpaque(ctx!).takeUnretainedValue()
            do {
                try wvBox.impl.onReady(code: code, msg: String(cString: msg!))
            } catch {
                wvForeignError(out_err, error)
            }
        },
        on_item: { ctx, item_ptr, item_len, gadget, out_err in
            let wvBox = Unmanaged<WvReadyListenerBox>.fromOpaque(ctx!).takeUnretainedValue()
            let b0 = [UInt8](UnsafeBufferPointer(start: item_ptr, count: item_len))
            var r1 = WvReader(bytes: b0)
            let v2 = wvReadItem(&r1)
            r1.finish()
            do {
                return try wvBox.impl.onItem(item: v2, gadget: Gadget(ptr: gadget!))
            } catch {
                wvForeignError(out_err, error)
                return false
            }
        },
        free: { ctx in
            Unmanaged<WvReadyListenerBox>.fromOpaque(ctx!).release()
        }
    )
    static let pointer: UnsafePointer<weaveffi_kitchen_ReadyListener_vtable> = {
        let cell = UnsafeMutablePointer<weaveffi_kitchen_ReadyListener_vtable>.allocate(capacity: 1)
        cell.initialize(to: value)
        return UnsafePointer(cell)
    }()
}

/// A pocket-sized interface exercising the object surface
public final class Gadget {
    let ptr: OpaquePointer

    init(ptr: OpaquePointer) {
        self.ptr = ptr
    }

    deinit {
        weaveffi_kitchen_Gadget_destroy(ptr)
    }

    /// Returns a new strong reference to the same object, for a position that
    /// takes ownership of it (an object token inside a value buffer).
    func clonePtr() -> OpaquePointer {
        weaveffi_kitchen_Gadget_clone(ptr)!
    }
    /// Create a gadget with the given id
