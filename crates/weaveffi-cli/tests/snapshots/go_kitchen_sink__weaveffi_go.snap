// The ABI revision these bindings were generated against.
const wvABIVersion uint32 = 2

func init() {
	if found := uint32(C.weaveffi_abi_version()); found != wvABIVersion {
		panic(fmt.Sprintf("WeaveFFI ABI mismatch: these bindings expect revision %d but the loaded library reports revision %d", wvABIVersion, found))
	}
}

func boolToC(b bool) C._Bool {
	return C._Bool(b)
}

func cToBool(b C._Bool) bool {
	return bool(b)
}

// WeaveFFIError reports a failure crossing the C boundary that no typed
// error domain claims: an unknown code, a marshalling failure, a
// producer panic (code -2), or a Go callback-interface implementation
// that panicked (code -4).
type WeaveFFIError struct {
	// Code is the numeric ABI error code.
	Code int32
	// Message is the human-readable error message.
	Message string
}

func (e *WeaveFFIError) Error() string {
	return fmt.Sprintf("weaveffi: %s (code %d)", e.Message, e.Code)
}

// wvTakeError reads and clears a non-zero C error slot, returning its
// code, message, and a copy of its structured payload buffer (nil when
// the code declares no payload fields).
func wvTakeError(cErr *C.weaveffi_error) (int32, string, []byte) {
	code := int32(cErr.code)
	msg := ""
	if cErr.message != nil {
		msg = C.GoString(cErr.message)
	}
	var payload []byte
	if cErr.payload_ptr != nil {
		payload = C.GoBytes(unsafe.Pointer(cErr.payload_ptr), C.int(cErr.payload_len))
	}
	C.weaveffi_error_clear(cErr)
	return code, msg, payload
}

// wvTakeBoxedError reads a heap-boxed error delivered to an async
// completion callback and releases the box with weaveffi_error_free.
func wvTakeBoxedError(cErr *C.weaveffi_error) (int32, string, []byte) {
	code := int32(cErr.code)
	msg := ""
	if cErr.message != nil {
		msg = C.GoString(cErr.message)
	}
	var payload []byte
	if cErr.payload_ptr != nil {
		payload = C.GoBytes(unsafe.Pointer(cErr.payload_ptr), C.int(cErr.payload_len))
	}
	C.weaveffi_error_free(cErr)
	return code, msg, payload
}

func wvBrandError(code int32, message string, _ []byte) error {
	return &WeaveFFIError{Code: code, Message: message}
}

// wvTrap panics when the C error slot reports a failure. Non-throwing
// wrappers check their slot with it: a non-zero code there can only be
// a producer panic, a marshalling failure, or a callback-interface
// implementation that panicked. The panic value is a *WeaveFFIError, so a
// recover() site can still inspect the code.
func wvTrap(cErr *C.weaveffi_error) {
	if cErr.code != 0 {
		panic(wvBrandError(wvTakeError(cErr)))
	}
}

// wvWriter serializes values into the WeaveFFI value-buffer format:
// little-endian, packed, u32 length prefixes.
type wvWriter struct {
	buf []byte
}

func (w *wvWriter) writeBool(v bool) {
	if v {
		w.buf = append(w.buf, 1)
	} else {
		w.buf = append(w.buf, 0)
	}
}

func (w *wvWriter) writeI8(v int8) {
	w.buf = append(w.buf, byte(v))
}

func (w *wvWriter) writeU8(v uint8) {
	w.buf = append(w.buf, v)
}

func (w *wvWriter) writeI16(v int16) {
	w.buf = binary.LittleEndian.AppendUint16(w.buf, uint16(v))
}

func (w *wvWriter) writeU16(v uint16) {
	w.buf = binary.LittleEndian.AppendUint16(w.buf, v)
}

func (w *wvWriter) writeI32(v int32) {
	w.buf = binary.LittleEndian.AppendUint32(w.buf, uint32(v))
}

func (w *wvWriter) writeU32(v uint32) {
	w.buf = binary.LittleEndian.AppendUint32(w.buf, v)
}

func (w *wvWriter) writeI64(v int64) {
	w.buf = binary.LittleEndian.AppendUint64(w.buf, uint64(v))
}

func (w *wvWriter) writeU64(v uint64) {
	w.buf = binary.LittleEndian.AppendUint64(w.buf, v)
}

func (w *wvWriter) writeF32(v float32) {
	w.writeU32(math.Float32bits(v))
}

func (w *wvWriter) writeF64(v float64) {
	w.writeU64(math.Float64bits(v))
}

func (w *wvWriter) writeLen(n int) {
	if n < 0 || uint64(n) > uint64(^uint32(0)) {
		panic("weaveffi: value-buffer length exceeds u32 range")
	}
	w.writeU32(uint32(n))
}

func (w *wvWriter) writeString(v string) {
	w.writeLen(len(v))
	w.buf = append(w.buf, v...)
}

func (w *wvWriter) writeBytes(v []byte) {
	w.writeLen(len(v))
	w.buf = append(w.buf, v...)
}

func (w *wvWriter) writeOptionFlag(present bool) {
	w.writeBool(present)
}

// wvReader decodes values from the WeaveFFI value-buffer format. A
// malformed buffer is a producer/consumer contract violation, so every
// read panics (the same channel a trapped producer error uses) instead
// of returning a typed domain error.
type wvReader struct {
	buf []byte
	pos int
}

func wvMalformed(context string) {
	panic("weaveffi: malformed value buffer: " + context)
}

func (r *wvReader) take(n int, context string) []byte {
	if n < 0 || len(r.buf)-r.pos < n {
		wvMalformed(context)
	}
	b := r.buf[r.pos : r.pos+n]
	r.pos += n
	return b
}

func (r *wvReader) readBool() bool {
	switch r.take(1, "bool")[0] {
	case 0:
		return false
	case 1:
		return true
	}
	wvMalformed("bool byte out of range")
	return false
}

func (r *wvReader) readI8() int8 {
	return int8(r.take(1, "i8")[0])
}

func (r *wvReader) readU8() uint8 {
	return r.take(1, "u8")[0]
}

func (r *wvReader) readI16() int16 {
	return int16(binary.LittleEndian.Uint16(r.take(2, "i16")))
}

func (r *wvReader) readU16() uint16 {
	return binary.LittleEndian.Uint16(r.take(2, "u16"))
}

func (r *wvReader) readI32() int32 {
	return int32(binary.LittleEndian.Uint32(r.take(4, "i32")))
}

func (r *wvReader) readU32() uint32 {
	return binary.LittleEndian.Uint32(r.take(4, "u32"))
}

func (r *wvReader) readI64() int64 {
	return int64(binary.LittleEndian.Uint64(r.take(8, "i64")))
}

func (r *wvReader) readU64() uint64 {
	return binary.LittleEndian.Uint64(r.take(8, "u64"))
}

func (r *wvReader) readF32() float32 {
	return math.Float32frombits(r.readU32())
}

func (r *wvReader) readF64() float64 {
	return math.Float64frombits(r.readU64())
}

func (r *wvReader) readLen() int {
	n := int(r.readU32())
	if n > len(r.buf)-r.pos {
		wvMalformed("length prefix exceeds remaining buffer")
	}
	return n
}

func (r *wvReader) readString() string {
	b := r.take(r.readLen(), "string bytes")
	if !utf8.Valid(b) {
		wvMalformed("string is not valid UTF-8")
	}
	return string(b)
}

func (r *wvReader) readBytes() []byte {
	b := r.take(r.readLen(), "byte buffer")
	out := make([]byte, len(b))
	copy(out, b)
	return out
}

func (r *wvReader) readOptionFlag() bool {
	switch r.take(1, "option flag")[0] {
	case 0:
		return false
	case 1:
		return true
	}
	wvMalformed("option flag byte out of range")
	return false
}

func (r *wvReader) expectEnd() {
	if r.pos != len(r.buf) {
		wvMalformed("trailing bytes after value")
	}
}

// wvCopyBuffer copies an owned, producer-allocated value buffer into Go
// memory and releases it with weaveffi_free_bytes.
func wvCopyBuffer(ptr *C.uint8_t, length C.size_t) []byte {
	if ptr == nil {
		return nil
	}
	out := C.GoBytes(unsafe.Pointer(ptr), C.int(length))
	C.weaveffi_free_bytes(ptr, length)
	return out
}

// wvBorrowBuffer copies a borrowed value buffer into Go memory. The
// producer keeps ownership and frees it after the borrowing call returns.
func wvBorrowBuffer(ptr *C.uint8_t, length C.size_t) []byte {
	if ptr == nil {
		return nil
	}
	return C.GoBytes(unsafe.Pointer(ptr), C.int(length))
}

// wvForeignError reports a panic recovered inside a callback-interface
// trampoline through the producer's error slot (code -4). The message is
// borrowed for the call: the producer copies it with its own allocator.
func wvForeignError(outErr *C.weaveffi_error, recovered any) {
	msg := C.CString(fmt.Sprint(recovered))
	defer C.free(unsafe.Pointer(msg))
	C.weaveffi_error_set(outErr, -4, msg)
}

// Token: A reusable token referenced across modules
type Token struct {
	Id    int64
	Label string
}

// wvPackToken appends v to w in the value-buffer wire format.
func wvPackToken(w *wvWriter, v Token) {
	w.writeI64(v.Id)
	w.writeString(v.Label)
}

// wvUnpackToken decodes one Token from r.
func wvUnpackToken(r *wvReader) Token {
	var v Token
	v.Id = r.readI64()
	v.Label = r.readString()
	return v
}

// Ping: Trivial cross-module helper
func Ping() string {
	var cErr C.weaveffi_error
	result := C.weaveffi_shared_ping(&cErr)
	wvTrap(&cErr)
	goResult := C.GoString(result)
	C.weaveffi_free_string(result)
	return goResult
}

// KitchenErrorsError is a typed error reported by the `kitchen` module.
type KitchenErrorsError struct {
	// Code is the numeric ABI error code (one of the KitchenErrorsError constants).
	Code int32
	// Message is the human-readable error message.
	Message string
}

func (e *KitchenErrorsError) Error() string {
	return fmt.Sprintf("kitchen: %s (code %d)", e.Message, e.Code)
}

// KitchenErrorsError codes.
const (
	// KitchenErrorsErrorNotFound: Item not found
	KitchenErrorsErrorNotFound int32 = 1
	// KitchenErrorsErrorInvalidInput: Invalid input
	KitchenErrorsErrorInvalidInput int32 = 2
)

// wvMapKitchen converts a non-zero code from the `kitchen` domain into a
// *KitchenErrorsError, falling back to the generic *WeaveFFIError for unknown codes.
func wvMapKitchen(code int32, message string, payload []byte) error {
	switch code {
	case KitchenErrorsErrorNotFound:
		if message == "" {
			message = "Item not found"
		}
		return &KitchenErrorsError{Code: code, Message: message}
	case KitchenErrorsErrorInvalidInput:
		if message == "" {
			message = "Invalid input"
		}
		return &KitchenErrorsError{Code: code, Message: message}
	default:
		return wvBrandError(code, message, payload)
	}
}

// Priority: Task priority levels
type Priority int32

const (
	// PriorityLow: Low priority
	PriorityLow Priority = 0
	// PriorityNormal: Normal priority
	PriorityNormal Priority = 1
	// PriorityHigh: High priority
	PriorityHigh Priority = 2
)

// Item: Kitchen sink struct exercising every field feature
type Item struct {
	// Id: Stable identifier
	Id int64
	// Name: Display name
	Name string
	// Count: Initial count
	Count int32
	// Enabled: Whether the item is enabled
	Enabled bool
	// Ratio: Scaling ratio
	Ratio   float64
	Nick    uint32
	Payload []byte
	Tags    []string
	Attrs   map[string]string
	Parent  *int64
	// Token: Cross-module struct reference
	Token    Token
	Priority Priority
	// Gadget: An optional object inside a record
	Gadget *Gadget
}

// wvPackItem appends v to w in the value-buffer wire format.
func wvPackItem(w *wvWriter, v Item) {
	w.writeI64(v.Id)
	w.writeString(v.Name)
	w.writeI32(v.Count)
	w.writeBool(v.Enabled)
	w.writeF64(v.Ratio)
	w.writeU32(v.Nick)
	w.writeBytes(v.Payload)
	w.writeLen(len(v.Tags))
	for _, eTags0 := range v.Tags {
		w.writeString(eTags0)
	}
	w.writeLen(len(v.Attrs))
	for kAttrs0, vAttrs0 := range v.Attrs {
		w.writeString(kAttrs0)
		w.writeString(vAttrs0)
	}
	if v.Parent == nil {
		w.writeOptionFlag(false)
	} else {
		w.writeOptionFlag(true)
		w.writeI64((*v.Parent))
	}
	wvPackToken(w, v.Token)
	w.writeI32(int32(v.Priority))
	if v.Gadget == nil {
		w.writeOptionFlag(false)
	} else {
		w.writeOptionFlag(true)
		w.writeU64(wvTokenGadget(v.Gadget))
	}
}

// wvUnpackItem decodes one Item from r.
func wvUnpackItem(r *wvReader) Item {
	var v Item
	v.Id = r.readI64()
	v.Name = r.readString()
	v.Count = r.readI32()
	v.Enabled = r.readBool()
	v.Ratio = r.readF64()
	v.Nick = r.readU32()
	v.Payload = r.readBytes()
	nTags0 := r.readLen()
	v.Tags = make([]string, nTags0)
	for iTags0 := range v.Tags {
		v.Tags[iTags0] = r.readString()
	}
	nAttrs0 := r.readLen()
	v.Attrs = make(map[string]string, nAttrs0)
	for iAttrs0 := 0; iAttrs0 < nAttrs0; iAttrs0++ {
		var kAttrs0 string
		kAttrs0 = r.readString()
		var vAttrs0 string
		vAttrs0 = r.readString()
		v.Attrs[kAttrs0] = vAttrs0
	}
	if r.readOptionFlag() {
		var oParent0 int64
		oParent0 = r.readI64()
		v.Parent = &oParent0
	}
	v.Token = wvUnpackToken(r)
	v.Priority = Priority(r.readI32())
	if r.readOptionFlag() {
		var oGadget0 *Gadget
		oGadget0 = wvUntokenGadget(r.readU64())
		v.Gadget = oGadget0
	}
	return v
}

// ReadyListener: Consumer-implemented observer of ready items
//
// Implement this interface in Go and pass the value to native functions
// that accept it.
//
// The native library may call any method from any thread until it releases
// the implementation. A panic in a method is reported to the native caller
// as a foreign error (code -4) instead of crashing the process.
type ReadyListener interface {
	// OnReady: Fires when an item is ready
	OnReady(code int32, msg string)
	// OnItem: Receives the item itself and says whether to keep listening
	OnItem(item Item, gadget *Gadget) bool
}

//export goWv_weaveffi_kitchen_ReadyListener_on_ready
func goWv_weaveffi_kitchen_ReadyListener_on_ready(ctx unsafe.Pointer, code C.int32_t, msg *C.char, out_err *C.weaveffi_error) {
	defer func() {
		if r := recover(); r != nil {
			wvForeignError(out_err, r)
		}
	}()
	impl := cgo.Handle(uintptr(ctx)).Value().(ReadyListener)
	arg0 := int32(code)
	arg1 := ""
	if msg != nil {
		arg1 = C.GoString(msg)
	}
	impl.OnReady(arg0, arg1)
}

//export goWv_weaveffi_kitchen_ReadyListener_on_item
func goWv_weaveffi_kitchen_ReadyListener_on_item(ctx unsafe.Pointer, item_ptr *C.uint8_t, item_len C.size_t, gadget *C.weaveffi_kitchen_Gadget, out_err *C.weaveffi_error) (ret C._Bool) {
	defer func() {
		if r := recover(); r != nil {
			wvForeignError(out_err, r)
		}
	}()
	impl := cgo.Handle(uintptr(ctx)).Value().(ReadyListener)
	rArg0 := &wvReader{buf: wvBorrowBuffer(item_ptr, item_len)}
	var arg0 Item
	arg0 = wvUnpackItem(rArg0)
	rArg0.expectEnd()
	arg1 := wvAdoptGadget(gadget)
	ret = boolToC(impl.OnItem(arg0, arg1))
	return
}

//export goWv_weaveffi_kitchen_ReadyListener_free
func goWv_weaveffi_kitchen_ReadyListener_free(ctx unsafe.Pointer) {
	cgo.Handle(uintptr(ctx)).Delete()
}

// Gadget: A pocket-sized interface exercising the object surface
//
// Each wrapper holds one strong reference; Close releases it, and a
// finalizer releases it if the wrapper is garbage collected first.
type Gadget struct {
	ptr *C.weaveffi_kitchen_Gadget
}

// wvAdoptGadget adopts one owned strong reference into a new wrapper. A null
// pointer adopts to nil.
func wvAdoptGadget(ptr *C.weaveffi_kitchen_Gadget) *Gadget {
	if ptr == nil {
		return nil
	}
	s := &Gadget{ptr: ptr}
	runtime.SetFinalizer(s, (*Gadget).Close)
	return s
}

// wvTokenGadget clones o's reference into a value-buffer object token. The
// wrapper keeps its own reference; the token carries the new one.
func wvTokenGadget(o *Gadget) uint64 {
	if o == nil || o.ptr == nil {
		panic("weaveffi: nil or closed Gadget cannot be encoded in a non-optional position")
	}
	return uint64(uintptr(unsafe.Pointer(C.weaveffi_kitchen_Gadget_clone(o.ptr))))
}

// wvUntokenGadget adopts the strong reference carried by a value-buffer object
// token.
func wvUntokenGadget(token uint64) *Gadget {
	if token == 0 {
		panic("weaveffi: malformed value buffer: null object token")
	}
	return wvAdoptGadget((*C.weaveffi_kitchen_Gadget)(C.wvHandlePtr(C.uintptr_t(token))))
}

// NewGadget: Create a gadget with the given id
func NewGadget(id int64) *Gadget {
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_Gadget_new(C.int64_t(id), &cErr)
	wvTrap(&cErr)
	return wvAdoptGadget(result)
}

// Describe: Render the gadget as a human-readable string
func (s *Gadget) Describe() string {
	if s.ptr == nil {
		panic("weaveffi: Gadget used after Close")
	}
	defer runtime.KeepAlive(s)
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_Gadget_describe(s.ptr, &cErr)
	wvTrap(&cErr)
	goResult := C.GoString(result)
	C.weaveffi_free_string(result)
	return goResult
}

// Poke: Poke the gadget a number of times, failing on a negative count
func (s *Gadget) Poke(times int32) (int32, error) {
	if s.ptr == nil {
		panic("weaveffi: Gadget used after Close")
	}
	defer runtime.KeepAlive(s)
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_Gadget_poke(s.ptr, C.int32_t(times), &cErr)
	if cErr.code != 0 {
		return 0, wvMapKitchen(wvTakeError(&cErr))
	}
	return int32(result), nil
}

// GadgetVersion: The gadget subsystem version string
func GadgetVersion() string {
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_Gadget_version(&cErr)
	wvTrap(&cErr)
	goResult := C.GoString(result)
	C.weaveffi_free_string(result)
	return goResult
}

// Close releases the wrapper's strong reference. Calling it more than once
// is harmless; the object itself is dropped by the native library when its
// last reference (from any wrapper, record, or producer) is released.
func (s *Gadget) Close() {
	if s.ptr != nil {
		C.weaveffi_kitchen_Gadget_destroy(s.ptr)
		s.ptr = nil
		runtime.SetFinalizer(s, nil)
	}
}

