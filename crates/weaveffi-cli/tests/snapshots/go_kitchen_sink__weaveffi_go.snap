	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult Token
	goResult = wvUnpackToken(rRes)
	rRes.expectEnd()
	return goResult
}

type wvOutcomeKitchenDoAsync struct {
	val string
	err error
}

//export goWv_weaveffi_kitchen_do_async_callback
func goWv_weaveffi_kitchen_do_async_callback(context unsafe.Pointer, err *C.weaveffi_error, result *C.char) {
	h := cgo.Handle(uintptr(context))
	ch := h.Value().(chan wvOutcomeKitchenDoAsync)
	h.Delete()
	if err != nil && err.code != 0 {
		ch <- wvOutcomeKitchenDoAsync{err: wvBrandError(wvTakeBoxedError(err))}
		return
	}
	val := ""
	if result != nil {
		val = C.GoString(result)
		C.weaveffi_free_string(result)
	}
	ch <- wvOutcomeKitchenDoAsync{val: val}
}

// DoAsync: Async operation
// Blocks the calling goroutine until the async producer completes.
func DoAsync(input string) string {
	ch := make(chan wvOutcomeKitchenDoAsync, 1)
	h := cgo.NewHandle(ch)
	cInput := C.CString(input)
	defer C.free(unsafe.Pointer(cInput))
	C.weaveffi_kitchen_do_async_async(cInput, C.weaveffi_kitchen_do_async_callback(unsafe.Pointer(C.goWv_weaveffi_kitchen_do_async_callback)), C.wvHandlePtr(C.uintptr_t(h)))
	outcome := <-ch
	if outcome.err != nil {
		panic(outcome.err)
	}
	return outcome.val
}

type wvOutcomeKitchenDoCancellable struct {
	val string
	err error
}

//export goWv_weaveffi_kitchen_do_cancellable_callback
func goWv_weaveffi_kitchen_do_cancellable_callback(context unsafe.Pointer, err *C.weaveffi_error, result *C.char) {
	h := cgo.Handle(uintptr(context))
	ch := h.Value().(chan wvOutcomeKitchenDoCancellable)
	h.Delete()
	if err != nil && err.code != 0 {
		ch <- wvOutcomeKitchenDoCancellable{err: wvBrandError(wvTakeBoxedError(err))}
		return
	}
	val := ""
	if result != nil {
		val = C.GoString(result)
		C.weaveffi_free_string(result)
	}
	ch <- wvOutcomeKitchenDoCancellable{val: val}
}

// DoCancellable: Cancellable async operation
// Blocks the calling goroutine until the async producer completes.
func DoCancellable(input string) string {
	ch := make(chan wvOutcomeKitchenDoCancellable, 1)
	h := cgo.NewHandle(ch)
	cInput := C.CString(input)
	defer C.free(unsafe.Pointer(cInput))
	C.weaveffi_kitchen_do_cancellable_async(cInput, nil, C.weaveffi_kitchen_do_cancellable_callback(unsafe.Pointer(C.goWv_weaveffi_kitchen_do_cancellable_callback)), C.wvHandlePtr(C.uintptr_t(h)))
	outcome := <-ch
	if outcome.err != nil {
		panic(outcome.err)
	}
	return outcome.val
}

