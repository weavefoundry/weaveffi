	result := C.weaveffi_kitchen_subscribe(C.wvHandlePtr(C.uintptr_t(hListener)), C.wvVtablePtr_weaveffi_kitchen_ReadyListener(), &cErr)
	wvTrap(&cErr)
	return int32(result)
}

// MaybeGadget: Optional object in both directions
func MaybeGadget(fallback *Gadget) *Gadget {
	defer runtime.KeepAlive(fallback)
	var cFallback *C.weaveffi_kitchen_Gadget
	if fallback != nil {
		cFallback = fallback.ptr
	}
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_maybe_gadget(cFallback, &cErr)
	wvTrap(&cErr)
	return wvAdoptGadget(result)
}

// Gadgets: A list of objects
func Gadgets() []*Gadget {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_gadgets(&cOutLen, &cErr)
	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult []*Gadget
	nRes0 := rRes.readLen()
	goResult = make([]*Gadget, nRes0)
	for iRes0 := range goResult {
		goResult[iRes0] = wvUntokenGadget(rRes.readU64())
	}
	rRes.expectEnd()
	return goResult
}

// StreamGadgets: An iterator over objects
// Returns a lazy sequence: the producer iterator is launched on first
// iteration and one producer next call runs per element. The iterator is
// destroyed exactly once, whether the sequence is exhausted or abandoned
// early; each range over the sequence launches a fresh producer iterator.
// A reported error can only be a producer bug and panics with the
// weaveffi message.
func StreamGadgets() iter.Seq[*Gadget] {
	return func(yield func(*Gadget) bool) {
		var cErr C.weaveffi_error
		it := C.weaveffi_kitchen_stream_gadgets(&cErr)
		wvTrap(&cErr)
		defer C.weaveffi_kitchen_StreamGadgetsIterator_destroy(it)
		for {
			var outItem *C.weaveffi_kitchen_Gadget
			var iterErr C.weaveffi_error
			ok := C.weaveffi_kitchen_StreamGadgetsIterator_next(it, &outItem, &iterErr) != 0
			wvTrap(&iterErr)
			if !ok {
				return
			}
			item := wvAdoptGadget(outItem)
			if !yield(item) {
				return
			}
		}
	}
}

// MaybeItem: Optional struct return
func MaybeItem(id int64) (*Item, error) {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_maybe_item(C.int64_t(id), &cOutLen, &cErr)
	if cErr.code != 0 {
		return nil, wvMapKitchen(wvTakeError(&cErr))
	}
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult *Item
	if rRes.readOptionFlag() {
		var oRes0 Item
		oRes0 = wvUnpackItem(rRes)
		goResult = &oRes0
	}
	rRes.expectEnd()
	return goResult, nil
}

// ListItems: List of structs
func ListItems() []Item {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_list_items(&cOutLen, &cErr)
	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult []Item
	nRes0 := rRes.readLen()
	goResult = make([]Item, nRes0)
	for iRes0 := range goResult {
		goResult[iRes0] = wvUnpackItem(rRes)
	}
	rRes.expectEnd()
	return goResult
}

// GetAttrs: Map return type
func GetAttrs() map[string]int32 {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_get_attrs(&cOutLen, &cErr)
	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult map[string]int32
	nRes0 := rRes.readLen()
	goResult = make(map[string]int32, nRes0)
	for iRes0 := 0; iRes0 < nRes0; iRes0++ {
		var kRes0 string
		kRes0 = rRes.readString()
		var vRes0 int32
		vRes0 = rRes.readI32()
		goResult[kRes0] = vRes0
	}
	rRes.expectEnd()
	return goResult
}

// StreamItems: Iterator return type
// Returns a lazy sequence: the producer iterator is launched on first
// iteration and one producer next call runs per element. The iterator is
// destroyed exactly once, whether the sequence is exhausted or abandoned
// early; each range over the sequence launches a fresh producer iterator.
// A reported error can only be a producer bug and panics with the
// weaveffi message.
func StreamItems() iter.Seq[Item] {
	return func(yield func(Item) bool) {
		var cErr C.weaveffi_error
		it := C.weaveffi_kitchen_stream_items(&cErr)
		wvTrap(&cErr)
		defer C.weaveffi_kitchen_StreamItemsIterator_destroy(it)
		for {
			var outItem *C.uint8_t
			var outLen C.size_t
			var iterErr C.weaveffi_error
			ok := C.weaveffi_kitchen_StreamItemsIterator_next(it, &outItem, &outLen, &iterErr) != 0
			wvTrap(&iterErr)
			if !ok {
				return
			}
			rItem := &wvReader{buf: wvCopyBuffer(outItem, outLen)}
			var item Item
			item = wvUnpackItem(rItem)
			rItem.expectEnd()
			if !yield(item) {
				return
			}
		}
	}
}

// CrossModuleToken: Returns the shared Token type from another module
func CrossModuleToken() Token {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
