// MaybeItem: Optional struct return
func MaybeItem(id int64) (*Item, error) {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_maybe_item(C.int64_t(id), &cOutLen, &cErr)
	if cErr.code != 0 {
		return nil, wvMapKitchen(wvTakeError(&cErr))
	}
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult *Item
	if rRes.readOptionFlag() {
		var oRes0 Item
		oRes0 = wvUnpackItem(rRes)
		goResult = &oRes0
	}
	rRes.expectEnd()
	return goResult, nil
}

// ListItems: List of structs
func ListItems() []Item {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_list_items(&cOutLen, &cErr)
	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult []Item
	nRes0 := rRes.readLen()
	goResult = make([]Item, nRes0)
	for iRes0 := range goResult {
		goResult[iRes0] = wvUnpackItem(rRes)
	}
	rRes.expectEnd()
	return goResult
}

// GetAttrs: Map return type
func GetAttrs() map[string]int32 {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_get_attrs(&cOutLen, &cErr)
	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult map[string]int32
	nRes0 := rRes.readLen()
	goResult = make(map[string]int32, nRes0)
	for iRes0 := 0; iRes0 < nRes0; iRes0++ {
		var kRes0 string
		kRes0 = rRes.readString()
		var vRes0 int32
		vRes0 = rRes.readI32()
		goResult[kRes0] = vRes0
	}
	rRes.expectEnd()
	return goResult
}

// StreamItems: Iterator return type
// Returns a lazy sequence: the producer iterator is launched on first
// iteration and one producer next call runs per element. The iterator is
// destroyed exactly once, whether the sequence is exhausted or abandoned
// early; each range over the sequence launches a fresh producer iterator.
// A reported error can only be a producer bug and panics with the
// weaveffi message.
func StreamItems() iter.Seq[Item] {
	return func(yield func(Item) bool) {
		var cErr C.weaveffi_error
		it := C.weaveffi_kitchen_stream_items(&cErr)
		wvTrap(&cErr)
		defer C.weaveffi_kitchen_StreamItemsIterator_destroy(it)
		for {
			var outItem *C.uint8_t
			var outLen C.size_t
			var iterErr C.weaveffi_error
			ok := C.weaveffi_kitchen_StreamItemsIterator_next(it, &outItem, &outLen, &iterErr) != 0
			wvTrap(&iterErr)
			if !ok {
				return
			}
			rItem := &wvReader{buf: wvCopyBuffer(outItem, outLen)}
			var item Item
			item = wvUnpackItem(rItem)
			rItem.expectEnd()
			if !yield(item) {
				return
			}
		}
	}
}

// CrossModuleToken: Returns the shared Token type from another module
func CrossModuleToken() Token {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kitchen_cross_module_token(&cOutLen, &cErr)
	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult Token
	goResult = wvUnpackToken(rRes)
	rRes.expectEnd()
	return goResult
}

type wvOutcomeKitchenDoAsync struct {
	val string
	err error
}

//export goWv_weaveffi_kitchen_do_async_callback
func goWv_weaveffi_kitchen_do_async_callback(context unsafe.Pointer, err *C.weaveffi_error, result *C.char) {
	v := wvCallbackTake(uint64(uintptr(context)))
	if v == nil {
		return
	}
	ch := v.(chan wvOutcomeKitchenDoAsync)
	if err != nil && err.code != 0 {
		ch <- wvOutcomeKitchenDoAsync{err: wvBrandError(wvTakeBoxedError(err))}
		return
	}
	val := ""
	if result != nil {
		val = C.GoString(result)
		C.weaveffi_free_string(result)
	}
	ch <- wvOutcomeKitchenDoAsync{val: val}
}

// DoAsync: Async operation
// Blocks the calling goroutine until the async producer completes.
func DoAsync(input string) string {
	ch := make(chan wvOutcomeKitchenDoAsync, 1)
	ctxID := wvCallbackStore(ch)
	cInput := C.CString(input)
	defer C.free(unsafe.Pointer(cInput))
	C.weaveffi_kitchen_do_async_async(cInput, C.weaveffi_kitchen_do_async_callback(unsafe.Pointer(C.goWv_weaveffi_kitchen_do_async_callback)), unsafe.Pointer(uintptr(ctxID)))
	outcome := <-ch
	if outcome.err != nil {
		panic(outcome.err)
	}
	return outcome.val
}

type wvOutcomeKitchenDoCancellable struct {
	val string
	err error
}

//export goWv_weaveffi_kitchen_do_cancellable_callback
func goWv_weaveffi_kitchen_do_cancellable_callback(context unsafe.Pointer, err *C.weaveffi_error, result *C.char) {
	v := wvCallbackTake(uint64(uintptr(context)))
	if v == nil {
		return
	}
	ch := v.(chan wvOutcomeKitchenDoCancellable)
	if err != nil && err.code != 0 {
		ch <- wvOutcomeKitchenDoCancellable{err: wvBrandError(wvTakeBoxedError(err))}
		return
	}
	val := ""
	if result != nil {
		val = C.GoString(result)
		C.weaveffi_free_string(result)
	}
	ch <- wvOutcomeKitchenDoCancellable{val: val}
}

// DoCancellable: Cancellable async operation
// Blocks the calling goroutine until the async producer completes.
func DoCancellable(input string) string {
	ch := make(chan wvOutcomeKitchenDoCancellable, 1)
	ctxID := wvCallbackStore(ch)
	cInput := C.CString(input)
	defer C.free(unsafe.Pointer(cInput))
	C.weaveffi_kitchen_do_cancellable_async(cInput, nil, C.weaveffi_kitchen_do_cancellable_callback(unsafe.Pointer(C.goWv_weaveffi_kitchen_do_cancellable_callback)), unsafe.Pointer(uintptr(ctxID)))
	outcome := <-ch
	if outcome.err != nil {
		panic(outcome.err)
	}
	return outcome.val
}

