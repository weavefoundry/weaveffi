cmake_minimum_required(VERSION 3.14)
project(edge_cases_cpp VERSION 0.1.0 LANGUAGES CXX)

# The producer library to link: a full path from the EDGE_CASES_LIBRARY cache or
# environment variable, or else the library name `edge_cases` (a CMake target
# of that name, or libedge_cases on the linker search path).
set(EDGE_CASES_LIBRARY "$ENV{EDGE_CASES_LIBRARY}" CACHE FILEPATH "Path to the edge_cases native library")

add_library(edge_cases_cpp INTERFACE)
add_library(edge_cases::cpp ALIAS edge_cases_cpp)
target_include_directories(edge_cases_cpp INTERFACE ${CMAKE_CURRENT_SOURCE_DIR})
target_compile_features(edge_cases_cpp INTERFACE cxx_std_17)
if(EDGE_CASES_LIBRARY)
  target_link_libraries(edge_cases_cpp INTERFACE "${EDGE_CASES_LIBRARY}")
else()
  target_link_libraries(edge_cases_cpp INTERFACE edge_cases)
endif()

