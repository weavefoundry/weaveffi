// Generated by WeaveFFI [VERSION]
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate

plugins {
    id("com.android.library") version "8.7.3"
    id("org.jetbrains.kotlin.android") version "2.0.21"
    `maven-publish`
}

group = "kitchen_sink"
version = "0.1.0"

// A packaged build ships a prebuilt libkitchen_sink_jni.so next to the producer
// library in src/main/jniLibs/<abi>/; without one, CMake builds it.
val prebuiltJni = fileTree("src/main/jniLibs") { include("**/libkitchen_sink_jni.so") }.files.isNotEmpty()

android {
    namespace = "kitchen_sink"
    compileSdk = 35
    defaultConfig {
        minSdk = 21
        consumerProguardFiles("consumer-rules.pro")
    }
    // Builds libkitchen_sink_jni.so per ABI, linked against the producer library in
    // src/main/jniLibs/<abi>/ (see src/main/cpp/CMakeLists.txt).
    if (!prebuiltJni) {
        externalNativeBuild {
            cmake {
                path = file("src/main/cpp/CMakeLists.txt")
            }
        }
    }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_1_8
        targetCompatibility = JavaVersion.VERSION_1_8
    }
    publishing {
        singleVariant("release") {
            withSourcesJar()
        }
    }
}

kotlin {
    compilerOptions {
        jvmTarget.set(org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_1_8)
    }
}

dependencies {
    implementation("org.jetbrains.kotlinx:kotlinx-coroutines-core:1.9.0")
}

publishing {
    publications {
        register<MavenPublication>("release") {
            artifactId = "kitchen_sink"
            afterEvaluate {
                from(components["release"])
            }
        }
    }
}

