    case 2:
      return EmptyOrderException(message);
    default:
      return WeaveFFIException(code, message);
  }
}

void _checkOrdersException(Pointer<_WeaveFFIError> err) {
  if (err.ref.code != 0) {
    final code = err.ref.code;
    final msg = err.ref.message.toDartString();
    final payload = _copyNativeBytes(err.ref.payloadPtr, err.ref.payloadLen);
    _weaveffiErrorClear(err);
    throw _mapOrdersException(code, msg, payload);
  }
}

class OrderItem {
  final int productId;
  final int quantity;
  final double unitPrice;

  OrderItem({required this.productId, required this.quantity, required this.unitPrice});
}

void _packOrderItem(_BufferWriter w, OrderItem v) {
  w.writeInt64(v.productId);
  w.writeInt32(v.quantity);
  w.writeFloat64(v.unitPrice);
}

OrderItem _unpackOrderItem(_BufferReader r) {
  return OrderItem(
    productId: r.readInt64(),
    quantity: r.readInt32(),
    unitPrice: r.readFloat64(),
  );
}

class Order {
  final int id;
  final List<OrderItem> items;
  final double total;
  final String status;

  Order({required this.id, required this.items, required this.total, required this.status});
}

void _packOrder(_BufferWriter w, Order v) {
  w.writeInt64(v.id);
  final t0 = v.items;
  w.writeLength(t0.length);
  for (final t1 in t0) {
    _packOrderItem(w, t1);
  }
  w.writeFloat64(v.total);
  w.writeString(v.status);
}

Order _unpackOrder(_BufferReader r) {
  return Order(
    id: r.readInt64(),
    items: List<OrderItem>.generate(r.readLength(), (_) => _unpackOrderItem(r)),
    total: r.readFloat64(),
    status: r.readString(),
  );
}

