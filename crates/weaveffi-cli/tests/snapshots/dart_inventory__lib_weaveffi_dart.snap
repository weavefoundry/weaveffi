/// Throws [OrdersException] on domain errors.
int createOrder(List<OrderItem> items) {
  final itemsWriter = _BufferWriter();
  final t0 = items;
  itemsWriter.writeLength(t0.length);
  for (final t1 in t0) {
    _packOrderItem(itemsWriter, t1);
  }
  final itemsBuf = itemsWriter.takeBytes();
  final itemsPtr = _stageBytes(itemsBuf);
  final err = calloc<_WeaveFFIError>();
  try {
    final result = _weaveffiOrdersCreateOrder(itemsPtr, itemsBuf.length, err);
    _checkOrdersException(err);
    return result;
  } finally {
    calloc.free(itemsPtr);
    calloc.free(err);
  }
}

