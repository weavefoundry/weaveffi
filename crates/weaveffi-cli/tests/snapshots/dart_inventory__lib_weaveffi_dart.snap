class ProductsException extends WeaveFFIException {
  ProductsException(super.code, super.message);
}

/// price must be positive
class InvalidPriceException extends ProductsException {
  InvalidPriceException([String message = 'price must be positive']) : super(1, message);
}

/// product not found
class ProductNotFoundException extends ProductsException {
  ProductNotFoundException([String message = 'product not found']) : super(2, message);
}

WeaveFFIException _mapProductsException(int code, String message, Uint8List payload) {
  switch (code) {
    case 1:
      return InvalidPriceException(message);
    case 2:
      return ProductNotFoundException(message);
    default:
      return WeaveFFIException(code, message);
  }
}

void _checkProductsException(Pointer<_WeaveFFIError> err) {
  if (err.ref.code != 0) {
    final code = err.ref.code;
    final msg = err.ref.message.toDartString();
    final payload = _copyNativeBytes(err.ref.payloadPtr, err.ref.payloadLen);
    _weaveffiErrorClear(err);
    throw _mapProductsException(code, msg, payload);
  }
}

enum Category {
  electronics(0),
  clothing(1),
  food(2),
  books(3),
  ;
  const Category(this.value);
  final int value;

  static Category fromValue(int value) =>
      Category.values.firstWhere((e) => e.value == value);
}

class Product {
  final int id;
  final String name;
  final String? description;
  final double price;
  final Category category;
  final List<String> tags;

  Product({required this.id, required this.name, this.description, required this.price, required this.category, required this.tags});
}

void _packProduct(_BufferWriter w, Product v) {
  w.writeInt64(v.id);
  w.writeString(v.name);
  final t0 = v.description;
  if (t0 == null) {
    w.writeOptionFlag(false);
  } else {
    w.writeOptionFlag(true);
    w.writeString(t0);
  }
  w.writeFloat64(v.price);
  w.writeInt32(v.category.value);
  final t1 = v.tags;
  w.writeLength(t1.length);
  for (final t2 in t1) {
    w.writeString(t2);
  }
}

Product _unpackProduct(_BufferReader r) {
  return Product(
    id: r.readInt64(),
    name: r.readString(),
    description: (r.readOptionFlag() ? r.readString() : null),
    price: r.readFloat64(),
    category: Category.fromValue(r.readInt32()),
    tags: List<String>.generate(r.readLength(), (_) => r.readString()),
  );
}

