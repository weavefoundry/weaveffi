/// A product catalog owning its products
class Catalog {
  final Pointer<Void> _handle;
  Catalog._(this._handle);

  /// Releases the native object reference.
  void dispose() {
    _weaveffiProductsCatalogDestroy(_handle);
  }

  factory Catalog() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiProductsCatalogNew(err);
      _checkError(err);
      return Catalog._(result);
    } finally {
      calloc.free(err);
    }
  }

  /// Throws [ProductsException] on domain errors.
  Product addProduct(String name, double price, Category category) {
    final namePtr = name.toNativeUtf8();
    final outLen = calloc<Size>();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiProductsCatalogAddProduct(_handle, namePtr, price, category.value, outLen, err);
      _checkProductsException(err);
      final n = outLen.value;
      final data = _copyNativeBytes(result, n);
      if (result != nullptr) _weaveffiFreeBytes(result, n);
      final reader = _BufferReader(data);
      final value = _unpackProduct(reader);
      reader.expectEnd();
      return value;
    } finally {
      calloc.free(namePtr);
      calloc.free(outLen);
      calloc.free(err);
    }
  }

  /// Throws [ProductsException] on domain errors.
  Product getProduct(int id) {
    final outLen = calloc<Size>();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiProductsCatalogGetProduct(_handle, id, outLen, err);
      _checkProductsException(err);
      final n = outLen.value;
      final data = _copyNativeBytes(result, n);
      if (result != nullptr) _weaveffiFreeBytes(result, n);
      final reader = _BufferReader(data);
      final value = _unpackProduct(reader);
      reader.expectEnd();
      return value;
    } finally {
      calloc.free(outLen);
      calloc.free(err);
    }
  }

  List<Product> search(Category category) {
    final outLen = calloc<Size>();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiProductsCatalogSearch(_handle, category.value, outLen, err);
      _checkError(err);
      final n = outLen.value;
      final data = _copyNativeBytes(result, n);
      if (result != nullptr) _weaveffiFreeBytes(result, n);
      final reader = _BufferReader(data);
      final value = List<Product>.generate(reader.readLength(), (_) => _unpackProduct(reader));
      reader.expectEnd();
      return value;
    } finally {
      calloc.free(outLen);
      calloc.free(err);
    }
  }

  /// Throws [ProductsException] on domain errors.
  bool updatePrice(int id, double price) {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiProductsCatalogUpdatePrice(_handle, id, price, err);
      _checkProductsException(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }

  bool remove(int id) {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiProductsCatalogRemove(_handle, id, err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }
}

