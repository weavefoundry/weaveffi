  # @api private
  # Appends values in the value-buffer wire format: little-endian, packed,
  # no alignment. Integers out of their type's range raise RangeError rather
  # than wrap.
  class WvBufferWriter
    def initialize
      @buf = +''.b
      @objects = []
    end

    # Reserves an object token for a `cls` wrapper. The strong reference it
    # carries is minted by #seal, just before the buffer is handed to the
    # library, so an encoding abandoned on the way never strands a
    # reference.
    def write_object(object, cls)
      raise TypeError, "expected a #{cls.name}, got #{object.class}" unless object.is_a?(cls)

      @objects << [@buf.bytesize, object]
      @buf << [0].pack('Q<')
    end

    # Mints the reference each reserved object token carries, recording it
    # in `minted`, and returns the finished encoding.
    def seal(minted)
      @objects.each do |offset, object|
        ptr = object._wv_clone_ptr
        minted << [object.class, ptr]
        @buf[offset, 8] = [ptr.address].pack('Q<')
      end
      @buf
    end

    # The finished encoding of a buffer that carries no objects.
    def bytes
      raise TypeError, 'this encoding cannot carry objects' unless @objects.empty?

      @buf
    end

    def write_bool(value)
      @buf << (value ? "\x01" : "\x00").b
    end

    def write_flag(value)
      write_bool(value)
    end

    def write_i8(value)
      @buf << [int(value, :i8)].pack('c')
    end

    def write_u8(value)
      @buf << [int(value, :u8)].pack('C')
    end

    def write_i16(value)
      @buf << [int(value, :i16)].pack('s<')
    end

    def write_u16(value)
      @buf << [int(value, :u16)].pack('S<')
    end

    def write_i32(value)
      @buf << [int(value, :i32)].pack('l<')
    end

    def write_u32(value)
      @buf << [int(value, :u32)].pack('L<')
    end

    def write_len(value)
      write_u32(value)
    end

    def write_i64(value)
      @buf << [int(value, :i64)].pack('q<')
    end

    def write_u64(value)
      @buf << [int(value, :u64)].pack('Q<')
    end

    def write_f32(value)
      @buf << [value].pack('e')
    end

    def write_f64(value)
      @buf << [value].pack('E')
    end

    def write_string(value)
      write_bytes(KitchenSink._wv_str(value))
    end

    def write_bytes(value)
      bytes = KitchenSink._wv_bytes(value)
      write_u32(bytes.bytesize)
      @buf << bytes
    end

    private

    def int(value, kind)
      KitchenSink._wv_int(value, kind)
    end
