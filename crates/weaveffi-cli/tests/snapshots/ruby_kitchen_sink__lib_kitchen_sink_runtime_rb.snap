  # @api private
  # Reads values in the value-buffer wire format, raising NativeBugError on
  # any malformed buffer.
  class WvBufferReader
    def initialize(data)
      @data = data.to_s.b
      @pos = 0
    end

    def take(count, what)
      raise KitchenSink._wv_malformed("truncated #{what}") if @pos + count > @data.bytesize

      bytes = @data.byteslice(@pos, count)
      @pos += count
      bytes
    end

    def read_bool
      byte = take(1, 'bool').unpack1('C')
      raise KitchenSink._wv_malformed('bool byte out of range') if byte > 1

      byte == 1
    end

    def read_flag
      byte = take(1, 'option flag').unpack1('C')
      raise KitchenSink._wv_malformed('option flag out of range') if byte > 1

      byte == 1
    end

    def read_i8
      take(1, 'i8').unpack1('c')
    end

    def read_u8
      take(1, 'u8').unpack1('C')
    end

    def read_i16
      take(2, 'i16').unpack1('s<')
    end

    def read_u16
      take(2, 'u16').unpack1('S<')
    end

    def read_i32
      take(4, 'i32').unpack1('l<')
    end

    def read_u32
      take(4, 'u32').unpack1('L<')
    end

    # A u32 element count. Counts are not checked against the remaining
    # bytes, since an element can encode to zero bytes; a short buffer still
    # fails on the first truncated read.
    def read_len
      read_u32
    end

    def read_i64
      take(8, 'i64').unpack1('q<')
    end

    def read_u64
      take(8, 'u64').unpack1('Q<')
    end

    def read_f32
      take(4, 'f32').unpack1('e')
    end

    def read_f64
      take(8, 'f64').unpack1('E')
    end

    def read_string
      text = read_bytes.force_encoding(Encoding::UTF_8)
      raise KitchenSink._wv_malformed('string is not valid UTF-8') unless text.valid_encoding?

      text
    end

    def read_bytes
      take(read_u32, 'byte run')
    end

    # An object token: a non-zero u64 carrying one strong reference, adopted
    # into a new `cls` wrapper.
    def read_object(cls)
      addr = read_u64
      raise KitchenSink._wv_malformed('null object token') if addr.zero?

      cls._from_ptr(FFI::Pointer.new(addr))
    end

    def expect_end!
      return if @pos == @data.bytesize

      raise KitchenSink._wv_malformed('trailing bytes after value')
    end
  end

  # @api private
  # Seals the writers of one call's object-carrying buffers (see
  # WvBufferWriter#seal) and returns their encodings. If any reference can't
  # be minted (a closed wrapper), the ones already minted are released before
  # the error propagates. The library adopts every minted reference once the
  # call is made.
  def self._wv_seal(*writers)
    minted = []
    writers.map { |writer| writer.seal(minted) }
  rescue Exception # rubocop:disable Lint/RescueException
    minted.each { |cls, ptr| cls::WV_PTR.release(ptr) }
    raise
  end

  # @api private
  # Encodes an argument that carries no objects: yields a writer and
  # returns the finished encoding.
  def self._wv_encode
    writer = WvBufferWriter.new
    yield writer
    writer.bytes
  end

  # @api private
  # A returned object pointer that must not be NULL.
  def self._wv_nonnull(ptr)
    raise NativeBugError.new(MARSHAL_ERROR_CODE, 'null object pointer') if ptr.null?

    ptr
  end

  # @api private
  # Decodes a returned value buffer: copies and releases it, yields a reader
  # to the block, and checks that the block consumed every byte.
  def self._wv_decode(ptr, len)
    reader = WvBufferReader.new(_wv_take_bytes(ptr, len))
    value = yield reader
    reader.expect_end!
    value
  end

  # @api private
