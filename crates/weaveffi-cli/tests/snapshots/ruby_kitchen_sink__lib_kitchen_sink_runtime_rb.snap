    reader = WvBufferReader.new(_wv_borrow_bytes(ptr, len))
    value = yield reader
    reader.expect_end!
    value
  end

  # Ruby objects the library refers to by an integer key: callback-interface
  # implementations (the key is the vtable `ctx`) and pending async
  # completions (the key is the completion `context`). The library never
  # sees a Ruby object address. A Monitor rather than a Mutex, so a
  # finalizer that runs while this thread holds the lock can't deadlock it.
  @wv_handles = {}
  @wv_next_handle = 0
  @wv_handles_lock = Monitor.new

  # @api private
  def self._wv_handle_put(value)
    @wv_handles_lock.synchronize do
      @wv_next_handle += 1
      @wv_handles[@wv_next_handle] = value
      FFI::Pointer.new(@wv_next_handle)
    end
  end

  # @api private
  def self._wv_handle_get(key)
    @wv_handles_lock.synchronize { @wv_handles[key.address] }
  end

  # @api private
  def self._wv_handle_take(key)
    @wv_handles_lock.synchronize { @wv_handles.delete(key.address) }
  end

  # @api private
  # Registers a callback-interface implementation and returns its `ctx` and
  # `vtable` arguments: two NULLs for a nil (optional) implementation. Never
  # raises, so nothing can strand the registration between this and the
  # call that hands it to the library (an unusable implementation fails
  # when the library calls it, with FOREIGN_ERROR_CODE).
  def self._wv_cb_register(impl, vtable)
    return [nil, nil] if impl.nil?

    [_wv_handle_put([:callback, impl]), vtable.to_ptr]
  end

  # @api private
  # Resolves a trampoline's `ctx` back to the registered implementation.
  def self._wv_cb_lookup(ctx)
    kind, impl = _wv_handle_get(ctx)
    raise Error.new(FOREIGN_ERROR_CODE, 'callback context is not registered') unless kind == :callback

    impl
  end

  # @api private
  # Drops an implementation when the library releases its last reference.
  def self._wv_cb_free(ctx)
    _wv_handle_take(ctx)
    nil
  end

  # @api private
  # The message a callback failure reports: the exception's message (its
  # class name when that's empty), as UTF-8 without NULs.
  def self._wv_cb_message(exception)
    message = exception.message.to_s
    message = exception.class.name.to_s if message.empty?
    message.encode(Encoding::UTF_8, invalid: :replace, undef: :replace).delete("\0")
  end

  # @api private
  # Reports a callback implementation's exception through `out_err` as
  # FOREIGN_ERROR_CODE. The library copies the message.
  def self._wv_cb_fail(out_err, exception)
    kitchen_sink_error_set(out_err, FOREIGN_ERROR_CODE, _wv_cb_message(exception))
    nil
  end

  # @api private
  # Reports a domain error raised by a callback method declared to throw:
  # the block returns its `[code, payload]`, or nil when it isn't one of the
  # domain's codes, which then fails as FOREIGN_ERROR_CODE like any other
  # exception.
  def self._wv_cb_throw(out_err, exception)
