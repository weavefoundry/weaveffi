  attach_function :kitchen_sink_error_clear, [:pointer], :void
  attach_function :kitchen_sink_error_free, [:pointer], :void
  attach_function :kitchen_sink_alloc, [:size_t], :pointer
  attach_function :kitchen_sink_free_bytes, [:pointer, :size_t], :void
  attach_function :kitchen_sink_cancel_token_create, [], :pointer
  attach_function :kitchen_sink_cancel_token_cancel, [:pointer], :void
  attach_function :kitchen_sink_cancel_token_is_cancelled, [:pointer], :bool
