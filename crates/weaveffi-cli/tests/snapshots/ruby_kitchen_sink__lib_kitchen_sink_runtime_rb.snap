    i32: -0x8000_0000..0x7fff_ffff,
    u32: 0..0xffff_ffff,
    i64: -0x8000_0000_0000_0000..0x7fff_ffff_ffff_ffff,
    u64: 0..0xffff_ffff_ffff_ffff
