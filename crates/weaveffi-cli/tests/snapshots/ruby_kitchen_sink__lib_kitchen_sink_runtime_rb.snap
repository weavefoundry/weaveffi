  # library: a run allocated with kitchen_sink_alloc, written to the out slots.
  # The library adopts and frees it.
  def self._wv_cb_return_bytes(out_ptr, out_len, data)
    len = data.bytesize
    run = FFI::Pointer::NULL
    unless len.zero?
      run = kitchen_sink_alloc(len)
      raise NoMemoryError, 'kitchen_sink_alloc failed' if run.null?

      run.put_bytes(0, data)
    end
    out_ptr.write_pointer(run)
    out_len.write(:size_t, len)
    nil
  end

  # @api private
  # A callback method's object return: a fresh strong reference the library
  # adopts, or NULL for nil (which the library rejects where the return
  # isn't optional).
  def self._wv_cb_return_object(value, cls)
    return FFI::Pointer::NULL if value.nil?
    raise TypeError, "expected a #{cls.name}, got #{value.class}" unless value.is_a?(cls)

    value._wv_clone_ptr
  end

  # @api private
  # Registers a pending async call; returns its completion context and the
  # queue its completion is delivered on.
  def self._wv_async_begin
    queue = Queue.new
    [_wv_handle_put([:async, queue]), queue]
  end

  # @api private
