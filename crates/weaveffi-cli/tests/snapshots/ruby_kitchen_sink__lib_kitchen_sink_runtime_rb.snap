    kitchen_sink_error_set(out_err, code, _wv_cb_message(exception))
    kitchen_sink_error_set_payload(out_err, payload, payload.bytesize) unless payload.empty?
    nil
  rescue Exception => e # rubocop:disable Lint/RescueException
    _wv_cb_fail(out_err, e)
  end

  # @api private
  # A callback method's floating-point return, checked to be numeric.
  def self._wv_float(value)
    raise TypeError, "expected a Float, got #{value.class}" unless value.is_a?(Numeric)

    value.to_f
  end

  # @api private
