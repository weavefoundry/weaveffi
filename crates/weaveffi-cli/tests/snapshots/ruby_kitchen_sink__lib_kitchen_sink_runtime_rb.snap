      begin
        attach_function symbol, [:pointer], :pointer unless respond_to?(symbol)
      rescue FFI::NotFoundError
        raise LoadError, "the loaded kitchen_sink library does not export #{symbol}"
      end
      out_len = FFI::MemoryPointer.new(:size_t)
      table = public_send(symbol, out_len)
      count = table.null? ? 0 : out_len.read(:size_t)
      actual = Array.new(count) do |i|
        entry = ContractEntry.new(table + (i * ContractEntry.size))
        [entry[:id], entry[:hash]]
      end.to_h
      expected.each do |id, hash, path|
        found = actual[id]
        raise LoadError, "kitchen_sink: #{path} is missing from the library" if found.nil?
        next if found == hash

        raise LoadError, "kitchen_sink: #{path} changed since these bindings were generated"
      end
