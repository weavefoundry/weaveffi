static void weaveffi_kitchen_do_async_jni_cb(void* context, weaveffi_error* err, const char* result) {
    weaveffi_jni_async_ctx* ctx = (weaveffi_jni_async_ctx*)context;
    JNIEnv* env = NULL;
    int attached = weaveffi_jni_attach(&env);
    if (env == NULL) { free(ctx); return; }
    if (err != NULL && err->code != 0) {
        const char* msg = err->message ? err->message : "WeaveFFI error";
        jstring jmsg = weaveffi_jni_utf8_to_string(env, msg);
        jbyteArray jpayload = NULL;
        if (err->payload_ptr != NULL) {
            jpayload = (*env)->NewByteArray(env, (jsize)err->payload_len);
            if (jpayload != NULL) { (*env)->SetByteArrayRegion(env, jpayload, 0, (jsize)err->payload_len, (const jbyte*)err->payload_ptr); }
        }
        jint jcode = (jint)err->code;
        weaveffi_error_free(err);
        jclass cls = (*env)->GetObjectClass(env, ctx->callback);
        jmethodID mid = (*env)->GetMethodID(env, cls, "onError", "(ILjava/lang/String;[B)V");
        (*env)->CallVoidMethod(env, ctx->callback, mid, jcode, jmsg, jpayload);
    } else {
        jobject boxed = (jobject)weaveffi_jni_utf8_to_string(env, result);
        weaveffi_free_string(result);
        jclass cls = (*env)->GetObjectClass(env, ctx->callback);
        jmethodID mid = (*env)->GetMethodID(env, cls, "onSuccess", "(Ljava/lang/Object;)V");
        (*env)->CallVoidMethod(env, ctx->callback, mid, boxed);
    }
    weaveffi_jni_handle_uncaught(env);
    (*env)->DeleteGlobalRef(env, ctx->callback);
    free(ctx);
    weaveffi_jni_detach(attached);
}

JNIEXPORT void JNICALL Java_com_weaveffi_WeaveFFI_doAsyncAsync(JNIEnv* env, jclass clazz, jstring input, jobject callback) {
    weaveffi_jni_async_ctx* ctx = (weaveffi_jni_async_ctx*)malloc(sizeof(weaveffi_jni_async_ctx));
    ctx->callback = (*env)->NewGlobalRef(env, callback);
    char* input_chars = weaveffi_jni_string_to_utf8(env, input);
    weaveffi_kitchen_do_async_async(input_chars, weaveffi_kitchen_do_async_jni_cb, ctx);
    free(input_chars);
}

static void weaveffi_kitchen_do_cancellable_jni_cb(void* context, weaveffi_error* err, const char* result) {
    weaveffi_jni_async_ctx* ctx = (weaveffi_jni_async_ctx*)context;
    JNIEnv* env = NULL;
