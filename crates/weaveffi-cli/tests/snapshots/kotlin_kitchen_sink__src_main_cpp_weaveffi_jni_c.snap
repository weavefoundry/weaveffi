}

JNIEXPORT void JNICALL Java_com_weaveffi_WeaveFFI_doCancellableAsync(JNIEnv* env, jclass clazz, jstring input, jlong cancelToken, jobject callback) {
    weaveffi_jni_async_ctx* ctx = (weaveffi_jni_async_ctx*)malloc(sizeof(weaveffi_jni_async_ctx));
