/**
 * The exception for a native failure of a call whose errors map through
 * [domain]: 0 for a call that can't fail ([NativeBugException]), 1 for
 * `throws: any` ([FfiException]), or an error domain, whose unknown codes
 * map to the domain's base exception. Runtime (negative) codes are
 * [FfiException]s.
 */
internal fun nativeError(domain: Int, code: Int, message: String, payload: ByteArray?): Throwable =
    when {
        domain == 0 -> NativeBugException(code, message)
        code < 0 -> FfiException(code, message)
        domain == 2 -> KitchenException.fromCode(code, message, payload)
        domain == 3 -> PantryException.fromCode(code, message, payload)
        else -> FfiException(code, message)
    }

/**
 * The async completions, one static callback per result type, so each stays
 * reachable for as long as the library can call it. Each hands the outcome
 * to the call its context names (see [PendingCalls]).
 */
internal object Completions {
    fun interface RunCallback : Callback {
        fun invoke(context: Pointer?, err: Pointer?, result: Run.ByValue)
    }

    @JvmField
    val runDone = RunCallback { context, err, result -> PendingCalls.complete(context, err, result) }

    fun interface OptI64Callback : Callback {
        fun invoke(context: Pointer?, err: Pointer?, result: OptI64.ByValue)
    }

    @JvmField
    val optI64Done = OptI64Callback { context, err, result -> PendingCalls.complete(context, err, result) }
}

