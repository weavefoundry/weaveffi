# === Module: kitchen ===

class KitchenErrorsError(WeaveFFIError):
    """Base exception for the `kitchen` module's error domain."""


class NotFound(KitchenErrorsError):
    """Item not found"""

    CODE = 1

    def __init__(self, message: str = "Item not found") -> None:
        super().__init__(1, message)


class InvalidInput(KitchenErrorsError):
    """Invalid input"""

    CODE = 2

    def __init__(self, message: str = "Invalid input") -> None:
        super().__init__(2, message)


KitchenErrorsError.NotFound = NotFound
KitchenErrorsError.InvalidInput = InvalidInput


_KITCHEN_ERRORS_ERROR_CODES: Dict[int, type] = {
    1: NotFound,
    2: InvalidInput,
}


def _kitchen_errors_error_from(code: int, message: str, payload: bytes = b"") -> WeaveFFIError:
    """Build the KitchenErrorsError subclass matching `code`, or a generic
    WeaveFFIError for codes outside the domain (panics, marshalling)."""
    _cls = _KITCHEN_ERRORS_ERROR_CODES.get(code)
    if _cls is None:
        return WeaveFFIError(code, message)
    _exc = _cls(message) if message else _cls()
    return _exc


def _check_kitchen_errors_error(err: _WeaveFFIErrorStruct) -> None:
    if err.code != 0:
        code = err.code
        message = err.message.decode("utf-8") if err.message else ""
        payload = ctypes.string_at(err.payload_ptr, err.payload_len) if err.payload_ptr else b""
        _lib.weaveffi_error_clear(ctypes.byref(err))
        raise _kitchen_errors_error_from(code, message, payload)


class Priority(IntEnum):
    """Task priority levels"""
    # Low priority
    Low = 0
    # Normal priority
    Normal = 1
    # High priority
    High = 2


@dataclass
class Item:
    """Kitchen sink struct exercising every field feature"""

    # Stable identifier
    id: int
    # Display name
    name: str
    # Initial count
    count: int
    # Whether the item is enabled
    enabled: bool
    # Scaling ratio
    ratio: float
    nick: int
    payload: bytes
    tags: List[str]
    attrs: Dict[str, str]
    parent: Optional[int]
    # Cross-module struct reference
    token: "Token"
    priority: "Priority"
    # An optional object inside a record
    gadget: Optional["Gadget"]


def _write_Item(_w: _BufferWriter, value: "Item") -> None:
    _w.write_i64(value.id)
    _w.write_string(value.name)
    _w.write_i32(value.count)
    _w.write_bool(value.enabled)
    _w.write_f64(value.ratio)
    _w.write_u32(value.nick)
    _w.write_bytes(value.payload)
    _w.write_len(len(value.tags))
    for _e0 in value.tags:
        _w.write_string(_e0)
    _w.write_len(len(value.attrs))
    for _k0, _v0 in value.attrs.items():
        _w.write_string(_k0)
        _w.write_string(_v0)
    if value.parent is None:
        _w.write_option_flag(False)
    else:
        _w.write_option_flag(True)
        _w.write_i64(value.parent)
    _write_Token(_w, value.token)
    _w.write_i32(value.priority)
    if value.gadget is None:
        _w.write_option_flag(False)
    else:
        _w.write_option_flag(True)
        _w.write_object(value.gadget)


def _read_Item(_r: _BufferReader) -> "Item":
    return Item(
        id=_r.read_i64(),
        name=_r.read_string(),
        count=_r.read_i32(),
        enabled=_r.read_bool(),
        ratio=_r.read_f64(),
        nick=_r.read_u32(),
        payload=_r.read_bytes(),
        tags=[_r.read_string() for _i0 in range(_r.read_len())],
        attrs=dict((_r.read_string(), _r.read_string()) for _i0 in range(_r.read_len())),
        parent=(_r.read_i64() if _r.read_option_flag() else None),
        token=_read_Token(_r),
        priority=Priority(_r.read_i32()),
        gadget=(Gadget._from_ptr(_r.read_object()) if _r.read_option_flag() else None),
    )


def _pack_Item(value: "Item") -> bytes:
    _w = _BufferWriter()
    _write_Item(_w, value)
    return _w.finish()


def _unpack_Item(data: bytes) -> "Item":
    return _decode_buffer(data, _read_Item)


class ReadyListener(abc.ABC):
    """
    Consumer-implemented observer of ready items

    Consumer-implemented callback interface. Subclass it, implement every abstract method, and pass an instance wherever the API takes a `ReadyListener`; the producer may call the methods from any thread until it releases the instance. An exception raised by a method is reported to the producer as WeaveFFIError.FOREIGN_ERROR_CODE (-4) and aborts the call that was in progress.
    """

    @abc.abstractmethod
    def on_ready(self, code: int, msg: str) -> None:
        """Fires when an item is ready
        """

    @abc.abstractmethod
    def on_item(self, item: "Item", gadget: "Gadget") -> bool:
        """Receives the item itself and says whether to keep listening
        """


_ReadyListener_on_ready_cfunctype = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_int32, ctypes.c_char_p, ctypes.POINTER(_WeaveFFIErrorStruct))
_ReadyListener_on_item_cfunctype = ctypes.CFUNCTYPE(ctypes.c_int32, ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint8), ctypes.c_size_t, ctypes.c_void_p, ctypes.POINTER(_WeaveFFIErrorStruct))
_ReadyListener_vtable_free_cfunctype = ctypes.CFUNCTYPE(None, ctypes.c_void_p)


class _ReadyListenerVtable(ctypes.Structure):
    """The C vtable `weaveffi_kitchen_ReadyListener_vtable`."""

    _fields_ = [
        ("on_ready", _ReadyListener_on_ready_cfunctype),
        ("on_item", _ReadyListener_on_item_cfunctype),
        ("free", _ReadyListener_vtable_free_cfunctype),
    ]


def _ReadyListener_on_ready_trampoline(ctx, code, msg, out_err):
    try:
        _impl = _cb_impls[ctx]
        _impl.on_ready(code, _bytes_to_string(msg))
    except Exception as _exc:
        # Never unwind through the C frame: report the failure and return a
        # default; the producer aborts its call with FOREIGN_ERROR_CODE.
        _lib.weaveffi_error_set(out_err, -4, str(_exc).encode("utf-8", "replace"))


def _ReadyListener_on_item_trampoline(ctx, item_ptr, item_len, gadget, out_err):
    try:
        _impl = _cb_impls[ctx]
        _ret = _impl.on_item(_unpack_Item(ctypes.string_at(item_ptr, item_len) if item_ptr else b""), Gadget._from_ptr(gadget))
        return 1 if _ret else 0
    except Exception as _exc:
        # Never unwind through the C frame: report the failure and return a
        # default; the producer aborts its call with FOREIGN_ERROR_CODE.
        _lib.weaveffi_error_set(out_err, -4, str(_exc).encode("utf-8", "replace"))
        return 0


def _ReadyListener_vtable_free_trampoline(ctx):
    # The producer's last reference is gone; it never touches `ctx` again.
    _cb_impls.pop(ctx, None)


# The one process-wide vtable for ReadyListener. The CFUNCTYPE objects are held at
# module scope so their function pointers stay valid for the process lifetime.
_ReadyListener_on_ready_cfunc = _ReadyListener_on_ready_cfunctype(_ReadyListener_on_ready_trampoline)
_ReadyListener_on_item_cfunc = _ReadyListener_on_item_cfunctype(_ReadyListener_on_item_trampoline)
_ReadyListener_vtable_free_cfunc = _ReadyListener_vtable_free_cfunctype(_ReadyListener_vtable_free_trampoline)
_ReadyListener_vtable = _ReadyListenerVtable(_ReadyListener_on_ready_cfunc, _ReadyListener_on_item_cfunc, _ReadyListener_vtable_free_cfunc)


