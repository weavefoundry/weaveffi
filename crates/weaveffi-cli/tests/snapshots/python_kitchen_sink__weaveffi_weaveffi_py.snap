class Gadget:
    """A pocket-sized interface exercising the object surface"""

    @classmethod
    def _from_ptr(cls, ptr) -> "Gadget":
        """Adopt one strong reference the producer handed over."""
        _obj = cls.__new__(cls)
        _obj._ptr = ptr
        return _obj

    def __init__(self, id: int) -> None:
        """Create a gadget with the given id
        """
        self._ptr = None
        _fn = _lib.weaveffi_kitchen_Gadget_new
        _fn.argtypes = [ctypes.c_int64, ctypes.POINTER(_WeaveFFIErrorStruct)]
        _fn.restype = ctypes.c_void_p
        _err = _WeaveFFIErrorStruct()
        _result = _fn(id, ctypes.byref(_err))
        _check_error(_err)
        if _result is None:
            raise WeaveFFIError(-1, "null pointer")
        self._ptr = _result


    def _clone_ptr(self):
        """A new strong reference to the same object (a raw pointer the
        receiver must eventually release), leaving this wrapper's own
        reference untouched."""
        return _lib.weaveffi_kitchen_Gadget_clone(_borrow(self))

    def close(self) -> None:
        """Release this wrapper's reference. The object itself is dropped
        when its last reference (here or in the producer) is released.
        Idempotent; the wrapper is unusable afterwards."""
        _p = getattr(self, "_ptr", None)
        self._ptr = None
        if _p is not None:
            _lib.weaveffi_kitchen_Gadget_destroy(_p)

    def __enter__(self) -> "Gadget":
        return self

    def __exit__(self, *exc) -> bool:
        self.close()
        return False

    def __del__(self) -> None:
        self.close()

    def describe(self) -> str:
        """Render the gadget as a human-readable string
        """
        _fn = _lib.weaveffi_kitchen_Gadget_describe
        _fn.argtypes = [ctypes.c_void_p, ctypes.POINTER(_WeaveFFIErrorStruct)]
        _fn.restype = ctypes.c_void_p
        _err = _WeaveFFIErrorStruct()
        _result = _fn(_borrow(self), ctypes.byref(_err))
        _check_error(_err)
        return _take_string(_result) or ""


    def poke(self, times: int) -> int:
        """Poke the gadget a number of times, failing on a negative count

        Raises
        ------
        KitchenErrorsError
            If the call reports one of the domain's error codes.
        """
        _fn = _lib.weaveffi_kitchen_Gadget_poke
        _fn.argtypes = [ctypes.c_void_p, ctypes.c_int32, ctypes.POINTER(_WeaveFFIErrorStruct)]
        _fn.restype = ctypes.c_int32
        _err = _WeaveFFIErrorStruct()
        _result = _fn(_borrow(self), times, ctypes.byref(_err))
