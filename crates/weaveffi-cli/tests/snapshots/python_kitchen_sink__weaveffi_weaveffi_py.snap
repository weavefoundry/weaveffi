class _StreamItemsIterator:
    """Lazy iterator over a producer stream: each step pulls one element
    across the C boundary. The native handle is released exactly once, on
    exhaustion, on close(), or when the iterator is garbage collected."""

    def __init__(self, ptr):
        self._ptr = ptr
        self._done = False

    def __iter__(self):
        return self

    def __next__(self):
        if self._done:
            raise StopIteration
        _next_fn = _lib.weaveffi_kitchen_StreamItemsIterator_next
        _next_fn.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(_WeaveFFIErrorStruct)]
        _next_fn.restype = ctypes.c_int32
        _out_item = ctypes.c_void_p()
        _out_len = ctypes.c_size_t(0)
        _err = _WeaveFFIErrorStruct()
        _has = _next_fn(self._ptr, ctypes.byref(_out_item), ctypes.byref(_out_len), ctypes.byref(_err))
        _check_error(_err)
        if not _has:
            self._done = True
            self._destroy()
            raise StopIteration
        return _unpack_Item(_take_buffer(_out_item.value, _out_len.value))

    def close(self):
        """Release the native iterator without draining it."""
        self._done = True
        self._destroy()

    def _destroy(self):
        if self._ptr is not None:
            _destroy_fn = _lib.weaveffi_kitchen_StreamItemsIterator_destroy
            _destroy_fn.argtypes = [ctypes.c_void_p]
            _destroy_fn.restype = None
            _destroy_fn(self._ptr)
            self._ptr = None

    def __del__(self):
        self._destroy()


