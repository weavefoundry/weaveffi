static inline void kitchen_sink_map_string_string_write(kitchen_sink_writer* w, const kitchen_sink_map_string_string* v) {
    kitchen_sink_writer_put_len(w, v->len);
    for (size_t i = 0; i < v->len; i++) {
        kitchen_sink_writer_put_string(w, v->keys[i]);
        kitchen_sink_writer_put_string(w, v->values[i]);
    }
}

static inline void kitchen_sink_map_string_string_read(kitchen_sink_reader* r, kitchen_sink_map_string_string* out) {
    memset(out, 0, sizeof *out);
    size_t n = kitchen_sink_reader_get_u32(r);
    out->keys = (kitchen_sink_str*)kitchen_sink_reader_alloc(r, n, sizeof(kitchen_sink_str), 8);
    out->values = (kitchen_sink_str*)kitchen_sink_reader_alloc(r, n, sizeof(kitchen_sink_str), 0);
    if (out->keys == NULL || out->values == NULL) {
        free(out->keys);
        free(out->values);
        out->keys = NULL;
        out->values = NULL;
        return;
    }
    out->len = n;
    for (size_t i = 0; i < n; i++) {
        out->keys[i] = kitchen_sink_reader_get_string(r);
        out->values[i] = kitchen_sink_reader_get_string(r);
    }
}

