static inline void kitchen_sink_kitchen_Item_write(kitchen_sink_writer* w, const kitchen_sink_kitchen_Item* v) {
    kitchen_sink_writer_put_i64(w, v->id);
    kitchen_sink_writer_put_string(w, v->name);
    kitchen_sink_writer_put_i32(w, v->count);
    kitchen_sink_writer_put_bool(w, v->enabled);
    kitchen_sink_writer_put_f64(w, v->ratio);
    kitchen_sink_writer_put_u32(w, v->nick);
    kitchen_sink_writer_put_bytes(w, v->payload);
    kitchen_sink_list_string_write(w, &v->tags);
    kitchen_sink_map_string_string_write(w, &v->attrs);
    kitchen_sink_opt_i64_write(w, v->parent);
    kitchen_sink_shared_Token_write(w, &v->token);
    kitchen_sink_writer_put_i32(w, (int32_t)v->priority);
    kitchen_sink_opt_Gadget_write(w, v->gadget);
}

static inline void kitchen_sink_kitchen_Item_read(kitchen_sink_reader* r, kitchen_sink_kitchen_Item* out) {
    memset(out, 0, sizeof *out);
    out->id = kitchen_sink_reader_get_i64(r);
    out->name = kitchen_sink_reader_get_string(r);
    out->count = kitchen_sink_reader_get_i32(r);
    out->enabled = kitchen_sink_reader_get_bool(r);
    out->ratio = kitchen_sink_reader_get_f64(r);
    out->nick = kitchen_sink_reader_get_u32(r);
    out->payload = kitchen_sink_reader_get_bytes(r);
    kitchen_sink_list_string_read(r, &out->tags);
    kitchen_sink_map_string_string_read(r, &out->attrs);
    kitchen_sink_opt_i64_read(r, &out->parent);
    kitchen_sink_shared_Token_read(r, &out->token);
    out->priority = (kitchen_sink_kitchen_Priority)kitchen_sink_reader_get_i32(r);
    kitchen_sink_opt_Gadget_read(r, &out->gadget);
}

static inline bool kitchen_sink_kitchen_Item_decode(const uint8_t* ptr, size_t len, kitchen_sink_kitchen_Item* out) {
    kitchen_sink_reader r = kitchen_sink_reader_of(ptr, len);
