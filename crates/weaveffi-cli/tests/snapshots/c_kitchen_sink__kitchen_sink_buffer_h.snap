}

static inline void kitchen_sink_map_string_string_free(kitchen_sink_map_string_string* v) {
    for (size_t i = 0; i < v->len; i++) {
        kitchen_sink_str_free(&v->keys[i]);
        kitchen_sink_str_free(&v->values[i]);
