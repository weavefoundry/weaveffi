namespace shapes {

/**
 * Base exception for every error reported through the C ABI.
 *
 * Positive codes are the declared error codes (see the typed domain
 * exceptions); negative codes are runtime traps: -1 a generic producer
 * error, -2 a producer panic, -3 a marshalling failure, -4 a
 * callback-interface implementation that threw, and -5 a cancelled call
 * (thrown as Cancelled).
 */
class Error : public std::runtime_error {
    int32_t code_;

public:
    /** Builds an error carrying `code` and `message`. */
    Error(int32_t code, const std::string& message) : std::runtime_error(message), code_(code) {}

    /** The numeric error code. */
    int32_t code() const noexcept { return code_; }
};

/** Thrown by an async call whose CancelToken was cancelled (code -5). */
class Cancelled : public Error {
public:
    /** Builds a cancellation error carrying the producer's message. */
    explicit Cancelled(const std::string& message) : Error(-5, message) {}
};

/**
 * Thrown on first use when the linked shapes library was built for a
 * different C ABI revision or a different API contract than this header.
 */
class LoadError : public Error {
public:
    /** Builds a load error describing the mismatch. */
    explicit LoadError(const std::string& message) : Error(-1, message) {}
};

/**
 * Tag selecting the constructor that adopts a raw C pointer (one strong
 * reference the wrapper then owns), in the style of std::adopt_lock.
 */
struct adopt_t {
    explicit adopt_t() = default;
};

/** The adopt_t tag value: `Gadget g(adopt, raw)`. */
inline constexpr adopt_t adopt{};

/**
 * A cancellation token for cancellable async functions.
 *
 * Create one, pass it to any number of cancellable calls, and call cancel()
 * from any thread. A cancelled call settles its future with Cancelled. Each
 * call takes its own reference to the native token, so the token can be
 * destroyed at any time; the destructor releases this wrapper's reference.
 */
class CancelToken {
    shapes_cancel_token* handle_;

    struct none_t {};
    explicit CancelToken(none_t) noexcept : handle_(nullptr) {}

public:
    /** Creates a new, uncancelled token. */
    CancelToken() : handle_(shapes_cancel_token_create()) {
        if (handle_ == nullptr) throw std::bad_alloc();
    }

    /** Releases this wrapper's reference to the native token. */
    ~CancelToken() {
        if (handle_ != nullptr) shapes_cancel_token_destroy(handle_);
    }

    CancelToken(const CancelToken&) = delete;
    CancelToken& operator=(const CancelToken&) = delete;

    /** Transfers the native token; `other` becomes empty. */
    CancelToken(CancelToken&& other) noexcept : handle_(other.handle_) { other.handle_ = nullptr; }

    /** Releases the current token and takes over `other`'s. */
    CancelToken& operator=(CancelToken&& other) noexcept {
        if (this != &other) {
            if (handle_ != nullptr) shapes_cancel_token_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** The empty token a cancellable call uses when none is passed. */
    static const CancelToken& none() noexcept {
        static const CancelToken token{none_t{}};
        return token;
    }

    /** Requests cancellation of every call this token was passed to. Idempotent and thread-safe. */
    void cancel() const noexcept {
        if (handle_ != nullptr) shapes_cancel_token_cancel(handle_);
    }

    /** Whether cancel() has been called. */
    bool is_cancelled() const noexcept {
        return handle_ != nullptr && shapes_cancel_token_is_cancelled(handle_);
    }

    /** The native token, borrowed (null for an empty token). */
    shapes_cancel_token* handle() const noexcept { return handle_; }
};

namespace detail {

/** The exception for a runtime (non-domain) error code. */
inline std::exception_ptr make_error(int32_t code, const std::string& message) {
    if (code == -5) return std::make_exception_ptr(Cancelled(message));
    return std::make_exception_ptr(Error(code, message));
}

/** The message of a nonzero error slot. */
inline std::string error_message(const shapes_error& err) {
    return std::string(err.message != nullptr ? err.message : "unknown error");
}

/** Throws the generic Error (or Cancelled) if `err` carries a nonzero code. */
inline void check(shapes_error& err) {
    if (err.code == 0) return;
    std::exception_ptr ex = make_error(err.code, error_message(err));
    shapes_error_clear(&err);
    std::rethrow_exception(ex);
}

/** Copies a producer-returned UTF-8 run into a string, then releases it. */
inline std::string take_string(const uint8_t* ptr, size_t len) {
    if (ptr == nullptr) return std::string();
    struct Release {
        const uint8_t* ptr;
        size_t len;
        ~Release() { shapes_free_bytes(const_cast<uint8_t*>(ptr), len); }
    } release{ptr, len};
    return std::string(reinterpret_cast<const char*>(ptr), len);
}

/** Copies a producer-returned byte run into a vector, then releases it. */
inline std::vector<uint8_t> take_bytes(const uint8_t* ptr, size_t len) {
    if (ptr == nullptr) return std::vector<uint8_t>();
    struct Release {
        const uint8_t* ptr;
        size_t len;
        ~Release() { shapes_free_bytes(const_cast<uint8_t*>(ptr), len); }
    } release{ptr, len};
    return std::vector<uint8_t>(ptr, ptr + len);
}

/** Views a borrowed UTF-8 run (null when empty) as a string_view. */
inline std::string_view borrow_string(const uint8_t* ptr, size_t len) noexcept {
    if (ptr == nullptr || len == 0) return std::string_view();
    return std::string_view(reinterpret_cast<const char*>(ptr), len);
}

/** Views a borrowed byte run (null when empty) as an owned vector. */
inline std::vector<uint8_t> borrow_bytes(const uint8_t* ptr, size_t len) {
    if (ptr == nullptr || len == 0) return std::vector<uint8_t>();
    return std::vector<uint8_t>(ptr, ptr + len);
}

/** The data pointer of a string argument, as the C ABI expects it. */
inline const uint8_t* utf8(std::string_view s) noexcept {
    return reinterpret_cast<const uint8_t*>(s.data());
}

} // namespace detail

/**
 * Verifies that the linked shapes library implements the C ABI revision
 * and the module contracts this header was generated against, throwing
 * LoadError naming the first mismatch. The check runs once; every free
 * function, constructor, and static member calls this before its first
 * native call, so calling it at startup is optional.
 */
inline void check_library() {
    static const std::string failure = [] {
        uint32_t abi = shapes_abi_version();
        if (abi != SHAPES_ABI_VERSION) {
            return "shapes: C ABI revision mismatch (header " + std::to_string(SHAPES_ABI_VERSION) +
                   ", library " + std::to_string(abi) + ")";
        }
        if (shapes_shapes_checksum() != 0x06acf433ffa2a0f0ull) {
            return std::string("shapes: module 'shapes' does not match the linked library (contract checksum mismatch); regenerate the bindings for this build");
        }
        return std::string();
    }();
    if (!failure.empty()) throw LoadError(failure);
}

namespace detail {

/**
 * Serializes values into the value-buffer wire format: little-endian, packed
 * with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const noexcept { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const noexcept { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a byte length or an element count as a u32. */
    void write_len(size_t n) {
        if (static_cast<uint64_t>(n) > UINT32_MAX) throw Error(-3, "value buffer length exceeds u32");
        append_le(static_cast<uint32_t>(n));
    }

    void write_string(std::string_view v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }
};

/**
 * Decodes values from the value-buffer wire format. A malformed buffer is a
 * producer/consumer contract violation (both sides are generated from one
 * API), so every decode failure throws the generic Error with the
 * marshalling code -3. Object tokens adopted before a failure live in RAII
 * wrappers that release them on unwind.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    [[noreturn]] static void fail(const char* what) {
        throw Error(-3, std::string("malformed value buffer: ") + what);
    }

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    BufferReader(const uint8_t* data, size_t len) noexcept : data_(data), len_(data != nullptr ? len : 0), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const noexcept { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a byte length, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    /**
     * Reads an element count. Elements may encode to zero bytes, so a count
     * larger than the bytes remaining is legal; callers cap preallocation
     * with reserve_hint().
     */
    size_t read_count() { return static_cast<size_t>(read_le<uint32_t>("count")); }

    /** A preallocation size for `n` elements that a malformed count can't inflate. */
    size_t reserve_hint(size_t n) const noexcept { return n < remaining() ? n : remaining(); }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with shapes_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    BufferGuard(const uint8_t* p, size_t n) noexcept : ptr(p), len(n) {}
    BufferGuard(const BufferGuard&) = delete;
    BufferGuard& operator=(const BufferGuard&) = delete;

    ~BufferGuard() {
        if (ptr != nullptr) shapes_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

} // namespace detail

/** A plain C-style enum (no payloads) */
enum class Channel : int32_t {
    Red = 0,
    Green = 1,
    Blue = 2
};

struct Numerics;
struct Shape;

/** One field per supported numeric primitive */
struct Numerics {
    int8_t a;
    int16_t b;
    int32_t c;
    int64_t d;
    uint8_t e;
    uint16_t f;
    uint32_t g;
    uint64_t h;
    float i;
    double j;
};

/** An algebraic shape (sum type with associated data) */
struct Shape {
    /** Discriminant identifying the active variant of `Shape`. */
    enum class Tag : int32_t {
        Empty = 0,
        Circle = 1,
        Rectangle = 2,
        Bounded = 3,
        Labeled = 4
    };

    /** The empty shape (a unit variant) */
    struct Empty {
    };

    /** A circle with a radius */
    struct Circle {
        /** Radius in points */
        double radius;
    };

    /** An axis-aligned rectangle */
    struct Rectangle {
        float width;
        float height;
    };

    /** An integer-bounded shape (exercises narrow + wide ints) */
    struct Bounded {
        int16_t min;
        int16_t max;
        uint64_t weight;
    };

    /** A labeled shape with a small count */
    struct Labeled {
        std::string label;
        uint8_t count;
    };

    /** The active variant's payload. */
    std::variant<Empty, Circle, Rectangle, Bounded, Labeled> value;

    /** The tag of the active variant. */
    Tag tag() const {
        static constexpr Tag tags[] = {
            Tag::Empty,
            Tag::Circle,
            Tag::Rectangle,
            Tag::Bounded,
            Tag::Labeled
        };
        return tags[value.index()];
    }
};

namespace detail {

/** Encodes a `Numerics` in the value-buffer wire format. */
inline void write_Numerics(BufferWriter& w, const Numerics& v) {
    w.write_i8(v.a);
    w.write_i16(v.b);
    w.write_i32(v.c);
    w.write_i64(v.d);
    w.write_u8(v.e);
    w.write_u16(v.f);
    w.write_u32(v.g);
    w.write_u64(v.h);
    w.write_f32(v.i);
    w.write_f64(v.j);
}

/** Decodes a `Numerics` from the value-buffer wire format. */
inline Numerics read_Numerics(BufferReader& r) {
    int8_t f_a = r.read_i8();
    int16_t f_b = r.read_i16();
    int32_t f_c = r.read_i32();
    int64_t f_d = r.read_i64();
    uint8_t f_e = r.read_u8();
    uint16_t f_f = r.read_u16();
    uint32_t f_g = r.read_u32();
    uint64_t f_h = r.read_u64();
    float f_i = r.read_f32();
    double f_j = r.read_f64();
    return Numerics{std::move(f_a), std::move(f_b), std::move(f_c), std::move(f_d), std::move(f_e), std::move(f_f), std::move(f_g), std::move(f_h), std::move(f_i), std::move(f_j)};
}

/** Encodes a `Shape` in the value-buffer wire format. */
inline void write_Shape(BufferWriter& w, const Shape& v) {
    switch (v.value.index()) {
    case 0: {
        w.write_i32(0);
        break;
    }
    case 1: {
        w.write_i32(1);
        const Shape::Circle& p = std::get<1>(v.value);
        w.write_f64(p.radius);
        break;
    }
    case 2: {
        w.write_i32(2);
        const Shape::Rectangle& p = std::get<2>(v.value);
        w.write_f32(p.width);
        w.write_f32(p.height);
        break;
    }
    case 3: {
        w.write_i32(3);
        const Shape::Bounded& p = std::get<3>(v.value);
        w.write_i16(p.min);
        w.write_i16(p.max);
        w.write_u64(p.weight);
        break;
    }
    case 4: {
        w.write_i32(4);
        const Shape::Labeled& p = std::get<4>(v.value);
        w.write_string(p.label);
        w.write_u8(p.count);
        break;
    }
    }
}

/** Decodes a `Shape` from the value-buffer wire format. */
inline Shape read_Shape(BufferReader& r) {
    int32_t tag = r.read_i32();
    switch (tag) {
    case 0: {
        return Shape{Shape::Empty{}};
    }
    case 1: {
        double f_radius = r.read_f64();
        return Shape{Shape::Circle{std::move(f_radius)}};
    }
    case 2: {
        float f_width = r.read_f32();
        float f_height = r.read_f32();
        return Shape{Shape::Rectangle{std::move(f_width), std::move(f_height)}};
    }
    case 3: {
        int16_t f_min = r.read_i16();
        int16_t f_max = r.read_i16();
        uint64_t f_weight = r.read_u64();
        return Shape{Shape::Bounded{std::move(f_min), std::move(f_max), std::move(f_weight)}};
    }
    case 4: {
        std::string f_label = r.read_string();
        uint8_t f_count = r.read_u8();
        return Shape{Shape::Labeled{std::move(f_label), std::move(f_count)}};
    }
    default:
        break;
    }
    throw Error(-3, "malformed value buffer: unknown Shape tag");
}

} // namespace detail

namespace shapes {

/** Render a shape to a string */
inline std::string describe(const Shape& shape) {
    check_library();
    detail::BufferWriter shape_buf;
    detail::write_Shape(shape_buf, shape);
    size_t out_len = 0;
    shapes_error err{};
    auto result = shapes_shapes_describe(shape_buf.data(), shape_buf.size(), &out_len, &err);
    detail::check(err);
    return detail::take_string(result, out_len);
}

/** Scale a shape by a factor, returning a new shape */
inline Shape scale(const Shape& shape, double factor) {
    check_library();
    detail::BufferWriter shape_buf;
    detail::write_Shape(shape_buf, shape);
    size_t out_len = 0;
    shapes_error err{};
    auto result = shapes_shapes_scale(shape_buf.data(), shape_buf.size(), factor, &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    Shape ret = detail::read_Shape(result_r);
    result_r.expect_end();
    return ret;
}

/** Sum a list of bytes into a wide integer (numerics smoke) */
inline uint64_t sum_bytes(const std::vector<uint8_t>& values) {
    check_library();
    shapes_error err{};
    auto result = shapes_shapes_sum_bytes(values.data(), values.size(), &err);
    detail::check(err);
    return result;
}

/** Build a Numerics struct from every numeric primitive */
inline Numerics make_numerics(int8_t a, int16_t b, int32_t c, int64_t d, uint8_t e, uint16_t f, uint32_t g, uint64_t h, float i, double j) {
    check_library();
    size_t out_len = 0;
    shapes_error err{};
    auto result = shapes_shapes_make_numerics(a, b, c, d, e, f, g, h, i, j, &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    Numerics ret = detail::read_Numerics(result_r);
    result_r.expect_end();
    return ret;
}

} // namespace shapes

} // namespace shapes

