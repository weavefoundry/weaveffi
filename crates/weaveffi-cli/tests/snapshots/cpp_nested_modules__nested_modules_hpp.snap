/** Construct a Shape. */
inline Shape make_shape(int32_t sides) {
    check_library();
    size_t out_len = 0;
    nested_modules_error err{};
    auto result = nested_modules_graphics_shapes_make_shape(sides, &out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_Shape);
}

/** Nested function returning a struct owned by an ancestor module. */
inline Canvas describe() {
    check_library();
    size_t out_len = 0;
    nested_modules_error err{};
    auto result = nested_modules_graphics_shapes_describe(&out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_Canvas);
}

} // namespace graphics::shapes

namespace graphics::shapes::geometry {

/**
 * Deeper function taking an ancestor-module struct. Throws through the root module's inherited GraphicsError domain.
 *
 * @throws GraphicsError when the call fails with one of the domain's codes.
 */
inline Detail compute(const Shape& shape) {
    check_library();
    detail::BufferWriter shape_buf;
    detail::write_Shape(shape_buf, shape);
    size_t out_len = 0;
    nested_modules_error err{};
    auto result = nested_modules_graphics_shapes_geometry_compute(shape_buf.data(), shape_buf.size(), &out_len, &err);
    detail::check_graphics(err);
    return detail::take(result, out_len, &detail::read_Detail);
}

} // namespace graphics::shapes::geometry

} // namespace nested_modules

// END nested_modules.hpp
