   `out_err` (the message is cut at its first NUL). */
JNIEXPORT void JNICALL Java_kitchen_1sink_JniBridge_error_1set(JNIEnv* env, jclass cls, jlong err, jint code, jbyteArray message) {
    (void)cls;
    Jni_bytes m = Jni_borrow_bytes(env, message);
    char* text = (char*)malloc(m.len + 1u);
    if (text != NULL) {
        if (m.len > 0) {
            memcpy(text, m.ptr, m.len);
        }
        text[m.len] = '\0';
    }
    Jni_release_bytes(env, &m);
    kitchen_sink_error_set((kitchen_sink_error*)(intptr_t)err, (int32_t)code, text != NULL ? text : "callback failed");
    free(text);
}

