static bool Jni_kitchen_Sampler_threshold(void* ctx, bool p_has_level, uint32_t p_level, double* out_value, kitchen_sink_error* out_err) {
    int detach = 0;
    JNIEnv* env = Jni_callback_begin(out_err, &detach);
    if (env == NULL) {
        return (bool)0;
    }
    jvalue value = {0};
    bool present = Jni_callback_opt(env, Jni_D, (*env)->CallStaticObjectMethod(env, Jni_bridge, Jni_mid_kitchen_Sampler_threshold, (jobject)ctx, (jlong)(intptr_t)out_err, p_has_level ? JNI_TRUE : JNI_FALSE, (jint)p_level), &value);
    if (present) {
        *out_value = (double)value.d;
    }
    Jni_callback_end(env, out_err, detach);
    return present;
}

