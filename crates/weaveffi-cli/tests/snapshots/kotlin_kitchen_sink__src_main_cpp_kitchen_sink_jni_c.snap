   implementation, from whatever thread the producer releases it on. */
static void Jni_release_callback(void* ctx) {
    int detach = 0;
    JNIEnv* env = Jni_env(&detach);
    if (env != NULL) {
        if (ctx != NULL) {
            (*env)->DeleteGlobalRef(env, (jobject)ctx);
        }
        Jni_env_done(detach);
    }
}

