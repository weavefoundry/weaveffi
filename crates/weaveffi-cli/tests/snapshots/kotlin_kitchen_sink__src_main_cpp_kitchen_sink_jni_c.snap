static jint Jni_load(JNIEnv* env) {
    if (Jni_check_contract(env, kitchen_sink_shared_contract, Jni_contract_shared, sizeof Jni_contract_shared / sizeof Jni_contract_shared[0]) != JNI_OK) {
        return JNI_ERR;
    }
    if (Jni_check_contract(env, kitchen_sink_kitchen_contract, Jni_contract_kitchen, sizeof Jni_contract_kitchen / sizeof Jni_contract_kitchen[0]) != JNI_OK) {
        return JNI_ERR;
    }
    if (Jni_load_boxes(env) != JNI_OK) {
        return JNI_ERR;
    }
    if (Jni_load_async(env) != JNI_OK) {
        return JNI_ERR;
    }
    Jni_mid_kitchen_ReadyListener_on_ready = (*env)->GetStaticMethodID(env, Jni_bridge, "kitchen_ReadyListener_on_ready", "(Lkitchen_sink/ReadyListener;JI[B)V");
    if (Jni_mid_kitchen_ReadyListener_on_ready == NULL) {
        return JNI_ERR;
    }
    Jni_mid_kitchen_ReadyListener_on_item = (*env)->GetStaticMethodID(env, Jni_bridge, "kitchen_ReadyListener_on_item", "(Lkitchen_sink/ReadyListener;J[BJ)Z");
    if (Jni_mid_kitchen_ReadyListener_on_item == NULL) {
        return JNI_ERR;
    }
    Jni_mid_kitchen_ReadyListener_label = (*env)->GetStaticMethodID(env, Jni_bridge, "kitchen_ReadyListener_label", "(Lkitchen_sink/ReadyListener;J)[B");
    if (Jni_mid_kitchen_ReadyListener_label == NULL) {
