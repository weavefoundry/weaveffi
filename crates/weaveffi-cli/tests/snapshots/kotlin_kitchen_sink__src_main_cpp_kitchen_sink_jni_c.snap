static void Jni_kitchen_ReadyListener_on_ready(void* ctx, int32_t p_code, const uint8_t* p_msg_ptr, size_t p_msg_len, kitchen_sink_error* out_err) {
    int detach = 0;
    JNIEnv* env = Jni_callback_begin(out_err, &detach);
    if (env == NULL) {
        return;
    }
    jarray a_msg = Jni_new_array(env, Jni_B, p_msg_ptr, p_msg_len);
    if ((*env)->ExceptionCheck(env)) {
        Jni_callback_end(env, out_err, detach);
        return;
    }
    (*env)->CallStaticVoidMethod(env, Jni_bridge, Jni_mid_kitchen_ReadyListener_on_ready, (jobject)ctx, (jlong)(intptr_t)out_err, (jint)p_code, a_msg);
    Jni_callback_end(env, out_err, detach);
}

static bool Jni_kitchen_ReadyListener_on_item(void* ctx, const uint8_t* p_item_ptr, size_t p_item_len, kitchen_sink_kitchen_Gadget* p_gadget, kitchen_sink_error* out_err) {
    int detach = 0;
    JNIEnv* env = Jni_callback_begin(out_err, &detach);
    if (env == NULL) {
        if (p_gadget != NULL) { kitchen_sink_kitchen_Gadget_destroy(p_gadget); }
        return (bool)0;
    }
    jarray a_item = Jni_new_array(env, Jni_B, p_item_ptr, p_item_len);
    if ((*env)->ExceptionCheck(env)) {
        if (p_gadget != NULL) { kitchen_sink_kitchen_Gadget_destroy(p_gadget); }
        Jni_callback_end(env, out_err, detach);
        return (bool)0;
    }
    jboolean rv = (*env)->CallStaticBooleanMethod(env, Jni_bridge, Jni_mid_kitchen_ReadyListener_on_item, (jobject)ctx, (jlong)(intptr_t)out_err, a_item, (jlong)(intptr_t)p_gadget);
    Jni_callback_end(env, out_err, detach);
    return rv == JNI_TRUE;
}

