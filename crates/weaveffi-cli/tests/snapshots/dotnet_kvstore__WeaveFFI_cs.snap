    }

    public static class Kv
    {
        private static readonly object _listenerLock = new object();
        // Live listener delegates by subscription id. Holding the delegate
        // here keeps its native thunk alive until unregistered; without this
        // the GC could collect a delegate the producer still calls.
        private static readonly Dictionary<ulong, Delegate> _listenerRefs = new Dictionary<ulong, Delegate>();

        /// <summary>Subscribe to per-key eviction notifications</summary>
        /// <returns>A subscription id for UnregisterEvictionListener().</returns>
        public static ulong RegisterEvictionListener(Action<string> callback)
        {
            NativeMethods.Cb_weaveffi_kv_OnEvict_fn trampoline = (key, context) =>
            {
                callback(Marshal.PtrToStringUTF8(key) ?? "");
            };
            ulong id;
            lock (_listenerLock)
            {
                id = NativeMethods.weaveffi_kv_register_eviction_listener(trampoline, IntPtr.Zero);
                _listenerRefs[id] = trampoline;
            }
            return id;
        }

        /// <summary>Unregisters a listener previously registered with RegisterEvictionListener().</summary>
        public static void UnregisterEvictionListener(ulong id)
        {
            NativeMethods.weaveffi_kv_unregister_eviction_listener(id);
            lock (_listenerLock)
            {
                _listenerRefs.Remove(id);
            }
        }

    }

    public static class KvStats
    {
        /// <summary>Snapshot the current store statistics</summary>
        /// <exception cref="KvException">Thrown when the call reports a KvError code.</exception>
        public static Stats GetStats(Store store)
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_kv_stats_get_stats(store.Handle, out var outLen, ref err);
            WeaveFFIError.CheckKv(err);
            var resultBuf = new byte[(int)outLen];
            if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
            NativeMethods.weaveffi_free_bytes(result, outLen);
            var valueReader = new WeaveFFIBufferReader(resultBuf);
            var value = Stats.ReadFrom(valueReader);
            valueReader.ExpectEnd();
            return value;
        }

    }

}

// END WeaveFFI.cs
