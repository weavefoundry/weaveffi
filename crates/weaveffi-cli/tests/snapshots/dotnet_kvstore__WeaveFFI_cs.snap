        {
            var fId = reader.ReadI64();
            var fKey = reader.ReadString();
            var fValue = reader.ReadBytes();
            var fCreatedAt = reader.ReadI64();
            long? fExpiresAt = null;
            if (reader.ReadOptionFlag())
            {
                var fExpiresAtValue = reader.ReadI64();
                fExpiresAt = fExpiresAtValue;
            }
            var fTagsCount = reader.ReadLen();
            var fTags = new string[fTagsCount];
            for (int i0 = 0; i0 < fTagsCount; i0++)
            {
                var fTagsItem = reader.ReadString();
                fTags[i0] = fTagsItem;
            }
            var fMetadataCount = reader.ReadLen();
            var fMetadata = new Dictionary<string, string>(fMetadataCount);
            for (int i0 = 0; i0 < fMetadataCount; i0++)
            {
                var fMetadataKey = reader.ReadString();
                var fMetadataVal = reader.ReadString();
                fMetadata[fMetadataKey] = fMetadataVal;
            }
            return new Entry(fId, fKey, fValue, fCreatedAt, fExpiresAt, fTags, fMetadata);
        }
