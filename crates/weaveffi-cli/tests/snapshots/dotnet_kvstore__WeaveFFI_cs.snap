    /// <summary>Aggregate store statistics</summary>
    public sealed class Stats
    {
        /// <summary>Number of live entries</summary>
        public long TotalEntries { get; }

        /// <summary>Sum of all value byte lengths</summary>
        public long TotalBytes { get; }

        /// <summary>Number of entries past their TTL but not yet evicted</summary>
        public long ExpiredEntries { get; }

        public Stats(long totalEntries, long totalBytes, long expiredEntries)
        {
            TotalEntries = totalEntries;
            TotalBytes = totalBytes;
            ExpiredEntries = expiredEntries;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI64(TotalEntries);
            writer.WriteI64(TotalBytes);
            writer.WriteI64(ExpiredEntries);
        }

        internal static Stats ReadFrom(WeaveFFIBufferReader reader)
        {
            var fTotalEntries = reader.ReadI64();
            var fTotalBytes = reader.ReadI64();
            var fExpiredEntries = reader.ReadI64();
            return new Stats(fTotalEntries, fTotalBytes, fExpiredEntries);
        }
    }

