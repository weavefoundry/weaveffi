// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

#ifndef WEAVEFFI_H
#define WEAVEFFI_H

#include <stdint.h>
#include <stddef.h>
#include <stdbool.h>

#ifndef WEAVEFFI_API
#  if defined(_WIN32) || defined(__CYGWIN__)
#    ifdef WEAVEFFI_BUILD
#      define WEAVEFFI_API __declspec(dllexport)
#    else
#      define WEAVEFFI_API __declspec(dllimport)
#    endif
#  elif defined(__EMSCRIPTEN__)
#    define WEAVEFFI_API __attribute__((used, visibility("default")))
#  elif defined(__GNUC__) && (__GNUC__ >= 4)
#    define WEAVEFFI_API __attribute__((visibility("default")))
#  else
#    define WEAVEFFI_API
#  endif
#endif

#ifndef WEAVEFFI_DEPRECATED
#  if defined(_MSC_VER)
#    define WEAVEFFI_DEPRECATED(msg) __declspec(deprecated(msg))
#  elif defined(__GNUC__) || defined(__clang__)
#    define WEAVEFFI_DEPRECATED(msg) __attribute__((deprecated(msg)))
#  else
#    define WEAVEFFI_DEPRECATED(msg)
#  endif
#endif

#ifdef __cplusplus
extern "C" {
#endif

typedef uint64_t weaveffi_handle_t;

/* Error slot written by every fallible call. `payload_ptr`/`payload_len`
   hold the matched error code's fields serialized in the WeaveFFI value
   buffer format (null when the code declares no fields); both the message
   and the payload are released by weaveffi_error_clear. */
typedef struct weaveffi_error {
    int32_t code;
    const char* message;
    const uint8_t* payload_ptr;
    size_t payload_len;
} weaveffi_error;

WEAVEFFI_API void weaveffi_error_clear(weaveffi_error* err);
WEAVEFFI_API void weaveffi_free_string(const char* ptr);
WEAVEFFI_API void weaveffi_free_bytes(uint8_t* ptr, size_t len);

/* Linear-memory allocator used by the Wasm JS glue to stage call
   arguments. Native consumers never call these; producers targeting
   WebAssembly must export them (the generated weaveffi.c provides
   malloc/free-backed defaults). */
WEAVEFFI_API uint8_t* weaveffi_alloc(uint32_t size);
WEAVEFFI_API void weaveffi_dealloc(uint8_t* ptr, uint32_t size);

typedef struct weaveffi_cancel_token weaveffi_cancel_token;
WEAVEFFI_API weaveffi_cancel_token* weaveffi_cancel_token_create(void);
WEAVEFFI_API void weaveffi_cancel_token_cancel(weaveffi_cancel_token* token);
WEAVEFFI_API bool weaveffi_cancel_token_is_cancelled(const weaveffi_cancel_token* token);
WEAVEFFI_API void weaveffi_cancel_token_destroy(weaveffi_cancel_token* token);

/*
 * Value buffer convention: records, rich enums, lists, maps, and
 * optionals cross the ABI serialized in the WeaveFFI value buffer
 * format (little-endian; see the generated bindings or the WeaveFFI
 * buffer protocol spec for the per-type encoding).
 * A buffered parameter named "v" expands to a borrowed view:
 *   const uint8_t* v_ptr, size_t v_len
 * A buffered return is a producer-allocated buffer returned as
 * `const uint8_t*` with a trailing `size_t* out_len`; the caller
 * decodes it and then releases it with weaveffi_free_bytes.
 */

/** Persistence semantics applied to a stored entry */
typedef enum {
    /** In-memory only; lost on close */
    weaveffi_kv_EntryKind_Volatile = 0,
    /** Flushed to durable storage */
    weaveffi_kv_EntryKind_Persistent = 1,
    /** Persistent and encrypted at rest */
    weaveffi_kv_EntryKind_Encrypted = 2
} weaveffi_kv_EntryKind;
/** Error codes reported by throwing functions in the `kv` module tree. */
typedef enum {
    /** No entry exists for the requested key */
    weaveffi_kv_KvError_KeyNotFound = 1001,
    /** The entry exists but its TTL has elapsed */
    weaveffi_kv_KvError_Expired = 1002,
    /** The store has reached its capacity limit */
    weaveffi_kv_KvError_StoreFull = 1003,
    /** Underlying storage reported an I/O failure */
    weaveffi_kv_KvError_IoError = 1004
} weaveffi_kv_KvError;
typedef struct weaveffi_kv_Store weaveffi_kv_Store;
typedef struct weaveffi_kv_Store_ListKeysIterator weaveffi_kv_Store_ListKeysIterator;
/** Fires when an entry is evicted from the store */
typedef void (*weaveffi_kv_OnEvict_fn)(const char* key, void* context);
typedef void (*weaveffi_kv_Store_compact_callback)(void* context, weaveffi_error* err, int64_t result);

// Module: kv
/** An in-memory key-value store owning its entries; destroying the object releases all of its state */
/** Open (or create) a store backed by the given filesystem path */
WEAVEFFI_API weaveffi_kv_Store* weaveffi_kv_Store_open(const char* path, weaveffi_error* out_err);
/** The largest number of live entries one store will hold */
WEAVEFFI_API int64_t weaveffi_kv_Store_default_capacity(weaveffi_error* out_err);
/** Insert or replace a value, returning true on success */
WEAVEFFI_API bool weaveffi_kv_Store_put(const weaveffi_kv_Store* self, const char* key, const uint8_t* value_ptr, size_t value_len, weaveffi_kv_EntryKind kind, const uint8_t* ttl_seconds_ptr, size_t ttl_seconds_len, weaveffi_error* out_err);
/** Look up an entry by key; returns null if missing or expired */
WEAVEFFI_API const uint8_t* weaveffi_kv_Store_get(const weaveffi_kv_Store* self, const char* key, size_t* out_len, weaveffi_error* out_err);
/** Remove the entry for the given key, returning true if it existed */
WEAVEFFI_API bool weaveffi_kv_Store_delete(const weaveffi_kv_Store* self, const char* key, weaveffi_error* out_err);
/** Stream every key, optionally filtered by a prefix */
WEAVEFFI_API weaveffi_kv_Store_ListKeysIterator* weaveffi_kv_Store_list_keys(const weaveffi_kv_Store* self, const uint8_t* prefix_ptr, size_t prefix_len, weaveffi_error* out_err);
WEAVEFFI_API int32_t weaveffi_kv_Store_ListKeysIterator_next(weaveffi_kv_Store_ListKeysIterator* iter, const char** out_item, weaveffi_error* out_err);
WEAVEFFI_API void weaveffi_kv_Store_ListKeysIterator_destroy(weaveffi_kv_Store_ListKeysIterator* iter);
/** Return the number of live entries in the store */
WEAVEFFI_API int64_t weaveffi_kv_Store_count(const weaveffi_kv_Store* self, weaveffi_error* out_err);
/** Drop every entry from the store */
WEAVEFFI_API void weaveffi_kv_Store_clear(const weaveffi_kv_Store* self, weaveffi_error* out_err);
/** Reclaim space asynchronously; returns the number of bytes reclaimed */
WEAVEFFI_API void weaveffi_kv_Store_compact_async(const weaveffi_kv_Store* self, weaveffi_cancel_token* cancel_token, weaveffi_kv_Store_compact_callback callback, void* context);
/** Legacy single-shot put kept for compatibility */
WEAVEFFI_DEPRECATED("use put() with explicit kind")
WEAVEFFI_API bool weaveffi_kv_Store_legacy_put(const weaveffi_kv_Store* self, const char* key, const uint8_t* value_ptr, size_t value_len, weaveffi_error* out_err);
WEAVEFFI_API void weaveffi_kv_Store_destroy(weaveffi_kv_Store* self);

/** Subscribe to per-key eviction notifications */
WEAVEFFI_API uint64_t weaveffi_kv_register_eviction_listener(weaveffi_kv_OnEvict_fn callback, void* context);
/** Subscribe to per-key eviction notifications */
WEAVEFFI_API void weaveffi_kv_unregister_eviction_listener(uint64_t id);

// Module: kv_stats
/** Snapshot the current store statistics */
WEAVEFFI_API const uint8_t* weaveffi_kv_stats_get_stats(const weaveffi_kv_Store* store, size_t* out_len, weaveffi_error* out_err);


#ifdef __cplusplus
}
#endif

#endif // WEAVEFFI_H

// END weaveffi.h
