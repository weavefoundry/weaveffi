    (0x2e086c45e9d617de, 0x4d43bf32358c01ff, 'docs.Notebook.find'),
    (0x4817dc98197ad960, 0xf8017b5a7d58b2c7, 'docs.Notebook.size'),
    (0x614de47452d5a55c, 0xd9aae1472494ffef, 'docs.get_document'),
    (0x67c5cb9fc119bcd5, 0x08d5b25a1a22a7fa, 'docs.Document'),
    (0x8d484bf2d78c9b70, 0xe9093cf96912194c, 'docs.Notebook.max_documents'),
    (0xaea61d6451691c67, 0xe4704128b3524b3d, 'docs.watch'),
    (0xd68d6ad1540cdec5, 0x01afeb40b0a8bfe1, 'docs.Notebook'),
    (0xdb0601444a4760cc, 0xe56c69629b444797, 'docs.create_document'),
