  int32_t t = 0;
  if (!js_arg_i32(env, v, &t)) return false;
  *out = (int8_t)t;
  return true;
}

JS_HELPER bool js_arg_i16(napi_env env, napi_value v, int16_t* out) {
  int32_t t = 0;
  if (!js_arg_i32(env, v, &t)) return false;
