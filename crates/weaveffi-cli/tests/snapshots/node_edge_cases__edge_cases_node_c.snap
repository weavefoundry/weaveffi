  napi_handle_scope scope;
  napi_open_handle_scope(env, &scope);
  napi_value argv[5];
  argv[0] = js_new_bytes(env, f->p0, f->p1);
  argv[1] = js_new_bytes(env, f->p2, f->p3);
  argv[2] = js_new_bytes(env, f->p4, f->p5);
  argv[3] = js_new_i32(env, (int32_t)f->p6);
  napi_value result;
  if (!js_cb_call(env, cb, "on_batch", 4, argv, &result)) {
    js_cb_report(env, f->out_err, "BatchListener.onBatch failed");
  }
  napi_close_handle_scope(env, scope);
}

static void tramp_edge_cases_edge_cases_BatchListener_on_batch(void* ctx, const uint8_t* p0, size_t p1, const uint8_t* p2, size_t p3, const uint8_t* p4, size_t p5, edge_cases_edge_cases_Mode p6, edge_cases_error* out_err) {
