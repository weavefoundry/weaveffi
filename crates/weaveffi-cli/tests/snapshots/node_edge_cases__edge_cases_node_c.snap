static void dispatch_edge_cases_edge_cases_BatchListener(napi_env env, napi_value fn, void* context, void* data) {
  (void)fn;
  (void)context;
  js_cb_req* req = (js_cb_req*)data;
  if (req->method < 0) {
    js_cb_release(env, req->cb);
    free(req);
    return;
  }
  if (!js_cb_take(req)) return;
  if (env == NULL) {
    edge_cases_error_set(req->out_err, -4, "the JavaScript environment is shutting down");
  } else {
    switch (req->method) {
      case 0: invoke_edge_cases_edge_cases_BatchListener_on_batch(env, req->cb, (frame_edge_cases_edge_cases_BatchListener_on_batch*)req->frame); break;
      case 1: invoke_edge_cases_edge_cases_BatchListener_on_widget(env, req->cb, (frame_edge_cases_edge_cases_BatchListener_on_widget*)req->frame); break;
      case 2: invoke_edge_cases_edge_cases_BatchListener_on_tick(env, req->cb, (frame_edge_cases_edge_cases_BatchListener_on_tick*)req->frame); break;
      case 3: invoke_edge_cases_edge_cases_BatchListener_should_continue(env, req->cb, (frame_edge_cases_edge_cases_BatchListener_should_continue*)req->frame); break;
      case 4: invoke_edge_cases_edge_cases_BatchListener_pick_mode(env, req->cb, (frame_edge_cases_edge_cases_BatchListener_pick_mode*)req->frame); break;
      default: break;
    }
  }
  js_cb_finish(req);
}

