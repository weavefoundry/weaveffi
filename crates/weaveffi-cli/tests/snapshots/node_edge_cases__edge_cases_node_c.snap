  memset(&f, 0, sizeof f);
  f.out_err = out_err;
  f.p0 = p0;
  f.p1 = p1;
  f.p2 = p2;
  f.p3 = p3;
  f.p4 = p4;
  f.p5 = p5;
  f.p6 = p6;
  js_cb* cb = (js_cb*)ctx;
  if (js_cb_on_js_thread(cb)) {
    invoke_edge_cases_edge_cases_BatchListener_on_batch(cb->env, cb, &f);
  } else {
    js_cb_hop(cb, 0, &f, out_err, "BatchListener.onBatch");
  }
}

