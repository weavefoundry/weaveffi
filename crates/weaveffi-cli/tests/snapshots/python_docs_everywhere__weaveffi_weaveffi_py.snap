_cb_next_ctx = 0


def _cb_register(impl) -> int:
    global _cb_next_ctx
    with _cb_lock:
        _cb_next_ctx += 1
        _ctx = _cb_next_ctx
        _cb_impls[_ctx] = impl
    return _ctx


