        if _p == 0:
            raise WeaveFFIError(-1, "malformed value buffer: null object token")
        return _p

    def expect_end(self) -> None:
        if self._pos != len(self._data):
            raise WeaveFFIError(-1, "malformed value buffer: trailing bytes")


