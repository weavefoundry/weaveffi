    return _decode_buffer(data, _read_Document)


class SavedListener(abc.ABC):
    """
    Consumer-implemented observer of document-saved notifications.

    Implementations must be safe to call from any thread.

    Consumer-implemented callback interface. Subclass it, implement every abstract method, and pass an instance wherever the API takes a `SavedListener`; the producer may call the methods from any thread until it releases the instance. An exception raised by a method is reported to the producer as WeaveFFIError.FOREIGN_ERROR_CODE (-4) and aborts the call that was in progress.
    """

