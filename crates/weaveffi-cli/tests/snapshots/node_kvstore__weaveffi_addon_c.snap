    { "Store_destroy", NULL, Napi_weaveffi_kv_Store_destroy, NULL, NULL, NULL, napi_default, NULL },
    { "registerEvictionListener", NULL, Napi_weaveffi_kv_register_eviction_listener, NULL, NULL, NULL, napi_default, NULL },
    { "unregisterEvictionListener", NULL, Napi_weaveffi_kv_unregister_eviction_listener, NULL, NULL, NULL, napi_default, NULL },
    { "getStats", NULL, Napi_weaveffi_kv_stats_get_stats, NULL, NULL, NULL, napi_default, NULL },
  };
  napi_define_properties(env, exports, 16, props);
  return exports;
}

NAPI_MODULE(NODE_GYP_MODULE_NAME, Init)

