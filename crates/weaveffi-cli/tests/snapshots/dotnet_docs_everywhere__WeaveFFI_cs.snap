    public static class Docs
    {
        /// <summary>
        /// Create a brand new document.
        /// 
        /// The document starts in `Draft` status; callers must publish
        /// it explicitly to make it visible.
        /// </summary>
        /// <param name="title">Human-readable title for the new document</param>
        /// <param name="tags">Initial set of tags (may be empty)</param>
        public static Document CreateDocument(string title, string[] tags)
        {
            var err = new WeaveFFIError();
            var titlePtr = Marshal.StringToCoTaskMemUTF8(title);
            var tagsWriter = new WeaveFFIBufferWriter();
            tagsWriter.WriteLen(tags.Length);
            foreach (var item0 in tags)
            {
                tagsWriter.WriteString(item0);
            }
            var tagsBuf = tagsWriter.ToArray();
            var tagsPin = GCHandle.Alloc(tagsBuf, GCHandleType.Pinned);
            try
            {
                var result = NativeMethods.weaveffi_docs_create_document(titlePtr, tagsPin.AddrOfPinnedObject(), (UIntPtr)tagsBuf.Length, out var outLen, ref err);
                WeaveFFIError.Check(err);
                var resultBuf = new byte[(int)outLen];
                if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
                NativeMethods.weaveffi_free_bytes(result, outLen);
                var decodedReader = new WeaveFFIBufferReader(resultBuf);
                var decoded = Document.ReadFrom(decodedReader);
                decodedReader.ExpectEnd();
                return decoded;
            }
            finally
            {
                Marshal.FreeCoTaskMem(titlePtr);
                tagsPin.Free();
            }
        }

        /// <summary>Look up a document by identifier</summary>
        /// <param name="id">Identifier returned from create_document</param>
        public static Document? GetDocument(long id)
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_docs_get_document(id, out var outLen, ref err);
            WeaveFFIError.Check(err);
            var resultBuf = new byte[(int)outLen];
            if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
            NativeMethods.weaveffi_free_bytes(result, outLen);
            var decodedReader = new WeaveFFIBufferReader(resultBuf);
            Document? decoded = null;
            if (decodedReader.ReadOptionFlag())
            {
                var decodedValue = Document.ReadFrom(decodedReader);
                decoded = decodedValue;
            }
            decodedReader.ExpectEnd();
            return decoded;
        }

        /// <summary>Publish a document in the background</summary>
        /// <param name="id">Identifier of the document to publish</param>
        public static async Task<bool> PublishAsync(long id)
        {
            var tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
            NativeMethods.AsyncCb_weaveffi_docs_publish_async callback = (context, err, result) =>
            {
                try
                {
                    if (err != IntPtr.Zero)
                    {
                        var wErr = Marshal.PtrToStructure<WeaveFFIError>(err);
                        if (wErr.Code != 0)
                        {
                            var msg = Marshal.PtrToStringUTF8(wErr.Message) ?? "";
                            NativeMethods.weaveffi_error_free(err);
                            tcs.SetException(new WeaveFFIException(wErr.Code, msg));
                            return;
                        }
                    }
                    tcs.SetResult(result != 0);
                }
                finally
                {
                    if (context != IntPtr.Zero)
                    {
                        GCHandle.FromIntPtr(context).Free();
                    }
                }
            };
            var gcHandle = GCHandle.Alloc(callback, GCHandleType.Normal);
            var ctx = GCHandle.ToIntPtr(gcHandle);
            try
            {
                NativeMethods.weaveffi_docs_publish_async_async(id, callback, ctx);
            }
            catch
            {
                if (gcHandle.IsAllocated) gcHandle.Free();
                throw;
            }
            return await tcs.Task;
        }

        /// <summary>Register a listener for saved notifications</summary>
        /// <param name="listener">Receiver of saved notifications</param>
        public static void Watch(ISavedListener listener)
        {
            var err = new WeaveFFIError();
            var listenerCtx = GCHandle.ToIntPtr(GCHandle.Alloc(listener));
            NativeMethods.weaveffi_docs_watch(listenerCtx, WeaveFFIVtable_docs_SavedListener.Pointer, ref err);
            WeaveFFIError.Check(err);
        }

    }

