    /// <summary>Raised for any WeaveFFI failure that isn't a typed domain
    /// error: producer bugs, panics, marshalling failures, and exceptions
    /// thrown by a callback-interface implementation.</summary>
    public class WeaveFFIException : Exception
    {
        /// <summary>An untyped producer error.</summary>
        public const int GenericErrorCode = -1;
        /// <summary>The producer panicked; the message carries the panic text.</summary>
        public const int PanicErrorCode = -2;
        /// <summary>An argument couldn't be lifted by the producer.</summary>
        public const int MarshalErrorCode = -3;
        /// <summary>A callback-interface implementation threw; the message
        /// carries the original exception's message.</summary>
        public const int ForeignErrorCode = -4;

        public int Code { get; }

        public WeaveFFIException(int code, string message) : base(message)
        {
            Code = code;
        }
    }

    /// <summary>Typed exception for the DocsErrorsError error domain (module docs).</summary>
    public class DocsErrorsException : WeaveFFIException
    {
        /// <summary>Returned when no document matches the requested id</summary>
        public const int NotFound = 1;
        /// <summary>Raised when attempting to move into a forbidden state</summary>
        public const int InvalidStatus = 2;

        public DocsErrorsException(int code, string message) : base(code, message)
        {
        }

        /// <summary>Wraps a raw error slot in the typed exception, falling
        /// back to <see cref="WeaveFFIException"/> for unknown codes. Codes
        /// declaring payload fields decode them into Data.</summary>
        internal static WeaveFFIException FromCode(int code, string message, byte[]? payload)
        {
            switch (code)
            {
                case NotFound:
                    return new DocsErrorsException(code, string.IsNullOrEmpty(message) ? "Document not found" : message);
                case InvalidStatus:
                    return new DocsErrorsException(code, string.IsNullOrEmpty(message) ? "Invalid status transition" : message);
                default:
                    return new WeaveFFIException(code, message);
            }
        }
    }

    [StructLayout(LayoutKind.Sequential)]
    internal struct WeaveFFIError
    {
        public int Code;
        public IntPtr Message;
        public IntPtr PayloadPtr;
        public UIntPtr PayloadLen;

        internal static byte[]? CopyPayload(WeaveFFIError err)
        {
            if (err.PayloadPtr == IntPtr.Zero || (int)err.PayloadLen == 0)
            {
                return null;
            }
            var payload = new byte[(int)err.PayloadLen];
            Marshal.Copy(err.PayloadPtr, payload, 0, (int)err.PayloadLen);
            return payload;
        }

        internal static void Check(WeaveFFIError err)
        {
            if (err.Code != 0)
            {
                var code = err.Code;
                var msg = Marshal.PtrToStringUTF8(err.Message) ?? "";
                NativeMethods.weaveffi_error_clear(ref err);
                throw new WeaveFFIException(code, msg);
            }
        }

        internal static void CheckDocsErrors(WeaveFFIError err)
        {
            if (err.Code != 0)
            {
                var code = err.Code;
                var msg = Marshal.PtrToStringUTF8(err.Message) ?? "";
                var payload = CopyPayload(err);
                NativeMethods.weaveffi_error_clear(ref err);
                throw DocsErrorsException.FromCode(code, msg, payload);
            }
        }
    }

    /// <summary>One strong reference to a native object, on its way into
    /// a wrapper that adopts it. A distinct type (rather than a bare
    /// <c>IntPtr</c>) so the adopting constructor never competes with a
    /// public constructor taking an integer.</summary>
    internal readonly struct WeaveFFIHandle
    {
        internal readonly IntPtr Value;

        internal WeaveFFIHandle(IntPtr value)
        {
            Value = value;
        }
    }

    internal static class WeaveFFIHelpers
    {
        internal static IntPtr StringToPtr(string? s)
        {
            return s == null ? IntPtr.Zero : Marshal.StringToCoTaskMemUTF8(s);
        }

        internal static string? PtrToString(IntPtr ptr)
        {
            return ptr == IntPtr.Zero ? null : Marshal.PtrToStringUTF8(ptr);
        }

        internal static void FreePtr(IntPtr ptr)
        {
            Marshal.FreeCoTaskMem(ptr);
        }
    }

    /// <summary>Serializes values into the WeaveFFI value-buffer wire
    /// format (little-endian, packed).</summary>
    internal sealed class WeaveFFIBufferWriter
    {
        private byte[] _buf = new byte[64];
        private int _len;

        private void Ensure(int extra)
        {
            if (_len + extra <= _buf.Length)
            {
                return;
            }
            var size = _buf.Length * 2;
            while (size < _len + extra)
            {
                size *= 2;
            }
            Array.Resize(ref _buf, size);
        }

        internal void WriteBool(bool v)
        {
            Ensure(1);
            _buf[_len++] = v ? (byte)1 : (byte)0;
        }

        internal void WriteI8(sbyte v)
        {
            Ensure(1);
            _buf[_len++] = (byte)v;
        }

        internal void WriteU8(byte v)
        {
            Ensure(1);
            _buf[_len++] = v;
        }

        internal void WriteU16(ushort v)
        {
            Ensure(2);
            _buf[_len++] = (byte)v;
            _buf[_len++] = (byte)(v >> 8);
        }

        internal void WriteI16(short v)
        {
            WriteU16((ushort)v);
        }

        internal void WriteU32(uint v)
        {
            Ensure(4);
            _buf[_len++] = (byte)v;
            _buf[_len++] = (byte)(v >> 8);
            _buf[_len++] = (byte)(v >> 16);
            _buf[_len++] = (byte)(v >> 24);
        }

        internal void WriteI32(int v)
        {
            WriteU32((uint)v);
        }

        internal void WriteU64(ulong v)
        {
            WriteU32((uint)v);
            WriteU32((uint)(v >> 32));
        }

        internal void WriteI64(long v)
        {
            WriteU64((ulong)v);
        }

        internal void WriteF32(float v)
        {
            WriteU32((uint)BitConverter.SingleToInt32Bits(v));
        }

        internal void WriteF64(double v)
        {
            WriteU64((ulong)BitConverter.DoubleToInt64Bits(v));
        }

        internal void WriteLen(int len)
        {
            WriteU32((uint)len);
        }

        internal void WriteOptionFlag(bool present)
        {
            WriteBool(present);
        }

        internal void WriteString(string v)
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(v);
            WriteLen(bytes.Length);
            Ensure(bytes.Length);
            Array.Copy(bytes, 0, _buf, _len, bytes.Length);
            _len += bytes.Length;
        }

        internal void WriteBytes(byte[] v)
        {
            WriteLen(v.Length);
            Ensure(v.Length);
            Array.Copy(v, 0, _buf, _len, v.Length);
            _len += v.Length;
        }

        internal void WriteObject(IntPtr token)
        {
            WriteU64((ulong)(nuint)(nint)token);
        }

        internal byte[] ToArray()
        {
            var outBuf = new byte[_len];
            Array.Copy(_buf, outBuf, _len);
            return outBuf;
        }
    }

    /// <summary>Decodes values from the WeaveFFI value-buffer wire format.
    /// A malformed buffer indicates a producer/consumer contract violation and
    /// throws <see cref="InvalidOperationException"/>.</summary>
    internal sealed class WeaveFFIBufferReader
    {
        private static readonly System.Text.Encoding Utf8Strict =
            new System.Text.UTF8Encoding(false, true);

        private readonly byte[] _data;
        private int _pos;

        internal WeaveFFIBufferReader(byte[] data)
        {
            _data = data;
        }

        private void Require(int n)
        {
            if (_data.Length - _pos < n)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: buffer exhausted");
            }
        }

        internal bool ReadBool()
        {
            Require(1);
            var b = _data[_pos++];
            if (b > 1)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: invalid bool byte");
            }
            return b == 1;
        }

        internal sbyte ReadI8()
        {
            Require(1);
            return (sbyte)_data[_pos++];
        }

        internal byte ReadU8()
        {
            Require(1);
            return _data[_pos++];
        }

        internal ushort ReadU16()
        {
            Require(2);
            var v = (ushort)(_data[_pos] | (_data[_pos + 1] << 8));
            _pos += 2;
            return v;
        }

        internal short ReadI16()
        {
            return (short)ReadU16();
        }

        internal uint ReadU32()
        {
            Require(4);
            var v = (uint)_data[_pos]
                | ((uint)_data[_pos + 1] << 8)
                | ((uint)_data[_pos + 2] << 16)
                | ((uint)_data[_pos + 3] << 24);
            _pos += 4;
            return v;
        }

        internal int ReadI32()
        {
            return (int)ReadU32();
        }

        internal ulong ReadU64()
        {
            var lo = (ulong)ReadU32();
            var hi = (ulong)ReadU32();
            return lo | (hi << 32);
        }

        internal long ReadI64()
        {
            return (long)ReadU64();
        }

        internal float ReadF32()
        {
            return BitConverter.Int32BitsToSingle(ReadI32());
        }

        internal double ReadF64()
        {
            return BitConverter.Int64BitsToDouble(ReadI64());
        }

        internal int ReadLen()
        {
            var len = ReadU32();
            if (len > (uint)(_data.Length - _pos))
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: length prefix exceeds remaining bytes");
            }
            return (int)len;
        }

        internal bool ReadOptionFlag()
        {
            return ReadBool();
        }

        internal string ReadString()
        {
            var len = ReadLen();
            string s;
            try
            {
                s = Utf8Strict.GetString(_data, _pos, len);
            }
            catch (ArgumentException)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: string is not valid UTF-8");
            }
            _pos += len;
            return s;
        }

        internal byte[] ReadBytes()
        {
            var len = ReadLen();
            var outBuf = new byte[len];
            Array.Copy(_data, _pos, outBuf, 0, len);
            _pos += len;
            return outBuf;
        }

        internal IntPtr ReadObject()
        {
            var token = ReadU64();
            if (token == 0)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: null object token");
            }
            return (nint)(nuint)token;
        }

        internal void ExpectEnd()
        {
            if (_pos != _data.Length)
            {
                throw new InvalidOperationException("malformed WeaveFFI value buffer: trailing bytes");
            }
        }
    }

    /// <summary>
    /// Lifecycle status of a document.
    /// 
    /// Used to drive UI badges and filters.
    /// </summary>
    public enum Status
    {
        /// <summary>Document is being edited</summary>
        Draft = 0,
        /// <summary>Document is publicly visible</summary>
        Published = 1,
        /// <summary>Document is hidden from listings</summary>
        Archived = 2,
    }

    /// <summary>
    /// Represents a single document tracked by the system.
    /// 
    /// Documents are persisted to disk and exposed via the public API.
    /// </summary>
    public sealed class Document
    {
        /// <summary>Stable opaque identifier</summary>
        public long Id { get; }

        /// <summary>Human-readable title shown in lists</summary>
        public string Title { get; }

        /// <summary>Current lifecycle status</summary>
        public Status Status { get; }

        /// <summary>Free-form tags for grouping</summary>
        public string[] Tags { get; }

        public Document(long id, string title, Status status, string[] tags)
        {
            Id = id;
            Title = title;
            Status = status;
            Tags = tags;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI64(Id);
            writer.WriteString(Title);
            writer.WriteI32((int)Status);
            writer.WriteLen(Tags.Length);
            foreach (var item0 in Tags)
            {
                writer.WriteString(item0);
            }
        }

        internal static Document ReadFrom(WeaveFFIBufferReader reader)
        {
            var fId = reader.ReadI64();
            var fTitle = reader.ReadString();
            var fStatus = (Status)reader.ReadI32();
            var fTagsCount = reader.ReadLen();
            var fTags = new string[fTagsCount];
            for (int i0 = 0; i0 < fTagsCount; i0++)
            {
                var fTagsItem = reader.ReadString();
                fTags[i0] = fTagsItem;
            }
            return new Document(fId, fTitle, fStatus, fTags);
        }
    }

    /// <summary>
    /// Consumer-implemented observer of document-saved notifications.
    /// 
    /// Implementations must be safe to call from any thread.
    /// </summary>
    /// <remarks>Implement this interface and pass an instance wherever the
    /// native library expects it. The library may call any method from any
    /// thread until it releases its last reference to the instance. Object
    /// arguments are owned by the implementation, which should dispose them
    /// when done. An exception thrown by a method is reported to the native
    /// caller as <see cref="WeaveFFIException.ForeignErrorCode"/>.</remarks>
    public interface ISavedListener
    {
        /// <summary>Fires after a document has been persisted successfully</summary>
        /// <param name="docId">Identifier of the saved document</param>
        /// <param name="revision">Monotonically increasing revision</param>
        void OnSaved(long docId, int revision);
    }

    /// <summary>The process-wide <c>weaveffi_docs_SavedListener_vtable</c> vtable and the trampolines behind
    /// it, adapting an <see cref="ISavedListener"/> to the C ABI.</summary>
    internal static unsafe class WeaveFFIVtable_docs_SavedListener
    {
        [StructLayout(LayoutKind.Sequential)]
        private struct Layout
        {
            public IntPtr on_saved;
            public IntPtr free;
        }

        /// <summary>Address of the one static vtable for this interface. It is
        /// allocated once and never freed, so the producer may keep the pointer
        /// for the process lifetime.</summary>
        internal static readonly IntPtr Pointer = Allocate();

        private static IntPtr Allocate()
        {
            var layout = new Layout
            {
                on_saved = (IntPtr)(delegate* unmanaged[Cdecl]<IntPtr, long, int, IntPtr, void>)&OnSavedTrampoline,
                free = (IntPtr)(delegate* unmanaged[Cdecl]<IntPtr, void>)&FreeTrampoline,
            };
            var mem = Marshal.AllocHGlobal(Marshal.SizeOf<Layout>());
            Marshal.StructureToPtr(layout, mem, false);
            return mem;
        }

        private static ISavedListener Target(IntPtr ctx)
        {
            return (ISavedListener)GCHandle.FromIntPtr(ctx).Target!;
        }

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvCdecl) })]
        private static void OnSavedTrampoline(IntPtr ctx, long doc_id, int revision, IntPtr out_err)
        {
            try
            {
                var impl = Target(ctx);
                impl.OnSaved(doc_id, revision);
            }
            catch (Exception ex)
            {
                NativeMethods.weaveffi_error_set(out_err, WeaveFFIException.ForeignErrorCode, ex.Message);
            }
        }

        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvCdecl) })]
        private static void FreeTrampoline(IntPtr ctx)
        {
            GCHandle.FromIntPtr(ctx).Free();
        }
    }

    /// <summary>
    /// An ordered collection of documents.
    /// 
    /// Notebooks own their documents and release them when destroyed.
    /// </summary>
    public class Notebook : IDisposable
    {
        private IntPtr _handle;
        private int _released;

        /// <summary>Adopts one strong reference to a native object.</summary>
        internal Notebook(WeaveFFIHandle handle)
        {
            _handle = handle.Value;
        }

        /// <summary>The borrowed native pointer for the duration of a call.</summary>
        /// <exception cref="ObjectDisposedException">The wrapper was disposed.</exception>
        internal IntPtr Handle
        {
            get
            {
                var h = _handle;
                if (h == IntPtr.Zero)
                {
                    throw new ObjectDisposedException(nameof(Notebook));
                }
                return h;
            }
        }

        /// <summary>Mints a second strong reference the caller owns (for
        /// example to write this object into a value buffer).</summary>
        internal IntPtr CloneHandle()
        {
            return NativeMethods.weaveffi_docs_Notebook_clone(Handle);
        }

        /// <summary>Create an empty notebook</summary>
        public Notebook()
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_docs_Notebook_new(ref err);
            WeaveFFIError.Check(err);
            _handle = result;
        }

        /// <summary>Add a document, returning its position in the notebook</summary>
        /// <param name="document">The document to add</param>
        public int Insert(Document document)
        {
            var err = new WeaveFFIError();
            var documentWriter = new WeaveFFIBufferWriter();
            document.WriteTo(documentWriter);
            var documentBuf = documentWriter.ToArray();
            var documentPin = GCHandle.Alloc(documentBuf, GCHandleType.Pinned);
            try
            {
                var result = NativeMethods.weaveffi_docs_Notebook_insert(Handle, documentPin.AddrOfPinnedObject(), (UIntPtr)documentBuf.Length, ref err);
                WeaveFFIError.Check(err);
                return result;
            }
            finally
            {
                documentPin.Free();
            }
        }

        /// <summary>Look up a document by identifier, failing when none matches</summary>
        /// <param name="id">Identifier of the document to find</param>
        /// <exception cref="DocsErrorsException">Thrown when the call reports a DocsErrorsError code.</exception>
        public Document Find(long id)
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_docs_Notebook_find(Handle, id, out var outLen, ref err);
            WeaveFFIError.CheckDocsErrors(err);
            var resultBuf = new byte[(int)outLen];
            if (result != IntPtr.Zero && (int)outLen > 0) Marshal.Copy(result, resultBuf, 0, (int)outLen);
            NativeMethods.weaveffi_free_bytes(result, outLen);
            var decodedReader = new WeaveFFIBufferReader(resultBuf);
            var decoded = Document.ReadFrom(decodedReader);
            decodedReader.ExpectEnd();
            return decoded;
        }

        /// <summary>The number of documents currently held</summary>
        public int Size()
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_docs_Notebook_size(Handle, ref err);
            WeaveFFIError.Check(err);
            return result;
        }

        /// <summary>The largest number of documents one notebook will hold</summary>
        public static int MaxDocuments()
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_docs_Notebook_max_documents(ref err);
            WeaveFFIError.Check(err);
            return result;
        }

        /// <summary>Releases this wrapper's reference. The native object is
        /// dropped when the producer releases its last reference; other
        /// wrappers to the same object stay valid.</summary>
        public void Dispose()
        {
            Release();
            GC.SuppressFinalize(this);
        }

        ~Notebook()
        {
            Release();
        }

        private void Release()
        {
            if (System.Threading.Interlocked.Exchange(ref _released, 1) != 0)
            {
                return;
            }
            var h = _handle;
            _handle = IntPtr.Zero;
            if (h != IntPtr.Zero)
            {
                NativeMethods.weaveffi_docs_Notebook_destroy(h);
            }
        }
    }

    internal static class NativeMethods
    {
        private const string LibName = "weaveffi";

        // The ABI revision these bindings were generated against.
        internal const uint AbiVersion = 2;

        // Runs before the first P/Invoke through this class, so a producer built
        // for a different ABI revision fails loudly instead of misreading the
        // error struct or a value buffer later.
        static NativeMethods()
        {
            uint found;
            try
            {
                found = weaveffi_abi_version();
            }
            catch (EntryPointNotFoundException e)
            {
                throw new InvalidOperationException(
                    $"the loaded WeaveFFI library predates ABI versioning (these bindings expect ABI revision {AbiVersion})", e);
            }
            if (found != AbiVersion)
            {
                throw new InvalidOperationException(
                    $"WeaveFFI ABI mismatch: these bindings expect revision {AbiVersion} but the loaded library reports revision {found}");
            }
        }

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern uint weaveffi_abi_version();

        // Fills a producer-owned error slot with a copy of `message`; callback
        // trampolines report a thrown exception through it so no managed
        // allocation is ever handed to the producer's allocator.
        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_error_set(IntPtr err, int code, [MarshalAs(UnmanagedType.LPUTF8Str)] string message);

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_free_string(IntPtr ptr);

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_free_bytes(IntPtr ptr, UIntPtr len);

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_error_clear(ref WeaveFFIError err);

        [DllImport(LibName, CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_error_free(IntPtr err);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_Notebook_clone", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_docs_Notebook_clone(IntPtr self);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_Notebook_destroy", CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_docs_Notebook_destroy(IntPtr self);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_Notebook_new", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_docs_Notebook_new(ref WeaveFFIError out_err);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_Notebook_insert", CallingConvention = CallingConvention.Cdecl)]
        internal static extern int weaveffi_docs_Notebook_insert(IntPtr self, IntPtr document_ptr, UIntPtr document_len, ref WeaveFFIError out_err);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_Notebook_find", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_docs_Notebook_find(IntPtr self, long id, out UIntPtr out_len, ref WeaveFFIError out_err);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_Notebook_size", CallingConvention = CallingConvention.Cdecl)]
        internal static extern int weaveffi_docs_Notebook_size(IntPtr self, ref WeaveFFIError out_err);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_Notebook_max_documents", CallingConvention = CallingConvention.Cdecl)]
        internal static extern int weaveffi_docs_Notebook_max_documents(ref WeaveFFIError out_err);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_create_document", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_docs_create_document(IntPtr title, IntPtr tags_ptr, UIntPtr tags_len, out UIntPtr out_len, ref WeaveFFIError out_err);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_get_document", CallingConvention = CallingConvention.Cdecl)]
        internal static extern IntPtr weaveffi_docs_get_document(long id, out UIntPtr out_len, ref WeaveFFIError out_err);

        [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
        internal delegate void AsyncCb_weaveffi_docs_publish_async(IntPtr context, IntPtr err, byte result);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_publish_async_async", CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_docs_publish_async_async(long id, AsyncCb_weaveffi_docs_publish_async callback, IntPtr context);

        [DllImport(LibName, EntryPoint = "weaveffi_docs_watch", CallingConvention = CallingConvention.Cdecl)]
        internal static extern void weaveffi_docs_watch(IntPtr listener_ctx, IntPtr listener_vtable, ref WeaveFFIError out_err);

