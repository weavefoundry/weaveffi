// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

package weaveffi

/*
#cgo LDFLAGS: -lweaveffi
#include "weaveffi.h"
#include <stdlib.h>
extern void goWv_weaveffi_docs_OnSaved_fn(int64_t doc_id, int32_t revision, void* context);
extern void goWv_weaveffi_docs_publish_async_callback(void* context, weaveffi_error* err, bool result);
*/
import "C"

import (
	"encoding/binary"
	"fmt"
	"math"
	"sync"
	"unicode/utf8"
	"unsafe"
)

// The ABI revision these bindings were generated against.
const wvABIVersion uint32 = 1

func init() {
	if found := uint32(C.weaveffi_abi_version()); found != wvABIVersion {
		panic(fmt.Sprintf("WeaveFFI ABI mismatch: these bindings expect revision %d but the loaded library reports revision %d", wvABIVersion, found))
	}
}

func boolToC(b bool) C._Bool {
	return C._Bool(b)
}

func cToBool(b C._Bool) bool {
	return bool(b)
}

// WeaveFFIError reports a failure crossing the C boundary that no typed
// error domain claims: an unknown code, a marshalling failure, or a
// producer panic.
type WeaveFFIError struct {
	// Code is the numeric ABI error code.
	Code int32
	// Message is the human-readable error message.
	Message string
}

func (e *WeaveFFIError) Error() string {
	return fmt.Sprintf("weaveffi: %s (code %d)", e.Message, e.Code)
}

// wvTakeError reads and clears a non-zero C error slot, returning its
// code, message, and a copy of its structured payload buffer (nil when
// the code declares no payload fields).
func wvTakeError(cErr *C.weaveffi_error) (int32, string, []byte) {
	code := int32(cErr.code)
	msg := ""
	if cErr.message != nil {
		msg = C.GoString(cErr.message)
	}
	var payload []byte
	if cErr.payload_ptr != nil {
		payload = C.GoBytes(unsafe.Pointer(cErr.payload_ptr), C.int(cErr.payload_len))
	}
	C.weaveffi_error_clear(cErr)
	return code, msg, payload
}

// wvTakeBoxedError reads a heap-boxed error delivered to an async
// completion callback and releases the box with weaveffi_error_free.
func wvTakeBoxedError(cErr *C.weaveffi_error) (int32, string, []byte) {
	code := int32(cErr.code)
	msg := ""
	if cErr.message != nil {
		msg = C.GoString(cErr.message)
	}
	var payload []byte
	if cErr.payload_ptr != nil {
		payload = C.GoBytes(unsafe.Pointer(cErr.payload_ptr), C.int(cErr.payload_len))
	}
	C.weaveffi_error_free(cErr)
	return code, msg, payload
}

func wvBrandError(code int32, message string, _ []byte) error {
	return &WeaveFFIError{Code: code, Message: message}
}

// wvTrap panics when the C error slot reports a failure. Non-throwing
// wrappers check their slot with it: a non-zero code there can only be
// a producer panic or a marshalling failure.
func wvTrap(cErr *C.weaveffi_error) {
	if cErr.code != 0 {
		code, msg, _ := wvTakeError(cErr)
		panic(fmt.Sprintf("weaveffi: %s (code %d)", msg, code))
	}
}

// wvWriter serializes values into the WeaveFFI value-buffer format:
// little-endian, packed, u32 length prefixes.
type wvWriter struct {
	buf []byte
}

func (w *wvWriter) writeBool(v bool) {
	if v {
		w.buf = append(w.buf, 1)
	} else {
		w.buf = append(w.buf, 0)
	}
}

func (w *wvWriter) writeI8(v int8) {
	w.buf = append(w.buf, byte(v))
}

func (w *wvWriter) writeU8(v uint8) {
	w.buf = append(w.buf, v)
}

func (w *wvWriter) writeI16(v int16) {
	w.buf = binary.LittleEndian.AppendUint16(w.buf, uint16(v))
}

func (w *wvWriter) writeU16(v uint16) {
	w.buf = binary.LittleEndian.AppendUint16(w.buf, v)
}

func (w *wvWriter) writeI32(v int32) {
	w.buf = binary.LittleEndian.AppendUint32(w.buf, uint32(v))
}

func (w *wvWriter) writeU32(v uint32) {
	w.buf = binary.LittleEndian.AppendUint32(w.buf, v)
}

func (w *wvWriter) writeI64(v int64) {
	w.buf = binary.LittleEndian.AppendUint64(w.buf, uint64(v))
}

func (w *wvWriter) writeU64(v uint64) {
	w.buf = binary.LittleEndian.AppendUint64(w.buf, v)
}

func (w *wvWriter) writeF32(v float32) {
	w.writeU32(math.Float32bits(v))
}

func (w *wvWriter) writeF64(v float64) {
	w.writeU64(math.Float64bits(v))
}

func (w *wvWriter) writeLen(n int) {
	if n < 0 || uint64(n) > uint64(^uint32(0)) {
		panic("weaveffi: value-buffer length exceeds u32 range")
	}
	w.writeU32(uint32(n))
}

func (w *wvWriter) writeString(v string) {
	w.writeLen(len(v))
	w.buf = append(w.buf, v...)
}

func (w *wvWriter) writeBytes(v []byte) {
	w.writeLen(len(v))
	w.buf = append(w.buf, v...)
}

func (w *wvWriter) writeOptionFlag(present bool) {
	w.writeBool(present)
}

// wvReader decodes values from the WeaveFFI value-buffer format. A
// malformed buffer is a producer/consumer contract violation, so every
// read panics (the same channel a trapped producer error uses) instead
// of returning a typed domain error.
type wvReader struct {
	buf []byte
	pos int
}

func wvMalformed(context string) {
	panic("weaveffi: malformed value buffer: " + context)
}

func (r *wvReader) take(n int, context string) []byte {
	if n < 0 || len(r.buf)-r.pos < n {
		wvMalformed(context)
	}
	b := r.buf[r.pos : r.pos+n]
	r.pos += n
	return b
}

func (r *wvReader) readBool() bool {
	switch r.take(1, "bool")[0] {
	case 0:
		return false
	case 1:
		return true
	}
	wvMalformed("bool byte out of range")
	return false
}

func (r *wvReader) readI8() int8 {
	return int8(r.take(1, "i8")[0])
}

func (r *wvReader) readU8() uint8 {
	return r.take(1, "u8")[0]
}

func (r *wvReader) readI16() int16 {
	return int16(binary.LittleEndian.Uint16(r.take(2, "i16")))
}

func (r *wvReader) readU16() uint16 {
	return binary.LittleEndian.Uint16(r.take(2, "u16"))
}

func (r *wvReader) readI32() int32 {
	return int32(binary.LittleEndian.Uint32(r.take(4, "i32")))
}

func (r *wvReader) readU32() uint32 {
	return binary.LittleEndian.Uint32(r.take(4, "u32"))
}

func (r *wvReader) readI64() int64 {
	return int64(binary.LittleEndian.Uint64(r.take(8, "i64")))
}

func (r *wvReader) readU64() uint64 {
	return binary.LittleEndian.Uint64(r.take(8, "u64"))
}

func (r *wvReader) readF32() float32 {
	return math.Float32frombits(r.readU32())
}

func (r *wvReader) readF64() float64 {
	return math.Float64frombits(r.readU64())
}

func (r *wvReader) readLen() int {
	n := int(r.readU32())
	if n > len(r.buf)-r.pos {
		wvMalformed("length prefix exceeds remaining buffer")
	}
	return n
}

func (r *wvReader) readString() string {
	b := r.take(r.readLen(), "string bytes")
	if !utf8.Valid(b) {
		wvMalformed("string is not valid UTF-8")
	}
	return string(b)
}

func (r *wvReader) readBytes() []byte {
	b := r.take(r.readLen(), "byte buffer")
	out := make([]byte, len(b))
	copy(out, b)
	return out
}

func (r *wvReader) readOptionFlag() bool {
	switch r.take(1, "option flag")[0] {
	case 0:
		return false
	case 1:
		return true
	}
	wvMalformed("option flag byte out of range")
	return false
}

func (r *wvReader) expectEnd() {
	if r.pos != len(r.buf) {
		wvMalformed("trailing bytes after value")
	}
}

// wvCopyBuffer copies an owned, producer-allocated value buffer into Go
// memory and releases it with weaveffi_free_bytes.
func wvCopyBuffer(ptr *C.uint8_t, length C.size_t) []byte {
	if ptr == nil {
		return nil
	}
	out := C.GoBytes(unsafe.Pointer(ptr), C.int(length))
	C.weaveffi_free_bytes(ptr, length)
	return out
}

// wvBorrowBuffer copies a borrowed value buffer into Go memory. The
// producer keeps ownership and frees it after the borrowing call returns.
func wvBorrowBuffer(ptr *C.uint8_t, length C.size_t) []byte {
	if ptr == nil {
		return nil
	}
	return C.GoBytes(unsafe.Pointer(ptr), C.int(length))
}

var (
	wvCallbackMu  sync.Mutex
	wvCallbackSeq uint64
	wvCallbacks   = map[uint64]interface{}{}
	// Subscription id -> registry id, so unregister can release the Go callback.
	wvListenerCtx = map[uint64]uint64{}
)

func wvCallbackStore(v interface{}) uint64 {
	wvCallbackMu.Lock()
	defer wvCallbackMu.Unlock()
	wvCallbackSeq++
	wvCallbacks[wvCallbackSeq] = v
	return wvCallbackSeq
}

func wvCallbackLoad(id uint64) interface{} {
	wvCallbackMu.Lock()
	defer wvCallbackMu.Unlock()
	return wvCallbacks[id]
}

func wvCallbackTake(id uint64) interface{} {
	wvCallbackMu.Lock()
	defer wvCallbackMu.Unlock()
	v := wvCallbacks[id]
	delete(wvCallbacks, id)
	return v
}

func wvCallbackDelete(id uint64) {
	wvCallbackMu.Lock()
	defer wvCallbackMu.Unlock()
	delete(wvCallbacks, id)
}

// DocsErrorsError is a typed error reported by the `docs` module.
type DocsErrorsError struct {
	// Code is the numeric ABI error code (one of the DocsErrorsError constants).
	Code int32
	// Message is the human-readable error message.
	Message string
}

func (e *DocsErrorsError) Error() string {
	return fmt.Sprintf("docs: %s (code %d)", e.Message, e.Code)
}

// DocsErrorsError codes.
const (
	// DocsErrorsErrorNotFound: Returned when no document matches the requested id
	DocsErrorsErrorNotFound int32 = 1
	// DocsErrorsErrorInvalidStatus: Raised when attempting to move into a forbidden state
	DocsErrorsErrorInvalidStatus int32 = 2
)

// wvMapDocs converts a non-zero code from the `docs` domain into a
// *DocsErrorsError, falling back to the generic *WeaveFFIError for unknown codes.
func wvMapDocs(code int32, message string, payload []byte) error {
	switch code {
	case DocsErrorsErrorNotFound:
		if message == "" {
			message = "Document not found"
		}
		return &DocsErrorsError{Code: code, Message: message}
	case DocsErrorsErrorInvalidStatus:
		if message == "" {
			message = "Invalid status transition"
		}
		return &DocsErrorsError{Code: code, Message: message}
	default:
		return wvBrandError(code, message, payload)
	}
}

// Status: Lifecycle status of a document.
//
// Used to drive UI badges and filters.
type Status int32

const (
	// StatusDraft: Document is being edited
	StatusDraft Status = 0
	// StatusPublished: Document is publicly visible
	StatusPublished Status = 1
	// StatusArchived: Document is hidden from listings
	StatusArchived Status = 2
)

// Document: Represents a single document tracked by the system.
//
// Documents are persisted to disk and exposed via the public API.
type Document struct {
	// Id: Stable opaque identifier
	Id int64
	// Title: Human-readable title shown in lists
	Title string
	// Status: Current lifecycle status
	Status Status
	// Tags: Free-form tags for grouping
	Tags []string
}

// wvPackDocument appends v to w in the value-buffer wire format.
func wvPackDocument(w *wvWriter, v Document) {
	w.writeI64(v.Id)
	w.writeString(v.Title)
	w.writeI32(int32(v.Status))
	w.writeLen(len(v.Tags))
	for _, eTags0 := range v.Tags {
		w.writeString(eTags0)
	}
}

// wvUnpackDocument decodes one Document from r.
func wvUnpackDocument(r *wvReader) Document {
	var v Document
	v.Id = r.readI64()
	v.Title = r.readString()
	v.Status = Status(r.readI32())
	nTags0 := r.readLen()
	v.Tags = make([]string, nTags0)
	for iTags0 := range v.Tags {
		v.Tags[iTags0] = r.readString()
	}
	return v
}

// Notebook: An ordered collection of documents.
//
// Notebooks own their documents and release them when destroyed.
type Notebook struct {
	ptr *C.weaveffi_docs_Notebook
}

// NewNotebook: Create an empty notebook
func NewNotebook() *Notebook {
	var cErr C.weaveffi_error
	result := C.weaveffi_docs_Notebook_new(&cErr)
	wvTrap(&cErr)
	return &Notebook{ptr: result}
}

// Insert: Add a document, returning its position in the notebook
//
// Parameters:
//   - document: The document to add
func (s *Notebook) Insert(document Document) int32 {
	wDocument := &wvWriter{}
	wvPackDocument(wDocument, document)
	var cDocumentPtr *C.uint8_t
	if len(wDocument.buf) > 0 {
		cDocumentPtr = (*C.uint8_t)(unsafe.Pointer(&wDocument.buf[0]))
	}
	var cErr C.weaveffi_error
	result := C.weaveffi_docs_Notebook_insert(s.ptr, cDocumentPtr, C.size_t(len(wDocument.buf)), &cErr)
	wvTrap(&cErr)
	return int32(result)
}

// Find: Look up a document by identifier, failing when none matches
//
// Parameters:
//   - id: Identifier of the document to find
func (s *Notebook) Find(id int64) (Document, error) {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_docs_Notebook_find(s.ptr, C.int64_t(id), &cOutLen, &cErr)
	if cErr.code != 0 {
		return Document{}, wvMapDocs(wvTakeError(&cErr))
	}
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult Document
	goResult = wvUnpackDocument(rRes)
	rRes.expectEnd()
	return goResult, nil
}

// Size: The number of documents currently held
func (s *Notebook) Size() int32 {
	var cErr C.weaveffi_error
	result := C.weaveffi_docs_Notebook_size(s.ptr, &cErr)
	wvTrap(&cErr)
	return int32(result)
}

// NotebookMaxDocuments: The largest number of documents one notebook will hold
func NotebookMaxDocuments() int32 {
	var cErr C.weaveffi_error
	result := C.weaveffi_docs_Notebook_max_documents(&cErr)
	wvTrap(&cErr)
	return int32(result)
}

func (s *Notebook) Close() {
	if s.ptr != nil {
		C.weaveffi_docs_Notebook_destroy(s.ptr)
		s.ptr = nil
	}
}

//export goWv_weaveffi_docs_OnSaved_fn
func goWv_weaveffi_docs_OnSaved_fn(doc_id C.int64_t, revision C.int32_t, context unsafe.Pointer) {
	v := wvCallbackLoad(uint64(uintptr(context)))
	if v == nil {
		return
	}
	cb := v.(func(docId int64, revision int32))
	arg0 := int64(doc_id)
	arg1 := int32(revision)
	cb(arg0, arg1)
}

// RegisterSavedListener: Subscribe to document-saved notifications
// Returns a subscription id for UnregisterSavedListener.
func RegisterSavedListener(callback func(docId int64, revision int32)) uint64 {
	ctxID := wvCallbackStore(callback)
	id := uint64(C.weaveffi_docs_register_saved_listener(C.weaveffi_docs_OnSaved_fn(unsafe.Pointer(C.goWv_weaveffi_docs_OnSaved_fn)), unsafe.Pointer(uintptr(ctxID))))
	wvCallbackMu.Lock()
	wvListenerCtx[id] = ctxID
	wvCallbackMu.Unlock()
	return id
}

// UnregisterSavedListener unregisters a listener previously registered with RegisterSavedListener.
func UnregisterSavedListener(id uint64) {
	C.weaveffi_docs_unregister_saved_listener(C.uint64_t(id))
	wvCallbackMu.Lock()
	ctxID, ok := wvListenerCtx[id]
	delete(wvListenerCtx, id)
	wvCallbackMu.Unlock()
	if ok {
		wvCallbackDelete(ctxID)
	}
}

// CreateDocument: Create a brand new document.
//
// The document starts in `Draft` status; callers must publish
// it explicitly to make it visible.
//
// Parameters:
//   - title: Human-readable title for the new document
//   - tags: Initial set of tags (may be empty)
func CreateDocument(title string, tags []string) Document {
	cTitle := C.CString(title)
	defer C.free(unsafe.Pointer(cTitle))
	wTags := &wvWriter{}
	wTags.writeLen(len(tags))
	for _, eTags0 := range tags {
		wTags.writeString(eTags0)
	}
	var cTagsPtr *C.uint8_t
	if len(wTags.buf) > 0 {
		cTagsPtr = (*C.uint8_t)(unsafe.Pointer(&wTags.buf[0]))
	}
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_docs_create_document(cTitle, cTagsPtr, C.size_t(len(wTags.buf)), &cOutLen, &cErr)
	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult Document
	goResult = wvUnpackDocument(rRes)
	rRes.expectEnd()
	return goResult
}

// GetDocument: Look up a document by identifier
//
// Parameters:
//   - id: Identifier returned from create_document
func GetDocument(id int64) *Document {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_docs_get_document(C.int64_t(id), &cOutLen, &cErr)
	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult *Document
	if rRes.readOptionFlag() {
		var oRes0 Document
		oRes0 = wvUnpackDocument(rRes)
		goResult = &oRes0
	}
	rRes.expectEnd()
	return goResult
}

type wvOutcomeDocsPublishAsync struct {
	val bool
	err error
}

//export goWv_weaveffi_docs_publish_async_callback
func goWv_weaveffi_docs_publish_async_callback(context unsafe.Pointer, err *C.weaveffi_error, result C._Bool) {
	v := wvCallbackTake(uint64(uintptr(context)))
	if v == nil {
		return
	}
	ch := v.(chan wvOutcomeDocsPublishAsync)
	if err != nil && err.code != 0 {
		ch <- wvOutcomeDocsPublishAsync{err: wvBrandError(wvTakeBoxedError(err))}
		return
	}
	ch <- wvOutcomeDocsPublishAsync{val: cToBool(result)}
}

// PublishAsync: Publish a document in the background
//
// Parameters:
//   - id: Identifier of the document to publish
// Blocks the calling goroutine until the async producer completes.
func PublishAsync(id int64) bool {
	ch := make(chan wvOutcomeDocsPublishAsync, 1)
	ctxID := wvCallbackStore(ch)
	C.weaveffi_docs_publish_async_async(C.int64_t(id), C.weaveffi_docs_publish_async_callback(unsafe.Pointer(C.goWv_weaveffi_docs_publish_async_callback)), unsafe.Pointer(uintptr(ctxID)))
	outcome := <-ch
	if outcome.err != nil {
		panic(outcome.err)
	}
	return outcome.val
}


