	// Tags: Free-form tags for grouping
	Tags []string
}

// wvPackDocument appends v to w in the value-buffer wire format.
func wvPackDocument(w *wvWriter, v Document) {
	w.writeI64(v.Id)
	w.writeString(v.Title)
	w.writeI32(int32(v.Status))
	w.writeLen(len(v.Tags))
	for _, eTags0 := range v.Tags {
		w.writeString(eTags0)
	}
}

// wvUnpackDocument decodes one Document from r.
func wvUnpackDocument(r *wvReader) Document {
	var v Document
	v.Id = r.readI64()
	v.Title = r.readString()
	v.Status = Status(r.readI32())
	nTags0 := r.readLen()
	v.Tags = make([]string, nTags0)
	for iTags0 := range v.Tags {
		v.Tags[iTags0] = r.readString()
	}
	return v
}

// SavedListener: Consumer-implemented observer of document-saved notifications.
//
// Implementations must be safe to call from any thread.
//
// Implement this interface in Go and pass the value to native functions
// that accept it.
//
// The native library may call any method from any thread until it releases
// the implementation. A panic in a method is reported to the native caller
// as a foreign error (code -4) instead of crashing the process.
type SavedListener interface {
	// OnSaved: Fires after a document has been persisted successfully
	//
	// Parameters:
	//   - doc_id: Identifier of the saved document
	//   - revision: Monotonically increasing revision
	OnSaved(docId int64, revision int32)
}

//export goWv_weaveffi_docs_SavedListener_on_saved
func goWv_weaveffi_docs_SavedListener_on_saved(ctx unsafe.Pointer, doc_id C.int64_t, revision C.int32_t, out_err *C.weaveffi_error) {
	defer func() {
