}

// wvAdoptNotebook adopts one owned strong reference into a new wrapper. A null
// pointer adopts to nil.
func wvAdoptNotebook(ptr *C.weaveffi_docs_Notebook) *Notebook {
	if ptr == nil {
		return nil
