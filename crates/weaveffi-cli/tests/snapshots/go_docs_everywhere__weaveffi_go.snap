			wvForeignError(out_err, r)
		}
	}()
	impl := cgo.Handle(uintptr(ctx)).Value().(SavedListener)
	arg0 := int64(doc_id)
	arg1 := int32(revision)
	impl.OnSaved(arg0, arg1)
}

//export goWv_weaveffi_docs_SavedListener_free
func goWv_weaveffi_docs_SavedListener_free(ctx unsafe.Pointer) {
	cgo.Handle(uintptr(ctx)).Delete()
}

// Notebook: An ordered collection of documents.
//
// Notebooks own their documents and release them when destroyed.
//
// Each wrapper holds one strong reference; Close releases it, and a
// finalizer releases it if the wrapper is garbage collected first.
type Notebook struct {
