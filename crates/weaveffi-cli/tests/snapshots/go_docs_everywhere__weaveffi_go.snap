	wvTrap(&cErr)
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult *Document
	if rRes.readOptionFlag() {
		var oRes0 Document
		oRes0 = wvUnpackDocument(rRes)
		goResult = &oRes0
	}
	rRes.expectEnd()
	return goResult
}

type wvOutcomeDocsPublishAsync struct {
	val bool
	err error
}

//export goWv_weaveffi_docs_publish_async_callback
func goWv_weaveffi_docs_publish_async_callback(context unsafe.Pointer, err *C.weaveffi_error, result C._Bool) {
	h := cgo.Handle(uintptr(context))
	ch := h.Value().(chan wvOutcomeDocsPublishAsync)
	h.Delete()
	if err != nil && err.code != 0 {
		ch <- wvOutcomeDocsPublishAsync{err: wvBrandError(wvTakeBoxedError(err))}
		return
	}
	ch <- wvOutcomeDocsPublishAsync{val: cToBool(result)}
}

// PublishAsync: Publish a document in the background
//
// Parameters:
//   - id: Identifier of the document to publish
// Blocks the calling goroutine until the async producer completes.
func PublishAsync(id int64) bool {
	ch := make(chan wvOutcomeDocsPublishAsync, 1)
	h := cgo.NewHandle(ch)
	C.weaveffi_docs_publish_async_async(C.int64_t(id), C.weaveffi_docs_publish_async_callback(unsafe.Pointer(C.goWv_weaveffi_docs_publish_async_callback)), C.wvHandlePtr(C.uintptr_t(h)))
	outcome := <-ch
	if outcome.err != nil {
		panic(outcome.err)
	}
	return outcome.val
}

// Watch: Register a listener for saved notifications
//
// Parameters:
//   - listener: Receiver of saved notifications
func Watch(listener SavedListener) {
	hListener := cgo.NewHandle(listener)
	var cErr C.weaveffi_error
	C.weaveffi_docs_watch(C.wvHandlePtr(C.uintptr_t(hListener)), C.wvVtablePtr_weaveffi_docs_SavedListener(), &cErr)
	wvTrap(&cErr)
}

