/// Typed error domain `ContactsError` declared by module `contacts`.
class ContactsException extends WeaveFFIException {
  ContactsException(super.code, super.message);
}

/// name must not be empty
class InvalidNameException extends ContactsException {
  InvalidNameException([String message = 'name must not be empty']) : super(1, message);
}

/// contact not found
class NotFoundException extends ContactsException {
  NotFoundException([String message = 'contact not found']) : super(2, message);
}

WeaveFFIException _mapContactsException(int code, String message, Uint8List payload) {
  switch (code) {
    case 1:
      return InvalidNameException(message);
    case 2:
      return NotFoundException(message);
    default:
      return WeaveFFIException(code, message);
  }
}

void _checkContactsException(Pointer<_WeaveFFIError> err) {
  if (err.ref.code != 0) {
    final code = err.ref.code;
    final msg = err.ref.message.toDartString();
    final payload = _copyNativeBytes(err.ref.payloadPtr, err.ref.payloadLen);
    _weaveffiErrorClear(err);
    throw _mapContactsException(code, msg, payload);
  }
}

enum ContactType {
  personal(0),
  work(1),
  other(2),
  ;
  const ContactType(this.value);
  final int value;

  static ContactType fromValue(int value) =>
      ContactType.values.firstWhere((e) => e.value == value);
}

class Contact {
  final int id;
  final String firstName;
  final String lastName;
  final String? email;
  final ContactType contactType;

  Contact({required this.id, required this.firstName, required this.lastName, this.email, required this.contactType});
}

void _packContact(_BufferWriter w, Contact v) {
  w.writeInt64(v.id);
  w.writeString(v.firstName);
  w.writeString(v.lastName);
  final t0 = v.email;
  if (t0 == null) {
    w.writeOptionFlag(false);
  } else {
    w.writeOptionFlag(true);
    w.writeString(t0);
  }
  w.writeInt32(v.contactType.value);
}

Contact _unpackContact(_BufferReader r) {
  return Contact(
    id: r.readInt64(),
    firstName: r.readString(),
    lastName: r.readString(),
    email: (r.readOptionFlag() ? r.readString() : null),
    contactType: ContactType.fromValue(r.readInt32()),
  );
}

