      emailWriter.writeOptionFlag(false);
    } else {
      emailWriter.writeOptionFlag(true);
      emailWriter.writeString(t0);
    }
    final emailBuf = emailWriter.takeBytes();
    final emailPtr = _stageBytes(emailBuf);
    final outLen = calloc<Size>();
    final err = calloc<_WeaveFFIError>();
    try {
