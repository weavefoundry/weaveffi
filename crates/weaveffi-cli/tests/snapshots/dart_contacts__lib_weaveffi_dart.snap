      if (result != nullptr) _weaveffiFreeBytes(result, n);
      final reader = _BufferReader(data);
      final value = _unpackContact(reader);
      reader.expectEnd();
      return value;
    } finally {
      calloc.free(outLen);
      calloc.free(err);
    }
