      if (result != nullptr) _weaveffiFreeBytes(result, n);
      final reader = _BufferReader(data);
      final value = _unpackContact(reader);
      reader.expectEnd();
      return value;
    } finally {
      calloc.free(firstNamePtr);
      calloc.free(lastNamePtr);
      calloc.free(emailPtr);
      calloc.free(outLen);
      calloc.free(err);
    }
  }

  /// Throws [ContactsException] on domain errors.
  Contact get(int id) {
    final outLen = calloc<Size>();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiContactsContactBookGet(_handle, id, outLen, err);
      _checkContactsException(err);
