    abiVersion = lib.lookupFunction<Uint32 Function(), int Function()>(
        'nested_modules_abi_version');
  } on ArgumentError {
    throw NativeLibraryError(
        "the native library 'nested_modules' isn't loaded; set NESTED_MODULES_LIBRARY "
        'to its path');
  }
