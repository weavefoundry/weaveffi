  if (found != _abiVersion) {
    throw NativeLibraryError('nested_modules: these bindings expect C ABI revision '
        '$_abiVersion, but the loaded library implements revision $found');
  }
  for (final (symbol, expected) in _contracts) {
    _checkContract(lib, symbol, expected);
