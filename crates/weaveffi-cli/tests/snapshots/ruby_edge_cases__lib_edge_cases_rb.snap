  end

  # @api private
  # Packs `[string]?` into the value-buffer wire format.
  def self._wv_write_opt_list_string(w, v)
    if v.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      _wv_write_list_string(w, v)
    end
  end

