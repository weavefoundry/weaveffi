  # Blocks until the call completes on a producer thread.
  # @return [String]
  def self.async_keywords(class_, import)
    class__s = _wv_str(class_)
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_keywords(class__s, class__s.bytesize, import, EDGE_CASES_EDGE_CASES_ASYNC_KEYWORDS_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # @return [Keywords]
  def self.keywords_roundtrip(value)
    value_s = _wv_encode { |w| _wv_write_keywords(w, value) }
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = edge_cases_edge_cases_keywords_roundtrip(value_s, value_s.bytesize, out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_keywords(r) }
  end

  # @return [Retired]
  # @deprecated Use Mode-based APIs
  def self.legacy_value(value)
    warn('EdgeCases.legacy_value is deprecated: Use Mode-based APIs', uplevel: 1)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = edge_cases_edge_cases_legacy_value(value, out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_retired(r) }
  end

  # === Value-buffer codecs of the composite types ===

  # @api private
  # Packs `[string]` into the value-buffer wire format.
  def self._wv_write_list_string(w, v)
    w.write_len(v.length)
    v.each { |e| w.write_string(e) }
  end

  # @api private
  # Unpacks `[string]` from the value-buffer wire format.
  def self._wv_read_list_string(r)
    Array.new(r.read_len) { r.read_string }
  end

  # @api private
  # Packs `i32?` into the value-buffer wire format.
  def self._wv_write_opt_i32(w, v)
    if v.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      w.write_i32(v)
    end
  end

  # @api private
  # Unpacks `i32?` from the value-buffer wire format.
  def self._wv_read_opt_i32(r)
    r.read_flag ? r.read_i32 : nil
  end

  # @api private
  # Packs `[Outer?]?` into the value-buffer wire format.
  def self._wv_write_opt_list_opt_outer(w, v)
    if v.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      _wv_write_list_opt_outer(w, v)
    end
  end

  # @api private
  # Unpacks `[Outer?]?` from the value-buffer wire format.
  def self._wv_read_opt_list_opt_outer(r)
    r.read_flag ? _wv_read_list_opt_outer(r) : nil
  end

  # @api private
  # Packs `[Outer?]` into the value-buffer wire format.
  def self._wv_write_list_opt_outer(w, v)
    w.write_len(v.length)
    v.each { |e| _wv_write_opt_outer(w, e) }
  end

  # @api private
  # Unpacks `[Outer?]` from the value-buffer wire format.
  def self._wv_read_list_opt_outer(r)
    Array.new(r.read_len) { _wv_read_opt_outer(r) }
  end

  # @api private
  # Packs `Outer?` into the value-buffer wire format.
  def self._wv_write_opt_outer(w, v)
    if v.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      _wv_write_outer(w, v)
    end
  end

  # @api private
  # Unpacks `Outer?` from the value-buffer wire format.
  def self._wv_read_opt_outer(r)
    r.read_flag ? _wv_read_outer(r) : nil
  end

  # @api private
  # Packs `string?` into the value-buffer wire format.
  def self._wv_write_opt_string(w, v)
    if v.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      w.write_string(v)
    end
  end

  # @api private
