    edge_cases_edge_cases_async_struct(EDGE_CASES_EDGE_CASES_ASYNC_STRUCT_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Blocks until the call completes on a producer thread.
  # @param cancel [CancelToken, nil] cancels the call; it then raises Cancelled
  # @return [Array<Outer>]
  def self.async_list(cancel: nil)
    own_token = CancelToken.new if cancel.nil?
    token = cancel || own_token
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_list(token._wv_ptr, EDGE_CASES_EDGE_CASES_ASYNC_LIST_CALLBACK, ctx)
    _wv_async_wait(queue, token)
  ensure
    own_token&.close
  end

  # Blocks until the call completes on a producer thread.
