  # @api private
  # Packs `[Widget]` into the value-buffer wire format.
  def self._wv_write_list_widget(w, v)
    w.write_len(v.length)
    v.each { |e| w.write_object(e, Widget) }
  end

  # @api private
  # Unpacks `[Widget]` from the value-buffer wire format.
