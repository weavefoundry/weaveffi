  # Callback interface carrying composite payloads and objects
  #
  # Consumer-implemented callback interface. Any object responding to the
  # methods below is accepted wherever a BatchListener is expected; include
  # this module to inherit NotImplementedError defaults. The library
  # may call the methods from any thread until it releases the
  # implementation.
  module BatchListener
    # Composite payloads cross as value buffers
    def on_batch(items, raw, first, mode)
      raise NotImplementedError, "#{self.class}#on_batch is not implemented"
    end

    # Objects cross as strong references the consumer must release
    def on_widget(widget, fallback, children)
      raise NotImplementedError, "#{self.class}#on_widget is not implemented"
    end

    def on_tick
      raise NotImplementedError, "#{self.class}#on_tick is not implemented"
    end

    # Scalar return travels back through the vtable
    # @return [Boolean]
    def should_continue(class_)
      raise NotImplementedError, "#{self.class}#should_continue is not implemented"
    end

    # Enum return travels back as its integer discriminant
    # @return [Integer]
    def pick_mode
      raise NotImplementedError, "#{self.class}#pick_mode is not implemented"
    end
  end

  # @api private
  # The C vtable layout the library calls a BatchListener through.
  class WvBatchListenerVtable < FFI::Struct
    layout :wv_size, :uint32,
           :wv_flags, :uint32,
           :wv_free, :pointer,
           :on_batch, :pointer,
           :on_widget, :pointer,
           :on_tick, :pointer,
           :should_continue, :pointer,
           :pick_mode, :pointer
  end

  # @api private
  # Releases a BatchListener implementation when the library drops its last
  # reference. May run on any library thread.
  WV_BATCH_LISTENER_FREE = FFI::Function.new(:void, [:pointer]) do |ctx|
    _wv_cb_free(ctx)
  end

  # @api private
  # Trampoline for BatchListener#on_batch.
  WV_BATCH_LISTENER_ON_BATCH = FFI::Function.new(:void, [:pointer, :pointer, :size_t, :pointer, :size_t, :pointer, :size_t, :int32, :pointer]) do |wv_ctx, items_ptr, items_len, raw_ptr, raw_len, first_ptr, first_len, mode, wv_err|
    items = _wv_decode_borrowed(items_ptr, items_len) { |r| _wv_read_list_outer(r) }
    raw = _wv_borrow_bytes(raw_ptr, raw_len)
    first = _wv_decode_borrowed(first_ptr, first_len) { |r| _wv_read_opt_outer(r) }
    _wv_cb_lookup(wv_ctx).on_batch(items, raw, first, mode)
    nil
  rescue Exception => e # rubocop:disable Lint/RescueException
    _wv_cb_fail(wv_err, e)
    nil
  end

  # @api private
  # Trampoline for BatchListener#on_widget.
  WV_BATCH_LISTENER_ON_WIDGET = FFI::Function.new(:void, [:pointer, :pointer, :pointer, :pointer, :size_t, :pointer]) do |wv_ctx, widget_ptr, fallback_ptr, children_ptr, children_len, wv_err|
    widget = Widget._from_ptr(widget_ptr)
    fallback = fallback_ptr.null? ? nil : Widget._from_ptr(fallback_ptr)
    children = _wv_decode_borrowed(children_ptr, children_len) { |r| _wv_read_list_widget(r) }
    _wv_cb_lookup(wv_ctx).on_widget(widget, fallback, children)
    nil
  rescue Exception => e # rubocop:disable Lint/RescueException
    _wv_cb_fail(wv_err, e)
    nil
  end

  # @api private
  # Trampoline for BatchListener#on_tick.
  WV_BATCH_LISTENER_ON_TICK = FFI::Function.new(:void, [:pointer, :pointer]) do |wv_ctx, wv_err|
    _wv_cb_lookup(wv_ctx).on_tick
    nil
  rescue Exception => e # rubocop:disable Lint/RescueException
    _wv_cb_fail(wv_err, e)
    nil
  end

  # @api private
  # Trampoline for BatchListener#should_continue.
  WV_BATCH_LISTENER_SHOULD_CONTINUE = FFI::Function.new(:bool, [:pointer, :int32, :pointer]) do |wv_ctx, class_, wv_err|
    _wv_cb_lookup(wv_ctx).should_continue(class_) ? true : false
  rescue Exception => e # rubocop:disable Lint/RescueException
    _wv_cb_fail(wv_err, e)
    false
  end

  # @api private
  # Trampoline for BatchListener#pick_mode.
  WV_BATCH_LISTENER_PICK_MODE = FFI::Function.new(:int32, [:pointer, :pointer]) do |wv_ctx, wv_err|
    _wv_int(_wv_cb_lookup(wv_ctx).pick_mode, :i32)
  rescue Exception => e # rubocop:disable Lint/RescueException
    _wv_cb_fail(wv_err, e)
    0
  end

  # The one process-wide BatchListener vtable every registration hands the
  # library; its entries live for the process lifetime.
  WV_BATCH_LISTENER_VTABLE = WvBatchListenerVtable.new
  WV_BATCH_LISTENER_VTABLE[:wv_size] = WvBatchListenerVtable.size
  WV_BATCH_LISTENER_VTABLE[:wv_flags] = 0
  WV_BATCH_LISTENER_VTABLE[:wv_free] = WV_BATCH_LISTENER_FREE
  WV_BATCH_LISTENER_VTABLE[:on_batch] = WV_BATCH_LISTENER_ON_BATCH
  WV_BATCH_LISTENER_VTABLE[:on_widget] = WV_BATCH_LISTENER_ON_WIDGET
  WV_BATCH_LISTENER_VTABLE[:on_tick] = WV_BATCH_LISTENER_ON_TICK
  WV_BATCH_LISTENER_VTABLE[:should_continue] = WV_BATCH_LISTENER_SHOULD_CONTINUE
  WV_BATCH_LISTENER_VTABLE[:pick_mode] = WV_BATCH_LISTENER_PICK_MODE

