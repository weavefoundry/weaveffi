  # Callback interface carrying composite payloads and objects
  #
  # Consumer-implemented callback interface. Any object responding to the
  # methods below is accepted wherever a BatchListener is expected; include
  # this module to inherit NotImplementedError defaults. The producer
  # may call the methods from any thread until it releases the
  # implementation.
  module BatchListener
    # Composite payloads cross as value buffers
    def on_batch(items, raw, first, mode)
      raise NotImplementedError, "#{self.class}#on_batch is not implemented"
    end

    # Objects cross as strong references the consumer must release
    def on_widget(widget, fallback, children)
      raise NotImplementedError, "#{self.class}#on_widget is not implemented"
    end

    def on_tick
      raise NotImplementedError, "#{self.class}#on_tick is not implemented"
    end

    # Scalar return travels back through the vtable
    # @return [Object] a bool
    def should_continue(class_)
      raise NotImplementedError, "#{self.class}#should_continue is not implemented"
    end

    # Enum return travels back as its integer discriminant
    # @return [Object] a edge_cases.Mode
    def pick_mode
      raise NotImplementedError, "#{self.class}#pick_mode is not implemented"
    end
  end

  # @api private
  # The C vtable layout the producer calls a BatchListener through.
  class WvBatchListenerVtable < FFI::Struct
    layout :on_batch, :pointer,
           :on_widget, :pointer,
           :on_tick, :pointer,
           :should_continue, :pointer,
           :pick_mode, :pointer,
           :free, :pointer
  end

  # @api private
  # Trampoline for BatchListener#on_batch.
  WV_BATCH_LISTENER_ON_BATCH = FFI::Function.new(:void, [:pointer, :pointer, :size_t, :pointer, :size_t, :pointer, :size_t, :int32, :pointer]) do |ctx, items_ptr, items_len, raw_ptr, raw_len, first_ptr, first_len, mode, out_err|
    begin
      items_r = WvBufferReader.new(_wv_borrow_bytes(items_ptr, items_len))
      items_v = Array.new(items_r.read_len) do
        _wv_e0 = _wv_read_outer(items_r)
        _wv_e0
      end
      items_r.expect_end!
      raw_v = _wv_borrow_bytes(raw_ptr, raw_len)
      first_r = WvBufferReader.new(_wv_borrow_bytes(first_ptr, first_len))
      if first_r.read_flag
        first_v = _wv_read_outer(first_r)
      else
        first_v = nil
      end
      first_r.expect_end!
      mode_v = mode
      impl = _wv_cb_lookup(ctx)
      impl.on_batch(items_v, raw_v, first_v, mode_v)
      nil
    rescue Exception => e # rubocop:disable Lint/RescueException
      _wv_cb_fail(out_err, e)
      nil
    end
  end

  # @api private
  # Trampoline for BatchListener#on_widget.
  WV_BATCH_LISTENER_ON_WIDGET = FFI::Function.new(:void, [:pointer, :pointer, :pointer, :pointer, :size_t, :pointer]) do |ctx, widget, fallback, children_ptr, children_len, out_err|
    begin
      widget_v = Widget._from_ptr(widget)
      fallback_v = fallback.null? ? nil : Widget._from_ptr(fallback)
      children_r = WvBufferReader.new(_wv_borrow_bytes(children_ptr, children_len))
      children_v = Array.new(children_r.read_len) do
        _wv_e0 = Widget._from_ptr(children_r.read_object_token)
        _wv_e0
      end
      children_r.expect_end!
      impl = _wv_cb_lookup(ctx)
      impl.on_widget(widget_v, fallback_v, children_v)
      nil
    rescue Exception => e # rubocop:disable Lint/RescueException
      _wv_cb_fail(out_err, e)
      nil
    end
  end

  # @api private
  # Trampoline for BatchListener#on_tick.
  WV_BATCH_LISTENER_ON_TICK = FFI::Function.new(:void, [:pointer, :pointer]) do |ctx, out_err|
    begin
      impl = _wv_cb_lookup(ctx)
      impl.on_tick
      nil
    rescue Exception => e # rubocop:disable Lint/RescueException
      _wv_cb_fail(out_err, e)
      nil
    end
  end

  # @api private
  # Trampoline for BatchListener#should_continue.
  WV_BATCH_LISTENER_SHOULD_CONTINUE = FFI::Function.new(:bool, [:pointer, :int32, :pointer]) do |ctx, class_, out_err|
    begin
      class__v = class_
      impl = _wv_cb_lookup(ctx)
      impl.should_continue(class__v) ? true : false
    rescue Exception => e # rubocop:disable Lint/RescueException
      _wv_cb_fail(out_err, e)
      false
    end
  end

  # @api private
  # Trampoline for BatchListener#pick_mode.
  WV_BATCH_LISTENER_PICK_MODE = FFI::Function.new(:int32, [:pointer, :pointer]) do |ctx, out_err|
    begin
      impl = _wv_cb_lookup(ctx)
      Integer(impl.pick_mode)
    rescue Exception => e # rubocop:disable Lint/RescueException
      _wv_cb_fail(out_err, e)
      0
    end
  end

  # @api private
  # Releases a BatchListener implementation when the producer drops its last
  # reference.
  WV_BATCH_LISTENER_FREE = FFI::Function.new(:void, [:pointer]) do |ctx|
    _wv_cb_free(ctx)
  end

  # The one process-wide BatchListener vtable every registration hands the
  # producer; its entries live for the process lifetime.
  WV_BATCH_LISTENER_VTABLE = WvBatchListenerVtable.new
  WV_BATCH_LISTENER_VTABLE[:on_batch] = WV_BATCH_LISTENER_ON_BATCH
  WV_BATCH_LISTENER_VTABLE[:on_widget] = WV_BATCH_LISTENER_ON_WIDGET
  WV_BATCH_LISTENER_VTABLE[:on_tick] = WV_BATCH_LISTENER_ON_TICK
  WV_BATCH_LISTENER_VTABLE[:should_continue] = WV_BATCH_LISTENER_SHOULD_CONTINUE
  WV_BATCH_LISTENER_VTABLE[:pick_mode] = WV_BATCH_LISTENER_PICK_MODE
  WV_BATCH_LISTENER_VTABLE[:free] = WV_BATCH_LISTENER_FREE

