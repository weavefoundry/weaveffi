  # @api private
  # Completion trampoline for fetch.
  EDGE_CASES_EDGE_CASES_WIDGET_FETCH_CALLBACK = FFI::Function.new(:void, [:pointer, :pointer, :pointer, :size_t]) do |ctx, err, result_ptr, result_len|
    queue = _wv_async_finish(ctx)
    begin
      taken = _wv_take_boxed_error(err)
      if taken
        queue << _wv_edge_errors_error_from(*taken)
      else
        value = _wv_decode(result_ptr, result_len) { |r| _wv_read_outer(r) }
        queue << value
      end
    rescue Exception => e # rubocop:disable Lint/RescueException
      queue << e
    end
  end

