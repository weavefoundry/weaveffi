  # @api private
  # Owns one strong reference to a Widget; releases it exactly once.
  class WidgetPtr < FFI::AutoPointer
    def self.release(ptr)
      EdgeCases.edge_cases_edge_cases_Widget_destroy(ptr)
    end
  end

  # Interface with no constructor; instances come from make_widget
  class Widget < WvObject
    WV_PTR = WidgetPtr
    private_class_method :new

    # @api private
    def self._wv_clone(ptr)
      EdgeCases.edge_cases_edge_cases_Widget_clone(ptr)
    end

    # Void method that can fail
    def refresh
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        EdgeCases.edge_cases_edge_cases_Widget_refresh(_wv_self, err)
        EdgeCases.check_edge_errors_error!(err)
      end
    end

    def rename(class_, import)
      class__s = EdgeCases._wv_str(class_)
      import_w = WvBufferWriter.new
      if import.nil?
        import_w.write_flag(false)
      else
        import_w.write_flag(true)
        import_w.write_string(import)
      end
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        out_len = FFI::MemoryPointer.new(:size_t)
        import_s = EdgeCases._wv_seal(import_w).first
        result = EdgeCases.edge_cases_edge_cases_Widget_rename(_wv_self, class__s, class__s.bytesize, import_s, import_s.bytesize, out_len, err)
        EdgeCases.check_error!(err)
        EdgeCases._wv_take_string(result, out_len.read(:size_t))
      end
    end

    # Async method with a struct result
    # Blocks until the call completes on a producer thread.
    def fetch(id)
      queue = nil
      EdgeCases._wv_pin(self) do |_wv_self|
        ctx, queue = EdgeCases._wv_async_begin
        EdgeCases.edge_cases_edge_cases_Widget_fetch(_wv_self, id, EDGE_CASES_EDGE_CASES_WIDGET_FETCH_CALLBACK, ctx)
      end
      EdgeCases._wv_async_wait(queue)
    end

    # @deprecated Use rename instead
    def old_name
      warn '[DEPRECATED] Use rename instead'
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        out_len = FFI::MemoryPointer.new(:size_t)
        result = EdgeCases.edge_cases_edge_cases_Widget_old_name(_wv_self, out_len, err)
        EdgeCases.check_error!(err)
        EdgeCases._wv_take_string(result, out_len.read(:size_t))
      end
    end
  end

  # @api private
  # Owns one strong reference to a Vault; releases it exactly once.
  class VaultPtr < FFI::AutoPointer
    def self.release(ptr)
      EdgeCases.edge_cases_edge_cases_Vault_destroy(ptr)
    end
  end

  # Deprecated interface with a throwing constructor
  # @deprecated Use Widget instead
  class Vault < WvObject
    WV_PTR = VaultPtr
    private_class_method :new

    # @api private
    def self._wv_clone(ptr)
      EdgeCases.edge_cases_edge_cases_Vault_clone(ptr)
    end

    # Fails when the vault is busy
    def self.open(path)
      path_s = EdgeCases._wv_str(path)
      err = ErrorStruct.new
      result = EdgeCases.edge_cases_edge_cases_Vault_open(path_s, path_s.bytesize, err)
      EdgeCases.check_edge_errors_error!(err)
      raise Error.new(GENERIC_ERROR_CODE, 'null object pointer') if result.null?
      _from_ptr(result)
    end

    def peek
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        result = EdgeCases.edge_cases_edge_cases_Vault_peek(_wv_self, err)
        EdgeCases.check_error!(err)
        result.null? ? nil : Widget._from_ptr(result)
      end
    end

    # Throwing static
    def self.probe
      err = ErrorStruct.new
      result = EdgeCases.edge_cases_edge_cases_Vault_probe(err)
      EdgeCases.check_edge_errors_error!(err)
      result
    end
  end

  # No parameters and no result
  def self.noop
    err = ErrorStruct.new
    edge_cases_edge_cases_noop(err)
    check_error!(err)
  end

  # Function named after a keyword whose parameters are all keywords
  def self.select(class_, from, func, range, type)
    from_s = _wv_str(from)
    func_w = WvBufferWriter.new
    func_w.write_len(func.length)
    func.each do |_wv_e0|
      func_w.write_string(_wv_e0)
    end
    range_w = WvBufferWriter.new
    if range.nil?
      range_w.write_flag(false)
    else
      range_w.write_flag(true)
      range_w.write_i32(range)
    end
    err = ErrorStruct.new
    func_s, range_s = _wv_seal(func_w, range_w)
    result = edge_cases_edge_cases_select(class_, from_s, from_s.bytesize, func_s, func_s.bytesize, range_s, range_s.bytesize, (type ? true : false), err)
    check_error!(err)
    result
  end

  # Optional list of optional structs, the deepest legal nesting
  def self.nested_optional(items)
    items_w = WvBufferWriter.new
    if items.nil?
      items_w.write_flag(false)
    else
      items_w.write_flag(true)
      items_w.write_len(items.length)
      items.each do |_wv_e0|
        if _wv_e0.nil?
          items_w.write_flag(false)
        else
          items_w.write_flag(true)
          _wv_write_outer(items_w, _wv_e0)
        end
      end
    end
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    items_s = _wv_seal(items_w).first
    result = edge_cases_edge_cases_nested_optional(items_s, items_s.bytesize, out_len, err)
    check_error!(err)
    _wv_decode(result, out_len.read(:size_t)) do |_wv_r|
      if _wv_r.read_flag
        _wv_value = Array.new(_wv_r.read_len) do
          if _wv_r.read_flag
            _wv_e0 = _wv_read_outer(_wv_r)
          else
            _wv_e0 = nil
          end
          _wv_e0
        end
      else
        _wv_value = nil
      end
      _wv_value
    end
  end

  def self.optional_params(text, count, outer, tags, blob, mode)
    text_w = WvBufferWriter.new
    if text.nil?
      text_w.write_flag(false)
    else
      text_w.write_flag(true)
      text_w.write_string(text)
    end
    count_w = WvBufferWriter.new
    if count.nil?
      count_w.write_flag(false)
    else
      count_w.write_flag(true)
      count_w.write_i32(count)
    end
    outer_w = WvBufferWriter.new
    if outer.nil?
      outer_w.write_flag(false)
    else
      outer_w.write_flag(true)
      _wv_write_outer(outer_w, outer)
    end
    tags_w = WvBufferWriter.new
    if tags.nil?
      tags_w.write_flag(false)
    else
      tags_w.write_flag(true)
      tags_w.write_len(tags.length)
      tags.each do |_wv_e0|
        tags_w.write_string(_wv_e0)
      end
    end
    blob_w = WvBufferWriter.new
    if blob.nil?
      blob_w.write_flag(false)
    else
      blob_w.write_flag(true)
      blob_w.write_bytes(blob)
    end
    mode_w = WvBufferWriter.new
    if mode.nil?
      mode_w.write_flag(false)
    else
      mode_w.write_flag(true)
      mode_w.write_i32(mode)
    end
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    text_s, count_s, outer_s, tags_s, blob_s, mode_s = _wv_seal(text_w, count_w, outer_w, tags_w, blob_w, mode_w)
    result = edge_cases_edge_cases_optional_params(text_s, text_s.bytesize, count_s, count_s.bytesize, outer_s, outer_s.bytesize, tags_s, tags_s.bytesize, blob_s, blob_s.bytesize, mode_s, mode_s.bytesize, out_len, err)
    check_error!(err)
    _wv_decode(result, out_len.read(:size_t)) do |_wv_r|
      if _wv_r.read_flag
        _wv_value = _wv_r.read_i32
      else
        _wv_value = nil
      end
      _wv_value
    end
  end

  # Two callback interface parameters on one function
  def self.register_batch(listener, keyword)
    err = ErrorStruct.new
    listener_ctx = _wv_cb_register(listener)
    keyword_ctx = _wv_cb_register(keyword)
    edge_cases_edge_cases_register_batch(listener_ctx, WV_BATCH_LISTENER_VTABLE.to_ptr, keyword_ctx, WV_KEYWORD_VTABLE.to_ptr, err)
    check_error!(err)
  end

  # Objects in every buffered position
  def self.widgets_everywhere(list, by_name, sparse, holder)
    list_w = WvBufferWriter.new
    list_w.write_len(list.length)
    list.each do |_wv_e0|
      list_w.write_object(_wv_e0)
    end
    by_name_w = WvBufferWriter.new
    by_name_w.write_len(by_name.length)
    by_name.each do |_wv_k0, _wv_v0|
      by_name_w.write_string(_wv_k0)
      by_name_w.write_object(_wv_v0)
    end
    sparse_w = WvBufferWriter.new
    sparse_w.write_len(sparse.length)
    sparse.each do |_wv_e0|
      if _wv_e0.nil?
        sparse_w.write_flag(false)
      else
        sparse_w.write_flag(true)
        sparse_w.write_object(_wv_e0)
      end
    end
    holder_w = WvBufferWriter.new
    _wv_write_widget_holder(holder_w, holder)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    list_s, by_name_s, sparse_s, holder_s = _wv_seal(list_w, by_name_w, sparse_w, holder_w)
    result = edge_cases_edge_cases_widgets_everywhere(list_s, list_s.bytesize, by_name_s, by_name_s.bytesize, sparse_s, sparse_s.bytesize, holder_s, holder_s.bytesize, out_len, err)
    check_error!(err)
    _wv_decode(result, out_len.read(:size_t)) do |_wv_r|
      _wv_value = _wv_read_widget_holder(_wv_r)
      _wv_value
    end
  end

  # Iterator of objects
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
  # iteration finishes or is abandoned early.
  def self.widget_stream
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = edge_cases_edge_cases_widget_stream(err)
      begin
        check_error!(err)
        out_item = FFI::MemoryPointer.new(:pointer)
        loop do
          has_item = edge_cases_edge_cases_WidgetStreamIterator_next(iter, out_item, err)
          check_error!(err)
          break if has_item.zero?
          item = out_item.read_pointer
          raise Error.new(GENERIC_ERROR_CODE, 'null object pointer') if item.null?
          value = Widget._from_ptr(item)
          y << value
        end
      ensure
        edge_cases_edge_cases_WidgetStreamIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Async returning an object
  # Blocks until the call completes on a producer thread.
  def self.async_widget
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_widget(EDGE_CASES_EDGE_CASES_ASYNC_WIDGET_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Factory for an interface with no constructor
  def self.make_widget(label)
    label_s = _wv_str(label)
    err = ErrorStruct.new
    result = edge_cases_edge_cases_make_widget(label_s, label_s.bytesize, err)
    check_error!(err)
    raise Error.new(GENERIC_ERROR_CODE, 'null object pointer') if result.null?
    Widget._from_ptr(result)
  end

  # Optional interface return
  def self.find_widget(id)
    err = ErrorStruct.new
    result = edge_cases_edge_cases_find_widget(id, err)
    check_edge_errors_error!(err)
    result.null? ? nil : Widget._from_ptr(result)
  end

  # Interface parameter, including an optional one
  def self.inspect_widget(widget, fallback)
    _wv_pin(widget, fallback) do |_wv_widget, _wv_fallback|
      err = ErrorStruct.new
      out_len = FFI::MemoryPointer.new(:size_t)
      result = edge_cases_edge_cases_inspect_widget(_wv_widget, _wv_fallback, out_len, err)
      check_error!(err)
      _wv_take_string(result, out_len.read(:size_t))
    end
  end

  # Iterator of strings
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
  # iteration finishes or is abandoned early.
  def self.string_stream
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = edge_cases_edge_cases_string_stream(err)
      begin
        check_error!(err)
        out_item = FFI::MemoryPointer.new(:pointer)
        out_len = FFI::MemoryPointer.new(:size_t)
        loop do
          has_item = edge_cases_edge_cases_StringStreamIterator_next(iter, out_item, out_len, err)
          check_error!(err)
          break if has_item.zero?
          item = out_item.read_pointer
          value = _wv_take_string(item, out_len.read(:size_t))
          y << value
        end
      ensure
        edge_cases_edge_cases_StringStreamIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Iterator of scalars
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
  # iteration finishes or is abandoned early.
  def self.scalar_stream
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = edge_cases_edge_cases_scalar_stream(err)
      begin
        check_error!(err)
        out_item = FFI::MemoryPointer.new(:int32)
        loop do
          has_item = edge_cases_edge_cases_ScalarStreamIterator_next(iter, out_item, err)
          check_error!(err)
          break if has_item.zero?
          item = out_item.read(:int32)
          value = item
          y << value
        end
      ensure
        edge_cases_edge_cases_ScalarStreamIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Iterator of enums
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
  # iteration finishes or is abandoned early.
  def self.mode_stream
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = edge_cases_edge_cases_mode_stream(err)
      begin
        check_error!(err)
        out_item = FFI::MemoryPointer.new(:int32)
        loop do
          has_item = edge_cases_edge_cases_ModeStreamIterator_next(iter, out_item, err)
          check_error!(err)
          break if has_item.zero?
          item = out_item.read(:int32)
          value = item
          y << value
        end
      ensure
        edge_cases_edge_cases_ModeStreamIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Async with no result
  # Blocks until the call completes on a producer thread.
  def self.async_void
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_void(EDGE_CASES_EDGE_CASES_ASYNC_VOID_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Blocks until the call completes on a producer thread.
  def self.async_bytes(size)
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_bytes(size, EDGE_CASES_EDGE_CASES_ASYNC_BYTES_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Blocks until the call completes on a producer thread.
  def self.async_struct
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_struct(EDGE_CASES_EDGE_CASES_ASYNC_STRUCT_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Blocks until the call completes on a producer thread.
  # @param cancel [CancelToken, nil] cancels the call; it then raises Cancelled
  def self.async_list(cancel: nil)
    own_token = CancelToken.new if cancel.nil?
    token = cancel || own_token
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_list(token._wv_ptr, EDGE_CASES_EDGE_CASES_ASYNC_LIST_CALLBACK, ctx)
    _wv_async_wait(queue, token)
  ensure
    own_token&.close
  end

  # Blocks until the call completes on a producer thread.
  def self.async_optional
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_optional(EDGE_CASES_EDGE_CASES_ASYNC_OPTIONAL_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Blocks until the call completes on a producer thread.
  def self.async_enum
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_enum(EDGE_CASES_EDGE_CASES_ASYNC_ENUM_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Blocks until the call completes on a producer thread.
  def self.async_keywords(class_, import)
    class__s = _wv_str(class_)
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_keywords(class__s, class__s.bytesize, import, EDGE_CASES_EDGE_CASES_ASYNC_KEYWORDS_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  def self.keywords_roundtrip(value)
    value_w = WvBufferWriter.new
    _wv_write_keywords(value_w, value)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    value_s = _wv_seal(value_w).first
    result = edge_cases_edge_cases_keywords_roundtrip(value_s, value_s.bytesize, out_len, err)
    check_error!(err)
    _wv_decode(result, out_len.read(:size_t)) do |_wv_r|
      _wv_value = _wv_read_keywords(_wv_r)
      _wv_value
    end
  end

  # @deprecated Use Mode-based APIs
  def self.legacy_value(value)
    warn '[DEPRECATED] Use Mode-based APIs'
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = edge_cases_edge_cases_legacy_value(value, out_len, err)
    check_error!(err)
    _wv_decode(result, out_len.read(:size_t)) do |_wv_r|
      _wv_value = _wv_read_retired(_wv_r)
      _wv_value
    end
  end
end

