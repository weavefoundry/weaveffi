  WV_KEYWORD_VTABLE[:wv_free] = WV_KEYWORD_FREE
  WV_KEYWORD_VTABLE[:delete] = WV_KEYWORD_DELETE
  WV_KEYWORD_VTABLE[:import] = WV_KEYWORD_IMPORT

  # @api private
  # Owns one strong reference to a Widget; releases it exactly once.
  class WidgetPtr < FFI::AutoPointer
    def self.release(ptr)
      EdgeCases.edge_cases_edge_cases_Widget_destroy(ptr)
    end
  end

  # Interface with no constructor; instances come from make_widget
  class Widget < WvObject
    WV_PTR = WidgetPtr
    private_class_method :new

    # @api private
    def self._wv_clone(ptr)
      EdgeCases.edge_cases_edge_cases_Widget_clone(ptr)
    end

    # Void method that can fail
    def refresh
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        EdgeCases.edge_cases_edge_cases_Widget_refresh(_wv_self, err)
        EdgeCases._wv_check_edge_errors_error!(err)
        nil
      end
    end

    # @return [String]
    def rename(class_, import = nil)
      class__s = EdgeCases._wv_str(class_)
      import_s = EdgeCases._wv_encode { |w| EdgeCases._wv_write_opt_string(w, import) }
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        out_len = FFI::MemoryPointer.new(:size_t)
        result = EdgeCases.edge_cases_edge_cases_Widget_rename(_wv_self, class__s, class__s.bytesize, import_s, import_s.bytesize, out_len, err)
        EdgeCases._wv_check!(err)
        EdgeCases._wv_take_string(result, out_len.read(:size_t))
      end
    end

    # Async method with a struct result
    # Blocks until the call completes on a producer thread.
    # @return [Outer]
    def fetch(id)
      queue = EdgeCases._wv_pin(self) do |_wv_self|
        ctx, pending = EdgeCases._wv_async_begin
        EdgeCases.edge_cases_edge_cases_Widget_fetch(_wv_self, id, EDGE_CASES_EDGE_CASES_WIDGET_FETCH_CALLBACK, ctx)
        pending
      end
      EdgeCases._wv_async_wait(queue)
    end

    # @return [String]
    # @deprecated Use rename instead
    def old_name
      warn('EdgeCases::Widget#old_name is deprecated: Use rename instead', uplevel: 1)
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        out_len = FFI::MemoryPointer.new(:size_t)
        result = EdgeCases.edge_cases_edge_cases_Widget_old_name(_wv_self, out_len, err)
        EdgeCases._wv_check!(err)
        EdgeCases._wv_take_string(result, out_len.read(:size_t))
      end
    end

    # Spelled like the release method of several wrappers
    # @return [Boolean]
    def close_
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        result = EdgeCases.edge_cases_edge_cases_Widget_close(_wv_self, err)
        EdgeCases._wv_check!(err)
        result
      end
    end

    # Spelled like the release method of the Dart and .NET wrappers
    def dispose(force)
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        EdgeCases.edge_cases_edge_cases_Widget_dispose(_wv_self, (force ? true : false), err)
        EdgeCases._wv_check!(err)
        nil
      end
    end
  end

  # @api private
  # Owns one strong reference to a Vault; releases it exactly once.
  class VaultPtr < FFI::AutoPointer
    def self.release(ptr)
      EdgeCases.edge_cases_edge_cases_Vault_destroy(ptr)
    end
  end

  # Deprecated interface with a throwing constructor
  # @deprecated Use Widget instead
  class Vault < WvObject
    WV_PTR = VaultPtr
    private_class_method :new

    # @api private
    def self._wv_clone(ptr)
      EdgeCases.edge_cases_edge_cases_Vault_clone(ptr)
    end

    # Fails when the vault is busy
    # @return [Vault]
    def self.open(path)
      path_s = EdgeCases._wv_str(path)
      err = ErrorStruct.new
      result = EdgeCases.edge_cases_edge_cases_Vault_open(path_s, path_s.bytesize, err)
      EdgeCases._wv_check_edge_errors_error!(err)
      _from_ptr(EdgeCases._wv_nonnull(result))
    end

    # @return [Widget, nil]
    def peek
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        result = EdgeCases.edge_cases_edge_cases_Vault_peek(_wv_self, err)
        EdgeCases._wv_check!(err)
        result.null? ? nil : Widget._from_ptr(result)
      end
    end

    # Spelled like the handle accessor of several wrappers
    # @return [Integer]
    def handle_
      EdgeCases._wv_pin(self) do |_wv_self|
        err = ErrorStruct.new
        result = EdgeCases.edge_cases_edge_cases_Vault_handle(_wv_self, err)
        EdgeCases._wv_check!(err)
        result
      end
    end

    # Throwing static
    # @return [Boolean]
    def self.probe
      err = ErrorStruct.new
      result = EdgeCases.edge_cases_edge_cases_Vault_probe(err)
      EdgeCases._wv_check_edge_errors_error!(err)
      result
    end

    # Static spelled like an inherited object member
    # @return [String]
    def self.to_string
      err = ErrorStruct.new
      out_len = FFI::MemoryPointer.new(:size_t)
      result = EdgeCases.edge_cases_edge_cases_Vault_to_string(out_len, err)
      EdgeCases._wv_check!(err)
      EdgeCases._wv_take_string(result, out_len.read(:size_t))
    end
  end

  # No parameters and no result
  def self.noop
    err = ErrorStruct.new
    edge_cases_edge_cases_noop(err)
    _wv_check!(err)
    nil
  end

  # Function named after a keyword whose parameters are all keywords
  # @return [Integer]
  def self.select(class_, from, func, range, type)
    from_s = _wv_str(from)
    func_s = _wv_encode { |w| _wv_write_list_string(w, func) }
    range_s = _wv_encode { |w| _wv_write_opt_i32(w, range) }
    err = ErrorStruct.new
    result = edge_cases_edge_cases_select(class_, from_s, from_s.bytesize, func_s, func_s.bytesize, range_s, range_s.bytesize, (type ? true : false), err)
    _wv_check!(err)
    result
  end

  # Optional list of optional structs, the deepest legal nesting
  # @return [Array<Outer, nil>, nil]
  def self.nested_optional(items = nil)
    items_s = _wv_encode { |w| _wv_write_opt_list_opt_outer(w, items) }
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = edge_cases_edge_cases_nested_optional(items_s, items_s.bytesize, out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_opt_list_opt_outer(r) }
  end

  # @return [Integer, nil]
  def self.optional_params(text = nil, count = nil, outer = nil, tags = nil, blob = nil, mode = nil)
    text_s = _wv_encode { |w| _wv_write_opt_string(w, text) }
    count_s = _wv_encode { |w| _wv_write_opt_i32(w, count) }
    outer_s = _wv_encode { |w| _wv_write_opt_outer(w, outer) }
    tags_s = _wv_encode { |w| _wv_write_opt_list_string(w, tags) }
    blob_s = _wv_encode { |w| _wv_write_opt_bytes(w, blob) }
    mode_s = _wv_encode { |w| _wv_write_opt_mode(w, mode) }
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = edge_cases_edge_cases_optional_params(text_s, text_s.bytesize, count_s, count_s.bytesize, outer_s, outer_s.bytesize, tags_s, tags_s.bytesize, blob_s, blob_s.bytesize, mode_s, mode_s.bytesize, out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_opt_mode(r) }
  end

  # Two callback interface parameters on one function
  def self.register_batch(listener, keyword)
    _wv_present!(listener, 'listener')
    _wv_present!(keyword, 'keyword')
    err = ErrorStruct.new
    listener_ctx, listener_vtable = _wv_cb_register(listener, WV_BATCH_LISTENER_VTABLE)
    keyword_ctx, keyword_vtable = _wv_cb_register(keyword, WV_KEYWORD_VTABLE)
    edge_cases_edge_cases_register_batch(listener_ctx, listener_vtable, keyword_ctx, keyword_vtable, err)
    _wv_check!(err)
    nil
  end

  # Objects in every buffered position
  # @return [WidgetHolder]
  def self.widgets_everywhere(list, by_name, sparse, holder)
    list_w = WvBufferWriter.new
    _wv_write_list_widget(list_w, list)
    by_name_w = WvBufferWriter.new
    _wv_write_map_string_widget(by_name_w, by_name)
    sparse_w = WvBufferWriter.new
    _wv_write_list_opt_widget(sparse_w, sparse)
    holder_w = WvBufferWriter.new
    _wv_write_widget_holder(holder_w, holder)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    list_s, by_name_s, sparse_s, holder_s = _wv_seal(list_w, by_name_w, sparse_w, holder_w)
    result = edge_cases_edge_cases_widgets_everywhere(list_s, list_s.bytesize, by_name_s, by_name_s.bytesize, sparse_s, sparse_s.bytesize, holder_s, holder_s.bytesize, out_len, err)
    _wv_check!(err)
    _wv_decode(result, out_len.read(:size_t)) { |r| _wv_read_widget_holder(r) }
  end

  # Iterator of objects
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
  # iteration finishes or is abandoned early.
  # @return [Enumerator<Widget>]
  def self.widget_stream
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = edge_cases_edge_cases_widget_stream(err)
      begin
        _wv_check!(err)
        out_item = FFI::MemoryPointer.new(:pointer)
        loop do
          has_item = edge_cases_edge_cases_WidgetStreamIterator_next(iter, out_item, err)
          _wv_check!(err)
          break if has_item.zero?
          item = out_item.read_pointer
          value = Widget._from_ptr(_wv_nonnull(item))
          y << value
        end
      ensure
        edge_cases_edge_cases_WidgetStreamIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Async returning an object
  # Blocks until the call completes on a producer thread.
  # @return [Widget]
  def self.async_widget
    ctx, queue = _wv_async_begin
    edge_cases_edge_cases_async_widget(EDGE_CASES_EDGE_CASES_ASYNC_WIDGET_CALLBACK, ctx)
    _wv_async_wait(queue)
  end

  # Factory for an interface with no constructor
  # @return [Widget]
  def self.make_widget(label)
    label_s = _wv_str(label)
    err = ErrorStruct.new
    result = edge_cases_edge_cases_make_widget(label_s, label_s.bytesize, err)
    _wv_check!(err)
    Widget._from_ptr(_wv_nonnull(result))
  end

  # Optional interface return
  # @return [Widget, nil]
  def self.find_widget(id)
    err = ErrorStruct.new
    result = edge_cases_edge_cases_find_widget(id, err)
    _wv_check_edge_errors_error!(err)
    result.null? ? nil : Widget._from_ptr(result)
  end

  # Interface parameter, including an optional one
  # @return [String]
  def self.inspect_widget(widget, fallback = nil)
    _wv_object!(widget, Widget, 'widget')
    _wv_object!(fallback, Widget, 'fallback', true)
    _wv_pin(widget, fallback) do |_wv_widget, _wv_fallback|
      err = ErrorStruct.new
      out_len = FFI::MemoryPointer.new(:size_t)
      result = edge_cases_edge_cases_inspect_widget(_wv_widget, _wv_fallback, out_len, err)
      _wv_check!(err)
      _wv_take_string(result, out_len.read(:size_t))
    end
  end

  # Iterator of strings
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
  # iteration finishes or is abandoned early.
  # @return [Enumerator<String>]
  def self.string_stream
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = edge_cases_edge_cases_string_stream(err)
      begin
        _wv_check!(err)
        out_item = FFI::MemoryPointer.new(:pointer)
        out_len = FFI::MemoryPointer.new(:size_t)
        loop do
          has_item = edge_cases_edge_cases_StringStreamIterator_next(iter, out_item, out_len, err)
          _wv_check!(err)
          break if has_item.zero?
          item = out_item.read_pointer
          value = _wv_take_string(item, out_len.read(:size_t))
          y << value
        end
      ensure
        edge_cases_edge_cases_StringStreamIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Iterator of scalars
  # Returns a lazy Enumerator that pulls one element per step. The
  # producer iterator starts on the first pull and is released when
