    return _result;
  } finally {
    _f.release();
  }
}

final _kitchenSinkHello = _lib.lookupFunction<
    _Run Function(Pointer<_Error>),
    _Run Function(Pointer<_Error>)>('kitchen_sink_hello');

/// A trivial function returning a string
String hello() {
  final _f = _Frame.take();
  try {
    final _result = _kitchenSinkHello(_f.err);
    _f.check();
    return _takeText(_result);
  } finally {
    _f.release();
  }
}

