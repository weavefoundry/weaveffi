/// The `KitchenErrors` error domain.
///
/// Every case carries the message the library reported (the code's
/// documented message when it sent none) and the code's fields.
public enum KitchenError: Error, LocalizedError, Hashable, Sendable {
    case notFound(message: String)
    case invalidInput(message: String)
    /// A code these bindings don't declare, from a newer library.
    case unknown(code: Int32, message: String)

    /// The numeric code the library reported.
    public var errorCode: Int32 {
        switch self {
        case .notFound: return 1
        case .invalidInput: return 2
        case let .unknown(code, _): return code
        }
    }

    /// The message the library reported, or the code's documented message.
    public var message: String {
        switch self {
        case let .notFound(message): return message
        case let .invalidInput(message): return message
        case let .unknown(_, message): return message
        }
    }

    public var errorDescription: String? { message }
}

extension KitchenError: WvDomain {
    init(wvError err: WvError) {
        let message = wvErrorMessage(err)
        switch err.code {
        case 1:
            self = .notFound(message: message.isEmpty ? "Item not found" : message)
        case 2:
            self = .invalidInput(message: message.isEmpty ? "Invalid input" : message)
        default:
            self = .unknown(code: err.code, message: message)
        }
    }

    func wvReport(_ outErr: UnsafeMutablePointer<WvError>?) {
        switch self {
        case let .notFound(message):
            wvSetError(outErr, 1, message)
        case let .invalidInput(message):
            wvSetError(outErr, 2, message)
        case let .unknown(code, message):
            wvSetError(outErr, code, message)
        }
    }
}

