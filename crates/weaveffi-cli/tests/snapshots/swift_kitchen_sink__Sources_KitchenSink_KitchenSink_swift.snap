        wvLoad()
        let token = WvCancelToken()
        return try await withTaskCancellationHandler {
            try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<[Float], Error>) in
                let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
                kitchen_sink_kitchen_async_samples(n, token.raw, { context, err, result_ptr, result_len in
                    let cont = Unmanaged<WvContinuation<[Float], Error>>.fromOpaque(context!).takeRetainedValue().value
                    if let err = err {
                        cont.resume(throwing: wvTakeCancellation(err))
                        return
                    }
                    cont.resume(returning: wvTakeSlice(result_ptr, result_len))
                }, context)
            }
        } onCancel: {
            token.cancel()
        }
    }

