/// Drive a consumer-implemented sampler
///
/// - Throws: ``PantryError`` for a declared failure,
///   ``KitchenSinkRuntimeError`` otherwise.
public func sampleWith(sampler: any Sampler, level: UInt32?) throws -> [Int16] {
    wvLoad()
    var err = WvError()
    let sampler_cb = kitchen_sink_Sampler(ctx: wvRetain(sampler), vtable: WvSamplerVtable.shared.pointer)
    let rv = kitchen_sink_sample_with(sampler_cb, kitchen_sink_opt_u32(wv: level), &err)
    try wvCheck(&err, PantryError.self)
    return wvTakeSlice(rv, as: Int16.self)
}

