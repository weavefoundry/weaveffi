    /// Every slice element type
    public static func mixedSlices(a: [Int8], b: [Int16], c: [UInt16], d: [UInt32], e: [Int64], f: [Float]) -> [UInt32] {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv: UnsafeMutablePointer<UInt32>? = wvWithSlice(a) { a_ptr, a_len in
            wvWithSlice(b) { b_ptr, b_len in
                wvWithSlice(c) { c_ptr, c_len in
                    wvWithSlice(d) { d_ptr, d_len in
                        wvWithSlice(e) { e_ptr, e_len in
                            wvWithSlice(f) { f_ptr, f_len in
                                kitchen_sink_kitchen_mixed_slices(a_ptr, a_len, b_ptr, b_len, c_ptr, c_len, d_ptr, d_len, e_ptr, e_len, f_ptr, f_len, &outLen, &err)
                            }
                        }
                    }
                }
            }
        }
        wvTrap(&err)
        return wvTakeSlice(rv, outLen)
    }

