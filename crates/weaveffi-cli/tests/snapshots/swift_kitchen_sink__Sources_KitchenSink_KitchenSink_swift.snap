    return NativeSequence(wvNonNull(rv), release: { kitchen_sink_StreamMaybeIterator_destroy($0) }, failure: { wvFatal($0) }) { handle, err in
        var item: kitchen_sink_opt_i32 = kitchen_sink_opt_i32()
        guard kitchen_sink_StreamMaybeIterator_next(handle, &item, err) != 0 else { return nil }
        return .some(item.wvValue)
    }
}

