}

public enum Kitchen {
    /// Identity for bool
    public static func boolId(x: Bool) -> Bool {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_bool_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func i32Id(x: Int32) -> Int32 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_i32_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func u32Id(x: UInt32) -> UInt32 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_u32_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func i64Id(x: Int64) -> Int64 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_i64_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func f64Id(x: Double) -> Double {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_f64_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func echoString(s: String) -> String {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv: UnsafePointer<UInt8>? = wvWithUTF8(s) { s_ptr, s_len in
            kitchen_sink_kitchen_echo_string(s_ptr, s_len, &outLen, &err)
        }
        wvTrap(&err)
        return wvTakeString(rv, outLen)
    }

    public static func echoBytes(b: Data) -> Data {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv: UnsafePointer<UInt8>? = wvWithBytes(b) { b_ptr, b_len in
            kitchen_sink_kitchen_echo_bytes(b_ptr, b_len, &outLen, &err)
        }
        wvTrap(&err)
        return wvTakeBytes(rv, outLen)
    }

    /// Register a listener, returning how many are attached
    public static func subscribe(listener: ReadyListener) -> Int32 {
        wvLoad()
        var err = WvError()
        let listener_ctx = Unmanaged.passRetained(WvReadyListenerBox(listener)).toOpaque()
        let rv = kitchen_sink_kitchen_subscribe(listener_ctx, WvReadyListenerVtable.shared.pointer, &err)
        wvTrap(&err)
        return rv
    }

    /// Optional object in both directions
    public static func maybeGadget(fallback: Gadget?) -> Gadget? {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_maybe_gadget(fallback?.ptr, &err)
        wvTrap(&err)
        return rv.map { Gadget(ptr: $0) }
    }

    /// A list of objects
    public static func gadgets() -> [Gadget] {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_gadgets(&outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen) { (r: inout WvReader) -> [Gadget] in
            let n1 = r.readCount()
            var v0: [Gadget] = []
            v0.reserveCapacity(min(n1, r.remaining))
            for _ in 0..<n1 {
                let v2 = Gadget(ptr: r.readObject())
                v0.append(v2)
            }
            return v0
        }
    }

    /// An iterator over objects
    /// - Returns: A lazy sequence that pulls one element per step from the
    ///   library; the underlying iterator is destroyed when the sequence is
    ///   exhausted or deinitialized.
    public static func streamGadgets() -> KitchenStreamGadgetsIterator {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_stream_gadgets(&err)
        wvTrap(&err)
        return KitchenStreamGadgetsIterator(handle: wvNonNull(rv))
    }

    /// Optional struct return
    public static func maybeItem(id: Int64) throws -> Item? {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_maybe_item(id, &outLen, &err)
        try checkKitchen(&err)
        return wvTakeBuffer(rv, outLen) { (r: inout WvReader) -> Item? in
            var v0: Item? = nil
            if r.readOptionFlag() {
                let v1 = wvReadItem(&r)
                v0 = v1
            }
            return v0
        }
    }

    /// List of structs
    public static func listItems() -> [Item] {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_list_items(&outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen) { (r: inout WvReader) -> [Item] in
            let n1 = r.readCount()
            var v0: [Item] = []
            v0.reserveCapacity(min(n1, r.remaining))
            for _ in 0..<n1 {
                let v2 = wvReadItem(&r)
                v0.append(v2)
            }
            return v0
        }
    }

    /// Map return type
    public static func getAttrs() -> [String: Int32] {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_get_attrs(&outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen) { (r: inout WvReader) -> [String: Int32] in
            let n1 = r.readCount()
            var v0: [String: Int32] = [:]
            v0.reserveCapacity(min(n1, r.remaining))
            for _ in 0..<n1 {
                let v2 = r.readString()
                let v3 = r.readI32()
                v0[v2] = v3
            }
            return v0
        }
    }

    /// Iterator return type
    /// - Returns: A lazy sequence that pulls one element per step from the
    ///   library; the underlying iterator is destroyed when the sequence is
    ///   exhausted or deinitialized.
    public static func streamItems() -> KitchenStreamItemsIterator {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_stream_items(&err)
        wvTrap(&err)
        return KitchenStreamItemsIterator(handle: wvNonNull(rv))
    }

    /// Returns the shared Token type from another module
    public static func crossModuleToken() -> Token {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_cross_module_token(&outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen, wvReadToken)
    }

    /// Async operation
    public static func doAsync(input: String) async -> String {
        wvLoad()
        return await withCheckedContinuation { (continuation: CheckedContinuation<String, Never>) in
            let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
            wvWithUTF8(input) { input_ptr, input_len in
                kitchen_sink_kitchen_do_async(input_ptr, input_len, { context, err, resultPtr, resultLen in
                    let cont = Unmanaged<WvContinuation<String, Never>>.fromOpaque(context!).takeRetainedValue().value
                    if let err = err {
                        wvTrapBoxed(err)
                    }
                    cont.resume(returning: wvTakeString(resultPtr, resultLen))
                }, context)
            }
        }
    }

    /// Cancellable async operation
    /// - Throws: `CancellationError` when the calling task is cancelled, which
    ///   also cancels the native call.
    public static func doCancellable(input: String) async throws -> String {
        wvLoad()
        let token = WvCancelToken()
        return try await withTaskCancellationHandler {
            try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<String, Error>) in
                let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
                wvWithUTF8(input) { input_ptr, input_len in
                    kitchen_sink_kitchen_do_cancellable(input_ptr, input_len, token.raw, { context, err, resultPtr, resultLen in
                        let cont = Unmanaged<WvContinuation<String, Error>>.fromOpaque(context!).takeRetainedValue().value
                        if let err = err {
                            cont.resume(throwing: wvTakeError(err, wvCancelledOrTrap))
                            return
                        }
                        cont.resume(returning: wvTakeString(resultPtr, resultLen))
                    }, context)
                }
            }
        } onCancel: {
            token.cancel()
        }
    }

    /// Legacy operation kept for compatibility
    @available(*, deprecated, message: "Use new_op instead")
    public static func legacyOp() -> Int32 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_legacy_op(&err)
        wvTrap(&err)
        return rv
    }

    /// Replacement for legacy_op
    public static func newOp() -> Int32 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_new_op(&err)
        wvTrap(&err)
        return rv
    }

