// MARK: - API

/// A reusable token referenced across modules
public struct Token: Hashable, Sendable {
    public var id: Int64
    public var label: String

    /// Creates a value from its fields.
    public init(id: Int64, label: String) {
        self.id = id
        self.label = label
    }
}

extension Token: WvCodable {
    static func wvRead(_ r: inout WvReader) -> Token {
        Token(id: r.read(), label: r.read())
    }

    func wvWrite(_ w: inout WvWriter) {
        w.write(self.id)
        w.write(self.label)
    }
}

/// Typed errors reported by the `kitchen` module.
public enum KitchenErrorsError: Error, LocalizedError, Sendable {
    case notFound(message: String)
    case invalidInput(message: String)

    /// The message the library reported, or the code's documented default.
    public var errorDescription: String? {
        switch self {
        case let .notFound(message): return message
        case let .invalidInput(message): return message
        }
    }

    /// The numeric ABI code carried by this error.
    public var errorCode: Int32 {
        switch self {
        case .notFound: return 1
        case .invalidInput: return 2
        }
    }
}

func wvMapKitchen(_ err: WvError) -> Error {
    let message = wvErrorMessage(err)
    switch err.code {
    case 1: return KitchenErrorsError.notFound(message: message.isEmpty ? "Item not found" : message)
    case 2: return KitchenErrorsError.invalidInput(message: message.isEmpty ? "Invalid input" : message)
    default: return wvRuntimeError(err)
    }
}

func wvCheckKitchen(_ err: inout WvError) throws {
    guard err.code != 0 else { return }
    let error = wvMapKitchen(err)
    kitchen_sink_error_clear(&err)
    throw error
}

/// Reports a ``KitchenErrorsError`` thrown by a callback method declared to throw it: its
/// code, its message, and its fields as the payload. Any other error is left
/// to the caller, which reports a callback failure.
func wvReportKitchen(_ error: Error, _ outErr: UnsafeMutablePointer<WvError>?) -> Bool {
    guard let error = error as? KitchenErrorsError else { return false }
    switch error {
    case let .notFound(message):
        wvSetError(outErr, 1, message)
    case let .invalidInput(message):
        wvSetError(outErr, 2, message)
    }
    return true
}

/// Task priority levels
public enum Priority: Int32, Sendable {
    /// Low priority
    case low = 0
    /// Normal priority
    case normal = 1
    /// High priority
    case high = 2
}

extension Priority: WvCEnum {}

/// Kitchen sink struct exercising every field feature
public struct Item: Sendable {
    /// Stable identifier
    public var id: Int64
    /// Display name
    public var name: String
    /// Initial count
    public var count: Int32
    /// Whether the item is enabled
    public var enabled: Bool
    /// Scaling ratio
    public var ratio: Double
    public var nick: UInt32
    public var payload: Data
    public var tags: [String]
    public var attrs: [String: String]
    public var parent: Int64?
    /// Cross-module struct reference
    public var token: Token
    public var priority: Priority
    /// An optional object inside a record
    public var gadget: Gadget?

    /// Creates a value from its fields.
    public init(id: Int64, name: String, count: Int32, enabled: Bool, ratio: Double, nick: UInt32, payload: Data, tags: [String], attrs: [String: String], parent: Int64?, token: Token, priority: Priority, gadget: Gadget?) {
        self.id = id
        self.name = name
        self.count = count
        self.enabled = enabled
        self.ratio = ratio
        self.nick = nick
        self.payload = payload
        self.tags = tags
        self.attrs = attrs
        self.parent = parent
        self.token = token
        self.priority = priority
        self.gadget = gadget
    }
}

extension Item: WvCodable {
    static func wvRead(_ r: inout WvReader) -> Item {
        Item(id: r.read(), name: r.read(), count: r.read(), enabled: r.read(), ratio: r.read(), nick: r.read(), payload: r.read(), tags: r.read(), attrs: r.read(), parent: r.read(), token: r.read(), priority: r.read(), gadget: r.read())
    }

    func wvWrite(_ w: inout WvWriter) {
        w.write(self.id)
        w.write(self.name)
        w.write(self.count)
        w.write(self.enabled)
        w.write(self.ratio)
        w.write(self.nick)
        w.write(self.payload)
        w.write(self.tags)
        w.write(self.attrs)
        w.write(self.parent)
        w.write(self.token)
        w.write(self.priority)
        w.write(self.gadget)
    }
}

/// Consumer-implemented observer of ready items
///
/// Implement this protocol with a class and pass an instance where the API
/// expects it. The library keeps the instance until it no longer needs it and
/// may call any method from any thread. A method that throws fails the
/// library's call in progress: a method documented to throw a module error
/// reports that error, with its code and fields, and any other error reaches
/// the library as a callback failure (code -4).
public protocol ReadyListener: AnyObject, Sendable {
    /// Fires when an item is ready
    func onReady(code: Int32, msg: String) throws

    /// Receives the item itself and says whether to keep listening
    func onItem(item: Item, gadget: Gadget) throws -> Bool

    /// A display label, failing with a kitchen error
    ///
    /// - Throws: ``KitchenErrorsError`` to report a declared failure with its fields, or any other error to fail the call.
    func label() throws -> String

    /// The most recent item the listener kept, if any
    func latest() throws -> Item?

    /// The listener's favorite gadget
    func favorite() throws -> Gadget
}

/// The process-wide vtable the library calls `ReadyListener` implementations
/// through (`kitchen_sink_kitchen_ReadyListener_vtable`). Every entry recovers the implementation
/// from `ctx`, copies or adopts its arguments, hands its result back, and
/// reports a thrown error through `out_err` instead of unwinding.
enum WvReadyListenerVtable {
    static let shared = WvVtable(kitchen_sink_kitchen_ReadyListener_vtable(
        size: UInt32(MemoryLayout<kitchen_sink_kitchen_ReadyListener_vtable>.stride),
        flags: 0,
        free: { ctx in
            wvRelease(ctx, as: (any ReadyListener).self)
        },
        on_ready: { ctx, code, msg_ptr, msg_len, out_err in
            wvInvoke(ctx, out_err, as: (any ReadyListener).self, fallback: ()) { wvImpl in
                try wvImpl.onReady(code: code, msg: wvBorrowString(msg_ptr, msg_len))
            }
        },
        on_item: { ctx, item_ptr, item_len, gadget, out_err in
            wvInvoke(ctx, out_err, as: (any ReadyListener).self, fallback: false) { wvImpl in
                try wvImpl.onItem(item: wvBorrowBuffer(item_ptr, item_len, as: Item.self), gadget: Gadget(ptr: wvNonNull(gadget)))
            }
        },
        label: { ctx, out_ptr, out_len, out_err in
            wvInvoke(ctx, out_err, as: (any ReadyListener).self, fallback: (), domain: wvReportKitchen) { wvImpl in
                try wvReturnString(wvImpl.label(), out_ptr, out_len)
            }
        },
        latest: { ctx, out_ptr, out_len, out_err in
            wvInvoke(ctx, out_err, as: (any ReadyListener).self, fallback: ()) { wvImpl in
                try wvReturnBuffer(wvImpl.latest(), out_ptr, out_len)
            }
        },
        favorite: { ctx, out_err in
            wvInvoke(ctx, out_err, as: (any ReadyListener).self, fallback: nil) { wvImpl in
                try wvImpl.favorite().clonePtr()
            }
        }
    ))
}

/// A pocket-sized interface exercising the object surface
public final class Gadget: @unchecked Sendable {
    let ptr: OpaquePointer

    init(ptr: OpaquePointer) {
        self.ptr = ptr
    }

    deinit {
        kitchen_sink_kitchen_Gadget_destroy(ptr)
    }

    /// Returns a new strong reference to the same object, for a position that
    /// takes ownership of it.
    func clonePtr() -> OpaquePointer {
        wvNonNull(kitchen_sink_kitchen_Gadget_clone(ptr))
    }

    /// Create a gadget with the given id
    public init(id: Int64) {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_Gadget_new(id, &err)
        wvTrap(&err)
        self.ptr = wvNonNull(rv)
    }

    /// Render the gadget as a human-readable string
    public func describe() -> String {
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_Gadget_describe(ptr, &outLen, &err)
        wvTrap(&err)
        return wvTakeString(rv, outLen)
    }

    /// Poke the gadget a number of times, failing on a negative count
    ///
    /// - Throws: ``KitchenErrorsError`` for a declared failure, ``KitchenSinkRuntimeError`` otherwise.
    public func poke(times: Int32) throws -> Int32 {
        var err = WvError()
        let rv = kitchen_sink_kitchen_Gadget_poke(ptr, times, &err)
        try wvCheckKitchen(&err)
        return rv
    }

    /// The gadget subsystem version string
    public static func version() -> String {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_Gadget_version(&outLen, &err)
        wvTrap(&err)
        return wvTakeString(rv, outLen)
    }
}

extension Gadget: WvCodable {
    static func wvRead(_ r: inout WvReader) -> Gadget { Gadget(ptr: r.readObject()) }
    func wvWrite(_ w: inout WvWriter) { w.writeObject(clonePtr()) }
}

/// A lazy sequence over the `Gadget` elements streamed by `kitchen_sink_kitchen_stream_gadgets`.
///
/// Each `next()` call pulls exactly one element from the library. The
/// underlying iterator is destroyed eagerly on exhaustion and from `deinit`
/// when iteration is abandoned early.
public final class KitchenStreamGadgetsIterator: Sequence, IteratorProtocol {
    private var handle: OpaquePointer?

    init(handle: OpaquePointer) {
        self.handle = handle
    }

    deinit {
        destroyHandle()
    }

    private func destroyHandle() {
        guard let handle = handle else { return }
        kitchen_sink_kitchen_StreamGadgetsIterator_destroy(handle)
        self.handle = nil
    }

    /// Pulls the next element from the library, or returns `nil` once the
    /// stream is exhausted (destroying the underlying iterator).
    public func next() -> Gadget? {
        guard let handle = handle else { return nil }
        var item: OpaquePointer? = nil
        var err = WvError()
        if kitchen_sink_kitchen_StreamGadgetsIterator_next(handle, &item, &err) == 0 {
            wvTrap(&err)
            destroyHandle()
            return nil
        }
        return Gadget(ptr: wvNonNull(item))
    }
}

/// A lazy sequence over the `Item` elements streamed by `kitchen_sink_kitchen_stream_items`.
///
/// Each `next()` call pulls exactly one element from the library. The
/// underlying iterator is destroyed eagerly on exhaustion and from `deinit`
/// when iteration is abandoned early.
public final class KitchenStreamItemsIterator: Sequence, IteratorProtocol {
    private var handle: OpaquePointer?

    init(handle: OpaquePointer) {
        self.handle = handle
    }

    deinit {
        destroyHandle()
    }

    private func destroyHandle() {
        guard let handle = handle else { return }
        kitchen_sink_kitchen_StreamItemsIterator_destroy(handle)
        self.handle = nil
    }

    /// Pulls the next element from the library, or returns `nil` once the
    /// stream is exhausted (destroying the underlying iterator).
    public func next() -> Item? {
        guard let handle = handle else { return nil }
        var item: UnsafePointer<UInt8>? = nil
        var itemLen = 0
        var err = WvError()
        if kitchen_sink_kitchen_StreamItemsIterator_next(handle, &item, &itemLen, &err) == 0 {
            wvTrap(&err)
            destroyHandle()
            return nil
        }
        return wvTakeBuffer(item, itemLen, as: Item.self)
    }
}

public enum Shared {
    /// Trivial cross-module helper
    public static func ping() -> String {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_shared_ping(&outLen, &err)
        wvTrap(&err)
        return wvTakeString(rv, outLen)
    }
}

public enum Kitchen {
    /// Identity for bool
    public static func boolId(x: Bool) -> Bool {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_bool_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func i32Id(x: Int32) -> Int32 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_i32_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func u32Id(x: UInt32) -> UInt32 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_u32_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func i64Id(x: Int64) -> Int64 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_i64_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func f64Id(x: Double) -> Double {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_f64_id(x, &err)
        wvTrap(&err)
        return rv
    }

    public static func echoString(s: String) -> String {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv: UnsafePointer<UInt8>? = wvWithUTF8(s) { s_ptr, s_len in
            kitchen_sink_kitchen_echo_string(s_ptr, s_len, &outLen, &err)
        }
        wvTrap(&err)
        return wvTakeString(rv, outLen)
    }

    public static func echoBytes(b: Data) -> Data {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv: UnsafePointer<UInt8>? = wvWithBytes(b) { b_ptr, b_len in
            kitchen_sink_kitchen_echo_bytes(b_ptr, b_len, &outLen, &err)
        }
        wvTrap(&err)
        return wvTakeBytes(rv, outLen)
    }

    /// Register a listener, returning how many are attached
    public static func subscribe(listener: any ReadyListener) -> Int32 {
        wvLoad()
        var err = WvError()
        let listener_ctx = wvRetain(listener)
        let rv = kitchen_sink_kitchen_subscribe(listener_ctx, WvReadyListenerVtable.shared.pointer, &err)
        wvTrap(&err)
        return rv
    }

    /// Register a listener if one is given
    public static func maybeSubscribe(listener: (any ReadyListener)?) -> Bool {
        wvLoad()
        var err = WvError()
        let listener_ctx = listener.map { wvRetain($0) }
        let rv = kitchen_sink_kitchen_maybe_subscribe(listener_ctx, listener == nil ? nil : WvReadyListenerVtable.shared.pointer, &err)
        wvTrap(&err)
        return rv
    }

    /// Optional object in both directions
    public static func maybeGadget(fallback: Gadget?) -> Gadget? {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_maybe_gadget(fallback?.ptr, &err)
        wvTrap(&err)
        return rv.map { Gadget(ptr: $0) }
    }

    /// A list of objects
    public static func gadgets() -> [Gadget] {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_gadgets(&outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen, as: [Gadget].self)
    }

    /// An iterator over objects
    ///
    /// - Returns: A lazy sequence that pulls one element per step from the library.
    public static func streamGadgets() -> KitchenStreamGadgetsIterator {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_stream_gadgets(&err)
        wvTrap(&err)
        return KitchenStreamGadgetsIterator(handle: wvNonNull(rv))
    }

    /// Optional struct return
    ///
    /// - Throws: ``KitchenErrorsError`` for a declared failure, ``KitchenSinkRuntimeError`` otherwise.
    public static func maybeItem(id: Int64) throws -> Item? {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_maybe_item(id, &outLen, &err)
        try wvCheckKitchen(&err)
        return wvTakeBuffer(rv, outLen, as: Item?.self)
    }

    /// List of structs
    public static func listItems() -> [Item] {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_list_items(&outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen, as: [Item].self)
    }

    /// Map return type
    public static func getAttrs() -> [String: Int32] {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_get_attrs(&outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen, as: [String: Int32].self)
    }

    /// Iterator return type
    ///
    /// - Returns: A lazy sequence that pulls one element per step from the library.
    public static func streamItems() -> KitchenStreamItemsIterator {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_stream_items(&err)
        wvTrap(&err)
        return KitchenStreamItemsIterator(handle: wvNonNull(rv))
    }

    /// Returns the shared Token type from another module
    public static func crossModuleToken() -> Token {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = kitchen_sink_kitchen_cross_module_token(&outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen, as: Token.self)
    }

    /// Async operation
    public static func doAsync(input: String) async -> String {
        wvLoad()
        return await withCheckedContinuation { (continuation: CheckedContinuation<String, Never>) in
            let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
            wvWithUTF8(input) { input_ptr, input_len in
                kitchen_sink_kitchen_do_async(input_ptr, input_len, { context, err, resultPtr, resultLen in
                    let cont = Unmanaged<WvContinuation<String, Never>>.fromOpaque(context!).takeRetainedValue().value
                    if let err = err {
                        wvTrapBoxed(err)
                    }
                    cont.resume(returning: wvTakeString(resultPtr, resultLen))
                }, context)
            }
        }
    }

    /// Cancellable async operation
    ///
    /// - Throws: `CancellationError` when the calling task is cancelled, which cancels the native call.
    public static func doCancellable(input: String) async throws -> String {
        wvLoad()
        let token = WvCancelToken()
        return try await withTaskCancellationHandler {
            try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<String, Error>) in
                let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
                wvWithUTF8(input) { input_ptr, input_len in
                    kitchen_sink_kitchen_do_cancellable(input_ptr, input_len, token.raw, { context, err, resultPtr, resultLen in
                        let cont = Unmanaged<WvContinuation<String, Error>>.fromOpaque(context!).takeRetainedValue().value
                        if let err = err {
                            cont.resume(throwing: wvTakeError(err, wvCancelledOrTrap))
                            return
                        }
                        cont.resume(returning: wvTakeString(resultPtr, resultLen))
                    }, context)
                }
            }
        } onCancel: {
            token.cancel()
        }
    }

    /// Legacy operation kept for compatibility
    @available(*, deprecated, message: "Use new_op instead")
    public static func legacyOp() -> Int32 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_legacy_op(&err)
        wvTrap(&err)
        return rv
    }

    /// Replacement for legacy_op
    public static func newOp() -> Int32 {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_kitchen_new_op(&err)
        wvTrap(&err)
        return rv
    }

    public enum Nested {
        /// Trivial nested-module function
        public static func hello() -> String {
            wvLoad()
            var err = WvError()
            var outLen = 0
            let rv = kitchen_sink_kitchen_nested_hello(&outLen, &err)
            wvTrap(&err)
            return wvTakeString(rv, outLen)
        }
    }
}

