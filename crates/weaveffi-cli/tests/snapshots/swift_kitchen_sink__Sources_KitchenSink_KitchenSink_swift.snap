/// Consumer-implemented observer of ready items
///
/// Implement this protocol with a class and pass an instance where the API
/// expects it. The library keeps the instance until it no longer needs it and
/// may call any method from any thread.
public protocol ReadyListener: AnyObject, Sendable {
    /// Fires when an item is ready
    func onReady(code: Int32, msg: String)

    /// Receives the item itself and says whether to keep listening
    func onItem(item: Item, gadget: Gadget) -> Bool

    /// A display label, failing with a kitchen error
    ///
    /// - Throws: ``KitchenError`` to fail the library's call with that error and
    ///   its fields; any other error fails it with the error's description.
    func label() throws -> String

    /// The most recent item the listener kept, if any
    func latest() -> Item?

    /// The listener's favorite gadget
    func favorite() -> Gadget
}

/// The process-wide vtable the library calls `ReadyListener` implementations
/// through (a `kitchen_sink_ReadyListener_vtable`). Every entry recovers the
/// implementation from `ctx`, copies or adopts its arguments, hands its result
/// back, and reports a thrown error through `out_err` instead of unwinding.
enum WvReadyListenerVtable {
    static let shared = WvVtable(kitchen_sink_ReadyListener_vtable(
        size: UInt32(MemoryLayout<kitchen_sink_ReadyListener_vtable>.size),
        flags: 0,
        free: { ctx in wvRelease(ctx, as: (any ReadyListener).self) },
        on_ready: { ctx, a0, a1, outErr in
            wvInvoke(ctx, outErr, as: (any ReadyListener).self, fallback: ()) { wvImpl in
                wvImpl.onReady(code: a0, msg: wvBorrowString(a1))
            }
        },
        on_item: { ctx, a0, a1, outErr in
            wvInvoke(ctx, outErr, as: (any ReadyListener).self, fallback: false) { wvImpl in
                wvImpl.onItem(item: wvBorrowBuffer(a0, as: Item.self), gadget: Gadget(ptr: wvNonNull(a1)))
            }
        },
        label: { ctx, outErr in
            wvInvoke(ctx, outErr, as: (any ReadyListener).self, throwing: KitchenError.self, fallback: WvRun()) { wvImpl in
                try wvHandOverString(wvImpl.label())
            }
        },
        latest: { ctx, outErr in
            wvInvoke(ctx, outErr, as: (any ReadyListener).self, fallback: WvRun()) { wvImpl in
                wvHandOverBuffer(wvImpl.latest())
            }
        },
        favorite: { ctx, outErr in
            wvInvoke(ctx, outErr, as: (any ReadyListener).self, fallback: nil) { wvImpl in
                wvImpl.favorite().clonePtr()
            }
        }
    ))
}

/// Consumer-implemented source of scalar samples
///
/// Implement this protocol with a class and pass an instance where the API
/// expects it. The library keeps the instance until it no longer needs it and
/// may call any method from any thread.
public protocol Sampler: AnyObject, Sendable {
    /// The cutoff for a level, if the sampler has one
    func threshold(level: UInt32?) -> Double?

    /// Up to `limit` samples, failing when the pantry is empty
    ///
    /// - Throws: ``PantryError`` to fail the library's call with that error and
    ///   its fields; any other error fails it with the error's description.
    func samples(limit: UInt32?, weights: [Double]) throws -> [Int16]

    /// A free-form description, failing with an untyped error
    ///
    /// - Throws: Any error, which fails the library's call with the error's
    ///   description.
    func describe() throws -> String
}

