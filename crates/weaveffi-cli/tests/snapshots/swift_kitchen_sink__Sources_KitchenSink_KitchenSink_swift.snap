/// A pocket-sized interface exercising the object surface
public final class Gadget: WvObject, Hashable, @unchecked Sendable {
    let ptr: OpaquePointer

    init(ptr: OpaquePointer) {
        self.ptr = ptr
    }

    deinit {
        kitchen_sink_Gadget_destroy(ptr)
    }

    func clonePtr() -> OpaquePointer {
        wvNonNull(kitchen_sink_Gadget_clone(ptr))
    }

    /// Whether two wrappers hold the same native object.
    public static func == (lhs: Gadget, rhs: Gadget) -> Bool {
        lhs.ptr == rhs.ptr
    }

    public func hash(into hasher: inout Hasher) {
        hasher.combine(ptr)
    }

    /// Create a gadget with the given id
    public init(id: Int64) {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_Gadget_new(id, &err)
        wvTrap(&err)
        self.ptr = wvNonNull(rv)
    }

    /// Render the gadget as a human-readable string
    public func describe() -> String {
        var err = WvError()
        let rv = kitchen_sink_Gadget_describe(self.ptr, &err)
        wvTrap(&err)
        return wvTakeString(rv)
    }

    /// Poke the gadget a number of times, failing on a negative count
    ///
    /// - Throws: ``KitchenError`` for a declared failure,
    ///   ``KitchenSinkRuntimeError`` otherwise.
    public func poke(times: Int32) throws -> Int32 {
        var err = WvError()
        let rv = kitchen_sink_Gadget_poke(self.ptr, times, &err)
        try wvCheck(&err, KitchenError.self)
        return rv
    }

    /// The gadget's sensor readings, optionally limited
    ///
    /// - Throws: ``KitchenSinkRuntimeError`` with the library's message.
    public func readings(limit: UInt32?) throws -> [Double] {
        var err = WvError()
        let rv = kitchen_sink_Gadget_readings(self.ptr, kitchen_sink_opt_u32(wv: limit), &err)
        try wvCheck(&err)
        return wvTakeSlice(rv, as: Double.self)
    }

    /// The gadget subsystem version string
    public static func version() -> String {
        wvLoad()
        var err = WvError()
        let rv = kitchen_sink_Gadget_version(&err)
        wvTrap(&err)
        return wvTakeString(rv)
    }
}

