/// Returns the shared Token record
public func makeToken() -> Token {
    wvLoad()
    var err = WvError()
    let rv = kitchen_sink_make_token(&err)
    wvTrap(&err)
    return wvTakeBuffer(rv, as: Token.self)
}

/// Async operation
public func doAsync(input: String) async -> String {
    wvLoad()
    return await withCheckedContinuation { (continuation: CheckedContinuation<String, Never>) in
        let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
        wvWithUTF8(input) { input_run in
            kitchen_sink_do_async(input_run, { context, err, result in
                let cont = Unmanaged<WvContinuation<String, Never>>.fromOpaque(context!).takeRetainedValue().value
                if let err = err {
                    wvFatal(err.pointee)
                }
                cont.resume(returning: wvTakeString(result))
            }, context)
        }
    }
}

/// Cancellable async operation
///
/// - Throws: `CancellationError` when the calling task is cancelled, which
///   cancels the native call.
public func doCancellable(input: String) async throws -> String {
    wvLoad()
    let token = WvCancelToken()
    return try await withTaskCancellationHandler {
        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<String, Error>) in
            let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
            wvWithUTF8(input) { input_run in
                kitchen_sink_do_cancellable(input_run, token.raw, { context, err, result in
                    let cont = Unmanaged<WvContinuation<String, Error>>.fromOpaque(context!).takeRetainedValue().value
                    if let err = err {
                        cont.resume(throwing: wvTakeCancellation(err))
                        return
                    }
                    cont.resume(returning: wvTakeString(result))
                }, context)
            }
        }
    } onCancel: {
        token.cancel()
    }
}

