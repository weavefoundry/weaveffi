    let rv = kitchen_sink_stream_gadgets(&err)
    wvTrap(&err)
    return NativeSequence(wvNonNull(rv), release: { kitchen_sink_StreamGadgetsIterator_destroy($0) }, failure: { wvFatal($0) }) { handle, err in
        var item: OpaquePointer? = nil
        guard kitchen_sink_StreamGadgetsIterator_next(handle, &item, err) != 0 else { return nil }
        return Gadget(ptr: wvNonNull(item))
    }
}

