/// Every slice element type
public func mixedSlices(a: [Int8], b: [Int16], c: [UInt16], d: [UInt32], e: [Int64], f: [Float]) -> [UInt32] {
    wvLoad()
    var err = WvError()
    let rv: WvRun = wvWithSlice(a) { a_run in
        wvWithSlice(b) { b_run in
            wvWithSlice(c) { c_run in
                wvWithSlice(d) { d_run in
                    wvWithSlice(e) { e_run in
                        wvWithSlice(f) { f_run in
                            kitchen_sink_mixed_slices(a_run, b_run, c_run, d_run, e_run, f_run, &err)
                        }
                    }
                }
            }
        }
    }
    wvTrap(&err)
    return wvTakeSlice(rv, as: UInt32.self)
}

/// Async returning an optional scalar
public func asyncMaybeCount() async -> Int64? {
    wvLoad()
    return await withCheckedContinuation { (continuation: CheckedContinuation<Int64?, Never>) in
        let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
        kitchen_sink_async_maybe_count({ context, err, result in
            let cont = Unmanaged<WvContinuation<Int64?, Never>>.fromOpaque(context!).takeRetainedValue().value
            if let err = err {
                wvFatal(err.pointee)
            }
            cont.resume(returning: result.wvValue)
        }, context)
    }
}

/// Async returning a typed array
///
/// - Throws: `CancellationError` when the calling task is cancelled, which
///   cancels the native call.
public func asyncSamples(n: UInt32) async throws -> [Float] {
    wvLoad()
    let token = WvCancelToken()
    return try await withTaskCancellationHandler {
        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<[Float], Error>) in
            let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
            kitchen_sink_async_samples(n, token.raw, { context, err, result in
                let cont = Unmanaged<WvContinuation<[Float], Error>>.fromOpaque(context!).takeRetainedValue().value
                if let err = err {
                    cont.resume(throwing: wvTakeCancellation(err))
                    return
                }
                cont.resume(returning: wvTakeSlice(result, as: Float.self))
            }, context)
        }
    } onCancel: {
        token.cancel()
    }
}

