/// Register a listener, returning how many are attached
public func subscribe(listener: any ReadyListener) -> Int32 {
    wvLoad()
    var err = WvError()
    let listener_cb = kitchen_sink_ReadyListener(ctx: wvRetain(listener), vtable: WvReadyListenerVtable.shared.pointer)
    let rv = kitchen_sink_subscribe(listener_cb, &err)
    wvTrap(&err)
    return rv
}

/// Register a listener if one is given
public func maybeSubscribe(listener: (any ReadyListener)?) -> Bool {
    wvLoad()
    var err = WvError()
    let listener_cb = listener.map { kitchen_sink_ReadyListener(ctx: wvRetain($0), vtable: WvReadyListenerVtable.shared.pointer) } ?? kitchen_sink_ReadyListener()
    let rv = kitchen_sink_maybe_subscribe(listener_cb, &err)
    wvTrap(&err)
    return rv
}

/// Optional object in both directions
public func maybeGadget(fallback: Gadget?) -> Gadget? {
    wvLoad()
    var err = WvError()
    let rv = kitchen_sink_maybe_gadget(fallback?.ptr, &err)
    wvTrap(&err)
    return rv.map { Gadget(ptr: $0) }
}

/// A list of objects
public func gadgets() -> [Gadget] {
    wvLoad()
    var err = WvError()
    let rv = kitchen_sink_gadgets(&err)
    wvTrap(&err)
    return wvTakeBuffer(rv, as: [Gadget].self)
}

/// An iterator over objects
