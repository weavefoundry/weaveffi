/// Consumer-implemented observer of ready items
///
/// Implement this protocol with a class and pass an instance where the API
/// expects it. The library keeps the instance until it no longer needs it and
/// may call any method from any thread.
public protocol ReadyListener: AnyObject, Sendable {
    /// Fires when an item is ready
    func onReady(code: Int32, msg: String)

    /// Receives the item itself and says whether to keep listening
    func onItem(item: Item, gadget: Gadget) -> Bool

    /// A display label, failing with a kitchen error
    ///
    /// - Throws: ``KitchenError`` to fail the library's call with that error and
    ///   its fields; any other error fails it with the error's description.
    func label() throws -> String

    /// The most recent item the listener kept, if any
    func latest() -> Item?

    /// The listener's favorite gadget
    func favorite() -> Gadget
}

