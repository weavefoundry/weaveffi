/// An ordered collection of documents.
///
/// Notebooks own their documents and release them when destroyed.
class Notebook {
  final Pointer<Void> _handle;
  Notebook._(this._handle);

  /// Releases the native object reference.
  void dispose() {
    _weaveffiDocsNotebookDestroy(_handle);
  }

  /// Create an empty notebook
  factory Notebook() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookNew(err);
      _checkError(err);
      return Notebook._(result);
    } finally {
      calloc.free(err);
    }
  }

  /// Add a document, returning its position in the notebook
  int insert(Document document) {
    final documentWriter = _BufferWriter();
    _packDocument(documentWriter, document);
    final documentBuf = documentWriter.takeBytes();
    final documentPtr = _stageBytes(documentBuf);
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookInsert(_handle, documentPtr, documentBuf.length, err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(documentPtr);
      calloc.free(err);
    }
  }

  /// Look up a document by identifier, failing when none matches
  ///
  /// Throws [DocsErrorsException] on domain errors.
  Document find(int id) {
    final outLen = calloc<Size>();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookFind(_handle, id, outLen, err);
      _checkDocsErrorsException(err);
      final n = outLen.value;
      final data = _copyNativeBytes(result, n);
      if (result != nullptr) _weaveffiFreeBytes(result, n);
      final reader = _BufferReader(data);
      final decoded = _unpackDocument(reader);
      reader.expectEnd();
      return decoded;
    } finally {
      calloc.free(outLen);
      calloc.free(err);
    }
  }

  /// The number of documents currently held
  int size() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookSize(_handle, err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }

  /// The largest number of documents one notebook will hold
  static int maxDocuments() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookMaxDocuments(err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }
}

