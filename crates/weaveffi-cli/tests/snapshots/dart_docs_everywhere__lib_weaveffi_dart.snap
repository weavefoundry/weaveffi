/// An ordered collection of documents.
///
/// Notebooks own their documents and release them when destroyed.
///
/// A reference-counted native object. Each instance holds one strong
/// reference, released by [dispose] or, if the instance is collected
/// without being disposed, by a GC finalizer. Instances stay valid for as
/// long as the Dart object is reachable; the producer keeps its own
/// references to any object it retains.
class Notebook implements Finalizable {
  final Pointer<Void> _ptr;
  bool _disposed = false;

  /// Adopts one strong reference to the native object.
  Notebook._(this._ptr) {
    _weaveffiDocsNotebookDestroyFinalizer.attach(this, _ptr, detach: this);
  }

  /// The borrowed native pointer for the duration of a call.
  Pointer<Void> get _handle {
    if (_disposed) throw StateError('Notebook used after dispose()');
    return _ptr;
  }

  /// Mints a second strong reference (the interface's `_clone` symbol) for
  /// an object token written into a value buffer.
  Pointer<Void> _cloneRef() => _weaveffiDocsNotebookClone(_handle);

  /// Releases this instance's native reference. Safe to call more than
  /// once; the native object is dropped when its last reference (this
  /// one, any other wrapper's, or the producer's) is released.
  void dispose() {
    if (_disposed) return;
    _disposed = true;
    _weaveffiDocsNotebookDestroyFinalizer.detach(this);
    _weaveffiDocsNotebookDestroy(_ptr);
  }

  /// Create an empty notebook
  ///
  /// The returned object is owned by the caller: call its `dispose()` when
  /// you are done with it.
  factory Notebook() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookNew(err);
      _checkError(err);
      return Notebook._(result);
    } finally {
      calloc.free(err);
    }
  }

  /// Add a document, returning its position in the notebook
  int insert(Document document) {
    final documentWriter = _BufferWriter();
    _packDocument(documentWriter, document);
    final documentBuf = documentWriter.takeBytes();
    final documentPtr = _stageBytes(documentBuf);
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookInsert(_handle, documentPtr, documentBuf.length, err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(documentPtr);
      calloc.free(err);
    }
  }

  /// Look up a document by identifier, failing when none matches
  ///
  /// Throws [DocsErrorsException] on domain errors.
  Document find(int id) {
    final outLen = calloc<Size>();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookFind(_handle, id, outLen, err);
      _checkDocsErrorsException(err);
      final n = outLen.value;
      final data = _copyNativeBytes(result, n);
      if (result != nullptr) _weaveffiFreeBytes(result, n);
      final reader = _BufferReader(data);
      final decoded = _unpackDocument(reader);
      reader.expectEnd();
      return decoded;
    } finally {
      calloc.free(outLen);
      calloc.free(err);
    }
  }

  /// The number of documents currently held
  int size() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookSize(_handle, err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }

  /// The largest number of documents one notebook will hold
  static int maxDocuments() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiDocsNotebookMaxDocuments(err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }
}

typedef _NativeWeaveffiDocsCreateDocument = Pointer<Uint8> Function(Pointer<Utf8>, Pointer<Uint8>, Size, Pointer<Size>, Pointer<_WeaveFFIError>);
typedef _DartWeaveffiDocsCreateDocument = Pointer<Uint8> Function(Pointer<Utf8>, Pointer<Uint8>, int, Pointer<Size>, Pointer<_WeaveFFIError>);
final _weaveffiDocsCreateDocument = _lib.lookupFunction<
    _NativeWeaveffiDocsCreateDocument, _DartWeaveffiDocsCreateDocument>('weaveffi_docs_create_document');

/// Create a brand new document.
///
/// The document starts in `Draft` status; callers must publish
/// it explicitly to make it visible.
Document createDocument(String title, List<String> tags) {
  final titlePtr = title.toNativeUtf8();
  final tagsWriter = _BufferWriter();
  final t0 = tags;
  tagsWriter.writeLength(t0.length);
  for (final t1 in t0) {
    tagsWriter.writeString(t1);
  }
  final tagsBuf = tagsWriter.takeBytes();
  final tagsPtr = _stageBytes(tagsBuf);
  final outLen = calloc<Size>();
  final err = calloc<_WeaveFFIError>();
  try {
    final result = _weaveffiDocsCreateDocument(titlePtr, tagsPtr, tagsBuf.length, outLen, err);
    _checkError(err);
    final n = outLen.value;
    final data = _copyNativeBytes(result, n);
    if (result != nullptr) _weaveffiFreeBytes(result, n);
    final reader = _BufferReader(data);
    final decoded = _unpackDocument(reader);
    reader.expectEnd();
    return decoded;
  } finally {
    calloc.free(titlePtr);
    calloc.free(tagsPtr);
    calloc.free(outLen);
    calloc.free(err);
  }
}

typedef _NativeWeaveffiDocsGetDocument = Pointer<Uint8> Function(Int64, Pointer<Size>, Pointer<_WeaveFFIError>);
typedef _DartWeaveffiDocsGetDocument = Pointer<Uint8> Function(int, Pointer<Size>, Pointer<_WeaveFFIError>);
final _weaveffiDocsGetDocument = _lib.lookupFunction<
    _NativeWeaveffiDocsGetDocument, _DartWeaveffiDocsGetDocument>('weaveffi_docs_get_document');

/// Look up a document by identifier
Document? getDocument(int id) {
  final outLen = calloc<Size>();
  final err = calloc<_WeaveFFIError>();
  try {
    final result = _weaveffiDocsGetDocument(id, outLen, err);
    _checkError(err);
    final n = outLen.value;
    final data = _copyNativeBytes(result, n);
    if (result != nullptr) _weaveffiFreeBytes(result, n);
    final reader = _BufferReader(data);
    final decoded = (reader.readOptionFlag() ? _unpackDocument(reader) : null);
    reader.expectEnd();
    return decoded;
  } finally {
    calloc.free(outLen);
    calloc.free(err);
  }
}

typedef _NativeAsyncCb_weaveffi_docs_publish_async = Void Function(Pointer<Void>, Pointer<_WeaveFFIError>, Bool);

typedef _NativeWeaveffiDocsPublishAsyncAsync = Void Function(Int64, Pointer<NativeFunction<_NativeAsyncCb_weaveffi_docs_publish_async>>, Pointer<Void>);
typedef _DartWeaveffiDocsPublishAsyncAsync = void Function(int, Pointer<NativeFunction<_NativeAsyncCb_weaveffi_docs_publish_async>>, Pointer<Void>);
final _weaveffiDocsPublishAsyncAsync = _lib.lookupFunction<
    _NativeWeaveffiDocsPublishAsyncAsync, _DartWeaveffiDocsPublishAsyncAsync>('weaveffi_docs_publish_async_async');

/// Publish a document in the background
Future<bool> publishAsync(int id) {
  final completer = Completer<bool>();
  late NativeCallable<_NativeAsyncCb_weaveffi_docs_publish_async> callable;
  callable = NativeCallable<_NativeAsyncCb_weaveffi_docs_publish_async>.listener((Pointer<Void> context, Pointer<_WeaveFFIError> err, bool result) {
    try {
      if (err.address != 0 && err.ref.code != 0) {
        final code = err.ref.code;
        final msg = err.ref.message.toDartString();
        _weaveffiErrorFree(err);
        completer.completeError(WeaveFFIException(code, msg));
        return;
      }
      completer.complete(result);
    } catch (e) {
      completer.completeError(e);
    } finally {
      callable.close();
    }
  });
  try {
    _weaveffiDocsPublishAsyncAsync(id, callable.nativeFunction, nullptr);
  } catch (e) {
    callable.close();
    rethrow;
  }
  return completer.future;
}

typedef _NativeWeaveffiDocsWatch = Void Function(Pointer<Void>, Pointer<Void>, Pointer<_WeaveFFIError>);
typedef _DartWeaveffiDocsWatch = void Function(Pointer<Void>, Pointer<Void>, Pointer<_WeaveFFIError>);
final _weaveffiDocsWatch = _lib.lookupFunction<
    _NativeWeaveffiDocsWatch, _DartWeaveffiDocsWatch>('weaveffi_docs_watch');

/// Register a listener for saved notifications
void watch(SavedListener listener) {
  final err = calloc<_WeaveFFIError>();
  try {
    _weaveffiDocsWatch(_registerCallback(listener), _SavedListenerVtable.cast<Void>(), err);
    _checkError(err);
  } finally {
    calloc.free(err);
  }
}

