  # Subscribe to per-key eviction notifications
  # Registers a OnEvict listener block. Returns a subscription id for
  # unregister_eviction_listener.
  def self.register_eviction_listener(&block)
    trampoline = FFI::Function.new(:void, [:string, :pointer]) do |key, _context|
      block.call(key)
    end
    listener_id = weaveffi_kv_register_eviction_listener(trampoline, FFI::Pointer::NULL)
    @listener_refs[listener_id] = trampoline
    listener_id
  end

  # Unregisters a listener previously registered with register_eviction_listener.
  def self.unregister_eviction_listener(listener_id)
    weaveffi_kv_unregister_eviction_listener(listener_id)
    @listener_refs.delete(listener_id)
    nil
  end

  # === Module: kv_stats ===

  # Aggregate store statistics
  class Stats
    # Number of live entries
    attr_reader :total_entries

    # Sum of all value byte lengths
    attr_reader :total_bytes

    # Number of entries past their TTL but not yet evicted
    attr_reader :expired_entries

    def initialize(total_entries:, total_bytes:, expired_entries:)
      @total_entries = total_entries
      @total_bytes = total_bytes
      @expired_entries = expired_entries
    end

    # Structural equality over every field.
    def ==(other)
      return false unless other.is_a?(Stats)
      return false unless total_entries == other.total_entries
      return false unless total_bytes == other.total_bytes
      return false unless expired_entries == other.expired_entries
      true
    end
  end

  # @api private
  # Packs a Stats into the value-buffer wire format.
  def self._wv_write_stats(w, v)
    w.write_i64(v.total_entries)
    w.write_i64(v.total_bytes)
    w.write_i64(v.expired_entries)
  end

  # @api private
  # Unpacks a Stats from the value-buffer wire format.
  def self._wv_read_stats(r)
    _wv_total_entries = r.read_i64
    _wv_total_bytes = r.read_i64
    _wv_expired_entries = r.read_i64
    Stats.new(total_entries: _wv_total_entries, total_bytes: _wv_total_bytes, expired_entries: _wv_expired_entries)
  end
  # Snapshot the current store statistics
  attach_function :weaveffi_kv_stats_get_stats, [:pointer, :pointer, :pointer], :pointer

  # Snapshot the current store statistics
  def self.get_stats(store)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kv_stats_get_stats(store.handle, out_len, err)
    check_kv_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = _wv_read_stats(_wv_r)
    _wv_r.expect_end!
    _wv_value
  end
end

