      WeaveFFI.weaveffi_kv_Store_clear(@handle, err)
      WeaveFFI.check_error!(err)
    end

    # Reclaim space asynchronously; returns the number of bytes reclaimed
    # Blocks the current thread until the async producer completes; the
    # result (or error) is delivered through the completion callback (cancellation token not exposed; pass-through is NULL).
    def compact()
      queue = Queue.new
      callback = FFI::Function.new(:void, [:pointer, :pointer, :int64]) do |_context, err_ptr, result|
        err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
        if err && err[:code] != 0
          code = err[:code]
          msg = err[:message].null? ? '' : err[:message].read_string
          payload = err[:payload_ptr].null? ? nil : err[:payload_ptr].read_string(err[:payload_len])
          WeaveFFI.weaveffi_error_clear(err_ptr)
          queue << WeaveFFI.kv_error_from(code, msg, payload)
        else
          queue << result
        end
      end
      WeaveFFI.weaveffi_kv_Store_compact_async(@handle, FFI::Pointer::NULL, callback, FFI::Pointer::NULL)
      value = queue.pop
      raise value if value.is_a?(Error)
      value
    end

    # Legacy single-shot put kept for compatibility
    def legacy_put(key, value)
      warn "[DEPRECATED] use put() with explicit kind"
      err = ErrorStruct.new
      value_buf = FFI::MemoryPointer.new(:uint8, value.bytesize)
      value_buf.put_bytes(0, value)
      result = WeaveFFI.weaveffi_kv_Store_legacy_put(@handle, key, value_buf, value.bytesize, err)
      WeaveFFI.check_kv_error!(err)
      result != 0
    end

