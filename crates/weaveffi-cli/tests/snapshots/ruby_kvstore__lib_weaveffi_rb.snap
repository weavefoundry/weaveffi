      _wv_v0 = r.read_string
      _wv_metadata[_wv_k0] = _wv_v0
    end
    Entry.new(id: _wv_id, key: _wv_key, value: _wv_value, created_at: _wv_created_at, expires_at: _wv_expires_at, tags: _wv_tags, metadata: _wv_metadata)
