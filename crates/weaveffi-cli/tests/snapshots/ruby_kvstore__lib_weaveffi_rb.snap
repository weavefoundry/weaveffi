      CODE = 1003

      def initialize(message = 'store has reached capacity')
        super(1003, message)
      end
    end

    # Underlying storage reported an I/O failure
    class IoError < KvError
      CODE = 1004

      def initialize(message = 'I/O failure')
        super(1004, message)
      end
    end
  end

  # Maps each ABI code of the KvError domain to its error class.
  KV_ERROR_CODES = {
    1001 => KvError::KeyNotFound,
    1002 => KvError::Expired,
    1003 => KvError::StoreFull,
    1004 => KvError::IoError,
