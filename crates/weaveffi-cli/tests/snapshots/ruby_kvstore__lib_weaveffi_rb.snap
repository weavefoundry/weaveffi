  # An in-memory key-value store owning its entries; destroying the object releases all of its state
  class Store
    attr_reader :handle

    # Wraps an owned pointer the producer handed over, without
    # re-running initialize.
    def self._from_ptr(ptr)
      obj = allocate
      obj.instance_variable_set(:@handle, StorePtr.new(ptr))
      obj
    end

    def destroy
      return if @handle.nil?
      @handle.free
      @handle = nil
    end

    # Open (or create) a store backed by the given filesystem path
    def self.open(path)
      err = ErrorStruct.new
      result = WeaveFFI.weaveffi_kv_Store_open(path, err)
      WeaveFFI.check_kv_error!(err)
      raise Error.new(-1, 'null pointer') if result.null?
      _from_ptr(result)
    end

    # Insert or replace a value, returning true on success
    def put(key, value, kind, ttl_seconds)
      err = ErrorStruct.new
      value_buf = FFI::MemoryPointer.new(:uint8, value.bytesize)
      value_buf.put_bytes(0, value)
      ttl_seconds_w = WvBufferWriter.new
      if ttl_seconds.nil?
        ttl_seconds_w.write_flag(false)
      else
        ttl_seconds_w.write_flag(true)
        ttl_seconds_w.write_i64(ttl_seconds)
      end
      ttl_seconds_data = ttl_seconds_w.data
      ttl_seconds_buf = FFI::MemoryPointer.new(:uint8, ttl_seconds_data.bytesize)
      ttl_seconds_buf.put_bytes(0, ttl_seconds_data)
      result = WeaveFFI.weaveffi_kv_Store_put(@handle, key, value_buf, value.bytesize, kind, ttl_seconds_buf, ttl_seconds_data.bytesize, err)
      WeaveFFI.check_kv_error!(err)
      result != 0
    end

    # Look up an entry by key; returns null if missing or expired
    def get(key)
      err = ErrorStruct.new
      out_len = FFI::MemoryPointer.new(:size_t)
      result = WeaveFFI.weaveffi_kv_Store_get(@handle, key, out_len, err)
      WeaveFFI.check_kv_error!(err)
      len = out_len.read(:size_t)
      data = result.null? ? ''.b : result.read_string(len)
      WeaveFFI.weaveffi_free_bytes(result, len) unless result.null?
      _wv_r = WvBufferReader.new(data)
      if _wv_r.read_flag
        _wv_value = WeaveFFI._wv_read_entry(_wv_r)
      else
        _wv_value = nil
      end
      _wv_r.expect_end!
      _wv_value
    end

