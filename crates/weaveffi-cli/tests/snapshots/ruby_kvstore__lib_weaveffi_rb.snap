    w.write_string(v.key)
    w.write_bytes(v.value)
    w.write_i64(v.created_at)
    if v.expires_at.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      w.write_i64(v.expires_at)
    end
    w.write_len(v.tags.length)
    v.tags.each do |_wv_e0|
      w.write_string(_wv_e0)
    end
    w.write_len(v.metadata.length)
    v.metadata.each do |_wv_k0, _wv_v0|
      w.write_string(_wv_k0)
      w.write_string(_wv_v0)
    end
