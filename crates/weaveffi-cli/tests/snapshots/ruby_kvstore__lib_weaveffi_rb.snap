    # Stream every key, optionally filtered by a prefix
    # Returns a lazy Enumerator that streams one element per pull; call
    # `.to_a` to collect eagerly. The underlying producer iterator is
    # launched on the first pull, so launch errors raise at that point
    # rather than when this method returns. The iterator handle is
    # released exactly once, when iteration finishes or is abandoned
    # early (for example by `break`).
    def list_keys(prefix)
      prefix_w = WvBufferWriter.new
      if prefix.nil?
        prefix_w.write_flag(false)
      else
        prefix_w.write_flag(true)
        prefix_w.write_string(prefix)
      end
      prefix_data = prefix_w.data
      prefix_buf = FFI::MemoryPointer.new(:uint8, prefix_data.bytesize)
      prefix_buf.put_bytes(0, prefix_data)
      Enumerator.new do |y|
        err = ErrorStruct.new
        iter = WeaveFFI.weaveffi_kv_Store_list_keys(@handle, prefix_buf, prefix_data.bytesize, err)
        begin
          WeaveFFI.check_kv_error!(err)
          unless iter.null?
            loop do
              out_item = FFI::MemoryPointer.new(:pointer)
              item_err = ErrorStruct.new
              has_item = WeaveFFI.weaveffi_kv_Store_ListKeysIterator_next(iter, out_item, item_err)
              WeaveFFI.check_kv_error!(item_err)
              break if has_item.zero?
              item_ptr = out_item.read_pointer
              if item_ptr.null?
                y << ''
              else
                item = item_ptr.read_string
                WeaveFFI.weaveffi_free_string(item_ptr)
                y << item
              end
            end
          end
        ensure
          WeaveFFI.weaveffi_kv_Store_ListKeysIterator_destroy(iter) unless iter.null?
        end
      end
    end

    # Return the number of live entries in the store
    def count()
      err = ErrorStruct.new
      result = WeaveFFI.weaveffi_kv_Store_count(@handle, err)
      WeaveFFI.check_error!(err)
      result
    end

    # Drop every entry from the store
    def clear()
