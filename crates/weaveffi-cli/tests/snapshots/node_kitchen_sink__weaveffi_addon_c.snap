// One handle-table entry per registered callback-interface implementation;
// its address is the `ctx` the producer passes back to every method.
typedef struct {
  napi_env env;
  napi_ref ref;
  napi_threadsafe_function tsfn;
} weaveffi_napi_cb_ctx;

// Every method frame starts with this header so the dispatcher can reach
// `out_err` without knowing the method.
typedef struct {
  weaveffi_error* out_err;
} weaveffi_napi_cb_frame_hdr;

// A request hopped from a producer thread to the JS thread. `method` is the
// vtable index to run, or -1 to release the context.
typedef struct {
  weaveffi_napi_cb_ctx* ctx;
  int method;
  void* frame;
  uv_mutex_t mu;
  uv_cond_t cv;
  bool done;
} weaveffi_napi_cb_req;

static weaveffi_napi_cb_ctx* weaveffi_napi_cb_register(napi_env env, napi_value target, const char* name, napi_threadsafe_function_call_js dispatch) {
  weaveffi_napi_cb_ctx* ctx = (weaveffi_napi_cb_ctx*)calloc(1, sizeof(weaveffi_napi_cb_ctx));
  ctx->env = env;
  napi_create_reference(env, target, 1, &ctx->ref);
  napi_value resource_name;
  napi_create_string_utf8(env, name, NAPI_AUTO_LENGTH, &resource_name);
  napi_create_threadsafe_function(env, NULL, NULL, resource_name, 0, 1, NULL, NULL, NULL, dispatch, &ctx->tsfn);
  // A live implementation must not pin the event loop by itself.
  napi_unref_threadsafe_function(env, ctx->tsfn);
  return ctx;
}

// Release one entry on the JS thread (env is NULL only during teardown, when
// the reference is already gone).
static void weaveffi_napi_cb_release(napi_env env, weaveffi_napi_cb_ctx* ctx) {
  if (env != NULL) {
    napi_delete_reference(env, ctx->ref);
  }
  napi_release_threadsafe_function(ctx->tsfn, napi_tsfn_release);
  free(ctx);
}

// The vtable's `free` entry: the producer is done with `ctx`.
static void weaveffi_napi_cb_free(void* ctx_) {
  weaveffi_napi_cb_ctx* ctx = (weaveffi_napi_cb_ctx*)ctx_;
  if (ctx == NULL) {
    return;
  }
  if (weaveffi_napi_on_js_thread()) {
    weaveffi_napi_cb_release(ctx->env, ctx);
    return;
  }
  weaveffi_napi_cb_req* req = (weaveffi_napi_cb_req*)calloc(1, sizeof(weaveffi_napi_cb_req));
  req->ctx = ctx;
  req->method = -1;
  if (napi_call_threadsafe_function(ctx->tsfn, req, napi_tsfn_nonblocking) != napi_ok) {
    free(req);
  }
}

// Run `req` on the JS thread and block until it has completed.
static void weaveffi_napi_cb_hop(weaveffi_napi_cb_req* req) {
  uv_mutex_init(&req->mu);
  uv_cond_init(&req->cv);
  req->done = false;
  if (napi_call_threadsafe_function(req->ctx->tsfn, req, napi_tsfn_blocking) == napi_ok) {
    uv_mutex_lock(&req->mu);
    while (!req->done) {
      uv_cond_wait(&req->cv, &req->mu);
    }
    uv_mutex_unlock(&req->mu);
  } else {
    weaveffi_error_set(((weaveffi_napi_cb_frame_hdr*)req->frame)->out_err, -4, "callback interface implementation is no longer reachable");
  }
  uv_cond_destroy(&req->cv);
  uv_mutex_destroy(&req->mu);
}

static void weaveffi_napi_cb_finish(weaveffi_napi_cb_req* req) {
  uv_mutex_lock(&req->mu);
  req->done = true;
  uv_cond_signal(&req->cv);
  uv_mutex_unlock(&req->mu);
}

