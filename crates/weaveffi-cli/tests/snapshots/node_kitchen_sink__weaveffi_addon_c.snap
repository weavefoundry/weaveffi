        ctx->err_msg = err->message ? strdup(err->message) : strdup("unknown error");
        ctx->err_payload_len = err->payload_len;
        if (err->payload_ptr != NULL && err->payload_len > 0) { ctx->err_payload = (uint8_t*)malloc(err->payload_len); memcpy(ctx->err_payload, err->payload_ptr, err->payload_len); }
    } else {
        ctx->result_null = result == NULL;
        ctx->result = result ? strdup(result) : NULL;
        weaveffi_free_string(result);
    }
    weaveffi_error_free(err);
    napi_call_threadsafe_function(ctx->tsfn, ctx, napi_tsfn_blocking);
}

static void weaveffi_kitchen_do_cancellable_napi_settle(napi_env env, napi_value js_cb, void* context, void* data) {
    (void)js_cb;
    (void)context;
    weaveffi_kitchen_do_cancellable_napi_actx* ctx = (weaveffi_kitchen_do_cancellable_napi_actx*)data;
    if (env != NULL) {
    if (ctx->err_code != 0) {
        napi_value err_obj = weaveffi_napi_error_value(env, ctx->err_code, ctx->err_msg, ctx->err_payload, ctx->err_payload_len);
        napi_reject_deferred(env, ctx->deferred, err_obj);
    } else {
        napi_value val;
        if (ctx->result_null) napi_get_null(env, &val); else napi_create_string_utf8(env, ctx->result ? ctx->result : "", NAPI_AUTO_LENGTH, &val);
        napi_resolve_deferred(env, ctx->deferred, val);
    }
    }
    free(ctx->err_msg);
    free(ctx->err_payload);
    free(ctx->result);
    napi_release_threadsafe_function(ctx->tsfn, napi_tsfn_release);
    free(ctx);
}

static napi_value Napi_weaveffi_kitchen_do_cancellable(napi_env env, napi_callback_info info) {
  size_t argc = 1;
  napi_value args[1];
  napi_get_cb_info(env, info, &argc, args, NULL, NULL);
  size_t input_len = 0;
  napi_get_value_string_utf8(env, args[0], NULL, 0, &input_len);
  char* input = (char*)malloc(input_len + 1);
  napi_get_value_string_utf8(env, args[0], input, input_len + 1, &input_len);
  weaveffi_kitchen_do_cancellable_napi_actx* ctx = (weaveffi_kitchen_do_cancellable_napi_actx*)calloc(1, sizeof(weaveffi_kitchen_do_cancellable_napi_actx));
  napi_value promise;
  napi_create_promise(env, &ctx->deferred, &promise);
  napi_value resource_name;
  napi_create_string_utf8(env, "weaveffi_kitchen_do_cancellable", NAPI_AUTO_LENGTH, &resource_name);
  napi_create_threadsafe_function(env, NULL, NULL, resource_name, 0, 1, NULL, NULL, NULL, weaveffi_kitchen_do_cancellable_napi_settle, &ctx->tsfn);
  weaveffi_kitchen_do_cancellable_async(input, NULL, weaveffi_kitchen_do_cancellable_napi_cb, ctx);
  free(input);
  return promise;
}

static napi_value Napi_weaveffi_kitchen_legacy_op(napi_env env, napi_callback_info info) {
  size_t argc = 0;
  napi_get_cb_info(env, info, &argc, NULL, NULL, NULL);
  weaveffi_error err = {0};
  int32_t result = weaveffi_kitchen_legacy_op(&err);
  if (err.code != 0) {
    napi_throw(env, weaveffi_napi_error_value(env, err.code, err.message, err.payload_ptr, err.payload_len));
    weaveffi_error_clear(&err);
    return NULL;
  }
  napi_value ret;
  napi_create_int32(env, result, &ret);
  return ret;
}

static napi_value Napi_weaveffi_kitchen_new_op(napi_env env, napi_callback_info info) {
  size_t argc = 0;
  napi_get_cb_info(env, info, &argc, NULL, NULL, NULL);
  weaveffi_error err = {0};
  int32_t result = weaveffi_kitchen_new_op(&err);
  if (err.code != 0) {
    napi_throw(env, weaveffi_napi_error_value(env, err.code, err.message, err.payload_ptr, err.payload_len));
    weaveffi_error_clear(&err);
    return NULL;
  }
  napi_value ret;
  napi_create_int32(env, result, &ret);
  return ret;
}

static napi_value Napi_weaveffi_kitchen_nested_hello(napi_env env, napi_callback_info info) {
  size_t argc = 0;
  napi_get_cb_info(env, info, &argc, NULL, NULL, NULL);
  weaveffi_error err = {0};
  const char* result = weaveffi_kitchen_nested_hello(&err);
  if (err.code != 0) {
    napi_throw(env, weaveffi_napi_error_value(env, err.code, err.message, err.payload_ptr, err.payload_len));
    weaveffi_error_clear(&err);
    return NULL;
  }
  napi_value ret;
  napi_create_string_utf8(env, result, NAPI_AUTO_LENGTH, &ret);
  weaveffi_free_string(result);
  return ret;
}

static napi_value Init(napi_env env, napi_value exports) {
  {
    uint32_t found = weaveffi_abi_version();
    if (found != WEAVEFFI_ABI_VERSION) {
      char msg[160];
      snprintf(msg, sizeof msg, "WeaveFFI ABI mismatch: these bindings expect revision %u but the loaded library reports revision %u", (unsigned)WEAVEFFI_ABI_VERSION, (unsigned)found);
      napi_throw_error(env, NULL, msg);
      return NULL;
    }
  }
  weaveffi_napi_js_thread = uv_thread_self();
  napi_property_descriptor props[] = {
    { "ping", NULL, Napi_weaveffi_shared_ping, NULL, NULL, NULL, napi_default, NULL },
    { "Gadget_new", NULL, Napi_weaveffi_kitchen_Gadget_new, NULL, NULL, NULL, napi_default, NULL },
    { "Gadget_version", NULL, Napi_weaveffi_kitchen_Gadget_version, NULL, NULL, NULL, napi_default, NULL },
    { "Gadget_describe", NULL, Napi_weaveffi_kitchen_Gadget_describe, NULL, NULL, NULL, napi_default, NULL },
    { "Gadget_poke", NULL, Napi_weaveffi_kitchen_Gadget_poke, NULL, NULL, NULL, napi_default, NULL },
    { "Gadget__destroy", NULL, Napi_weaveffi_kitchen_Gadget_destroy, NULL, NULL, NULL, napi_default, NULL },
    { "Gadget__clone", NULL, Napi_weaveffi_kitchen_Gadget_clone, NULL, NULL, NULL, napi_default, NULL },
    { "boolId", NULL, Napi_weaveffi_kitchen_bool_id, NULL, NULL, NULL, napi_default, NULL },
    { "i32Id", NULL, Napi_weaveffi_kitchen_i32_id, NULL, NULL, NULL, napi_default, NULL },
    { "u32Id", NULL, Napi_weaveffi_kitchen_u32_id, NULL, NULL, NULL, napi_default, NULL },
    { "i64Id", NULL, Napi_weaveffi_kitchen_i64_id, NULL, NULL, NULL, napi_default, NULL },
    { "f64Id", NULL, Napi_weaveffi_kitchen_f64_id, NULL, NULL, NULL, napi_default, NULL },
    { "echoString", NULL, Napi_weaveffi_kitchen_echo_string, NULL, NULL, NULL, napi_default, NULL },
    { "echoBytes", NULL, Napi_weaveffi_kitchen_echo_bytes, NULL, NULL, NULL, napi_default, NULL },
    { "subscribe", NULL, Napi_weaveffi_kitchen_subscribe, NULL, NULL, NULL, napi_default, NULL },
    { "maybeGadget", NULL, Napi_weaveffi_kitchen_maybe_gadget, NULL, NULL, NULL, napi_default, NULL },
    { "gadgets", NULL, Napi_weaveffi_kitchen_gadgets, NULL, NULL, NULL, napi_default, NULL },
    { "streamGadgets_iterNext", NULL, Napi_weaveffi_kitchen_StreamGadgetsIterator_next, NULL, NULL, NULL, napi_default, NULL },
    { "streamGadgets_iterDestroy", NULL, Napi_weaveffi_kitchen_StreamGadgetsIterator_destroy, NULL, NULL, NULL, napi_default, NULL },
    { "streamGadgets", NULL, Napi_weaveffi_kitchen_stream_gadgets, NULL, NULL, NULL, napi_default, NULL },
    { "maybeItem", NULL, Napi_weaveffi_kitchen_maybe_item, NULL, NULL, NULL, napi_default, NULL },
    { "listItems", NULL, Napi_weaveffi_kitchen_list_items, NULL, NULL, NULL, napi_default, NULL },
    { "getAttrs", NULL, Napi_weaveffi_kitchen_get_attrs, NULL, NULL, NULL, napi_default, NULL },
    { "streamItems_iterNext", NULL, Napi_weaveffi_kitchen_StreamItemsIterator_next, NULL, NULL, NULL, napi_default, NULL },
    { "streamItems_iterDestroy", NULL, Napi_weaveffi_kitchen_StreamItemsIterator_destroy, NULL, NULL, NULL, napi_default, NULL },
    { "streamItems", NULL, Napi_weaveffi_kitchen_stream_items, NULL, NULL, NULL, napi_default, NULL },
    { "crossModuleToken", NULL, Napi_weaveffi_kitchen_cross_module_token, NULL, NULL, NULL, napi_default, NULL },
    { "doAsync", NULL, Napi_weaveffi_kitchen_do_async, NULL, NULL, NULL, napi_default, NULL },
    { "doCancellable", NULL, Napi_weaveffi_kitchen_do_cancellable, NULL, NULL, NULL, napi_default, NULL },
    { "legacyOp", NULL, Napi_weaveffi_kitchen_legacy_op, NULL, NULL, NULL, napi_default, NULL },
    { "newOp", NULL, Napi_weaveffi_kitchen_new_op, NULL, NULL, NULL, napi_default, NULL },
    { "hello", NULL, Napi_weaveffi_kitchen_nested_hello, NULL, NULL, NULL, napi_default, NULL },
  };
  napi_define_properties(env, exports, 32, props);
  return exports;
}

NAPI_MODULE(NODE_GYP_MODULE_NAME, Init)

