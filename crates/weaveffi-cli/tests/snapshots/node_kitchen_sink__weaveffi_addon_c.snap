  } else {
    switch (req->method) {
      case 0: weaveffi_kitchen_ReadyListener_on_ready_invoke(env, req->ctx, (weaveffi_kitchen_ReadyListener_on_ready_frame*)req->frame); break;
      case 1: weaveffi_kitchen_ReadyListener_on_item_invoke(env, req->ctx, (weaveffi_kitchen_ReadyListener_on_item_frame*)req->frame); break;
      default: break;
    }
