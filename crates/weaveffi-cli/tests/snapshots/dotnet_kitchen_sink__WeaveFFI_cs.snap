    }

    /// <summary>Kitchen sink struct exercising every field feature</summary>
    public sealed class Item
    {
        /// <summary>Stable identifier</summary>
        public long Id { get; }

        /// <summary>Display name</summary>
        public string Name { get; }

        /// <summary>Initial count</summary>
        public int Count { get; }

        /// <summary>Whether the item is enabled</summary>
        public bool Enabled { get; }

        /// <summary>Scaling ratio</summary>
        public double Ratio { get; }

        public uint Nick { get; }

        public byte[] Payload { get; }

        public string[] Tags { get; }

        public Dictionary<string, string> Attrs { get; }

        public long? Parent { get; }

        /// <summary>Cross-module struct reference</summary>
        public Token Token { get; }

        public Priority Priority { get; }

        public Item(long id, string name, int count, bool enabled, double ratio, uint nick, byte[] payload, string[] tags, Dictionary<string, string> attrs, long? parent, Token token, Priority priority)
        {
            Id = id;
            Name = name;
            Count = count;
            Enabled = enabled;
            Ratio = ratio;
            Nick = nick;
            Payload = payload;
            Tags = tags;
            Attrs = attrs;
            Parent = parent;
            Token = token;
            Priority = priority;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI64(Id);
            writer.WriteString(Name);
            writer.WriteI32(Count);
            writer.WriteBool(Enabled);
            writer.WriteF64(Ratio);
            writer.WriteU32(Nick);
            writer.WriteBytes(Payload);
            writer.WriteLen(Tags.Length);
            foreach (var item0 in Tags)
            {
                writer.WriteString(item0);
            }
            writer.WriteLen(Attrs.Count);
            foreach (var entry0 in Attrs)
            {
                writer.WriteString(entry0.Key);
                writer.WriteString(entry0.Value);
            }
            if (Parent != null)
            {
                writer.WriteOptionFlag(true);
                writer.WriteI64(Parent.Value);
            }
            else
            {
                writer.WriteOptionFlag(false);
            }
            Token.WriteTo(writer);
            writer.WriteI32((int)Priority);
        }

        internal static Item ReadFrom(WeaveFFIBufferReader reader)
        {
            var fId = reader.ReadI64();
            var fName = reader.ReadString();
            var fCount = reader.ReadI32();
            var fEnabled = reader.ReadBool();
            var fRatio = reader.ReadF64();
            var fNick = reader.ReadU32();
            var fPayload = reader.ReadBytes();
            var fTagsCount = reader.ReadLen();
            var fTags = new string[fTagsCount];
            for (int i0 = 0; i0 < fTagsCount; i0++)
            {
                var fTagsItem = reader.ReadString();
                fTags[i0] = fTagsItem;
            }
            var fAttrsCount = reader.ReadLen();
            var fAttrs = new Dictionary<string, string>(fAttrsCount);
            for (int i0 = 0; i0 < fAttrsCount; i0++)
            {
                var fAttrsKey = reader.ReadString();
                var fAttrsVal = reader.ReadString();
                fAttrs[fAttrsKey] = fAttrsVal;
            }
            long? fParent = null;
            if (reader.ReadOptionFlag())
            {
                var fParentValue = reader.ReadI64();
                fParent = fParentValue;
            }
            var fToken = Token.ReadFrom(reader);
            var fPriority = (Priority)reader.ReadI32();
            return new Item(fId, fName, fCount, fEnabled, fRatio, fNick, fPayload, fTags, fAttrs, fParent, fToken, fPriority);
        }
    }

    /// <summary>A pocket-sized interface exercising the object surface</summary>
    public class Gadget : IDisposable
    {
        private IntPtr _handle;
        private bool _disposed;

        internal Gadget(IntPtr handle)
        {
            _handle = handle;
        }

        internal IntPtr Handle => _handle;

        /// <summary>Create a gadget with the given id</summary>
        public Gadget(long id)
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_kitchen_Gadget_new(id, ref err);
            WeaveFFIError.Check(err);
            _handle = result;
        }

        /// <summary>Render the gadget as a human-readable string</summary>
        public string Describe()
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_kitchen_Gadget_describe(_handle, ref err);
            WeaveFFIError.Check(err);
            var str = Marshal.PtrToStringUTF8(result);
            NativeMethods.weaveffi_free_string(result);
            return str ?? "";
        }

        /// <summary>Poke the gadget a number of times, failing on a negative count</summary>
        /// <exception cref="KitchenErrorsException">Thrown when the call reports a KitchenErrorsError code.</exception>
        public int Poke(int times)
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_kitchen_Gadget_poke(_handle, times, ref err);
            WeaveFFIError.CheckKitchenErrors(err);
            return result;
        }

        /// <summary>The gadget subsystem version string</summary>
        public static string Version()
        {
            var err = new WeaveFFIError();
            var result = NativeMethods.weaveffi_kitchen_Gadget_version(ref err);
            WeaveFFIError.Check(err);
            var str = Marshal.PtrToStringUTF8(result);
            NativeMethods.weaveffi_free_string(result);
            return str ?? "";
        }

        public void Dispose()
        {
            if (!_disposed)
            {
                NativeMethods.weaveffi_kitchen_Gadget_destroy(_handle);
                _disposed = true;
            }
            GC.SuppressFinalize(this);
        }

        ~Gadget()
        {
            Dispose();
        }
    }

