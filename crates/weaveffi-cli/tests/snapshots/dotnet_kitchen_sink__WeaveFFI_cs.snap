    /// <summary>A lazily streamed sequence backed by a native iterator.
    /// It can be enumerated exactly once; enumerate it promptly (or call
    /// a materializing operator such as ToList) and let the enumerator be
    /// disposed to release the native iterator.</summary>
    internal sealed class WeaveFFIOnceEnumerable<T> : IEnumerable<T>
    {
        private IEnumerator<T>? _enumerator;

        internal WeaveFFIOnceEnumerable(IEnumerator<T> enumerator)
        {
            _enumerator = enumerator;
        }

        public IEnumerator<T> GetEnumerator()
        {
            var e = System.Threading.Interlocked.Exchange(ref _enumerator, null);
            if (e == null)
            {
                throw new InvalidOperationException("this sequence can be enumerated only once");
            }
            return e;
        }

        System.Collections.IEnumerator System.Collections.IEnumerable.GetEnumerator()
        {
            return GetEnumerator();
        }
    }

    /// <summary>A reusable token referenced across modules</summary>
    public sealed class Token
    {
        public long Id { get; }

        public string Label { get; }

        public Token(long id, string label)
        {
            Id = id;
            Label = label;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI64(Id);
            writer.WriteString(Label);
        }

        internal static Token ReadFrom(WeaveFFIBufferReader reader)
        {
            var fId = reader.ReadI64();
            var fLabel = reader.ReadString();
            return new Token(fId, fLabel);
        }
    }

