namespace weaveffi {

/** Base exception for every error reported through the C ABI. */
class WeaveFFIError : public std::runtime_error {
    int32_t code_;

public:
    WeaveFFIError(int32_t code, const std::string& msg) : std::runtime_error(msg), code_(code) {}
    int32_t code() const { return code_; }
};

namespace detail {

/** Throw the generic WeaveFFIError if `err` carries a nonzero code. */
inline void check(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    int32_t code = err.code;
    weaveffi_error_clear(&err);
    throw WeaveFFIError(code, msg);
}

/** Wrap an async-callback error as the generic WeaveFFIError. */
inline std::exception_ptr make_error(int32_t code, const std::string& msg) {
    return std::make_exception_ptr(WeaveFFIError(code, msg));
}

} // namespace detail

namespace detail {

/**
 * Serializes values into the WeaveFFI value-buffer wire format: little-endian,
 * packed with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a string, byte-buffer, or collection length as a u32. */
    void write_len(size_t n) { append_le(static_cast<uint32_t>(n)); }

    void write_string(const std::string& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }
};

/**
 * Decodes values from the WeaveFFI value-buffer wire format. A malformed
 * buffer is a producer/consumer contract violation (both sides are generated
 * from one IDL), so every decode failure throws the generic WeaveFFIError,
 * the same channel as a producer panic.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    [[noreturn]] static void fail(const char* what) {
        throw WeaveFFIError(-2, std::string("malformed WeaveFFI value buffer: ") + what);
    }

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    BufferReader(const uint8_t* data, size_t len) : data_(data), len_(len), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a length prefix, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with weaveffi_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    ~BufferGuard() {
        if (ptr != nullptr) weaveffi_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

} // namespace detail

/** Persistence semantics applied to a stored entry */
enum class EntryKind : int32_t {
    /** In-memory only; lost on close */
    Volatile = 0,
    /** Flushed to durable storage */
    Persistent = 1,
    /** Persistent and encrypted at rest */
    Encrypted = 2
};

/** A single key-value entry persisted in the store */
struct Entry {
    /** Stable monotonic identifier assigned on insert */
    int64_t id;
    /** UTF-8 lookup key */
    std::string key;
    /** Opaque binary payload */
    std::vector<uint8_t> value;
    /** Unix-timestamp seconds when the entry was created */
    int64_t created_at;
    /** Optional unix-timestamp seconds at which the entry expires */
    std::optional<int64_t> expires_at;
    /** Free-form labels attached to the entry */
    std::vector<std::string> tags;
    /** Arbitrary string-valued metadata pairs */
    std::unordered_map<std::string, std::string> metadata;
};

/** Aggregate store statistics */
struct Stats {
    /** Number of live entries */
    int64_t total_entries;
    /** Sum of all value byte lengths */
    int64_t total_bytes;
    /** Number of entries past their TTL but not yet evicted */
    int64_t expired_entries;
};

namespace detail {

/** Encodes a `Entry` in the WeaveFFI value-buffer format. */
inline void write_Entry(BufferWriter& w, const Entry& v) {
    w.write_i64(v.id);
    w.write_string(v.key);
    w.write_bytes(v.value);
    w.write_i64(v.created_at);
    w.write_option_flag(v.expires_at.has_value());
    if (v.expires_at.has_value()) {
        w.write_i64((*v.expires_at));
    }
    w.write_len(v.tags.size());
    for (const auto& item0 : v.tags) {
        w.write_string(item0);
    }
    w.write_len(v.metadata.size());
    for (const auto& kv0 : v.metadata) {
        w.write_string(kv0.first);
        w.write_string(kv0.second);
    }
}

/** Decodes a `Entry` from the WeaveFFI value-buffer format. */
inline Entry read_Entry(BufferReader& r) {
    Entry out{};
    out.id = r.read_i64();
    out.key = r.read_string();
    out.value = r.read_bytes();
    out.created_at = r.read_i64();
    if (r.read_option_flag()) {
        int64_t v_expires_at_v = r.read_i64();
        out.expires_at = std::move(v_expires_at_v);
    }
    {
        size_t v_tags_n = r.read_len();
        out.tags.reserve(v_tags_n);
        for (size_t v_tags_i = 0; v_tags_i < v_tags_n; ++v_tags_i) {
            std::string v_tags_item = r.read_string();
            out.tags.push_back(std::move(v_tags_item));
        }
    }
    {
        size_t v_metadata_n = r.read_len();
        for (size_t v_metadata_i = 0; v_metadata_i < v_metadata_n; ++v_metadata_i) {
            std::string v_metadata_key = r.read_string();
            std::string v_metadata_val = r.read_string();
            out.metadata.emplace(std::move(v_metadata_key), std::move(v_metadata_val));
        }
    }
    return out;
}

/** Encodes a `Stats` in the WeaveFFI value-buffer format. */
inline void write_Stats(BufferWriter& w, const Stats& v) {
    w.write_i64(v.total_entries);
    w.write_i64(v.total_bytes);
    w.write_i64(v.expired_entries);
}

/** Decodes a `Stats` from the WeaveFFI value-buffer format. */
inline Stats read_Stats(BufferReader& r) {
    Stats out{};
    out.total_entries = r.read_i64();
    out.total_bytes = r.read_i64();
    out.expired_entries = r.read_i64();
    return out;
}

} // namespace detail

/** Typed errors reported by the `kv` module's throwing functions. */
class KvError : public WeaveFFIError {
public:
    KvError(int32_t code, const std::string& msg) : WeaveFFIError(code, msg) {}
};

/** No entry exists for the requested key */
class KeyNotFoundError : public KvError {
public:
    KeyNotFoundError(const std::string& msg) : KvError(1001, msg) {}
};

/** The entry exists but its TTL has elapsed */
class ExpiredError : public KvError {
public:
    ExpiredError(const std::string& msg) : KvError(1002, msg) {}
};

/** The store has reached its capacity limit */
class StoreFullError : public KvError {
public:
    StoreFullError(const std::string& msg) : KvError(1003, msg) {}
};

/** Underlying storage reported an I/O failure */
class IoError : public KvError {
public:
    IoError(const std::string& msg) : KvError(1004, msg) {}
};

namespace detail {

/** Map a `kv` error code and payload to its typed exception (KvError for unknown codes). */
inline std::exception_ptr make_kv_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    switch (code) {
    case 1001: return std::make_exception_ptr(KeyNotFoundError(msg));
    case 1002: return std::make_exception_ptr(ExpiredError(msg));
    case 1003: return std::make_exception_ptr(StoreFullError(msg));
    case 1004: return std::make_exception_ptr(IoError(msg));
    default: return std::make_exception_ptr(KvError(code, msg));
    }
}

/** Throw the typed `kv` exception if `err` carries a nonzero code. */
inline void check_kv(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    std::exception_ptr ex = make_kv_error(err.code, msg, err.payload_ptr, err.payload_len);
    weaveffi_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

namespace detail {

inline std::mutex& wv_listener_mutex() {
    static std::mutex m;
    return m;
}

inline std::unordered_map<uint64_t, std::shared_ptr<void>>& wv_listener_registry() {
    static std::unordered_map<uint64_t, std::shared_ptr<void>> registry;
    return registry;
}

} // namespace detail

/** An in-memory key-value store owning its entries; destroying the object releases all of its state */
class Store {
    void* handle_;

public:
    explicit Store(void* h) : handle_(h) {}

    ~Store() {
        if (handle_) weaveffi_kv_Store_destroy(static_cast<weaveffi_kv_Store*>(handle_));
    }

    Store(const Store&) = delete;
    Store& operator=(const Store&) = delete;

    Store(Store&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    Store& operator=(Store&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_kv_Store_destroy(static_cast<weaveffi_kv_Store*>(handle_));
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    void* handle() const { return handle_; }

    /** Open (or create) a store backed by the given filesystem path */
    static Store open(const std::string& path) {
        weaveffi_error err{};
        auto result = weaveffi_kv_Store_open(path.c_str(), &err);
        detail::check_kv(err);
        return Store(result);
    }

    /** Insert or replace a value, returning true on success */
    bool put(const std::string& key, const std::vector<uint8_t>& value, EntryKind kind, const std::optional<int64_t>& ttl_seconds) const {
        detail::BufferWriter ttl_seconds_buf;
        ttl_seconds_buf.write_option_flag(ttl_seconds.has_value());
        if (ttl_seconds.has_value()) {
            ttl_seconds_buf.write_i64((*ttl_seconds));
        }
        weaveffi_error err{};
        auto result = weaveffi_kv_Store_put(static_cast<const weaveffi_kv_Store*>(handle_), key.c_str(), value.data(), value.size(), static_cast<weaveffi_kv_EntryKind>(static_cast<int32_t>(kind)), ttl_seconds_buf.data(), ttl_seconds_buf.size(), &err);
        detail::check_kv(err);
        return result;
    }

    /** Look up an entry by key; returns null if missing or expired */
    std::optional<Entry> get(const std::string& key) const {
        size_t out_len = 0;
        weaveffi_error err{};
        auto result = weaveffi_kv_Store_get(static_cast<const weaveffi_kv_Store*>(handle_), key.c_str(), &out_len, &err);
        detail::check_kv(err);
        detail::BufferGuard result_guard{result, out_len};
        detail::BufferReader result_r(result, out_len);
        std::optional<Entry> ret{};
        if (result_r.read_option_flag()) {
            Entry ret_v = detail::read_Entry(result_r);
            ret = std::move(ret_v);
        }
        result_r.expect_end();
        return ret;
    }

    /** Remove the entry for the given key, returning true if it existed */
    bool delete_(const std::string& key) const {
        weaveffi_error err{};
        auto result = weaveffi_kv_Store_delete(static_cast<const weaveffi_kv_Store*>(handle_), key.c_str(), &err);
        detail::check_kv(err);
        return result;
    }

    /**
     * A lazy, move-only range over the `std::string` elements produced by `list_keys()`.
     *
     * Each iteration step pulls exactly one element from the producer, so results stream in constant memory. The range owns the producer-side iterator and releases it exactly once: eagerly when the range is exhausted, or from the destructor when iteration is abandoned early.
     */
    class ListKeysIterator {
        weaveffi_kv_Store_ListKeysIterator* handle_;

    public:
        /** Adopts ownership of the raw producer iterator handle. */
        explicit ListKeysIterator(weaveffi_kv_Store_ListKeysIterator* h) : handle_(h) {}

        ~ListKeysIterator() {
            if (handle_) weaveffi_kv_Store_ListKeysIterator_destroy(handle_);
        }

        ListKeysIterator(const ListKeysIterator&) = delete;
        ListKeysIterator& operator=(const ListKeysIterator&) = delete;

        ListKeysIterator(ListKeysIterator&& other) noexcept : handle_(other.handle_) {
            other.handle_ = nullptr;
        }

        ListKeysIterator& operator=(ListKeysIterator&& other) noexcept {
            if (this != &other) {
                if (handle_) weaveffi_kv_Store_ListKeysIterator_destroy(handle_);
                handle_ = other.handle_;
                other.handle_ = nullptr;
            }
            return *this;
        }

        /** Pulls the next element from the producer, or `std::nullopt` once exhausted (which releases the producer iterator eagerly). A producer error throws the module's typed exception after releasing the iterator. */
        std::optional<std::string> next() {
            if (!handle_) return std::nullopt;
            weaveffi_error err{};
            const char* item{};
            int32_t has_item = weaveffi_kv_Store_ListKeysIterator_next(handle_, &item, &err);
            if (err.code != 0) {
                weaveffi_kv_Store_ListKeysIterator_destroy(handle_);
                handle_ = nullptr;
                detail::check_kv(err);
            }
            if (has_item == 0) {
                weaveffi_kv_Store_ListKeysIterator_destroy(handle_);
                handle_ = nullptr;
                return std::nullopt;
            }
            std::string value(item);
            weaveffi_free_string(item);
            return value;
        }

        /** Sentinel type marking the end of the range. */
        struct sentinel {};

        /** Single-pass input iterator; each increment pulls one element from the producer. */
        class iterator {
            ListKeysIterator* range_;
            std::optional<std::string> current_;

        public:
            using iterator_category = std::input_iterator_tag;
            using value_type = std::string;
            using difference_type = std::ptrdiff_t;
            using pointer = std::string*;
            using reference = std::string&;

            /** Binds to `range` and pulls the first element. */
            explicit iterator(ListKeysIterator* range) : range_(range), current_(range->next()) {}
            reference operator*() { return *current_; }
            pointer operator->() { return &*current_; }
            iterator& operator++() { current_ = range_->next(); return *this; }
            void operator++(int) { current_ = range_->next(); }
            bool operator==(sentinel) const { return !current_.has_value(); }
            bool operator!=(sentinel) const { return current_.has_value(); }
        };

        /** Begins iteration by pulling the first element. */
        iterator begin() { return iterator(this); }

        /** The past-the-end sentinel. */
        sentinel end() const { return sentinel{}; }
    };

    /**
     * Stream every key, optionally filtered by a prefix
     *
     * @return A lazy `ListKeysIterator` range that streams one element per iteration step and releases the producer iterator when exhausted or destroyed.
     */
    ListKeysIterator list_keys(const std::optional<std::string>& prefix) const {
        detail::BufferWriter prefix_buf;
        prefix_buf.write_option_flag(prefix.has_value());
        if (prefix.has_value()) {
            prefix_buf.write_string((*prefix));
        }
        weaveffi_error err{};
        weaveffi_kv_Store_ListKeysIterator* iter = weaveffi_kv_Store_list_keys(static_cast<const weaveffi_kv_Store*>(handle_), prefix_buf.data(), prefix_buf.size(), &err);
        detail::check_kv(err);
        return ListKeysIterator(iter);
    }

    /** Return the number of live entries in the store */
    int64_t count() const {
        weaveffi_error err{};
        auto result = weaveffi_kv_Store_count(static_cast<const weaveffi_kv_Store*>(handle_), &err);
        detail::check(err);
        return result;
    }

    /** Drop every entry from the store */
    void clear() const {
        weaveffi_error err{};
        weaveffi_kv_Store_clear(static_cast<const weaveffi_kv_Store*>(handle_), &err);
        detail::check(err);
    }

    /** Reclaim space asynchronously; returns the number of bytes reclaimed */
    std::future<int64_t> compact(weaveffi_cancel_token* cancel_token = nullptr) const {
        auto* promise_ptr = new std::promise<int64_t>();
        auto future = promise_ptr->get_future();
        weaveffi_kv_Store_compact_async(static_cast<const weaveffi_kv_Store*>(handle_), cancel_token, [](void* context, weaveffi_error* err, int64_t result) {
            auto* p = static_cast<std::promise<int64_t>*>(context);
            if (err && err->code != 0) {
                std::string msg(err->message ? err->message : "unknown error");
                p->set_exception(detail::make_kv_error(err->code, msg, err->payload_ptr, err->payload_len));
            } else {
                p->set_value(result);
            }
            delete p;
        }, static_cast<void*>(promise_ptr));
        return future;
    }

    /** Legacy single-shot put kept for compatibility */
    [[deprecated("use put() with explicit kind")]]
    bool legacy_put(const std::string& key, const std::vector<uint8_t>& value) const {
        weaveffi_error err{};
        auto result = weaveffi_kv_Store_legacy_put(static_cast<const weaveffi_kv_Store*>(handle_), key.c_str(), value.data(), value.size(), &err);
        detail::check_kv(err);
        return result;
    }

    /** The largest number of live entries one store will hold */
    static int64_t default_capacity() {
        weaveffi_error err{};
        auto result = weaveffi_kv_Store_default_capacity(&err);
        detail::check(err);
        return result;
    }

};

namespace kv {

/** Subscribe to per-key eviction notifications */
/** @return A subscription id for unregister_eviction_listener(). */
inline uint64_t register_eviction_listener(std::function<void(std::string)> callback) {
    auto fn = std::make_shared<std::function<void(std::string)>>(std::move(callback));
    uint64_t id = weaveffi_kv_register_eviction_listener(
        [](const char* key, void* context) {
            auto& cb = *static_cast<std::function<void(std::string)>*>(context);
            cb(std::string(key ? key : ""));
        },
        fn.get());
    std::lock_guard<std::mutex> lock(detail::wv_listener_mutex());
    detail::wv_listener_registry()[id] = fn;
    return id;
}

/** Unregisters a listener previously registered with register_eviction_listener(). */
inline void unregister_eviction_listener(uint64_t id) {
    weaveffi_kv_unregister_eviction_listener(id);
    std::lock_guard<std::mutex> lock(detail::wv_listener_mutex());
    detail::wv_listener_registry().erase(id);
}

} // namespace kv

namespace kv::stats {

/** Snapshot the current store statistics */
inline Stats get_stats(const Store& store) {
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_kv_stats_get_stats(static_cast<const weaveffi_kv_Store*>(store.handle()), &out_len, &err);
    detail::check_kv(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    Stats ret = detail::read_Stats(result_r);
    result_r.expect_end();
    return ret;
}

} // namespace kv::stats

} // namespace weaveffi

// END weaveffi.hpp
