Future<List<TaskResult>> runBatch(List<String> names) {
  final completer = Completer<List<TaskResult>>();
  final namesWriter = _BufferWriter();
  final t0 = names;
  namesWriter.writeLength(t0.length);
  for (final t1 in t0) {
    namesWriter.writeString(t1);
  }
  final namesBuf = namesWriter.takeBytes();
  final namesPtr = _stageBytes(namesBuf);
  late NativeCallable<_NativeAsyncCb_weaveffi_tasks_run_batch> callable;
  callable = NativeCallable<_NativeAsyncCb_weaveffi_tasks_run_batch>.listener((Pointer<Void> context, Pointer<_WeaveFFIError> err, Pointer<Uint8> result, int resultLen) {
    try {
      if (err.address != 0 && err.ref.code != 0) {
        final code = err.ref.code;
        final msg = err.ref.message.toDartString();
        _weaveffiErrorClear(err);
        completer.completeError(WeaveFFIException(code, msg));
        return;
      }
      final resultData = _copyNativeBytes(result, resultLen);
      final resultReader = _BufferReader(resultData);
      final value = List<TaskResult>.generate(resultReader.readLength(), (_) => _unpackTaskResult(resultReader));
      resultReader.expectEnd();
      completer.complete(value);
    } catch (e) {
      completer.completeError(e);
    } finally {
      callable.close();
    }
  });
  try {
