Future<TaskResult> runTask(String name) {
  final completer = Completer<TaskResult>();
  final namePtr = name.toNativeUtf8();
  late NativeCallable<_NativeAsyncCb_weaveffi_tasks_run_task> callable;
  callable = NativeCallable<_NativeAsyncCb_weaveffi_tasks_run_task>.listener((Pointer<Void> context, Pointer<_WeaveFFIError> err, Pointer<Uint8> result, int resultLen) {
    try {
      if (err.address != 0 && err.ref.code != 0) {
        final code = err.ref.code;
        final msg = err.ref.message.toDartString();
        final payload = _copyNativeBytes(err.ref.payloadPtr, err.ref.payloadLen);
        _weaveffiErrorClear(err);
        completer.completeError(_mapTaskException(code, msg, payload));
        return;
      }
      final resultData = _copyNativeBytes(result, resultLen);
      final resultReader = _BufferReader(resultData);
      final value = _unpackTaskResult(resultReader);
      resultReader.expectEnd();
      completer.complete(value);
    } catch (e) {
      completer.completeError(e);
    } finally {
      callable.close();
    }
  });
  try {
    _weaveffiTasksRunTaskAsync(namePtr, callable.nativeFunction, nullptr);
  } catch (e) {
    callable.close();
    calloc.free(namePtr);
    rethrow;
  }
  return completer.future.whenComplete(() {
    calloc.free(namePtr);
  });
}

