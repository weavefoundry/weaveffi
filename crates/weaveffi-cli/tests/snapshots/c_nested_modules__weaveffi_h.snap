#      define WEAVEFFI_API __declspec(dllexport)
#    else
#      define WEAVEFFI_API __declspec(dllimport)
#    endif
#  elif defined(__EMSCRIPTEN__)
#    define WEAVEFFI_API __attribute__((used, visibility("default")))
#  elif defined(__GNUC__) && (__GNUC__ >= 4)
#    define WEAVEFFI_API __attribute__((visibility("default")))
#  else
#    define WEAVEFFI_API
#  endif
#endif

#ifndef WEAVEFFI_DEPRECATED
#  if defined(_MSC_VER)
#    define WEAVEFFI_DEPRECATED(msg) __declspec(deprecated(msg))
#  elif defined(__GNUC__) || defined(__clang__)
#    define WEAVEFFI_DEPRECATED(msg) __attribute__((deprecated(msg)))
#  else
#    define WEAVEFFI_DEPRECATED(msg)
#  endif
#endif

#ifdef __cplusplus
extern "C" {
#endif

typedef uint64_t weaveffi_handle_t;

/* Error slot written by every fallible call. `payload_ptr`/`payload_len`
   hold the matched error code's fields serialized in the WeaveFFI value
   buffer format (null when the code declares no fields); both the message
   and the payload are released by weaveffi_error_clear. */
typedef struct weaveffi_error {
    int32_t code;
    const char* message;
    const uint8_t* payload_ptr;
    size_t payload_len;
} weaveffi_error;

WEAVEFFI_API void weaveffi_error_clear(weaveffi_error* err);

/* Async completion callbacks receive a heap-boxed error the consumer
   owns; weaveffi_error_free releases the message, the payload, and the
   box itself. Passing NULL is a safe no-op. */
WEAVEFFI_API void weaveffi_error_free(weaveffi_error* err);
WEAVEFFI_API void weaveffi_free_string(const char* ptr);
WEAVEFFI_API void weaveffi_free_bytes(uint8_t* ptr, size_t len);

/* Linear-memory allocator used by the Wasm JS glue to stage call
   arguments. Native consumers never call these; producers targeting
   WebAssembly must export them (the generated weaveffi.c provides
   malloc/free-backed defaults). */
WEAVEFFI_API uint8_t* weaveffi_alloc(uint32_t size);
WEAVEFFI_API void weaveffi_dealloc(uint8_t* ptr, uint32_t size);

typedef struct weaveffi_cancel_token weaveffi_cancel_token;
WEAVEFFI_API weaveffi_cancel_token* weaveffi_cancel_token_create(void);
WEAVEFFI_API void weaveffi_cancel_token_cancel(weaveffi_cancel_token* token);
WEAVEFFI_API bool weaveffi_cancel_token_is_cancelled(const weaveffi_cancel_token* token);
WEAVEFFI_API void weaveffi_cancel_token_destroy(weaveffi_cancel_token* token);

/*
 * Value buffer convention: records, rich enums, lists, maps, and
 * optionals cross the ABI serialized in the WeaveFFI value buffer
 * format (little-endian; see the generated bindings or the WeaveFFI
 * buffer protocol spec for the per-type encoding).
 * A buffered parameter named "v" expands to a borrowed view:
 *   const uint8_t* v_ptr, size_t v_len
 * A buffered return is a producer-allocated buffer returned as
 * `const uint8_t*` with a trailing `size_t* out_len`; the caller
 * decodes it and then releases it with weaveffi_free_bytes.
 */

/** A measurement unit shared with nested submodules. */
typedef enum { weaveffi_graphics_Unit_pixels = 0, weaveffi_graphics_Unit_points = 1 } weaveffi_graphics_Unit;
/** Error codes reported by throwing functions in the `graphics` module tree. */
typedef enum { weaveffi_graphics_GraphicsError_OutOfBounds = 1 } weaveffi_graphics_GraphicsError;

// Module: graphics
/** Construct a Canvas. */
WEAVEFFI_API const uint8_t* weaveffi_graphics_new_canvas(int32_t width, size_t* out_len, weaveffi_error* out_err);

// Module: graphics_shapes
/** Construct a Shape. */
WEAVEFFI_API const uint8_t* weaveffi_graphics_shapes_make_shape(int32_t sides, size_t* out_len, weaveffi_error* out_err);
/** Nested function returning a struct owned by an ancestor module. */
WEAVEFFI_API const uint8_t* weaveffi_graphics_shapes_describe(size_t* out_len, weaveffi_error* out_err);

// Module: graphics_shapes_geometry
/** Deeper function taking an ancestor-module struct. Throws through the root module's inherited GraphicsError domain. */
WEAVEFFI_API const uint8_t* weaveffi_graphics_shapes_geometry_compute(const uint8_t* shape_ptr, size_t shape_len, size_t* out_len, weaveffi_error* out_err);


