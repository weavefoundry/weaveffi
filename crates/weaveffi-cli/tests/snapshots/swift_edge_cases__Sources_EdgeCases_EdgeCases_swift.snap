        Leaf(weight: r.read())
    }

    func wvWrite(_ w: inout WvWriter) {
        w.write(self.weight)
    }
}

/// Middle layer of a three-deep struct nesting
public struct Inner: Hashable, Sendable {
    public var leaf: Leaf
    public var leaves: [Leaf]

    /// Creates a value from its fields.
    public init(leaf: Leaf, leaves: [Leaf]) {
        self.leaf = leaf
        self.leaves = leaves
    }
}

extension Inner: WvCodable {
    static func wvRead(_ r: inout WvReader) -> Inner {
        Inner(leaf: r.read(), leaves: r.read())
    }

    func wvWrite(_ w: inout WvWriter) {
        w.write(self.leaf)
        w.write(self.leaves)
    }
}

