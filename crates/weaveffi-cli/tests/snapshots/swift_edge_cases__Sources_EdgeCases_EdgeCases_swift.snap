}

func wvWriteInner(_ value: Inner, into w: inout WvWriter) {
    wvWriteLeaf(value.leaf, into: &w)
    w.writeLen(value.leaves.count)
    for v0 in value.leaves {
        wvWriteLeaf(v0, into: &w)
    }
}

func wvReadInner(_ r: inout WvReader) -> Inner {
    let v1 = wvReadLeaf(&r)
    let n3 = r.readCount()
    var v2: [Leaf] = []
    v2.reserveCapacity(min(n3, r.remaining))
    for _ in 0..<n3 {
        let v4 = wvReadLeaf(&r)
        v2.append(v4)
    }
    return Inner(leaf: v1, leaves: v2)
}

public struct Outer: Hashable, Sendable {
    public var inner: Inner
    public var maybeInner: Inner?
    public var byName: [String: Inner]
    public var modes: [Mode]
