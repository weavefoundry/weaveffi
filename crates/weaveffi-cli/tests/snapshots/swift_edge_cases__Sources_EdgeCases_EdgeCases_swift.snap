        WidgetHolder(primary: r.read(), fallback: r.read(), extras: r.read(), byName: r.read())
    }

    func wvWrite(_ w: inout WvWriter) {
        w.write(self.primary)
        w.write(self.fallback)
        w.write(self.extras)
        w.write(self.byName)
    }
}

/// Callback interface carrying composite payloads and objects
///
/// Implement this protocol with a class and pass an instance where the API
/// expects it. The library keeps the instance until it no longer needs it and
/// may call any method from any thread. A method that throws fails the
/// library's call in progress: a method documented to throw a module error
/// reports that error, with its code and fields, and any other error reaches
/// the library as a callback failure (code -4).
public protocol BatchListener: AnyObject, Sendable {
    /// Composite payloads cross as value buffers
    func onBatch(items: [Outer], raw: Data, first: Outer?, mode: Mode) throws

    /// Objects cross as strong references the consumer must release
    func onWidget(widget: Widget, fallback: Widget?, children: [Widget]) throws

    func onTick() throws

    /// Scalar return travels back through the vtable
    func shouldContinue(class_: Int32) throws -> Bool

    /// Enum return travels back as its integer discriminant
    func pickMode() throws -> Mode
}

/// The process-wide vtable the library calls `BatchListener` implementations
/// through (`edge_cases_edge_cases_BatchListener_vtable`). Every entry recovers the implementation
/// from `ctx`, copies or adopts its arguments, hands its result back, and
/// reports a thrown error through `out_err` instead of unwinding.
enum WvBatchListenerVtable {
    static let shared = WvVtable(edge_cases_edge_cases_BatchListener_vtable(
        size: UInt32(MemoryLayout<edge_cases_edge_cases_BatchListener_vtable>.stride),
        flags: 0,
        free: { ctx in
            wvRelease(ctx, as: (any BatchListener).self)
        },
        on_batch: { ctx, items_ptr, items_len, raw_ptr, raw_len, first_ptr, first_len, mode, out_err in
            wvInvoke(ctx, out_err, as: (any BatchListener).self, fallback: ()) { wvImpl in
                try wvImpl.onBatch(items: wvBorrowBuffer(items_ptr, items_len, as: [Outer].self), raw: wvBorrowBytes(raw_ptr, raw_len), first: wvBorrowBuffer(first_ptr, first_len, as: Outer?.self), mode: wvEnumCase(Mode.self, numericCast(mode.rawValue)))
            }
        },
        on_widget: { ctx, widget, fallback, children_ptr, children_len, out_err in
            wvInvoke(ctx, out_err, as: (any BatchListener).self, fallback: ()) { wvImpl in
                try wvImpl.onWidget(widget: Widget(ptr: wvNonNull(widget)), fallback: fallback.map { Widget(ptr: $0) }, children: wvBorrowBuffer(children_ptr, children_len, as: [Widget].self))
            }
        },
        on_tick: { ctx, out_err in
            wvInvoke(ctx, out_err, as: (any BatchListener).self, fallback: ()) { wvImpl in
                try wvImpl.onTick()
            }
        },
        should_continue: { ctx, class_, out_err in
            wvInvoke(ctx, out_err, as: (any BatchListener).self, fallback: false) { wvImpl in
                try wvImpl.shouldContinue(class_: class_)
            }
        },
        pick_mode: { ctx, out_err in
            wvInvoke(ctx, out_err, as: (any BatchListener).self, fallback: edge_cases_edge_cases_Mode(rawValue: 0)) { wvImpl in
                try edge_cases_edge_cases_Mode(rawValue: numericCast(wvImpl.pickMode().rawValue))
            }
        }
    ))
}

/// Callback interface whose name and methods are keywords
///
/// Implement this protocol with a class and pass an instance where the API
/// expects it. The library keeps the instance until it no longer needs it and
/// may call any method from any thread. A method that throws fails the
/// library's call in progress: a method documented to throw a module error
/// reports that error, with its code and fields, and any other error reaches
/// the library as a callback failure (code -4).
public protocol Keyword: AnyObject, Sendable {
    func delete(self_: Int32) throws

    func import_() throws -> Int32
}

/// The process-wide vtable the library calls `Keyword` implementations
/// through (`edge_cases_edge_cases_Keyword_vtable`). Every entry recovers the implementation
/// from `ctx`, copies or adopts its arguments, hands its result back, and
/// reports a thrown error through `out_err` instead of unwinding.
enum WvKeywordVtable {
    static let shared = WvVtable(edge_cases_edge_cases_Keyword_vtable(
        size: UInt32(MemoryLayout<edge_cases_edge_cases_Keyword_vtable>.stride),
        flags: 0,
        free: { ctx in
            wvRelease(ctx, as: (any Keyword).self)
        },
        delete_: { ctx, self_, out_err in
            wvInvoke(ctx, out_err, as: (any Keyword).self, fallback: ()) { wvImpl in
                try wvImpl.delete(self_: self_)
            }
        },
        import: { ctx, out_err in
            wvInvoke(ctx, out_err, as: (any Keyword).self, fallback: 0) { wvImpl in
                try wvImpl.import_()
            }
        }
    ))
}

/// Interface with no constructor; instances come from make_widget
public final class Widget: @unchecked Sendable {
    let ptr: OpaquePointer

    init(ptr: OpaquePointer) {
        self.ptr = ptr
    }

    deinit {
        edge_cases_edge_cases_Widget_destroy(ptr)
    }

    /// Returns a new strong reference to the same object, for a position that
    /// takes ownership of it.
    func clonePtr() -> OpaquePointer {
        wvNonNull(edge_cases_edge_cases_Widget_clone(ptr))
    }

    /// Void method that can fail
    ///
    /// - Throws: ``EdgeErrorsError`` for a declared failure, ``EdgeCasesRuntimeError`` otherwise.
    public func refresh() throws {
        var err = WvError()
        edge_cases_edge_cases_Widget_refresh(ptr, &err)
        try wvCheckEdgeCases(&err)
    }

    public func rename(class_: String, import_: String?) -> String {
        var err = WvError()
        var outLen = 0
        let rv: UnsafePointer<UInt8>? = wvWithUTF8(class_) { class__ptr, class__len in
            wvWithEncoded(import_) { import__ptr, import__len in
                edge_cases_edge_cases_Widget_rename(ptr, class__ptr, class__len, import__ptr, import__len, &outLen, &err)
            }
        }
        wvTrap(&err)
        return wvTakeString(rv, outLen)
    }

    /// Async method with a struct result
    ///
    /// - Throws: ``EdgeErrorsError`` for a declared failure, ``EdgeCasesRuntimeError`` otherwise.
    public func fetch(id: Int64) async throws -> Outer {
        return try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Outer, Error>) in
            let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
            edge_cases_edge_cases_Widget_fetch(self.ptr, id, { context, err, resultPtr, resultLen in
                let cont = Unmanaged<WvContinuation<Outer, Error>>.fromOpaque(context!).takeRetainedValue().value
                if let err = err {
                    cont.resume(throwing: wvTakeError(err, wvMapEdgeCases))
                    return
                }
                cont.resume(returning: wvTakeBuffer(resultPtr, resultLen, as: Outer.self))
            }, context)
        }
    }

    @available(*, deprecated, message: "Use rename instead")
