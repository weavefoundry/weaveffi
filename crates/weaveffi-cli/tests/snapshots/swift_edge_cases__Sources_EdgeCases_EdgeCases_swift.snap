        self.note = note
        self.byId = byId
        self.hidden = hidden
        self.v2 = v2
    }
}

func wvWriteOuter(_ value: Outer, into w: inout WvWriter) {
    wvWriteInner(value.inner, into: &w)
    if let v0 = value.maybeInner {
        w.writeOptionFlag(true)
        wvWriteInner(v0, into: &w)
    } else {
        w.writeOptionFlag(false)
    }
    w.writeLen(value.byName.count)
    for (v1, v2) in value.byName {
        w.writeString(v1)
        wvWriteInner(v2, into: &w)
    }
    w.writeLen(value.modes.count)
    for v3 in value.modes {
        w.writeI32(v3.rawValue)
    }
    w.writeLen(value.matrix.count)
    for v4 in value.matrix {
        w.writeLen(v4.count)
        for v5 in v4 {
            w.writeI32(v5)
        }
    }
    w.writeLen(value.sparse.count)
    for v6 in value.sparse {
        if let v7 = v6 {
            w.writeOptionFlag(true)
            w.writeI64(v7)
        } else {
            w.writeOptionFlag(false)
        }
    }
    if let v8 = value.blob {
        w.writeOptionFlag(true)
        w.writeBytes(v8)
    } else {
        w.writeOptionFlag(false)
    }
    if let v9 = value.note {
        w.writeOptionFlag(true)
        w.writeString(v9)
    } else {
        w.writeOptionFlag(false)
    }
    w.writeLen(value.byId.count)
    for (v10, v11) in value.byId {
        w.writeI64(v10)
        w.writeString(v11)
    }
    w.writeBool(value.hidden)
    w.writeU8(value.v2)
}

