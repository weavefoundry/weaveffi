    let v12 = wvReadInner(&r)
    var v13: Inner? = nil
    if r.readOptionFlag() {
        let v14 = wvReadInner(&r)
        v13 = v14
    }
    let n16 = r.readCount()
    var v15: [String: Inner] = [:]
    v15.reserveCapacity(min(n16, r.remaining))
    for _ in 0..<n16 {
        let v17 = r.readString()
        let v18 = wvReadInner(&r)
        v15[v17] = v18
    }
    let n20 = r.readCount()
    var v19: [Mode] = []
    v19.reserveCapacity(min(n20, r.remaining))
    for _ in 0..<n20 {
        let v21 = wvEnumCase(Mode.self, r.readI32())
        v19.append(v21)
    }
    let n23 = r.readCount()
    var v22: [[Int32]] = []
    v22.reserveCapacity(min(n23, r.remaining))
    for _ in 0..<n23 {
        let n25 = r.readCount()
        var v24: [Int32] = []
        v24.reserveCapacity(min(n25, r.remaining))
        for _ in 0..<n25 {
            let v26 = r.readI32()
            v24.append(v26)
        }
        v22.append(v24)
    }
    let n28 = r.readCount()
    var v27: [Int64?] = []
    v27.reserveCapacity(min(n28, r.remaining))
    for _ in 0..<n28 {
        var v29: Int64? = nil
        if r.readOptionFlag() {
            let v30 = r.readI64()
            v29 = v30
        }
        v27.append(v29)
    }
    var v31: Data? = nil
    if r.readOptionFlag() {
        let v32 = r.readBytes()
        v31 = v32
    }
    var v33: String? = nil
    if r.readOptionFlag() {
        let v34 = r.readString()
        v33 = v34
    }
    let n36 = r.readCount()
    var v35: [Int64: String] = [:]
    v35.reserveCapacity(min(n36, r.remaining))
    for _ in 0..<n36 {
        let v37 = r.readI64()
        let v38 = r.readString()
        v35[v37] = v38
    }
    let v39 = r.readBool()
    let v40 = r.readU8()
    return Outer(inner: v12, maybeInner: v13, byName: v15, modes: v19, matrix: v22, sparse: v27, blob: v31, note: v33, byId: v35, hidden: v39, v2: v40)
}

