    public init(inner: Inner, maybeInner: Inner?, byName: [String: Inner], modes: [Mode], matrix: [[Int32]], sparse: [Int64?], blob: Data?, note: String?, byId: [Int64: String], hidden: Bool, v2: UInt8) {
        self.inner = inner
        self.maybeInner = maybeInner
        self.byName = byName
        self.modes = modes
        self.matrix = matrix
        self.sparse = sparse
        self.blob = blob
        self.note = note
        self.byId = byId
        self.hidden = hidden
        self.v2 = v2
    }
}

extension Outer: WvCodable {
    static func wvRead(_ r: inout WvReader) -> Outer {
        Outer(inner: r.read(), maybeInner: r.read(), byName: r.read(), modes: r.read(), matrix: r.read(), sparse: r.read(), blob: r.read(), note: r.read(), byId: r.read(), hidden: r.read(), v2: r.read())
    }

    func wvWrite(_ w: inout WvWriter) {
        w.write(self.inner)
        w.write(self.maybeInner)
        w.write(self.byName)
        w.write(self.modes)
        w.write(self.matrix)
        w.write(self.sparse)
        w.write(self.blob)
        w.write(self.note)
        w.write(self.byId)
        w.write(self.hidden)
        w.write(self.v2)
    }
}

