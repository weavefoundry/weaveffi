// MARK: - API

/// Typed errors reported by the `edge_cases` module.
public enum EdgeErrorsError: Error, LocalizedError, Sendable {
    case busy(message: String)

    /// The message the library reported, or the code's documented default.
    public var errorDescription: String? {
        switch self {
        case let .busy(message): return message
        }
    }

    /// The numeric ABI code carried by this error.
    public var errorCode: Int32 {
        switch self {
        case .busy: return 7
        }
    }
}

func wvMapEdgeCases(_ err: WvError) -> Error {
    let message = wvErrorMessage(err)
    switch err.code {
    case 7: return EdgeErrorsError.busy(message: message.isEmpty ? "Resource is busy" : message)
    default: return wvRuntimeError(err)
    }
}

func wvCheckEdgeCases(_ err: inout WvError) throws {
    guard err.code != 0 else { return }
    let error = wvMapEdgeCases(err)
    edge_cases_error_clear(&err)
    throw error
}

/// Deprecated enum with non-contiguous values and keyword-like variants
@available(*, deprecated, message: "Use Mode instead")
public enum Legacy: Int32, Sendable {
    case none = 0
    case default_ = 5
    case class_ = 10
}

@available(*, deprecated, message: "Use Mode instead")
extension Legacy: WvCEnum {}

public enum Mode: Int32, Sendable {
    case fast = 1
    case safe = 2
}

extension Mode: WvCEnum {}

public struct Leaf: Hashable, Sendable {
    public var weight: Float

    /// Creates a value from its fields.
    public init(weight: Float) {
        self.weight = weight
    }
}

