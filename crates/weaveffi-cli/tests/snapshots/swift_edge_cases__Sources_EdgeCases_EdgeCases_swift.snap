/// Record carrying objects in every buffered position
public struct WidgetHolder: Sendable {
    public var primary: Widget
    public var fallback: Widget?
    public var extras: [Widget]
    public var byName: [String: Widget]

    /// Creates a value from its fields.
    public init(primary: Widget, fallback: Widget?, extras: [Widget], byName: [String: Widget]) {
        self.primary = primary
        self.fallback = fallback
        self.extras = extras
        self.byName = byName
    }
}

extension WidgetHolder: WvCodable {
