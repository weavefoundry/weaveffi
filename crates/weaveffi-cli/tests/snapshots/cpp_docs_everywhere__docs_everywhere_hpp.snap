/**
 * Verifies that the linked docs_everywhere library implements C ABI revision
 * 4 and every declaration this header was generated with, throwing
 * LoadError naming the first mismatch. The check runs once; every free
 * function, constructor, and static member calls this before its first
 * native call, so calling it at startup is optional.
 */
inline void check_library() {
    static const std::string failure = []() -> std::string {
        uint32_t abi = docs_everywhere_abi_version();
        if (abi != DOCS_EVERYWHERE_ABI_VERSION) {
            return "docs_everywhere: C ABI revision mismatch (header " + std::to_string(DOCS_EVERYWHERE_ABI_VERSION) +
                   ", library " + std::to_string(abi) + ")";
        }
        if (std::string why = detail::contract_mismatch(docs_everywhere_docs_contract, detail::docs_contract); !why.empty()) {
            return "docs_everywhere: " + why;
        }
        return std::string();
    }();
    if (!failure.empty()) throw LoadError(failure);
}

namespace detail {

/**
 * Serializes values into the value-buffer wire format: little-endian, packed
 * with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const noexcept { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const noexcept { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a byte length or an element count as a u32. */
    void write_len(size_t n) {
        if (static_cast<uint64_t>(n) > UINT32_MAX) throw std::length_error("value buffer length exceeds u32");
        append_le(static_cast<uint32_t>(n));
    }

    void write_string(std::string_view v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }

    /**
     * Writes an object token: a fresh strong reference from the wrapper's
     * `_clone`, which the reader adopts while `v` keeps its own.
     */
    template <typename T>
    void write_object(const T& v) {
        write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(v.clone_handle())));
    }
};

/**
 * Decodes values from the value-buffer wire format. A malformed buffer is a
 * producer bug (both sides are generated from one API), so every decode
 * failure throws InternalError with the marshalling code -3. Object tokens
 * adopted before a failure live in RAII wrappers that release them on
 * unwind.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    /** Throws the marshalling failure (-3) for a malformed buffer. */
    [[noreturn]] static void fail(const char* what) {
        throw InternalError(-3, std::string("malformed value buffer: ") + what);
    }

    /** Reads from the `len` bytes at `data` (null when empty). */
    BufferReader(const uint8_t* data, size_t len) noexcept : data_(data), len_(data != nullptr ? len : 0), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const noexcept { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a byte length, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    /**
     * Reads an element count. Elements may encode to zero bytes, so a count
     * larger than the bytes remaining is legal; callers cap preallocation
     * with reserve_hint().
     */
    size_t read_count() { return static_cast<size_t>(read_le<uint32_t>("count")); }

    /** A preallocation size for `n` elements that a malformed count can't inflate. */
    size_t reserve_hint(size_t n) const noexcept { return n < remaining() ? n : remaining(); }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Reads an object token, adopting the strong reference it carries into a `T` wrapper. */
    template <typename T>
    T read_object() {
        auto* raw = reinterpret_cast<typename T::raw_type*>(static_cast<uintptr_t>(read_u64()));
        if (raw == nullptr) fail("null object token");
        return T(adopt, raw);
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with docs_everywhere_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    BufferGuard(const uint8_t* p, size_t n) noexcept : ptr(p), len(n) {}
    BufferGuard(const BufferGuard&) = delete;
    BufferGuard& operator=(const BufferGuard&) = delete;

    ~BufferGuard() {
        if (ptr != nullptr) docs_everywhere_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

/** Decodes one complete `T` from a borrowed buffer with `read`, rejecting trailing bytes. */
template <typename T>
T decode(const uint8_t* ptr, size_t len, T (*read)(BufferReader&)) {
    BufferReader r(ptr, len);
    T value = read(r);
    r.expect_end();
    return value;
}

/** Decodes one complete `T` from a producer-returned buffer with `read`, then releases the buffer. */
template <typename T>
T take(const uint8_t* ptr, size_t len, T (*read)(BufferReader&)) {
    BufferGuard guard(ptr, len);
    return decode(ptr, len, read);
}

} // namespace detail

/**
 * Lifecycle status of a document.
 *
 * Used to drive UI badges and filters.
 */
enum class Status : int32_t {
    /** Document is being edited */
    Draft = 0,
    /** Document is publicly visible */
    Published = 1,
    /** Document is hidden from listings */
    Archived = 2,
};

struct Document;
class Notebook;
class SavedListener;

/**
 * An ordered collection of documents.
 *
 * Notebooks own their documents and release them when destroyed.
 */
class Notebook {
    docs_everywhere_docs_Notebook* raw_;

public:
    /** The C type this class wraps. */
    using raw_type = docs_everywhere_docs_Notebook;

    /** Adopts one strong reference to a producer object: `Notebook(adopt, raw)`. */
    explicit Notebook(adopt_t, docs_everywhere_docs_Notebook* h) noexcept : raw_(h) {}

    /** Releases this wrapper's reference; the object is dropped with its last one. */
    ~Notebook() {
        if (raw_ != nullptr) docs_everywhere_docs_Notebook_destroy(raw_);
    }

    /** Copies share the object: the copy takes a new strong reference. */
    Notebook(const Notebook& other) : raw_(docs_everywhere_docs_Notebook_clone(other.raw_)) {}

    /** Takes a new reference to `other`'s object and releases the current one. */
    Notebook& operator=(const Notebook& other) {
        if (this != &other) {
            docs_everywhere_docs_Notebook* h = docs_everywhere_docs_Notebook_clone(other.raw_);
            if (raw_ != nullptr) docs_everywhere_docs_Notebook_destroy(raw_);
            raw_ = h;
        }
        return *this;
    }

    /** Transfers `other`'s reference; `other` becomes empty. */
    Notebook(Notebook&& other) noexcept : raw_(other.raw_) { other.raw_ = nullptr; }

    /** Releases the current reference and takes over `other`'s. */
    Notebook& operator=(Notebook&& other) noexcept {
        if (this != &other) {
            if (raw_ != nullptr) docs_everywhere_docs_Notebook_destroy(raw_);
            raw_ = other.raw_;
            other.raw_ = nullptr;
        }
        return *this;
    }

    /** The wrapped pointer, borrowed (null after a move): this wrapper keeps its reference. */
    const docs_everywhere_docs_Notebook* handle() const noexcept { return raw_; }

    /** A new strong reference to the object, which the caller owns. */
    docs_everywhere_docs_Notebook* clone_handle() const { return docs_everywhere_docs_Notebook_clone(raw_); }

    /** Create an empty notebook */
    Notebook();

    /**
     * Add a document, returning its position in the notebook
     *
     * @param document The document to add
     */
    int32_t insert(const Document& document) const;

    /**
     * Look up a document by identifier, failing when none matches
     *
     * @param id Identifier of the document to find
     * @throws DocsErrorsError when the call fails with one of the domain's codes.
     */
    Document find(int64_t id) const;

    /** The number of documents currently held */
    int32_t size() const;

    /** The largest number of documents one notebook will hold */
    static int32_t max_documents();

};

/**
 * Represents a single document tracked by the system.
 *
 * Documents are persisted to disk and exposed via the public API.
 */
struct Document {
    /** Stable opaque identifier */
    int64_t id;
    /** Human-readable title shown in lists */
    std::string title;
    /** Current lifecycle status */
    Status status;
    /** Free-form tags for grouping */
    std::vector<std::string> tags;
};

namespace detail {

inline void write_Document(BufferWriter& w, const Document& v);
inline Document read_Document(BufferReader& r);
inline void write_list_string(BufferWriter& w, const std::vector<std::string>& v);
inline std::vector<std::string> read_list_string(BufferReader& r);
inline void write_opt_Document(BufferWriter& w, const std::optional<Document>& v);
inline std::optional<Document> read_opt_Document(BufferReader& r);

/** Writes one `Document` to a value buffer. */
inline void write_Document(BufferWriter& w, const Document& v) {
    w.write_i64(v.id);
    w.write_string(v.title);
    w.write_i32(static_cast<int32_t>(v.status));
    detail::write_list_string(w, v.tags);
}

/** Reads one `Document` from a value buffer. */
inline Document read_Document(BufferReader& r) {
    return Document{
        r.read_i64(),
        r.read_string(),
        static_cast<Status>(r.read_i32()),
        detail::read_list_string(r),
    };
}

/** Writes one `[string]` to a value buffer. */
inline void write_list_string(BufferWriter& w, const std::vector<std::string>& v) {
    w.write_len(v.size());
    for (const auto& item : v) w.write_string(item);
}

/** Reads one `[string]` from a value buffer. */
inline std::vector<std::string> read_list_string(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<std::string> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(r.read_string());
    return v;
}

/** Writes one `Document?` to a value buffer. */
inline void write_opt_Document(BufferWriter& w, const std::optional<Document>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) detail::write_Document(w, *v);
}

/** Reads one `Document?` from a value buffer. */
inline std::optional<Document> read_opt_Document(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<Document>(detail::read_Document(r));
}

} // namespace detail

/** The errors the `docs` module's throwing calls report; catch a code's subclass or this. */
class DocsErrorsError : public Error {
public:
    /** Builds an error carrying a domain `code` and `message`. */
    DocsErrorsError(int32_t code, const std::string& message) : Error(code, message) {}
};

/**
 * Returned when no document matches the requested id
 *
 * Code 1.
 */
class NotFoundError : public DocsErrorsError {
public:
    /** Builds the error with the producer's `message` and the code's fields. */
    explicit NotFoundError(const std::string& message) : DocsErrorsError(1, message) {}
};

/**
 * Raised when attempting to move into a forbidden state
 *
 * Code 2.
 */
class InvalidStatusError : public DocsErrorsError {
public:
    /** Builds the error with the producer's `message` and the code's fields. */
    explicit InvalidStatusError(const std::string& message) : DocsErrorsError(2, message) {}
};

namespace detail {

/** The exception for a failed `DocsErrorsError` call: its code's subclass, Cancelled, or the root Error. */
inline std::exception_ptr make_docs_error(int32_t code, const std::string& message, const uint8_t* payload_ptr, size_t payload_len) {
    if (code == -5) return std::make_exception_ptr(Cancelled(message));
    if (code < 0) return std::make_exception_ptr(Error(code, message));
    (void)payload_ptr;
    (void)payload_len;
    switch (code) {
        case 1: return std::make_exception_ptr(NotFoundError(message));
        case 2: return std::make_exception_ptr(InvalidStatusError(message));
        default: return std::make_exception_ptr(DocsErrorsError(code, message));
    }
}

/** Throws the typed `DocsErrorsError` exception if `err` carries a nonzero code. */
inline void check_docs(docs_everywhere_error& err) {
    if (err.code == 0) return;
    std::exception_ptr ex = make_docs_error(err.code, error_message(err), err.payload_ptr, err.payload_len);
    docs_everywhere_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

/**
 * Consumer-implemented observer of document-saved notifications.
 *
 * Implementations must be safe to call from any thread.
 *
 *
 * Subclass it and pass a `std::shared_ptr<SavedListener>` where the API takes a `SavedListener`. The producer may call the methods from any thread, so they must be thread-safe, until it releases the implementation (also from any thread). An exception a method throws reaches the producer as a callback failure (code -4).
 */
class SavedListener {
public:
    virtual ~SavedListener() = default;

    /** Fires after a document has been persisted successfully */
    virtual void on_saved(int64_t doc_id, int32_t revision) = 0;
};

namespace detail {

/** Trampolines adapting a `SavedListener` implementation to `docs_everywhere_docs_SavedListener_vtable`. */
struct SavedListener_trampolines {
    static void on_saved(void* ctx, int64_t doc_id, int32_t revision, docs_everywhere_error* out_err) {
        try {
            SavedListener& impl = **static_cast<std::shared_ptr<SavedListener>*>(ctx);
            impl.on_saved(doc_id, revision);
        } catch (const std::exception& e) {
            docs_everywhere_error_set(out_err, -4, e.what());
        } catch (...) {
            docs_everywhere_error_set(out_err, -4, "SavedListener::on_saved threw a non-standard exception");
        }
    }

    /** Deletes the implementation box once the producer releases it. */
    static void free_ctx(void* ctx) {
        delete static_cast<std::shared_ptr<SavedListener>*>(ctx);
    }
};

/** The vtable every `SavedListener` implementation is passed with. */
inline const docs_everywhere_docs_SavedListener_vtable& SavedListener_vtable() {
    static const docs_everywhere_docs_SavedListener_vtable vtable = {
        static_cast<uint32_t>(sizeof(docs_everywhere_docs_SavedListener_vtable)),
        0,
        &SavedListener_trampolines::free_ctx,
        &SavedListener_trampolines::on_saved,
    };
    return vtable;
}

} // namespace detail

inline Notebook::Notebook() : raw_(nullptr) {
    check_library();
    docs_everywhere_error err{};
    auto result = docs_everywhere_docs_Notebook_new(&err);
    detail::check(err);
    raw_ = result;
}

inline int32_t Notebook::insert(const Document& document) const {
    detail::BufferWriter document_buf;
    detail::write_Document(document_buf, document);
    docs_everywhere_error err{};
    auto result = docs_everywhere_docs_Notebook_insert(raw_, document_buf.data(), document_buf.size(), &err);
    detail::check(err);
    return result;
}

inline Document Notebook::find(int64_t id) const {
    size_t out_len = 0;
    docs_everywhere_error err{};
    auto result = docs_everywhere_docs_Notebook_find(raw_, id, &out_len, &err);
    detail::check_docs(err);
    return detail::take(result, out_len, &detail::read_Document);
}

inline int32_t Notebook::size() const {
    docs_everywhere_error err{};
    auto result = docs_everywhere_docs_Notebook_size(raw_, &err);
    detail::check(err);
    return result;
}

inline int32_t Notebook::max_documents() {
    check_library();
    docs_everywhere_error err{};
    auto result = docs_everywhere_docs_Notebook_max_documents(&err);
    detail::check(err);
    return result;
}

namespace docs {

/**
 * Create a brand new document.
 *
 * The document starts in `Draft` status; callers must publish
 * it explicitly to make it visible.
 *
 *
 * @param title Human-readable title for the new document
 * @param tags Initial set of tags (may be empty)
 */
inline Document create_document(std::string_view title, const std::vector<std::string>& tags) {
    check_library();
    detail::BufferWriter tags_buf;
    detail::write_list_string(tags_buf, tags);
    size_t out_len = 0;
    docs_everywhere_error err{};
    auto result = docs_everywhere_docs_create_document(detail::utf8(title), title.size(), tags_buf.data(), tags_buf.size(), &out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_Document);
}

/**
 * Look up a document by identifier
 *
 * @param id Identifier returned from create_document
 */
inline std::optional<Document> get_document(int64_t id) {
    check_library();
    size_t out_len = 0;
    docs_everywhere_error err{};
    auto result = docs_everywhere_docs_get_document(id, &out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_opt_Document);
}

/**
 * Publish a document in the background
 *
 * @param id Identifier of the document to publish
 * @return A future settled from a producer thread; get() rethrows the call's error.
 */
inline std::future<bool> publish_async(int64_t id) {
    check_library();
    auto promise = std::make_unique<std::promise<bool>>();
    auto future = promise->get_future();
    docs_everywhere_docs_publish_async(id, [](void* context, docs_everywhere_error* err, bool result) {
        std::unique_ptr<std::promise<bool>> p(static_cast<std::promise<bool>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string message = detail::error_message(*err);
                p->set_exception(detail::make_internal_error(err->code, message));
            } else {
                p->set_value(result);
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        docs_everywhere_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

/**
 * Register a listener for saved notifications
 *
 * @param listener Receiver of saved notifications
 */
inline void watch(std::shared_ptr<SavedListener> listener) {
    check_library();
    if (!listener) throw std::invalid_argument("listener: null callback interface");
    auto listener_ctx = std::make_unique<std::shared_ptr<SavedListener>>(std::move(listener));
    docs_everywhere_error err{};
    docs_everywhere_docs_watch(static_cast<void*>(listener_ctx.release()), &detail::SavedListener_vtable(), &err);
    detail::check(err);
}

} // namespace docs

} // namespace docs_everywhere

// END docs_everywhere.hpp
