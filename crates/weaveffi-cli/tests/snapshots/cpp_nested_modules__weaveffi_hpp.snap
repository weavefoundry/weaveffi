    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    Shape ret = detail::read_Shape(result_r);
    result_r.expect_end();
    return ret;
}

/** Nested function returning a struct owned by an ancestor module. */
inline Canvas describe() {
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_graphics_shapes_describe(&out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    Canvas ret = detail::read_Canvas(result_r);
    result_r.expect_end();
    return ret;
}

} // namespace graphics::shapes

namespace graphics::shapes::geometry {

/** Deeper function taking an ancestor-module struct. Throws through the root module's inherited GraphicsError domain. */
inline Detail compute(const Shape& shape) {
    detail::BufferWriter shape_buf;
    detail::write_Shape(shape_buf, shape);
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_graphics_shapes_geometry_compute(shape_buf.data(), shape_buf.size(), &out_len, &err);
    detail::check_graphics(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    Detail ret = detail::read_Detail(result_r);
    result_r.expect_end();
    return ret;
}

} // namespace graphics::shapes::geometry

