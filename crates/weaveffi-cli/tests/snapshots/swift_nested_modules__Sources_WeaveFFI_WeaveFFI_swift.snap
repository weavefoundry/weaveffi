func wvReadShape(_ r: inout WvReader) -> Shape {
    let v0 = r.readInt32()
    let v1 = Unit(rawValue: UInt32(bitPattern: r.readInt32()))!
    let v2 = wvReadDetail(&r)
    return Shape(sides: v0, unit: v1, detail: v2)
}

/// A struct two levels deep.
