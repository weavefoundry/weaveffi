cmake_minimum_required(VERSION 3.18)
project(kitchen_sink_jni C)

# The directory holding the producer library (libkitchen_sink). Android builds
# default to the per-ABI copy under src/main/jniLibs/.
set(KITCHEN_SINK_LIBRARY_DIR "" CACHE PATH "Directory holding the kitchen_sink producer library")
if(NOT KITCHEN_SINK_LIBRARY_DIR AND ANDROID)
    set(KITCHEN_SINK_LIBRARY_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../jniLibs/${ANDROID_ABI}")
endif()
if(KITCHEN_SINK_LIBRARY_DIR)
    find_library(KITCHEN_SINK_PRODUCER NAMES kitchen_sink PATHS "${KITCHEN_SINK_LIBRARY_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
else()
    set(CMAKE_FIND_FRAMEWORK NEVER)
    find_library(KITCHEN_SINK_PRODUCER NAMES kitchen_sink REQUIRED)
endif()

add_library(kitchen_sink_jni SHARED kitchen_sink_jni.c)
target_include_directories(kitchen_sink_jni PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(kitchen_sink_jni PRIVATE "${KITCHEN_SINK_PRODUCER}")
if(NOT ANDROID)
    find_package(JNI REQUIRED)
    find_package(Threads REQUIRED)
    target_include_directories(kitchen_sink_jni PRIVATE ${JNI_INCLUDE_DIRS})
    target_link_libraries(kitchen_sink_jni PRIVATE Threads::Threads)
endif()

