// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

package com.weaveffi

import kotlinx.coroutines.suspendCancellableCoroutine
import kotlin.coroutines.resume
import kotlin.coroutines.resumeWithException

class WeaveFFI {
    companion object {
        init { System.loadLibrary("weaveffi") }

        @Volatile private var callbackExceptionHandler: ((Throwable) -> Unit)? = null

        /**
         * Installs a handler for exceptions thrown by listener callbacks and
         * async continuations on native producer threads. These exceptions have
         * no Kotlin caller to propagate to; when no handler is installed, they
         * are logged with their stack trace and dropped. Pass `null` to
         * restore the default logging behavior.
         */
        @JvmStatic fun setCallbackExceptionHandler(handler: ((Throwable) -> Unit)?) {
            callbackExceptionHandler = handler
        }

        // Invoked from the JNI glue; rethrowing signals "no handler" so the
        // glue falls back to ExceptionDescribe.
        @JvmStatic private fun dispatchCallbackException(t: Throwable) {
            callbackExceptionHandler?.invoke(t) ?: throw t
        }

        /** Exceptions thrown by the callback cannot propagate to a caller (events fire on a producer thread); they are delivered to the handler installed via [setCallbackExceptionHandler], or logged with their stack trace and dropped when no handler is set. */
        @JvmStatic private external fun registerBatchListenerJni(callback: (ByteArray, ByteArray, ByteArray, Int) -> Unit): Long
        @JvmStatic fun registerBatchListener(callback: (List<Outer>, ByteArray, Outer?, Int) -> Unit): Long = registerBatchListenerJni { a0, a1, a2, a3 -> callback(weaveDecode(a0) { r -> r.readList { unpackOuter(r) } }, a1, weaveDecode(a2) { r -> r.readOptional { unpackOuter(r) } }, a3) }
        @JvmStatic external fun unregisterBatchListener(id: Long)
        /** Exceptions thrown by the callback cannot propagate to a caller (events fire on a producer thread); they are delivered to the handler installed via [setCallbackExceptionHandler], or logged with their stack trace and dropped when no handler is set. */
        @JvmStatic external fun registerTickListener(callback: () -> Unit): Long
        @JvmStatic external fun unregisterTickListener(id: Long)
        /**
         * No parameters and no result
         */
        @JvmStatic external fun noop(): Unit
        /**
         * Function named after a keyword whose parameters are all keywords
         */
        @JvmStatic private external fun selectJni(class_: Int, from: String, func: ByteArray, range: ByteArray, type: Boolean): Int
        @JvmStatic fun select(class_: Int, from: String, func: List<String>, range: Int?, type: Boolean): Int = selectJni(class_, from, weaveEncode { w -> w.writeList(func) { v0 -> w.writeString(v0) } }, weaveEncode { w -> w.writeOptional(range) { v0 -> w.writeI32(v0) } }, type)
        /**
         * Optional list of optional structs, the deepest legal nesting
         */
        @JvmStatic private external fun nestedOptionalJni(items: ByteArray): ByteArray
        @JvmStatic fun nestedOptional(items: List<Outer?>?): List<Outer?>? = weaveDecode(nestedOptionalJni(weaveEncode { w -> w.writeOptional(items) { v0 -> w.writeList(v0) { v1 -> w.writeOptional(v1) { v2 -> packOuter(w, v2) } } } })) { r -> r.readOptional { r.readList { r.readOptional { unpackOuter(r) } } } }
        @JvmStatic private external fun optionalParamsJni(text: ByteArray, count: ByteArray, outer: ByteArray, tags: ByteArray, blob: ByteArray, mode: ByteArray): ByteArray
        @JvmStatic fun optionalParams(text: String?, count: Int?, outer: Outer?, tags: List<String>?, blob: ByteArray?, mode: Mode?): Mode? = weaveDecode(optionalParamsJni(weaveEncode { w -> w.writeOptional(text) { v0 -> w.writeString(v0) } }, weaveEncode { w -> w.writeOptional(count) { v0 -> w.writeI32(v0) } }, weaveEncode { w -> w.writeOptional(outer) { v0 -> packOuter(w, v0) } }, weaveEncode { w -> w.writeOptional(tags) { v0 -> w.writeList(v0) { v1 -> w.writeString(v1) } } }, weaveEncode { w -> w.writeOptional(blob) { v0 -> w.writeBytes(v0) } }, weaveEncode { w -> w.writeOptional(mode) { v0 -> w.writeI32(v0.value) } })) { r -> r.readOptional { Mode.fromValue(r.readI32()) } }
        /**
         * Write-back parameters
         */
        @JvmStatic external fun mutableParams(text: String, blob: ByteArray): Unit
        /**
         * Factory for an interface with no constructor
         */
        @JvmStatic private external fun makeWidgetJni(label: String): Long
        @JvmStatic fun makeWidget(label: String): Widget = Widget(makeWidgetJni(label))
        /**
         * Optional interface return
         */
        @JvmStatic private external fun findWidgetJni(id: Long): Long?
        @JvmStatic fun findWidget(id: Long): Widget? = findWidgetJni(id)?.let { Widget(it) }
        /**
         * Interface parameter, including an optional one
         */
        @JvmStatic private external fun inspectWidgetJni(widget: Long, fallback: Long?): String
        @JvmStatic fun inspectWidget(widget: Widget, fallback: Widget?): String = inspectWidgetJni(widget.handle, fallback?.handle)
        @JvmStatic external fun typedHandleParam(token: Long, raw: Long): Long
        /**
         * Iterator of strings
         */
        @JvmStatic private external fun stringStreamJni(): Long
        @JvmStatic fun stringStream(): Iterator<String> = EdgeCasesStringStreamIterator(stringStreamJni())
        /**
         * Iterator of scalars
         */
        @JvmStatic private external fun scalarStreamJni(): Long
        @JvmStatic fun scalarStream(): Iterator<Int> = EdgeCasesScalarStreamIterator(scalarStreamJni())
        /**
         * Iterator of enums
         */
        @JvmStatic private external fun modeStreamJni(): Long
        @JvmStatic fun modeStream(): Iterator<Mode> = EdgeCasesModeStreamIterator(modeStreamJni())
        /**
         * Async with no result
         */
        @JvmStatic private external fun asyncVoidAsync(callback: Any)
        @JvmStatic suspend fun asyncVoid(): Unit = suspendCancellableCoroutine { cont ->
            asyncVoidAsync(WeaveContinuation(cont) { code, message, _ -> WeaveFFIException(code, message) })
        }
        @JvmStatic private external fun asyncBytesAsync(size: Long, callback: Any)
        @JvmStatic suspend fun asyncBytes(size: Long): ByteArray = suspendCancellableCoroutine { cont ->
            asyncBytesAsync(size, WeaveContinuation(cont) { code, message, _ -> WeaveFFIException(code, message) })
        }
        @JvmStatic private external fun asyncStructAsync(callback: Any)
        @JvmStatic suspend fun asyncStruct(): Outer {
            val raw: ByteArray = suspendCancellableCoroutine { cont ->
                asyncStructAsync(WeaveContinuation(cont) { code, message, payload -> EdgeErrorsException.fromCode(code, message, payload) })
            }
            return weaveDecode(raw) { r -> unpackOuter(r) }
        }
        @JvmStatic private external fun asyncListAsync(cancelToken: Long, callback: Any)
        @JvmStatic suspend fun asyncList(): List<Outer> {
            val raw: ByteArray = suspendCancellableCoroutine { cont ->
                asyncListAsync(0L, WeaveContinuation(cont) { code, message, payload -> EdgeErrorsException.fromCode(code, message, payload) })
            }
            return weaveDecode(raw) { r -> r.readList { unpackOuter(r) } }
        }
        @JvmStatic private external fun asyncOptionalAsync(callback: Any)
        @JvmStatic suspend fun asyncOptional(): Long? {
            val raw: ByteArray = suspendCancellableCoroutine { cont ->
                asyncOptionalAsync(WeaveContinuation(cont) { code, message, _ -> WeaveFFIException(code, message) })
            }
            return weaveDecode(raw) { r -> r.readOptional { r.readI64() } }
        }
        @JvmStatic private external fun asyncEnumAsync(callback: Any)
        @JvmStatic suspend fun asyncEnum(): Mode {
