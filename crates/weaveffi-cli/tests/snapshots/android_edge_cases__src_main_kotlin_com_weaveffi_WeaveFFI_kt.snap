        @JvmStatic suspend fun asyncKeywords(class_: String, import: Int): String = suspendCancellableCoroutine { cont ->
            asyncKeywordsAsync(class_, import, WeaveContinuation(cont) { code, message, _ -> WeaveFFIException(code, message) })
        }
        @JvmStatic private external fun keywordsRoundtripJni(value: ByteArray): ByteArray
        @JvmStatic fun keywordsRoundtrip(value: Keywords): Keywords = weaveDecode(keywordsRoundtripJni(weaveEncode { w -> packKeywords(w, value) })) { r -> unpackKeywords(r) }
