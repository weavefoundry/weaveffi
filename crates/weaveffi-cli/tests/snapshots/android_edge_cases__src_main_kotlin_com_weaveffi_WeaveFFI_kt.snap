/** Deprecated struct */
data class Retired(val id: Long)

internal fun packRetired(w: WeaveBufferWriter, v: Retired) {
    w.writeI64(v.id)
}

internal fun unpackRetired(r: WeaveBufferReader): Retired = Retired(
    r.readI64(),
)

/** Interface with no constructor; instances come from make_widget */
class Widget internal constructor(internal var handle: Long) : java.io.Closeable {
    companion object {
        init { System.loadLibrary("weaveffi") }

        @JvmStatic private external fun nativeRefresh(selfHandle: Long): Unit
        @JvmStatic private external fun nativeRename(selfHandle: Long, class_: String, import: ByteArray): String
        @JvmStatic private external fun nativeFetchAsync(selfHandle: Long, id: Long, callback: Any)
        @JvmStatic private external fun nativeOldName(selfHandle: Long): String
        @JvmStatic private external fun nativeDestroy(handle: Long)
    }

    /**
     * Void method that can fail
     */
    fun refresh() { nativeRefresh(handle) }

    fun rename(class_: String, import: String?): String = nativeRename(handle, class_, weaveEncode { w -> w.writeOptional(import) { v0 -> w.writeString(v0) } })

    /**
     * Async method with a struct result
     */
    suspend fun fetch(id: Long): Outer {
        val raw: ByteArray = suspendCancellableCoroutine { cont ->
            nativeFetchAsync(handle, id, WeaveContinuation(cont) { code, message, payload -> EdgeErrorsException.fromCode(code, message, payload) })
        }
        return weaveDecode(raw) { r -> unpackOuter(r) }
    }

    @Deprecated("Use rename instead")
    fun oldName(): String = nativeOldName(handle)

    override fun close() {
        if (handle != 0L) {
            nativeDestroy(handle)
            handle = 0L
        }
    }

    protected fun finalize() {
        close()
    }
}

/** Deprecated interface with a throwing constructor */
class Vault internal constructor(internal var handle: Long) : java.io.Closeable {
    companion object {
        init { System.loadLibrary("weaveffi") }

        @JvmStatic private external fun nativeOpen(path: String): Long
        @JvmStatic private external fun nativeProbe(): Boolean
        @JvmStatic private external fun nativePeek(selfHandle: Long): Long?
        @JvmStatic private external fun nativeDestroy(handle: Long)

        /**
         * Fails when the vault is busy
         */
        fun open(path: String): Vault = Vault(nativeOpen(path))

        /**
         * Throwing static
         */
        fun probe(): Boolean = nativeProbe()
    }

    fun peek(): Widget? = nativePeek(handle)?.let { Widget(it) }

    override fun close() {
        if (handle != 0L) {
            nativeDestroy(handle)
            handle = 0L
        }
    }

    protected fun finalize() {
        close()
    }
}

/**
 * A lazy iterator over the `String` elements streamed by [stringStream]. Each step pulls
 * exactly one element from the native producer. The native handle is
 * released when the producer is exhausted, when [close] is called, or by
 * the finalizer if the iterator is abandoned, whichever comes first.
 */
class EdgeCasesStringStreamIterator internal constructor(private var handle: Long) : Iterator<String>, java.io.Closeable {
    private var nextSlot: Array<Any?>? = null

    override fun hasNext(): Boolean {
        if (nextSlot != null) return true
        if (handle == 0L) return false
        val slot = nativeNext(handle)
        if (slot == null) {
            close()
            return false
        }
        nextSlot = slot
        return true
    }

    override fun next(): String {
        if (!hasNext()) throw NoSuchElementException()
        val raw = nextSlot!![0]
        nextSlot = null
        return raw as String
    }

    override fun close() {
        if (handle != 0L) {
            nativeDestroy(handle)
            handle = 0L
        }
    }

    protected fun finalize() {
        close()
    }

    companion object {
        init { System.loadLibrary("weaveffi") }

        @JvmStatic private external fun nativeNext(handle: Long): Array<Any?>?
        @JvmStatic private external fun nativeDestroy(handle: Long)
    }
}

