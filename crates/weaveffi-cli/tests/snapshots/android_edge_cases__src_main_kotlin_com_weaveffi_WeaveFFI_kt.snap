/** Deprecated enum with non-contiguous values and keyword-like variants */
enum class Legacy(val value: Int) {
    None(0),
    Default(5),
    Class(10);

    companion object {
        fun fromValue(value: Int): Legacy = entries.first { it.value == value }
    }
}

enum class Mode(val value: Int) {
    Fast(1),
    Safe(2);

    companion object {
        fun fromValue(value: Int): Mode = entries.first { it.value == value }
    }
}

data class Leaf(val weight: Float)

internal fun packLeaf(w: WeaveBufferWriter, v: Leaf) {
    w.writeF32(v.weight)
}

internal fun unpackLeaf(r: WeaveBufferReader): Leaf = Leaf(
    r.readF32(),
)

/** Middle layer of a three-deep struct nesting */
data class Inner(val leaf: Leaf, val leaves: List<Leaf>)

internal fun packInner(w: WeaveBufferWriter, v: Inner) {
    packLeaf(w, v.leaf)
    w.writeList(v.leaves) { v0 -> packLeaf(w, v0) }
}

internal fun unpackInner(r: WeaveBufferReader): Inner = Inner(
    unpackLeaf(r),
    r.readList { unpackLeaf(r) },
)

data class Outer(val inner: Inner, val maybe_inner: Inner?, val by_name: Map<String, Inner>, val modes: List<Mode>, val matrix: List<List<Int>>, val sparse: List<Long?>, val blob: ByteArray?, val note: String?, val by_id: Map<Long, String>, val _hidden: Boolean, val v2: Byte)

internal fun packOuter(w: WeaveBufferWriter, v: Outer) {
    packInner(w, v.inner)
    w.writeOptional(v.maybe_inner) { v0 -> packInner(w, v0) }
    w.writeMap(v.by_name, { k0 -> w.writeString(k0) }, { v0 -> packInner(w, v0) })
    w.writeList(v.modes) { v0 -> w.writeI32(v0.value) }
    w.writeList(v.matrix) { v0 -> w.writeList(v0) { v1 -> w.writeI32(v1) } }
    w.writeList(v.sparse) { v0 -> w.writeOptional(v0) { v1 -> w.writeI64(v1) } }
    w.writeOptional(v.blob) { v0 -> w.writeBytes(v0) }
    w.writeOptional(v.note) { v0 -> w.writeString(v0) }
    w.writeMap(v.by_id, { k0 -> w.writeI64(k0) }, { v0 -> w.writeString(v0) })
    w.writeBool(v._hidden)
    w.writeI8(v.v2)
}

internal fun unpackOuter(r: WeaveBufferReader): Outer = Outer(
    unpackInner(r),
    r.readOptional { unpackInner(r) },
    r.readMap({ r.readString() }, { unpackInner(r) }),
    r.readList { Mode.fromValue(r.readI32()) },
    r.readList { r.readList { r.readI32() } },
    r.readList { r.readOptional { r.readI64() } },
    r.readOptional { r.readBytes() },
    r.readOptional { r.readString() },
    r.readMap({ r.readI64() }, { r.readString() }),
    r.readBool(),
    r.readI8(),
)

/** Every field is a reserved word somewhere */
data class Keywords(val class_: Int, val def: Int, val import: Int, val from: Int, val func: Int, val range: Int, val register: Int, val volatile: Int, val new: Int, val default: Int, val end: Int, val in_: Int, val is_: Int, val int: Int, val var_: Int, val val_: Int, val self: Int, val this_: Int, val object_: Int, val string: Int, val case: Int, val select: Int, val switch: Int, val void: Int, val union: Int, val namespace: Int, val operator: Int, val template: Int, val package_: Int, val protocol: Int, val guard: Int, val defer: Int, val inout: Int, val internal: Int, val when_: Int, val fun_: Int, val data: Int, val late: Int, val part: Int, val out: Int, val ref: Int, val event: Int, val base: Int, val lambda: Int, val yield: Int, val nil: Int, val null_: Int, val begin: Int, val rescue: Int, val module: Int, val chan: Int, val go: Int, val let: Int, val export: Int, val delete: Int, val typedef: Int, val sizeof: Int, val static: Int, val super_: Int)

