class Widget:
    """Interface with no constructor; instances come from make_widget"""

    @classmethod
    def _from_ptr(cls, ptr) -> "Widget":
        _obj = cls.__new__(cls)
        _obj._ptr = ptr
        return _obj

    def __init__(self, _ptr: int) -> None:
        self._ptr = _ptr


    def __del__(self) -> None:
        if self._ptr is not None:
            _lib.weaveffi_edge_cases_Widget_destroy.argtypes = [ctypes.c_void_p]
            _lib.weaveffi_edge_cases_Widget_destroy.restype = None
            _lib.weaveffi_edge_cases_Widget_destroy(self._ptr)
            self._ptr = None

    def refresh(self) -> None:
        """Void method that can fail

        Raises
        ------
        EdgeErrorsError
            If the call reports one of the domain's error codes.
