@dataclass
class Outer:
    inner: "Inner"
    maybe_inner: Optional["Inner"]
    by_name: Dict[str, "Inner"]
    modes: List["Mode"]
    matrix: List[List[int]]
    sparse: List[Optional[int]]
    blob: Optional[bytes]
    note: Optional[str]
    by_id: Dict[int, str]
    _hidden: bool
    v2: int


def _write_Outer(_w: _BufferWriter, value: "Outer") -> None:
    _write_Inner(_w, value.inner)
    if value.maybe_inner is None:
        _w.write_option_flag(False)
    else:
        _w.write_option_flag(True)
        _write_Inner(_w, value.maybe_inner)
    _w.write_len(len(value.by_name))
    for _k0, _v0 in value.by_name.items():
        _w.write_string(_k0)
        _write_Inner(_w, _v0)
    _w.write_len(len(value.modes))
    for _e0 in value.modes:
        _w.write_i32(_e0)
    _w.write_len(len(value.matrix))
    for _e0 in value.matrix:
        _w.write_len(len(_e0))
        for _e1 in _e0:
            _w.write_i32(_e1)
    _w.write_len(len(value.sparse))
    for _e0 in value.sparse:
        if _e0 is None:
            _w.write_option_flag(False)
        else:
            _w.write_option_flag(True)
            _w.write_i64(_e0)
    if value.blob is None:
        _w.write_option_flag(False)
    else:
        _w.write_option_flag(True)
        _w.write_bytes(value.blob)
    if value.note is None:
        _w.write_option_flag(False)
    else:
        _w.write_option_flag(True)
        _w.write_string(value.note)
    _w.write_len(len(value.by_id))
    for _k0, _v0 in value.by_id.items():
        _w.write_i64(_k0)
        _w.write_string(_v0)
    _w.write_bool(value._hidden)
    _w.write_u8(value.v2)


def _read_Outer(_r: _BufferReader) -> "Outer":
    return Outer(
        inner=_read_Inner(_r),
        maybe_inner=(_read_Inner(_r) if _r.read_option_flag() else None),
        by_name=dict((_r.read_string(), _read_Inner(_r)) for _i0 in range(_r.read_len())),
        modes=[Mode(_r.read_i32()) for _i0 in range(_r.read_len())],
        matrix=[[_r.read_i32() for _i1 in range(_r.read_len())] for _i0 in range(_r.read_len())],
        sparse=[(_r.read_i64() if _r.read_option_flag() else None) for _i0 in range(_r.read_len())],
        blob=(_r.read_bytes() if _r.read_option_flag() else None),
        note=(_r.read_string() if _r.read_option_flag() else None),
        by_id=dict((_r.read_i64(), _r.read_string()) for _i0 in range(_r.read_len())),
        _hidden=_r.read_bool(),
        v2=_r.read_u8(),
    )


def _pack_Outer(value: "Outer") -> bytes:
    _w = _BufferWriter()
    _write_Outer(_w, value)
    return _w.finish()


def _unpack_Outer(data: bytes) -> "Outer":
    return _decode_buffer(data, _read_Outer)


