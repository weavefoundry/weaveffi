    edge_cases_opt_edge_cases_Inner_write(w, v->maybe_inner);
    edge_cases_map_string_edge_cases_Inner_write(w, &v->by_name);
    edge_cases_list_edge_cases_Mode_write(w, &v->modes);
    edge_cases_list_list_i32_write(w, &v->matrix);
    edge_cases_list_opt_i64_write(w, &v->sparse);
    edge_cases_opt_bytes_write(w, v->blob);
    edge_cases_opt_string_write(w, v->note);
    edge_cases_map_i64_string_write(w, &v->by_id);
    edge_cases_writer_put_bool(w, v->_hidden);
    edge_cases_writer_put_u8(w, v->v2);
}

