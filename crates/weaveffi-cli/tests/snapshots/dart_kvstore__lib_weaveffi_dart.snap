/// An in-memory key-value store owning its entries; destroying the object releases all of its state
class Store {
  final Pointer<Void> _handle;
  Store._(this._handle);

  /// Releases the native object reference.
  void dispose() {
    _weaveffiKvStoreDestroy(_handle);
  }

  /// Open (or create) a store backed by the given filesystem path
  ///
  /// Throws [KvException] on domain errors.
  factory Store.open(String path) {
    final pathPtr = path.toNativeUtf8();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKvStoreOpen(pathPtr, err);
      _checkKvException(err);
      return Store._(result);
    } finally {
      calloc.free(pathPtr);
      calloc.free(err);
    }
  }

  /// Insert or replace a value, returning true on success
  ///
  /// Throws [KvException] on domain errors.
  bool put(String key, List<int> value, EntryKind kind, int? ttlSeconds) {
    final keyPtr = key.toNativeUtf8();
    final valuePtr = value.isEmpty ? nullptr : calloc<Uint8>(value.length);
    for (var i = 0; i < value.length; i++) { valuePtr[i] = value[i]; }
    final ttlSecondsWriter = _BufferWriter();
    final t0 = ttlSeconds;
    if (t0 == null) {
      ttlSecondsWriter.writeOptionFlag(false);
    } else {
      ttlSecondsWriter.writeOptionFlag(true);
      ttlSecondsWriter.writeInt64(t0);
    }
    final ttlSecondsBuf = ttlSecondsWriter.takeBytes();
    final ttlSecondsPtr = _stageBytes(ttlSecondsBuf);
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKvStorePut(_handle, keyPtr, valuePtr, value.length, kind.value, ttlSecondsPtr, ttlSecondsBuf.length, err);
      _checkKvException(err);
      return result;
    } finally {
      calloc.free(keyPtr);
      if (valuePtr != nullptr) calloc.free(valuePtr);
      calloc.free(ttlSecondsPtr);
      calloc.free(err);
    }
  }

  /// Look up an entry by key; returns null if missing or expired
  ///
  /// Throws [KvException] on domain errors.
  Entry? get(String key) {
    final keyPtr = key.toNativeUtf8();
    final outLen = calloc<Size>();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKvStoreGet(_handle, keyPtr, outLen, err);
      _checkKvException(err);
      final n = outLen.value;
      final data = _copyNativeBytes(result, n);
      if (result != nullptr) _weaveffiFreeBytes(result, n);
      final reader = _BufferReader(data);
      final value = (reader.readOptionFlag() ? _unpackEntry(reader) : null);
      reader.expectEnd();
      return value;
    } finally {
      calloc.free(keyPtr);
      calloc.free(outLen);
      calloc.free(err);
    }
  }

  /// Remove the entry for the given key, returning true if it existed
  ///
  /// Throws [KvException] on domain errors.
  bool delete(String key) {
    final keyPtr = key.toNativeUtf8();
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKvStoreDelete(_handle, keyPtr, err);
      _checkKvException(err);
      return result;
    } finally {
      calloc.free(keyPtr);
      calloc.free(err);
    }
  }

  /// Stream every key, optionally filtered by a prefix
  ///
  /// Returns a lazy [Iterable]: elements are pulled from the native
  /// iterator one at a time (one native `next` call per element), and
  /// iterating the result again launches a fresh native iterator.
  ///
  /// The native iterator handle is destroyed exactly once: eagerly when
  /// the iteration completes or fails, or by a GC finalizer if the
  /// iteration is abandoned before it is exhausted.
  ///
  /// Throws [KvException] on domain errors.
  Iterable<String> listKeys(String? prefix) sync* {
    final prefixWriter = _BufferWriter();
    final t0 = prefix;
    if (t0 == null) {
      prefixWriter.writeOptionFlag(false);
    } else {
      prefixWriter.writeOptionFlag(true);
      prefixWriter.writeString(t0);
    }
    final prefixBuf = prefixWriter.takeBytes();
    final prefixPtr = _stageBytes(prefixBuf);
    final err = calloc<_WeaveFFIError>();
    final outItem = calloc<Pointer<Utf8>>();
    Pointer<Void> iter = nullptr;
    final anchor = _IteratorLifetime();
    try {
      iter = _weaveffiKvStoreListKeys(_handle, prefixPtr, prefixBuf.length, err);
      _checkKvException(err);
      _weaveffiKvStoreListKeysIteratorDestroyFinalizer.attach(anchor, iter, detach: anchor);
      while (_weaveffiKvStoreListKeysIteratorNext(iter, outItem, err) != 0) {
        _checkKvException(err);
        final itemPtr = outItem.value;
        final item = itemPtr.toDartString();
        _weaveffiFreeString(itemPtr);
        yield item;
      }
      _checkKvException(err);
    } finally {
      if (iter != nullptr) {
        _weaveffiKvStoreListKeysIteratorDestroyFinalizer.detach(anchor);
        _weaveffiKvStoreListKeysIteratorDestroy(iter);
        iter = nullptr;
      }
      calloc.free(outItem);
      calloc.free(prefixPtr);
      calloc.free(err);
    }
  }

  /// Return the number of live entries in the store
  int count() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKvStoreCount(_handle, err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }

  /// Drop every entry from the store
  void clear() {
    final err = calloc<_WeaveFFIError>();
    try {
      _weaveffiKvStoreClear(_handle, err);
      _checkError(err);
    } finally {
      calloc.free(err);
    }
  }

  /// Reclaim space asynchronously; returns the number of bytes reclaimed
  ///
  /// Throws [KvException] on domain errors.
  Future<int> compact() {
    final completer = Completer<int>();
    late NativeCallable<_NativeAsyncCb_weaveffi_kv_Store_compact> callable;
    callable = NativeCallable<_NativeAsyncCb_weaveffi_kv_Store_compact>.listener((Pointer<Void> context, Pointer<_WeaveFFIError> err, int result) {
      try {
        if (err.address != 0 && err.ref.code != 0) {
          final code = err.ref.code;
          final msg = err.ref.message.toDartString();
          final payload = _copyNativeBytes(err.ref.payloadPtr, err.ref.payloadLen);
          _weaveffiErrorClear(err);
          completer.completeError(_mapKvException(code, msg, payload));
          return;
        }
        completer.complete(result);
      } catch (e) {
        completer.completeError(e);
      } finally {
        callable.close();
      }
    });
    try {
      _weaveffiKvStoreCompactAsync(_handle, nullptr, callable.nativeFunction, nullptr);
    } catch (e) {
      callable.close();
      rethrow;
    }
    return completer.future;
  }

  /// Legacy single-shot put kept for compatibility
  ///
  /// Throws [KvException] on domain errors.
  @Deprecated('use put() with explicit kind')
  bool legacyPut(String key, List<int> value) {
    final keyPtr = key.toNativeUtf8();
    final valuePtr = value.isEmpty ? nullptr : calloc<Uint8>(value.length);
    for (var i = 0; i < value.length; i++) { valuePtr[i] = value[i]; }
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKvStoreLegacyPut(_handle, keyPtr, valuePtr, value.length, err);
      _checkKvException(err);
      return result;
    } finally {
      calloc.free(keyPtr);
      if (valuePtr != nullptr) calloc.free(valuePtr);
      calloc.free(err);
    }
  }

  /// The largest number of live entries one store will hold
  static int defaultCapacity() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKvStoreDefaultCapacity(err);
      _checkError(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }
}

typedef _NativeCb_weaveffi_kv_OnEvict_fn = Void Function(Pointer<Utf8>, Pointer<Void>);

typedef _NativeWeaveffiKvRegisterEvictionListener = Uint64 Function(Pointer<NativeFunction<_NativeCb_weaveffi_kv_OnEvict_fn>>, Pointer<Void>);
typedef _DartWeaveffiKvRegisterEvictionListener = int Function(Pointer<NativeFunction<_NativeCb_weaveffi_kv_OnEvict_fn>>, Pointer<Void>);
final _weaveffiKvRegisterEvictionListener = _lib.lookupFunction<
    _NativeWeaveffiKvRegisterEvictionListener, _DartWeaveffiKvRegisterEvictionListener>('weaveffi_kv_register_eviction_listener');

typedef _NativeWeaveffiKvUnregisterEvictionListener = Void Function(Uint64);
typedef _DartWeaveffiKvUnregisterEvictionListener = void Function(int);
final _weaveffiKvUnregisterEvictionListener = _lib.lookupFunction<
    _NativeWeaveffiKvUnregisterEvictionListener, _DartWeaveffiKvUnregisterEvictionListener>('weaveffi_kv_unregister_eviction_listener');

/// Subscribe to per-key eviction notifications
/// Registers a OnEvict listener. Returns a subscription id for unregisterEvictionListener().
int registerEvictionListener(void Function(String key) callback) {
  final callable = NativeCallable<_NativeCb_weaveffi_kv_OnEvict_fn>.isolateLocal((Pointer<Utf8> key, Pointer<Void> context) {
    callback(key == nullptr ? '' : key.toDartString());
  });
  final id = _weaveffiKvRegisterEvictionListener(callable.nativeFunction, nullptr);
  _listenerCallables[id] = callable;
  return id;
}

/// Unregisters a listener previously registered with registerEvictionListener().
void unregisterEvictionListener(int id) {
  _weaveffiKvUnregisterEvictionListener(id);
  _listenerCallables.remove(id)?.close();
}

/// Aggregate store statistics
class Stats {
  /// Number of live entries
  final int totalEntries;
  /// Sum of all value byte lengths
  final int totalBytes;
  /// Number of entries past their TTL but not yet evicted
  final int expiredEntries;

  Stats({required this.totalEntries, required this.totalBytes, required this.expiredEntries});
}

void _packStats(_BufferWriter w, Stats v) {
  w.writeInt64(v.totalEntries);
  w.writeInt64(v.totalBytes);
  w.writeInt64(v.expiredEntries);
}

Stats _unpackStats(_BufferReader r) {
  return Stats(
    totalEntries: r.readInt64(),
    totalBytes: r.readInt64(),
    expiredEntries: r.readInt64(),
  );
}

typedef _NativeWeaveffiKvStatsGetStats = Pointer<Uint8> Function(Pointer<Void>, Pointer<Size>, Pointer<_WeaveFFIError>);
typedef _DartWeaveffiKvStatsGetStats = Pointer<Uint8> Function(Pointer<Void>, Pointer<Size>, Pointer<_WeaveFFIError>);
final _weaveffiKvStatsGetStats = _lib.lookupFunction<
    _NativeWeaveffiKvStatsGetStats, _DartWeaveffiKvStatsGetStats>('weaveffi_kv_stats_get_stats');

/// Snapshot the current store statistics
///
/// Throws [KvException] on domain errors.
Stats getStats(Store store) {
  final outLen = calloc<Size>();
  final err = calloc<_WeaveFFIError>();
  try {
    final result = _weaveffiKvStatsGetStats(store._handle, outLen, err);
    _checkKvException(err);
    final n = outLen.value;
    final data = _copyNativeBytes(result, n);
    if (result != nullptr) _weaveffiFreeBytes(result, n);
    final reader = _BufferReader(data);
    final value = _unpackStats(reader);
    reader.expectEnd();
    return value;
  } finally {
    calloc.free(outLen);
    calloc.free(err);
  }
}

// END weaveffi.dart
