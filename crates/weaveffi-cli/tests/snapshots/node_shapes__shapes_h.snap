   library built for a different revision. */
#define SHAPES_ABI_VERSION 3u
SHAPES_API uint32_t shapes_abi_version(void);

/* Error slot written by every fallible call. `message` is NUL-terminated
   UTF-8. `payload_ptr`/`payload_len` hold the matched error code's fields
   serialized in the value buffer format (null when the code declares no
   fields). Both are released by shapes_error_clear. Positive codes are
   the API's declared error codes; negative codes are runtime traps:
   -1 generic, -2 producer panic, -3 marshalling failure, -4 a callback
   interface implementation failed, -5 cancelled. */
typedef struct shapes_error {
    int32_t code;
    const char* message;
    const uint8_t* payload_ptr;
    size_t payload_len;
} shapes_error;

/* Fill `err` with `code` and a producer-owned copy of `message`. Callback
   interface implementations call this to report a failure (code -4)
   without allocating with a foreign allocator. */
SHAPES_API void shapes_error_set(shapes_error* err, int32_t code, const char* message);
SHAPES_API void shapes_error_clear(shapes_error* err);

/* Async completions receive a heap-boxed error the consumer owns;
   shapes_error_free releases the message, the payload, and the box.
   NULL is a no-op. */
SHAPES_API void shapes_error_free(shapes_error* err);

/* Release a string, bytes, or value buffer the producer returned. */
SHAPES_API void shapes_free_bytes(uint8_t* ptr, size_t len);

/* Cancellation for `cancellable` async functions. A token starts with
   one reference owned by the consumer; the producer takes its own for
   each call it is passed to, so the consumer may cancel and destroy its
   reference at any time. A cancelled call completes with code -5. */
typedef struct shapes_cancel_token shapes_cancel_token;
SHAPES_API shapes_cancel_token* shapes_cancel_token_create(void);
SHAPES_API void shapes_cancel_token_cancel(shapes_cancel_token* token);
