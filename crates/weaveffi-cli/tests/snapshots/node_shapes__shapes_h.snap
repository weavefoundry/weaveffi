 * caller and released with shapes_free_bytes.
 * Records, rich enums, lists, maps, and optionals are serialized
 * in the little-endian value buffer format; when generated,
 * shapes_buffer.h declares a C struct and codec for each.
 */

/** An algebraic shape (sum type with associated data) */
typedef enum {
    /** The empty shape (a unit variant) */
    shapes_shapes_Shape_Empty = 0,
    /** A circle with a radius */
