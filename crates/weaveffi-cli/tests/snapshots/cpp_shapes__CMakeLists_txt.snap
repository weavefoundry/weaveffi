# Generated by WeaveFFI [VERSION] from api.yml
# DO NOT EDIT. Your changes will be overwritten.
# To regenerate: weaveffi generate api.yml -o <out>

cmake_minimum_required(VERSION 3.14)
project(shapes_cpp VERSION 0.1.0 LANGUAGES CXX)

# The producer library to link: a full path from the SHAPES_LIBRARY cache or
# environment variable, or else the library name `shapes` (a CMake target
# of that name, or libshapes on the linker search path).
set(SHAPES_LIBRARY "$ENV{SHAPES_LIBRARY}" CACHE FILEPATH "Path to the shapes native library")

add_library(shapes_cpp INTERFACE)
add_library(shapes::cpp ALIAS shapes_cpp)
target_include_directories(shapes_cpp INTERFACE ${CMAKE_CURRENT_SOURCE_DIR})
target_compile_features(shapes_cpp INTERFACE cxx_std_17)
if(SHAPES_LIBRARY)
  target_link_libraries(shapes_cpp INTERFACE "${SHAPES_LIBRARY}")
else()
  target_link_libraries(shapes_cpp INTERFACE shapes)
endif()

# END CMakeLists.txt
