// MARK: - API

/// Typed errors reported by the `docs` module.
public enum DocsErrorsError: Error, LocalizedError, Sendable {
    /// Returned when no document matches the requested id
    case notFound(message: String)
    /// Raised when attempting to move into a forbidden state
    case invalidStatus(message: String)

    /// The message the library reported, or the code's documented default.
    public var errorDescription: String? {
        switch self {
        case let .notFound(message): return message
        case let .invalidStatus(message): return message
        }
    }

    /// The numeric ABI code carried by this error.
    public var errorCode: Int32 {
        switch self {
        case .notFound: return 1
        case .invalidStatus: return 2
        }
    }
}

func mapDocs(_ err: WvError) -> Error {
    let message = wvErrorMessage(err)
    switch err.code {
    case 1: return DocsErrorsError.notFound(message: message.isEmpty ? "Document not found" : message)
    case 2: return DocsErrorsError.invalidStatus(message: message.isEmpty ? "Invalid status transition" : message)
    default: return wvRuntimeError(err)
    }
}

func checkDocs(_ err: inout WvError) throws {
    guard err.code != 0 else { return }
    let error = mapDocs(err)
    docs_everywhere_error_clear(&err)
    throw error
}

/// Lifecycle status of a document.
///
/// Used to drive UI badges and filters.
public enum Status: Int32, Sendable {
    /// Document is being edited
    case draft = 0
    /// Document is publicly visible
    case published = 1
    /// Document is hidden from listings
    case archived = 2
}

/// Represents a single document tracked by the system.
///
/// Documents are persisted to disk and exposed via the public API.
public struct Document: Hashable, Sendable {
    /// Stable opaque identifier
    public var id: Int64
    /// Human-readable title shown in lists
    public var title: String
    /// Current lifecycle status
    public var status: Status
    /// Free-form tags for grouping
    public var tags: [String]

    /// Creates a value from its fields.
    public init(id: Int64, title: String, status: Status, tags: [String]) {
        self.id = id
        self.title = title
        self.status = status
        self.tags = tags
    }
}

func wvWriteDocument(_ value: Document, into w: inout WvWriter) {
    w.writeI64(value.id)
    w.writeString(value.title)
    w.writeI32(value.status.rawValue)
    w.writeLen(value.tags.count)
    for v0 in value.tags {
        w.writeString(v0)
    }
}

func wvReadDocument(_ r: inout WvReader) -> Document {
    let v1 = r.readI64()
    let v2 = r.readString()
    let v3 = wvEnumCase(Status.self, r.readI32())
    let n5 = r.readCount()
    var v4: [String] = []
    v4.reserveCapacity(min(n5, r.remaining))
    for _ in 0..<n5 {
        let v6 = r.readString()
        v4.append(v6)
    }
    return Document(id: v1, title: v2, status: v3, tags: v4)
}

/// Consumer-implemented observer of document-saved notifications.
///
/// Implementations must be safe to call from any thread.
///
/// Implement this protocol with a class and pass an instance where the API
/// expects it; the library keeps it alive for as long as it holds the
/// callback and may call any method from any thread. A thrown error aborts
/// the library's call and surfaces to the original caller as a foreign error
/// (code -4).
public protocol SavedListener: AnyObject, Sendable {
    /// Fires after a document has been persisted successfully
    /// - Parameter docId: Identifier of the saved document
    /// - Parameter revision: Monotonically increasing revision
    func onSaved(docId: Int64, revision: Int32) throws
}

/// Retains one `SavedListener` implementation across the C boundary; the library's
/// `free` entry releases it.
final class WvSavedListenerBox: Sendable {
    let impl: any SavedListener
    init(_ impl: any SavedListener) { self.impl = impl }
}

/// The process-wide `docs_everywhere_docs_SavedListener_vtable` the library calls `SavedListener`
/// implementations through. Every entry recovers the box from `ctx`, copies
/// or adopts its arguments, and reports a thrown error through `out_err`
/// instead of unwinding.
enum WvSavedListenerVtable {
    static let shared = WvVtable<docs_everywhere_docs_SavedListener_vtable>(docs_everywhere_docs_SavedListener_vtable(
        on_saved: { ctx, doc_id, revision, out_err in
            let wvBox = Unmanaged<WvSavedListenerBox>.fromOpaque(ctx!).takeUnretainedValue()
            do {
                try wvBox.impl.onSaved(docId: doc_id, revision: revision)
            } catch {
                wvForeignError(out_err, error)
            }
        },
        free: { ctx in
            Unmanaged<WvSavedListenerBox>.fromOpaque(ctx!).release()
        }
    ))
}

/// An ordered collection of documents.
///
/// Notebooks own their documents and release them when destroyed.
public final class Notebook: @unchecked Sendable {
    let ptr: OpaquePointer

    init(ptr: OpaquePointer) {
        self.ptr = ptr
    }

    deinit {
        docs_everywhere_docs_Notebook_destroy(ptr)
    }

