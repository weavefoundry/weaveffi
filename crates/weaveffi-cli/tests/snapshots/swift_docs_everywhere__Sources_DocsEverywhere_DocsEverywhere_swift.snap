    /// takes ownership of it (an object token inside a value buffer).
    func clonePtr() -> OpaquePointer {
        wvNonNull(docs_everywhere_docs_Notebook_clone(ptr))
    }

    /// Create an empty notebook
    public init() {
        wvLoad()
        var err = WvError()
        let rv = docs_everywhere_docs_Notebook_new(&err)
        wvTrap(&err)
        self.ptr = wvNonNull(rv)
    }

    /// Add a document, returning its position in the notebook
    /// - Parameter document: The document to add
    public func insert(document: Document) -> Int32 {
        var err = WvError()
        var documentWriter = WvWriter()
        wvWriteDocument(document, into: &documentWriter)
        let rv: Int32 = wvWithBuffer(documentWriter) { document_ptr, document_len in
            docs_everywhere_docs_Notebook_insert(ptr, document_ptr, document_len, &err)
        }
        wvTrap(&err)
        return rv
    }

    /// Look up a document by identifier, failing when none matches
    /// - Parameter id: Identifier of the document to find
    public func find(id: Int64) throws -> Document {
        var err = WvError()
        var outLen = 0
        let rv = docs_everywhere_docs_Notebook_find(ptr, id, &outLen, &err)
        try checkDocs(&err)
        return wvTakeBuffer(rv, outLen, wvReadDocument)
    }

    /// The number of documents currently held
    public func size() -> Int32 {
        var err = WvError()
        let rv = docs_everywhere_docs_Notebook_size(ptr, &err)
        wvTrap(&err)
        return rv
    }

    /// The largest number of documents one notebook will hold
    public static func maxDocuments() -> Int32 {
        wvLoad()
        var err = WvError()
        let rv = docs_everywhere_docs_Notebook_max_documents(&err)
        wvTrap(&err)
        return rv
    }
}

public enum Docs {
    /// Create a brand new document.
    ///
    /// The document starts in `Draft` status; callers must publish
    /// it explicitly to make it visible.
    /// - Parameter title: Human-readable title for the new document
    /// - Parameter tags: Initial set of tags (may be empty)
    public static func createDocument(title: String, tags: [String]) -> Document {
        wvLoad()
        var err = WvError()
        var tagsWriter = WvWriter()
        tagsWriter.writeLen(tags.count)
        for v0 in tags {
            tagsWriter.writeString(v0)
        }
        var outLen = 0
        let rv: UnsafePointer<UInt8>? = wvWithUTF8(title) { title_ptr, title_len in
            wvWithBuffer(tagsWriter) { tags_ptr, tags_len in
                docs_everywhere_docs_create_document(title_ptr, title_len, tags_ptr, tags_len, &outLen, &err)
            }
        }
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen, wvReadDocument)
    }

    /// Look up a document by identifier
    /// - Parameter id: Identifier returned from create_document
    public static func getDocument(id: Int64) -> Document? {
        wvLoad()
        var err = WvError()
        var outLen = 0
        let rv = docs_everywhere_docs_get_document(id, &outLen, &err)
        wvTrap(&err)
        return wvTakeBuffer(rv, outLen) { (r: inout WvReader) -> Document? in
            var v0: Document? = nil
            if r.readOptionFlag() {
                let v1 = wvReadDocument(&r)
                v0 = v1
            }
            return v0
        }
    }

    /// Publish a document in the background
    /// - Parameter id: Identifier of the document to publish
    public static func publishAsync(id: Int64) async -> Bool {
        wvLoad()
        return await withCheckedContinuation { (continuation: CheckedContinuation<Bool, Never>) in
            let context = Unmanaged.passRetained(WvContinuation(continuation)).toOpaque()
            docs_everywhere_docs_publish_async(id, { context, err, result in
                let cont = Unmanaged<WvContinuation<Bool, Never>>.fromOpaque(context!).takeRetainedValue().value
                if let err = err {
                    wvTrapBoxed(err)
                }
                cont.resume(returning: result)
            }, context)
        }
    }

    /// Register a listener for saved notifications
    /// - Parameter listener: Receiver of saved notifications
    public static func watch(listener: SavedListener) {
        wvLoad()
        var err = WvError()
        let listener_ctx = Unmanaged.passRetained(WvSavedListenerBox(listener)).toOpaque()
        docs_everywhere_docs_watch(listener_ctx, WvSavedListenerVtable.shared.pointer, &err)
        wvTrap(&err)
    }
}

