        const _l = _listeners.get(id);
        if (_l === undefined) return;
        _listeners.delete(id);
        wasm.weaveffi_edge_cases_unregister_tick_listener(_l.rid);
      },
      Widget: Widget,
      Vault: Vault,
    },
  };
}

// END weaveffi_wasm.js
