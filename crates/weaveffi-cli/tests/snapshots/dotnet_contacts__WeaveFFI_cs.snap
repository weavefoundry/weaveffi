    public sealed class Contact
    {
        public long Id { get; }

        public string FirstName { get; }

        public string LastName { get; }

        public string? Email { get; }

        public ContactType ContactType { get; }

        public Contact(long id, string firstName, string lastName, string? email, ContactType contactType)
        {
            Id = id;
            FirstName = firstName;
            LastName = lastName;
            Email = email;
            ContactType = contactType;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI64(Id);
            writer.WriteString(FirstName);
            writer.WriteString(LastName);
            if (Email != null)
            {
                writer.WriteOptionFlag(true);
                writer.WriteString(Email!);
            }
            else
            {
                writer.WriteOptionFlag(false);
            }
            writer.WriteI32((int)ContactType);
        }

        internal static Contact ReadFrom(WeaveFFIBufferReader reader)
        {
            var fId = reader.ReadI64();
            var fFirstName = reader.ReadString();
            var fLastName = reader.ReadString();
            string? fEmail = null;
            if (reader.ReadOptionFlag())
            {
                var fEmailValue = reader.ReadString();
                fEmail = fEmailValue;
            }
            var fContactType = (ContactType)reader.ReadI32();
            return new Contact(fId, fFirstName, fLastName, fEmail, fContactType);
        }
    }

