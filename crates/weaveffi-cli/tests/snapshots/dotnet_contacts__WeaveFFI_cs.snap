    /// <summary>Typed exception for the ContactsError error domain (module contacts).</summary>
    public class ContactsException : WeaveFFIException
    {
        /// <summary>name must not be empty</summary>
        public const int InvalidName = 1;
        /// <summary>contact not found</summary>
        public const int NotFound = 2;

        public ContactsException(int code, string message) : base(code, message)
        {
        }

        /// <summary>Wraps a raw error slot in the typed exception, falling
        /// back to <see cref="WeaveFFIException"/> for unknown codes. Codes
        /// declaring payload fields decode them into Data.</summary>
        internal static WeaveFFIException FromCode(int code, string message, byte[]? payload)
        {
            switch (code)
            {
                case InvalidName:
                    return new ContactsException(code, string.IsNullOrEmpty(message) ? "name must not be empty" : message);
                case NotFound:
                    return new ContactsException(code, string.IsNullOrEmpty(message) ? "contact not found" : message);
                default:
                    return new WeaveFFIException(code, message);
            }
        }
    }

