// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

#include <jni.h>
#include <stdbool.h>
#include <stdint.h>
#include <stddef.h>
#include <stdlib.h>
#include "weaveffi.h"

static void throw_weaveffi_error(JNIEnv* env, weaveffi_error* err) {
    const char* msg = err->message ? err->message : "WeaveFFI error";
    jclass exClass = (*env)->FindClass(env, "com/weaveffi/WeaveFFIException");
    if (exClass != NULL) {
        jmethodID ctor = (*env)->GetMethodID(env, exClass, "<init>", "(ILjava/lang/String;)V");
        jstring jmsg = (*env)->NewStringUTF(env, msg);
        jthrowable ex = (jthrowable)(*env)->NewObject(env, exClass, ctor, (jint)err->code, jmsg);
        if (ex != NULL) { (*env)->Throw(env, ex); }
    }
    weaveffi_error_clear(err);
}

static void throw_weaveffi_calculator_CalcError(JNIEnv* env, weaveffi_error* err) {
    jclass exClass = (*env)->FindClass(env, "com/weaveffi/CalcException");
    jmethodID fromCode = exClass ? (*env)->GetStaticMethodID(env, exClass, "fromCode", "(ILjava/lang/String;[B)Lcom/weaveffi/WeaveFFIException;") : NULL;
    if (fromCode == NULL) {
        (*env)->ExceptionClear(env);
        throw_weaveffi_error(env, err);
        return;
    }
    const char* msg = err->message ? err->message : "WeaveFFI error";
    jstring jmsg = (*env)->NewStringUTF(env, msg);
    jbyteArray jpayload = NULL;
    if (err->payload_ptr != NULL) {
        jpayload = (*env)->NewByteArray(env, (jsize)err->payload_len);
        if (jpayload != NULL) { (*env)->SetByteArrayRegion(env, jpayload, 0, (jsize)err->payload_len, (const jbyte*)err->payload_ptr); }
    }
    jthrowable ex = (jthrowable)(*env)->CallStaticObjectMethod(env, exClass, fromCode, (jint)err->code, jmsg, jpayload);
    if (ex != NULL && !(*env)->ExceptionCheck(env)) { (*env)->Throw(env, ex); }
    weaveffi_error_clear(err);
}

JNIEXPORT jint JNICALL Java_com_weaveffi_WeaveFFI_add(JNIEnv* env, jclass clazz, jint a, jint b) {
    weaveffi_error err = {0, NULL, NULL, 0};
    int32_t rv = weaveffi_calculator_add((int32_t)a, (int32_t)b, &err);
    if (err.code != 0) {
        throw_weaveffi_error(env, &err);
        return 0;
    }
    return (jint) rv;
}

JNIEXPORT jint JNICALL Java_com_weaveffi_WeaveFFI_mul(JNIEnv* env, jclass clazz, jint a, jint b) {
    weaveffi_error err = {0, NULL, NULL, 0};
    int32_t rv = weaveffi_calculator_mul((int32_t)a, (int32_t)b, &err);
    if (err.code != 0) {
        throw_weaveffi_error(env, &err);
        return 0;
    }
    return (jint) rv;
}

JNIEXPORT jint JNICALL Java_com_weaveffi_WeaveFFI_div(JNIEnv* env, jclass clazz, jint a, jint b) {
    weaveffi_error err = {0, NULL, NULL, 0};
    int32_t rv = weaveffi_calculator_div((int32_t)a, (int32_t)b, &err);
    if (err.code != 0) {
        throw_weaveffi_calculator_CalcError(env, &err);
        return 0;
    }
    return (jint) rv;
}

JNIEXPORT jstring JNICALL Java_com_weaveffi_WeaveFFI_echo(JNIEnv* env, jclass clazz, jstring s) {
    weaveffi_error err = {0, NULL, NULL, 0};
    const char* s_chars = (*env)->GetStringUTFChars(env, s, NULL);
    const char* rv = weaveffi_calculator_echo(s_chars, &err);
    (*env)->ReleaseStringUTFChars(env, s, s_chars);
    if (err.code != 0) {
        throw_weaveffi_error(env, &err);
        return NULL;
    }
    jstring out = rv ? (*env)->NewStringUTF(env, rv) : (*env)->NewStringUTF(env, "");
    weaveffi_free_string(rv);
    return out;
}


