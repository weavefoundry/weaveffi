// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

package com.weaveffi

import kotlinx.coroutines.suspendCancellableCoroutine
import kotlin.coroutines.resume
import kotlin.coroutines.resumeWithException

class WeaveFFI {
    companion object {
        init { System.loadLibrary("weaveffi") }

        @Volatile private var callbackExceptionHandler: ((Throwable) -> Unit)? = null

        /**
         * Installs a handler for exceptions thrown by listener callbacks and
         * async continuations on native producer threads. These exceptions have
         * no Kotlin caller to propagate to; when no handler is installed, they
         * are logged with their stack trace and dropped. Pass `null` to
         * restore the default logging behavior.
         */
        @JvmStatic fun setCallbackExceptionHandler(handler: ((Throwable) -> Unit)?) {
            callbackExceptionHandler = handler
        }

        // Invoked from the JNI glue; rethrowing signals "no handler" so the
        // glue falls back to ExceptionDescribe.
        @JvmStatic private fun dispatchCallbackException(t: Throwable) {
            callbackExceptionHandler?.invoke(t) ?: throw t
        }

        /**
         * Subscribe to per-key eviction notifications
         *
         * Exceptions thrown by the callback cannot propagate to a caller (events fire on a producer thread); they are delivered to the handler installed via [setCallbackExceptionHandler], or logged with their stack trace and dropped when no handler is set.
         */
        @JvmStatic external fun registerEvictionListener(callback: (String) -> Unit): Long
        @JvmStatic external fun unregisterEvictionListener(id: Long)
        /**
         * Snapshot the current store statistics
         */
        @JvmStatic private external fun getStatsJni(store: Long): ByteArray
        @JvmStatic fun getStats(store: Store): Stats = weaveDecode(getStatsJni(store.handle)) { r -> unpackStats(r) }
    }
}

/** Persistence semantics applied to a stored entry */
enum class EntryKind(val value: Int) {
    /** In-memory only; lost on close */
    Volatile(0),
    /** Flushed to durable storage */
    Persistent(1),
    /** Persistent and encrypted at rest */
    Encrypted(2);

    companion object {
        fun fromValue(value: Int): EntryKind = entries.first { it.value == value }
    }
}

/** A single key-value entry persisted in the store */
data class Entry(
    /** Stable monotonic identifier assigned on insert */
    val id: Long,
    /** UTF-8 lookup key */
    val key: String,
    /** Opaque binary payload */
    val value: ByteArray,
    /** Unix-timestamp seconds when the entry was created */
    val created_at: Long,
    /** Optional unix-timestamp seconds at which the entry expires */
    val expires_at: Long?,
    /** Free-form labels attached to the entry */
    val tags: List<String>,
    /** Arbitrary string-valued metadata pairs */
    val metadata: Map<String, String>,
)

internal fun packEntry(w: WeaveBufferWriter, v: Entry) {
    w.writeI64(v.id)
    w.writeString(v.key)
    w.writeBytes(v.value)
    w.writeI64(v.created_at)
    w.writeOptional(v.expires_at) { v0 -> w.writeI64(v0) }
    w.writeList(v.tags) { v0 -> w.writeString(v0) }
    w.writeMap(v.metadata, { k0 -> w.writeString(k0) }, { v0 -> w.writeString(v0) })
}

internal fun unpackEntry(r: WeaveBufferReader): Entry = Entry(
    r.readI64(),
    r.readString(),
    r.readBytes(),
    r.readI64(),
    r.readOptional { r.readI64() },
    r.readList { r.readString() },
    r.readMap({ r.readString() }, { r.readString() }),
)

/** An in-memory key-value store owning its entries; destroying the object releases all of its state */
class Store internal constructor(internal var handle: Long) : java.io.Closeable {
    companion object {
        init { System.loadLibrary("weaveffi") }

        @JvmStatic private external fun nativeOpen(path: String): Long
        @JvmStatic private external fun nativeDefaultCapacity(): Long
        @JvmStatic private external fun nativePut(selfHandle: Long, key: String, value: ByteArray, kind: Int, ttlSeconds: ByteArray): Boolean
        @JvmStatic private external fun nativeGet(selfHandle: Long, key: String): ByteArray
        @JvmStatic private external fun nativeDelete(selfHandle: Long, key: String): Boolean
        @JvmStatic private external fun nativeListKeys(selfHandle: Long, prefix: ByteArray): Long
        @JvmStatic private external fun nativeCount(selfHandle: Long): Long
        @JvmStatic private external fun nativeClear(selfHandle: Long): Unit
        @JvmStatic private external fun nativeCompactAsync(selfHandle: Long, cancelToken: Long, callback: Any)
        @JvmStatic private external fun nativeLegacyPut(selfHandle: Long, key: String, value: ByteArray): Boolean
        @JvmStatic private external fun nativeDestroy(handle: Long)

        /**
         * Open (or create) a store backed by the given filesystem path
         */
        fun open(path: String): Store = Store(nativeOpen(path))

        /**
         * The largest number of live entries one store will hold
         */
        fun defaultCapacity(): Long = nativeDefaultCapacity()
    }

    /**
     * Insert or replace a value, returning true on success
     */
    fun put(key: String, value: ByteArray, kind: EntryKind, ttlSeconds: Long?): Boolean = nativePut(handle, key, value, kind.value, weaveEncode { w -> w.writeOptional(ttlSeconds) { v0 -> w.writeI64(v0) } })

    /**
     * Look up an entry by key; returns null if missing or expired
     */
    fun get(key: String): Entry? = weaveDecode(nativeGet(handle, key)) { r -> r.readOptional { unpackEntry(r) } }

    /**
     * Remove the entry for the given key, returning true if it existed
     */
    fun delete(key: String): Boolean = nativeDelete(handle, key)

    /**
     * Stream every key, optionally filtered by a prefix
     */
    fun listKeys(prefix: String?): Iterator<String> = KvStoreListKeysIterator(nativeListKeys(handle, weaveEncode { w -> w.writeOptional(prefix) { v0 -> w.writeString(v0) } }))

    /**
     * Return the number of live entries in the store
     */
    fun count(): Long = nativeCount(handle)

    /**
     * Drop every entry from the store
     */
    fun clear() { nativeClear(handle) }

    /**
     * Reclaim space asynchronously; returns the number of bytes reclaimed
     */
    suspend fun compact(): Long = suspendCancellableCoroutine { cont ->
        nativeCompactAsync(handle, 0L, WeaveContinuation(cont) { code, message, payload -> KvException.fromCode(code, message, payload) })
    }

    /**
     * Legacy single-shot put kept for compatibility
     */
    @Deprecated("use put() with explicit kind")
    fun legacyPut(key: String, value: ByteArray): Boolean = nativeLegacyPut(handle, key, value)

    override fun close() {
        if (handle != 0L) {
            nativeDestroy(handle)
            handle = 0L
        }
    }

    protected fun finalize() {
        close()
    }
}

/**
 * A lazy iterator over the `String` elements streamed by [listKeys]. Each step pulls
 * exactly one element from the native producer. The native handle is
 * released when the producer is exhausted, when [close] is called, or by
 * the finalizer if the iterator is abandoned, whichever comes first.
 */
class KvStoreListKeysIterator internal constructor(private var handle: Long) : Iterator<String>, java.io.Closeable {
    private var nextSlot: Array<Any?>? = null

    override fun hasNext(): Boolean {
        if (nextSlot != null) return true
        if (handle == 0L) return false
        val slot = nativeNext(handle)
        if (slot == null) {
            close()
            return false
        }
        nextSlot = slot
        return true
    }

    override fun next(): String {
        if (!hasNext()) throw NoSuchElementException()
        val raw = nextSlot!![0]
        nextSlot = null
        return raw as String
    }

    override fun close() {
        if (handle != 0L) {
            nativeDestroy(handle)
            handle = 0L
        }
    }

    protected fun finalize() {
        close()
    }

    companion object {
        init { System.loadLibrary("weaveffi") }

        @JvmStatic private external fun nativeNext(handle: Long): Array<Any?>?
        @JvmStatic private external fun nativeDestroy(handle: Long)
    }
}

/** Aggregate store statistics */
data class Stats(
    /** Number of live entries */
    val total_entries: Long,
    /** Sum of all value byte lengths */
    val total_bytes: Long,
    /** Number of entries past their TTL but not yet evicted */
    val expired_entries: Long,
)

internal fun packStats(w: WeaveBufferWriter, v: Stats) {
    w.writeI64(v.total_entries)
    w.writeI64(v.total_bytes)
    w.writeI64(v.expired_entries)
}

internal fun unpackStats(r: WeaveBufferReader): Stats = Stats(
    r.readI64(),
    r.readI64(),
    r.readI64(),
)

/** Generic WeaveFFI failure: panics, marshalling errors, and unknown codes. */
open class WeaveFFIException(val code: Int, message: String) : Exception(message)

/** Typed error domain `KvError` declared by module `kv`. */
sealed class KvException(code: Int, message: String) : WeaveFFIException(code, message) {
    /** No entry exists for the requested key */
    class KeyNotFound(message: String = "key not found") : KvException(1001, message)
    /** The entry exists but its TTL has elapsed */
    class Expired(message: String = "entry expired") : KvException(1002, message)
    /** The store has reached its capacity limit */
    class StoreFull(message: String = "store has reached capacity") : KvException(1003, message)
    /** Underlying storage reported an I/O failure */
    class IoError(message: String = "I/O failure") : KvException(1004, message)

    companion object {
        /** Map a raw `KvError` code and payload to the typed exception; unknown codes yield the generic [WeaveFFIException]. */
        @JvmStatic fun fromCode(code: Int, message: String, payload: ByteArray?): WeaveFFIException = when (code) {
            1001 -> KeyNotFound(message)
            1002 -> Expired(message)
            1003 -> StoreFull(message)
            1004 -> IoError(message)
            else -> WeaveFFIException(code, message)
        }
    }
}

/** Growable little-endian writer implementing the WeaveFFI value-buffer wire format. */
internal class WeaveBufferWriter {
    private var buf = ByteArray(32)
    private var len = 0

    private fun reserve(extra: Int) {
        if (len + extra <= buf.size) return
        var cap = buf.size * 2
        while (cap < len + extra) cap *= 2
        buf = buf.copyOf(cap)
    }

    fun toByteArray(): ByteArray = buf.copyOf(len)

    fun writeBool(v: Boolean) { reserve(1); buf[len++] = if (v) 1 else 0 }
    fun writeI8(v: Byte) { reserve(1); buf[len++] = v }
    fun writeI16(v: Short) {
        reserve(2)
        val b = v.toInt()
        buf[len++] = (b and 0xFF).toByte()
        buf[len++] = ((b shr 8) and 0xFF).toByte()
    }
    fun writeI32(v: Int) {
        reserve(4)
        buf[len++] = (v and 0xFF).toByte()
        buf[len++] = ((v shr 8) and 0xFF).toByte()
        buf[len++] = ((v shr 16) and 0xFF).toByte()
        buf[len++] = ((v shr 24) and 0xFF).toByte()
    }
    fun writeU32(v: Long) = writeI32(v.toInt())
    fun writeI64(v: Long) {
        writeI32(v.toInt())
        writeI32((v ushr 32).toInt())
    }
    fun writeF32(v: Float) = writeI32(v.toRawBits())
    fun writeF64(v: Double) = writeI64(v.toRawBits())
    fun writeString(v: String) = writeBytes(v.toByteArray(Charsets.UTF_8))
    fun writeBytes(v: ByteArray) {
        writeI32(v.size)
        reserve(v.size)
        v.copyInto(buf, len)
        len += v.size
    }
    fun <T> writeOptional(v: T?, write: (T) -> Unit) {
        if (v == null) writeBool(false) else { writeBool(true); write(v) }
    }
    fun <T> writeList(v: List<T>, write: (T) -> Unit) {
        writeI32(v.size)
        for (e in v) write(e)
    }
    fun <K, V> writeMap(v: Map<K, V>, writeKey: (K) -> Unit, writeValue: (V) -> Unit) {
        writeI32(v.size)
        for ((k, e) in v) { writeKey(k); writeValue(e) }
    }
}

/** Validating little-endian reader for the WeaveFFI value-buffer wire format. */
internal class WeaveBufferReader(private val buf: ByteArray) {
    private var pos = 0

    private fun malformed(detail: String): Nothing =
        throw WeaveFFIException(-2, "malformed WeaveFFI value buffer: " + detail)

    private fun take(n: Int): Int {
        if (n > buf.size - pos) malformed("truncated buffer")
        val at = pos
        pos += n
        return at
    }

    fun readBool(): Boolean = when (buf[take(1)].toInt()) {
        0 -> false
        1 -> true
        else -> malformed("invalid bool byte")
    }
    fun readI8(): Byte = buf[take(1)]
    fun readI16(): Short {
        val at = take(2)
        return ((buf[at].toInt() and 0xFF) or ((buf[at + 1].toInt() and 0xFF) shl 8)).toShort()
    }
    fun readI32(): Int {
        val at = take(4)
        return (buf[at].toInt() and 0xFF) or
            ((buf[at + 1].toInt() and 0xFF) shl 8) or
            ((buf[at + 2].toInt() and 0xFF) shl 16) or
            ((buf[at + 3].toInt() and 0xFF) shl 24)
    }
    fun readU32(): Long = readI32().toLong() and 0xFFFFFFFFL
    fun readI64(): Long {
        val lo = readI32().toLong() and 0xFFFFFFFFL
        val hi = readI32().toLong()
        return lo or (hi shl 32)
    }
    fun readF32(): Float = Float.fromBits(readI32())
    fun readF64(): Double = Double.fromBits(readI64())
    private fun readLen(): Int {
        val n = readI32()
        if (n < 0 || n > buf.size - pos) malformed("length prefix exceeds remaining bytes")
        return n
    }
    fun readString(): String {
        val n = readLen()
        val at = take(n)
        return try {
            Charsets.UTF_8.newDecoder().decode(java.nio.ByteBuffer.wrap(buf, at, n)).toString()
        } catch (e: java.nio.charset.CharacterCodingException) {
            malformed("string is not valid UTF-8")
        }
    }
    fun readBytes(): ByteArray {
        val n = readLen()
        val at = take(n)
        return buf.copyOfRange(at, at + n)
    }
    fun <T> readOptional(read: () -> T): T? = if (readBool()) read() else null
    fun <T> readList(read: () -> T): List<T> {
        val n = readLen()
        val out = ArrayList<T>(n)
        repeat(n) { out.add(read()) }
        return out
    }
    fun <K, V> readMap(readKey: () -> K, readValue: () -> V): Map<K, V> {
        val n = readLen()
        val out = LinkedHashMap<K, V>()
        repeat(n) { out[readKey()] = readValue() }
        return out
    }
    fun expectEnd() {
        if (pos != buf.size) malformed("trailing bytes after value")
    }
}

internal fun weaveEncode(write: (WeaveBufferWriter) -> Unit): ByteArray {
    val w = WeaveBufferWriter()
    write(w)
    return w.toByteArray()
}

internal fun <T> weaveDecode(bytes: ByteArray, read: (WeaveBufferReader) -> T): T {
    val r = WeaveBufferReader(bytes)
    val v = read(r)
    r.expectEnd()
    return v
}

internal class WeaveContinuation<T>(
    private val cont: kotlinx.coroutines.CancellableContinuation<T>,
    private val mapError: (Int, String, ByteArray?) -> Throwable
) {
    @Suppress("UNCHECKED_CAST")
    fun onSuccess(result: Any?) { cont.resume(result as T) }
    fun onError(code: Int, message: String, payload: ByteArray?) { cont.resumeWithException(mapError(code, message, payload)) }
}

// END WeaveFFI.kt
