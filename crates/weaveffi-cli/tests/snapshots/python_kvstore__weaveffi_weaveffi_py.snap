# Fires when an entry is evicted from the store
# Callback type OnEvict: Callable[[str], None]
_CFUNC_weaveffi_kv_OnEvict_fn = ctypes.CFUNCTYPE(None, ctypes.c_char_p, ctypes.c_void_p)


def register_eviction_listener(callback: Callable[[str], None]) -> int:
    """
    Subscribe to per-key eviction notifications

    Returns a subscription id for unregister_eviction_listener().
    """
    def _trampoline(key, _context):
        callback(_bytes_to_string(key))
    _cfunc = _CFUNC_weaveffi_kv_OnEvict_fn(_trampoline)
    _fn = _lib.weaveffi_kv_register_eviction_listener
    _fn.argtypes = [_CFUNC_weaveffi_kv_OnEvict_fn, ctypes.c_void_p]
    _fn.restype = ctypes.c_uint64
    _listener_id = int(_fn(_cfunc, None))
    _listener_refs[_listener_id] = _cfunc
    return _listener_id


def unregister_eviction_listener(listener_id: int) -> None:
    """Unregister a listener previously registered with register_eviction_listener()."""
    _fn = _lib.weaveffi_kv_unregister_eviction_listener
    _fn.argtypes = [ctypes.c_uint64]
    _fn.restype = None
    _fn(ctypes.c_uint64(listener_id))
    _listener_refs.pop(listener_id, None)


# === Module: kv_stats ===

@dataclass
class Stats:
    """Aggregate store statistics"""

    # Number of live entries
    total_entries: int
    # Sum of all value byte lengths
    total_bytes: int
    # Number of entries past their TTL but not yet evicted
    expired_entries: int


def _write_Stats(_w: _BufferWriter, value: "Stats") -> None:
    _w.write_i64(value.total_entries)
    _w.write_i64(value.total_bytes)
    _w.write_i64(value.expired_entries)


def _read_Stats(_r: _BufferReader) -> "Stats":
    return Stats(
        total_entries=_r.read_i64(),
        total_bytes=_r.read_i64(),
        expired_entries=_r.read_i64(),
    )


def _pack_Stats(value: "Stats") -> bytes:
    _w = _BufferWriter()
    _write_Stats(_w, value)
    return _w.finish()


def _unpack_Stats(data: bytes) -> "Stats":
    return _decode_buffer(data, _read_Stats)


def get_stats(store: "Store") -> "Stats":
    """Snapshot the current store statistics

    Raises
    ------
    KvError
        If the call reports one of the domain's error codes.
    """
    _fn = _lib.weaveffi_kv_stats_get_stats
    _fn.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(_WeaveFFIErrorStruct)]
    _fn.restype = ctypes.c_void_p
    _err = _WeaveFFIErrorStruct()
    _out_len = ctypes.c_size_t(0)
    _result = _fn(store._ptr, ctypes.byref(_out_len), ctypes.byref(_err))
    _check_kv_error(_err)
    _data = _take_buffer(_result, _out_len.value)
    return _unpack_Stats(_data)

# END weaveffi.py
