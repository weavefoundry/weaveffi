            writer.WriteString(Status);
        }

        internal static Order ReadFrom(WeaveFFIBufferReader reader)
        {
            var fId = reader.ReadI64();
            var fItemsCount = reader.ReadLen();
            var fItems = new OrderItem[fItemsCount];
            for (int i0 = 0; i0 < fItemsCount; i0++)
