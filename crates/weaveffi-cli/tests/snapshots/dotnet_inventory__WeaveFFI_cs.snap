    /// <summary>Typed exception for the ProductsError error domain (module products).</summary>
    public class ProductsException : WeaveFFIException
    {
        /// <summary>price must be positive</summary>
        public const int InvalidPrice = 1;
        /// <summary>product not found</summary>
        public const int ProductNotFound = 2;

        public ProductsException(int code, string message) : base(code, message)
        {
        }

        /// <summary>Wraps a raw error slot in the typed exception, falling
        /// back to <see cref="WeaveFFIException"/> for unknown codes. Codes
        /// declaring payload fields decode them into Data.</summary>
        internal static WeaveFFIException FromCode(int code, string message, byte[]? payload)
        {
            switch (code)
            {
                case InvalidPrice:
                    return new ProductsException(code, string.IsNullOrEmpty(message) ? "price must be positive" : message);
                case ProductNotFound:
                    return new ProductsException(code, string.IsNullOrEmpty(message) ? "product not found" : message);
                default:
                    return new WeaveFFIException(code, message);
            }
        }
    }

