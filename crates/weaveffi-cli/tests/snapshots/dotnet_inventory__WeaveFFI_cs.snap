    public sealed class OrderItem
    {
        public long ProductId { get; }

        public int Quantity { get; }

        public double UnitPrice { get; }

        public OrderItem(long productId, int quantity, double unitPrice)
        {
            ProductId = productId;
            Quantity = quantity;
            UnitPrice = unitPrice;
        }

        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI64(ProductId);
            writer.WriteI32(Quantity);
            writer.WriteF64(UnitPrice);
        }

        internal static OrderItem ReadFrom(WeaveFFIBufferReader reader)
        {
            var fProductId = reader.ReadI64();
            var fQuantity = reader.ReadI32();
            var fUnitPrice = reader.ReadF64();
            return new OrderItem(fProductId, fQuantity, fUnitPrice);
        }
    }

    public sealed class Order
    {
