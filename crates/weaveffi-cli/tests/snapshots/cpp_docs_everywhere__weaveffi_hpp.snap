namespace weaveffi {

/** Base exception for every error reported through the C ABI. */
class WeaveFFIError : public std::runtime_error {
    int32_t code_;

public:
    WeaveFFIError(int32_t code, const std::string& msg) : std::runtime_error(msg), code_(code) {}
    int32_t code() const { return code_; }
};

namespace detail {

/** Throw the generic WeaveFFIError if `err` carries a nonzero code. */
inline void check(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    int32_t code = err.code;
    weaveffi_error_clear(&err);
    throw WeaveFFIError(code, msg);
}

/** Wrap an async-callback error as the generic WeaveFFIError. */
inline std::exception_ptr make_error(int32_t code, const std::string& msg) {
    return std::make_exception_ptr(WeaveFFIError(code, msg));
}

} // namespace detail

namespace detail {

/**
 * Serializes values into the WeaveFFI value-buffer wire format: little-endian,
 * packed with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a string, byte-buffer, or collection length as a u32. */
    void write_len(size_t n) { append_le(static_cast<uint32_t>(n)); }

    void write_string(const std::string& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }
};

/**
 * Decodes values from the WeaveFFI value-buffer wire format. A malformed
 * buffer is a producer/consumer contract violation (both sides are generated
 * from one IDL), so every decode failure throws the generic WeaveFFIError,
 * the same channel as a producer panic.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    [[noreturn]] static void fail(const char* what) {
        throw WeaveFFIError(-2, std::string("malformed WeaveFFI value buffer: ") + what);
    }

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    BufferReader(const uint8_t* data, size_t len) : data_(data), len_(len), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a length prefix, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with weaveffi_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    ~BufferGuard() {
        if (ptr != nullptr) weaveffi_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

} // namespace detail

/**
 * Lifecycle status of a document.
 *
 * Used to drive UI badges and filters.
 */
enum class Status : int32_t {
    /** Document is being edited */
    Draft = 0,
    /** Document is publicly visible */
    Published = 1,
    /** Document is hidden from listings */
    Archived = 2
};

/**
 * Represents a single document tracked by the system.
 *
 * Documents are persisted to disk and exposed via the public API.
 */
struct Document {
    /** Stable opaque identifier */
    int64_t id;
    /** Human-readable title shown in lists */
    std::string title;
    /** Current lifecycle status */
    Status status;
    /** Free-form tags for grouping */
    std::vector<std::string> tags;
};

namespace detail {

/** Encodes a `Document` in the WeaveFFI value-buffer format. */
inline void write_Document(BufferWriter& w, const Document& v) {
    w.write_i64(v.id);
    w.write_string(v.title);
    w.write_i32(static_cast<int32_t>(v.status));
    w.write_len(v.tags.size());
    for (const auto& item0 : v.tags) {
        w.write_string(item0);
    }
}

/** Decodes a `Document` from the WeaveFFI value-buffer format. */
inline Document read_Document(BufferReader& r) {
    Document out{};
    out.id = r.read_i64();
    out.title = r.read_string();
    out.status = static_cast<Status>(r.read_i32());
    {
        size_t v_tags_n = r.read_len();
        out.tags.reserve(v_tags_n);
        for (size_t v_tags_i = 0; v_tags_i < v_tags_n; ++v_tags_i) {
            std::string v_tags_item = r.read_string();
            out.tags.push_back(std::move(v_tags_item));
        }
    }
    return out;
}

} // namespace detail

/** Typed errors reported by the `docs` module's throwing functions. */
class DocsErrorsError : public WeaveFFIError {
public:
    DocsErrorsError(int32_t code, const std::string& msg) : WeaveFFIError(code, msg) {}
};

/** Returned when no document matches the requested id */
class NotFoundError : public DocsErrorsError {
public:
    NotFoundError(const std::string& msg) : DocsErrorsError(1, msg) {}
};

/** Raised when attempting to move into a forbidden state */
class InvalidStatusError : public DocsErrorsError {
public:
    InvalidStatusError(const std::string& msg) : DocsErrorsError(2, msg) {}
};

namespace detail {

/** Map a `docs` error code and payload to its typed exception (DocsErrorsError for unknown codes). */
inline std::exception_ptr make_docs_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    switch (code) {
    case 1: return std::make_exception_ptr(NotFoundError(msg));
    case 2: return std::make_exception_ptr(InvalidStatusError(msg));
    default: return std::make_exception_ptr(DocsErrorsError(code, msg));
    }
}

/** Throw the typed `docs` exception if `err` carries a nonzero code. */
inline void check_docs(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    std::exception_ptr ex = make_docs_error(err.code, msg, err.payload_ptr, err.payload_len);
    weaveffi_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

namespace detail {

inline std::mutex& wv_listener_mutex() {
    static std::mutex m;
    return m;
}

inline std::unordered_map<uint64_t, std::shared_ptr<void>>& wv_listener_registry() {
    static std::unordered_map<uint64_t, std::shared_ptr<void>> registry;
    return registry;
}

} // namespace detail

/**
 * An ordered collection of documents.
 *
 * Notebooks own their documents and release them when destroyed.
 */
class Notebook {
    void* handle_;

public:
    explicit Notebook(void* h) : handle_(h) {}

    ~Notebook() {
        if (handle_) weaveffi_docs_Notebook_destroy(static_cast<weaveffi_docs_Notebook*>(handle_));
    }

    Notebook(const Notebook&) = delete;
    Notebook& operator=(const Notebook&) = delete;

    Notebook(Notebook&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    Notebook& operator=(Notebook&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_docs_Notebook_destroy(static_cast<weaveffi_docs_Notebook*>(handle_));
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    void* handle() const { return handle_; }

    /** Create an empty notebook */
    Notebook() : handle_(nullptr) {
        weaveffi_error err{};
        auto result = weaveffi_docs_Notebook_new(&err);
        detail::check(err);
        handle_ = result;
    }

    /** Add a document, returning its position in the notebook */
    int32_t insert(const Document& document) const {
        detail::BufferWriter document_buf;
        detail::write_Document(document_buf, document);
        weaveffi_error err{};
        auto result = weaveffi_docs_Notebook_insert(static_cast<const weaveffi_docs_Notebook*>(handle_), document_buf.data(), document_buf.size(), &err);
        detail::check(err);
        return result;
    }

    /** Look up a document by identifier, failing when none matches */
    Document find(int64_t id) const {
        size_t out_len = 0;
        weaveffi_error err{};
        auto result = weaveffi_docs_Notebook_find(static_cast<const weaveffi_docs_Notebook*>(handle_), id, &out_len, &err);
        detail::check_docs(err);
        detail::BufferGuard result_guard{result, out_len};
        detail::BufferReader result_r(result, out_len);
        Document ret = detail::read_Document(result_r);
        result_r.expect_end();
        return ret;
    }

    /** The number of documents currently held */
    int32_t size() const {
        weaveffi_error err{};
        auto result = weaveffi_docs_Notebook_size(static_cast<const weaveffi_docs_Notebook*>(handle_), &err);
        detail::check(err);
        return result;
    }

    /** The largest number of documents one notebook will hold */
    static int32_t max_documents() {
        weaveffi_error err{};
        auto result = weaveffi_docs_Notebook_max_documents(&err);
        detail::check(err);
        return result;
    }

};

namespace docs {

/** Subscribe to document-saved notifications */
/** @return A subscription id for unregister_saved_listener(). */
inline uint64_t register_saved_listener(std::function<void(int64_t, int32_t)> callback) {
    auto fn = std::make_shared<std::function<void(int64_t, int32_t)>>(std::move(callback));
    uint64_t id = weaveffi_docs_register_saved_listener(
        [](int64_t doc_id, int32_t revision, void* context) {
            auto& cb = *static_cast<std::function<void(int64_t, int32_t)>*>(context);
            cb(doc_id, revision);
        },
        fn.get());
    std::lock_guard<std::mutex> lock(detail::wv_listener_mutex());
    detail::wv_listener_registry()[id] = fn;
    return id;
}

/** Unregisters a listener previously registered with register_saved_listener(). */
inline void unregister_saved_listener(uint64_t id) {
    weaveffi_docs_unregister_saved_listener(id);
    std::lock_guard<std::mutex> lock(detail::wv_listener_mutex());
    detail::wv_listener_registry().erase(id);
}

/**
 * Create a brand new document.
 *
 * The document starts in `Draft` status; callers must publish
 * it explicitly to make it visible.
 */
inline Document create_document(const std::string& title, const std::vector<std::string>& tags) {
    detail::BufferWriter tags_buf;
    tags_buf.write_len(tags.size());
    for (const auto& item0 : tags) {
        tags_buf.write_string(item0);
    }
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_docs_create_document(title.c_str(), tags_buf.data(), tags_buf.size(), &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    Document ret = detail::read_Document(result_r);
    result_r.expect_end();
    return ret;
}

/** Look up a document by identifier */
inline std::optional<Document> get_document(int64_t id) {
    size_t out_len = 0;
    weaveffi_error err{};
    auto result = weaveffi_docs_get_document(id, &out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard{result, out_len};
    detail::BufferReader result_r(result, out_len);
    std::optional<Document> ret{};
    if (result_r.read_option_flag()) {
        Document ret_v = detail::read_Document(result_r);
        ret = std::move(ret_v);
    }
    result_r.expect_end();
    return ret;
}

/** Publish a document in the background */
inline std::future<bool> publish_async(int64_t id) {
    auto* promise_ptr = new std::promise<bool>();
    auto future = promise_ptr->get_future();
    weaveffi_docs_publish_async_async(id, [](void* context, weaveffi_error* err, bool result) {
        auto* p = static_cast<std::promise<bool>*>(context);
        if (err && err->code != 0) {
            std::string msg(err->message ? err->message : "unknown error");
            p->set_exception(detail::make_error(err->code, msg));
        } else {
            p->set_value(result);
        }
        delete p;
    }, static_cast<void*>(promise_ptr));
    return future;
}

} // namespace docs

} // namespace weaveffi

// END weaveffi.hpp
