# Generated by WeaveFFI [VERSION] from api.yml
# DO NOT EDIT. Your changes will be overwritten.
# To regenerate: weaveffi generate api.yml -o <out>

cmake_minimum_required(VERSION 3.18)
project(docs_everywhere_jni C)

# The directory holding the producer library (libdocs_everywhere). Android builds
# default to the per-ABI copy under src/main/jniLibs/.
set(DOCS_EVERYWHERE_LIBRARY_DIR "" CACHE PATH "Directory holding the docs_everywhere producer library")
if(NOT DOCS_EVERYWHERE_LIBRARY_DIR AND ANDROID)
    set(DOCS_EVERYWHERE_LIBRARY_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../jniLibs/${ANDROID_ABI}")
endif()
if(DOCS_EVERYWHERE_LIBRARY_DIR)
    find_library(DOCS_EVERYWHERE_PRODUCER NAMES docs_everywhere PATHS "${DOCS_EVERYWHERE_LIBRARY_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
else()
    set(CMAKE_FIND_FRAMEWORK NEVER)
    find_library(DOCS_EVERYWHERE_PRODUCER NAMES docs_everywhere REQUIRED)
endif()

add_library(docs_everywhere_jni SHARED docs_everywhere_jni.c)
target_include_directories(docs_everywhere_jni PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(docs_everywhere_jni PRIVATE "${DOCS_EVERYWHERE_PRODUCER}")
if(NOT ANDROID)
    find_package(JNI REQUIRED)
    find_package(Threads REQUIRED)
    target_include_directories(docs_everywhere_jni PRIVATE ${JNI_INCLUDE_DIRS})
    target_link_libraries(docs_everywhere_jni PRIVATE Threads::Threads)
endif()

# END CMakeLists.txt
