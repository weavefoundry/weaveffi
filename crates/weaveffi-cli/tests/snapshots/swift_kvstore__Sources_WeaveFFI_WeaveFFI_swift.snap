            return valueBytes.withUnsafeBufferPointer { value_buf in
                let value_ptr = value_buf.baseAddress
                let value_len = value_buf.count
                return ttlSecondsWriter.bytes.withUnsafeBufferPointer { ttlSeconds_buf in
                    let ttlSeconds_ptr = ttlSeconds_buf.baseAddress
                    let ttlSeconds_len = ttlSeconds_buf.count
                    return weaveffi_kv_Store_put(ptr, key_ptr, value_ptr, value_len, weaveffi_kv_EntryKind(kind.rawValue), ttlSeconds_ptr, ttlSeconds_len, &err)
                }
            }
