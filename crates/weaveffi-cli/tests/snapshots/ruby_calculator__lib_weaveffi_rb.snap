    message.empty? ? cls.new : cls.new(message)
  end

  # Raises the typed CalcError for a non-zero error slot.
  def self.check_calc_error!(err)
    return if err[:code].zero?
    code = err[:code]
    msg_ptr = err[:message]
    msg = msg_ptr.null? ? '' : msg_ptr.read_string
    payload_ptr = err[:payload_ptr]
    payload = payload_ptr.null? ? nil : payload_ptr.read_string(err[:payload_len])
    weaveffi_error_clear(err.to_ptr)
