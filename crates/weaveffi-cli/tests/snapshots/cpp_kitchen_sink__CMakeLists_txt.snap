cmake_minimum_required(VERSION 3.14)
project(kitchen_sink_cpp VERSION 0.1.0 LANGUAGES CXX)

# The producer library to link: a full path from the KITCHEN_SINK_LIBRARY cache or
# environment variable, or else the library name `kitchen_sink` (a CMake target
# of that name, or libkitchen_sink on the linker search path).
set(KITCHEN_SINK_LIBRARY "$ENV{KITCHEN_SINK_LIBRARY}" CACHE FILEPATH "Path to the kitchen_sink native library")

add_library(kitchen_sink_cpp INTERFACE)
add_library(kitchen_sink::cpp ALIAS kitchen_sink_cpp)
target_include_directories(kitchen_sink_cpp INTERFACE ${CMAKE_CURRENT_SOURCE_DIR})
target_compile_features(kitchen_sink_cpp INTERFACE cxx_std_17)
if(KITCHEN_SINK_LIBRARY)
  target_link_libraries(kitchen_sink_cpp INTERFACE "${KITCHEN_SINK_LIBRARY}")
else()
  target_link_libraries(kitchen_sink_cpp INTERFACE kitchen_sink)
endif()

