    private static IntPtr Allocate()
    {
        var vtable = (Layout*)NativeMemory.Alloc((nuint)sizeof(Layout));
        vtable->on_batch = &OnBatchTrampoline;
        vtable->on_widget = &OnWidgetTrampoline;
        vtable->on_tick = &OnTickTrampoline;
        vtable->should_continue = &ShouldContinueTrampoline;
        vtable->pick_mode = &PickModeTrampoline;
        vtable->free = &FreeTrampoline;
        return (IntPtr)vtable;
    }

    [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvCdecl) })]
    private static void OnBatchTrampoline(IntPtr ctx, byte* items_ptr, nuint items_len, byte* raw_ptr, nuint raw_len, byte* first_ptr, nuint first_len, int mode, FfiError* out_err)
    {
        try
        {
            var arg0Reader = new FfiBufferReader(Ffi.ReadBytes(items_ptr, items_len));
            var arg0Count = arg0Reader.ReadLen();
            var arg0List = new List<Outer>(arg0Reader.Capacity(arg0Count));
            for (var i0 = 0; i0 < arg0Count; i0++)
            {
                var arg0Item = global::EdgeCases.Outer.ReadFrom(arg0Reader);
                arg0List.Add(arg0Item);
            }
            var arg0 = arg0List.ToArray();
            arg0Reader.ExpectEnd();
            var arg2Reader = new FfiBufferReader(Ffi.ReadBytes(first_ptr, first_len));
            Outer? arg2 = null;
            if (arg2Reader.ReadBool())
            {
                var arg2Value = global::EdgeCases.Outer.ReadFrom(arg2Reader);
                arg2 = arg2Value;
            }
            arg2Reader.ExpectEnd();
            Ffi.Target<IBatchListener>(ctx).OnBatch(arg0, Ffi.ReadBytes(raw_ptr, raw_len), arg2, (Mode)mode);
        }
        catch (Exception e)
        {
            Ffi.SetForeignError(out_err, e);
