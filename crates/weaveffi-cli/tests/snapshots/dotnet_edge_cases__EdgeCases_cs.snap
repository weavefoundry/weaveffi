/// <summary>Callback interface carrying composite payloads and objects</summary>
/// <remarks>The native library may call any method from any thread until
/// it releases its last reference to the implementation. Object arguments
/// belong to the implementation. An exception thrown by a method reaches
/// the native caller as <see cref="NativeException.ForeignErrorCode"/>.</remarks>
public interface IBatchListener
{
    /// <summary>Composite payloads cross as value buffers</summary>
    void OnBatch(Outer[] items, byte[] raw, Outer? first, Mode mode);
    /// <summary>Objects cross as strong references the consumer must release</summary>
    void OnWidget(Widget widget, Widget? fallback, Widget[] children);
    void OnTick();
    /// <summary>Scalar return travels back through the vtable</summary>
    bool ShouldContinue(int @class);
    /// <summary>Enum return travels back as its integer discriminant</summary>
    Mode PickMode();
}

/// <summary>The process-wide <c>edge_cases_edge_cases_BatchListener_vtable</c> and the trampolines behind it,
