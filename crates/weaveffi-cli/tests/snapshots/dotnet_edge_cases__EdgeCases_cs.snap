    internal static Dictionary<long, string> ReadMapOfI64ToString(FfiBufferReader reader)
    {
        var count = reader.ReadLen();
        var map = new Dictionary<long, string>(reader.Capacity(count));
        for (var i = 0; i < count; i++)
        {
            var key = reader.ReadI64();
            if (!map.TryAdd(key, reader.ReadString()))
            {
                throw FfiBufferReader.Malformed("repeated map key");
            }
        }
        return map;
    }

