/// <summary>The value-buffer codec of every composite type the API
/// carries.</summary>
internal static class FfiCodecs
{
    /// <summary>Reads one value that must fill the whole buffer.</summary>
    internal static T Decode<T>(FfiBufferReader reader, Func<FfiBufferReader, T> read)
    {
        var value = read(reader);
        reader.ExpectEnd();
        return value;
    }

    internal static void WriteListOfI32(FfiBufferWriter writer, int[] value)
    {
        writer.WriteLen(value.Length);
        foreach (var item in value)
        {
            writer.WriteI32(item);
        }
    }

    internal static int[] ReadListOfI32(FfiBufferReader reader)
    {
        var count = reader.ReadLen();
        var list = new List<int>(reader.Capacity(count));
        for (var i = 0; i < count; i++)
        {
            list.Add(reader.ReadI32());
        }
        return list.ToArray();
    }

    internal static void WriteListOfLeaf(FfiBufferWriter writer, Leaf[] value)
    {
        writer.WriteLen(value.Length);
        foreach (var item in value)
