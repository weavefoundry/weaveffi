package docs_everywhere

/** Errors of the `DocsErrors` domain. */
sealed class DocsErrorsException(code: Int, message: String) : FfiException(code, message) {
    /** Returned when no document matches the requested id */
    class NotFound(message: String = "Document not found") : DocsErrorsException(1, message)
    /** Raised when attempting to move into a forbidden state */
    class InvalidStatus(message: String = "Invalid status transition") : DocsErrorsException(2, message)

    internal companion object {
        /** The exception for a raw code and its serialized payload. */
        fun fromCode(code: Int, message: String, payload: ByteArray?): FfiException = when (code) {
            1 -> NotFound(message)
            2 -> InvalidStatus(message)
            else -> FfiException(code, message)
        }
    }
}

/**
 * Lifecycle status of a document.
 *
 * Used to drive UI badges and filters.
 */
enum class Status(val value: Int) {
    /** Document is being edited */
    Draft(0),
    /** Document is publicly visible */
    Published(1),
    /** Document is hidden from listings */
    Archived(2);

    companion object {
        /** The variant whose ABI value is [value]. */
        fun fromValue(value: Int): Status = entries.firstOrNull { it.value == value }
            ?: throw FfiException(-3, "unknown Status value $value")
    }
}

/**
 * Represents a single document tracked by the system.
 *
 * Documents are persisted to disk and exposed via the public API.
 */
data class Document(
    /** Stable opaque identifier */
    val id: Long,
    /** Human-readable title shown in lists */
    val title: String,
    /** Current lifecycle status */
    val status: Status,
    /** Free-form tags for grouping */
    val tags: List<String>,
)

internal fun packDocument(_w: BufferWriter, _v: Document) {
    _w.writeI64(_v.id)
    _w.writeString(_v.title)
    _w.writeI32(_v.status.value)
    _w.writeList(_v.tags) { _v0 -> _w.writeString(_v0) }
}

internal fun unpackDocument(_r: BufferReader): Document = Document(
    _r.readI64(),
    _r.readString(),
    Status.fromValue(_r.readI32()),
    _r.readList { _r.readString() },
)

/**
 * Consumer-implemented observer of document-saved notifications.
 *
 * Implementations must be safe to call from any thread.
 */
interface SavedListener {
    /**
     * Fires after a document has been persisted successfully
     * @param docId Identifier of the saved document
     * @param revision Monotonically increasing revision
     */
    fun onSaved(docId: Long, revision: Int)
}

/**
 * An ordered collection of documents.
 *
 * Notebooks own their documents and release them when destroyed.
 */
class Notebook private constructor(address: Long) : AutoCloseable {
    internal val handle: NativeHandle = NativeCleaner.register(this, NativeHandle(address, JniBridge::docs_Notebook_destroy))

    /** A new strong reference to this object, as written into a value buffer. */
    internal fun cloneHandle(): Long = handle.borrow { JniBridge.docs_Notebook_clone(it) }

    /**
     * Add a document, returning its position in the notebook
     * @param document The document to add
     */
    fun insert(document: Document): Int = handle.borrow { _self ->
        JniBridge.docs_Notebook_insert(_self, encodeBuffer { _w -> packDocument(_w, document) })
    }

    /**
     * Look up a document by identifier, failing when none matches
     * @param id Identifier of the document to find
     */
    fun find(id: Long): Document = handle.borrow { _self ->
        decodeBuffer(JniBridge.docs_Notebook_find(_self, id)) { _r -> unpackDocument(_r) }
    }

    /** The number of documents currently held */
    fun size(): Int = handle.borrow { _self ->
        JniBridge.docs_Notebook_size(_self)
    }

    /** Releases this wrapper's native reference; safe to call more than once. */
    override fun close() = handle.close()

    companion object {
        /** Adopts one strong reference (a return value or a buffer token). */
        internal fun fromHandle(address: Long): Notebook = Notebook(address)

        /** [fromHandle], with address 0 meaning no object. */
        internal fun fromHandleOrNull(address: Long): Notebook? = if (address == 0L) null else Notebook(address)

        /** Create an empty notebook */
        operator fun invoke(): Notebook = Notebook.fromHandle(JniBridge.docs_Notebook_new())

        /** The largest number of documents one notebook will hold */
        fun maxDocuments(): Int = JniBridge.docs_Notebook_max_documents()
    }
}

object Docs {
    /**
     * Create a brand new document.
     *
     * The document starts in `Draft` status; callers must publish
     * it explicitly to make it visible.
     * @param title Human-readable title for the new document
     * @param tags Initial set of tags (may be empty)
     */
    fun createDocument(title: String, tags: List<String>): Document = decodeBuffer(JniBridge.docs_create_document(encodeUtf8(title), encodeBuffer { _w -> _w.writeList(tags) { _v0 -> _w.writeString(_v0) } })) { _r -> unpackDocument(_r) }

    /**
     * Look up a document by identifier
     * @param id Identifier returned from create_document
     */
    fun getDocument(id: Long): Document? = decodeBuffer(JniBridge.docs_get_document(id)) { _r -> _r.readOptional { unpackDocument(_r) } }

    /**
     * Publish a document in the background
     * @param id Identifier of the document to publish
     */
    suspend fun publishAsync(id: Long): Boolean = awaitNative(false, 0, { it as Boolean }) { _, _done ->
        JniBridge.docs_publish_async(id, _done)
    }

    /**
     * Register a listener for saved notifications
     * @param listener Receiver of saved notifications
     */
    fun watch(listener: SavedListener) {
        JniBridge.docs_watch(listener)
    }
}

