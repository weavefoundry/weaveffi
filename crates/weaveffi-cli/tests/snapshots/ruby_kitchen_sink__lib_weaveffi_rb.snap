    def initialize(id:, name:, count:, enabled:, ratio:, nick:, payload:, tags:, attrs:, parent:, token:, priority:, gadget:)
      @id = id
      @name = name
      @count = count
      @enabled = enabled
      @ratio = ratio
      @nick = nick
      @payload = payload
      @tags = tags
      @attrs = attrs
      @parent = parent
      @token = token
      @priority = priority
      @gadget = gadget
    end

    # Structural equality over every field.
    def ==(other)
      return false unless other.is_a?(Item)
      return false unless id == other.id
      return false unless name == other.name
      return false unless count == other.count
      return false unless enabled == other.enabled
      return false unless ratio == other.ratio
      return false unless nick == other.nick
      return false unless payload == other.payload
      return false unless tags == other.tags
      return false unless attrs == other.attrs
      return false unless parent == other.parent
      return false unless token == other.token
      return false unless priority == other.priority
      return false unless gadget == other.gadget
      true
    end
  end

  # @api private
  # Packs a Item into the value-buffer wire format.
  def self._wv_write_item(w, v)
    w.write_i64(v.id)
    w.write_string(v.name)
    w.write_i32(v.count)
    w.write_bool(v.enabled)
    w.write_f64(v.ratio)
    w.write_u32(v.nick)
    w.write_bytes(v.payload)
    w.write_len(v.tags.length)
    v.tags.each do |_wv_e0|
      w.write_string(_wv_e0)
    end
    w.write_len(v.attrs.length)
    v.attrs.each do |_wv_k0, _wv_v0|
      w.write_string(_wv_k0)
      w.write_string(_wv_v0)
    end
    if v.parent.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      w.write_i64(v.parent)
    end
    _wv_write_token(w, v.token)
    w.write_i32(v.priority)
    if v.gadget.nil?
      w.write_flag(false)
    else
      w.write_flag(true)
      w.write_u64(v.gadget._wv_clone_ptr.address)
    end
  end

  # @api private
  # Unpacks a Item from the value-buffer wire format.
  def self._wv_read_item(r)
    _wv_id = r.read_i64
    _wv_name = r.read_string
    _wv_count = r.read_i32
    _wv_enabled = r.read_bool
    _wv_ratio = r.read_f64
    _wv_nick = r.read_u32
    _wv_payload = r.read_bytes
    _wv_tags = Array.new(r.read_len) do
      _wv_e0 = r.read_string
      _wv_e0
    end
    _wv_attrs = {}
    r.read_len.times do
      _wv_k0 = r.read_string
      _wv_v0 = r.read_string
      _wv_attrs[_wv_k0] = _wv_v0
    end
    if r.read_flag
      _wv_parent = r.read_i64
    else
      _wv_parent = nil
    end
    _wv_token = _wv_read_token(r)
    _wv_priority = r.read_i32
    if r.read_flag
      _wv_gadget = Gadget._from_ptr(r.read_object_token)
    else
      _wv_gadget = nil
    end
    Item.new(id: _wv_id, name: _wv_name, count: _wv_count, enabled: _wv_enabled, ratio: _wv_ratio, nick: _wv_nick, payload: _wv_payload, tags: _wv_tags, attrs: _wv_attrs, parent: _wv_parent, token: _wv_token, priority: _wv_priority, gadget: _wv_gadget)
  end

