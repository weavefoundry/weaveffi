  # === Module: kitchen ===

  # Base error for the `kitchen` module's error domain.
  class KitchenErrorsError < Error
    # Item not found
    class NotFound < KitchenErrorsError
      CODE = 1

      def initialize(message = 'Item not found')
        super(1, message)
      end
    end

    # Invalid input
    class InvalidInput < KitchenErrorsError
      CODE = 2

      def initialize(message = 'Invalid input')
        super(2, message)
      end
    end
