  def self.echo_bytes(b)
    err = ErrorStruct.new
    b_buf = FFI::MemoryPointer.new(:uint8, b.bytesize)
    b_buf.put_bytes(0, b)
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kitchen_echo_bytes(b_buf, b.bytesize, out_len, err)
    check_error!(err)
    return ''.b if result.null?
    len = out_len.read(:size_t)
    data = result.read_string(len)
    weaveffi_free_bytes(result, len)
    data
  end

