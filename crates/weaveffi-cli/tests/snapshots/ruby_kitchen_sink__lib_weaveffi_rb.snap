  # Consumer-implemented observer of ready items
  # Consumer-implemented callback interface. Any object responding to the
  # methods below is accepted wherever a ReadyListener parameter is expected;
  # include this module to inherit NotImplementedError defaults. The
  # producer may call the methods from any thread until it releases the
  # implementation.
  module ReadyListener
    # Fires when an item is ready
    def on_ready(code, msg)
      raise NotImplementedError, "#{self.class}#on_ready is not implemented"
    end

    # Receives the item itself and says whether to keep listening
    # @return [Object] a bool
    def on_item(item, gadget)
      raise NotImplementedError, "#{self.class}#on_item is not implemented"
    end
  end

  # @api private
  # The C vtable layout the producer calls a ReadyListener through.
  class WvReadyListenerVtable < FFI::Struct
    layout :on_ready, :pointer,
           :on_item, :pointer,
           :free, :pointer
  end

  # @api private
  # Trampoline for ReadyListener#on_ready.
  WV_READY_LISTENER_ON_READY = FFI::Function.new(:void, [:pointer, :int32, :string, :pointer]) do |ctx, code, msg, out_err|
    begin
      impl = _wv_cb_lookup(ctx)
      code_v = code
      msg_v = msg.nil? ? '' : msg.force_encoding(Encoding::UTF_8)
      impl.on_ready(code_v, msg_v)
      nil
    rescue Exception => e
      _wv_cb_fail(out_err, e)
      nil
    end
  end

  # @api private
  # Trampoline for ReadyListener#on_item.
  WV_READY_LISTENER_ON_ITEM = FFI::Function.new(:int32, [:pointer, :pointer, :size_t, :pointer, :pointer]) do |ctx, item_ptr, item_len, gadget, out_err|
    begin
      impl = _wv_cb_lookup(ctx)
      item_r = WvBufferReader.new(item_ptr.null? ? ''.b : item_ptr.read_string(item_len))
      item_v = _wv_read_item(item_r)
      item_r.expect_end!
      gadget_v = Gadget._from_ptr(gadget)
      impl.on_item(item_v, gadget_v) ? 1 : 0
    rescue Exception => e
      _wv_cb_fail(out_err, e)
      0
    end
  end

  # @api private
  # Releases a ReadyListener implementation when the producer drops its last
  # reference.
  WV_READY_LISTENER_FREE = FFI::Function.new(:void, [:pointer]) do |ctx|
    _wv_cb_free(ctx)
  end

  # The one process-wide ReadyListener vtable every registration hands the
  # producer; its entries live for the process lifetime.
  WV_READY_LISTENER_VTABLE = WvReadyListenerVtable.new
  WV_READY_LISTENER_VTABLE[:on_ready] = WV_READY_LISTENER_ON_READY
  WV_READY_LISTENER_VTABLE[:on_item] = WV_READY_LISTENER_ON_ITEM
  WV_READY_LISTENER_VTABLE[:free] = WV_READY_LISTENER_FREE

  # @api private
  # Owns one strong reference to a Gadget; releases it exactly once.
  class GadgetPtr < FFI::AutoPointer
    def self.release(ptr)
      WeaveFFI.weaveffi_kitchen_Gadget_destroy(ptr)
    end
  end

  # A pocket-sized interface exercising the object surface
  class Gadget
    # @api private
    # Adopts one strong reference the producer handed over, without
    # re-running initialize.
    def self._from_ptr(ptr)
      obj = allocate
      obj.instance_variable_set(:@handle, GadgetPtr.new(ptr))
      obj
    end

    # The borrowed object pointer passed to producer calls.
    def handle
      raise Error.new(-1, 'Gadget used after close') if @handle.nil?
      @handle
    end

    # Whether close has released this wrapper's reference.
    def closed?
      @handle.nil?
    end

    # Releases this wrapper's reference now rather than at GC time.
    # Idempotent; the object itself is dropped when the last reference
    # anywhere (another wrapper, a record field, the producer) goes.
    def close
      return if @handle.nil?
      @handle.free
      @handle = nil
    end

    # @api private
    # Mints a new strong reference the caller owns (used when this
    # object is written into a value buffer).
    def _wv_clone_ptr
      WeaveFFI.weaveffi_kitchen_Gadget_clone(handle)
    end

    # dup and clone produce an independent wrapper with its own reference.
    def initialize_copy(other)
      super
      @handle = GadgetPtr.new(WeaveFFI.weaveffi_kitchen_Gadget_clone(other.handle))
    end

    # Create a gadget with the given id
    def initialize(id)
      err = ErrorStruct.new
      result = WeaveFFI.weaveffi_kitchen_Gadget_new(id, err)
      WeaveFFI.check_error!(err)
      raise Error.new(-1, 'null pointer') if result.null?
      @handle = GadgetPtr.new(result)
    end

    # Render the gadget as a human-readable string
    def describe()
      err = ErrorStruct.new
      result = WeaveFFI.weaveffi_kitchen_Gadget_describe(handle, err)
      WeaveFFI.check_error!(err)
      return '' if result.null?
      str = result.read_string.force_encoding(Encoding::UTF_8)
      WeaveFFI.weaveffi_free_string(result)
      str
    end

    # Poke the gadget a number of times, failing on a negative count
    def poke(times)
      err = ErrorStruct.new
      result = WeaveFFI.weaveffi_kitchen_Gadget_poke(handle, times, err)
      WeaveFFI.check_kitchen_errors_error!(err)
      result
    end

    # The gadget subsystem version string
    def self.version()
      err = ErrorStruct.new
      result = WeaveFFI.weaveffi_kitchen_Gadget_version(err)
      WeaveFFI.check_error!(err)
      return '' if result.null?
      str = result.read_string.force_encoding(Encoding::UTF_8)
      WeaveFFI.weaveffi_free_string(result)
      str
    end
  end

  # Identity for bool
  def self.bool_id(x)
    err = ErrorStruct.new
    x_c = x ? 1 : 0
    result = weaveffi_kitchen_bool_id(x_c, err)
    check_error!(err)
    (result != 0)
  end

  def self.i32_id(x)
    err = ErrorStruct.new
    result = weaveffi_kitchen_i32_id(x, err)
    check_error!(err)
    result
  end

  def self.u32_id(x)
    err = ErrorStruct.new
    result = weaveffi_kitchen_u32_id(x, err)
    check_error!(err)
    result
  end

  def self.i64_id(x)
    err = ErrorStruct.new
    result = weaveffi_kitchen_i64_id(x, err)
    check_error!(err)
    result
  end

  def self.f64_id(x)
    err = ErrorStruct.new
    result = weaveffi_kitchen_f64_id(x, err)
    check_error!(err)
    result
  end

  def self.echo_string(s)
    err = ErrorStruct.new
    result = weaveffi_kitchen_echo_string(s, err)
    check_error!(err)
    return '' if result.null?
    str = result.read_string.force_encoding(Encoding::UTF_8)
    weaveffi_free_string(result)
    str
  end

  def self.echo_bytes(b)
    err = ErrorStruct.new
    b_buf = FFI::MemoryPointer.new(:uint8, b.bytesize)
    b_buf.put_bytes(0, b)
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kitchen_echo_bytes(b_buf, b.bytesize, out_len, err)
    check_error!(err)
    return ''.b if result.null?
    len = out_len.read(:size_t)
    data = result.read_string(len)
    weaveffi_free_bytes(result, len)
    data
  end

  # Register a listener, returning how many are attached
  def self.subscribe(listener)
    err = ErrorStruct.new
    listener_ctx = _wv_cb_register(listener)
    result = weaveffi_kitchen_subscribe(listener_ctx, WV_READY_LISTENER_VTABLE.to_ptr, err)
    check_error!(err)
    result
  end

  # Optional object in both directions
  def self.maybe_gadget(fallback)
    err = ErrorStruct.new
    result = weaveffi_kitchen_maybe_gadget(fallback&.handle, err)
    check_error!(err)
    return nil if result.null?
    Gadget._from_ptr(result)
  end

  # A list of objects
  def self.gadgets()
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kitchen_gadgets(out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = Array.new(_wv_r.read_len) do
      _wv_e0 = Gadget._from_ptr(_wv_r.read_object_token)
      _wv_e0
    end
    _wv_r.expect_end!
    _wv_value
  end

  # An iterator over objects
  # Returns a lazy Enumerator that streams one element per pull; call
  # `.to_a` to collect eagerly. The underlying producer iterator is
  # launched on the first pull, so launch errors raise at that point
  # rather than when this method returns. The iterator handle is
  # released exactly once, when iteration finishes or is abandoned
  # early (for example by `break`).
  def self.stream_gadgets()
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = weaveffi_kitchen_stream_gadgets(err)
      begin
        check_error!(err)
        unless iter.null?
          loop do
            out_item = FFI::MemoryPointer.new(:pointer)
            item_err = ErrorStruct.new
            has_item = weaveffi_kitchen_StreamGadgetsIterator_next(iter, out_item, item_err)
            check_error!(item_err)
            break if has_item.zero?
            item_ptr = out_item.read_pointer
            raise Error.new(-1, 'null pointer') if item_ptr.null?
            y << Gadget._from_ptr(item_ptr)
          end
        end
      ensure
        weaveffi_kitchen_StreamGadgetsIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Optional struct return
  def self.maybe_item(id)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kitchen_maybe_item(id, out_len, err)
    check_kitchen_errors_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    if _wv_r.read_flag
      _wv_value = _wv_read_item(_wv_r)
    else
      _wv_value = nil
    end
    _wv_r.expect_end!
    _wv_value
  end

  # List of structs
  def self.list_items()
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kitchen_list_items(out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = Array.new(_wv_r.read_len) do
      _wv_e0 = _wv_read_item(_wv_r)
      _wv_e0
    end
    _wv_r.expect_end!
    _wv_value
  end

  # Map return type
  def self.get_attrs()
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kitchen_get_attrs(out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = {}
    _wv_r.read_len.times do
      _wv_k0 = _wv_r.read_string
      _wv_v0 = _wv_r.read_i32
      _wv_value[_wv_k0] = _wv_v0
    end
    _wv_r.expect_end!
    _wv_value
  end

  # Iterator return type
  # Returns a lazy Enumerator that streams one element per pull; call
  # `.to_a` to collect eagerly. The underlying producer iterator is
  # launched on the first pull, so launch errors raise at that point
  # rather than when this method returns. The iterator handle is
  # released exactly once, when iteration finishes or is abandoned
  # early (for example by `break`).
  def self.stream_items()
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = weaveffi_kitchen_stream_items(err)
      begin
        check_error!(err)
        unless iter.null?
          loop do
            out_item = FFI::MemoryPointer.new(:pointer)
            out_item_len = FFI::MemoryPointer.new(:size_t)
            item_err = ErrorStruct.new
            has_item = weaveffi_kitchen_StreamItemsIterator_next(iter, out_item, out_item_len, item_err)
            check_error!(item_err)
            break if has_item.zero?
            item_ptr = out_item.read_pointer
            item_len = out_item_len.read(:size_t)
            _wv_data = item_ptr.null? ? ''.b : item_ptr.read_string(item_len)
            weaveffi_free_bytes(item_ptr, item_len) unless item_ptr.null?
            _wv_r = WvBufferReader.new(_wv_data)
            _wv_item = _wv_read_item(_wv_r)
            _wv_r.expect_end!
            y << _wv_item
          end
        end
      ensure
        weaveffi_kitchen_StreamItemsIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Returns the shared Token type from another module
  def self.cross_module_token()
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kitchen_cross_module_token(out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = _wv_read_token(_wv_r)
    _wv_r.expect_end!
    _wv_value
  end

  # Async operation
  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.do_async(input)
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer]) do |_context, err_ptr, result|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string.force_encoding(Encoding::UTF_8)
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        _wv_s = result.null? ? '' : result.read_string.force_encoding(Encoding::UTF_8)
        weaveffi_free_string(result) unless result.null?
        queue << _wv_s
      end
    end
    weaveffi_kitchen_do_async_async(input, callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Cancellable async operation
  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback (cancellation token not exposed; pass-through is NULL).
  def self.do_cancellable(input)
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer]) do |_context, err_ptr, result|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string.force_encoding(Encoding::UTF_8)
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        _wv_s = result.null? ? '' : result.read_string.force_encoding(Encoding::UTF_8)
        weaveffi_free_string(result) unless result.null?
        queue << _wv_s
      end
    end
    weaveffi_kitchen_do_cancellable_async(input, FFI::Pointer::NULL, callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Legacy operation kept for compatibility
  def self.legacy_op()
    warn "[DEPRECATED] Use new_op instead"
    err = ErrorStruct.new
    result = weaveffi_kitchen_legacy_op(err)
    check_error!(err)
    result
  end

  # Replacement for legacy_op
  def self.new_op()
    err = ErrorStruct.new
    result = weaveffi_kitchen_new_op(err)
    check_error!(err)
    result
  end

  # === Module: kitchen_nested ===
  # Trivial nested-module function
  attach_function :weaveffi_kitchen_nested_hello, [:pointer], :pointer

  # Trivial nested-module function
  def self.hello()
    err = ErrorStruct.new
    result = weaveffi_kitchen_nested_hello(err)
    check_error!(err)
    return '' if result.null?
    str = result.read_string.force_encoding(Encoding::UTF_8)
    weaveffi_free_string(result)
    str
  end
end

# END weaveffi.rb
