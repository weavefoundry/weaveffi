  # Kitchen sink struct exercising every field feature
  class Item
    # Stable identifier
    attr_reader :id

    # Display name
    attr_reader :name

    # Initial count
    attr_reader :count

    # Whether the item is enabled
    attr_reader :enabled

    # Scaling ratio
