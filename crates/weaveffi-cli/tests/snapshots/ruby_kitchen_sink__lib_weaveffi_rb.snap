  # Builds the KitchenErrorsError subclass matching `code`, decoding any payload
  # fields the code declares, or a generic Error for codes outside
  # the domain (panics, marshalling, callback failures).
  def self.kitchen_errors_error_from(code, message, payload = nil)
    cls = KITCHEN_ERRORS_ERROR_CODES[code]
    return Error.new(code, message) if cls.nil?
    message.empty? ? cls.new : cls.new(message)
  end

  # Raises the typed KitchenErrorsError for a non-zero error slot.
  def self.check_kitchen_errors_error!(err)
    return if err[:code].zero?
    code = err[:code]
    msg_ptr = err[:message]
    msg = msg_ptr.null? ? '' : msg_ptr.read_string.force_encoding(Encoding::UTF_8)
    payload_ptr = err[:payload_ptr]
    payload = payload_ptr.null? ? nil : payload_ptr.read_string(err[:payload_len])
    weaveffi_error_clear(err.to_ptr)
    raise kitchen_errors_error_from(code, msg, payload)
  end

