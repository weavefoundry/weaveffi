  # Iterator return type
  # Returns a lazy Enumerator that streams one element per pull; call
  # `.to_a` to collect eagerly. The underlying producer iterator is
  # launched on the first pull, so launch errors raise at that point
  # rather than when this method returns. The iterator handle is
  # released exactly once, when iteration finishes or is abandoned
  # early (for example by `break`).
  def self.stream_items()
    Enumerator.new do |y|
      err = ErrorStruct.new
      iter = weaveffi_kitchen_stream_items(err)
      begin
        check_error!(err)
        unless iter.null?
          loop do
            out_item = FFI::MemoryPointer.new(:pointer)
            out_item_len = FFI::MemoryPointer.new(:size_t)
            item_err = ErrorStruct.new
            has_item = weaveffi_kitchen_StreamItemsIterator_next(iter, out_item, out_item_len, item_err)
            check_error!(item_err)
            break if has_item.zero?
            item_ptr = out_item.read_pointer
            item_len = out_item_len.read(:size_t)
            _wv_data = item_ptr.null? ? ''.b : item_ptr.read_string(item_len)
            weaveffi_free_bytes(item_ptr, item_len) unless item_ptr.null?
            _wv_r = WvBufferReader.new(_wv_data)
            _wv_item = _wv_read_item(_wv_r)
            _wv_r.expect_end!
            y << _wv_item
          end
        end
      ensure
        weaveffi_kitchen_StreamItemsIterator_destroy(iter) unless iter.null?
      end
    end
  end

  # Returns the shared Token type from another module
  def self.cross_module_token()
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_kitchen_cross_module_token(out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = _wv_read_token(_wv_r)
    _wv_r.expect_end!
    _wv_value
  end

  # Async operation
  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.do_async(input)
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer]) do |_context, err_ptr, result|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        _wv_s = result.null? ? '' : result.read_string
        weaveffi_free_string(result) unless result.null?
        queue << _wv_s
      end
    end
    weaveffi_kitchen_do_async_async(input, callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Cancellable async operation
  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback (cancellation token not exposed; pass-through is NULL).
  def self.do_cancellable(input)
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :pointer]) do |_context, err_ptr, result|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        _wv_s = result.null? ? '' : result.read_string
        weaveffi_free_string(result) unless result.null?
        queue << _wv_s
      end
    end
    weaveffi_kitchen_do_cancellable_async(input, FFI::Pointer::NULL, callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
  end

  # Legacy operation kept for compatibility
  def self.legacy_op()
    warn "[DEPRECATED] Use new_op instead"
    err = ErrorStruct.new
    result = weaveffi_kitchen_legacy_op(err)
    check_error!(err)
    result
  end

  # Replacement for legacy_op
  def self.new_op()
    err = ErrorStruct.new
    result = weaveffi_kitchen_new_op(err)
    check_error!(err)
    result
  end

  # === Module: kitchen_nested ===
  # Trivial nested-module function
  attach_function :weaveffi_kitchen_nested_hello, [:pointer], :pointer

  # Trivial nested-module function
  def self.hello()
    err = ErrorStruct.new
    result = weaveffi_kitchen_nested_hello(err)
    check_error!(err)
    return '' if result.null?
    str = result.read_string
    weaveffi_free_string(result)
    str
  end
end

# END weaveffi.rb
