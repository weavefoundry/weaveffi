}

// BusyError is the EdgeErrorsError code Busy (7): Resource is busy.
type BusyError struct {
	// Message describes the failure; when it's empty, Error returns the
	// code's default message, "Resource is busy".
	Message string
}

// Error returns the error's message.
func (e *BusyError) Error() string {
	if e.Message == "" {
		return "Resource is busy"
	}
	return e.Message
}

// Code returns 7.
func (*BusyError) Code() int32 {
	return 7
}

func (*BusyError) isEdgeErrorsError() {}

func (*BusyError) wvPayload() []byte {
	return nil
}

func wvEdgeErrorsError(f wvFailure) error {
	switch f.code {
	case 7:
		return &BusyError{Message: f.message}
	}
	return f.err()
}

