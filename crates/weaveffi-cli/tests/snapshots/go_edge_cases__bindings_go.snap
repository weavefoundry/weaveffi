	defer wvRecoverCallback(out_err)
	wvCallback[BatchListener](ctx).OnBatch(wvDecodeBorrowed(items_ptr, items_len, wvReadListOuter), wvBorrowBytes(raw_ptr, raw_len), wvDecodeBorrowed(first_ptr, first_len, wvReadOptOuter), Mode(mode))
}

