// BatchListener: Callback interface carrying composite payloads and objects
//
// Implement BatchListener in Go and pass the value to the functions that take
// it. The native library may call its methods from any thread until it
// releases the implementation. A method that panics, or a throwing method that
// returns an error outside its domain, fails the native call in progress as a
// callback failure (code -4).
type BatchListener interface {
	// OnBatch: Composite payloads cross as value buffers
	OnBatch(items []Outer, raw []byte, first *Outer, mode Mode)
	// OnWidget: Objects cross as strong references the consumer must release
	OnWidget(widget *Widget, fallback *Widget, children []*Widget)
	OnTick()
	// ShouldContinue: Scalar return travels back through the vtable
	ShouldContinue(class int32) bool
	// PickMode: Enum return travels back as its integer discriminant
	PickMode() Mode
}

