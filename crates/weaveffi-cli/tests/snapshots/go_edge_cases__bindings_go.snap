func KeywordsRoundtrip(value Keywords) Keywords {
	wValue := &wvWriter{}
	wvPackKeywords(wValue, value)
	cValuePtr, cValueLen := wvBytes(wValue.buf)
	var cRetLen C.size_t
	var cErr C.edge_cases_error
	cRet := C.edge_cases_edge_cases_keywords_roundtrip(cValuePtr, cValueLen, &cRetLen, &cErr)
	wvTrap(&cErr)
	rRet := &wvReader{buf: wvTakeBytes(cRet, cRetLen)}
	var ret Keywords
	ret = wvUnpackKeywords(rRet)
	rRet.expectEnd()
	return ret
}

