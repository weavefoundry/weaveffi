            }, ctx)
        }
    }
    public static func activeCallbacks() -> Int64 {
        var err = weaveffi_error(code: 0, message: nil, payload_ptr: nil, payload_len: 0)
        let rv = weaveffi_tasks_active_callbacks(&err)
