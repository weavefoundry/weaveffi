import Foundation
import PackageDescription

// The C module `CShapes` comes from one of two places. Next to this
// manifest, a prebuilt `CShapes.xcframework` (assembled from the native
// libraries, see the README) wins. Otherwise `Sources/CShapes` declares
// the generated header as a system library that links `shapes` from the
// linker search path, e.g. `swift build -Xlinker -L/path/to/lib`.
let xcframework = "CShapes.xcframework"
let cModule: Target = FileManager.default.fileExists(atPath: "\(Context.packageDirectory)/\(xcframework)")
    ? .binaryTarget(name: "CShapes", path: xcframework)
    : .systemLibrary(name: "CShapes")

let package = Package(
    name: "Shapes",
    platforms: [.macOS(.v10_15), .iOS(.v13), .tvOS(.v13), .watchOS(.v6)],
    products: [
        .library(name: "Shapes", targets: ["Shapes"]),
    ],
    targets: [
        cModule,
        .target(name: "Shapes", dependencies: ["CShapes"]),
    ]
)

// END Package.swift
