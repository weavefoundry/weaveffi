cmake_minimum_required(VERSION 3.14)
project(docs_everywhere_cpp VERSION 0.1.0 LANGUAGES CXX)

# The producer library to link: a full path from the DOCS_EVERYWHERE_LIBRARY cache or
# environment variable, or else the library name `docs_everywhere` (a CMake target
# of that name, or libdocs_everywhere on the linker search path).
set(DOCS_EVERYWHERE_LIBRARY "$ENV{DOCS_EVERYWHERE_LIBRARY}" CACHE FILEPATH "Path to the docs_everywhere native library")

add_library(docs_everywhere_cpp INTERFACE)
add_library(docs_everywhere::cpp ALIAS docs_everywhere_cpp)
target_include_directories(docs_everywhere_cpp INTERFACE ${CMAKE_CURRENT_SOURCE_DIR})
target_compile_features(docs_everywhere_cpp INTERFACE cxx_std_17)
if(DOCS_EVERYWHERE_LIBRARY)
  target_link_libraries(docs_everywhere_cpp INTERFACE "${DOCS_EVERYWHERE_LIBRARY}")
else()
  target_link_libraries(docs_everywhere_cpp INTERFACE docs_everywhere)
endif()

