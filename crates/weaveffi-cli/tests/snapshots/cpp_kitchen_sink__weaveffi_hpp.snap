namespace weaveffi {

/**
 * Base exception for every error reported through the C ABI.
 *
 * Positive codes are the module's declared error codes (see the typed
 * domain exceptions); negative codes are runtime traps: -1 a generic
 * producer error, -2 a producer panic, -3 a marshalling failure, -4 a
 * callback-interface implementation that threw.
 */
class WeaveFFIError : public std::runtime_error {
    int32_t code_;

public:
    WeaveFFIError(int32_t code, const std::string& msg) : std::runtime_error(msg), code_(code) {}
    int32_t code() const { return code_; }
};

/**
 * Throws WeaveFFIError when the loaded producer library was built for a
 * different WeaveFFI ABI revision than this header. Call once at startup.
 */
inline void check_abi_version() {
    uint32_t actual = weaveffi_abi_version();
    if (actual != WEAVEFFI_ABI_VERSION) {
        throw WeaveFFIError(-1, "WeaveFFI ABI revision mismatch: header " + std::to_string(WEAVEFFI_ABI_VERSION) + ", library " + std::to_string(actual));
    }
}

namespace detail {

/** Throw the generic WeaveFFIError if `err` carries a nonzero code. */
inline void check(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    int32_t code = err.code;
    weaveffi_error_clear(&err);
    throw WeaveFFIError(code, msg);
}

/** Wrap an async-callback error as the generic WeaveFFIError. */
inline std::exception_ptr make_error(int32_t code, const std::string& msg) {
    return std::make_exception_ptr(WeaveFFIError(code, msg));
}

} // namespace detail

namespace detail {

/**
 * Serializes values into the WeaveFFI value-buffer wire format: little-endian,
 * packed with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a string, byte-buffer, or collection length as a u32. */
    void write_len(size_t n) { append_le(static_cast<uint32_t>(n)); }

    void write_string(const std::string& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }
};

/**
 * Decodes values from the WeaveFFI value-buffer wire format. A malformed
 * buffer is a producer/consumer contract violation (both sides are generated
 * from one IDL), so every decode failure throws the generic WeaveFFIError,
 * the same channel as a producer panic. Object tokens adopted before a
 * failure live in RAII wrappers that release them on unwind.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    [[noreturn]] static void fail(const char* what) {
        throw WeaveFFIError(-2, std::string("malformed WeaveFFI value buffer: ") + what);
    }

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    BufferReader(const uint8_t* data, size_t len) : data_(data), len_(len), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a length prefix, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with weaveffi_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    ~BufferGuard() {
        if (ptr != nullptr) weaveffi_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

} // namespace detail

/** Task priority levels */
enum class Priority : int32_t {
    /** Low priority */
    Low = 0,
    /** Normal priority */
    Normal = 1,
    /** High priority */
    High = 2
};

struct Token;
struct Item;
class Gadget;
class ReadyListener;

/** A pocket-sized interface exercising the object surface */
class Gadget {
    weaveffi_kitchen_Gadget* handle_;

public:
    /** Adopts one strong reference to a producer object. */
    explicit Gadget(weaveffi_kitchen_Gadget* h) : handle_(h) {}

    /** Releases this wrapper's reference; the object is dropped with its last one. */
    ~Gadget() {
        if (handle_) weaveffi_kitchen_Gadget_destroy(handle_);
    }

    /** Copies share the object: the copy takes a new strong reference. */
    Gadget(const Gadget& other) : handle_(weaveffi_kitchen_Gadget_clone(other.handle_)) {}

    Gadget& operator=(const Gadget& other) {
        if (this != &other) {
            weaveffi_kitchen_Gadget* h = weaveffi_kitchen_Gadget_clone(other.handle_);
            if (handle_) weaveffi_kitchen_Gadget_destroy(handle_);
            handle_ = h;
        }
        return *this;
    }

    Gadget(Gadget&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    Gadget& operator=(Gadget&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_kitchen_Gadget_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** The wrapped pointer, borrowed: this wrapper keeps its reference. */
    const weaveffi_kitchen_Gadget* handle() const { return handle_; }

    /** A new strong reference the caller owns (for example to write into a value buffer). */
    weaveffi_kitchen_Gadget* clone_handle() const { return weaveffi_kitchen_Gadget_clone(handle_); }

    /** Create a gadget with the given id */
    Gadget(int64_t id);

    /** Render the gadget as a human-readable string */
    std::string describe() const;

    /** Poke the gadget a number of times, failing on a negative count */
    int32_t poke(int32_t times) const;

    /** The gadget subsystem version string */
    static std::string version();

};

/** A reusable token referenced across modules */
struct Token {
    int64_t id;
    std::string label;
};

/** Kitchen sink struct exercising every field feature */
struct Item {
    /** Stable identifier */
    int64_t id;
    /** Display name */
    std::string name;
    /** Initial count */
    int32_t count;
    /** Whether the item is enabled */
    bool enabled;
    /** Scaling ratio */
    double ratio;
    uint32_t nick;
    std::vector<uint8_t> payload;
    std::vector<std::string> tags;
    std::unordered_map<std::string, std::string> attrs;
    std::optional<int64_t> parent;
    /** Cross-module struct reference */
    Token token;
    Priority priority;
    /** An optional object inside a record */
    std::optional<Gadget> gadget;
};

namespace detail {

/** Encodes a `Token` in the WeaveFFI value-buffer format. */
inline void write_Token(BufferWriter& w, const Token& v) {
    w.write_i64(v.id);
    w.write_string(v.label);
}

/** Decodes a `Token` from the WeaveFFI value-buffer format. */
inline Token read_Token(BufferReader& r) {
    int64_t f_id = r.read_i64();
    std::string f_label = r.read_string();
    return Token{std::move(f_id), std::move(f_label)};
}

/** Encodes a `Item` in the WeaveFFI value-buffer format. */
inline void write_Item(BufferWriter& w, const Item& v) {
    w.write_i64(v.id);
    w.write_string(v.name);
    w.write_i32(v.count);
    w.write_bool(v.enabled);
    w.write_f64(v.ratio);
    w.write_u32(v.nick);
    w.write_bytes(v.payload);
    w.write_len(v.tags.size());
    for (const auto& item0 : v.tags) {
        w.write_string(item0);
    }
    w.write_len(v.attrs.size());
    for (const auto& kv0 : v.attrs) {
        w.write_string(kv0.first);
        w.write_string(kv0.second);
    }
    w.write_option_flag(v.parent.has_value());
    if (v.parent.has_value()) {
        w.write_i64((*v.parent));
    }
    detail::write_Token(w, v.token);
    w.write_i32(static_cast<int32_t>(v.priority));
    w.write_option_flag(v.gadget.has_value());
    if (v.gadget.has_value()) {
        w.write_u64(static_cast<uint64_t>(reinterpret_cast<uintptr_t>((*v.gadget).clone_handle())));
    }
}

/** Decodes a `Item` from the WeaveFFI value-buffer format. */
inline Item read_Item(BufferReader& r) {
    int64_t f_id = r.read_i64();
    std::string f_name = r.read_string();
    int32_t f_count = r.read_i32();
    bool f_enabled = r.read_bool();
    double f_ratio = r.read_f64();
    uint32_t f_nick = r.read_u32();
    std::vector<uint8_t> f_payload = r.read_bytes();
    std::vector<std::string> f_tags{};
    {
        size_t f_tags_n = r.read_len();
        f_tags.reserve(f_tags_n);
        for (size_t f_tags_i = 0; f_tags_i < f_tags_n; ++f_tags_i) {
            std::string f_tags_item = r.read_string();
            f_tags.push_back(std::move(f_tags_item));
        }
    }
    std::unordered_map<std::string, std::string> f_attrs{};
    {
        size_t f_attrs_n = r.read_len();
        for (size_t f_attrs_i = 0; f_attrs_i < f_attrs_n; ++f_attrs_i) {
            std::string f_attrs_key = r.read_string();
            std::string f_attrs_val = r.read_string();
            f_attrs.emplace(std::move(f_attrs_key), std::move(f_attrs_val));
        }
    }
    std::optional<int64_t> f_parent{};
    if (r.read_option_flag()) {
        int64_t f_parent_v = r.read_i64();
        f_parent = std::move(f_parent_v);
    }
    Token f_token = detail::read_Token(r);
    Priority f_priority = static_cast<Priority>(r.read_i32());
    std::optional<Gadget> f_gadget{};
    if (r.read_option_flag()) {
        Gadget f_gadget_v = Gadget(reinterpret_cast<weaveffi_kitchen_Gadget*>(static_cast<uintptr_t>(r.read_u64())));
        f_gadget = std::move(f_gadget_v);
    }
    return Item{std::move(f_id), std::move(f_name), std::move(f_count), std::move(f_enabled), std::move(f_ratio), std::move(f_nick), std::move(f_payload), std::move(f_tags), std::move(f_attrs), std::move(f_parent), std::move(f_token), std::move(f_priority), std::move(f_gadget)};
}

} // namespace detail

/** Typed errors reported by the `kitchen` module's throwing functions. */
class KitchenErrorsError : public WeaveFFIError {
public:
    KitchenErrorsError(int32_t code, const std::string& msg) : WeaveFFIError(code, msg) {}
};

/** Item not found */
class NotFoundError : public KitchenErrorsError {
public:
    NotFoundError(const std::string& msg) : KitchenErrorsError(1, msg) {}
};

/** Invalid input */
class InvalidInputError : public KitchenErrorsError {
public:
    InvalidInputError(const std::string& msg) : KitchenErrorsError(2, msg) {}
};

namespace detail {

/** Map a `kitchen` error code and payload to its typed exception (WeaveFFIError for runtime codes, KitchenErrorsError for unknown codes). */
inline std::exception_ptr make_kitchen_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    if (code < 0) return std::make_exception_ptr(WeaveFFIError(code, msg));
    (void)payload_ptr;
    (void)payload_len;
    switch (code) {
    case 1: return std::make_exception_ptr(NotFoundError(msg));
    case 2: return std::make_exception_ptr(InvalidInputError(msg));
    default: return std::make_exception_ptr(KitchenErrorsError(code, msg));
    }
}

/** Throw the typed `kitchen` exception if `err` carries a nonzero code. */
inline void check_kitchen(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    std::exception_ptr ex = make_kitchen_error(err.code, msg, err.payload_ptr, err.payload_len);
    weaveffi_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

/**
 * Consumer-implemented observer of ready items
 *
 * Implement this interface and pass a `std::shared_ptr<ReadyListener>` to any function that accepts one. The producer may call the methods from any thread until it releases its last reference to the implementation. An exception thrown by a method is reported to the producer as a foreign error (code -4) and aborts the call that triggered it.
 */
class ReadyListener {
public:
    virtual ~ReadyListener() = default;

    /** Fires when an item is ready */
    virtual void on_ready(int32_t code, const std::string& msg) = 0;
    /** Receives the item itself and says whether to keep listening */
    virtual bool on_item(const Item& item, Gadget gadget) = 0;
};

namespace detail {

/** Vtable trampolines adapting a `ReadyListener` implementation to `weaveffi_kitchen_ReadyListener_vtable`. */
struct ReadyListener_trampolines {
    static void on_ready(void* ctx, int32_t code, const char* msg, weaveffi_error* out_err) {
        try {
            ReadyListener& impl = **static_cast<std::shared_ptr<ReadyListener>*>(ctx);
            std::string msg_val(msg ? msg : "");
            impl.on_ready(code, msg_val);
            return;
        } catch (const std::exception& e) {
            weaveffi_error_set(out_err, -4, e.what());
        } catch (...) {
            weaveffi_error_set(out_err, -4, "ReadyListener::on_ready threw a non-standard exception");
        }
    }

    static bool on_item(void* ctx, const uint8_t* item_ptr, size_t item_len, weaveffi_kitchen_Gadget* gadget, weaveffi_error* out_err) {
        Gadget gadget_val(gadget);
        try {
            ReadyListener& impl = **static_cast<std::shared_ptr<ReadyListener>*>(ctx);
            detail::BufferReader item_r(item_ptr, item_len);
            Item item_val = detail::read_Item(item_r);
            item_r.expect_end();
            return impl.on_item(item_val, std::move(gadget_val));
        } catch (const std::exception& e) {
            weaveffi_error_set(out_err, -4, e.what());
        } catch (...) {
            weaveffi_error_set(out_err, -4, "ReadyListener::on_item threw a non-standard exception");
        }
        return bool{};
    }

    /** Releases the implementation box once the producer drops its last reference. */
    static void free_ctx(void* ctx) {
        delete static_cast<std::shared_ptr<ReadyListener>*>(ctx);
    }
};

/** The process-wide vtable every `ReadyListener` implementation is passed with. */
inline const weaveffi_kitchen_ReadyListener_vtable& ReadyListener_vtable() {
    static const weaveffi_kitchen_ReadyListener_vtable vtable = {
        &ReadyListener_trampolines::on_ready,
        &ReadyListener_trampolines::on_item,
        &ReadyListener_trampolines::free_ctx,
    };
    return vtable;
}

} // namespace detail

