        internal void WriteTo(WeaveFFIBufferWriter writer)
        {
            writer.WriteI64(Id);
            writer.WriteString(Value);
            writer.WriteBool(Success);
        }

        internal static TaskResult ReadFrom(WeaveFFIBufferReader reader)
        {
            var fId = reader.ReadI64();
            var fValue = reader.ReadString();
            var fSuccess = reader.ReadBool();
            return new TaskResult(fId, fValue, fSuccess);
        }
    }

