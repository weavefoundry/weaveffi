                NativeMethods.kitchen_sink_kitchen_do_async(inputPtr, (nuint)inputBytes.Length, &CompleteDoAsync, ffiCall.Context);
            }
        }
        catch
        {
            ffiCall.Abandon();
            throw;
        }
        return ffiCall.Task;
    }

    [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvCdecl) })]
    private static void CompleteDoAsync(IntPtr context, FfiError* err, byte* result_ptr, nuint result_len)
    {
        var ffiCall = FfiCall<string>.Complete(context);
        try
        {
            if (err != null)
            {
                ffiCall.SetError(err, global::KitchenSink.NativeException.FromError);
                return;
            }
            ffiCall.SetResult(Ffi.TakeString(result_ptr, result_len));
        }
        catch (Exception e)
        {
            ffiCall.SetException(e);
        }
    }

    /// <summary>Cancellable async operation</summary>
    /// <param name="cancellationToken">Cancels the native call; the task
    /// then completes as canceled.</param>
    public static Task<string> DoCancellable(string input, CancellationToken cancellationToken = default)
    {
        if (cancellationToken.IsCancellationRequested)
        {
            return Task.FromCanceled<string>(cancellationToken);
        }
        var inputBytes = Ffi.Utf8(input);
        var ffiCall = new FfiCall<string>(cancellationToken);
        try
        {
            fixed (byte* inputPtr = inputBytes)
            {
                NativeMethods.kitchen_sink_kitchen_do_cancellable(inputPtr, (nuint)inputBytes.Length, ffiCall.CancelToken(), &CompleteDoCancellable, ffiCall.Context);
            }
        }
        catch
        {
            ffiCall.Abandon();
            throw;
        }
        return ffiCall.Task;
    }

    [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvCdecl) })]
    private static void CompleteDoCancellable(IntPtr context, FfiError* err, byte* result_ptr, nuint result_len)
    {
        var ffiCall = FfiCall<string>.Complete(context);
        try
        {
            if (err != null)
            {
                ffiCall.SetError(err, global::KitchenSink.NativeException.FromError);
                return;
            }
            ffiCall.SetResult(Ffi.TakeString(result_ptr, result_len));
        }
        catch (Exception e)
        {
            ffiCall.SetException(e);
        }
    }

