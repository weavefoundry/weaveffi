/// <summary>The value-buffer codec of every composite type the API
/// carries.</summary>
internal static class FfiCodecs
{
    /// <summary>Reads one value that must fill the whole buffer.</summary>
    internal static T Decode<T>(FfiBufferReader reader, Func<FfiBufferReader, T> read)
    {
        var value = read(reader);
        reader.ExpectEnd();
        return value;
    }

    internal static void WriteListOfGadget(FfiBufferWriter writer, Gadget[] value)
    {
        writer.WriteLen(value.Length);
        foreach (var item in value)
        {
            writer.WriteObject(item.CloneHandle());
        }
    }

    internal static Gadget[] ReadListOfGadget(FfiBufferReader reader)
    {
        var count = reader.ReadLen();
        var list = new List<Gadget>(reader.Capacity(count));
        for (var i = 0; i < count; i++)
        {
            list.Add(global::KitchenSink.Gadget.Adopt(reader.ReadObject()));
        }
        return list.ToArray();
    }

    internal static void WriteListOfItem(FfiBufferWriter writer, Item[] value)
    {
        writer.WriteLen(value.Length);
        foreach (var item in value)
        {
            item.WriteTo(writer);
        }
    }

    internal static Item[] ReadListOfItem(FfiBufferReader reader)
    {
        var count = reader.ReadLen();
        var list = new List<Item>(reader.Capacity(count));
        for (var i = 0; i < count; i++)
        {
            list.Add(global::KitchenSink.Item.ReadFrom(reader));
        }
        return list.ToArray();
    }

    internal static void WriteListOfString(FfiBufferWriter writer, string[] value)
    {
        writer.WriteLen(value.Length);
        foreach (var item in value)
        {
            writer.WriteString(item);
        }
    }

    internal static string[] ReadListOfString(FfiBufferReader reader)
    {
        var count = reader.ReadLen();
        var list = new List<string>(reader.Capacity(count));
        for (var i = 0; i < count; i++)
        {
            list.Add(reader.ReadString());
        }
        return list.ToArray();
    }

    internal static void WriteMapOfStringToI32(FfiBufferWriter writer, Dictionary<string, int> value)
    {
        writer.WriteLen(value.Count);
        foreach (var entry in value)
        {
            writer.WriteString(entry.Key);
            writer.WriteI32(entry.Value);
        }
    }

    internal static Dictionary<string, int> ReadMapOfStringToI32(FfiBufferReader reader)
    {
        var count = reader.ReadLen();
        var map = new Dictionary<string, int>(reader.Capacity(count));
        for (var i = 0; i < count; i++)
        {
            var key = reader.ReadString();
            if (!map.TryAdd(key, reader.ReadI32()))
            {
                throw FfiBufferReader.Malformed("repeated map key");
            }
        }
        return map;
    }

    internal static void WriteMapOfStringToString(FfiBufferWriter writer, Dictionary<string, string> value)
    {
        writer.WriteLen(value.Count);
        foreach (var entry in value)
        {
            writer.WriteString(entry.Key);
            writer.WriteString(entry.Value);
        }
    }

    internal static Dictionary<string, string> ReadMapOfStringToString(FfiBufferReader reader)
    {
        var count = reader.ReadLen();
        var map = new Dictionary<string, string>(reader.Capacity(count));
        for (var i = 0; i < count; i++)
        {
            var key = reader.ReadString();
            if (!map.TryAdd(key, reader.ReadString()))
            {
                throw FfiBufferReader.Malformed("repeated map key");
            }
        }
        return map;
    }

    internal static void WriteOptionalOfGadget(FfiBufferWriter writer, Gadget? value)
    {
        writer.WriteBool(value != null);
        if (value is { } present)
        {
            writer.WriteObject(present.CloneHandle());
        }
    }

    internal static Gadget? ReadOptionalOfGadget(FfiBufferReader reader)
    {
        return reader.ReadBool() ? global::KitchenSink.Gadget.Adopt(reader.ReadObject()) : null;
    }

    internal static void WriteOptionalOfI64(FfiBufferWriter writer, long? value)
    {
        writer.WriteBool(value != null);
        if (value is { } present)
        {
            writer.WriteI64(present);
        }
    }

    internal static long? ReadOptionalOfI64(FfiBufferReader reader)
    {
        return reader.ReadBool() ? reader.ReadI64() : null;
    }

    internal static void WriteOptionalOfItem(FfiBufferWriter writer, Item? value)
    {
        writer.WriteBool(value != null);
        if (value is { } present)
        {
            present.WriteTo(writer);
        }
    }

    internal static Item? ReadOptionalOfItem(FfiBufferReader reader)
    {
        return reader.ReadBool() ? global::KitchenSink.Item.ReadFrom(reader) : null;
    }
}

