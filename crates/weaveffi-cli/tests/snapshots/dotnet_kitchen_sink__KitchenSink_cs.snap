public static unsafe class KitchenNested
{
    /// <summary>Trivial nested-module function</summary>
    public static string Hello()
    {
        var ffiErr = default(FfiError);
        nuint ffiOutLen = 0;
        var ffiResult = NativeMethods.kitchen_sink_kitchen_nested_hello(&ffiOutLen, &ffiErr);
        if (ffiErr.Code != 0) throw Ffi.TakeError(&ffiErr, global::KitchenSink.NativeException.FromError);
        return Ffi.TakeString(ffiResult, ffiOutLen);
    }
}

