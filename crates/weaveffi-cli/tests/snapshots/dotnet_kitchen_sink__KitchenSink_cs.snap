        var ffiResult = NativeMethods.kitchen_sink_Gadget_describe(Handle, &ffiErr);
        if (ffiErr.Code != 0) throw Ffi.TakeError(&ffiErr, &global::KitchenSink.NativeBugException.FromError);
        return Ffi.TakeString(ffiResult);
    }

