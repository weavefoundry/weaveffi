    /// <summary>A display label, failing with a kitchen error</summary>
    /// <exception cref="KitchenErrorsException">Reported to the library with its code and fields.</exception>
    string Label();

    /// <summary>The most recent item the listener kept, if any</summary>
    Item? Latest();

    /// <summary>The listener's favorite gadget</summary>
    Gadget Favorite();
}

