        var ffiResult = NativeMethods.kitchen_sink_Gadget_poke(Handle, times, &ffiErr);
        if (ffiErr.Code != 0) throw Ffi.TakeError(&ffiErr, &global::KitchenSink.KitchenException.FromError);
        return ffiResult;
    }

