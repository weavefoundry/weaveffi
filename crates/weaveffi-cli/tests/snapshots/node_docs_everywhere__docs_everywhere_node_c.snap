static void invoke_docs_everywhere_docs_SavedListener_on_saved(napi_env env, js_cb* cb, frame_docs_everywhere_docs_SavedListener_on_saved* f) {
  napi_handle_scope scope;
  napi_open_handle_scope(env, &scope);
  napi_value argv[3];
  argv[0] = js_new_i64(env, f->p0);
  argv[1] = js_new_i32(env, (int32_t)f->p1);
  napi_value result;
  if (!js_cb_call(env, cb, "on_saved", 2, argv, &result)) {
    js_cb_report(env, f->hdr.out_err, "SavedListener.on_saved failed");
  }
  napi_close_handle_scope(env, scope);
}

static void tramp_docs_everywhere_docs_SavedListener_on_saved(void* ctx, int64_t p0, int32_t p1, docs_everywhere_error* out_err) {
  frame_docs_everywhere_docs_SavedListener_on_saved f;
  memset(&f, 0, sizeof f);
  f.hdr.out_err = out_err;
  f.p0 = p0;
  f.p1 = p1;
  js_cb* cb = (js_cb*)ctx;
  if (js_cb_on_js_thread(cb)) {
    invoke_docs_everywhere_docs_SavedListener_on_saved(cb->env, cb, &f);
  } else {
    js_cb_req req;
    memset(&req, 0, sizeof req);
    req.cb = cb;
    req.method = 0;
    req.frame = &f;
    js_cb_hop(&req);
  }
}

static void dispatch_docs_everywhere_docs_SavedListener(napi_env env, napi_value fn, void* context, void* data) {
  (void)fn;
  (void)context;
  js_cb_req* req = (js_cb_req*)data;
  if (req->method < 0) {
    js_cb_release(env, req->cb);
    free(req);
    return;
  }
  if (env == NULL) {
    docs_everywhere_error_set(((js_cb_frame*)req->frame)->out_err, -4, "the JavaScript environment is shutting down");
  } else {
    switch (req->method) {
      case 0: invoke_docs_everywhere_docs_SavedListener_on_saved(env, req->cb, (frame_docs_everywhere_docs_SavedListener_on_saved*)req->frame); break;
      default: break;
    }
  }
  js_cb_finish(req);
}

