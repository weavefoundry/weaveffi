/* Enters a trampoline: the JNIEnv with a local frame pushed, or NULL after
   reporting the failure through `out_err`. */
static JNIEnv* Jni_callback_begin(docs_everywhere_error* out_err, int* detach) {
    JNIEnv* env = Jni_env(detach);
    if (env == NULL) {
        docs_everywhere_error_set(out_err, -4, "could not attach the calling thread to the JVM");
        return NULL;
    }
    if ((*env)->PushLocalFrame(env, 16) != 0) {
        (*env)->ExceptionClear(env);
        docs_everywhere_error_set(out_err, -4, "JNI local frame exhausted");
        Jni_env_done(*detach);
        return NULL;
    }
    return env;
}

/* Leaves a trampoline. An exception still pending means the dispatch itself
   failed (the shim catches everything the implementation throws), which
   reaches the producer as code -4; nothing ever unwinds through its frames. */
static void Jni_callback_end(JNIEnv* env, docs_everywhere_error* out_err, int detach) {
    if ((*env)->ExceptionCheck(env)) {
        (*env)->ExceptionClear(env);
        docs_everywhere_error_set(out_err, -4, "the JVM failed to dispatch the callback");
    }
    (*env)->PopLocalFrame(env, NULL);
    Jni_env_done(detach);
}

