/**
 * Errors of the `KitchenErrors` domain, one subclass per code.
 *
 * A code these bindings don't declare (from a newer library) is a plain `KitchenException`
 * carrying that [code] and the library's message.
 */
open class KitchenException internal constructor(code: Int, message: String) : FfiException(code, message) {
    class NotFound(message: String = "Item not found") : KitchenException(1, message)
    class InvalidInput(message: String = "Invalid input") : KitchenException(2, message)

    internal companion object {
        /** The exception for a positive code and its serialized payload. */
        fun fromCode(code: Int, message: String, payload: ByteArray?): KitchenException = when (code) {
            1 -> NotFound(message)
            2 -> InvalidInput(message)
            else -> KitchenException(code, message)
        }
    }
}

/**
 * Errors of the `PantryError` domain, one subclass per code.
 *
 * A code these bindings don't declare (from a newer library) is a plain `PantryException`
 * carrying that [code] and the library's message.
 */
open class PantryException internal constructor(code: Int, message: String) : FfiException(code, message) {
    class OutOfStock(val item: String, message: String = "Out of stock") : PantryException(1, message) {
        override fun encodePayload(): ByteArray = encodeBuffer { _w ->
            _w.writeString(item)
        }
    }
    class Spoiled(message: String = "Spoiled") : PantryException(2, message)

    internal companion object {
        /** The exception for a positive code and its serialized payload. */
        fun fromCode(code: Int, message: String, payload: ByteArray?): PantryException = when (code) {
            1 -> if (payload == null) PantryException(code, message) else decodeBuffer(payload) { _r -> OutOfStock(_r.readString(), message) }
            2 -> Spoiled(message)
            else -> PantryException(code, message)
        }
    }
}

/** Task priority levels */
enum class Priority(val value: Int) {
    /** Low priority */
    Low(0),
    /** Normal priority */
    Normal(1),
    /** High priority */
    High(2);

    companion object {
        /** The variant whose ABI value is [value]. */
        @JvmStatic
        fun fromValue(value: Int): Priority = entries.firstOrNull { it.value == value }
            ?: throw NativeBugException(-3, "unknown Priority value $value")
    }
}

/** A reusable token referenced from several declarations */
data class Token(val id: Long, val label: String)

internal fun pack_Token(_w: BufferWriter, _v: Token) {
    _w.writeI64(_v.id)
    _w.writeString(_v.label)
}

internal fun unpack_Token(_r: BufferReader): Token = Token(
    _r.readI64(),
    _r.readString(),
)

/** Kitchen sink struct exercising every field feature */
data class Item(
    /** Stable identifier */
    val id: Long,
    /** Display name */
    val name: String,
    /** Initial count */
    val count: Int,
    /** Whether the item is enabled */
    val enabled: Boolean,
    /** Scaling ratio */
    val ratio: Double,
    val nick: UInt,
    val payload: ByteArray,
    val tags: List<String>,
    val attrs: Map<String, String>,
    val parent: Long?,
    /** A record inside a record */
    val token: Token,
    val priority: Priority,
    /** An optional object inside a record */
    val gadget: Gadget?,
) {
    override fun equals(other: Any?): Boolean {
        if (this === other) return true
        if (other !is Item) return false
        return id == other.id &&
            name == other.name &&
            count == other.count &&
            enabled == other.enabled &&
            ratio == other.ratio &&
            nick == other.nick &&
            payload.contentEquals(other.payload) &&
            tags == other.tags &&
            attrs == other.attrs &&
            parent == other.parent &&
            token == other.token &&
            priority == other.priority &&
            gadget == other.gadget
    }

    override fun hashCode(): Int {
        var result = id.hashCode()
        result = 31 * result + name.hashCode()
        result = 31 * result + count.hashCode()
        result = 31 * result + enabled.hashCode()
        result = 31 * result + ratio.hashCode()
        result = 31 * result + nick.hashCode()
        result = 31 * result + payload.contentHashCode()
        result = 31 * result + tags.hashCode()
        result = 31 * result + attrs.hashCode()
        result = 31 * result + parent.hashCode()
        result = 31 * result + token.hashCode()
        result = 31 * result + priority.hashCode()
        result = 31 * result + gadget.hashCode()
        return result
    }

    override fun toString(): String = "Item(id=${id}, name=${name}, count=${count}, enabled=${enabled}, ratio=${ratio}, nick=${nick}, payload=${payload.contentToString()}, tags=${tags}, attrs=${attrs}, parent=${parent}, token=${token}, priority=${priority}, gadget=${gadget})"
}

internal fun pack_Item(_w: BufferWriter, _v: Item) {
    _w.writeI64(_v.id)
    _w.writeString(_v.name)
    _w.writeI32(_v.count)
    _w.writeBool(_v.enabled)
    _w.writeF64(_v.ratio)
    _w.writeU32(_v.nick)
    _w.writeBytes(_v.payload)
    pack_list_string(_w, _v.tags)
    pack_map_string_string(_w, _v.attrs)
    pack_opt_i64(_w, _v.parent)
    pack_Token(_w, _v.token)
    _w.writeI32(_v.priority.value)
    pack_opt_Gadget(_w, _v.gadget)
}

