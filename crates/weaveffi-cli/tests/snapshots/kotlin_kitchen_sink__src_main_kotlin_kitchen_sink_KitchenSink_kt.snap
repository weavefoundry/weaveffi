    unpack_opt_Gadget(_r),
)

/** Consumer-implemented observer of ready items */
interface ReadyListener {
    /** Fires when an item is ready */
    fun onReady(code: Int, msg: String)

    /** Receives the item itself and says whether to keep listening */
    fun onItem(item: Item, gadget: Gadget): Boolean

    /**
     * A display label, failing with a kitchen error
     *
     * Throw a [KitchenException] to report a typed error to the library; anything else
     * thrown reaches it as an untyped failure with its message.
     */
    @Throws(KitchenException::class)
    fun label(): String

    /** The most recent item the listener kept, if any */
    fun latest(): Item?

    /** The listener's favorite gadget */
    fun favorite(): Gadget
}

/** Consumer-implemented source of scalar samples */
interface Sampler {
    /** The cutoff for a level, if the sampler has one */
    fun threshold(level: UInt?): Double?

    /**
     * Up to `limit` samples, failing when the pantry is empty
     *
     * Throw a [PantryException] to report a typed error to the library; anything else
     * thrown reaches it as an untyped failure with its message.
     */
    @Throws(PantryException::class)
    fun samples(limit: UInt?, weights: List<Double>): List<Short>

    /**
     * A free-form description, failing with an untyped error
     *
     * Anything thrown reaches the library as a failure with its message.
     */
    @Throws(Exception::class)
    fun describe(): String
}

