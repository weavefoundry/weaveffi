// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

package weaveffi

/*
#cgo LDFLAGS: -lweaveffi
#include "weaveffi.h"
#include <stdlib.h>
extern void goWv_weaveffi_kv_OnEvict_fn(char* key, void* context);
extern void goWv_weaveffi_kv_Store_compact_callback(void* context, weaveffi_error* err, int64_t result);
*/
import "C"

import (
	"encoding/binary"
	"fmt"
	"iter"
	"math"
	"sync"
	"unicode/utf8"
	"unsafe"
)

func boolToC(b bool) C._Bool {
	return C._Bool(b)
}

func cToBool(b C._Bool) bool {
	return bool(b)
}

// WeaveFFIError reports a failure crossing the C boundary that no typed
// error domain claims: an unknown code, a marshalling failure, or a
// producer panic.
type WeaveFFIError struct {
	// Code is the numeric ABI error code.
	Code int32
	// Message is the human-readable error message.
	Message string
}

func (e *WeaveFFIError) Error() string {
	return fmt.Sprintf("weaveffi: %s (code %d)", e.Message, e.Code)
}

// wvTakeError reads and clears a non-zero C error slot, returning its
// code, message, and a copy of its structured payload buffer (nil when
// the code declares no payload fields).
func wvTakeError(cErr *C.weaveffi_error) (int32, string, []byte) {
	code := int32(cErr.code)
	msg := ""
	if cErr.message != nil {
		msg = C.GoString(cErr.message)
	}
	var payload []byte
	if cErr.payload_ptr != nil {
		payload = C.GoBytes(unsafe.Pointer(cErr.payload_ptr), C.int(cErr.payload_len))
	}
	C.weaveffi_error_clear(cErr)
	return code, msg, payload
}

// wvTakeBoxedError reads a heap-boxed error delivered to an async
// completion callback and releases the box with weaveffi_error_free.
func wvTakeBoxedError(cErr *C.weaveffi_error) (int32, string, []byte) {
	code := int32(cErr.code)
	msg := ""
	if cErr.message != nil {
		msg = C.GoString(cErr.message)
	}
	var payload []byte
	if cErr.payload_ptr != nil {
		payload = C.GoBytes(unsafe.Pointer(cErr.payload_ptr), C.int(cErr.payload_len))
	}
	C.weaveffi_error_free(cErr)
	return code, msg, payload
}

func wvBrandError(code int32, message string, _ []byte) error {
	return &WeaveFFIError{Code: code, Message: message}
}

// wvTrap panics when the C error slot reports a failure. Non-throwing
// wrappers check their slot with it: a non-zero code there can only be
// a producer panic or a marshalling failure.
func wvTrap(cErr *C.weaveffi_error) {
	if cErr.code != 0 {
		code, msg, _ := wvTakeError(cErr)
		panic(fmt.Sprintf("weaveffi: %s (code %d)", msg, code))
	}
}

// wvWriter serializes values into the WeaveFFI value-buffer format:
// little-endian, packed, u32 length prefixes.
type wvWriter struct {
	buf []byte
}

func (w *wvWriter) writeBool(v bool) {
	if v {
		w.buf = append(w.buf, 1)
	} else {
		w.buf = append(w.buf, 0)
	}
}

func (w *wvWriter) writeI8(v int8) {
	w.buf = append(w.buf, byte(v))
}

func (w *wvWriter) writeU8(v uint8) {
	w.buf = append(w.buf, v)
}

func (w *wvWriter) writeI16(v int16) {
	w.buf = binary.LittleEndian.AppendUint16(w.buf, uint16(v))
}

func (w *wvWriter) writeU16(v uint16) {
	w.buf = binary.LittleEndian.AppendUint16(w.buf, v)
}

func (w *wvWriter) writeI32(v int32) {
	w.buf = binary.LittleEndian.AppendUint32(w.buf, uint32(v))
}

func (w *wvWriter) writeU32(v uint32) {
	w.buf = binary.LittleEndian.AppendUint32(w.buf, v)
}

func (w *wvWriter) writeI64(v int64) {
	w.buf = binary.LittleEndian.AppendUint64(w.buf, uint64(v))
}

func (w *wvWriter) writeU64(v uint64) {
	w.buf = binary.LittleEndian.AppendUint64(w.buf, v)
}

func (w *wvWriter) writeF32(v float32) {
	w.writeU32(math.Float32bits(v))
}

func (w *wvWriter) writeF64(v float64) {
	w.writeU64(math.Float64bits(v))
}

func (w *wvWriter) writeLen(n int) {
	if n < 0 || uint64(n) > uint64(^uint32(0)) {
		panic("weaveffi: value-buffer length exceeds u32 range")
	}
	w.writeU32(uint32(n))
}

func (w *wvWriter) writeString(v string) {
	w.writeLen(len(v))
	w.buf = append(w.buf, v...)
}

func (w *wvWriter) writeBytes(v []byte) {
	w.writeLen(len(v))
	w.buf = append(w.buf, v...)
}

func (w *wvWriter) writeOptionFlag(present bool) {
	w.writeBool(present)
}

// wvReader decodes values from the WeaveFFI value-buffer format. A
// malformed buffer is a producer/consumer contract violation, so every
// read panics (the same channel a trapped producer error uses) instead
// of returning a typed domain error.
type wvReader struct {
	buf []byte
	pos int
}

func wvMalformed(context string) {
	panic("weaveffi: malformed value buffer: " + context)
}

func (r *wvReader) take(n int, context string) []byte {
	if n < 0 || len(r.buf)-r.pos < n {
		wvMalformed(context)
	}
	b := r.buf[r.pos : r.pos+n]
	r.pos += n
	return b
}

func (r *wvReader) readBool() bool {
	switch r.take(1, "bool")[0] {
	case 0:
		return false
	case 1:
		return true
	}
	wvMalformed("bool byte out of range")
	return false
}

func (r *wvReader) readI8() int8 {
	return int8(r.take(1, "i8")[0])
}

func (r *wvReader) readU8() uint8 {
	return r.take(1, "u8")[0]
}

func (r *wvReader) readI16() int16 {
	return int16(binary.LittleEndian.Uint16(r.take(2, "i16")))
}

func (r *wvReader) readU16() uint16 {
	return binary.LittleEndian.Uint16(r.take(2, "u16"))
}

func (r *wvReader) readI32() int32 {
	return int32(binary.LittleEndian.Uint32(r.take(4, "i32")))
}

func (r *wvReader) readU32() uint32 {
	return binary.LittleEndian.Uint32(r.take(4, "u32"))
}

func (r *wvReader) readI64() int64 {
	return int64(binary.LittleEndian.Uint64(r.take(8, "i64")))
}

func (r *wvReader) readU64() uint64 {
	return binary.LittleEndian.Uint64(r.take(8, "u64"))
}

func (r *wvReader) readF32() float32 {
	return math.Float32frombits(r.readU32())
}

func (r *wvReader) readF64() float64 {
	return math.Float64frombits(r.readU64())
}

func (r *wvReader) readLen() int {
	n := int(r.readU32())
	if n > len(r.buf)-r.pos {
		wvMalformed("length prefix exceeds remaining buffer")
	}
	return n
}

func (r *wvReader) readString() string {
	b := r.take(r.readLen(), "string bytes")
	if !utf8.Valid(b) {
		wvMalformed("string is not valid UTF-8")
	}
	return string(b)
}

func (r *wvReader) readBytes() []byte {
	b := r.take(r.readLen(), "byte buffer")
	out := make([]byte, len(b))
	copy(out, b)
	return out
}

func (r *wvReader) readOptionFlag() bool {
	switch r.take(1, "option flag")[0] {
	case 0:
		return false
	case 1:
		return true
	}
	wvMalformed("option flag byte out of range")
	return false
}

func (r *wvReader) expectEnd() {
	if r.pos != len(r.buf) {
		wvMalformed("trailing bytes after value")
	}
}

// wvCopyBuffer copies an owned, producer-allocated value buffer into Go
// memory and releases it with weaveffi_free_bytes.
func wvCopyBuffer(ptr *C.uint8_t, length C.size_t) []byte {
	if ptr == nil {
		return nil
	}
	out := C.GoBytes(unsafe.Pointer(ptr), C.int(length))
	C.weaveffi_free_bytes(ptr, length)
	return out
}

// wvBorrowBuffer copies a borrowed value buffer into Go memory. The
// producer keeps ownership and frees it after the borrowing call returns.
func wvBorrowBuffer(ptr *C.uint8_t, length C.size_t) []byte {
	if ptr == nil {
		return nil
	}
	return C.GoBytes(unsafe.Pointer(ptr), C.int(length))
}

var (
	wvCallbackMu  sync.Mutex
	wvCallbackSeq uint64
	wvCallbacks   = map[uint64]interface{}{}
	// Subscription id -> registry id, so unregister can release the Go callback.
	wvListenerCtx = map[uint64]uint64{}
)

func wvCallbackStore(v interface{}) uint64 {
	wvCallbackMu.Lock()
	defer wvCallbackMu.Unlock()
	wvCallbackSeq++
	wvCallbacks[wvCallbackSeq] = v
	return wvCallbackSeq
}

func wvCallbackLoad(id uint64) interface{} {
	wvCallbackMu.Lock()
	defer wvCallbackMu.Unlock()
	return wvCallbacks[id]
}

func wvCallbackTake(id uint64) interface{} {
	wvCallbackMu.Lock()
	defer wvCallbackMu.Unlock()
	v := wvCallbacks[id]
	delete(wvCallbacks, id)
	return v
}

func wvCallbackDelete(id uint64) {
	wvCallbackMu.Lock()
	defer wvCallbackMu.Unlock()
	delete(wvCallbacks, id)
}

// KvError is a typed error reported by the `kv` module.
type KvError struct {
	// Code is the numeric ABI error code (one of the KvError constants).
	Code int32
	// Message is the human-readable error message.
	Message string
}

func (e *KvError) Error() string {
	return fmt.Sprintf("kv: %s (code %d)", e.Message, e.Code)
}

// KvError codes.
const (
	// KvErrorKeyNotFound: No entry exists for the requested key
	KvErrorKeyNotFound int32 = 1001
	// KvErrorExpired: The entry exists but its TTL has elapsed
	KvErrorExpired int32 = 1002
	// KvErrorStoreFull: The store has reached its capacity limit
	KvErrorStoreFull int32 = 1003
	// KvErrorIoError: Underlying storage reported an I/O failure
	KvErrorIoError int32 = 1004
)

// wvMapKv converts a non-zero code from the `kv` domain into a
// *KvError, falling back to the generic *WeaveFFIError for unknown codes.
func wvMapKv(code int32, message string, payload []byte) error {
	switch code {
	case KvErrorKeyNotFound:
		if message == "" {
			message = "key not found"
		}
		return &KvError{Code: code, Message: message}
	case KvErrorExpired:
		if message == "" {
			message = "entry expired"
		}
		return &KvError{Code: code, Message: message}
	case KvErrorStoreFull:
		if message == "" {
			message = "store has reached capacity"
		}
		return &KvError{Code: code, Message: message}
	case KvErrorIoError:
		if message == "" {
			message = "I/O failure"
		}
		return &KvError{Code: code, Message: message}
	default:
		return wvBrandError(code, message, payload)
	}
}

// EntryKind: Persistence semantics applied to a stored entry
type EntryKind int32

const (
	// EntryKindVolatile: In-memory only; lost on close
	EntryKindVolatile EntryKind = 0
	// EntryKindPersistent: Flushed to durable storage
	EntryKindPersistent EntryKind = 1
	// EntryKindEncrypted: Persistent and encrypted at rest
	EntryKindEncrypted EntryKind = 2
)

// Entry: A single key-value entry persisted in the store
type Entry struct {
	// Id: Stable monotonic identifier assigned on insert
	Id int64
	// Key: UTF-8 lookup key
	Key string
	// Value: Opaque binary payload
	Value []byte
	// CreatedAt: Unix-timestamp seconds when the entry was created
	CreatedAt int64
	// ExpiresAt: Optional unix-timestamp seconds at which the entry expires
	ExpiresAt *int64
	// Tags: Free-form labels attached to the entry
	Tags []string
	// Metadata: Arbitrary string-valued metadata pairs
	Metadata map[string]string
}

// wvPackEntry appends v to w in the value-buffer wire format.
func wvPackEntry(w *wvWriter, v Entry) {
	w.writeI64(v.Id)
	w.writeString(v.Key)
	w.writeBytes(v.Value)
	w.writeI64(v.CreatedAt)
	if v.ExpiresAt == nil {
		w.writeOptionFlag(false)
	} else {
		w.writeOptionFlag(true)
		w.writeI64((*v.ExpiresAt))
	}
	w.writeLen(len(v.Tags))
	for _, eTags0 := range v.Tags {
		w.writeString(eTags0)
	}
	w.writeLen(len(v.Metadata))
	for kMetadata0, vMetadata0 := range v.Metadata {
		w.writeString(kMetadata0)
		w.writeString(vMetadata0)
	}
}

// wvUnpackEntry decodes one Entry from r.
func wvUnpackEntry(r *wvReader) Entry {
	var v Entry
	v.Id = r.readI64()
	v.Key = r.readString()
	v.Value = r.readBytes()
	v.CreatedAt = r.readI64()
	if r.readOptionFlag() {
		var oExpiresAt0 int64
		oExpiresAt0 = r.readI64()
		v.ExpiresAt = &oExpiresAt0
	}
	nTags0 := r.readLen()
	v.Tags = make([]string, nTags0)
	for iTags0 := range v.Tags {
		v.Tags[iTags0] = r.readString()
	}
	nMetadata0 := r.readLen()
	v.Metadata = make(map[string]string, nMetadata0)
	for iMetadata0 := 0; iMetadata0 < nMetadata0; iMetadata0++ {
		var kMetadata0 string
		kMetadata0 = r.readString()
		var vMetadata0 string
		vMetadata0 = r.readString()
		v.Metadata[kMetadata0] = vMetadata0
	}
	return v
}

// Store: An in-memory key-value store owning its entries; destroying the object releases all of its state
type Store struct {
	ptr *C.weaveffi_kv_Store
}

// OpenStore: Open (or create) a store backed by the given filesystem path
func OpenStore(path string) (*Store, error) {
	cPath := C.CString(path)
	defer C.free(unsafe.Pointer(cPath))
	var cErr C.weaveffi_error
	result := C.weaveffi_kv_Store_open(cPath, &cErr)
	if cErr.code != 0 {
		return nil, wvMapKv(wvTakeError(&cErr))
	}
	return &Store{ptr: result}, nil
}

// Put: Insert or replace a value, returning true on success
func (s *Store) Put(key string, value []byte, kind EntryKind, ttlSeconds *int64) (bool, error) {
	cKey := C.CString(key)
	defer C.free(unsafe.Pointer(cKey))
	var cValuePtr *C.uint8_t
	cValueLen := C.size_t(len(value))
	if len(value) > 0 {
		cValuePtr = (*C.uint8_t)(unsafe.Pointer(&value[0]))
	}
	wTtlSeconds := &wvWriter{}
	if ttlSeconds == nil {
		wTtlSeconds.writeOptionFlag(false)
	} else {
		wTtlSeconds.writeOptionFlag(true)
		wTtlSeconds.writeI64((*ttlSeconds))
	}
	var cTtlSecondsPtr *C.uint8_t
	if len(wTtlSeconds.buf) > 0 {
		cTtlSecondsPtr = (*C.uint8_t)(unsafe.Pointer(&wTtlSeconds.buf[0]))
	}
	var cErr C.weaveffi_error
	result := C.weaveffi_kv_Store_put(s.ptr, cKey, cValuePtr, cValueLen, C.weaveffi_kv_EntryKind(kind), cTtlSecondsPtr, C.size_t(len(wTtlSeconds.buf)), &cErr)
	if cErr.code != 0 {
		return false, wvMapKv(wvTakeError(&cErr))
	}
	return cToBool(result), nil
}

// Get: Look up an entry by key; returns null if missing or expired
func (s *Store) Get(key string) (*Entry, error) {
	cKey := C.CString(key)
	defer C.free(unsafe.Pointer(cKey))
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kv_Store_get(s.ptr, cKey, &cOutLen, &cErr)
	if cErr.code != 0 {
		return nil, wvMapKv(wvTakeError(&cErr))
	}
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult *Entry
	if rRes.readOptionFlag() {
		var oRes0 Entry
		oRes0 = wvUnpackEntry(rRes)
		goResult = &oRes0
	}
	rRes.expectEnd()
	return goResult, nil
}

// Delete: Remove the entry for the given key, returning true if it existed
func (s *Store) Delete(key string) (bool, error) {
	cKey := C.CString(key)
	defer C.free(unsafe.Pointer(cKey))
	var cErr C.weaveffi_error
	result := C.weaveffi_kv_Store_delete(s.ptr, cKey, &cErr)
	if cErr.code != 0 {
		return false, wvMapKv(wvTakeError(&cErr))
	}
	return cToBool(result), nil
}

// ListKeys: Stream every key, optionally filtered by a prefix
// Returns a lazy sequence: the producer iterator is launched on first
// iteration and one producer next call runs per element. The iterator is
// destroyed exactly once, whether the sequence is exhausted or abandoned
// early; each range over the sequence launches a fresh producer iterator.
// A launch or per-element error is yielded as the final (zero value,
// error) pair, and iteration stops.
func (s *Store) ListKeys(prefix *string) iter.Seq2[string, error] {
	return func(yield func(string, error) bool) {
		wPrefix := &wvWriter{}
		if prefix == nil {
			wPrefix.writeOptionFlag(false)
		} else {
			wPrefix.writeOptionFlag(true)
			wPrefix.writeString((*prefix))
		}
		var cPrefixPtr *C.uint8_t
		if len(wPrefix.buf) > 0 {
			cPrefixPtr = (*C.uint8_t)(unsafe.Pointer(&wPrefix.buf[0]))
		}
		var cErr C.weaveffi_error
		it := C.weaveffi_kv_Store_list_keys(s.ptr, cPrefixPtr, C.size_t(len(wPrefix.buf)), &cErr)
		if cErr.code != 0 {
			yield("", wvMapKv(wvTakeError(&cErr)))
			return
		}
		defer C.weaveffi_kv_Store_ListKeysIterator_destroy(it)
		for {
			var outItem *C.char
			var iterErr C.weaveffi_error
			ok := C.weaveffi_kv_Store_ListKeysIterator_next(it, &outItem, &iterErr) != 0
			if iterErr.code != 0 {
				yield("", wvMapKv(wvTakeError(&iterErr)))
				return
			}
			if !ok {
				return
			}
			item := C.GoString(outItem)
			C.weaveffi_free_string(outItem)
			if !yield(item, nil) {
				return
			}
		}
	}
}

// Count: Return the number of live entries in the store
func (s *Store) Count() int64 {
	var cErr C.weaveffi_error
	result := C.weaveffi_kv_Store_count(s.ptr, &cErr)
	wvTrap(&cErr)
	return int64(result)
}

// Clear: Drop every entry from the store
func (s *Store) Clear() {
	var cErr C.weaveffi_error
	C.weaveffi_kv_Store_clear(s.ptr, &cErr)
	wvTrap(&cErr)
}

type wvOutcomeKvStoreCompact struct {
	val int64
	err error
}

//export goWv_weaveffi_kv_Store_compact_callback
func goWv_weaveffi_kv_Store_compact_callback(context unsafe.Pointer, err *C.weaveffi_error, result C.int64_t) {
	v := wvCallbackTake(uint64(uintptr(context)))
	if v == nil {
		return
	}
	ch := v.(chan wvOutcomeKvStoreCompact)
	if err != nil && err.code != 0 {
		ch <- wvOutcomeKvStoreCompact{err: wvMapKv(wvTakeBoxedError(err))}
		return
	}
	ch <- wvOutcomeKvStoreCompact{val: int64(result)}
}

// Compact: Reclaim space asynchronously; returns the number of bytes reclaimed
// Blocks the calling goroutine until the async producer completes.
func (s *Store) Compact() (int64, error) {
	ch := make(chan wvOutcomeKvStoreCompact, 1)
	ctxID := wvCallbackStore(ch)
	C.weaveffi_kv_Store_compact_async(s.ptr, nil, C.weaveffi_kv_Store_compact_callback(unsafe.Pointer(C.goWv_weaveffi_kv_Store_compact_callback)), unsafe.Pointer(uintptr(ctxID)))
	outcome := <-ch
	if outcome.err != nil {
		return 0, outcome.err
	}
	return outcome.val, nil
}

// LegacyPut: Legacy single-shot put kept for compatibility
// Deprecated: use put() with explicit kind
func (s *Store) LegacyPut(key string, value []byte) (bool, error) {
	cKey := C.CString(key)
	defer C.free(unsafe.Pointer(cKey))
	var cValuePtr *C.uint8_t
	cValueLen := C.size_t(len(value))
	if len(value) > 0 {
		cValuePtr = (*C.uint8_t)(unsafe.Pointer(&value[0]))
	}
	var cErr C.weaveffi_error
	result := C.weaveffi_kv_Store_legacy_put(s.ptr, cKey, cValuePtr, cValueLen, &cErr)
	if cErr.code != 0 {
		return false, wvMapKv(wvTakeError(&cErr))
	}
	return cToBool(result), nil
}

// StoreDefaultCapacity: The largest number of live entries one store will hold
func StoreDefaultCapacity() int64 {
	var cErr C.weaveffi_error
	result := C.weaveffi_kv_Store_default_capacity(&cErr)
	wvTrap(&cErr)
	return int64(result)
}

func (s *Store) Close() {
	if s.ptr != nil {
		C.weaveffi_kv_Store_destroy(s.ptr)
		s.ptr = nil
	}
}

//export goWv_weaveffi_kv_OnEvict_fn
func goWv_weaveffi_kv_OnEvict_fn(key *C.char, context unsafe.Pointer) {
	v := wvCallbackLoad(uint64(uintptr(context)))
	if v == nil {
		return
	}
	cb := v.(func(key string))
	arg0 := ""
	if key != nil {
		arg0 = C.GoString(key)
	}
	cb(arg0)
}

// RegisterEvictionListener: Subscribe to per-key eviction notifications
// Returns a subscription id for UnregisterEvictionListener.
func RegisterEvictionListener(callback func(key string)) uint64 {
	ctxID := wvCallbackStore(callback)
	id := uint64(C.weaveffi_kv_register_eviction_listener(C.weaveffi_kv_OnEvict_fn(unsafe.Pointer(C.goWv_weaveffi_kv_OnEvict_fn)), unsafe.Pointer(uintptr(ctxID))))
	wvCallbackMu.Lock()
	wvListenerCtx[id] = ctxID
	wvCallbackMu.Unlock()
	return id
}

// UnregisterEvictionListener unregisters a listener previously registered with RegisterEvictionListener.
func UnregisterEvictionListener(id uint64) {
	C.weaveffi_kv_unregister_eviction_listener(C.uint64_t(id))
	wvCallbackMu.Lock()
	ctxID, ok := wvListenerCtx[id]
	delete(wvListenerCtx, id)
	wvCallbackMu.Unlock()
	if ok {
		wvCallbackDelete(ctxID)
	}
}

// Stats: Aggregate store statistics
type Stats struct {
	// TotalEntries: Number of live entries
	TotalEntries int64
	// TotalBytes: Sum of all value byte lengths
	TotalBytes int64
	// ExpiredEntries: Number of entries past their TTL but not yet evicted
	ExpiredEntries int64
}

// wvPackStats appends v to w in the value-buffer wire format.
func wvPackStats(w *wvWriter, v Stats) {
	w.writeI64(v.TotalEntries)
	w.writeI64(v.TotalBytes)
	w.writeI64(v.ExpiredEntries)
}

// wvUnpackStats decodes one Stats from r.
func wvUnpackStats(r *wvReader) Stats {
	var v Stats
	v.TotalEntries = r.readI64()
	v.TotalBytes = r.readI64()
	v.ExpiredEntries = r.readI64()
	return v
}

// GetStats: Snapshot the current store statistics
func GetStats(store *Store) (Stats, error) {
	var cOutLen C.size_t
	var cErr C.weaveffi_error
	result := C.weaveffi_kv_stats_get_stats(store.ptr, &cOutLen, &cErr)
	if cErr.code != 0 {
		return Stats{}, wvMapKv(wvTakeError(&cErr))
	}
	rRes := &wvReader{buf: wvCopyBuffer(result, cOutLen)}
	var goResult Stats
	goResult = wvUnpackStats(rRes)
	rRes.expectEnd()
	return goResult, nil
}


// END weaveffi.go
