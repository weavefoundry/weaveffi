// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

// WeaveFFI Wasm bindings (auto-generated)
//
// Boundary conventions for a wasm32-unknown-unknown build:
//
//   Objects   -> i32 pointer into linear memory (0 = null/absent); one
//                strong reference per wrapper, released by close()
//   Enums     -> i32 discriminant value
//   i64/u64   -> JavaScript BigInt
//   Strings   -> NUL-terminated UTF-8 (const char*); a single i32 pointer
//   Bytes     -> i32 data pointer + i32 length (out_len for returns)
//   Buffered  -> records, rich enums, optionals, lists, and maps cross
//                as one value buffer: i32 pointer + i32 length
//   Callbacks -> i32 context key + i32 pointer to a static vtable

// The ABI revision this glue was generated against.
const _ABI_VERSION = 2;

function _checkAbiVersion(wasm) {
  if (typeof wasm.weaveffi_abi_version !== 'function') {
    throw new Error(`the loaded WeaveFFI module predates ABI versioning (this glue expects ABI revision ${_ABI_VERSION})`);
  }
  const found = wasm.weaveffi_abi_version() >>> 0;
  if (found !== _ABI_VERSION) {
    throw new Error(`WeaveFFI ABI mismatch: this glue expects revision ${_ABI_VERSION} but the loaded module reports revision ${found}`);
  }
}

/** Base error for WeaveFFI failures: domain errors extend it, and it is
 * thrown directly for unknown codes, marshalling failures, producer
 * panics, and callback-interface implementations that raised (code -4).
 * Carries the stable ABI `code`. */
export class WeaveFFIError extends Error {
  constructor(code, message) {
    super(message ? `WeaveFFI error ${code}: ${message}` : `WeaveFFI error ${code}`);
    this.name = new.target.name;
    this.code = code;
  }
}

const _enc = new TextEncoder();
const _dec = new TextDecoder();

// Stage a JS string as a NUL-terminated C string in linear memory.
// Returns [ptr, size] (size includes the NUL); release with _free.
function _cstr(wasm, str) {
  const bytes = _enc.encode(str);
  const size = bytes.length + 1;
  const ptr = wasm.weaveffi_alloc(size);
  const mem = new Uint8Array(wasm.memory.buffer, ptr, size);
  mem.set(bytes);
  mem[bytes.length] = 0;
  return [ptr, size];
}

// Read a NUL-terminated C string (0 => null). Does not free.
function _readCStr(wasm, ptr) {
  if (ptr === 0) return null;
  const mem = new Uint8Array(wasm.memory.buffer);
  let end = ptr;
  while (mem[end] !== 0) end++;
  return _dec.decode(mem.subarray(ptr, end));
}

// Read then free a producer-owned C string.
function _takeCStr(wasm, ptr) {
  const s = _readCStr(wasm, ptr);
  if (ptr !== 0) wasm.weaveffi_free_string(ptr);
  return s;
}

// Stage a byte buffer (or an encoded value buffer); returns [ptr, len];
// release with weaveffi_dealloc(ptr, len).
function _bytes(wasm, data) {
  const u8 = data instanceof Uint8Array ? data : new Uint8Array(data);
  const ptr = wasm.weaveffi_alloc(u8.length);
  if (u8.length) new Uint8Array(wasm.memory.buffer, ptr, u8.length).set(u8);
  return [ptr, u8.length];
}

// Copy then free a producer-owned byte (or value) buffer.
function _takeBytes(wasm, ptr, len) {
  if (ptr === 0 || len === 0) return new Uint8Array(0);
  const copy = new Uint8Array(wasm.memory.buffer, ptr, len).slice();
  wasm.weaveffi_free_bytes(ptr, len);
  return copy;
}

// Growable little-endian byte writer implementing the WeaveFFI value-buffer
// wire format: values are packed back to back with no alignment; lengths and
// counts are u32; strings are u32 byte length + UTF-8 bytes (no NUL).
class _BufWriter {
  constructor() {
    this._u8 = new Uint8Array(64);
    this._dv = new DataView(this._u8.buffer);
    this._len = 0;
  }
  _need(n) {
    if (this._len + n <= this._u8.length) return;
    let cap = this._u8.length * 2;
    while (cap < this._len + n) cap *= 2;
    const u8 = new Uint8Array(cap);
    u8.set(this._u8.subarray(0, this._len));
    this._u8 = u8;
    this._dv = new DataView(u8.buffer);
  }
  bool(v) { this._need(1); this._dv.setUint8(this._len, v ? 1 : 0); this._len += 1; }
  i8(v) { this._need(1); this._dv.setInt8(this._len, v); this._len += 1; }
  u8(v) { this._need(1); this._dv.setUint8(this._len, v); this._len += 1; }
  i16(v) { this._need(2); this._dv.setInt16(this._len, v, true); this._len += 2; }
  u16(v) { this._need(2); this._dv.setUint16(this._len, v, true); this._len += 2; }
  i32(v) { this._need(4); this._dv.setInt32(this._len, v, true); this._len += 4; }
  u32(v) { this._need(4); this._dv.setUint32(this._len, v, true); this._len += 4; }
  i64(v) { this._need(8); this._dv.setBigInt64(this._len, BigInt(v), true); this._len += 8; }
  u64(v) { this._need(8); this._dv.setBigUint64(this._len, BigInt(v), true); this._len += 8; }
  f32(v) { this._need(4); this._dv.setFloat32(this._len, v, true); this._len += 4; }
  f64(v) { this._need(8); this._dv.setFloat64(this._len, v, true); this._len += 8; }
  len(n) { this.u32(n); }
  flag(present) { this.u8(present ? 1 : 0); }
  // An object token: the pointer (a wasm32 i32, read unsigned) widened to u64.
  obj(ptr) { this.u64(BigInt(ptr >>> 0)); }
  str(v) {
    const b = _enc.encode(v);
    this.len(b.length);
    this._need(b.length);
    this._u8.set(b, this._len);
    this._len += b.length;
  }
  bytes(v) {
    const b = v instanceof Uint8Array ? v : new Uint8Array(v);
    this.len(b.length);
    this._need(b.length);
    this._u8.set(b, this._len);
    this._len += b.length;
  }
  finish() { return this._u8.subarray(0, this._len); }
}

const _bufDec = new TextDecoder('utf-8', { fatal: true });

// Strict little-endian reader for the WeaveFFI value-buffer wire format. A
// malformed buffer (truncation, invalid bool or flag bytes, an oversized
// length prefix, invalid UTF-8, trailing bytes) is a producer/consumer
// contract violation and throws the generic brand error; code -3 marks a
// consumer-side marshalling failure.
class _BufReader {
  constructor(bytes) {
    this._u8 = bytes;
    this._dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
    this._pos = 0;
  }
  _bad(what) {
    throw new WeaveFFIError(-3, 'malformed value buffer: ' + what);
  }
  _take(n, what) {
    if (this._pos + n > this._u8.length) this._bad('truncated ' + what);
    const at = this._pos;
    this._pos += n;
    return at;
  }
  bool() {
    const b = this._u8[this._take(1, 'bool')];
    if (b > 1) this._bad('bool byte out of range');
    return b === 1;
  }
  i8() { return this._dv.getInt8(this._take(1, 'i8')); }
  u8() { return this._u8[this._take(1, 'u8')]; }
  i16() { return this._dv.getInt16(this._take(2, 'i16'), true); }
  u16() { return this._dv.getUint16(this._take(2, 'u16'), true); }
  i32() { return this._dv.getInt32(this._take(4, 'i32'), true); }
  u32() { return this._dv.getUint32(this._take(4, 'u32'), true); }
  i64() { return this._dv.getBigInt64(this._take(8, 'i64'), true); }
  u64() { return this._dv.getBigUint64(this._take(8, 'u64'), true); }
  f32() { return this._dv.getFloat32(this._take(4, 'f32'), true); }
  f64() { return this._dv.getFloat64(this._take(8, 'f64'), true); }
  len() {
    const n = this.u32();
    if (n > this._u8.length - this._pos) this._bad('length prefix exceeds remaining buffer');
    return n;
  }
  flag() {
    const b = this._u8[this._take(1, 'option flag')];
    if (b > 1) this._bad('option flag byte out of range');
    return b === 1;
  }
  // An object token narrowed back to a wasm32 pointer; zero is never a
  // valid token (an absent `Interface?` uses the option flag instead).
  obj() {
    const t = this.u64();
    if (t === 0n || t > 0xffffffffn) this._bad('object token out of range');
    return Number(t);
  }
  str() {
    const n = this.len();
    const at = this._take(n, 'string bytes');
    try {
      return _bufDec.decode(this._u8.subarray(at, at + n));
    } catch (e) {
      this._bad('string is not valid UTF-8');
    }
  }
  bytes() {
    const n = this.len();
    const at = this._take(n, 'byte buffer');
    return this._u8.subarray(at, at + n).slice();
  }
  end() {
    if (this._pos !== this._u8.length) this._bad('trailing bytes after value');
  }
}

// Allocate a zeroed 16-byte error slot:
// { i32 code, char* message, uint8_t* payload_ptr, size_t payload_len }.
function _allocErr(wasm) {
  const ptr = wasm.weaveffi_alloc(16);
  new Uint8Array(wasm.memory.buffer, ptr, 16).fill(0);
  return ptr;
}

// Throw (and free the slot) if the error slot carries a non-zero code.
// Non-throwing wrappers route here: a non-zero code can only be a
// producer panic (-2), a marshalling failure (-3), or a callback
// interface implementation that raised (-4), surfaced as the generic
// WeaveFFIError.
function _checkErr(wasm, errPtr) {
  _pendingForeign = null;
  const dv = new DataView(wasm.memory.buffer);
  const code = dv.getInt32(errPtr, true);
  if (code !== 0) {
    const msgPtr = dv.getUint32(errPtr + 4, true);
    const msg = _readCStr(wasm, msgPtr) || '';
    wasm.weaveffi_error_clear(errPtr);
    wasm.weaveffi_dealloc(errPtr, 16);
    throw new WeaveFFIError(code, msg);
  }
}

// Release an error slot on the success path.
function _freeErr(wasm, errPtr) {
  _pendingForeign = null;
  wasm.weaveffi_dealloc(errPtr, 16);
}

// The message of a callback-interface failure a trampoline reported through
// out_err, held until the producer call on the stack returns (every error
// checker and _freeErr clear it) so later callbacks in that call are refused.
let _pendingForeign = null;

// Translate an exception raised while a producer call was on the stack.
// wasm32-unknown-unknown has no unwinding runtime: a producer panic executes
// `unreachable`, so the engine throws a WebAssembly.RuntimeError instead of
// the producer writing out_err. A trap that follows a callback-interface
// failure is labelled with that failure (-4); any other trap is a producer
// panic (-2). Non-trap exceptions pass through unchanged. The producer
// frames between the trap and the call are not unwound, so a lock held
// across a callback stays locked; a producer that snapshots its state
// before calling out stays usable.
function _trapError(e) {
  const foreign = _pendingForeign;
  _pendingForeign = null;
  if (!(e instanceof WebAssembly.RuntimeError)) return e;
  if (foreign !== null) return new WeaveFFIError(-4, foreign);
  return new WeaveFFIError(-2, 'producer panicked: ' + e.message);
}

// Release the error slot a failed call never filled, then translate.
function _trap(wasm, errPtr, e) {
  _freeErr(wasm, errPtr);
  return _trapError(e);
}

export const Channel = Object.freeze({
  Red: 0,
  Green: 1,
  Blue: 2,
});

/**
 * Load a WeaveFFI Wasm module.
 *
 * @param {string|URL|BufferSource|WebAssembly.Module} source - A URL to
 *   fetch the `.wasm` from, its bytes, or an already compiled module
 *   (use the bytes form where `fetch` cannot read files, e.g. Node).
 * @returns {Promise<Object>} The API bindings.
 *
 * Exported functions follow the C ABI naming convention:
 *   weaveffi_{module}_{function}(params...) -> result
 *
 * @example
 * const api = await loadWeaveffiWasm('lib.wasm');
 *
 * // Primitive: plain numbers in, number out.
 * const sum = api.math.add(1, 2);
 *
 * // Record: plain objects in and out (serialized automatically).
 * const person = api.contacts.create({ name: 'Ada', age: 36 });
 *
 * // Object: a class wrapping one producer reference; close() releases it
 * // (or let `using` do it). Passing it lends the reference for the call.
 * const store = new api.kv.Store();
 * api.kv.inspect(store);
 * store.close();
 *
 * // Enum: pass the integer discriminant.
 * api.ui.set_color(0); // 0 = first variant
 *
 * // Optional: pass null to omit, a value to provide.
 * api.config.set_timeout(5000); // present
 * api.config.set_timeout(null); // absent
 *
 * // List/Map: pass arrays/objects; receive arrays/objects.
 * const names = api.data.all_names();
 */
export async function loadWeaveffiWasm(source) {
  let module;
  if (source instanceof WebAssembly.Module) {
    module = source;
  } else if (source instanceof ArrayBuffer || ArrayBuffer.isView(source)) {
    module = await WebAssembly.compile(source);
  } else {
    const response = await fetch(source);
    module = await WebAssembly.compile(await response.arrayBuffer());
  }
  const instance = await WebAssembly.instantiate(module, {});
  const wasm = instance.exports;

  _checkAbiVersion(wasm);

  // Serialize a `shapes.Numerics` record into the value-buffer wire format.
  function _write_shapes_Numerics(w, v) {
    w.i8(v.a);
    w.i16(v.b);
    w.i32(v.c);
    w.i64(v.d);
    w.u8(v.e);
    w.u16(v.f);
    w.u32(v.g);
    w.u64(v.h);
    w.f32(v.i);
    w.f64(v.j);
  }

  // Decode a `shapes.Numerics` record from the value-buffer wire format.
  function _read_shapes_Numerics(r) {
    const v = {};
    v.a = r.i8();
    v.b = r.i16();
    v.c = r.i32();
    v.d = r.i64();
    v.e = r.u8();
    v.f = r.u16();
    v.g = r.u32();
    v.h = r.u64();
    v.i = r.f32();
    v.j = r.f64();
    return v;
  }

  // Serialize a `shapes.Shape` rich enum into the value-buffer wire format:
  // an i32 tag, then the active variant's fields in order.
  function _write_shapes_Shape(w, v) {
    switch (v.tag) {
      case "Empty": {
        w.i32(0);
        break;
      }
      case "Circle": {
        w.i32(1);
        w.f64(v.radius);
        break;
      }
      case "Rectangle": {
        w.i32(2);
        w.f32(v.width);
        w.f32(v.height);
        break;
      }
      case "Bounded": {
        w.i32(3);
        w.i16(v.min);
        w.i16(v.max);
        w.u64(v.weight);
        break;
      }
      case "Labeled": {
        w.i32(4);
        w.str(v.label);
        w.u8(v.count);
        break;
      }
      default:
        throw new WeaveFFIError(-3, "unknown Shape variant tag: " + v.tag);
    }
  }

  // Decode a `shapes.Shape` rich enum from the value-buffer wire format.
  function _read_shapes_Shape(r) {
    const _tag = r.i32();
    switch (_tag) {
      case 0:
        return { tag: "Empty" };
      case 1: {
        const v = { tag: "Circle" };
        v.radius = r.f64();
        return v;
      }
      case 2: {
        const v = { tag: "Rectangle" };
        v.width = r.f32();
        v.height = r.f32();
        return v;
      }
      case 3: {
        const v = { tag: "Bounded" };
        v.min = r.i16();
        v.max = r.i16();
        v.weight = r.u64();
        return v;
      }
      case 4: {
        const v = { tag: "Labeled" };
        v.label = r.str();
        v.count = r.u8();
        return v;
      }
      default:
        throw new WeaveFFIError(-3, "malformed value buffer: unknown Shape tag " + _tag);
    }
  }

  return {
    _raw: wasm,
    shapes: {
      describe(shape) {
        const a0_w = new _BufWriter();
        _write_shapes_Shape(a0_w, shape);
        const [a0_p, a0_l] = _bytes(wasm, a0_w.finish());
        const _err = _allocErr(wasm);
        let _r;
        try {
          _r = wasm.weaveffi_shapes_describe(a0_p, a0_l, _err);
        } catch (e) {
          throw _trap(wasm, _err, e);
        } finally {
          wasm.weaveffi_dealloc(a0_p, a0_l);
        }
        _checkErr(wasm, _err);
        _freeErr(wasm, _err);
        return _takeCStr(wasm, _r);
      },
      scale(shape, factor) {
        const a0_w = new _BufWriter();
        _write_shapes_Shape(a0_w, shape);
        const [a0_p, a0_l] = _bytes(wasm, a0_w.finish());
        const _lp = wasm.weaveffi_alloc(4);
        const _err = _allocErr(wasm);
        let _r;
        try {
          _r = wasm.weaveffi_shapes_scale(a0_p, a0_l, factor, _lp, _err);
        } catch (e) {
          wasm.weaveffi_dealloc(_lp, 4);
          throw _trap(wasm, _err, e);
        } finally {
          wasm.weaveffi_dealloc(a0_p, a0_l);
        }
        _checkErr(wasm, _err);
        _freeErr(wasm, _err);
        const _len = new DataView(wasm.memory.buffer).getUint32(_lp, true);
        wasm.weaveffi_dealloc(_lp, 4);
        const _rd = new _BufReader(_takeBytes(wasm, _r, _len));
        const _out = _read_shapes_Shape(_rd);
        _rd.end();
        return _out;
      },
      sumBytes(values) {
        const [a0_p, a0_l] = _bytes(wasm, values);
        const _err = _allocErr(wasm);
        let _r;
        try {
          _r = wasm.weaveffi_shapes_sum_bytes(a0_p, a0_l, _err);
        } catch (e) {
          throw _trap(wasm, _err, e);
        } finally {
          wasm.weaveffi_dealloc(a0_p, a0_l);
        }
        _checkErr(wasm, _err);
        _freeErr(wasm, _err);
        return BigInt.asUintN(64, _r);
      },
      makeNumerics(a, b, c, d, e, f, g, h, i, j) {
        const _lp = wasm.weaveffi_alloc(4);
        const _err = _allocErr(wasm);
        let _r;
        try {
          _r = wasm.weaveffi_shapes_make_numerics(a, b, c, BigInt(d), e, f, g, BigInt(h), i, j, _lp, _err);
        } catch (e) {
          wasm.weaveffi_dealloc(_lp, 4);
          throw _trap(wasm, _err, e);
        }
        _checkErr(wasm, _err);
        _freeErr(wasm, _err);
        const _len = new DataView(wasm.memory.buffer).getUint32(_lp, true);
        wasm.weaveffi_dealloc(_lp, 4);
        const _rd = new _BufReader(_takeBytes(wasm, _r, _len));
        const _out = _read_shapes_Numerics(_rd);
        _rd.end();
        return _out;
      },
    },
  };
}

// END weaveffi_wasm.js
