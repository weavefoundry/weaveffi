  # Subscribe to document-saved notifications
  # Registers a OnSaved listener block. Returns a subscription id for
  # unregister_saved_listener.
  def self.register_saved_listener(&block)
    trampoline = FFI::Function.new(:void, [:int64, :int32, :pointer]) do |doc_id, revision, _context|
      block.call(doc_id, revision)
    end
    listener_id = weaveffi_docs_register_saved_listener(trampoline, FFI::Pointer::NULL)
    @listener_refs[listener_id] = trampoline
    listener_id
