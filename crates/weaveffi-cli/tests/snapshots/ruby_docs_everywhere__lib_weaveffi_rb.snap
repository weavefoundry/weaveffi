    # Create an empty notebook
    def initialize()
      err = ErrorStruct.new
      result = WeaveFFI.weaveffi_docs_Notebook_new(err)
      WeaveFFI.check_error!(err)
      raise Error.new(-1, 'null pointer') if result.null?
