    weaveffi_docs_unregister_saved_listener(listener_id)
    @listener_refs.delete(listener_id)
    nil
  end

  # Create a brand new document.
  #
  # The document starts in `Draft` status; callers must publish
  # it explicitly to make it visible.
  # @param title [Object] Human-readable title for the new document
  # @param tags [Object] Initial set of tags (may be empty)
  def self.create_document(title, tags)
    err = ErrorStruct.new
    tags_w = WvBufferWriter.new
    tags_w.write_len(tags.length)
    tags.each do |_wv_e0|
      tags_w.write_string(_wv_e0)
    end
    tags_data = tags_w.data
    tags_buf = FFI::MemoryPointer.new(:uint8, tags_data.bytesize)
    tags_buf.put_bytes(0, tags_data)
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_docs_create_document(title, tags_buf, tags_data.bytesize, out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    _wv_value = _wv_read_document(_wv_r)
    _wv_r.expect_end!
    _wv_value
  end

  # Look up a document by identifier
  # @param id [Object] Identifier returned from create_document
  def self.get_document(id)
    err = ErrorStruct.new
    out_len = FFI::MemoryPointer.new(:size_t)
    result = weaveffi_docs_get_document(id, out_len, err)
    check_error!(err)
    len = out_len.read(:size_t)
    data = result.null? ? ''.b : result.read_string(len)
    weaveffi_free_bytes(result, len) unless result.null?
    _wv_r = WvBufferReader.new(data)
    if _wv_r.read_flag
      _wv_value = _wv_read_document(_wv_r)
    else
      _wv_value = nil
    end
    _wv_r.expect_end!
    _wv_value
  end

  # Publish a document in the background
  # Blocks the current thread until the async producer completes; the
  # result (or error) is delivered through the completion callback.
  def self.publish_async(id)
    queue = Queue.new
    callback = FFI::Function.new(:void, [:pointer, :pointer, :int32]) do |_context, err_ptr, result|
      err = err_ptr.null? ? nil : ErrorStruct.new(err_ptr)
      if err && err[:code] != 0
        code = err[:code]
        msg = err[:message].null? ? '' : err[:message].read_string
        weaveffi_error_free(err_ptr)
        queue << Error.new(code, msg)
      else
        queue << (result != 0)
      end
    end
    weaveffi_docs_publish_async_async(id, callback, FFI::Pointer::NULL)
    value = queue.pop
    raise value if value.is_a?(Error)
    value
