  # Maps each ABI code of the DocsErrorsError domain to its error class.
  DOCS_ERRORS_ERROR_CODES = {
    1 => DocsErrorsError::NotFound,
    2 => DocsErrorsError::InvalidStatus,
  }.freeze

  # Builds the DocsErrorsError subclass matching `code`, decoding any payload
  # fields the code declares, or a generic Error for codes outside
  # the domain (panics, marshalling).
  def self.docs_errors_error_from(code, message, payload = nil)
