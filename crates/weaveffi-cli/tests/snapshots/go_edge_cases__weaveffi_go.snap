	w.writeI32(v.In)
	w.writeI32(v.Is)
	w.writeI32(v.Int)
	w.writeI32(v.Var)
	w.writeI32(v.Val)
	w.writeI32(v.Self)
	w.writeI32(v.This)
	w.writeI32(v.Object)
	w.writeI32(v.String)
	w.writeI32(v.Case)
	w.writeI32(v.Select)
	w.writeI32(v.Switch)
	w.writeI32(v.Void)
	w.writeI32(v.Union)
	w.writeI32(v.Namespace)
	w.writeI32(v.Operator)
	w.writeI32(v.Template)
	w.writeI32(v.Package)
	w.writeI32(v.Protocol)
	w.writeI32(v.Guard)
	w.writeI32(v.Defer)
	w.writeI32(v.Inout)
	w.writeI32(v.Internal)
	w.writeI32(v.When)
	w.writeI32(v.Fun)
	w.writeI32(v.Data)
	w.writeI32(v.Late)
	w.writeI32(v.Part)
	w.writeI32(v.Out)
	w.writeI32(v.Ref)
	w.writeI32(v.Event)
	w.writeI32(v.Base)
	w.writeI32(v.Lambda)
	w.writeI32(v.Yield)
