  napi_value promise;
  napi_create_promise(env, &ctx->deferred, &promise);
  napi_value resource_name;
  napi_create_string_utf8(env, "weaveffi_edge_cases_async_widget", NAPI_AUTO_LENGTH, &resource_name);
  napi_create_threadsafe_function(env, NULL, NULL, resource_name, 0, 1, NULL, NULL, NULL, weaveffi_edge_cases_async_widget_napi_settle, &ctx->tsfn);
  weaveffi_edge_cases_async_widget_async(weaveffi_edge_cases_async_widget_napi_cb, ctx);
  return promise;
}

