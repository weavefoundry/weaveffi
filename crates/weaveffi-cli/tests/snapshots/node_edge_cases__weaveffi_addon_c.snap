} weaveffi_edge_cases_Keyword_import_frame;

static void weaveffi_edge_cases_Keyword_import_invoke(napi_env env, weaveffi_napi_cb_ctx* ctx, weaveffi_edge_cases_Keyword_import_frame* f) {
  napi_handle_scope scope;
  napi_open_handle_scope(env, &scope);
  napi_value target;
  napi_get_reference_value(env, ctx->ref, &target);
  napi_value fn;
  napi_get_named_property(env, target, "import", &fn);
  napi_value result;
  napi_valuetype fn_type;
  napi_typeof(env, fn, &fn_type);
  if (fn_type != napi_function) {
    weaveffi_napi_cb_report(env, f->hdr.out_err, "Keyword implementation has no import method");
  } else if (napi_call_function(env, target, fn, 0, NULL, &result) != napi_ok) {
    weaveffi_napi_cb_report(env, f->hdr.out_err, "Keyword.import threw");
  } else {
    napi_status rs;
    rs = napi_get_value_int32(env, result, &f->result);
    if (rs != napi_ok) {
      weaveffi_napi_cb_report(env, f->hdr.out_err, "Keyword.import returned a value of the wrong type");
    }
  }
  napi_close_handle_scope(env, scope);
}

static int32_t weaveffi_edge_cases_Keyword_import_tramp(void* ctx, weaveffi_error* out_err) {
  weaveffi_edge_cases_Keyword_import_frame f;
  memset(&f, 0, sizeof f);
  f.hdr.out_err = out_err;
  weaveffi_napi_cb_ctx* c = (weaveffi_napi_cb_ctx*)ctx;
  if (weaveffi_napi_on_js_thread()) {
    weaveffi_edge_cases_Keyword_import_invoke(c->env, c, &f);
  } else {
    weaveffi_napi_cb_req req;
    req.ctx = c;
    req.method = 1;
    req.frame = &f;
    weaveffi_napi_cb_hop(&req);
  }
  return f.result;
}

static void weaveffi_edge_cases_Keyword_napi_dispatch(napi_env env, napi_value js_cb, void* context, void* data) {
  (void)js_cb;
  (void)context;
  weaveffi_napi_cb_req* req = (weaveffi_napi_cb_req*)data;
  if (req->method < 0) {
    weaveffi_napi_cb_release(env, req->ctx);
    free(req);
    return;
  }
  if (env == NULL) {
    weaveffi_error_set(((weaveffi_napi_cb_frame_hdr*)req->frame)->out_err, -4, "Node environment is shutting down");
  } else {
    switch (req->method) {
      case 0: weaveffi_edge_cases_Keyword_delete_invoke(env, req->ctx, (weaveffi_edge_cases_Keyword_delete_frame*)req->frame); break;
      case 1: weaveffi_edge_cases_Keyword_import_invoke(env, req->ctx, (weaveffi_edge_cases_Keyword_import_frame*)req->frame); break;
      default: break;
    }
  }
  weaveffi_napi_cb_finish(req);
}

