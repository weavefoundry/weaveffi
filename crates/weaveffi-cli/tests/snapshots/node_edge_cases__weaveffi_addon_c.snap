typedef struct {
    napi_deferred deferred;
    napi_threadsafe_function tsfn;
    int32_t err_code;
    char* err_msg;
    uint8_t* err_payload;
    size_t err_payload_len;
    uint8_t* result;
    size_t result_len;
} weaveffi_edge_cases_Widget_fetch_napi_actx;

static void weaveffi_edge_cases_Widget_fetch_napi_cb(void* context, weaveffi_error* err, const uint8_t* result_ptr, size_t result_len) {
    weaveffi_edge_cases_Widget_fetch_napi_actx* ctx = (weaveffi_edge_cases_Widget_fetch_napi_actx*)context;
    if (err != NULL && err->code != 0) {
        ctx->err_code = err->code;
        ctx->err_msg = err->message ? strdup(err->message) : strdup("unknown error");
        ctx->err_payload_len = err->payload_len;
        if (err->payload_ptr != NULL && err->payload_len > 0) { ctx->err_payload = (uint8_t*)malloc(err->payload_len); memcpy(ctx->err_payload, err->payload_ptr, err->payload_len); }
    } else {
        ctx->result_len = result_len;
        if (result_ptr != NULL && result_len > 0) { ctx->result = (uint8_t*)malloc(result_len); memcpy(ctx->result, result_ptr, result_len); }
        weaveffi_free_bytes((uint8_t*)result_ptr, result_len);
    }
    weaveffi_error_free(err);
    napi_call_threadsafe_function(ctx->tsfn, ctx, napi_tsfn_blocking);
}

static void weaveffi_edge_cases_Widget_fetch_napi_settle(napi_env env, napi_value js_cb, void* context, void* data) {
    (void)js_cb;
    (void)context;
    weaveffi_edge_cases_Widget_fetch_napi_actx* ctx = (weaveffi_edge_cases_Widget_fetch_napi_actx*)data;
    if (env != NULL) {
    if (ctx->err_code != 0) {
        napi_value err_obj = weaveffi_napi_error_value(env, ctx->err_code, ctx->err_msg, ctx->err_payload, ctx->err_payload_len);
        napi_reject_deferred(env, ctx->deferred, err_obj);
    } else {
        napi_value val;
        napi_create_buffer_copy(env, ctx->result_len, ctx->result ? (const void*)ctx->result : (const void*)"", NULL, &val);
        napi_resolve_deferred(env, ctx->deferred, val);
    }
    }
    free(ctx->err_msg);
    free(ctx->err_payload);
    free(ctx->result);
    napi_release_threadsafe_function(ctx->tsfn, napi_tsfn_release);
    free(ctx);
}

