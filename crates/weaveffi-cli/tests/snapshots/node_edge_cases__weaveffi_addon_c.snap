  napi_get_reference_value(env, ctx->ref, &target);
  napi_value fn;
  napi_get_named_property(env, target, "delete", &fn);
  napi_value argv[1];
  napi_create_int32(env, f->self, &argv[0]);
  napi_value result;
  napi_valuetype fn_type;
  napi_typeof(env, fn, &fn_type);
  if (fn_type != napi_function) {
    weaveffi_napi_cb_report(env, f->hdr.out_err, "Keyword implementation has no delete method");
  } else if (napi_call_function(env, target, fn, 1, argv, &result) != napi_ok) {
    weaveffi_napi_cb_report(env, f->hdr.out_err, "Keyword.delete threw");
  }
  napi_close_handle_scope(env, scope);
}

static void weaveffi_edge_cases_Keyword_delete_tramp(void* ctx, int32_t self, weaveffi_error* out_err) {
  weaveffi_edge_cases_Keyword_delete_frame f;
