namespace weaveffi {

/** Base exception for every error reported through the C ABI. */
class WeaveFFIError : public std::runtime_error {
    int32_t code_;

public:
    WeaveFFIError(int32_t code, const std::string& msg) : std::runtime_error(msg), code_(code) {}
    int32_t code() const { return code_; }
};

namespace detail {

/** Throw the generic WeaveFFIError if `err` carries a nonzero code. */
inline void check(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    int32_t code = err.code;
    weaveffi_error_clear(&err);
    throw WeaveFFIError(code, msg);
}

/** Wrap an async-callback error as the generic WeaveFFIError. */
inline std::exception_ptr make_error(int32_t code, const std::string& msg) {
    return std::make_exception_ptr(WeaveFFIError(code, msg));
}

} // namespace detail

namespace detail {

/**
 * Serializes values into the WeaveFFI value-buffer wire format: little-endian,
 * packed with no alignment, lengths and element counts as u32.
 */
class BufferWriter {
    std::vector<uint8_t> buf_;

    template <typename T>
    void append_le(T v) {
        for (size_t i = 0; i < sizeof(T); ++i) {
            buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
        }
    }

public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const { return buf_.size(); }

    void write_bool(bool v) { buf_.push_back(v ? 1 : 0); }
    void write_i8(int8_t v) { buf_.push_back(static_cast<uint8_t>(v)); }
    void write_u8(uint8_t v) { buf_.push_back(v); }
    void write_i16(int16_t v) { append_le(static_cast<uint16_t>(v)); }
    void write_u16(uint16_t v) { append_le(v); }
    void write_i32(int32_t v) { append_le(static_cast<uint32_t>(v)); }
    void write_u32(uint32_t v) { append_le(v); }
    void write_i64(int64_t v) { append_le(static_cast<uint64_t>(v)); }
    void write_u64(uint64_t v) { append_le(v); }

    void write_f32(float v) {
        uint32_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    void write_f64(double v) {
        uint64_t bits = 0;
        std::memcpy(&bits, &v, sizeof(bits));
        append_le(bits);
    }

    /** Writes a string, byte-buffer, or collection length as a u32. */
    void write_len(size_t n) { append_le(static_cast<uint32_t>(n)); }

    void write_string(const std::string& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    void write_bytes(const std::vector<uint8_t>& v) {
        write_len(v.size());
        buf_.insert(buf_.end(), v.begin(), v.end());
    }

    /** Writes an optional's presence flag: 0 absent, 1 present. */
    void write_option_flag(bool present) { buf_.push_back(present ? 1 : 0); }
};

/**
 * Decodes values from the WeaveFFI value-buffer wire format. A malformed
 * buffer is a producer/consumer contract violation (both sides are generated
 * from one IDL), so every decode failure throws the generic WeaveFFIError,
 * the same channel as a producer panic.
 */
class BufferReader {
    const uint8_t* data_;
    size_t len_;
    size_t pos_;

    [[noreturn]] static void fail(const char* what) {
        throw WeaveFFIError(-2, std::string("malformed WeaveFFI value buffer: ") + what);
    }

    void require(size_t n, const char* what) const {
        if (len_ - pos_ < n) fail(what);
    }

    template <typename T>
    T read_le(const char* what) {
        require(sizeof(T), what);
        uint64_t v = 0;
        for (size_t i = 0; i < sizeof(T); ++i) {
            v |= static_cast<uint64_t>(data_[pos_ + i]) << (8 * i);
        }
        pos_ += sizeof(T);
        return static_cast<T>(v);
    }

public:
    BufferReader(const uint8_t* data, size_t len) : data_(data), len_(len), pos_(0) {}

    /** Bytes not yet consumed. */
    size_t remaining() const { return len_ - pos_; }

    bool read_bool() {
        uint8_t b = read_le<uint8_t>("bool");
        if (b > 1) fail("bool byte out of range");
        return b != 0;
    }

    int8_t read_i8() { return read_le<int8_t>("i8"); }
    uint8_t read_u8() { return read_le<uint8_t>("u8"); }
    int16_t read_i16() { return read_le<int16_t>("i16"); }
    uint16_t read_u16() { return read_le<uint16_t>("u16"); }
    int32_t read_i32() { return read_le<int32_t>("i32"); }
    uint32_t read_u32() { return read_le<uint32_t>("u32"); }
    int64_t read_i64() { return read_le<int64_t>("i64"); }
    uint64_t read_u64() { return read_le<uint64_t>("u64"); }

    float read_f32() {
        uint32_t bits = read_le<uint32_t>("f32");
        float v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    double read_f64() {
        uint64_t bits = read_le<uint64_t>("f64");
        double v = 0;
        std::memcpy(&v, &bits, sizeof(v));
        return v;
    }

    /** Reads a length prefix, rejecting one larger than the bytes remaining. */
    size_t read_len() {
        uint32_t n = read_le<uint32_t>("length");
        if (static_cast<size_t>(n) > remaining()) fail("length prefix exceeds remaining buffer");
        return static_cast<size_t>(n);
    }

    std::string read_string() {
        size_t n = read_len();
        std::string v(reinterpret_cast<const char*>(data_) + pos_, n);
        pos_ += n;
        return v;
    }

    std::vector<uint8_t> read_bytes() {
        size_t n = read_len();
        std::vector<uint8_t> v(data_ + pos_, data_ + pos_ + n);
        pos_ += n;
        return v;
    }

    bool read_option_flag() {
        uint8_t b = read_le<uint8_t>("option flag");
        if (b > 1) fail("option flag byte out of range");
        return b != 0;
    }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }
};

/** Releases a producer-allocated buffer with weaveffi_free_bytes on scope exit. */
struct BufferGuard {
    /** The producer-allocated buffer, or null when the call reported an error. */
    const uint8_t* ptr;
    /** The buffer length in bytes. */
    size_t len;

    ~BufferGuard() {
        if (ptr != nullptr) weaveffi_free_bytes(const_cast<uint8_t*>(ptr), len);
    }
};

} // namespace detail

enum class ContactType : int32_t {
    Personal = 0,
    Work = 1,
    Other = 2
};

struct Contact {
    int64_t id;
    std::string first_name;
    std::string last_name;
    std::optional<std::string> email;
    ContactType contact_type;
};

namespace detail {

/** Encodes a `Contact` in the WeaveFFI value-buffer format. */
inline void write_Contact(BufferWriter& w, const Contact& v) {
    w.write_i64(v.id);
    w.write_string(v.first_name);
    w.write_string(v.last_name);
    w.write_option_flag(v.email.has_value());
    if (v.email.has_value()) {
        w.write_string((*v.email));
    }
    w.write_i32(static_cast<int32_t>(v.contact_type));
}

/** Decodes a `Contact` from the WeaveFFI value-buffer format. */
inline Contact read_Contact(BufferReader& r) {
    Contact out{};
    out.id = r.read_i64();
    out.first_name = r.read_string();
    out.last_name = r.read_string();
    if (r.read_option_flag()) {
        std::string v_email_v = r.read_string();
        out.email = std::move(v_email_v);
    }
    out.contact_type = static_cast<ContactType>(r.read_i32());
    return out;
}

} // namespace detail

/** Typed errors reported by the `contacts` module's throwing functions. */
class ContactsError : public WeaveFFIError {
public:
    ContactsError(int32_t code, const std::string& msg) : WeaveFFIError(code, msg) {}
};

/** name must not be empty */
class InvalidNameError : public ContactsError {
public:
    InvalidNameError(const std::string& msg) : ContactsError(1, msg) {}
};

/** contact not found */
class NotFoundError : public ContactsError {
public:
    NotFoundError(const std::string& msg) : ContactsError(2, msg) {}
};

namespace detail {

/** Map a `contacts` error code and payload to its typed exception (ContactsError for unknown codes). */
inline std::exception_ptr make_contacts_error(int32_t code, const std::string& msg, const uint8_t* payload_ptr, size_t payload_len) {
    switch (code) {
    case 1: return std::make_exception_ptr(InvalidNameError(msg));
    case 2: return std::make_exception_ptr(NotFoundError(msg));
    default: return std::make_exception_ptr(ContactsError(code, msg));
    }
}

/** Throw the typed `contacts` exception if `err` carries a nonzero code. */
inline void check_contacts(weaveffi_error& err) {
    if (err.code == 0) return;
    std::string msg(err.message ? err.message : "unknown error");
    std::exception_ptr ex = make_contacts_error(err.code, msg, err.payload_ptr, err.payload_len);
    weaveffi_error_clear(&err);
    std::rethrow_exception(ex);
}

} // namespace detail

/** An in-memory address book owning its contacts */
class ContactBook {
    void* handle_;

public:
    explicit ContactBook(void* h) : handle_(h) {}

    ~ContactBook() {
        if (handle_) weaveffi_contacts_ContactBook_destroy(static_cast<weaveffi_contacts_ContactBook*>(handle_));
    }

    ContactBook(const ContactBook&) = delete;
    ContactBook& operator=(const ContactBook&) = delete;

    ContactBook(ContactBook&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    ContactBook& operator=(ContactBook&& other) noexcept {
        if (this != &other) {
            if (handle_) weaveffi_contacts_ContactBook_destroy(static_cast<weaveffi_contacts_ContactBook*>(handle_));
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    void* handle() const { return handle_; }

    ContactBook() : handle_(nullptr) {
        weaveffi_error err{};
        auto result = weaveffi_contacts_ContactBook_new(&err);
        detail::check(err);
        handle_ = result;
    }

    Contact add(const std::string& first_name, const std::string& last_name, const std::optional<std::string>& email, ContactType contact_type) const {
        detail::BufferWriter email_buf;
        email_buf.write_option_flag(email.has_value());
        if (email.has_value()) {
            email_buf.write_string((*email));
        }
        size_t out_len = 0;
        weaveffi_error err{};
        auto result = weaveffi_contacts_ContactBook_add(static_cast<const weaveffi_contacts_ContactBook*>(handle_), first_name.c_str(), last_name.c_str(), email_buf.data(), email_buf.size(), static_cast<weaveffi_contacts_ContactType>(static_cast<int32_t>(contact_type)), &out_len, &err);
        detail::check_contacts(err);
        detail::BufferGuard result_guard{result, out_len};
        detail::BufferReader result_r(result, out_len);
        Contact ret = detail::read_Contact(result_r);
        result_r.expect_end();
        return ret;
    }

    Contact get(int64_t id) const {
        size_t out_len = 0;
        weaveffi_error err{};
        auto result = weaveffi_contacts_ContactBook_get(static_cast<const weaveffi_contacts_ContactBook*>(handle_), id, &out_len, &err);
        detail::check_contacts(err);
        detail::BufferGuard result_guard{result, out_len};
        detail::BufferReader result_r(result, out_len);
        Contact ret = detail::read_Contact(result_r);
        result_r.expect_end();
        return ret;
    }

    std::vector<Contact> list() const {
        size_t out_len = 0;
        weaveffi_error err{};
        auto result = weaveffi_contacts_ContactBook_list(static_cast<const weaveffi_contacts_ContactBook*>(handle_), &out_len, &err);
        detail::check(err);
        detail::BufferGuard result_guard{result, out_len};
        detail::BufferReader result_r(result, out_len);
        std::vector<Contact> ret{};
        {
            size_t ret_n = result_r.read_len();
            ret.reserve(ret_n);
            for (size_t ret_i = 0; ret_i < ret_n; ++ret_i) {
                Contact ret_item = detail::read_Contact(result_r);
                ret.push_back(std::move(ret_item));
            }
        }
        result_r.expect_end();
        return ret;
    }

    bool remove(int64_t id) const {
        weaveffi_error err{};
        auto result = weaveffi_contacts_ContactBook_remove(static_cast<const weaveffi_contacts_ContactBook*>(handle_), id, &err);
        detail::check(err);
        return result;
    }

    int32_t count() const {
        weaveffi_error err{};
        auto result = weaveffi_contacts_ContactBook_count(static_cast<const weaveffi_contacts_ContactBook*>(handle_), &err);
        detail::check(err);
        return result;
    }

};

} // namespace weaveffi

