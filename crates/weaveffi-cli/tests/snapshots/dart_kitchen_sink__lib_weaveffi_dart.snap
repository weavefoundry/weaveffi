final _weaveffiKitchenGadgetDestroy = _lib.lookupFunction<
    _NativeWeaveffiKitchenGadgetDestroy, _DartWeaveffiKitchenGadgetDestroy>('weaveffi_kitchen_Gadget_destroy');
final _weaveffiKitchenGadgetDestroyFinalizer = NativeFinalizer(
    _lib.lookup<NativeFunction<Void Function(Pointer<Void>)>>('weaveffi_kitchen_Gadget_destroy'));

typedef _NativeWeaveffiKitchenGadgetNew = Pointer<Void> Function(Int64, Pointer<_WeaveFFIError>);
typedef _DartWeaveffiKitchenGadgetNew = Pointer<Void> Function(int, Pointer<_WeaveFFIError>);
final _weaveffiKitchenGadgetNew = _lib.lookupFunction<
    _NativeWeaveffiKitchenGadgetNew, _DartWeaveffiKitchenGadgetNew>('weaveffi_kitchen_Gadget_new');

typedef _NativeWeaveffiKitchenGadgetDescribe = Pointer<Utf8> Function(Pointer<Void>, Pointer<_WeaveFFIError>);
typedef _DartWeaveffiKitchenGadgetDescribe = Pointer<Utf8> Function(Pointer<Void>, Pointer<_WeaveFFIError>);
final _weaveffiKitchenGadgetDescribe = _lib.lookupFunction<
    _NativeWeaveffiKitchenGadgetDescribe, _DartWeaveffiKitchenGadgetDescribe>('weaveffi_kitchen_Gadget_describe');

typedef _NativeWeaveffiKitchenGadgetPoke = Int32 Function(Pointer<Void>, Int32, Pointer<_WeaveFFIError>);
typedef _DartWeaveffiKitchenGadgetPoke = int Function(Pointer<Void>, int, Pointer<_WeaveFFIError>);
final _weaveffiKitchenGadgetPoke = _lib.lookupFunction<
    _NativeWeaveffiKitchenGadgetPoke, _DartWeaveffiKitchenGadgetPoke>('weaveffi_kitchen_Gadget_poke');

typedef _NativeWeaveffiKitchenGadgetVersion = Pointer<Utf8> Function(Pointer<_WeaveFFIError>);
typedef _DartWeaveffiKitchenGadgetVersion = Pointer<Utf8> Function(Pointer<_WeaveFFIError>);
final _weaveffiKitchenGadgetVersion = _lib.lookupFunction<
    _NativeWeaveffiKitchenGadgetVersion, _DartWeaveffiKitchenGadgetVersion>('weaveffi_kitchen_Gadget_version');

/// A pocket-sized interface exercising the object surface
///
