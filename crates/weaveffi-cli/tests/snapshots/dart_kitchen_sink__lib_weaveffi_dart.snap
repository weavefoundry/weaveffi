// Generated by WeaveFFI [VERSION] from weaveffi.yml
// DO NOT EDIT. Your changes will be overwritten.
// To regenerate: weaveffi generate weaveffi.yml -o <out>

// ignore_for_file: non_constant_identifier_names, camel_case_types, unused_element

import 'dart:async';
import 'dart:convert';
import 'dart:ffi';
import 'dart:io' show Platform;
import 'dart:typed_data';

import 'package:ffi/ffi.dart';

DynamicLibrary _openLibrary() {
  // An explicit path in WEAVEFFI_LIBRARY wins, so callers can point at a
  // specific build artifact regardless of its file name or location.
  final override = Platform.environment['WEAVEFFI_LIBRARY'];
  if (override != null && override.isNotEmpty) return DynamicLibrary.open(override);
  if (Platform.isMacOS) return DynamicLibrary.open('libweaveffi.dylib');
  if (Platform.isLinux) return DynamicLibrary.open('libweaveffi.so');
  if (Platform.isWindows) return DynamicLibrary.open('weaveffi.dll');
  throw UnsupportedError('Unsupported platform: ${Platform.operatingSystem}');
}

// The ABI revision these bindings were generated against.
const int _abiVersion = 2;

DynamicLibrary _checkAbiVersion(DynamicLibrary lib) {
  final int Function() abiVersion;
  try {
    abiVersion = lib.lookupFunction<Uint32 Function(), int Function()>('weaveffi_abi_version');
  } on ArgumentError {
    throw StateError(
      'the loaded WeaveFFI library predates ABI versioning '
      '(these bindings expect ABI revision $_abiVersion)',
    );
  }
  final found = abiVersion();
  if (found != _abiVersion) {
    throw StateError(
      'WeaveFFI ABI mismatch: these bindings expect revision $_abiVersion '
      'but the loaded library reports revision $found',
    );
  }
  return lib;
}

final DynamicLibrary _lib = _checkAbiVersion(_openLibrary());

final class _WeaveFFIError extends Struct {
  @Int32()
  external int code;
  external Pointer<Utf8> message;
  external Pointer<Uint8> payloadPtr;
  @Size()
  external int payloadLen;
}

typedef _NativeWeaveffiErrorSet = Void Function(Pointer<_WeaveFFIError>, Int32, Pointer<Utf8>);
typedef _DartWeaveffiErrorSet = void Function(Pointer<_WeaveFFIError>, int, Pointer<Utf8>);
final _weaveffiErrorSet = _lib.lookupFunction<
    _NativeWeaveffiErrorSet, _DartWeaveffiErrorSet>('weaveffi_error_set');

typedef _NativeWeaveffiErrorClear = Void Function(Pointer<_WeaveFFIError>);
typedef _DartWeaveffiErrorClear = void Function(Pointer<_WeaveFFIError>);
final _weaveffiErrorClear = _lib.lookupFunction<
    _NativeWeaveffiErrorClear, _DartWeaveffiErrorClear>('weaveffi_error_clear');

typedef _NativeWeaveffiErrorFree = Void Function(Pointer<_WeaveFFIError>);
typedef _DartWeaveffiErrorFree = void Function(Pointer<_WeaveFFIError>);
final _weaveffiErrorFree = _lib.lookupFunction<
    _NativeWeaveffiErrorFree, _DartWeaveffiErrorFree>('weaveffi_error_free');

typedef _NativeWeaveffiFreeString = Void Function(Pointer<Utf8>);
typedef _DartWeaveffiFreeString = void Function(Pointer<Utf8>);
final _weaveffiFreeString = _lib.lookupFunction<
    _NativeWeaveffiFreeString, _DartWeaveffiFreeString>('weaveffi_free_string');

typedef _NativeWeaveffiFreeBytes = Void Function(Pointer<Uint8>, Size);
typedef _DartWeaveffiFreeBytes = void Function(Pointer<Uint8>, int);
final _weaveffiFreeBytes = _lib.lookupFunction<
    _NativeWeaveffiFreeBytes, _DartWeaveffiFreeBytes>('weaveffi_free_bytes');

/// Generic WeaveFFI failure: a producer panic ([panicCode]), a marshalling
/// error ([marshalCode]), a callback-interface implementation that threw
/// ([foreignCode], carrying the Dart exception's text), or an unknown code.
class WeaveFFIException implements Exception {
  /// The producer reported an untyped error.
  static const int genericCode = -1;
  /// The producer panicked; [message] carries the panic text.
  static const int panicCode = -2;
  /// An argument could not be lifted by the producer.
  static const int marshalCode = -3;
  /// A Dart callback-interface implementation threw; [message] carries the
  /// exception's text.
  static const int foreignCode = -4;
  final int code;
  final String message;
  WeaveFFIException(this.code, this.message);
  @override
  String toString() => '$runtimeType($code): $message';
}

void _checkError(Pointer<_WeaveFFIError> err) {
  if (err.ref.code != 0) {
    final code = err.ref.code;
    final msg = err.ref.message.toDartString();
    _weaveffiErrorClear(err);
    throw WeaveFFIException(code, msg);
  }
}

// ── WeaveFFI value-buffer runtime ──
// Records, rich enums, optionals, lists, maps, and error payloads cross the
// C ABI serialized in this little-endian, packed format. A malformed buffer
// is a producer/consumer contract violation, never a typed domain error.

Never _bufferError(String context) =>
    throw StateError('malformed WeaveFFI value buffer: $context');

// Copies a borrowed native (ptr, len) buffer into Dart-owned memory.
Uint8List _copyNativeBytes(Pointer<Uint8> ptr, int len) =>
    ptr == nullptr ? Uint8List(0) : Uint8List.fromList(ptr.asTypedList(len));

// Stages an encoding into native memory for a borrowed (ptr, len) argument;
// the caller frees the pointer after the call returns.
Pointer<Uint8> _stageBytes(Uint8List bytes) {
  final ptr = calloc<Uint8>(bytes.isEmpty ? 1 : bytes.length);
  if (bytes.isNotEmpty) ptr.asTypedList(bytes.length).setAll(0, bytes);
  return ptr;
}

final class _BufferWriter {
  Uint8List _buf = Uint8List(64);
  ByteData? _view;
  int _len = 0;

  ByteData get _data => _view ??= ByteData.sublistView(_buf);

  void _ensure(int extra) {
    if (_len + extra <= _buf.length) return;
    var cap = _buf.length * 2;
    while (cap < _len + extra) {
      cap *= 2;
    }
    final next = Uint8List(cap);
    next.setRange(0, _len, _buf);
    _buf = next;
    _view = null;
  }

  Uint8List takeBytes() => Uint8List.sublistView(_buf, 0, _len);

  void writeBool(bool v) => writeUint8(v ? 1 : 0);

  void writeOptionFlag(bool present) => writeUint8(present ? 1 : 0);

  void writeInt8(int v) {
    _ensure(1);
    _data.setInt8(_len, v);
    _len += 1;
  }

  void writeUint8(int v) {
    _ensure(1);
    _data.setUint8(_len, v);
    _len += 1;
  }

  void writeInt16(int v) {
    _ensure(2);
    _data.setInt16(_len, v, Endian.little);
    _len += 2;
  }

  void writeUint16(int v) {
    _ensure(2);
    _data.setUint16(_len, v, Endian.little);
    _len += 2;
  }

  void writeInt32(int v) {
    _ensure(4);
    _data.setInt32(_len, v, Endian.little);
    _len += 4;
  }

  void writeUint32(int v) {
    _ensure(4);
    _data.setUint32(_len, v, Endian.little);
    _len += 4;
  }

  void writeInt64(int v) {
    _ensure(8);
    _data.setInt64(_len, v, Endian.little);
    _len += 8;
  }

  void writeUint64(int v) {
    _ensure(8);
    _data.setUint64(_len, v, Endian.little);
    _len += 8;
  }

  void writeFloat32(double v) {
    _ensure(4);
    _data.setFloat32(_len, v, Endian.little);
    _len += 4;
  }

  void writeFloat64(double v) {
    _ensure(8);
    _data.setFloat64(_len, v, Endian.little);
    _len += 8;
  }

  void writeLength(int v) => writeUint32(v);

  void writeString(String v) {
    final bytes = utf8.encode(v);
    writeLength(bytes.length);
    _ensure(bytes.length);
    _buf.setRange(_len, _len + bytes.length, bytes);
    _len += bytes.length;
  }

  void writeBytes(List<int> v) {
    writeLength(v.length);
    _ensure(v.length);
    _buf.setRange(_len, _len + v.length, v);
    _len += v.length;
  }
}

final class _BufferReader {
  final Uint8List _buf;
  final ByteData _data;
  int _pos = 0;

  _BufferReader(Uint8List buf)
      : _buf = buf,
        _data = ByteData.sublistView(buf);

  int get _remaining => _buf.length - _pos;

  void _require(int n, String context) {
    if (_remaining < n) _bufferError(context);
  }

  bool readBool() {
    _require(1, 'bool');
    final b = _buf[_pos++];
    if (b > 1) _bufferError('bool byte out of range');
    return b == 1;
  }

  bool readOptionFlag() {
    _require(1, 'option flag');
    final b = _buf[_pos++];
    if (b > 1) _bufferError('option flag byte out of range');
    return b == 1;
  }

  int readInt8() {
    _require(1, 'i8');
    return _data.getInt8(_pos++);
  }

  int readUint8() {
    _require(1, 'u8');
    return _buf[_pos++];
  }

  int readInt16() {
    _require(2, 'i16');
    final v = _data.getInt16(_pos, Endian.little);
    _pos += 2;
    return v;
  }

  int readUint16() {
    _require(2, 'u16');
    final v = _data.getUint16(_pos, Endian.little);
    _pos += 2;
    return v;
  }

  int readInt32() {
    _require(4, 'i32');
    final v = _data.getInt32(_pos, Endian.little);
    _pos += 4;
    return v;
  }

  int readUint32() {
    _require(4, 'u32');
    final v = _data.getUint32(_pos, Endian.little);
    _pos += 4;
    return v;
  }

  int readInt64() {
    _require(8, 'i64');
    final v = _data.getInt64(_pos, Endian.little);
    _pos += 8;
    return v;
  }

  int readUint64() {
    _require(8, 'u64');
    final v = _data.getUint64(_pos, Endian.little);
    _pos += 8;
    return v;
  }

  double readFloat32() {
    _require(4, 'f32');
    final v = _data.getFloat32(_pos, Endian.little);
    _pos += 4;
    return v;
  }

  double readFloat64() {
    _require(8, 'f64');
    final v = _data.getFloat64(_pos, Endian.little);
    _pos += 8;
    return v;
  }

  int readLength() {
    final n = readUint32();
    if (n > _remaining) _bufferError('length prefix exceeds remaining buffer');
    return n;
  }

  String readString() {
    final n = readLength();
    final s = utf8.decode(Uint8List.sublistView(_buf, _pos, _pos + n));
    _pos += n;
    return s;
  }

  Uint8List readBytes() {
    final n = readLength();
    final b = Uint8List.fromList(Uint8List.sublistView(_buf, _pos, _pos + n));
    _pos += n;
    return b;
  }

  void expectEnd() {
    if (_remaining != 0) _bufferError('trailing bytes after value');
  }
}

// ── WeaveFFI callback-interface runtime ──
// A Dart implementation passed to the producer is stored here under an
// integer key; the key (widened to a pointer) is what crosses as `ctx`, so the
// producer never holds a Dart object and the GC never sees a raw pointer. The
// entry lives until the producer calls the vtable's `free(ctx)`.
final Map<int, Object> _callbackTable = {};
int _nextCallbackKey = 1;

Pointer<Void> _registerCallback(Object impl) {
  final key = _nextCallbackKey++;
  _callbackTable[key] = impl;
  return Pointer<Void>.fromAddress(key);
}

Object _callbackFor(Pointer<Void> ctx) {
  final impl = _callbackTable[ctx.address];
  if (impl == null) {
    throw StateError('callback interface context ${ctx.address} is not registered');
  }
  return impl;
}

// Vtable trampolines are process-wide: their NativeCallables are never closed,
// so they are anchored here to keep the native thunks alive. `keepIsolateAlive`
// is cleared on each so an idle isolate can still exit.
final List<NativeCallable<Function>> _callbackCallables = [];

Pointer<NativeFunction<T>> _pinCallable<T extends Function>(
    NativeCallable<T> callable) {
  callable.keepIsolateAlive = false;
  _callbackCallables.add(callable);
  return callable.nativeFunction;
}

// Reports a Dart exception thrown by a callback-interface implementation
// through `weaveffi_error_set` with the reserved foreign error code (-4).
// The producer copies the message, so the temporary is freed right away. This
// must never throw: it runs in the catch path of a trampoline whose C frame
// an exception must not unwind through.
void _foreignError(Pointer<_WeaveFFIError> outErr, Object error) {
  if (outErr == nullptr) return;
  Pointer<Utf8> message = nullptr;
  try {
    message = error.toString().toNativeUtf8();
    _weaveffiErrorSet(outErr, WeaveFFIException.foreignCode, message);
  } catch (_) {
    _weaveffiErrorSet(outErr, WeaveFFIException.foreignCode, nullptr);
  } finally {
    if (message != nullptr) calloc.free(message);
  }
}

// Anchors one live native iteration for its GC-finalizer backstop.
// A suspended `sync*` frame keeps the anchor reachable; abandoning the
// iteration drops the frame, and the finalizer destroys the native
// iterator handle. Exhausted iterations detach before destroying
// eagerly, so the handle is destroyed exactly once either way.
final class _IteratorLifetime implements Finalizable {}

/// A reusable token referenced across modules
class Token {
  final int id;
  final String label;

  Token({required this.id, required this.label});
}

void _packToken(_BufferWriter w, Token v) {
  w.writeInt64(v.id);
  w.writeString(v.label);
}

Token _unpackToken(_BufferReader r) {
  return Token(
    id: r.readInt64(),
    label: r.readString(),
  );
}

typedef _NativeWeaveffiSharedPing = Pointer<Utf8> Function(Pointer<_WeaveFFIError>);
typedef _DartWeaveffiSharedPing = Pointer<Utf8> Function(Pointer<_WeaveFFIError>);
final _weaveffiSharedPing = _lib.lookupFunction<
    _NativeWeaveffiSharedPing, _DartWeaveffiSharedPing>('weaveffi_shared_ping');

/// Trivial cross-module helper
String ping() {
  final err = calloc<_WeaveFFIError>();
  try {
    final result = _weaveffiSharedPing(err);
    _checkError(err);
    final decoded = result.toDartString();
    _weaveffiFreeString(result);
    return decoded;
  } finally {
    calloc.free(err);
  }
}

/// Typed error domain `KitchenErrors` declared by module `kitchen`.
class KitchenErrorsException extends WeaveFFIException {
  KitchenErrorsException(super.code, super.message);
}

/// Item not found
class NotFoundException extends KitchenErrorsException {
  NotFoundException([String message = 'Item not found']) : super(1, message);
}

/// Invalid input
class InvalidInputException extends KitchenErrorsException {
  InvalidInputException([String message = 'Invalid input']) : super(2, message);
}

WeaveFFIException _mapKitchenErrorsException(int code, String message, Uint8List payload) {
  switch (code) {
    case 1:
      return NotFoundException(message);
    case 2:
      return InvalidInputException(message);
    default:
      return WeaveFFIException(code, message);
  }
}

void _checkKitchenErrorsException(Pointer<_WeaveFFIError> err) {
  if (err.ref.code != 0) {
    final code = err.ref.code;
    final msg = err.ref.message.toDartString();
    final payload = _copyNativeBytes(err.ref.payloadPtr, err.ref.payloadLen);
    _weaveffiErrorClear(err);
    throw _mapKitchenErrorsException(code, msg, payload);
  }
}

/// Task priority levels
enum Priority {
  /// Low priority
  low(0),
  /// Normal priority
  normal(1),
  /// High priority
  high(2),
  ;
  const Priority(this.value);
  final int value;

  static Priority fromValue(int value) =>
      Priority.values.firstWhere((e) => e.value == value);
}

/// Kitchen sink struct exercising every field feature
class Item {
  /// Stable identifier
  final int id;
  /// Display name
  final String name;
  /// Initial count
  final int count;
  /// Whether the item is enabled
  final bool enabled;
  /// Scaling ratio
  final double ratio;
  final int nick;
  final List<int> payload;
  final List<String> tags;
  final Map<String, String> attrs;
  final int? parent;
  /// Cross-module struct reference
  final Token token;
  final Priority priority;
  /// An optional object inside a record
  final Gadget? gadget;

  Item({required this.id, required this.name, required this.count, required this.enabled, required this.ratio, required this.nick, required this.payload, required this.tags, required this.attrs, this.parent, required this.token, required this.priority, this.gadget});
}

void _packItem(_BufferWriter w, Item v) {
  w.writeInt64(v.id);
  w.writeString(v.name);
  w.writeInt32(v.count);
  w.writeBool(v.enabled);
  w.writeFloat64(v.ratio);
  w.writeUint32(v.nick);
  w.writeBytes(v.payload);
  final t0 = v.tags;
  w.writeLength(t0.length);
  for (final t1 in t0) {
    w.writeString(t1);
  }
  final t2 = v.attrs;
  w.writeLength(t2.length);
  for (final t3 in t2.entries) {
    w.writeString(t3.key);
    w.writeString(t3.value);
  }
  final t4 = v.parent;
  if (t4 == null) {
    w.writeOptionFlag(false);
  } else {
    w.writeOptionFlag(true);
    w.writeInt64(t4);
  }
  _packToken(w, v.token);
  w.writeInt32(v.priority.value);
  final t5 = v.gadget;
  if (t5 == null) {
    w.writeOptionFlag(false);
  } else {
    w.writeOptionFlag(true);
    w.writeUint64(t5._cloneRef().address);
  }
}

Item _unpackItem(_BufferReader r) {
  return Item(
    id: r.readInt64(),
    name: r.readString(),
    count: r.readInt32(),
    enabled: r.readBool(),
    ratio: r.readFloat64(),
    nick: r.readUint32(),
    payload: r.readBytes(),
    tags: List<String>.generate(r.readLength(), (_) => r.readString()),
    attrs: <String, String>{ for (var i = r.readLength(); i > 0; i--) r.readString(): r.readString() },
    parent: (r.readOptionFlag() ? r.readInt64() : null),
    token: _unpackToken(r),
    priority: Priority.fromValue(r.readInt32()),
    gadget: (r.readOptionFlag() ? Gadget._(Pointer<Void>.fromAddress(r.readUint64())) : null),
  );
}

/// Consumer-implemented observer of ready items
///
/// A callback interface: implement this class and pass an instance to any
/// function taking a [ReadyListener]. The producer keeps the instance alive
/// (through a private handle table) until it releases the callback, so no
/// other reference needs to be held.
///
/// Object arguments are owned by the implementation: call `dispose()` on
/// them (or let the finalizer run) when done. A thrown exception is reported
/// to the producer, which aborts the call it was making; the original Dart
/// caller then observes a [WeaveFFIException] with [WeaveFFIException.foreignCode]
/// carrying the exception's text.
///
/// Dart limitation: methods are bound with `NativeCallable.isolateLocal`, so
/// the producer may only invoke them on the thread of the isolate that
/// passed the callback. That holds when the producer calls them
/// synchronously during a call from Dart. A producer that invokes a method
/// from another thread (an async task, a background worker) is unsupported:
/// a `NativeCallable.listener` cannot return a value or read borrowed
/// arguments after the native frame returns.
abstract class ReadyListener {
  /// Fires when an item is ready
  void onReady(int code, String msg);
  /// Receives the item itself and says whether to keep listening
  bool onItem(Item item, Gadget gadget);
}

typedef _NativeReadyListenerVtOnReady = Void Function(Pointer<Void>, Int32, Pointer<Utf8>, Pointer<_WeaveFFIError>);
typedef _NativeReadyListenerVtOnItem = Bool Function(Pointer<Void>, Pointer<Uint8>, Size, Pointer<Void>, Pointer<_WeaveFFIError>);
typedef _NativeReadyListenerVtFree = Void Function(Pointer<Void>);

// The C `weaveffi_kitchen_ReadyListener_vtable` layout.
final class _ReadyListenerVtableStruct extends Struct {
  external Pointer<NativeFunction<_NativeReadyListenerVtOnReady>> onReady;
  external Pointer<NativeFunction<_NativeReadyListenerVtOnItem>> onItem;
  external Pointer<NativeFunction<_NativeReadyListenerVtFree>> free;
}

// Vtable entry `weaveffi_kitchen_ReadyListener_vtable.on_ready`.
void _readyListenerVtOnReady(Pointer<Void> ctx, int code, Pointer<Utf8> msg, Pointer<_WeaveFFIError> outErr) {
  try {
    final impl = _callbackFor(ctx) as ReadyListener;
    impl.onReady(code, msg == nullptr ? '' : msg.toDartString());
  } catch (e) {
    _foreignError(outErr, e);
  }
}

// Vtable entry `weaveffi_kitchen_ReadyListener_vtable.on_item`.
bool _readyListenerVtOnItem(Pointer<Void> ctx, Pointer<Uint8> itemPtr, int itemLen, Pointer<Void> gadget, Pointer<_WeaveFFIError> outErr) {
  try {
    final itemData = _copyNativeBytes(itemPtr, itemLen);
    final itemReader = _BufferReader(itemData);
    final itemValue = _unpackItem(itemReader);
    itemReader.expectEnd();
    final gadgetValue = Gadget._(gadget);
    final impl = _callbackFor(ctx) as ReadyListener;
    return impl.onItem(itemValue, gadgetValue);
  } catch (e) {
    _foreignError(outErr, e);
    return false;
  }
}

void _readyListenerVtFree(Pointer<Void> ctx) {
  _callbackTable.remove(ctx.address);
}

// The process-wide static `weaveffi_kitchen_ReadyListener_vtable` every ReadyListener passed to the producer
// shares; the per-instance state travels in `ctx`.
final Pointer<_ReadyListenerVtableStruct> _ReadyListenerVtable = () {
  final vt = calloc<_ReadyListenerVtableStruct>();
  vt.ref.onReady = _pinCallable(NativeCallable<_NativeReadyListenerVtOnReady>.isolateLocal(
      _readyListenerVtOnReady));
  vt.ref.onItem = _pinCallable(NativeCallable<_NativeReadyListenerVtOnItem>.isolateLocal(
      _readyListenerVtOnItem, exceptionalReturn: false));
  vt.ref.free = _pinCallable(NativeCallable<_NativeReadyListenerVtFree>.listener(
      _readyListenerVtFree));
  return vt;
}();

typedef _NativeWeaveffiKitchenGadgetClone = Pointer<Void> Function(Pointer<Void>);
typedef _DartWeaveffiKitchenGadgetClone = Pointer<Void> Function(Pointer<Void>);
final _weaveffiKitchenGadgetClone = _lib.lookupFunction<
