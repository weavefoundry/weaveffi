      if (itemPtr != nullptr) _weaveffiFreeBytes(itemPtr, itemLen);
      final itemReader = _BufferReader(itemData);
      final item = _unpackItem(itemReader);
      itemReader.expectEnd();
      yield item;
    }
    _checkError(err);
  } finally {
    if (iter != nullptr) {
      _weaveffiKitchenStreamItemsIteratorDestroyFinalizer.detach(anchor);
      _weaveffiKitchenStreamItemsIteratorDestroy(iter);
      iter = nullptr;
    }
    calloc.free(outLen);
    calloc.free(outItem);
    calloc.free(err);
  }
}

