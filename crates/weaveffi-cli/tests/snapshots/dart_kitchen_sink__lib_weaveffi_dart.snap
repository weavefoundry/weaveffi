    calloc.free(err);
  }
}

/// Typed error domain `KitchenErrors` declared by module `kitchen`.
class KitchenErrorsException extends WeaveFFIException {
  KitchenErrorsException(super.code, super.message);
}

/// Item not found
class NotFoundException extends KitchenErrorsException {
  NotFoundException([String message = 'Item not found']) : super(1, message);
}

/// Invalid input
class InvalidInputException extends KitchenErrorsException {
  InvalidInputException([String message = 'Invalid input']) : super(2, message);
}

WeaveFFIException _mapKitchenErrorsException(int code, String message, Uint8List payload) {
  switch (code) {
    case 1:
      return NotFoundException(message);
    case 2:
      return InvalidInputException(message);
    default:
      return WeaveFFIException(code, message);
  }
}

void _checkKitchenErrorsException(Pointer<_WeaveFFIError> err) {
  if (err.ref.code != 0) {
    final code = err.ref.code;
    final msg = err.ref.message.toDartString();
    final payload = _copyNativeBytes(err.ref.payloadPtr, err.ref.payloadLen);
    _weaveffiErrorClear(err);
    throw _mapKitchenErrorsException(code, msg, payload);
  }
}

/// Task priority levels
enum Priority {
  /// Low priority
  low(0),
  /// Normal priority
  normal(1),
  /// High priority
  high(2),
  ;
  const Priority(this.value);
  final int value;

  static Priority fromValue(int value) =>
      Priority.values.firstWhere((e) => e.value == value);
}

/// Kitchen sink struct exercising every field feature
class Item {
  /// Stable identifier
  final int id;
  /// Display name
  final String name;
  /// Initial count
  final int count;
  /// Whether the item is enabled
  final bool enabled;
  /// Scaling ratio
  final double ratio;
  final int nick;
  final List<int> payload;
  final List<String> tags;
  final Map<String, String> attrs;
  final int? parent;
  /// Cross-module struct reference
  final Token token;
  final Priority priority;

  Item({required this.id, required this.name, required this.count, required this.enabled, required this.ratio, required this.nick, required this.payload, required this.tags, required this.attrs, this.parent, required this.token, required this.priority});
}

void _packItem(_BufferWriter w, Item v) {
  w.writeInt64(v.id);
  w.writeString(v.name);
  w.writeInt32(v.count);
  w.writeBool(v.enabled);
  w.writeFloat64(v.ratio);
  w.writeUint32(v.nick);
  w.writeBytes(v.payload);
  final t0 = v.tags;
  w.writeLength(t0.length);
  for (final t1 in t0) {
    w.writeString(t1);
  }
  final t2 = v.attrs;
  w.writeLength(t2.length);
  for (final t3 in t2.entries) {
    w.writeString(t3.key);
    w.writeString(t3.value);
  }
  final t4 = v.parent;
  if (t4 == null) {
    w.writeOptionFlag(false);
  } else {
    w.writeOptionFlag(true);
    w.writeInt64(t4);
  }
  _packToken(w, v.token);
  w.writeInt32(v.priority.value);
}

Item _unpackItem(_BufferReader r) {
  return Item(
    id: r.readInt64(),
    name: r.readString(),
    count: r.readInt32(),
    enabled: r.readBool(),
    ratio: r.readFloat64(),
    nick: r.readUint32(),
    payload: r.readBytes(),
    tags: List<String>.generate(r.readLength(), (_) => r.readString()),
    attrs: <String, String>{ for (var i = r.readLength(); i > 0; i--) r.readString(): r.readString() },
    parent: (r.readOptionFlag() ? r.readInt64() : null),
    token: _unpackToken(r),
    priority: Priority.fromValue(r.readInt32()),
  );
}

