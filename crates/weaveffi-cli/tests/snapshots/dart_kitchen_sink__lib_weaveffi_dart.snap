/// Trivial cross-module helper
String ping() {
  final err = calloc<_WeaveFFIError>();
  try {
    final result = _weaveffiSharedPing(err);
    _checkError(err);
    final value = result.toDartString();
    _weaveffiFreeString(result);
    return value;
