/// A pocket-sized interface exercising the object surface
class Gadget {
  final Pointer<Void> _handle;
  Gadget._(this._handle);

  /// Releases the native object reference.
  void dispose() {
    _weaveffiKitchenGadgetDestroy(_handle);
  }

  /// Create a gadget with the given id
  factory Gadget(int id) {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKitchenGadgetNew(id, err);
      _checkError(err);
      return Gadget._(result);
    } finally {
      calloc.free(err);
    }
  }

  /// Render the gadget as a human-readable string
  String describe() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKitchenGadgetDescribe(_handle, err);
      _checkError(err);
      final value = result.toDartString();
      _weaveffiFreeString(result);
      return value;
    } finally {
      calloc.free(err);
    }
  }

  /// Poke the gadget a number of times, failing on a negative count
  ///
  /// Throws [KitchenErrorsException] on domain errors.
  int poke(int times) {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKitchenGadgetPoke(_handle, times, err);
      _checkKitchenErrorsException(err);
      return result;
    } finally {
      calloc.free(err);
    }
  }

  /// The gadget subsystem version string
  static String version() {
    final err = calloc<_WeaveFFIError>();
    try {
      final result = _weaveffiKitchenGadgetVersion(err);
      _checkError(err);
      final value = result.toDartString();
      _weaveffiFreeString(result);
      return value;
    } finally {
      calloc.free(err);
    }
  }
}

