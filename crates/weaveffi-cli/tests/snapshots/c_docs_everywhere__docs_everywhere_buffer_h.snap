/* ---------------------------------------------------------------------------
 * Value types. A record is a struct of its fields; a rich enum is a `tag`
 * plus a union `as` with one struct per payload-carrying variant; a list is
 * `items` + `len`; a map is parallel `keys` and `values` arrays + `len`; an
 * optional is a pointer that is NULL when absent; an object is its pointer;
 * a string or byte string is a view (`ptr` + `len`).
 * ------------------------------------------------------------------------- */

typedef struct docs_everywhere_docs_Document docs_everywhere_docs_Document;
typedef struct docs_everywhere_list_string docs_everywhere_list_string;

/** `[string]` */
struct docs_everywhere_list_string {
    docs_everywhere_str* items;
    size_t len;
};

/**
 * Represents a single document tracked by the system.
 *
 * Documents are persisted to disk and exposed via the public API.
 */
struct docs_everywhere_docs_Document {
    /** Stable opaque identifier */
    int64_t id;
    /** Human-readable title shown in lists */
    docs_everywhere_str title;
    /** Current lifecycle status */
    docs_everywhere_docs_Status status;
    /** Free-form tags for grouping */
    docs_everywhere_list_string tags;
};

