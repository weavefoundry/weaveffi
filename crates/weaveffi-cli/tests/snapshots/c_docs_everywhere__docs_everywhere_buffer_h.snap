static inline void docs_everywhere_docs_Document_write(docs_everywhere_writer* w, const docs_everywhere_docs_Document* v) {
    docs_everywhere_writer_put_i64(w, v->id);
    docs_everywhere_writer_put_string(w, v->title);
    docs_everywhere_writer_put_i32(w, (int32_t)v->status);
    docs_everywhere_list_string_write(w, &v->tags);
