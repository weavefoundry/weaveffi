static inline bool docs_everywhere_opt_docs_Document_decode(const uint8_t* ptr, size_t len, docs_everywhere_docs_Document** out) {
    docs_everywhere_reader r = docs_everywhere_reader_of(ptr, len);
    docs_everywhere_opt_docs_Document_read(&r, out);
    if (!docs_everywhere_reader_finish(&r)) {
