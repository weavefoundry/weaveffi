    memset(out, 0, sizeof *out);
    out->id = docs_everywhere_reader_get_i64(r);
    out->title = docs_everywhere_reader_get_string(r);
    out->status = (docs_everywhere_docs_Status)docs_everywhere_reader_get_i32(r);
    docs_everywhere_list_string_read(r, &out->tags);
}

