/** A pocket-sized interface exercising the object surface */
class Gadget {
    kitchen_sink_kitchen_Gadget* raw_;

public:
    /** The C type this class wraps. */
    using raw_type = kitchen_sink_kitchen_Gadget;

    /** Adopts one strong reference to a producer object: `Gadget(adopt, raw)`. */
    explicit Gadget(adopt_t, kitchen_sink_kitchen_Gadget* h) noexcept : raw_(h) {}

    /** Releases this wrapper's reference; the object is dropped with its last one. */
    ~Gadget() {
        if (raw_ != nullptr) kitchen_sink_kitchen_Gadget_destroy(raw_);
    }

    /** Copies share the object: the copy takes a new strong reference. */
    Gadget(const Gadget& other) : raw_(kitchen_sink_kitchen_Gadget_clone(other.raw_)) {}

    /** Takes a new reference to `other`'s object and releases the current one. */
    Gadget& operator=(const Gadget& other) {
        if (this != &other) {
            kitchen_sink_kitchen_Gadget* h = kitchen_sink_kitchen_Gadget_clone(other.raw_);
            if (raw_ != nullptr) kitchen_sink_kitchen_Gadget_destroy(raw_);
            raw_ = h;
        }
        return *this;
    }

    /** Transfers `other`'s reference; `other` becomes empty. */
    Gadget(Gadget&& other) noexcept : raw_(other.raw_) { other.raw_ = nullptr; }

    /** Releases the current reference and takes over `other`'s. */
    Gadget& operator=(Gadget&& other) noexcept {
        if (this != &other) {
            if (raw_ != nullptr) kitchen_sink_kitchen_Gadget_destroy(raw_);
            raw_ = other.raw_;
            other.raw_ = nullptr;
        }
        return *this;
    }

    /** The wrapped pointer, borrowed (null after a move): this wrapper keeps its reference. */
    const kitchen_sink_kitchen_Gadget* handle() const noexcept { return raw_; }

    /** A new strong reference to the object, which the caller owns. */
    kitchen_sink_kitchen_Gadget* clone_handle() const { return kitchen_sink_kitchen_Gadget_clone(raw_); }

    /** Create a gadget with the given id */
    explicit Gadget(int64_t id);

    /** Render the gadget as a human-readable string */
    std::string describe() const;

    /**
     * Poke the gadget a number of times, failing on a negative count
     *
     * @throws KitchenErrorsError when the call fails with one of the domain's codes.
     */
    int32_t poke(int32_t times) const;

    /** The gadget subsystem version string */
    static std::string version();

};

/** A reusable token referenced across modules */
struct Token {
    int64_t id;
    std::string label;
};

/** Kitchen sink struct exercising every field feature */
struct Item {
    /** Stable identifier */
    int64_t id;
    /** Display name */
    std::string name;
    /** Initial count */
    int32_t count;
    /** Whether the item is enabled */
    bool enabled;
    /** Scaling ratio */
    double ratio;
    uint32_t nick;
    std::vector<uint8_t> payload;
    std::vector<std::string> tags;
    std::unordered_map<std::string, std::string> attrs;
    std::optional<int64_t> parent;
    /** Cross-module struct reference */
    Token token;
    Priority priority;
    /** An optional object inside a record */
    std::optional<Gadget> gadget;
};

namespace detail {

inline void write_Token(BufferWriter& w, const Token& v);
inline Token read_Token(BufferReader& r);
inline void write_Item(BufferWriter& w, const Item& v);
inline Item read_Item(BufferReader& r);
inline void write_list_string(BufferWriter& w, const std::vector<std::string>& v);
inline std::vector<std::string> read_list_string(BufferReader& r);
inline void write_map_string_string(BufferWriter& w, const std::unordered_map<std::string, std::string>& v);
inline std::unordered_map<std::string, std::string> read_map_string_string(BufferReader& r);
inline void write_opt_i64(BufferWriter& w, const std::optional<int64_t>& v);
inline std::optional<int64_t> read_opt_i64(BufferReader& r);
inline void write_opt_Gadget(BufferWriter& w, const std::optional<Gadget>& v);
inline std::optional<Gadget> read_opt_Gadget(BufferReader& r);
inline void write_list_Gadget(BufferWriter& w, const std::vector<Gadget>& v);
inline std::vector<Gadget> read_list_Gadget(BufferReader& r);
inline void write_opt_Item(BufferWriter& w, const std::optional<Item>& v);
inline std::optional<Item> read_opt_Item(BufferReader& r);
inline void write_list_Item(BufferWriter& w, const std::vector<Item>& v);
inline std::vector<Item> read_list_Item(BufferReader& r);
inline void write_map_string_i32(BufferWriter& w, const std::unordered_map<std::string, int32_t>& v);
inline std::unordered_map<std::string, int32_t> read_map_string_i32(BufferReader& r);

/** Writes one `Token` to a value buffer. */
inline void write_Token(BufferWriter& w, const Token& v) {
    w.write_i64(v.id);
    w.write_string(v.label);
}

/** Reads one `Token` from a value buffer. */
inline Token read_Token(BufferReader& r) {
    return Token{
        r.read_i64(),
        r.read_string(),
    };
}

/** Writes one `Item` to a value buffer. */
inline void write_Item(BufferWriter& w, const Item& v) {
    w.write_i64(v.id);
    w.write_string(v.name);
    w.write_i32(v.count);
    w.write_bool(v.enabled);
    w.write_f64(v.ratio);
    w.write_u32(v.nick);
    w.write_bytes(v.payload);
    detail::write_list_string(w, v.tags);
    detail::write_map_string_string(w, v.attrs);
    detail::write_opt_i64(w, v.parent);
    detail::write_Token(w, v.token);
    w.write_i32(static_cast<int32_t>(v.priority));
    detail::write_opt_Gadget(w, v.gadget);
}

/** Reads one `Item` from a value buffer. */
inline Item read_Item(BufferReader& r) {
    return Item{
        r.read_i64(),
        r.read_string(),
        r.read_i32(),
        r.read_bool(),
        r.read_f64(),
        r.read_u32(),
        r.read_bytes(),
        detail::read_list_string(r),
        detail::read_map_string_string(r),
        detail::read_opt_i64(r),
        detail::read_Token(r),
        static_cast<Priority>(r.read_i32()),
        detail::read_opt_Gadget(r),
    };
}

/** Writes one `[string]` to a value buffer. */
inline void write_list_string(BufferWriter& w, const std::vector<std::string>& v) {
    w.write_len(v.size());
    for (const auto& item : v) w.write_string(item);
}

/** Reads one `[string]` from a value buffer. */
inline std::vector<std::string> read_list_string(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<std::string> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(r.read_string());
    return v;
}

/** Writes one `{string:string}` to a value buffer. */
inline void write_map_string_string(BufferWriter& w, const std::unordered_map<std::string, std::string>& v) {
    w.write_len(v.size());
    for (const auto& entry : v) {
        w.write_string(entry.first);
        w.write_string(entry.second);
    }
}

/** Reads one `{string:string}` from a value buffer. */
inline std::unordered_map<std::string, std::string> read_map_string_string(BufferReader& r) {
    size_t n = r.read_count();
    std::unordered_map<std::string, std::string> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) {
        std::string key = r.read_string();
        std::string value = r.read_string();
        if (!v.emplace(std::move(key), std::move(value)).second) BufferReader::fail("repeated map key");
    }
    return v;
}

/** Writes one `i64?` to a value buffer. */
inline void write_opt_i64(BufferWriter& w, const std::optional<int64_t>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) w.write_i64(*v);
}

/** Reads one `i64?` from a value buffer. */
inline std::optional<int64_t> read_opt_i64(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<int64_t>(r.read_i64());
}

/** Writes one `Gadget?` to a value buffer. */
inline void write_opt_Gadget(BufferWriter& w, const std::optional<Gadget>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) w.write_object(*v);
}

/** Reads one `Gadget?` from a value buffer. */
inline std::optional<Gadget> read_opt_Gadget(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<Gadget>(r.read_object<Gadget>());
}

/** Writes one `[Gadget]` to a value buffer. */
inline void write_list_Gadget(BufferWriter& w, const std::vector<Gadget>& v) {
    w.write_len(v.size());
    for (const auto& item : v) w.write_object(item);
}

/** Reads one `[Gadget]` from a value buffer. */
inline std::vector<Gadget> read_list_Gadget(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<Gadget> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(r.read_object<Gadget>());
    return v;
}

/** Writes one `Item?` to a value buffer. */
inline void write_opt_Item(BufferWriter& w, const std::optional<Item>& v) {
    w.write_option_flag(v.has_value());
    if (v.has_value()) detail::write_Item(w, *v);
}

/** Reads one `Item?` from a value buffer. */
inline std::optional<Item> read_opt_Item(BufferReader& r) {
    if (!r.read_option_flag()) return std::nullopt;
    return std::optional<Item>(detail::read_Item(r));
}

/** Writes one `[Item]` to a value buffer. */
inline void write_list_Item(BufferWriter& w, const std::vector<Item>& v) {
    w.write_len(v.size());
    for (const auto& item : v) detail::write_Item(w, item);
}

/** Reads one `[Item]` from a value buffer. */
inline std::vector<Item> read_list_Item(BufferReader& r) {
    size_t n = r.read_count();
    std::vector<Item> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(detail::read_Item(r));
    return v;
}

/** Writes one `{string:i32}` to a value buffer. */
inline void write_map_string_i32(BufferWriter& w, const std::unordered_map<std::string, int32_t>& v) {
    w.write_len(v.size());
    for (const auto& entry : v) {
        w.write_string(entry.first);
        w.write_i32(entry.second);
    }
}

/** Reads one `{string:i32}` from a value buffer. */
inline std::unordered_map<std::string, int32_t> read_map_string_i32(BufferReader& r) {
    size_t n = r.read_count();
    std::unordered_map<std::string, int32_t> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) {
        std::string key = r.read_string();
        int32_t value = r.read_i32();
        if (!v.emplace(std::move(key), std::move(value)).second) BufferReader::fail("repeated map key");
    }
    return v;
}

} // namespace detail

/** The errors the `kitchen` module's throwing calls report; catch a code's subclass or this. */
class KitchenErrorsError : public Error {
public:
    /** Builds an error carrying a domain `code` and `message`. */
    KitchenErrorsError(int32_t code, const std::string& message) : Error(code, message) {}
};

/**
 * Item not found
 *
 * Code 1.
 */
class NotFoundError : public KitchenErrorsError {
public:
    /** Builds the error with the producer's `message` and the code's fields. */
    explicit NotFoundError(const std::string& message) : KitchenErrorsError(1, message) {}
};

/**
 * Invalid input
 *
 * Code 2.
 */
class InvalidInputError : public KitchenErrorsError {
public:
    /** Builds the error with the producer's `message` and the code's fields. */
    explicit InvalidInputError(const std::string& message) : KitchenErrorsError(2, message) {}
};

namespace detail {

/** The exception for a failed `KitchenErrorsError` call: its code's subclass, Cancelled, or the root Error. */
inline std::exception_ptr make_kitchen_error(int32_t code, const std::string& message, const uint8_t* payload_ptr, size_t payload_len) {
    if (code == -5) return std::make_exception_ptr(Cancelled(message));
    if (code < 0) return std::make_exception_ptr(Error(code, message));
    (void)payload_ptr;
    (void)payload_len;
    switch (code) {
        case 1: return std::make_exception_ptr(NotFoundError(message));
        case 2: return std::make_exception_ptr(InvalidInputError(message));
        default: return std::make_exception_ptr(KitchenErrorsError(code, message));
    }
}

/** Throws the typed `KitchenErrorsError` exception if `err` carries a nonzero code. */
inline void check_kitchen(kitchen_sink_error& err) {
    if (err.code == 0) return;
    std::exception_ptr ex = make_kitchen_error(err.code, error_message(err), err.payload_ptr, err.payload_len);
    kitchen_sink_error_clear(&err);
    std::rethrow_exception(ex);
}

/** Reports a `KitchenErrorsError` a callback implementation threw through the vtable entry's `out_err`. */
inline void report_kitchen_error(const KitchenErrorsError& e, kitchen_sink_error* out_err) {
    switch (e.code()) {
        case 1: kitchen_sink_error_set(out_err, 1, e.what()); return;
        case 2: kitchen_sink_error_set(out_err, 2, e.what()); return;
        default: break;
    }
    kitchen_sink_error_set(out_err, -4, e.what());
}

} // namespace detail

/**
 * Consumer-implemented observer of ready items
 *
 * Subclass it and pass a `std::shared_ptr<ReadyListener>` where the API takes a `ReadyListener`. The producer may call the methods from any thread, so they must be thread-safe, until it releases the implementation (also from any thread). A method that declares errors may throw a `KitchenErrorsError` code's exception, which reaches the producer with its fields; any other exception reaches it as a callback failure (code -4).
 */
class ReadyListener {
public:
    virtual ~ReadyListener() = default;

    /** Fires when an item is ready */
    virtual void on_ready(int32_t code, std::string_view msg) = 0;

    /** Receives the item itself and says whether to keep listening */
    virtual bool on_item(const Item& item, Gadget gadget) = 0;

    /**
     * A display label, failing with a kitchen error
     *
     * @throws KitchenErrorsError to report one of the domain's codes to the producer.
     */
    virtual std::string label() = 0;

    /** The most recent item the listener kept, if any */
    virtual std::optional<Item> latest() = 0;

    /** The listener's favorite gadget */
    virtual Gadget favorite() = 0;
};

namespace detail {

/** Trampolines adapting a `ReadyListener` implementation to `kitchen_sink_kitchen_ReadyListener_vtable`. */
struct ReadyListener_trampolines {
    static void on_ready(void* ctx, int32_t code, const uint8_t* msg_ptr, size_t msg_len, kitchen_sink_error* out_err) {
        try {
            ReadyListener& impl = **static_cast<std::shared_ptr<ReadyListener>*>(ctx);
            impl.on_ready(code, detail::borrow_string(msg_ptr, msg_len));
        } catch (const std::exception& e) {
            kitchen_sink_error_set(out_err, -4, e.what());
        } catch (...) {
            kitchen_sink_error_set(out_err, -4, "ReadyListener::on_ready threw a non-standard exception");
        }
    }

    static bool on_item(void* ctx, const uint8_t* item_ptr, size_t item_len, kitchen_sink_kitchen_Gadget* gadget, kitchen_sink_error* out_err) {
        Gadget gadget_arg(adopt, gadget);
        try {
            ReadyListener& impl = **static_cast<std::shared_ptr<ReadyListener>*>(ctx);
            Item item_arg = detail::decode(item_ptr, item_len, &detail::read_Item);
            return impl.on_item(std::move(item_arg), std::move(gadget_arg));
        } catch (const std::exception& e) {
            kitchen_sink_error_set(out_err, -4, e.what());
        } catch (...) {
            kitchen_sink_error_set(out_err, -4, "ReadyListener::on_item threw a non-standard exception");
        }
        return bool{};
    }

    static void label(void* ctx, uint8_t** out_ptr, size_t* out_len, kitchen_sink_error* out_err) {
        try {
            ReadyListener& impl = **static_cast<std::shared_ptr<ReadyListener>*>(ctx);
            std::string ret = impl.label();
            detail::hand_over(ret.data(), ret.size(), out_ptr, out_len);
        } catch (const KitchenErrorsError& e) {
            detail::report_kitchen_error(e, out_err);
        } catch (const std::exception& e) {
            kitchen_sink_error_set(out_err, -4, e.what());
        } catch (...) {
            kitchen_sink_error_set(out_err, -4, "ReadyListener::label threw a non-standard exception");
        }
    }

    static void latest(void* ctx, uint8_t** out_ptr, size_t* out_len, kitchen_sink_error* out_err) {
        try {
            ReadyListener& impl = **static_cast<std::shared_ptr<ReadyListener>*>(ctx);
            std::optional<Item> ret = impl.latest();
            detail::BufferWriter ret_buf;
            detail::write_opt_Item(ret_buf, ret);
            detail::hand_over(ret_buf.data(), ret_buf.size(), out_ptr, out_len);
        } catch (const std::exception& e) {
            kitchen_sink_error_set(out_err, -4, e.what());
        } catch (...) {
            kitchen_sink_error_set(out_err, -4, "ReadyListener::latest threw a non-standard exception");
        }
    }

    static kitchen_sink_kitchen_Gadget* favorite(void* ctx, kitchen_sink_error* out_err) {
        try {
            ReadyListener& impl = **static_cast<std::shared_ptr<ReadyListener>*>(ctx);
            return impl.favorite().clone_handle();
        } catch (const std::exception& e) {
            kitchen_sink_error_set(out_err, -4, e.what());
        } catch (...) {
            kitchen_sink_error_set(out_err, -4, "ReadyListener::favorite threw a non-standard exception");
        }
        return nullptr;
    }

    /** Deletes the implementation box once the producer releases it. */
    static void free_ctx(void* ctx) {
        delete static_cast<std::shared_ptr<ReadyListener>*>(ctx);
    }
};

/** The vtable every `ReadyListener` implementation is passed with. */
inline const kitchen_sink_kitchen_ReadyListener_vtable& ReadyListener_vtable() {
    static const kitchen_sink_kitchen_ReadyListener_vtable vtable = {
        static_cast<uint32_t>(sizeof(kitchen_sink_kitchen_ReadyListener_vtable)),
        0,
        &ReadyListener_trampolines::free_ctx,
        &ReadyListener_trampolines::on_ready,
        &ReadyListener_trampolines::on_item,
        &ReadyListener_trampolines::label,
        &ReadyListener_trampolines::latest,
        &ReadyListener_trampolines::favorite,
    };
    return vtable;
}

} // namespace detail

inline Gadget::Gadget(int64_t id) : raw_(nullptr) {
    check_library();
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_Gadget_new(id, &err);
    detail::check(err);
    raw_ = result;
}

inline std::string Gadget::describe() const {
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_Gadget_describe(raw_, &out_len, &err);
    detail::check(err);
    return detail::take_string(result, out_len);
}

inline int32_t Gadget::poke(int32_t times) const {
    kitchen_sink_error err{};
