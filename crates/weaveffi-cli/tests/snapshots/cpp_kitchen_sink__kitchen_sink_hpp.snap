/** Register a listener, returning how many are attached */
inline int32_t subscribe(std::shared_ptr<ReadyListener> listener) {
    check_library();
    if (!listener) throw std::invalid_argument("listener: null callback interface");
    auto listener_ctx = std::make_unique<std::shared_ptr<ReadyListener>>(std::move(listener));
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_subscribe(static_cast<void*>(listener_ctx.release()), &detail::ReadyListener_vtable(), &err);
    detail::check(err);
    return result;
}

/** Register a listener if one is given */
inline bool maybe_subscribe(std::shared_ptr<ReadyListener> listener) {
    check_library();
    const auto* listener_vtable = listener ? &detail::ReadyListener_vtable() : nullptr;
    std::unique_ptr<std::shared_ptr<ReadyListener>> listener_ctx(listener ? new std::shared_ptr<ReadyListener>(std::move(listener)) : nullptr);
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_maybe_subscribe(static_cast<void*>(listener_ctx.release()), listener_vtable, &err);
    detail::check(err);
    return result;
}

/** Optional object in both directions */
inline std::optional<Gadget> maybe_gadget(const std::optional<Gadget>& fallback) {
    check_library();
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_maybe_gadget(fallback.has_value() ? fallback->handle() : nullptr, &err);
    detail::check(err);
    return result != nullptr ? std::optional<Gadget>(std::in_place, adopt, result) : std::nullopt;
}

/** A list of objects */
inline std::vector<Gadget> gadgets() {
    check_library();
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_gadgets(&out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_list_Gadget);
}

/**
 * A lazy, move-only range over the `Gadget` elements `stream_gadgets()` produces.
 *
 * Each step pulls one element from the producer, so results stream in constant memory. The range releases the producer iterator exactly once: when it's exhausted, or from the destructor when iteration stops early.
 */
class StreamGadgetsIterator {
    kitchen_sink_kitchen_StreamGadgetsIterator* handle_;

public:
    /** Adopts a producer iterator. */
    explicit StreamGadgetsIterator(adopt_t, kitchen_sink_kitchen_StreamGadgetsIterator* h) noexcept : handle_(h) {}

    /** Releases the producer iterator if it's still held. */
    ~StreamGadgetsIterator() {
        if (handle_ != nullptr) kitchen_sink_kitchen_StreamGadgetsIterator_destroy(handle_);
    }

    StreamGadgetsIterator(const StreamGadgetsIterator&) = delete;
    StreamGadgetsIterator& operator=(const StreamGadgetsIterator&) = delete;

    /** Transfers `other`'s iterator; `other` becomes empty. */
    StreamGadgetsIterator(StreamGadgetsIterator&& other) noexcept : handle_(other.handle_) { other.handle_ = nullptr; }

    /** Releases the current iterator and takes over `other`'s. */
    StreamGadgetsIterator& operator=(StreamGadgetsIterator&& other) noexcept {
        if (this != &other) {
            if (handle_ != nullptr) kitchen_sink_kitchen_StreamGadgetsIterator_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** Pulls the next element, or `std::nullopt` once exhausted (which releases the producer iterator). A producer error releases the iterator and throws InternalError. */
    std::optional<Gadget> next() {
        if (handle_ == nullptr) return std::nullopt;
        kitchen_sink_error err{};
        kitchen_sink_kitchen_Gadget* item{};
        int32_t has_item = kitchen_sink_kitchen_StreamGadgetsIterator_next(handle_, &item, &err);
        if (err.code != 0 || has_item == 0) {
            kitchen_sink_kitchen_StreamGadgetsIterator_destroy(handle_);
            handle_ = nullptr;
            detail::check(err);
            return std::nullopt;
        }
        return std::optional<Gadget>(std::in_place, Gadget(adopt, item));
    }

    /** Sentinel type marking the end of the range. */
    struct sentinel {};

    /** Single-pass input iterator; each increment pulls one element. */
    class iterator {
        StreamGadgetsIterator* range_;
        std::optional<Gadget> current_;

    public:
        using iterator_category = std::input_iterator_tag;
        using value_type = Gadget;
        using difference_type = std::ptrdiff_t;
        using pointer = Gadget*;
        using reference = Gadget&;

        /** Binds to `range` and pulls the first element. */
        explicit iterator(StreamGadgetsIterator* range) : range_(range), current_(range->next()) {}
        reference operator*() { return *current_; }
        pointer operator->() { return &*current_; }
        iterator& operator++() { current_ = range_->next(); return *this; }
        void operator++(int) { current_ = range_->next(); }
        bool operator==(sentinel) const { return !current_.has_value(); }
        bool operator!=(sentinel) const { return current_.has_value(); }
    };

    /** Begins iteration by pulling the first element. */
    iterator begin() { return iterator(this); }

    /** The past-the-end sentinel. */
    sentinel end() const { return sentinel{}; }
};

/**
 * An iterator over objects
 *
 * @return A lazy `StreamGadgetsIterator` range that pulls one element per step and releases the producer iterator when exhausted or destroyed.
 */
inline StreamGadgetsIterator stream_gadgets() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_kitchen_StreamGadgetsIterator* iter = kitchen_sink_kitchen_stream_gadgets(&err);
    detail::check(err);
    return StreamGadgetsIterator(adopt, iter);
}

/**
 * Optional struct return
 *
 * @throws KitchenErrorsError when the call fails with one of the domain's codes.
 */
inline std::optional<Item> maybe_item(int64_t id) {
    check_library();
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_maybe_item(id, &out_len, &err);
    detail::check_kitchen(err);
    return detail::take(result, out_len, &detail::read_opt_Item);
}

