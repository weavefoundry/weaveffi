namespace kitchen::nested {

/** Trivial nested-module function */
inline std::string hello() {
    check_library();
    kitchen_sink_error err{};
    size_t out_len{};
    auto result = kitchen_sink_kitchen_nested_hello(&out_len, &err);
    detail::check<InternalError>(err);
    return detail::take_string(result, out_len);
}

