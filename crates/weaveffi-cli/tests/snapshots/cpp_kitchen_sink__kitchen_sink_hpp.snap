} // namespace detail

/**
 * Verifies that the linked kitchen_sink library implements C ABI revision
 * 5 and every declaration this header was generated with, throwing
 * LoadError naming the first mismatch. The check runs once; every free
 * function, constructor, and static member calls this before its first
 * native call, so calling it at startup is optional.
 */
inline void check_library() {
    static const std::string failure = []() -> std::string {
        uint32_t abi = kitchen_sink_abi_version();
        if (abi != KITCHEN_SINK_ABI_VERSION) {
            return "kitchen_sink: C ABI revision mismatch (header " + std::to_string(KITCHEN_SINK_ABI_VERSION) +
                   ", library " + std::to_string(abi) + ")";
        }
        if (std::string why = detail::contract_mismatch(kitchen_sink_shared_contract, detail::shared_contract); !why.empty()) {
            return "kitchen_sink: " + why;
        }
        if (std::string why = detail::contract_mismatch(kitchen_sink_kitchen_contract, detail::kitchen_contract); !why.empty()) {
            return "kitchen_sink: " + why;
        }
        return std::string();
    }();
    if (!failure.empty()) throw LoadError(failure);
}

namespace detail {

/**
 * Serializes values into the value-buffer wire format: little-endian, packed
 * with no alignment, lengths and element counts as u32. The `write`
 * overloads below encode one value of each type.
 */
class BufferWriter {
public:
    /** Pointer to the encoded bytes. */
    const uint8_t* data() const noexcept { return buf_.data(); }

    /** Number of encoded bytes. */
    size_t size() const noexcept { return buf_.size(); }

    /** Appends one byte. */
    void byte(uint8_t v) { buf_.push_back(v); }

    /** Appends an unsigned integer, little-endian. */
    template <typename U>
    void le(U v) {
        for (size_t i = 0; i < sizeof(U); ++i) buf_.push_back(static_cast<uint8_t>(v >> (8 * i)));
    }

    /** Appends a byte length or an element count as a u32, failing with -3 past u32. */
    void len(size_t n) {
        if (static_cast<uint64_t>(n) > UINT32_MAX) throw Error(-3, "value buffer length exceeds u32");
        le(static_cast<uint32_t>(n));
    }

    /** Appends `n` raw bytes. */
    void bytes(const void* data, size_t n) {
        const uint8_t* p = static_cast<const uint8_t*>(data);
        buf_.insert(buf_.end(), p, p + n);
    }

private:
    std::vector<uint8_t> buf_;
};

/**
 * Decodes values from the value-buffer wire format. A malformed buffer is a
 * producer bug (both sides are generated from one API), so every decode
 * failure throws InternalError with the marshalling code -3. Object tokens
 * adopted before a failure live in wrappers that release them on unwind.
 */
class BufferReader {
public:
    /** Reads from the `len` bytes at `data` (null when empty). */
    BufferReader(const uint8_t* data, size_t len) noexcept : data_(data), len_(data != nullptr ? len : 0) {}

    /** Throws the marshalling failure (-3) for a malformed buffer. */
    [[noreturn]] static void fail(const char* what) {
        throw InternalError(-3, std::string("malformed value buffer: ") + what);
    }

    /** Bytes not yet consumed. */
    size_t remaining() const noexcept { return len_ - pos_; }

    /** Consumes `n` bytes, returning where they start. */
    const uint8_t* take(size_t n, const char* what) {
        if (remaining() < n) fail(what);
        const uint8_t* p = data_ + pos_;
        pos_ += n;
        return p;
    }

    /** Reads an unsigned integer, little-endian. */
    template <typename U>
    U le(const char* what) {
        const uint8_t* p = take(sizeof(U), what);
        U v = 0;
        for (size_t i = 0; i < sizeof(U); ++i) v = static_cast<U>(v | static_cast<U>(static_cast<U>(p[i]) << (8 * i)));
        return v;
    }

    /** Reads a 0/1 byte (a bool or an optional's presence flag). */
    bool flag(const char* what) {
        uint8_t b = le<uint8_t>(what);
        if (b > 1) fail(what);
        return b != 0;
    }

    /** Reads a byte length, rejecting one larger than the bytes remaining. */
    size_t len() {
        size_t n = le<uint32_t>("length");
        if (n > remaining()) fail("length prefix exceeds remaining buffer");
        return n;
    }

    /**
     * Reads an element count. Elements may encode to zero bytes, so a count
     * larger than the bytes remaining is legal; preallocate with reserve_hint().
     */
    size_t count() { return le<uint32_t>("count"); }

    /** A preallocation size for `n` elements that a malformed count can't inflate. */
    size_t reserve_hint(size_t n) const noexcept { return n < remaining() ? n : remaining(); }

    /** Rejects unconsumed bytes after decoding a complete value. */
    void expect_end() const {
        if (pos_ != len_) fail("trailing bytes after value");
    }

private:
    const uint8_t* data_;
    size_t len_;
    size_t pos_ = 0;
};

/** Selects a `read` overload by the type it decodes. */
template <typename T>
struct type_tag {};

/** Reads one `T` (declared below and per value type). */
template <typename T>
T read(BufferReader& r) {
    return read(r, type_tag<T>{});
}

inline void write(BufferWriter& w, bool v) { w.byte(v ? 1 : 0); }
inline void write(BufferWriter& w, int8_t v) { w.byte(static_cast<uint8_t>(v)); }
inline void write(BufferWriter& w, uint8_t v) { w.byte(v); }
inline void write(BufferWriter& w, int16_t v) { w.le(static_cast<uint16_t>(v)); }
inline void write(BufferWriter& w, uint16_t v) { w.le(v); }
inline void write(BufferWriter& w, int32_t v) { w.le(static_cast<uint32_t>(v)); }
inline void write(BufferWriter& w, uint32_t v) { w.le(v); }
inline void write(BufferWriter& w, int64_t v) { w.le(static_cast<uint64_t>(v)); }
inline void write(BufferWriter& w, uint64_t v) { w.le(v); }

inline void write(BufferWriter& w, float v) {
    uint32_t bits = 0;
    std::memcpy(&bits, &v, sizeof bits);
    w.le(bits);
}

inline void write(BufferWriter& w, double v) {
    uint64_t bits = 0;
    std::memcpy(&bits, &v, sizeof bits);
    w.le(bits);
}

inline void write(BufferWriter& w, std::string_view v) {
    w.len(v.size());
    w.bytes(v.data(), v.size());
}

inline void write(BufferWriter& w, const std::vector<uint8_t>& v) {
    w.len(v.size());
    w.bytes(v.data(), v.size());
}

inline bool read(BufferReader& r, type_tag<bool>) { return r.flag("bool"); }
inline int8_t read(BufferReader& r, type_tag<int8_t>) { return static_cast<int8_t>(r.le<uint8_t>("i8")); }
inline uint8_t read(BufferReader& r, type_tag<uint8_t>) { return r.le<uint8_t>("u8"); }
inline int16_t read(BufferReader& r, type_tag<int16_t>) { return static_cast<int16_t>(r.le<uint16_t>("i16")); }
inline uint16_t read(BufferReader& r, type_tag<uint16_t>) { return r.le<uint16_t>("u16"); }
inline int32_t read(BufferReader& r, type_tag<int32_t>) { return static_cast<int32_t>(r.le<uint32_t>("i32")); }
inline uint32_t read(BufferReader& r, type_tag<uint32_t>) { return r.le<uint32_t>("u32"); }
inline int64_t read(BufferReader& r, type_tag<int64_t>) { return static_cast<int64_t>(r.le<uint64_t>("i64")); }
inline uint64_t read(BufferReader& r, type_tag<uint64_t>) { return r.le<uint64_t>("u64"); }

inline float read(BufferReader& r, type_tag<float>) {
    uint32_t bits = r.le<uint32_t>("f32");
    float v = 0;
    std::memcpy(&v, &bits, sizeof v);
    return v;
}

inline double read(BufferReader& r, type_tag<double>) {
    uint64_t bits = r.le<uint64_t>("f64");
    double v = 0;
    std::memcpy(&v, &bits, sizeof v);
    return v;
}

inline std::string read(BufferReader& r, type_tag<std::string>) {
    size_t n = r.len();
    return std::string(reinterpret_cast<const char*>(r.take(n, "string")), n);
}

inline std::vector<uint8_t> read(BufferReader& r, type_tag<std::vector<uint8_t>>) {
    size_t n = r.len();
    const uint8_t* p = r.take(n, "bytes");
    return std::vector<uint8_t>(p, p + n);
}

/** A C-style enum crosses as its `int32_t` discriminant. */
template <typename E, std::enable_if_t<std::is_enum_v<E>, int> = 0>
void write(BufferWriter& w, E v) {
    write(w, static_cast<int32_t>(v));
}

template <typename E, std::enable_if_t<std::is_enum_v<E>, int> = 0>
E read(BufferReader& r, type_tag<E>) {
    return static_cast<E>(read<int32_t>(r));
}

/** Whether `T` is an interface wrapper (it names the C type it wraps). */
template <typename T, typename = void>
struct is_object : std::false_type {};

template <typename T>
struct is_object<T, std::void_t<typename T::raw_type>> : std::true_type {};

/**
 * An object crosses as a token: a fresh strong reference from the wrapper's
 * `_clone`, which the reader adopts while the writer's wrapper keeps its own.
 */
template <typename T, std::enable_if_t<is_object<T>::value, int> = 0>
void write(BufferWriter& w, const T& v) {
    write(w, static_cast<uint64_t>(reinterpret_cast<uintptr_t>(v.clone_handle())));
}

template <typename T, std::enable_if_t<is_object<T>::value, int> = 0>
T read(BufferReader& r, type_tag<T>) {
    auto* raw = reinterpret_cast<typename T::raw_type*>(static_cast<uintptr_t>(read<uint64_t>(r)));
    if (raw == nullptr) BufferReader::fail("null object token");
    return T(adopt, raw);
}

/** `T?`: a presence flag, then the value when present. */
template <typename T>
void write(BufferWriter& w, const std::optional<T>& v) {
    w.byte(v.has_value() ? 1 : 0);
    if (v.has_value()) write(w, *v);
}

template <typename T>
std::optional<T> read(BufferReader& r, type_tag<std::optional<T>>) {
    if (!r.flag("option flag")) return std::nullopt;
    return std::optional<T>(read<T>(r));
}

/** `[T]`: a u32 count, then the elements. */
template <typename T>
void write(BufferWriter& w, const std::vector<T>& v) {
    w.len(v.size());
    for (const auto& item : v) write(w, item);
}

template <typename T>
std::vector<T> read(BufferReader& r, type_tag<std::vector<T>>) {
    size_t n = r.count();
    std::vector<T> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) v.push_back(read<T>(r));
    return v;
}

/** `{K: V}`: a u32 count, then each key and value. A repeated key is malformed. */
template <typename K, typename V>
void write(BufferWriter& w, const std::unordered_map<K, V>& v) {
    w.len(v.size());
    for (const auto& entry : v) {
        write(w, entry.first);
        write(w, entry.second);
    }
}

template <typename K, typename V>
std::unordered_map<K, V> read(BufferReader& r, type_tag<std::unordered_map<K, V>>) {
    size_t n = r.count();
    std::unordered_map<K, V> v;
    v.reserve(r.reserve_hint(n));
    for (size_t i = 0; i < n; ++i) {
        K key = read<K>(r);
        V value = read<V>(r);
        if (!v.emplace(std::move(key), std::move(value)).second) BufferReader::fail("repeated map key");
    }
    return v;
}

/** Encodes one value into a fresh buffer. */
template <typename T>
BufferWriter encode(const T& value) {
    BufferWriter w;
    write(w, value);
    return w;
}

/** Decodes one complete `T` from a borrowed buffer, rejecting trailing bytes. */
template <typename T>
T decode(const uint8_t* ptr, size_t len) {
    BufferReader r(ptr, len);
    T value = read<T>(r);
    r.expect_end();
    return value;
}

/** Decodes one complete `T` from a producer-returned buffer, then releases the buffer. */
template <typename T>
T take(const uint8_t* ptr, size_t len) {
    Run run{ptr, len};
    return decode<T>(ptr, len);
}

/** Hands a callback's buffered return to the producer as a kitchen_sink_alloc run. */
inline void give(const BufferWriter& value, uint8_t** out_ptr, size_t* out_len) {
    give_run(value.data(), value.size(), out_ptr, out_len);
}

/** Throws the error class `E` of a domain code with fields, decoding them from the error's payload. */
template <typename E, typename... Fields>
[[noreturn]] void raise_with_fields(const error& err) {
    BufferReader r(err.payload_ptr, err.payload_len);
    E e{message(err), read<Fields>(r)...};
    r.expect_end();
    throw e;
}

/**
 * Reports a domain exception from a callback: its code and message, and its
 * `fields` encoded as the payload. A field that can't be encoded reports a
 * plain failure (-1) instead.
 */
template <typename... Fields>
void report_with_fields(error* out_err, const Error& e, const Fields&... fields) noexcept {
    try {
        BufferWriter payload;
        (write(payload, fields), ...);
        set_error(out_err, e.code(), e.what());
        kitchen_sink_error_set_payload(out_err, payload.data(), payload.size());
    } catch (...) {
        set_error(out_err, -1, e.what());
    }
}

} // namespace detail

/** Task priority levels */
enum class Priority : int32_t {
    /** Low priority */
    Low = 0,
    /** Normal priority */
    Normal = 1,
    /** High priority */
    High = 2,
};

struct Token;
struct Item;
class Gadget;
class ReadyListener;
class Sampler;

/** A pocket-sized interface exercising the object surface */
class Gadget {
public:
    /** The C type this class wraps. */
    using raw_type = kitchen_sink_kitchen_Gadget;

    /** Adopts one strong reference to a producer object: `Gadget(adopt, raw)`. */
    explicit Gadget(adopt_t, raw_type* raw) noexcept : raw_(raw) {}

    /** Create a gadget with the given id */
    explicit Gadget(int64_t id);

    /** Render the gadget as a human-readable string */
    std::string describe() const;

    /**
     * Poke the gadget a number of times, failing on a negative count
     *
     * @throws KitchenError (or one of its codes' classes) when the call fails with one of the domain's codes.
     */
    int32_t poke(int32_t times) const;

    /**
     * The gadget's sensor readings, optionally limited
     *
     * @throws Error with code -1 and the producer's message when the call fails.
     */
    std::vector<double> readings(std::optional<uint32_t> limit) const;

    /** The gadget subsystem version string */
    static std::string version();

    /** The wrapped pointer, borrowed (null after a move): this wrapper keeps its reference. */
    const raw_type* handle() const noexcept { return raw_.get(); }

    /** A new strong reference to the object, which the caller owns. */
    raw_type* clone_handle() const noexcept { return raw_.clone(); }

    /** Whether both wrap the same producer object. */
    friend bool operator==(const Gadget& a, const Gadget& b) noexcept { return a.raw_.get() == b.raw_.get(); }
    friend bool operator!=(const Gadget& a, const Gadget& b) noexcept { return !(a == b); }

private:
    struct traits {
        using raw_type = kitchen_sink_kitchen_Gadget;
        static raw_type* clone(const raw_type* raw) noexcept { return kitchen_sink_kitchen_Gadget_clone(raw); }
        static void destroy(raw_type* raw) noexcept { kitchen_sink_kitchen_Gadget_destroy(raw); }
    };

    detail::Handle<traits> raw_;
};

/** A reusable token referenced across modules */
struct Token {
    int64_t id{};
    std::string label{};

    /** Memberwise equality; interface members compare by identity. */
    friend bool operator==(const Token& a, const Token& b) { return a.id == b.id && a.label == b.label; }
    friend bool operator!=(const Token& a, const Token& b) { return !(a == b); }
};

/** Kitchen sink struct exercising every field feature */
struct Item {
    /** Stable identifier */
    int64_t id{};
    /** Display name */
    std::string name{};
    /** Initial count */
    int32_t count{};
    /** Whether the item is enabled */
    bool enabled{};
    /** Scaling ratio */
    double ratio{};
    uint32_t nick{};
    std::vector<uint8_t> payload{};
    std::vector<std::string> tags{};
    std::unordered_map<std::string, std::string> attrs{};
    std::optional<int64_t> parent{};
    /** Cross-module struct reference */
    Token token{};
    Priority priority{};
    /** An optional object inside a record */
    std::optional<Gadget> gadget{};

    /** Memberwise equality; interface members compare by identity. */
    friend bool operator==(const Item& a, const Item& b) {
        return a.id == b.id
            && a.name == b.name
            && a.count == b.count
            && a.enabled == b.enabled
            && a.ratio == b.ratio
            && a.nick == b.nick
            && a.payload == b.payload
            && a.tags == b.tags
            && a.attrs == b.attrs
            && a.parent == b.parent
            && a.token == b.token
            && a.priority == b.priority
            && a.gadget == b.gadget;
    }
    friend bool operator!=(const Item& a, const Item& b) { return !(a == b); }
};

namespace detail {

inline void write(BufferWriter& w, const Token& v);
inline Token read(BufferReader& r, type_tag<Token>);
inline void write(BufferWriter& w, const Item& v);
inline Item read(BufferReader& r, type_tag<Item>);

inline void write(BufferWriter& w, const Token& v) {
    write(w, v.id);
    write(w, v.label);
}

inline Token read(BufferReader& r, type_tag<Token>) {
    return Token{read<int64_t>(r), read<std::string>(r)};
}

inline void write(BufferWriter& w, const Item& v) {
    write(w, v.id);
    write(w, v.name);
    write(w, v.count);
    write(w, v.enabled);
    write(w, v.ratio);
    write(w, v.nick);
    write(w, v.payload);
    write(w, v.tags);
    write(w, v.attrs);
    write(w, v.parent);
    write(w, v.token);
    write(w, v.priority);
    write(w, v.gadget);
}

inline Item read(BufferReader& r, type_tag<Item>) {
    return Item{
        read<int64_t>(r),
        read<std::string>(r),
        read<int32_t>(r),
        read<bool>(r),
        read<double>(r),
        read<uint32_t>(r),
        read<std::vector<uint8_t>>(r),
        read<std::vector<std::string>>(r),
        read<std::unordered_map<std::string, std::string>>(r),
        read<std::optional<int64_t>>(r),
        read<Token>(r),
        read<Priority>(r),
        read<std::optional<Gadget>>(r)
    };
}

} // namespace detail

/** The `KitchenErrors` error domain of module `kitchen`: catch a code's class or this. */
class KitchenError : public Error {
public:
    /** Builds an error carrying one of the domain's `code`s and its `message`. */
    KitchenError(int32_t code, const std::string& message) : Error(code, message) {}
};

/**
 * Item not found
 *
 * Code 1.
 */
class NotFoundError : public KitchenError {
public:
    /** Builds the error with the producer's `message` and the code's fields. */
    explicit NotFoundError(const std::string& message) : KitchenError(1, message) {}
};

/**
 * Invalid input
 *
 * Code 2.
 */
class InvalidInputError : public KitchenError {
public:
    /** Builds the error with the producer's `message` and the code's fields. */
    explicit InvalidInputError(const std::string& message) : KitchenError(2, message) {}
};

namespace detail {

/** Raises and reports `KitchenError` and its codes' classes. */
template <>
struct Errors<KitchenError> {
    [[noreturn]] static void raise(const kitchen_sink_error& err) {
        if (err.code < 0) raise_runtime<Error>(err);
        switch (err.code) {
            case 1: throw NotFoundError(message(err));
            case 2: throw InvalidInputError(message(err));
            default: throw KitchenError(err.code, message(err));
        }
    }

    static void report(kitchen_sink_error* out_err) noexcept {
        try {
            throw;
        } catch (const KitchenError& e) {
            set_error(out_err, e.code(), e.what());
        } catch (...) {
            report_current(out_err, -1);
        }
    }
};

} // namespace detail

/** The `PantryError` error domain of module `kitchen`: catch a code's class or this. */
class PantryError : public Error {
public:
    /** Builds an error carrying one of the domain's `code`s and its `message`. */
    PantryError(int32_t code, const std::string& message) : Error(code, message) {}
};

/**
 * Out of stock
 *
 * Code 1.
 */
class OutOfStockError : public PantryError {
public:
    std::string item;

    /** Builds the error with the producer's `message` and the code's fields. */
    OutOfStockError(const std::string& message, std::string item) : PantryError(1, message), item(std::move(item)) {}
};

/**
 * Spoiled
 *
 * Code 2.
 */
class SpoiledError : public PantryError {
public:
    /** Builds the error with the producer's `message` and the code's fields. */
    explicit SpoiledError(const std::string& message) : PantryError(2, message) {}
};

namespace detail {

/** Raises and reports `PantryError` and its codes' classes. */
template <>
struct Errors<PantryError> {
    [[noreturn]] static void raise(const kitchen_sink_error& err) {
        if (err.code < 0) raise_runtime<Error>(err);
        switch (err.code) {
            case 1: raise_with_fields<OutOfStockError, std::string>(err);
            case 2: throw SpoiledError(message(err));
            default: throw PantryError(err.code, message(err));
        }
    }

    static void report(kitchen_sink_error* out_err) noexcept {
        try {
            throw;
        } catch (const OutOfStockError& e) {
            report_with_fields(out_err, e, e.item);
        } catch (const PantryError& e) {
            set_error(out_err, e.code(), e.what());
        } catch (...) {
            report_current(out_err, -1);
        }
    }
};

} // namespace detail

/**
 * Consumer-implemented observer of ready items
 *
 * Subclass it and pass a `std::shared_ptr<ReadyListener>` where the API takes a `ReadyListener`. The producer may call the methods from any thread, so they must be thread-safe, and releases the implementation (also from any thread) once it's done with it. An exception a method throws never unwinds into the producer: a method that declares errors reports it as described on the method, and any other method reports a callback failure (-4).
 */
class ReadyListener {
public:
    virtual ~ReadyListener() = default;

    /** Fires when an item is ready */
    virtual void on_ready(int32_t code, std::string_view msg) = 0;

    /** Receives the item itself and says whether to keep listening */
    virtual bool on_item(const Item& item, Gadget gadget) = 0;

    /**
     * A display label, failing with a kitchen error
     *
     * @throws KitchenError (or one of its codes' classes) to report one of the domain's codes, fields included; any other exception reports a plain failure.
     */
    virtual std::string label() = 0;

    /** The most recent item the listener kept, if any */
    virtual std::optional<Item> latest() = 0;

    /** The listener's favorite gadget */
    virtual Gadget favorite() = 0;
};

namespace detail {

/** Adapts a `ReadyListener` implementation to `kitchen_sink_kitchen_ReadyListener_vtable`. */
template <>
struct Callbacks<ReadyListener> {
    static void on_ready(void* ctx, int32_t code, const uint8_t* msg_ptr, size_t msg_len, kitchen_sink_error* out_err) {
        callback<InternalError>(out_err, [&] {
            implementation<ReadyListener>(ctx).on_ready(code, borrow_string(msg_ptr, msg_len));
        });
    }

    static bool on_item(void* ctx, const uint8_t* item_ptr, size_t item_len, kitchen_sink_kitchen_Gadget* gadget, kitchen_sink_error* out_err) {
        Gadget gadget_arg(adopt, gadget);
        return callback<InternalError>(out_err, [&] {
            auto item_arg = decode<Item>(item_ptr, item_len);
            return implementation<ReadyListener>(ctx).on_item(std::move(item_arg), std::move(gadget_arg));
        });
    }

    static void label(void* ctx, uint8_t** out_ptr, size_t* out_len, kitchen_sink_error* out_err) {
        callback<KitchenError>(out_err, [&] {
            give(implementation<ReadyListener>(ctx).label(), out_ptr, out_len);
        });
    }

    static void latest(void* ctx, uint8_t** out_ptr, size_t* out_len, kitchen_sink_error* out_err) {
        callback<InternalError>(out_err, [&] {
            give(encode(implementation<ReadyListener>(ctx).latest()), out_ptr, out_len);
        });
    }

    static kitchen_sink_kitchen_Gadget* favorite(void* ctx, kitchen_sink_error* out_err) {
        return callback<InternalError>(out_err, [&] {
            return implementation<ReadyListener>(ctx).favorite().clone_handle();
        });
    }

    /** The vtable every `ReadyListener` implementation is passed with. */
    static const kitchen_sink_kitchen_ReadyListener_vtable& vtable() noexcept {
        static const kitchen_sink_kitchen_ReadyListener_vtable table = {
            sizeof(kitchen_sink_kitchen_ReadyListener_vtable),
            0,
            &release<ReadyListener>,
            &on_ready,
            &on_item,
            &label,
            &latest,
            &favorite,
        };
        return table;
    }
};

} // namespace detail

/**
 * Consumer-implemented source of scalar samples
 *
 * Subclass it and pass a `std::shared_ptr<Sampler>` where the API takes a `Sampler`. The producer may call the methods from any thread, so they must be thread-safe, and releases the implementation (also from any thread) once it's done with it. An exception a method throws never unwinds into the producer: a method that declares errors reports it as described on the method, and any other method reports a callback failure (-4).
 */
class Sampler {
public:
    virtual ~Sampler() = default;

    /** The cutoff for a level, if the sampler has one */
    virtual std::optional<double> threshold(std::optional<uint32_t> level) = 0;

    /**
     * Up to `limit` samples, failing when the pantry is empty
     *
     * @throws PantryError (or one of its codes' classes) to report one of the domain's codes, fields included; any other exception reports a plain failure.
     */
    virtual std::vector<int16_t> samples(std::optional<uint32_t> limit, const std::vector<double>& weights) = 0;

    /**
     * A free-form description, failing with an untyped error
     *
     * @throws std::exception to report a failure, with `what()` as its message.
     */
    virtual std::string describe() = 0;
};

namespace detail {

/** Adapts a `Sampler` implementation to `kitchen_sink_kitchen_Sampler_vtable`. */
template <>
struct Callbacks<Sampler> {
    static bool threshold(void* ctx, bool has_level, uint32_t level, double* out_value, kitchen_sink_error* out_err) {
        return callback<InternalError>(out_err, [&] {
            return give_optional(implementation<Sampler>(ctx).threshold(lift_optional<uint32_t>(has_level, level)), out_value);
        });
    }

    static void samples(void* ctx, bool has_limit, uint32_t limit, const double* weights_ptr, size_t weights_len, int16_t** out_ptr, size_t* out_len, kitchen_sink_error* out_err) {
        callback<PantryError>(out_err, [&] {
            give_slice(implementation<Sampler>(ctx).samples(lift_optional<uint32_t>(has_limit, limit), borrow_slice(weights_ptr, weights_len)), out_ptr, out_len);
        });
    }

    static void describe(void* ctx, uint8_t** out_ptr, size_t* out_len, kitchen_sink_error* out_err) {
        callback<Error>(out_err, [&] {
            give(implementation<Sampler>(ctx).describe(), out_ptr, out_len);
        });
    }

    /** The vtable every `Sampler` implementation is passed with. */
    static const kitchen_sink_kitchen_Sampler_vtable& vtable() noexcept {
        static const kitchen_sink_kitchen_Sampler_vtable table = {
            sizeof(kitchen_sink_kitchen_Sampler_vtable),
            0,
            &release<Sampler>,
            &threshold,
            &samples,
            &describe,
        };
        return table;
    }
};

