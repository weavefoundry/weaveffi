/**
 * A lazy, move-only range over the `Item` elements `stream_items()` produces.
 *
 * Each step pulls one element from the producer, so results stream in constant memory. The range releases the producer iterator exactly once: when it's exhausted, or from the destructor when iteration stops early.
 */
class StreamItemsIterator {
    kitchen_sink_kitchen_StreamItemsIterator* handle_;

public:
    /** Adopts a producer iterator. */
    explicit StreamItemsIterator(adopt_t, kitchen_sink_kitchen_StreamItemsIterator* h) noexcept : handle_(h) {}

    /** Releases the producer iterator if it's still held. */
    ~StreamItemsIterator() {
        if (handle_ != nullptr) kitchen_sink_kitchen_StreamItemsIterator_destroy(handle_);
    }

    StreamItemsIterator(const StreamItemsIterator&) = delete;
    StreamItemsIterator& operator=(const StreamItemsIterator&) = delete;

    /** Transfers `other`'s iterator; `other` becomes empty. */
    StreamItemsIterator(StreamItemsIterator&& other) noexcept : handle_(other.handle_) { other.handle_ = nullptr; }

    /** Releases the current iterator and takes over `other`'s. */
    StreamItemsIterator& operator=(StreamItemsIterator&& other) noexcept {
        if (this != &other) {
            if (handle_ != nullptr) kitchen_sink_kitchen_StreamItemsIterator_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** Pulls the next element, or `std::nullopt` once exhausted (which releases the producer iterator). A producer error releases the iterator and throws InternalError. */
    std::optional<Item> next() {
        if (handle_ == nullptr) return std::nullopt;
        kitchen_sink_error err{};
        const uint8_t* item{};
        size_t item_len = 0;
        int32_t has_item = kitchen_sink_kitchen_StreamItemsIterator_next(handle_, &item, &item_len, &err);
        if (err.code != 0 || has_item == 0) {
            kitchen_sink_kitchen_StreamItemsIterator_destroy(handle_);
            handle_ = nullptr;
            detail::check(err);
            return std::nullopt;
        }
        return std::optional<Item>(std::in_place, detail::take(item, item_len, &detail::read_Item));
    }

    /** Sentinel type marking the end of the range. */
    struct sentinel {};

    /** Single-pass input iterator; each increment pulls one element. */
    class iterator {
        StreamItemsIterator* range_;
        std::optional<Item> current_;

    public:
        using iterator_category = std::input_iterator_tag;
        using value_type = Item;
        using difference_type = std::ptrdiff_t;
        using pointer = Item*;
        using reference = Item&;

        /** Binds to `range` and pulls the first element. */
        explicit iterator(StreamItemsIterator* range) : range_(range), current_(range->next()) {}
        reference operator*() { return *current_; }
        pointer operator->() { return &*current_; }
        iterator& operator++() { current_ = range_->next(); return *this; }
        void operator++(int) { current_ = range_->next(); }
        bool operator==(sentinel) const { return !current_.has_value(); }
        bool operator!=(sentinel) const { return current_.has_value(); }
    };

    /** Begins iteration by pulling the first element. */
    iterator begin() { return iterator(this); }

    /** The past-the-end sentinel. */
    sentinel end() const { return sentinel{}; }
};

/**
 * Iterator return type
 *
 * @return A lazy `StreamItemsIterator` range that pulls one element per step and releases the producer iterator when exhausted or destroyed.
 */
inline StreamItemsIterator stream_items() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_kitchen_StreamItemsIterator* iter = kitchen_sink_kitchen_stream_items(&err);
    detail::check(err);
    return StreamItemsIterator(adopt, iter);
}

/** Returns the shared Token type from another module */
inline Token cross_module_token() {
    check_library();
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_cross_module_token(&out_len, &err);
    detail::check(err);
    return detail::take(result, out_len, &detail::read_Token);
}

/**
 * Async operation
 *
 * @return A future settled from a producer thread; get() rethrows the call's error.
 */
inline std::future<std::string> do_async(std::string_view input) {
    check_library();
    auto promise = std::make_unique<std::promise<std::string>>();
    auto future = promise->get_future();
    kitchen_sink_kitchen_do_async(detail::utf8(input), input.size(), [](void* context, kitchen_sink_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<std::string>> p(static_cast<std::promise<std::string>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string message = detail::error_message(*err);
                p->set_exception(detail::make_internal_error(err->code, message));
            } else {
                p->set_value(detail::take_string(result_ptr, result_len));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        kitchen_sink_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

/**
 * Cancellable async operation
 *
 * @param cancel_token Cancels the call; the future then throws Cancelled.
 * @return A future settled from a producer thread; get() rethrows the call's error.
 */
inline std::future<std::string> do_cancellable(std::string_view input, const CancelToken& cancel_token = CancelToken::none()) {
    check_library();
    auto promise = std::make_unique<std::promise<std::string>>();
    auto future = promise->get_future();
    kitchen_sink_kitchen_do_cancellable(detail::utf8(input), input.size(), cancel_token.handle(), [](void* context, kitchen_sink_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<std::string>> p(static_cast<std::promise<std::string>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string message = detail::error_message(*err);
                p->set_exception(detail::make_internal_error(err->code, message));
            } else {
                p->set_value(detail::take_string(result_ptr, result_len));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        kitchen_sink_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

