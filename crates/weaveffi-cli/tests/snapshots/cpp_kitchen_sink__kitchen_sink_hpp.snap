/**
 * Async operation
 *
 * @return A future settled from a producer thread; get() rethrows the call's error.
 */
inline std::future<std::string> do_async(std::string_view input) {
    check_library();
    auto promise = std::make_unique<std::promise<std::string>>();
    auto future = promise->get_future();
    kitchen_sink_do_async(detail::string_run(input), [](void* context, kitchen_sink_error* err, kitchen_sink_run result) {
        detail::settle<InternalError, std::string>(context, err, [&] { return detail::take_string(result); });
    }, promise.release());
    return future;
}

/**
 * Cancellable async operation
 *
 * @param cancel_token Cancels the call; the future then throws Cancelled.
 * @return A future settled from a producer thread; get() rethrows the call's error.
 */
inline std::future<std::string> do_cancellable(std::string_view input, const CancelToken& cancel_token = CancelToken::none()) {
    check_library();
    auto promise = std::make_unique<std::promise<std::string>>();
    auto future = promise->get_future();
    kitchen_sink_do_cancellable(detail::string_run(input), cancel_token.handle(), [](void* context, kitchen_sink_error* err, kitchen_sink_run result) {
        detail::settle<InternalError, std::string>(context, err, [&] { return detail::take_string(result); });
    }, promise.release());
    return future;
}

