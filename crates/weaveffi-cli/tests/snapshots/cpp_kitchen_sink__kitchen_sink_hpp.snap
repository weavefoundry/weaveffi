/**
 * An iterator over objects
 *
 * @return A lazy, single-pass range; each step makes one producer call.
 */
inline Range<Gadget> stream_gadgets() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_StreamGadgetsIterator* iter = kitchen_sink_stream_gadgets(&err);
    detail::check<InternalError>(err);
    return Range<Gadget>(adopt, iter, [](void* raw, std::optional<Gadget>& item) {
        kitchen_sink_error next_err{};
        kitchen_sink_Gadget* out_item{};
        if (kitchen_sink_StreamGadgetsIterator_next(static_cast<kitchen_sink_StreamGadgetsIterator*>(raw), &out_item, &next_err) == 0) {
            detail::check<InternalError>(next_err);
            return false;
        }
        item.emplace(Gadget(adopt, out_item));
        return true;
    }, [](void* raw) { kitchen_sink_StreamGadgetsIterator_destroy(static_cast<kitchen_sink_StreamGadgetsIterator*>(raw)); });
}

