}

/** Every slice element type */
inline std::vector<uint32_t> mixed_slices(const std::vector<int8_t>& a, const std::vector<int16_t>& b, const std::vector<uint16_t>& c, const std::vector<uint32_t>& d, const std::vector<int64_t>& e, const std::vector<float>& f) {
    check_library();
    kitchen_sink_error err{};
    size_t out_len{};
    auto result = kitchen_sink_kitchen_mixed_slices(a.data(), a.size(), b.data(), b.size(), c.data(), c.size(), d.data(), d.size(), e.data(), e.size(), f.data(), f.size(), &out_len, &err);
    detail::check<InternalError>(err);
    return detail::take_slice(result, out_len);
}

/**
 * Async returning an optional scalar
 *
 * @return A future settled from a producer thread; get() rethrows the call's error.
 */
inline std::future<std::optional<int64_t>> async_maybe_count() {
    check_library();
    auto promise = std::make_unique<std::promise<std::optional<int64_t>>>();
    auto future = promise->get_future();
    kitchen_sink_kitchen_async_maybe_count([](void* context, kitchen_sink_error* err, bool has_result, int64_t result) {
        detail::settle<InternalError, std::optional<int64_t>>(context, err, [&] { return detail::lift_optional<int64_t>(has_result, result); });
    }, promise.release());
    return future;
}

/**
 * Async returning a typed array
 *
 * @param cancel_token Cancels the call; the future then throws Cancelled.
 * @return A future settled from a producer thread; get() rethrows the call's error.
 */
inline std::future<std::vector<float>> async_samples(uint32_t n, const CancelToken& cancel_token = CancelToken::none()) {
    check_library();
    auto promise = std::make_unique<std::promise<std::vector<float>>>();
    auto future = promise->get_future();
    kitchen_sink_kitchen_async_samples(n, cancel_token.handle(), [](void* context, kitchen_sink_error* err, const float* result_ptr, size_t result_len) {
        detail::settle<InternalError, std::vector<float>>(context, err, [&] { return detail::take_slice(result_ptr, result_len); });
    }, promise.release());
    return future;
}

/**
 * Iterator of optional scalars
 *
 * @return A lazy, single-pass range; each step makes one producer call.
 */
inline Range<std::optional<int32_t>> stream_maybe() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_kitchen_StreamMaybeIterator* iter = kitchen_sink_kitchen_stream_maybe(&err);
    detail::check<InternalError>(err);
    return Range<std::optional<int32_t>>(adopt, iter, [](void* raw, std::optional<std::optional<int32_t>>& item) {
        kitchen_sink_error next_err{};
        bool out_has_item{};
        int32_t out_item{};
        if (kitchen_sink_kitchen_StreamMaybeIterator_next(static_cast<kitchen_sink_kitchen_StreamMaybeIterator*>(raw), &out_has_item, &out_item, &next_err) == 0) {
            detail::check<InternalError>(next_err);
            return false;
        }
        item.emplace(detail::lift_optional<int32_t>(out_has_item, out_item));
        return true;
    }, [](void* raw) { kitchen_sink_kitchen_StreamMaybeIterator_destroy(static_cast<kitchen_sink_kitchen_StreamMaybeIterator*>(raw)); });
}

/**
 * Iterator of typed arrays
 *
 * @return A lazy, single-pass range; each step makes one producer call.
 */
inline Range<std::vector<int32_t>> stream_chunks() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_kitchen_StreamChunksIterator* iter = kitchen_sink_kitchen_stream_chunks(&err);
    detail::check<InternalError>(err);
    return Range<std::vector<int32_t>>(adopt, iter, [](void* raw, std::optional<std::vector<int32_t>>& item) {
        kitchen_sink_error next_err{};
        int32_t* out_item{};
        size_t out_len{};
        if (kitchen_sink_kitchen_StreamChunksIterator_next(static_cast<kitchen_sink_kitchen_StreamChunksIterator*>(raw), &out_item, &out_len, &next_err) == 0) {
            detail::check<InternalError>(next_err);
            return false;
        }
        item.emplace(detail::take_slice(out_item, out_len));
        return true;
    }, [](void* raw) { kitchen_sink_kitchen_StreamChunksIterator_destroy(static_cast<kitchen_sink_kitchen_StreamChunksIterator*>(raw)); });
}

/**
 * Drive a consumer-implemented sampler
 *
 * @throws PantryError (or one of its codes' classes) when the call fails with one of the domain's codes.
 */
inline std::vector<int16_t> sample_with(std::shared_ptr<Sampler> sampler, std::optional<uint32_t> level) {
    check_library();
    auto sampler_ctx = detail::lend_required(std::move(sampler), "sampler");
    kitchen_sink_error err{};
    size_t out_len{};
    auto result = kitchen_sink_kitchen_sample_with(sampler_ctx.release(), &detail::Callbacks<Sampler>::vtable(), level.has_value(), detail::value_or_zero(level), &out_len, &err);
    detail::check<PantryError>(err);
    return detail::take_slice(result, out_len);
}

/**
 * Fails with the second domain
 *
 * @throws PantryError (or one of its codes' classes) when the call fails with one of the domain's codes.
 */
inline int32_t take_from_pantry(std::string_view item) {
    check_library();
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_take_from_pantry(detail::utf8(item), item.size(), &err);
    detail::check<PantryError>(err);
    return result;
}

/**
 * Fails with an untyped error
 *
 * @throws Error with code -1 and the producer's message when the call fails.
 */
inline int64_t parse_any(std::string_view text) {
    check_library();
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_parse_any(detail::utf8(text), text.size(), &err);
    detail::check<Error>(err);
    return result;
}

