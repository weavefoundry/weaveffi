/** Register a listener, returning how many are attached */
inline int32_t subscribe(std::shared_ptr<ReadyListener> listener) {
    check_library();
    if (!listener) throw std::invalid_argument("listener: null callback interface");
    auto listener_ctx = std::make_unique<std::shared_ptr<ReadyListener>>(std::move(listener));
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_subscribe(static_cast<void*>(listener_ctx.release()), &detail::ReadyListener_vtable(), &err);
    detail::check(err);
    return result;
}

/** Optional object in both directions */
inline std::optional<Gadget> maybe_gadget(const std::optional<Gadget>& fallback) {
    check_library();
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_maybe_gadget(fallback.has_value() ? fallback->handle() : nullptr, &err);
    detail::check(err);
    if (!result) return std::nullopt;
    return Gadget(adopt, result);
}

/** A list of objects */
inline std::vector<Gadget> gadgets() {
    check_library();
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_gadgets(&out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    std::vector<Gadget> ret{};
    {
        size_t ret_n = result_r.read_count();
        ret.reserve(result_r.reserve_hint(ret_n));
        for (size_t ret_i = 0; ret_i < ret_n; ++ret_i) {
            Gadget ret_item = Gadget(adopt, reinterpret_cast<Gadget::raw_type*>(static_cast<uintptr_t>(result_r.read_u64())));
            ret.push_back(std::move(ret_item));
        }
    }
    result_r.expect_end();
    return ret;
}

/**
 * A lazy, move-only range over the `Gadget` elements produced by `stream_gadgets()`.
 *
 * Each iteration step pulls exactly one element from the producer, so results stream in constant memory. The range owns the producer-side iterator and releases it exactly once: eagerly when the range is exhausted, or from the destructor when iteration is abandoned early.
 */
class StreamGadgetsIterator {
    kitchen_sink_kitchen_StreamGadgetsIterator* handle_;

public:
    /** Adopts ownership of a raw producer iterator. */
    explicit StreamGadgetsIterator(adopt_t, kitchen_sink_kitchen_StreamGadgetsIterator* h) noexcept : handle_(h) {}

    ~StreamGadgetsIterator() {
        if (handle_) kitchen_sink_kitchen_StreamGadgetsIterator_destroy(handle_);
    }

    StreamGadgetsIterator(const StreamGadgetsIterator&) = delete;
    StreamGadgetsIterator& operator=(const StreamGadgetsIterator&) = delete;

    StreamGadgetsIterator(StreamGadgetsIterator&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    StreamGadgetsIterator& operator=(StreamGadgetsIterator&& other) noexcept {
        if (this != &other) {
            if (handle_) kitchen_sink_kitchen_StreamGadgetsIterator_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** Pulls the next element from the producer, or `std::nullopt` once exhausted (which releases the producer iterator eagerly). A producer error throws the generic Error after releasing the iterator. */
    std::optional<Gadget> next() {
        if (!handle_) return std::nullopt;
        kitchen_sink_error err{};
        kitchen_sink_kitchen_Gadget* item{};
        int32_t has_item = kitchen_sink_kitchen_StreamGadgetsIterator_next(handle_, &item, &err);
        if (err.code != 0) {
            kitchen_sink_kitchen_StreamGadgetsIterator_destroy(handle_);
            handle_ = nullptr;
            detail::check(err);
        }
        if (has_item == 0) {
            kitchen_sink_kitchen_StreamGadgetsIterator_destroy(handle_);
            handle_ = nullptr;
            return std::nullopt;
        }
        return Gadget(adopt, item);
    }

    /** Sentinel type marking the end of the range. */
    struct sentinel {};

    /** Single-pass input iterator; each increment pulls one element from the producer. */
    class iterator {
        StreamGadgetsIterator* range_;
        std::optional<Gadget> current_;

    public:
        using iterator_category = std::input_iterator_tag;
        using value_type = Gadget;
        using difference_type = std::ptrdiff_t;
        using pointer = Gadget*;
        using reference = Gadget&;

        /** Binds to `range` and pulls the first element. */
        explicit iterator(StreamGadgetsIterator* range) : range_(range), current_(range->next()) {}
        reference operator*() { return *current_; }
        pointer operator->() { return &*current_; }
        iterator& operator++() { current_ = range_->next(); return *this; }
        void operator++(int) { current_ = range_->next(); }
        bool operator==(sentinel) const { return !current_.has_value(); }
        bool operator!=(sentinel) const { return current_.has_value(); }
    };

    /** Begins iteration by pulling the first element. */
    iterator begin() { return iterator(this); }

    /** The past-the-end sentinel. */
    sentinel end() const { return sentinel{}; }
};

/**
 * An iterator over objects
 *
 * @return A lazy `StreamGadgetsIterator` range that streams one element per iteration step and releases the producer iterator when exhausted or destroyed.
 */
inline StreamGadgetsIterator stream_gadgets() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_kitchen_StreamGadgetsIterator* iter = kitchen_sink_kitchen_stream_gadgets(&err);
    detail::check(err);
    return StreamGadgetsIterator(adopt, iter);
}

/** Optional struct return */
inline std::optional<Item> maybe_item(int64_t id) {
    check_library();
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_maybe_item(id, &out_len, &err);
    detail::check_kitchen(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    std::optional<Item> ret{};
    if (result_r.read_option_flag()) {
        Item ret_v = detail::read_Item(result_r);
        ret = std::move(ret_v);
    }
    result_r.expect_end();
    return ret;
}

/** List of structs */
inline std::vector<Item> list_items() {
    check_library();
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_list_items(&out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    std::vector<Item> ret{};
    {
        size_t ret_n = result_r.read_count();
        ret.reserve(result_r.reserve_hint(ret_n));
        for (size_t ret_i = 0; ret_i < ret_n; ++ret_i) {
            Item ret_item = detail::read_Item(result_r);
            ret.push_back(std::move(ret_item));
        }
    }
    result_r.expect_end();
    return ret;
}

/** Map return type */
inline std::unordered_map<std::string, int32_t> get_attrs() {
    check_library();
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_get_attrs(&out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    std::unordered_map<std::string, int32_t> ret{};
    {
        size_t ret_n = result_r.read_count();
        for (size_t ret_i = 0; ret_i < ret_n; ++ret_i) {
            std::string ret_key = result_r.read_string();
            int32_t ret_val = result_r.read_i32();
            ret.emplace(std::move(ret_key), std::move(ret_val));
        }
    }
    result_r.expect_end();
    return ret;
}

/**
 * A lazy, move-only range over the `Item` elements produced by `stream_items()`.
 *
 * Each iteration step pulls exactly one element from the producer, so results stream in constant memory. The range owns the producer-side iterator and releases it exactly once: eagerly when the range is exhausted, or from the destructor when iteration is abandoned early.
 */
class StreamItemsIterator {
    kitchen_sink_kitchen_StreamItemsIterator* handle_;

public:
    /** Adopts ownership of a raw producer iterator. */
    explicit StreamItemsIterator(adopt_t, kitchen_sink_kitchen_StreamItemsIterator* h) noexcept : handle_(h) {}

    ~StreamItemsIterator() {
        if (handle_) kitchen_sink_kitchen_StreamItemsIterator_destroy(handle_);
    }

    StreamItemsIterator(const StreamItemsIterator&) = delete;
    StreamItemsIterator& operator=(const StreamItemsIterator&) = delete;

    StreamItemsIterator(StreamItemsIterator&& other) noexcept : handle_(other.handle_) {
        other.handle_ = nullptr;
    }

    StreamItemsIterator& operator=(StreamItemsIterator&& other) noexcept {
        if (this != &other) {
            if (handle_) kitchen_sink_kitchen_StreamItemsIterator_destroy(handle_);
            handle_ = other.handle_;
            other.handle_ = nullptr;
        }
        return *this;
    }

    /** Pulls the next element from the producer, or `std::nullopt` once exhausted (which releases the producer iterator eagerly). A producer error throws the generic Error after releasing the iterator. */
    std::optional<Item> next() {
        if (!handle_) return std::nullopt;
        kitchen_sink_error err{};
        const uint8_t* item{};
        size_t item_len = 0;
        int32_t has_item = kitchen_sink_kitchen_StreamItemsIterator_next(handle_, &item, &item_len, &err);
        if (err.code != 0) {
            kitchen_sink_kitchen_StreamItemsIterator_destroy(handle_);
            handle_ = nullptr;
            detail::check(err);
        }
        if (has_item == 0) {
            kitchen_sink_kitchen_StreamItemsIterator_destroy(handle_);
            handle_ = nullptr;
            return std::nullopt;
        }
        detail::BufferGuard item_guard(item, item_len);
        detail::BufferReader item_r(item, item_len);
        Item value = detail::read_Item(item_r);
        item_r.expect_end();
        return value;
    }

    /** Sentinel type marking the end of the range. */
    struct sentinel {};

    /** Single-pass input iterator; each increment pulls one element from the producer. */
    class iterator {
        StreamItemsIterator* range_;
        std::optional<Item> current_;

    public:
        using iterator_category = std::input_iterator_tag;
        using value_type = Item;
        using difference_type = std::ptrdiff_t;
        using pointer = Item*;
        using reference = Item&;

        /** Binds to `range` and pulls the first element. */
        explicit iterator(StreamItemsIterator* range) : range_(range), current_(range->next()) {}
        reference operator*() { return *current_; }
        pointer operator->() { return &*current_; }
        iterator& operator++() { current_ = range_->next(); return *this; }
        void operator++(int) { current_ = range_->next(); }
        bool operator==(sentinel) const { return !current_.has_value(); }
        bool operator!=(sentinel) const { return current_.has_value(); }
    };

    /** Begins iteration by pulling the first element. */
    iterator begin() { return iterator(this); }

    /** The past-the-end sentinel. */
    sentinel end() const { return sentinel{}; }
};

/**
 * Iterator return type
 *
 * @return A lazy `StreamItemsIterator` range that streams one element per iteration step and releases the producer iterator when exhausted or destroyed.
 */
inline StreamItemsIterator stream_items() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_kitchen_StreamItemsIterator* iter = kitchen_sink_kitchen_stream_items(&err);
    detail::check(err);
    return StreamItemsIterator(adopt, iter);
}

/** Returns the shared Token type from another module */
inline Token cross_module_token() {
    check_library();
    size_t out_len = 0;
    kitchen_sink_error err{};
    auto result = kitchen_sink_kitchen_cross_module_token(&out_len, &err);
    detail::check(err);
    detail::BufferGuard result_guard(result, out_len);
    detail::BufferReader result_r(result, out_len);
    Token ret = detail::read_Token(result_r);
    result_r.expect_end();
