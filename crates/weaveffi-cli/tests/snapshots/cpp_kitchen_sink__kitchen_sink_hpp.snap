/**
 * Iterator of optional scalars
 *
 * @return A lazy, single-pass range; each step makes one producer call.
 */
inline Range<std::optional<int32_t>> stream_maybe() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_StreamMaybeIterator* iter = kitchen_sink_stream_maybe(&err);
    detail::check<InternalError>(err);
    return Range<std::optional<int32_t>>(adopt, iter, [](void* raw, std::optional<std::optional<int32_t>>& item) {
        kitchen_sink_error next_err{};
        kitchen_sink_opt_i32 out_item{};
        if (kitchen_sink_StreamMaybeIterator_next(static_cast<kitchen_sink_StreamMaybeIterator*>(raw), &out_item, &next_err) == 0) {
            detail::check<InternalError>(next_err);
            return false;
        }
        item.emplace(detail::from_opt<int32_t>(out_item));
        return true;
    }, [](void* raw) { kitchen_sink_StreamMaybeIterator_destroy(static_cast<kitchen_sink_StreamMaybeIterator*>(raw)); });
}

/**
 * Iterator of typed arrays
 *
 * @return A lazy, single-pass range; each step makes one producer call.
 */
inline Range<std::vector<int32_t>> stream_chunks() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_StreamChunksIterator* iter = kitchen_sink_stream_chunks(&err);
    detail::check<InternalError>(err);
    return Range<std::vector<int32_t>>(adopt, iter, [](void* raw, std::optional<std::vector<int32_t>>& item) {
        kitchen_sink_error next_err{};
        kitchen_sink_run out_item{};
        if (kitchen_sink_StreamChunksIterator_next(static_cast<kitchen_sink_StreamChunksIterator*>(raw), &out_item, &next_err) == 0) {
            detail::check<InternalError>(next_err);
            return false;
        }
        item.emplace(detail::take_slice<int32_t>(out_item));
        return true;
    }, [](void* raw) { kitchen_sink_StreamChunksIterator_destroy(static_cast<kitchen_sink_StreamChunksIterator*>(raw)); });
}

/**
 * Drive a consumer-implemented sampler
 *
 * @throws PantryError (or one of its codes' classes) when the call fails with one of the domain's codes.
 */
inline std::vector<int16_t> sample_with(std::shared_ptr<Sampler> sampler, std::optional<uint32_t> level) {
    check_library();
    auto sampler_ctx = detail::lend_required(std::move(sampler), "sampler");
    kitchen_sink_error err{};
    auto result = kitchen_sink_sample_with(kitchen_sink_Sampler{sampler_ctx.release(), &detail::Callbacks<Sampler>::vtable()}, detail::to_opt<kitchen_sink_opt_u32>(level), &err);
    detail::check<PantryError>(err);
    return detail::take_slice<int16_t>(result);
}

/**
 * Fails with the second domain
 *
 * @throws PantryError (or one of its codes' classes) when the call fails with one of the domain's codes.
 */
inline int32_t take_from_pantry(std::string_view item) {
    check_library();
    kitchen_sink_error err{};
    auto result = kitchen_sink_take_from_pantry(detail::string_run(item), &err);
    detail::check<PantryError>(err);
    return result;
}

/**
 * Fails with an untyped error
 *
 * @throws Error with code -1 and the producer's message when the call fails.
 */
inline int64_t parse_any(std::string_view text) {
    check_library();
    kitchen_sink_error err{};
    auto result = kitchen_sink_parse_any(detail::string_run(text), &err);
    detail::check<Error>(err);
    return result;
}

/** A trivial function returning a string */
inline std::string hello() {
    check_library();
    kitchen_sink_error err{};
    auto result = kitchen_sink_hello(&err);
    detail::check<InternalError>(err);
    return detail::take_string(result);
}

} // namespace kitchen_sink

// END kitchen_sink.hpp
