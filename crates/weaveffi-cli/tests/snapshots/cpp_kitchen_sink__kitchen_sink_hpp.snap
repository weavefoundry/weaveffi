}

/** Async operation */
inline std::future<std::string> do_async(std::string_view input) {
    check_library();
    auto promise = std::make_unique<std::promise<std::string>>();
    auto future = promise->get_future();
    kitchen_sink_kitchen_do_async(detail::utf8(input), input.size(), [](void* context, kitchen_sink_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<std::string>> p(static_cast<std::promise<std::string>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string msg = detail::error_message(*err);
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                p->set_value(detail::take_string(result_ptr, result_len));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        kitchen_sink_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

/** Cancellable async operation */
inline std::future<std::string> do_cancellable(std::string_view input, const CancelToken& cancel_token = CancelToken::none()) {
    check_library();
    auto promise = std::make_unique<std::promise<std::string>>();
    auto future = promise->get_future();
    kitchen_sink_kitchen_do_cancellable(detail::utf8(input), input.size(), cancel_token.handle(), [](void* context, kitchen_sink_error* err, const uint8_t* result_ptr, size_t result_len) {
        std::unique_ptr<std::promise<std::string>> p(static_cast<std::promise<std::string>*>(context));
        try {
            if (err != nullptr && err->code != 0) {
                std::string msg = detail::error_message(*err);
                p->set_exception(detail::make_error(err->code, msg));
            } else {
                p->set_value(detail::take_string(result_ptr, result_len));
            }
        } catch (...) {
            p->set_exception(std::current_exception());
        }
        kitchen_sink_error_free(err);
    }, static_cast<void*>(promise.release()));
    return future;
}

