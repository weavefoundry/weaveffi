 */
inline Range<Item> stream_items() {
    check_library();
    kitchen_sink_error err{};
    kitchen_sink_kitchen_StreamItemsIterator* iter = kitchen_sink_kitchen_stream_items(&err);
    detail::check<InternalError>(err);
    return Range<Item>(adopt, iter, [](void* raw, std::optional<Item>& item) {
        kitchen_sink_error next_err{};
        const uint8_t* out_item{};
        size_t out_len{};
        if (kitchen_sink_kitchen_StreamItemsIterator_next(static_cast<kitchen_sink_kitchen_StreamItemsIterator*>(raw), &out_item, &out_len, &next_err) == 0) {
            detail::check<InternalError>(next_err);
            return false;
        }
        item.emplace(detail::take<Item>(out_item, out_len));
        return true;
    }, [](void* raw) { kitchen_sink_kitchen_StreamItemsIterator_destroy(static_cast<kitchen_sink_kitchen_StreamItemsIterator*>(raw)); });
}

