/** Register a listener, returning how many are attached */
inline int32_t subscribe(std::shared_ptr<ReadyListener> listener) {
    check_library();
    auto listener_ctx = detail::lend_required(std::move(listener), "listener");
    kitchen_sink_error err{};
    auto result = kitchen_sink_subscribe(kitchen_sink_ReadyListener{listener_ctx.release(), &detail::Callbacks<ReadyListener>::vtable()}, &err);
    detail::check<InternalError>(err);
    return result;
}

/** Register a listener if one is given */
inline bool maybe_subscribe(std::shared_ptr<ReadyListener> listener) {
    check_library();
    auto listener_ctx = detail::lend(std::move(listener));
    const auto* listener_vtable = listener_ctx ? &detail::Callbacks<ReadyListener>::vtable() : nullptr;
    kitchen_sink_error err{};
    auto result = kitchen_sink_maybe_subscribe(kitchen_sink_ReadyListener{listener_ctx.release(), listener_vtable}, &err);
    detail::check<InternalError>(err);
    return result;
}

